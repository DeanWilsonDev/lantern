{
  "name": "lantern",
  "version": "0.1.0",
  "dependencies": {
    "cgltf": "1.15",
    "stb_image": "2",
    "sdl3": "3.4",
    "sdl3_image": "3.4",
    "sdl3_ttf": "3.2",
    "penumbra-ui-engine": { "git": "https://github.com/fearlessgamelabs/penumbra-ui-engine", "branch": "nox-proto", "submodules": false },
    "amanuensis-data-serialisation-library": { "git": "https://github.com/fearlessgamelabs/amanuensis-data-serialisation-library", "branch": "main", "submodules": false },
    "penumbra-bridge": { "git": "https://github.com/fearlessgamelabs/penumbra-bridge", "branch": "main", "submodules": false },
    "lantern-native": { "path": "engine/native" }
  },
  "scripts": {
    "graphs": "cd engine && nox run --project tools/build-graphs",
    "assets": "cd engine && nox run --release --project tools/generate-assets --",
    "materials": "cd engine && nox run --project tools/build-materials",
    "package": "engine/tools/package-game.sh",
    "build-shaders": "engine/tools/build-shaders.sh",
    "test": "engine/tools/run-tests.sh",
    "game": "cd engine && nox run --release --",
    "editor": "nox build --release --project engine && nox run --release --project apps/world-editor/nox --"
  }
}
