#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct ObjectUniforms
{
    float4x4 model;
    float4x4 normal_matrix;
};

struct FrameUniforms
{
    float4x4 view_projection;
    float4 camera_position;
};

struct main0_out
{
    float3 world_position [[user(locn0)]];
    float3 world_normal [[user(locn1)]];
    float2 surface_uv [[user(locn2)]];
    float4 surface_color [[user(locn3)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 input_position [[attribute(0)]];
    float3 input_normal [[attribute(1)]];
    float2 input_uv [[attribute(2)]];
    float4 input_color [[attribute(3)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant FrameUniforms& frame [[buffer(0)]], constant ObjectUniforms& object_uniforms [[buffer(1)]])
{
    main0_out out = {};
    float4 world = object_uniforms.model * float4(in.input_position, 1.0);
    out.gl_Position = frame.view_projection * world;
    out.world_position = world.xyz;
    out.world_normal = (object_uniforms.normal_matrix * float4(in.input_normal, 0.0)).xyz;
    out.surface_uv = in.input_uv;
    out.surface_color = in.input_color;
    return out;
}

