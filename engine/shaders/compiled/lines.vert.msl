#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FrameUniforms
{
    float4x4 view_projection;
    float4 output_flags;
};

struct main0_out
{
    float4 line_color [[user(locn0)]];
    float encode_srgb [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 input_position [[attribute(0)]];
    float4 input_color [[attribute(1)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant FrameUniforms& frame [[buffer(0)]])
{
    main0_out out = {};
    out.gl_Position = frame.view_projection * float4(in.input_position, 1.0);
    out.line_color = in.input_color;
    out.encode_srgb = frame.output_flags.w;
    return out;
}

