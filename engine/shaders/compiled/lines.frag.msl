#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 output_color [[color(0)]];
};

struct main0_in
{
    float4 line_color [[user(locn0)]];
    float encode_srgb [[user(locn1), flat]];
};

fragment main0_out main0(main0_in in [[stage_in]])
{
    main0_out out = {};
    float3 color = in.line_color.xyz;
    if (in.encode_srgb > 0.5)
    {
        color = pow(color, float3(0.4545454680919647216796875));
    }
    out.output_color = float4(color, in.line_color.w);
    return out;
}

