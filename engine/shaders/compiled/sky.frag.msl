#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct SkyUniforms
{
    float4 right_scaled;
    float4 up_scaled;
    float4 forward;
    float4 to_sun_and_disc_cosine;
    float4 zenith;
    float4 horizon;
    float4 ground;
    float4 sun_color;
};

struct main0_out
{
    float4 output_color [[color(0)]];
    float4 output_surface [[color(1)]];
};

struct main0_in
{
    float2 screen_position [[user(locn0)]];
};

static inline __attribute__((always_inline))
float3 SkyGradient(thread const float3& direction, thread const float3& zenith, thread const float3& horizon, thread const float3& ground, thread const float& blur)
{
    float elevation = direction.y;
    float upward = fast::clamp(elevation, 0.0, 1.0);
    float3 above = mix(horizon, zenith, float3(pow(upward, mix(0.449999988079071044921875, 1.0, blur))));
    float softness = mix(0.00999999977648258209228515625, 0.5, blur);
    float below_amount = smoothstep(-softness, softness, -elevation);
    return mix(above, ground, float3(below_amount));
}

fragment main0_out main0(main0_in in [[stage_in]], constant SkyUniforms& sky [[buffer(0)]])
{
    main0_out out = {};
    float3 direction = fast::normalize((sky.forward.xyz + (sky.right_scaled.xyz * in.screen_position.x)) + (sky.up_scaled.xyz * in.screen_position.y));
    float3 seen_ground = mix(sky.horizon.xyz, sky.ground.xyz, float3(0.25));
    float3 param = direction;
    float3 param_1 = sky.zenith.xyz;
    float3 param_2 = sky.horizon.xyz;
    float3 param_3 = seen_ground;
    float param_4 = 0.300000011920928955078125;
    float3 color = SkyGradient(param, param_1, param_2, param_3, param_4);
    float cosine_to_sun = dot(direction, sky.to_sun_and_disc_cosine.xyz);
    float disc_cosine = sky.to_sun_and_disc_cosine.w;
    float disc = smoothstep(disc_cosine - 0.00019999999494757503271102905273438, disc_cosine + 0.00019999999494757503271102905273438, cosine_to_sun);
    float glow = pow(fast::max(cosine_to_sun, 0.0), 128.0) * 0.1500000059604644775390625;
    color += (sky.sun_color.xyz * (disc + glow));
    out.output_color = float4(color, 1.0);
    out.output_surface = float4(0.5, 0.5, 1.0, 0.0);
    return out;
}

