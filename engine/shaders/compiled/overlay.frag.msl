#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 output_color [[color(0)]];
};

struct main0_in
{
    float2 atlas_uv [[user(locn0)]];
    float4 glyph_color [[user(locn1)]];
    float encode_srgb [[user(locn2), flat]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> atlas_texture [[texture(0)]], sampler atlas_textureSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 texel = atlas_texture.sample(atlas_textureSmplr, in.atlas_uv);
    float3 color = texel.xyz * in.glyph_color.xyz;
    if (in.encode_srgb > 0.5)
    {
        color = pow(color, float3(0.4545454680919647216796875));
    }
    out.output_color = float4(color, texel.w * in.glyph_color.w);
    return out;
}

