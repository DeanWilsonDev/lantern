static inline __attribute__((always_inline))
bool IsBackground(thread const float& depth)
{
    return depth > 0.999989986419677734375;
}

static inline __attribute__((always_inline))
float LinearDistance(thread const float& depth, constant AmbientOcclusionUniforms& settings)
{
    float depth_range = settings.projection_terms.w;
    return (depth_range * settings.projection_terms.z) / (depth + depth_range);
}

static inline __attribute__((always_inline))
float3 ViewPosition(thread const float2& uv, thread const float& depth, constant AmbientOcclusionUniforms& settings)
{
    float param = depth;
    float distance_ahead = LinearDistance(param, settings);
    float2 ndc = float2((uv.x * 2.0) - 1.0, 1.0 - (uv.y * 2.0));
    return float3((ndc.x * settings.projection_terms.x) * distance_ahead, (ndc.y * settings.projection_terms.y) * distance_ahead, -distance_ahead);
}

static inline __attribute__((always_inline))
float TurnAmount(thread const int2& pixel)
{
    return _149[((pixel.y & 3) * 4) + (pixel.x & 3)] / 16.0;
}

static inline __attribute__((always_inline))
float2 ProjectToUv(thread const float3& view_position, constant AmbientOcclusionUniforms& settings)
{
    float distance_ahead = -view_position.z;
    float2 ndc = float2(view_position.x / (settings.projection_terms.x * distance_ahead), view_position.y / (settings.projection_terms.y * distance_ahead));
    return float2((ndc.x * 0.5) + 0.5, 0.5 - (ndc.y * 0.5));
}

