#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct ScreenUniforms
{
    float4 size_and_flags;
};

struct main0_out
{
    float2 atlas_uv [[user(locn0)]];
    float4 glyph_color [[user(locn1)]];
    float encode_srgb [[user(locn2)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 input_position [[attribute(0)]];
    float2 input_uv [[attribute(1)]];
    float4 input_color [[attribute(2)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant ScreenUniforms& screen [[buffer(0)]])
{
    main0_out out = {};
    float2 normalized_device_position = float2(((in.input_position.x / screen.size_and_flags.x) * 2.0) - 1.0, 1.0 - ((in.input_position.y / screen.size_and_flags.y) * 2.0));
    out.gl_Position = float4(normalized_device_position, 0.0, 1.0);
    out.atlas_uv = in.input_uv;
    out.glyph_color = in.input_color;
    out.encode_srgb = screen.size_and_flags.w;
    return out;
}

