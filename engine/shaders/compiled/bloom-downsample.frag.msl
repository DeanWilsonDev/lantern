static inline __attribute__((always_inline))
float3 Sample(thread const float2& offset_in_texels, texture2d<float> source_image, sampler source_imageSmplr, thread float2& source_uv, constant DownsampleUniforms& settings)
{
    return source_image.sample(source_imageSmplr, (source_uv + (offset_in_texels * settings.texel_threshold_mode.xy))).xyz;
}

static inline __attribute__((always_inline))
float Brightness(thread const float3& color)
{
    return fast::max(fast::max(color.x, color.y), color.z);
}

static inline __attribute__((always_inline))
float3 KeepBrightPart(thread const float3& color, thread const float& threshold)
{
    float3 param = color;
    float brightness = Brightness(param);
    float knee = fast::max(threshold * 0.100000001490116119384765625, 9.9999997473787516355514526367188e-05);
    float soft = fast::clamp((brightness - threshold) + knee, 0.0, 2.0 * knee);
    soft = (soft * soft) / (4.0 * knee);
    float contribution = fast::max(brightness - threshold, soft) / fast::max(brightness, 9.9999997473787516355514526367188e-05);
    return color * contribution;
}

