    float3 result;
    if (settings.texel_threshold_mode.w > 0.5)
    {
        float threshold = settings.texel_threshold_mode.z;
        float3 centre = (((j + k) + l) + m) * 0.25;
        float3 top_left = (((a + b) + d) + e) * 0.25;
        float3 top_right = (((b + c) + e) + f) * 0.25;
        float3 bottom_left = (((d + e) + g) + h) * 0.25;
        float3 bottom_right = (((e + f) + h) + i) * 0.25;
