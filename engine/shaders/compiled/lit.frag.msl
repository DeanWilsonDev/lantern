    float4 color_and_kind;
    float4 direction_and_outer_cosine;
    float4 cone;
};

struct LocalLightUniforms
{
    float4 header;
    LocalLight lights[8];
};

struct LocalLight_1
{
    float4 position_and_range;
    float4 color_and_kind;
    float4 direction_and_outer_cosine;
    float4 cone;
};

struct main0_out
