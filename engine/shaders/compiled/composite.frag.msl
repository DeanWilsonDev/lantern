static inline __attribute__((always_inline))
bool IsBackground(thread const float& depth)
{
    return depth > 0.999989986419677734375;
}

static inline __attribute__((always_inline))
float LinearDistance(thread const float& depth, constant CompositeUniforms& settings)
{
    float depth_range = settings.projection_terms.w;
    return (depth_range * settings.projection_terms.z) / (depth + depth_range);
}

static inline __attribute__((always_inline))
float3 ApplyHeightFog(thread const float3& scene, thread const float3& ray, thread const float& ray_length, constant CompositeUniforms& settings)
{
    float falloff = settings.camera_position_and_falloff.w;
    float base_density = settings.fog_color_and_density.w;
    float height_above_base = settings.camera_position_and_falloff.y - settings.fog_base_and_shaft_decay.x;
    float slope = falloff * ray.y;
    float exponent = fast::clamp((-slope) * ray_length, -30.0, 30.0);
    float _269;
    if (abs(slope) > 9.9999997473787516355514526367188e-05)
    {
        _269 = (1.0 - exp(exponent)) / slope;
    }
    else
    {
        _269 = ray_length;
    }
    float length_term = _269;
    float optical = (base_density * exp(fast::clamp((-falloff) * height_above_base, -30.0, 30.0))) * length_term;
    float fog = 1.0 - exp(-fast::max(optical, 0.0));
    float toward_sun = pow(fast::max(dot(ray, settings.sun_direction_and_scattering.xyz), 0.0), 6.0);
    float3 fog_color = settings.fog_color_and_density.xyz + (settings.sun_color_and_shaft_strength.xyz * (settings.sun_direction_and_scattering.w * toward_sun));
    return mix(scene, fog_color, float3(fast::clamp(fog, 0.0, 1.0)));
}

static inline __attribute__((always_inline))
float3 LightShafts(thread const float2& uv, thread const float3& ray, constant CompositeUniforms& settings, texture2d<float> depth_image, sampler depth_imageSmplr)
{
    float3 sun = settings.sun_direction_and_scattering.xyz;
    float facing = dot(sun, settings.camera_forward.xyz);
    if (facing <= 0.0500000007450580596923828125)
    {
        return float3(0.0);
    }
    float2 sun_ndc = float2(dot(sun, settings.camera_right.xyz) / (facing * settings.projection_terms.x), dot(sun, settings.camera_up.xyz) / (facing * settings.projection_terms.y));
    float2 sun_uv = float2((sun_ndc.x * 0.5) + 0.5, 0.5 - (sun_ndc.y * 0.5));
    float2 step_vector = (sun_uv - uv) / float2(24.0);
    float decay = settings.fog_base_and_shaft_decay.y;
    float weight = 1.0;
    float total = 0.0;
    float total_weight = 0.0;
    float2 position = uv;
    for (int step_index = 0; step_index < 24; step_index++)
    {
        position += step_vector;
        float param = depth_image.sample(depth_imageSmplr, fast::clamp(position, float2(0.0), float2(1.0))).x;
        float sky = float(IsBackground(param));
        total += (sky * weight);
        total_weight += weight;
        weight *= decay;
    }
    float toward_sun = pow(fast::max(dot(ray, sun), 0.0), 3.0);
    float fade_in = smoothstep(0.0500000007450580596923828125, 0.4000000059604644775390625, facing);
    return settings.sun_color_and_shaft_strength.xyz * ((((settings.sun_color_and_shaft_strength.w * toward_sun) * fade_in) * total) / total_weight);
}

static inline __attribute__((always_inline))
float3 AcesFilmic(thread const float3& x)
{
    return fast::clamp((x * ((x * 2.5099999904632568359375) + float3(0.02999999932944774627685546875))) / ((x * ((x * 2.4300000667572021484375) + float3(0.589999973773956298828125))) + float3(0.14000000059604644775390625)), float3(0.0), float3(1.0));
}

static inline __attribute__((always_inline))
float3 PbrNeutral(thread float3& color)
{
    float lowest = fast::min(color.x, fast::min(color.y, color.z));
    float _115;
    if (lowest < 0.07999999821186065673828125)
    {
        _115 = lowest - ((6.25 * lowest) * lowest);
    }
    else
    {
        _115 = 0.039999999105930328369140625;
    }
    float offset = _115;
    color -= float3(offset);
    float peak = fast::max(color.x, fast::max(color.y, color.z));
    if (peak < 0.7599999904632568359375)
    {
        return color;
    }
    float room = 0.23999999463558197021484375;
    float new_peak = 1.0 - ((room * room) / ((peak + room) - 0.7599999904632568359375));
    color *= (new_peak / peak);
    float blend_to_white = 1.0 - (1.0 / ((0.1500000059604644775390625 * (peak - new_peak)) + 1.0));
    return mix(color, float3(1.0) * new_peak, float3(blend_to_white));
}

static inline __attribute__((always_inline))
float3 ToneMap(thread const float3& exposed, thread const float& mapper)
{
    if (mapper > 1.5)
    {
        float3 param = exposed;
        return AcesFilmic(param);
    }
    if (mapper > 0.5)
    {
        float3 param_1 = exposed;
        float3 _199 = PbrNeutral(param_1);
        return fast::clamp(_199, float3(0.0), float3(1.0));
    }
    return fast::clamp(exposed, float3(0.0), float3(1.0));
}

static inline __attribute__((always_inline))
float3 EncodeSrgb(thread const float3& linear_color)
{
    float3 low = linear_color * 12.9200000762939453125;
    float3 high = (pow(linear_color, float3(0.4166666567325592041015625)) * 1.05499994754791259765625) - float3(0.054999999701976776123046875);
    return select(high, low, linear_color <= float3(0.003130800090730190277099609375));
}

fragment main0_out main0(main0_in in [[stage_in]], constant CompositeUniforms& settings [[buffer(0)]], texture2d<float> scene_image [[texture(0)]], texture2d<float> bloom_image [[texture(1)]], texture2d<float> occlusion_image [[texture(2)]], texture2d<float> depth_image [[texture(3)]], sampler scene_imageSmplr [[sampler(0)]], sampler bloom_imageSmplr [[sampler(1)]], sampler occlusion_imageSmplr [[sampler(2)]], sampler depth_imageSmplr [[sampler(3)]])
