#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FxaaUniforms
{
    float4 texel_size;
};

struct main0_out
{
    float4 output_color [[color(0)]];
};

struct main0_in
{
    float2 source_uv [[user(locn0)]];
};

static inline __attribute__((always_inline))
float Luma(thread const float3& color)
{
    return dot(color, float3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625));
}

fragment main0_out main0(main0_in in [[stage_in]], constant FxaaUniforms& settings [[buffer(0)]], texture2d<float> scene_image [[texture(0)]], sampler scene_imageSmplr [[sampler(0)]])
{
    main0_out out = {};
    float2 texel = settings.texel_size.xy;
    float3 middle = scene_image.sample(scene_imageSmplr, in.source_uv).xyz;
    float3 north_west = scene_image.sample(scene_imageSmplr, (in.source_uv + (float2(-1.0) * texel))).xyz;
    float3 north_east = scene_image.sample(scene_imageSmplr, (in.source_uv + (float2(1.0, -1.0) * texel))).xyz;
    float3 south_west = scene_image.sample(scene_imageSmplr, (in.source_uv + (float2(-1.0, 1.0) * texel))).xyz;
    float3 south_east = scene_image.sample(scene_imageSmplr, (in.source_uv + (float2(1.0) * texel))).xyz;
    float3 param = middle;
    float luma_middle = Luma(param);
    float3 param_1 = north_west;
    float luma_north_west = Luma(param_1);
    float3 param_2 = north_east;
    float luma_north_east = Luma(param_2);
    float3 param_3 = south_west;
    float luma_south_west = Luma(param_3);
    float3 param_4 = south_east;
    float luma_south_east = Luma(param_4);
    float luma_lowest = fast::min(luma_middle, fast::min(fast::min(luma_north_west, luma_north_east), fast::min(luma_south_west, luma_south_east)));
    float luma_highest = fast::max(luma_middle, fast::max(fast::max(luma_north_west, luma_north_east), fast::max(luma_south_west, luma_south_east)));
    float contrast = luma_highest - luma_lowest;
    if (contrast < fast::max(0.031199999153614044189453125, luma_highest * 0.125))
    {
        out.output_color = float4(middle, 1.0);
        return out;
    }
    float2 edge_direction;
    edge_direction.x = -((luma_north_west + luma_north_east) - (luma_south_west + luma_south_east));
    edge_direction.y = (luma_north_west + luma_south_west) - (luma_north_east + luma_south_east);
    float direction_reduce = fast::max(((((luma_north_west + luma_north_east) + luma_south_west) + luma_south_east) * 0.25) * 0.125, 0.0078125);
    float direction_scale = 1.0 / (fast::min(abs(edge_direction.x), abs(edge_direction.y)) + direction_reduce);
    edge_direction = fast::clamp(edge_direction * direction_scale, float2(-8.0), float2(8.0)) * texel;
    float3 short_average = (scene_image.sample(scene_imageSmplr, (in.source_uv + (edge_direction * (-0.16666667163372039794921875)))).xyz + scene_image.sample(scene_imageSmplr, (in.source_uv + (edge_direction * 0.16666667163372039794921875))).xyz) * 0.5;
    float3 long_average = (short_average * 0.5) + ((scene_image.sample(scene_imageSmplr, (in.source_uv + (edge_direction * (-0.5)))).xyz + scene_image.sample(scene_imageSmplr, (in.source_uv + (edge_direction * 0.5))).xyz) * 0.25);
    float3 param_5 = long_average;
    float luma_long = Luma(param_5);
    if ((luma_long < luma_lowest) || (luma_long > luma_highest))
    {
        out.output_color = float4(short_average, 1.0);
    }
    else
    {
        out.output_color = float4(long_average, 1.0);
    }
    return out;
}

