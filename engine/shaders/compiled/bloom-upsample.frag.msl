#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct UpsampleUniforms
{
    float4 texel;
};

struct main0_out
{
    float4 output_color [[color(0)]];
};

struct main0_in
{
    float2 source_uv [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant UpsampleUniforms& settings [[buffer(0)]], texture2d<float> smaller_image [[texture(0)]], sampler smaller_imageSmplr [[sampler(0)]])
{
    main0_out out = {};
    float2 step_size = settings.texel.xy;
    float3 total = (((((((smaller_image.sample(smaller_imageSmplr, (in.source_uv + (float2(-1.0) * step_size))).xyz + (smaller_image.sample(smaller_imageSmplr, (in.source_uv + (float2(0.0, -1.0) * step_size))).xyz * 2.0)) + smaller_image.sample(smaller_imageSmplr, (in.source_uv + (float2(1.0, -1.0) * step_size))).xyz) + (smaller_image.sample(smaller_imageSmplr, (in.source_uv + (float2(-1.0, 0.0) * step_size))).xyz * 2.0)) + (smaller_image.sample(smaller_imageSmplr, in.source_uv).xyz * 4.0)) + (smaller_image.sample(smaller_imageSmplr, (in.source_uv + (float2(1.0, 0.0) * step_size))).xyz * 2.0)) + smaller_image.sample(smaller_imageSmplr, (in.source_uv + (float2(-1.0, 1.0) * step_size))).xyz) + (smaller_image.sample(smaller_imageSmplr, (in.source_uv + (float2(0.0, 1.0) * step_size))).xyz * 2.0)) + smaller_image.sample(smaller_imageSmplr, (in.source_uv + (float2(1.0) * step_size))).xyz;
    out.output_color = float4(total / float3(16.0), 1.0);
    return out;
}

