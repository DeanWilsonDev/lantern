#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct TileUniforms
{
    float4x4 light_view_projection;
};

struct ObjectUniforms
{
    float4x4 model;
};

struct main0_out
{
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 input_position [[attribute(0)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant TileUniforms& tile [[buffer(0)]], constant ObjectUniforms& object_uniforms [[buffer(1)]])
{
    main0_out out = {};
    out.gl_Position = tile.light_view_projection * (object_uniforms.model * float4(in.input_position, 1.0));
    return out;
}

