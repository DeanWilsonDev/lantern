lantern :: import lantern;

main :: () -> i32 {
    mixer := lantern:::testing:::QuietMixer();
    defer delete mixer;
    song := lantern:::testing:::AddConstant(mixer, 0.2f, 10);
    mixer->PlayMusic(song);
    output: Array<f32>! = mixer->Mix(1000);
    allLoud~ bool = true;
    for sample in output {
        allLoud = allLoud && sample > 0.1f;
    }
    assert(allLoud, "a ten-frame song fills a thousand frames");
    assert(mixer->ActiveVoiceCount() == 1, "the music keeps its voice");
    delete output;
    print("music loops forever");
    return 0;
}
