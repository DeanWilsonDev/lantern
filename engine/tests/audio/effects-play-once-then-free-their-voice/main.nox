lantern :: import lantern;

main :: () -> i32 {
    mixer := lantern:::testing:::QuietMixer();
    defer delete mixer;
    beep := lantern:::testing:::AddConstant(mixer, 0.1f, 100);
    mixer->Play(beep, 1.0f);
    first: Array<f32>! = mixer->Mix(64);
    assert(first[0] > 0.09f && first[0] < 0.1f, "the beep plays, softly clipped");
    assert(mixer->ActiveVoiceCount() == 1, "the voice is still playing");
    second: Array<f32>! = mixer->Mix(64);
    assert(second[2 * 35] > 0.0f && second[2 * 36] == 0.0f, "the remaining 36 frames, then silence");
    assert(mixer->ActiveVoiceCount() == 0, "the voice is freed");
    delete first;
    delete second;
    print("effects play once then free their voice");
    return 0;
}
