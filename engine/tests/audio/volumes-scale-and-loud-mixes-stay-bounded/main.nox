lantern :: import lantern;

main :: () -> i32 {
    mixer := lantern:::testing:::QuietMixer();
    defer delete mixer;
    loud := lantern:::testing:::AddConstant(mixer, 1.0f, 10);
    for index~ u32 = 0; index < 8; index++ {
        mixer->Play(loud, 1.0f);
    }
    clipped: Array<f32>! = mixer->Mix(10);
    bounded~ bool = true;
    for sample in clipped {
        bounded = bounded && Math:::abs(sample) <= 1.0f;
    }
    assert(bounded, "eight loud voices stay within one");
    mixer->volumes.master = 0.0f;
    mixer->Play(loud, 1.0f);
    muted: Array<f32>! = mixer->Mix(10);
    silent~ bool = true;
    for sample in muted {
        silent = silent && sample == 0.0f;
    }
    assert(silent, "a zero master volume is silent");
    delete clipped;
    delete muted;
    print("volumes scale and loud mixes stay bounded");
    return 0;
}
