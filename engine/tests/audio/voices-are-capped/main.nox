lantern :: import lantern;

main :: () -> i32 {
    mixer := lantern:::testing:::QuietMixer();
    defer delete mixer;
    beep := lantern:::testing:::AddConstant(mixer, 0.01f, 1000);
    for index~ usize = 0; index < lantern:::audio:::MAX_VOICES + 5; index++ {
        mixer->Play(beep, 1.0f);
    }
    assert(mixer->ActiveVoiceCount() == lantern:::audio:::MAX_VOICES, "the oldest voices are stolen");
    print("voices are capped");
    return 0;
}
