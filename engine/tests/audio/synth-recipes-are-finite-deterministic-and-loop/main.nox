lantern :: import lantern;

Check :: (name: string) -> bool {
    first := lantern:::synth:::Make(name);
    second := lantern:::synth:::Make(name);
    healthy~ bool = false;
    if a := first {
        if b := second {
            count: usize = a->samples.length();
            healthy = count > 0 && count == b->samples.length();
            for index~ usize = 0; healthy && index < count; index++ {
                sample: f32 = a->samples[index];
                healthy = Math:::abs(sample) <= 1.0f && sample == b->samples[index];
            }
        }
    }
    if !healthy {
        print(`recipe ${name} is empty, out of range or differs between builds`);
    }
    delete first;
    delete second;
    return healthy;
}

main :: () -> i32 {
    healthyCount~ usize = 0;
    for name in lantern:::synth:::RECIPE_NAMES {
        if Check(name) {
            healthyCount += 1;
        }
    }
    assert(healthyCount == lantern:::synth:::RECIPE_NAMES.length(), "every recipe builds the same finite sound twice");
    unknown := lantern:::synth:::Make("no_such_sound");
    assert(unknown == null, "an unknown name has no recipe");
    delete unknown;
    print("synth recipes are finite and deterministic");
    return 0;
}
