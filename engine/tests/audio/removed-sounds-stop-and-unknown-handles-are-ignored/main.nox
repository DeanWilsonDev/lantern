lantern :: import lantern;

main :: () -> i32 {
    mixer := lantern:::testing:::QuietMixer();
    defer delete mixer;
    beep := lantern:::testing:::AddConstant(mixer, 0.5f, 1000);
    mixer->Play(beep, 1.0f);
    mixer->PlayMusic(beep);
    mixer->RemoveSound(beep);
    assert(mixer->ActiveVoiceCount() == 0, "removing a sound stops it");
    mixer->Play(beep, 1.0f);
    assert(mixer->ActiveVoiceCount() == 0, "a removed sound doesn't play");
    print("removed sounds stop and unknown handles are ignored");
    return 0;
}
