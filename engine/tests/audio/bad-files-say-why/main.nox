lantern :: import lantern;

main :: () -> i32 {
    nope: Array<u8>! = [110, 111, 112, 101];
    notRiff: string! = lantern:::testing:::FailureOf(nope);
    assert(notRiff.contains("RIFF"), "not a RIFF file");
    delete notRiff;
    delete nope;
    silence: Array<f32>! = [0.0f];
    eightBit~ Array<u8>! = lantern:::audio:::EncodeWavMono(silence, 8000);
    eightBit[34] = 8;
    wrongDepth: string! = lantern:::testing:::FailureOf(eightBit);
    assert(wrongDepth.contains("16-bit"), "only 16-bit PCM");
    delete wrongDepth;
    delete eightBit;
    delete silence;
    print("bad files say why");
    return 0;
}
