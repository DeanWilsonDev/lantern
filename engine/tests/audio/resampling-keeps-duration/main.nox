lantern :: import lantern;

main :: () -> i32 {
    samples~ Array<f32>! = [];
    for index~ usize = 0; index < 22050; index++ {
        samples.push(0.25f);
    }
    bytes: Array<u8>! = lantern:::audio:::EncodeWavMono(samples, 22050);
    sound := lantern:::testing:::DecodeOrExit(bytes);
    defer delete sound;
    resampled := sound->Resampled(48000);
    defer delete resampled;
    assert(Math:::abs(resampled->DurationSeconds() - 1.0f) < 0.001f, "still one second");
    assert(Math:::abs(resampled->samples[100] - 0.25f) < 0.001f, "the level is kept");
    delete samples;
    delete bytes;
    print("resampling keeps duration");
    return 0;
}
