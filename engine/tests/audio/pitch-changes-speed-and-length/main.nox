lantern :: import lantern;

main :: () -> i32 {
    mixer := lantern:::testing:::QuietMixer();
    defer delete mixer;
    beep := lantern:::testing:::AddConstant(mixer, 0.3f, 400);
    mixer->PlayOn(beep, lantern:::audio:::BUS_SFX, 1.0f, 2.0f);
    assert(mixer->ActiveVoiceCount() == 1, "the voice starts");
    block: Array<f32>! = mixer->Mix(150);
    assert(mixer->ActiveVoiceCount() == 1, "at double speed 400 frames last 200");
    delete block;
    second: Array<f32>! = mixer->Mix(100);
    assert(mixer->ActiveVoiceCount() == 0, "and it is done after 200 frames");
    assert(second[99] > 0.0f && second[101] == 0.0f, "the sound stops partway through the block");
    delete second;
    mixer->PlayOn(beep, lantern:::audio:::BUS_SFX, 1.0f, 0.5f);
    third: Array<f32>! = mixer->Mix(700);
    assert(mixer->ActiveVoiceCount() == 1, "at half speed 400 frames last 800");
    delete third;
    print("pitch changes speed and length");
    return 0;
}
