lantern :: import lantern;

main :: () -> i32 {
    samples: Array<f32>! = [0.0f, 0.5f, -0.5f, 1.0f];
    bytes: Array<u8>! = lantern:::audio:::EncodeWavMono(samples, 22050);
    sound := lantern:::testing:::DecodeOrExit(bytes);
    defer delete sound;
    assert(sound->sampleRate == 22050, "the rate survives");
    assert(sound->FrameCount() == 4, "four frames");
    assert(Math:::abs(sound->samples[2] - 0.5f) < 0.001f && Math:::abs(sound->samples[3] - 0.5f) < 0.001f, "mono becomes both channels");
    delete samples;
    delete bytes;
    print("mono round trips as stereo");
    return 0;
}
