lantern :: import lantern;

main :: () -> i32 {
    overlay := new lantern:::renderer:::Overlay();
    defer delete overlay;
    values := new lantern:::core:::DebugValues();
    defer delete values;
    values->SetNumber("Player/Speed", 3.5f);
    values->SetInteger("Frame/FPS", 60);
    hud := new lantern:::debug:::DebugHud();
    defer delete hud;
    hud->Draw(values, overlay, Vec2 { }, 1.0f);
    assert(overlay->vertices.length() > 6 * 10, "the background quad plus two group headers, two names and two values");
    print("visible hud draws a panel and text");
    return 0;
}
