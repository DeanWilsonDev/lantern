lantern :: import lantern;

main :: () -> i32 {
    overlay := new lantern:::renderer:::Overlay();
    defer delete overlay;
    values := new lantern:::core:::DebugValues();
    defer delete values;
    pages := new lantern:::debug:::PageAssignments();
    defer delete pages;
    values->SetNumber("Player/Speed", 3.5f);
    window := new lantern:::debug:::DebugWindow();
    defer delete window;
    window->visible = false;
    window->Draw(values, pages, overlay, Vec2 { x: 1280.0f, y: 720.0f }, 1.0f);
    assert(overlay->vertices.length() == 0, "a hidden window draws nothing");
    window->Toggle();
    window->Draw(values, pages, overlay, Vec2 { x: 1280.0f, y: 720.0f }, 1.0f);
    assert(overlay->vertices.length() > 0, "toggling shows it");
    window->focused = true;
    window->Toggle();
    assert(!window->visible && !window->focused, "hiding it gives the game its input back");
    tiny := new lantern:::renderer:::Overlay();
    defer delete tiny;
    window->Toggle();
    window->Draw(values, pages, tiny, Vec2 { x: 100.0f, y: 60.0f }, 1.0f);
    assert(tiny->vertices.length() == 0, "a screen too small for the window draws nothing, not a broken one");
    print("hidden window draws nothing");
    return 0;
}
