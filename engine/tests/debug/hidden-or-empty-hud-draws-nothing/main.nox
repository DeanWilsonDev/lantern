lantern :: import lantern;

main :: () -> i32 {
    overlay := new lantern:::renderer:::Overlay();
    defer delete overlay;
    values := new lantern:::core:::DebugValues();
    defer delete values;
    hud := new lantern:::debug:::DebugHud();
    defer delete hud;
    hud->Draw(values, overlay, Vec2 { }, 1.0f);
    assert(overlay->vertices.length() == 0, "an empty list draws nothing");
    values->SetNumber("Player/Speed", 3.5f);
    hud->visible = false;
    hud->Draw(values, overlay, Vec2 { }, 1.0f);
    assert(overlay->vertices.length() == 0, "a hidden HUD draws nothing");
    print("hidden or empty hud draws nothing");
    return 0;
}
