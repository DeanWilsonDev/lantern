// The debug window draws its tabs and rows, with the All page holding every value, the known pages first in order, then
// the player and companion pages, and unlisted pages after.
lantern :: import lantern;

main :: () -> i32 {
    overlay := new lantern:::renderer:::Overlay();
    defer delete overlay;
    values := new lantern:::core:::DebugValues();
    defer delete values;
    pages := new lantern:::debug:::PageAssignments();
    defer delete pages;
    values->SetNumber("Player/Speed", 3.5f);
    values->SetInteger("Frame/FPS", 60);
    values->SetInteger("Audio/Underruns", 2);
    values->SetText("Anchor/Ready", "yes");
    values->SetText("Companion/Mode", "leading");
    values->SetText("Racing/Lap", "3");
    window := new lantern:::debug:::DebugWindow();
    defer delete window;
    window->Draw(values, pages, overlay, Vec2 { x: 1280.0f, y: 720.0f }, 1.0f);
    assert(overlay->vertices.length() > 6 * 40, "the window, its tabs and its rows draw");

    summary := lantern:::debug:::SummarisePages(values, pages, "");
    defer delete summary;
    assert(summary->names.length() == 6, "All, Frame, Audio, Player, Companion and the unlisted Racing page");
    assert(summary->names[0] == "All" && summary->counts[0] == 6, "All holds every value");
    assert(summary->names[1] == "Frame" && summary->names[2] == "Audio", "the known pages come first, in order");
    assert(summary->names[3] == "Player" && summary->names[4] == "Companion", "player and companion follow");
    assert(summary->names[5] == "Racing", "an unlisted group is a page of its own");
    assert(summary->counts[4] == 2, "Anchor values share the Companion page");
    pages->Assign("Racing", "Game");
    other := lantern:::debug:::SummarisePages(values, pages, "");
    defer delete other;
    assert(other->IndexOf("Racing") == null && other->IndexOf("Game") != null, "Assign moves a group to another page");
    print("the window draws pages and values");
    return 0;
}
