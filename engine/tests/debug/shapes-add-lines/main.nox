lantern :: import lantern;

main :: () -> i32 {
    renderWorld := new lantern:::renderer:::RenderWorld();
    defer delete renderWorld;
    white := lantern:::core:::Color:::White();
    lantern:::debug:::Capsule(renderWorld, Vec3 { }, 0.5f, 0.5f, white);
    afterCapsule: usize = renderWorld->lines.length();
    assert(afterCapsule > 0, "a capsule draws lines");
    triangles: Array<lantern:::renderer:::Triangle>! = [lantern:::renderer:::Triangle { first: Vec3 { }, second: Vec3 { x: 1.0f, y: 0.0f, z: 0.0f }, third: Vec3 { x: 0.0f, y: 0.0f, z: 1.0f } }];
    lantern:::debug:::TriangleEdges(renderWorld, triangles, white);
    delete triangles;
    assert(renderWorld->lines.length() == afterCapsule + 6, "a triangle's three edges are six line vertices");
    print("shapes add lines");
    return 0;
}
