lantern :: import lantern;

main :: () -> i32 {
    values := new lantern:::core:::DebugValues();
    defer delete values;
    pages := new lantern:::debug:::PageAssignments();
    defer delete pages;
    for index~ i64 = 0; index < 60; index++ {
        name: string! = `Player/Value ${index}`;
        values->SetInteger(name, index);
        delete name;
    }
    values->SetText("Frame/FPS", "60");
    window := new lantern:::debug:::DebugWindow();
    defer delete window;
    window->visible = true;
    small := new lantern:::renderer:::Overlay();
    defer delete small;
    window->Draw(values, pages, small, Vec2 { x: 640.0f, y: 360.0f }, 1.0f);
    for vertex in small->vertices {
        assert(vertex.position[0] <= 640.0f && vertex.position[1] <= 360.0f, "nothing is drawn past the screen's edge");
    }
    assert(window->visibleRowCount < 25, "a small screen shows fewer rows");
    window->SelectPage("Player");
    window->ScrollBy(5);
    window->Draw(values, pages, small, Vec2 { x: 640.0f, y: 360.0f }, 1.0f);
    assert(window->scroll == 5, "Down scrolls by a line");
    window->ScrollBy(1000);
    window->Draw(values, pages, small, Vec2 { x: 640.0f, y: 360.0f }, 1.0f);
    assert(window->scroll == 61 - window->visibleRowCount, "scrolling stops with the last row at the bottom");
    window->ScrollBy(-1000);
    assert(window->scroll == 0, "scrolling up stops at the top");
    window->ScrollWheel(-1.0f);
    assert(window->scroll == 3, "a wheel turn away from the top scrolls three lines");
    window->SelectPage("Frame");
    assert(window->scroll == 0, "a new page starts at the top");

    large := new lantern:::renderer:::Overlay();
    defer delete large;
    window->Draw(values, pages, large, Vec2 { x: 2560.0f, y: 1440.0f }, 2.0f);
    for vertex in large->vertices {
        assert(vertex.position[0] <= 2560.0f && vertex.position[1] <= 1440.0f, "a large screen at a larger scale fits too");
    }
    print("pages fit the screen and scroll");
    return 0;
}
