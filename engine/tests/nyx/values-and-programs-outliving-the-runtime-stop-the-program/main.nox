NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    runtime := new lantern:::nyx:::Runtime();
    program := lantern:::testing:::Mount(runtime, "Answer :: () -> i32 { return 42; }");
    answer := runtime->MakeI32(42);
    delete runtime;
    print("the runtime was deleted with a value and a program alive");
    delete answer;
    delete program;
    return 0;
}
