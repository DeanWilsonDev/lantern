NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    runtime := new lantern:::nyx:::Runtime();
    failed := runtime->RegisterFunction("Scale", "(value: i32, factor: i32) -> i32", new (context: lantern:::nyx:::CallContext~*) -> void {
        value: i32 = context->I32(0);
        factor: i32 = context->I32(1);
        context->ReturnI32(value * factor);
    });
    failedStatus: NyxC:::nyx_status = lantern:::testing:::StatusOf(failed!);
    assert(failedStatus == NyxC:::NYX_OK, "Scale registers");
    manifest: string! = lantern:::testing:::TextOrFail(runtime->WriteHostSurface());
    assert(manifest.contains("\"name\": \"Scale\""), "the manifest names Scale");
    assert(manifest.contains("\"signature\": \"(value: i32, factor: i32) -> i32\""), "the manifest has its signature");
    delete manifest;
    delete runtime;
    print("the host surface lists registered functions");
    return 0;
}
