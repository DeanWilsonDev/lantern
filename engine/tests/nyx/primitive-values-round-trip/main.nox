NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    runtime := new lantern:::nyx:::Runtime();
    yes := runtime->MakeBool(true);
    assert(lantern:::testing:::BoolOrFail(yes->Bool()), "true round trips");
    delete yes;
    negative := runtime->MakeI32(-7);
    assert(lantern:::testing:::I32OrFail(negative->I32()) == -7, "an i32 round trips");
    delete negative;
    big := runtime->MakeI64(1099511627776);
    assert(lantern:::testing:::I64OrFail(big->I64()) == 1099511627776, "an i64 round trips");
    delete big;
    half := runtime->MakeF32(2.5f);
    assert(lantern:::testing:::F32OrFail(half->F32()) == 2.5f, "an f32 round trips");
    delete half;
    eighth := runtime->MakeF64(0.125f);
    assert(lantern:::testing:::F64OrFail(eighth->F64()) == 0.125f, "an f64 round trips");
    delete eighth;
    accented := runtime->MakeString("héllo");
    accentedText: string! = lantern:::testing:::TextOrFail(accented->Text());
    assert(accentedText == "héllo", "a string round trips");
    delete accentedText;
    delete accented;
    empty := runtime->MakeString("");
    emptyText: string! = lantern:::testing:::TextOrFail(empty->Text());
    assert(emptyText == "", "an empty string round trips");
    delete emptyText;
    delete empty;
    nothing := runtime->MakeNull();
    assert(nothing->IsNull(), "null is null");
    delete nothing;
    delete runtime;
    print("primitive values round trip");
    return 0;
}
