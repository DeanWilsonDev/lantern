NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    runtime := new lantern:::nyx:::Runtime();
    failed := runtime->RegisterFunction("Spawn", "() -> i32", new (context: lantern:::nyx:::CallContext~*) -> void {
        context->Refuse("the world is full");
    });
    failedStatus: NyxC:::nyx_status = lantern:::testing:::StatusOf(failed!);
    assert(failedStatus == NyxC:::NYX_OK, "Spawn registers");
    program := lantern:::testing:::Mount(runtime, "Run :: () -> i32 { return Spawn(); }");
    noArguments: Array<lantern:::nyx:::Value*>! = [];
    error := lantern:::testing:::ErrorOrFail(program->CallFunction("Run", noArguments));
    delete noArguments;
    assert(error->status == NyxC:::NYX_ERROR_RUNTIME, "a refusal is a runtime error");
    assert(error->message.contains("the world is full"), "it carries the host's message");
    delete error;
    delete program;
    delete runtime;
    print("a refusal stops the call with its message");
    return 0;
}
