NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    runtime := new lantern:::nyx:::Runtime();
    error := lantern:::testing:::ValueOrFail(runtime->MakeError("Error::Unknown", "despawned"));
    variant: string! = lantern:::testing:::TextOrFail(error->ErrorVariant());
    message: string! = lantern:::testing:::TextOrFail(error->ErrorMessage());
    assert(variant == "Error::Unknown", "the variant is kept");
    assert(message == "despawned", "the message is kept");
    delete variant;
    delete message;
    delete error;
    delete runtime;
    print("error values carry their variant and message");
    return 0;
}
