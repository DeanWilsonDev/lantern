// The Nyx header the engine was built against and the Nyx library it is linked to report the same version.
NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    assert(lantern:::nyx:::CapiVersion() == lantern:::nyx:::HEADER_VERSION, "the header and library versions match");
    print("reports the header and library versions");
    return 0;
}
