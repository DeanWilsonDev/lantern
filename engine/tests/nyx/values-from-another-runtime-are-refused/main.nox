NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    first := new lantern:::nyx:::Runtime();
    second := new lantern:::nyx:::Runtime();
    program := lantern:::testing:::Mount(first, "Echo :: (value: i32) -> i32 { return value; }");
    foreign := second->MakeI32(1);
    arguments: Array<lantern:::nyx:::Value*>! = [foreign];
    error := lantern:::testing:::ErrorOrFail(program->CallFunction("Echo", arguments));
    delete arguments;
    assert(error->status == NyxC:::NYX_ERROR_INVALID_ARGUMENT, "the status is an invalid argument");
    delete error;
    delete foreign;
    delete program;
    delete first;
    delete second;
    print("values from another runtime are refused");
    return 0;
}
