NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    runtime := new lantern:::nyx:::Runtime();
    number := runtime->MakeI32(3);
    read := number->ArrayLength();
    when read! {
        Result:::Ok(length) -> {
            assert(false, "an i32 has no array length");
        },
        Result:::Err(error) -> {
            assert(error->status == NyxC:::NYX_ERROR_TYPE_MISMATCH, "the status is a type mismatch");
            assert(error->message == "the value is i32, not array", "the message names both kinds");
            delete error;
        }
    }
    delete number;
    delete runtime;
    print("reading the wrong kind is a type mismatch");
    return 0;
}
