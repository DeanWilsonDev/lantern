lantern :: import lantern;

main :: () -> i32 {
    audio := new lantern:::engine:::AudioSystem(null);
    defer delete audio;
    loaded := audio->LoadSound("jump", "does/not/exist.wav");
    assert(loaded == null, "a missing file loads nothing");
    audio->Play("jump", 1.0f);
    audio->PlayMusic("theme");
    audio->Update();
    assert(!audio->Stats().hasDevice, "there's no device");
    print("missing device and missing sounds are not errors");
    return 0;
}
