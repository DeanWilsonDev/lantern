lantern :: import lantern;

main :: () -> i32 {
    rates: f64[4] = [30.0f, 60.0f, 144.0f, 250.0f];
    for rate in rates {
        rateLoop := lantern:::testing:::MakeLoop();
        ratePlatform := new lantern:::testing:::ScriptedPlatform();
        rateGame := new lantern:::testing:::RecordingGame();
        frameCount: usize = usize(rate) * 2;
        for frame~ usize = 0; frame <= frameCount; frame++ {
            ratePlatform->AddFrame(f64(frame) / rate);
        }
        lantern:::testing:::RunScript(rateLoop, ratePlatform, rateGame);
        print(`${rate:.0f} Hz moved ${rateGame->position:.2f}`);
        assert(Math:::abs(rateGame->position - 6.0f) < 0.06f, "the distance doesn't depend on the frame rate");
        delete rateLoop;
        delete ratePlatform;
        delete rateGame;
    }
    return 0;
}
