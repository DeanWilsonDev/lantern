lantern :: import lantern;

main :: () -> i32 {
    fake := new lantern:::testing:::FakeSink();
    audio := new lantern:::engine:::AudioSystem(fake!);
    defer delete audio;
    audio->Update();
    assert(lantern:::testing:::QueuedFramesOf(audio) == 60, "60 ms at 1 kHz");
    lantern:::testing:::PlayFramesDownTo(audio, 45);
    audio->Update();
    assert(lantern:::testing:::QueuedFramesOf(audio) == 60, "the 15 frames played are topped up");
    assert(lantern:::testing:::PushedSamplesOf(audio) == 75 * 2, "75 frames pushed in all");
    assert(audio->Stats().underrunCount == 0, "no underrun yet");
    lantern:::testing:::PlayFramesDownTo(audio, 0);
    audio->Update();
    assert(audio->Stats().underrunCount == 1, "an empty queue after pushing is an underrun");
    print("update tops the queue up to the target");
    return 0;
}
