lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    mover := world->Spawn("mover", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    world->StorePreviousTransforms();
    if record ~= world->BorrowMutable(mover) {
        record->local.translation = Vec3 { x: 2.0f, y: 0.0f, z: 0.0f };
    }
    world->UpdateWorldTransforms();
    halfway~ Mat4 = Mat4 { };
    if record := world->Get(mover) {
        halfway = record.InterpolatedWorld(0.5f);
    }
    assert(lantern:::testing:::Near3(lantern:::core:::MatrixColumn3(halfway, 3), Vec3 { x: 1.0f, y: 0.0f, z: 0.0f }), "halfway between the steps");
    world->Teleport(mover, Vec3 { x: 10.0f, y: 0.0f, z: 0.0f });
    snapped~ Mat4 = Mat4 { };
    if record := world->Get(mover) {
        snapped = record.InterpolatedWorld(0.5f);
    }
    assert(lantern:::testing:::Near3(lantern:::core:::MatrixColumn3(snapped, 3), Vec3 { x: 10.0f, y: 0.0f, z: 0.0f }), "teleports don't interpolate");
    print("interpolation blends previous and current steps");
    return 0;
}
