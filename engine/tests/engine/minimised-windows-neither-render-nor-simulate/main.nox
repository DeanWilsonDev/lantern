lantern :: import lantern;

main :: () -> i32 {
    frameLoop := lantern:::testing:::MakeLoop();
    defer delete frameLoop;
    platform := new lantern:::testing:::ScriptedPlatform();
    defer delete platform;
    game := new lantern:::testing:::RecordingGame();
    defer delete game;
    platform->AddFrame(0.0f);
    platform->AddFrameWith(0.016f, lantern:::platform:::PlatformEvent:::WindowMinimized);
    for frame~ usize = 2; frame < 10; frame++ {
        platform->AddFrame(f64(frame) * 0.016f);
    }
    platform->AddFrameWith(0.5f, lantern:::platform:::PlatformEvent:::WindowRestored);
    lantern:::testing:::RunScript(frameLoop, platform, game);
    print(`renders ${game->renders}`);
    assert(game->steps <= 2, "the simulation pauses while minimised");
    print("the simulation paused");
    return 0;
}
