lantern :: import lantern;

main :: () -> i32 {
    fixture := new lantern:::testing:::InputFixture();
    defer delete fixture;
    router: lantern:::engine:::InputRouter~* = fixture->router;
    jump := fixture->jump;
    lantern:::testing:::FrameWith(router, lantern:::testing:::SpaceDown());
    first := router->TakeFixedStepSnapshot();
    defer delete first;
    second := router->TakeFixedStepSnapshot();
    defer delete second;
    assert(first->Pressed(jump), "the first step sees the press");
    assert(!second->Pressed(jump) && second->Held(jump), "the second only sees it held");
    print("only the first step sees the press");
    return 0;
}
