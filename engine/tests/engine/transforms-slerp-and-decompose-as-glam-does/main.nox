lantern :: import lantern;

QuaternionText :: (rotation: Quaternion) -> string! {
    return `${rotation.x} ${rotation.y} ${rotation.z} ${rotation.w}`;
}

main :: () -> i32 {
    start: Quaternion = lantern:::core:::QuaternionFromEulerYxz(0.3f, -0.2f, 0.1f);
    end: Quaternion = lantern:::core:::QuaternionFromEulerYxz(2.0f, 0.5f, -0.4f);
    blended: string! = QuaternionText(lantern:::core:::QuaternionSlerp(start, end, 0.25f));
    print(blended);
    delete blended;
    matrix: Mat4 = lantern:::core:::MatrixFromScaleRotationTranslation(Vec3 { x: 2.0f, y: 0.5f, z: 1.5f }, end, Vec3 { x: 1.0f, y: -2.0f, z: 3.0f });
    parts: lantern:::core:::MatrixParts = lantern:::core:::DecomposeMatrix(matrix);
    rotation: string! = QuaternionText(parts.rotation);
    print(`${parts.scale.x} ${parts.scale.y} ${parts.scale.z} | ${rotation} | ${parts.translation.x} ${parts.translation.y} ${parts.translation.z}`);
    delete rotation;
    print(`${lantern:::core:::Determinant4(matrix)}`);
    print("transforms slerp and decompose as glam does");
    return 0;
}
