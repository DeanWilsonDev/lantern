lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    child := world->Spawn("child", lantern:::testing:::Level(), lantern:::engine:::Transform:::FromTranslation(Vec3 { x: 1.0f, y: 0.0f, z: 0.0f }));
    parent := world->Spawn("parent", lantern:::testing:::Level(), lantern:::engine:::Transform:::FromTranslation(Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }));
    attached := world->SetParent(child, parent);
    assert(attached == lantern:::engine:::ParentChange:::Done, "the child attaches");
    world->UpdateWorldTransforms();
    assert(lantern:::testing:::Near3(lantern:::testing:::PositionOf(world, child), Vec3 { x: 1.0f, y: 1.0f, z: 0.0f }), "the parent updates first");
    print("a child spawned before its parent still updates after it");
    return 0;
}
