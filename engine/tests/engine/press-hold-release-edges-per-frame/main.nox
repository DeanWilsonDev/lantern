lantern :: import lantern;

main :: () -> i32 {
    fixture := new lantern:::testing:::InputFixture();
    defer delete fixture;
    router: lantern:::engine:::InputRouter~* = fixture->router;
    jump := fixture->jump;
    lantern:::testing:::FrameWith(router, lantern:::testing:::SpaceDown());
    lantern:::testing:::Report("pressed", router->FrameSnapshot()->State(jump));
    lantern:::testing:::EmptyFrame(router);
    lantern:::testing:::Report("holding", router->FrameSnapshot()->State(jump));
    lantern:::testing:::FrameWith(router, lantern:::testing:::SpaceUp());
    lantern:::testing:::Report("released", router->FrameSnapshot()->State(jump));
    return 0;
}
