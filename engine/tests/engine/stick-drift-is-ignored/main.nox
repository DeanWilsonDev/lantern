lantern :: import lantern;

main :: () -> i32 {
    fixture := new lantern:::testing:::InputFixture();
    defer delete fixture;
    router: lantern:::engine:::InputRouter~* = fixture->router;
    movement := fixture->movement;
    lantern:::testing:::FrameWith(router, lantern:::platform:::PlatformEvent:::GamepadAxisMoved(lantern:::core:::GamepadAxis:::LeftY, 0.1f));
    assert(!router->FrameSnapshot()->Held(movement), "drift reads as idle");
    print("stick drift is ignored");
    return 0;
}
