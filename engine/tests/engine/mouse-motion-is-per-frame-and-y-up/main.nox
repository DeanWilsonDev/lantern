lantern :: import lantern;

main :: () -> i32 {
    fixture := new lantern:::testing:::InputFixture();
    defer delete fixture;
    router: lantern:::engine:::InputRouter~* = fixture->router;
    look := fixture->look;
    lantern:::testing:::FrameWithBoth(router, lantern:::platform:::PlatformEvent:::MouseMoved(4.0f, 2.0f, 104.0f, 102.0f), lantern:::platform:::PlatformEvent:::MouseMoved(6.0f, 0.0f, 110.0f, 102.0f));
    assert(router->FrameSnapshot()->Vector(look) == Vec2 { x: 5.0f, y: -1.0f }, "motion sums, scaled, with y up");
    lantern:::testing:::EmptyFrame(router);
    assert(router->FrameSnapshot()->Vector(look) == Vec2 { }, "the next frame has no motion");
    print("mouse motion is per frame with y up");
    return 0;
}
