lantern :: import lantern;

main :: () -> i32 {
    fixture := new lantern:::testing:::InputFixture();
    defer delete fixture;
    router: lantern:::engine:::InputRouter~* = fixture->router;
    jump := fixture->jump;
    lantern:::testing:::FrameWithBoth(router, lantern:::testing:::SpaceDown(), lantern:::testing:::SpaceUp());
    assert(router->FrameSnapshot()->Pressed(jump), "the tap is a press");
    lantern:::testing:::EmptyFrame(router);
    assert(router->FrameSnapshot()->Released(jump), "and a release on the next frame");
    print("a tap is one press");
    return 0;
}
