lantern :: import lantern;

main :: () -> i32 {
    frameLoop := lantern:::testing:::MakeLoop();
    defer delete frameLoop;
    platform := new lantern:::testing:::ScriptedPlatform();
    defer delete platform;
    game := new lantern:::testing:::RecordingGame();
    defer delete game;
    for frame~ usize = 0; frame < 40; frame++ {
        if frame == 5 {
            platform->AddFrameWith(f64(frame) / 240.0f, lantern:::platform:::PlatformEvent:::KeyDown(lantern:::core:::KeyCode:::Space, false));
        } else {
            platform->AddFrame(f64(frame) / 240.0f);
        }
    }
    lantern:::testing:::RunScript(frameLoop, platform, game);
    print(`jumps seen ${game->jumpsSeen}`);
    return 0;
}
