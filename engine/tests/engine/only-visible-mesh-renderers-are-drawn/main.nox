lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    mesh := lantern:::core:::HandleFromBits<lantern:::renderer:::MeshTag>(0);
    red := lantern:::core:::Color { r: 1.0f, g: 0.0f, b: 0.0f, a: 1.0f };
    world->Spawn("empty", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    world->SpawnMesh("shown", lantern:::testing:::Level(), lantern:::engine:::Transform:::FromTranslation(Vec3 { x: 1.0f, y: 0.0f, z: 0.0f }), lantern:::engine:::MeshRenderer:::Create(mesh, null, red));
    hidden := world->SpawnMesh("hidden", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity(), lantern:::engine:::MeshRenderer:::Create(mesh, null, red));
    if record ~= world->BorrowMutable(hidden) {
        if renderer := record->meshRenderer {
            hiddenRenderer~ lantern:::engine:::MeshRenderer = renderer;
            hiddenRenderer.visible = false;
            record->meshRenderer = hiddenRenderer;
        }
    }
    renderWorld := new lantern:::renderer:::RenderWorld();
    defer delete renderWorld;
    lantern:::engine:::ExtractDraws(world, 1.0f, renderWorld);
    assert(renderWorld->draws.length() == 1, "one draw");
    assert(lantern:::core:::MatrixColumn3(renderWorld->draws[0].transform, 3) == Vec3 { x: 1.0f, y: 0.0f, z: 0.0f }, "at the shown entity");
    print("only visible mesh renderers are drawn");
    return 0;
}
