lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    camera := world->Spawn("camera", lantern:::engine:::PersistentScene(), lantern:::engine:::Transform:::Identity());
    for index~ u32 = 0; index < 5; index++ {
        name: string! = `block ${index}`;
        world->Spawn(name, lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
        delete name;
    }
    assert(world->DespawnScene(lantern:::testing:::Level()) == 5, "the level's five blocks go");
    assert(world->Length() == 1, "one entity is left");
    assert(world->Contains(camera), "the camera stays");
    print("leaving a scene removes only its entities");
    return 0;
}
