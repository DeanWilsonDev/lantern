lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    platform := world->Spawn("platform", lantern:::testing:::Level(), lantern:::engine:::Transform:::FromTranslation(Vec3 { x: 5.0f, y: 0.0f, z: 0.0f }));
    crateOnTop := world->Spawn("crate", lantern:::testing:::Level(), lantern:::engine:::Transform:::FromTranslation(Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }));
    attached := world->SetParent(crateOnTop, platform);
    assert(attached == lantern:::engine:::ParentChange:::Done, "the crate attaches");
    world->UpdateWorldTransforms();
    assert(lantern:::testing:::Near3(lantern:::testing:::PositionOf(world, crateOnTop), Vec3 { x: 5.0f, y: 1.0f, z: 0.0f }), "the crate sits on the platform");
    if record ~= world->BorrowMutable(platform) {
        record->local.translation.x = 7.0f;
    }
    world->UpdateWorldTransforms();
    assert(lantern:::testing:::Near3(lantern:::testing:::PositionOf(world, crateOnTop), Vec3 { x: 7.0f, y: 1.0f, z: 0.0f }), "the crate moves with the platform");
    print("children follow their parents");
    return 0;
}
