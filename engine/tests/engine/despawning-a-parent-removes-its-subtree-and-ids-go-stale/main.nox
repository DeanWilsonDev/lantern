lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    root := world->Spawn("root", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    child := world->Spawn("child", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    attached := world->SetParent(child, root);
    assert(attached == lantern:::engine:::ParentChange:::Done, "the child attaches");
    removedCount := world->Despawn(root);
    assert(removedCount == 2, "the root and its child go");
    assert(!world->Contains(child), "the child's id is stale");
    reused := world->Spawn("new", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    assert(world->Get(root) == null && world->Get(reused) != null, "a reused slot doesn't revive the old id");
    print("despawning a parent removes its subtree and ids go stale");
    return 0;
}
