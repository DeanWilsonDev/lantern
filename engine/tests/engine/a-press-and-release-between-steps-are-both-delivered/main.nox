lantern :: import lantern;

main :: () -> i32 {
    fixture := new lantern:::testing:::InputFixture();
    defer delete fixture;
    router: lantern:::engine:::InputRouter~* = fixture->router;
    jump := fixture->jump;
    lantern:::testing:::FrameWith(router, lantern:::testing:::SpaceDown());
    lantern:::testing:::FrameWith(router, lantern:::testing:::SpaceUp());
    step := router->TakeFixedStepSnapshot();
    defer delete step;
    assert(step->Pressed(jump) && step->Released(jump) && !step->Held(jump), "both edges reach the step");
    print("both edges are delivered");
    return 0;
}
