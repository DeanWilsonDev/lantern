lantern :: import lantern;

main :: () -> i32 {
    fixture := new lantern:::testing:::InputFixture();
    defer delete fixture;
    router: lantern:::engine:::InputRouter~* = fixture->router;
    movement := fixture->movement;
    lantern:::testing:::FrameWithBoth(router, lantern:::platform:::PlatformEvent:::KeyDown(lantern:::core:::KeyCode:::W, false), lantern:::platform:::PlatformEvent:::KeyDown(lantern:::core:::KeyCode:::D, false));
    diagonal := router->FrameSnapshot()->Vector(movement);
    assert(Math:::abs(lantern:::core:::Vec2Length(diagonal) - 1.0f) < 0.000001f, "the diagonal is unit length");
    lantern:::testing:::FrameWith(router, lantern:::platform:::PlatformEvent:::GamepadAxisMoved(lantern:::core:::GamepadAxis:::LeftX, 1.0f));
    assert(lantern:::core:::Vec2Length(router->FrameSnapshot()->Vector(movement)) <= 1.0f + 0.000001f, "combined input is clamped");
    print("keyboard and stick combine within unit length");
    return 0;
}
