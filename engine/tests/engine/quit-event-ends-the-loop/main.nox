lantern :: import lantern;

main :: () -> i32 {
    frameLoop := lantern:::testing:::MakeLoop();
    defer delete frameLoop;
    platform := new lantern:::testing:::ScriptedPlatform();
    defer delete platform;
    game := new lantern:::testing:::RecordingGame();
    defer delete game;
    platform->AddFrame(0.0f);
    platform->AddFrameWith(0.016f, lantern:::platform:::PlatformEvent:::QuitRequested);
    platform->AddFrame(0.032f);
    firstStatus := frameLoop->RunFrame(platform, game);
    assert(firstStatus == lantern:::engine:::LoopStatus:::Running, "the first frame keeps running");
    secondStatus := frameLoop->RunFrame(platform, game);
    assert(secondStatus == lantern:::engine:::LoopStatus:::Finished, "the quit frame finishes");
    print("a quit event ends the loop");
    return 0;
}
