lantern :: import lantern;

QuaternionText :: (rotation: Quaternion) -> string! {
    return `${rotation.x} ${rotation.y} ${rotation.z} ${rotation.w}`;
}

main :: () -> i32 {
    start: Quaternion = lantern:::core:::QuaternionFromEulerYxz(0.3f, -0.2f, 0.1f);
    ends: Array<Quaternion>! = [
        lantern:::core:::QuaternionFromEulerYxz(2.0f, 0.5f, -0.4f),
        lantern:::core:::QuaternionFromEulerYxz(-1.2f, 0.9f, 0.3f),
        lantern:::core:::QuaternionFromEulerYxz(3.0f, -0.7f, 1.1f)];
    amounts: Array<f32>! = [0.0f, 0.1f, 0.5f, 0.9f, 1.0f];
    for end in ends {
        for amount in amounts {
            blended: string! = QuaternionText(lantern:::core:::QuaternionSlerp(start, end, amount));
            print(blended);
            delete blended;
        }
    }
    for index~ usize = 0; index < ends.length(); index++ {
        matrix: Mat4 = lantern:::core:::MatrixFromScaleRotationTranslation(Vec3 { x: 2.0f, y: 0.5f, z: 1.5f + f32(index) }, ends[index], Vec3 { x: 1.0f, y: -2.0f, z: 3.0f });
        parts: lantern:::core:::MatrixParts = lantern:::core:::DecomposeMatrix(matrix);
        rotation: string! = QuaternionText(parts.rotation);
        print(`${parts.scale.x} ${parts.scale.y} ${parts.scale.z} | ${rotation} | ${parts.translation.x} ${parts.translation.y} ${parts.translation.z}`);
        delete rotation;
        print(`${lantern:::core:::Determinant4(matrix)}`);
    }
    delete ends;
    delete amounts;
    print("transforms slerp and decompose as glam scalar math does");
    return 0;
}
