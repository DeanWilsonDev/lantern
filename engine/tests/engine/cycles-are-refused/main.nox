lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    a := world->Spawn("a", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    b := world->Spawn("b", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    c := world->Spawn("c", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    assert(world->SetParent(b, a) == lantern:::engine:::ParentChange:::Done, "b goes under a");
    assert(world->SetParent(c, b) == lantern:::engine:::ParentChange:::Done, "c goes under b");
    assert(world->SetParent(a, c) == lantern:::engine:::ParentChange:::WouldCreateCycle, "a can't go under its grandchild");
    assert(world->SetParent(a, a) == lantern:::engine:::ParentChange:::WouldCreateCycle, "a can't go under itself");
    print("cycles are refused");
    return 0;
}
