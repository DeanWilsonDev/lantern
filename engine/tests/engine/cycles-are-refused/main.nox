lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    a := world->Spawn("a", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    b := world->Spawn("b", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    c := world->Spawn("c", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    bUnderA := world->SetParent(b, a);
    assert(bUnderA == lantern:::engine:::ParentChange:::Done, "b goes under a");
    cUnderB := world->SetParent(c, b);
    assert(cUnderB == lantern:::engine:::ParentChange:::Done, "c goes under b");
    aUnderC := world->SetParent(a, c);
    assert(aUnderC == lantern:::engine:::ParentChange:::WouldCreateCycle, "a can't go under its grandchild");
    aUnderItself := world->SetParent(a, a);
    assert(aUnderItself == lantern:::engine:::ParentChange:::WouldCreateCycle, "a can't go under itself");
    print("cycles are refused");
    return 0;
}
