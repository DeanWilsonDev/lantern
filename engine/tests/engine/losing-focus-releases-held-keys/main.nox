lantern :: import lantern;

main :: () -> i32 {
    fixture := new lantern:::testing:::InputFixture();
    defer delete fixture;
    router: lantern:::engine:::InputRouter~* = fixture->router;
    jump := fixture->jump;
    lantern:::testing:::FrameWith(router, lantern:::testing:::SpaceDown());
    lantern:::testing:::FrameWith(router, lantern:::platform:::PlatformEvent:::FocusLost);
    assert(router->FrameSnapshot()->Released(jump), "losing focus releases jump");
    print("losing focus releases held keys");
    return 0;
}
