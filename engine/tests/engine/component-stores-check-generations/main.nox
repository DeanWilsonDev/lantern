lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::engine:::World();
    defer delete world;
    health := new lantern:::engine:::ComponentStore<i32>();
    defer delete health;
    first := world->Spawn("first", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    health->Insert(first, 3);
    world->Despawn(first);
    second := world->Spawn("second", lantern:::testing:::Level(), lantern:::engine:::Transform:::Identity());
    assert(first.Index() == second.Index(), "the slot is reused");
    assert(health->Get(second) == null, "a new entity in the same slot has no stale component");
    health->RetainAlive(world);
    assert(health->IsEmpty(), "the dead entity's component is dropped");
    print("component stores check generations");
    return 0;
}
