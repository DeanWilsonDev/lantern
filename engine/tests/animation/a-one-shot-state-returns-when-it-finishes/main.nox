lantern :: import lantern;

main :: () -> i32 {
    rig := lantern:::animation_support:::MakeArmRig();
    defer delete rig;
    animator := new lantern:::animation:::Animator();
    defer delete animator;
    idle: i32 = animator->AddState("idle", 0, true);
    wave: i32 = animator->AddState("wave", 2, false);
    animator->AddTransition(
        idle,
        wave,
        "wave",
        lantern:::animation:::TransitionCondition:::Trigger,
        0.0f,
        0.1f
    );
    animator->AddTransition(
        wave,
        idle,
        "",
        lantern:::animation:::TransitionCondition:::Finished,
        0.0f,
        0.1f
    );
    animator->Update(rig, 0.1f);
    animator->SetParameter("wave", 1.0f);
    animator->Update(rig, 0.1f);
    assert(animator->CurrentStateName() == "wave", "the trigger starts the one-shot");
    assert(animator->Parameter("wave") == 0.0f, "the trigger is used up");
    for step~ i32 = 0; step < 4; step++ {
        animator->Update(rig, 0.1f);
    }
    assert(animator->CurrentStateName() == "wave", "it is still waving before the clip ends");
    animator->Update(rig, 0.2f);
    animator->Update(rig, 0.01f);
    assert(animator->CurrentStateName() == "idle", "it returns when the clip has finished");
    print("one-shots return");
    return 0;
}
