// A blend state scales its playback speed to the character's ground speed, so feet don't slide: as authored at the
// first
// clip's speed, faster or slower in between, capped at 1.6, and not sped up when nearly still.
lantern :: import lantern;

main :: () -> i32 {
    rig := lantern:::animation_support:::MakeArmRig();
    defer delete rig;
    rig->clips[0]->groundSpeed = 1.0f;
    rig->clips[1]->groundSpeed = 2.0f;
    animator := new lantern:::animation:::Animator();
    defer delete animator;
    blend: i32 = animator->AddBlendState("move", "speed");
    animator->AddBlendClip(blend, 0, 1.0f);
    animator->AddBlendClip(blend, 1, 3.0f);
    animator->SetParameter("speed", 1.0f);
    assert(lantern:::animation_support:::Near(animator->StrideRate(rig, blend), 1.0f), "at the first clip's ground speed it plays as authored");
    animator->SetParameter("speed", 2.0f);
    rate: f32 = animator->StrideRate(rig, blend);
    assert(lantern:::animation_support:::Near(rate, 2.0f / 1.5f), "half way between the clips it plays at speed over their mixed ground speed");
    animator->SetParameter("speed", 3.0f);
    assert(lantern:::animation_support:::Near(animator->StrideRate(rig, blend), 1.5f), "at the second clip's threshold, 3 m/s over its 2 m/s");
    animator->SetParameter("speed", 20.0f);
    assert(lantern:::animation_support:::Near(animator->StrideRate(rig, blend), 1.6f), "a huge speed is capped at 1.6");
    animator->SetParameter("speed", 0.1f);
    assert(lantern:::animation_support:::Near(animator->StrideRate(rig, blend), 1.0f), "a character that is nearly still is not sped up");
    rig->clips[1]->groundSpeed = 0.0f;
    animator->SetParameter("speed", 3.0f);
    assert(lantern:::animation_support:::Near(animator->StrideRate(rig, blend), 1.0f), "a clip that does not say how fast it travels is played as authored");
    print("strides follow the ground speed");
    return 0;
}
