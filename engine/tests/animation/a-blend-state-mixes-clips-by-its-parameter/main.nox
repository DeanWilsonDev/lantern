// A blend state plays two clips mixed by a parameter: an amount of 0 is the rest clip, 1 is the raise clip, and a value
// between them mixes the two poses.
lantern :: import lantern;

main :: () -> i32 {
    rig := lantern:::animation_support:::MakeArmRig();
    defer delete rig;
    animator := new lantern:::animation:::Animator();
    defer delete animator;
    blend: i32 = animator->AddBlendState("lift", "amount");
    animator->AddBlendClip(blend, 0, 0.0f);
    animator->AddBlendClip(blend, 1, 1.0f);
    animator->SetParameter("amount", 0.0f);
    animator->Update(rig, 0.0f);
    assert(
        lantern:::animation_support:::NearPoint(
            lantern:::animation_support:::TipOf(rig, animator),
            Vec3 { y: 2.0f }
        ),
        "amount 0 is the rest clip"
    );
    animator->SetParameter("amount", 1.0f);
    animator->Update(rig, 0.0f);
    assert(
        lantern:::animation_support:::NearPoint(
            lantern:::animation_support:::TipOf(rig, animator),
            Vec3 { y: 2.0f }
        ),
        "amount 1 at phase 0 is the raise clip's first key"
    );
    animator->Update(rig, 0.5f);
    expected: f32 = Math:::sin(Math:::PI * 0.25f);
    assert(
        lantern:::animation_support:::NearPoint(
            lantern:::animation_support:::TipOf(rig, animator),
            Vec3 { x: -expected, y: 1.0f + expected }
        ),
        "half way through the raise clip"
    );
    print("blend states mix by parameter");
    return 0;
}
