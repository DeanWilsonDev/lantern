lantern :: import lantern;

main :: () -> i32 {
    rig := lantern:::animation_support:::MakeArmRig();
    defer delete rig;
    rest: Array<lantern:::animation:::JointTransform>! = rig->skeleton->RestPose();
    defer delete rest;
    matrices: Array<Mat4>! = rig->skeleton->ModelMatrices(rest);
    defer delete matrices;
    tip: Vec3 = lantern:::core:::TransformPoint3(matrices[2], Vec3 { });
    assert(
        lantern:::animation_support:::NearPoint(tip, Vec3 { y: 2.0f }),
        "the rest tip is two metres up"
    );
    palette: Array<Mat4>! = rig->skeleton->Palette(rest);
    defer delete palette;
    for index~ usize = 0; index < palette.length(); index++ {
        moved: Vec3 = lantern:::core:::TransformPoint3(
            palette[index],
            Vec3 { x: 0.3f, y: 0.7f, z: -0.2f }
        );
        assert(
            lantern:::animation_support:::NearPoint(moved, Vec3 { x: 0.3f, y: 0.7f, z: -0.2f }),
            "the rest palette leaves a vertex where it was"
        );
    }
    print("rest skinning is identity");
    return 0;
}
