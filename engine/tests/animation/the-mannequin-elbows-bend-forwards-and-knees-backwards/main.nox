// The mannequin's joints bend the way a person's do in every pose of its clips: forearms fold in front of the upper arm
// and shins behind the thigh.
lantern :: import lantern;

CheckMotion :: (
    skeleton: lantern:::animation:::Skeleton*,
    motion: lantern:::animation:::MannequinMotion,
    motionName: string
) -> void {
    folded~ i32 = 0;
    for step~ i32 = 0; step <= 8; step++ {
        phase: f32 = f32(step) / 8.0f;
        pose: Array<lantern:::animation:::JointTransform>! = lantern:::animation:::MannequinPose(skeleton, motion, phase);
        defer delete pose;
        elbowSides: usize[2] = [
            lantern:::animation:::MANNEQUIN_LEFT_FOREARM,
            lantern:::animation:::MANNEQUIN_RIGHT_FOREARM
        ];
        kneeSides: usize[2] = [
            lantern:::animation:::MANNEQUIN_LEFT_SHIN,
            lantern:::animation:::MANNEQUIN_RIGHT_SHIN
        ];
        for side~ usize = 0; side < 2; side++ {
            forearmDirection: Vec3 = lantern:::core:::RotateVector(pose[elbowSides[side]].rotation, Vec3 { y: -1.0f });
            if forearmDirection.z > 0.001f {
                folded++;
            }
            shinDirection: Vec3 = lantern:::core:::RotateVector(pose[kneeSides[side]].rotation, Vec3 { y: -1.0f });
            if shinDirection.z < -0.001f {
                folded++;
            }
        }
    }
    print(`${motionName}: ${folded} limbs fold the wrong way`);
    assert(folded == 0, "a forearm folds behind its upper arm or a shin in front of its thigh");
}

main :: () -> i32 {
    rig := lantern:::animation:::MannequinRig();
    defer delete rig;
    CheckMotion(rig->skeleton, lantern:::animation:::MannequinMotion:::Idle, "idle");
    CheckMotion(rig->skeleton, lantern:::animation:::MannequinMotion:::Walk, "walk");
    CheckMotion(rig->skeleton, lantern:::animation:::MannequinMotion:::Run, "run");
    CheckMotion(rig->skeleton, lantern:::animation:::MannequinMotion:::Jump, "jump");
    CheckMotion(rig->skeleton, lantern:::animation:::MannequinMotion:::Fall, "fall");
    CheckMotion(rig->skeleton, lantern:::animation:::MannequinMotion:::Crouch, "crouch");
    CheckMotion(rig->skeleton, lantern:::animation:::MannequinMotion:::Wave, "wave");
    CheckMotion(rig->skeleton, lantern:::animation:::MannequinMotion:::Reach, "reach");
    return 0;
}
