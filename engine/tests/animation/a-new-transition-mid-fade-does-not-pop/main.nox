lantern :: import lantern;

main :: () -> i32 {
    rig := lantern:::animation_support:::MakeArmRig();
    defer delete rig;
    animator := new lantern:::animation:::Animator();
    defer delete animator;
    idle: i32 = animator->AddState("idle", 0, true);
    raised: i32 = animator->AddState("raised", 1, true);
    animator->Update(rig, 0.1f);
    animator->Play(raised, 1.0f);
    animator->Update(rig, 0.5f);
    before: Vec3 = lantern:::animation_support:::TipOf(rig, animator);
    animator->Play(idle, 1.0f);
    animator->Update(rig, 0.0f);
    after: Vec3 = lantern:::animation_support:::TipOf(rig, animator);
    assert(
        lantern:::animation_support:::NearPoint(before, after),
        "interrupting a fade starts from the pose on screen"
    );
    print("no pop");
    return 0;
}
