NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    game := new lantern:::testing:::MenuGame();
    game->MountMenu();
    buttons: Array<lantern:::chaosui:::ButtonRect>! = lantern:::testing:::ButtonCentres(game);
    play: lantern:::chaosui:::ButtonRect = buttons[0];
    quit: lantern:::chaosui:::ButtonRect = buttons[1];
    delete buttons;
    playCentre: Vec2 = lantern:::testing:::Centre(play.rect);
    game->ui->Navigate(lantern:::testing:::PointerAt(playCentre, false, false, false));
    assert((game->ui->Focused() ?? 0) == play.node, "the mouse focuses Play");
    keyboard~ lantern:::chaosui:::Navigation = lantern:::testing:::PointerAt(playCentre, false, false, false);
    keyboard.next = true;
    game->ui->Navigate(keyboard);
    assert((game->ui->Focused() ?? 0) == quit.node, "the keyboard moved focus and the mouse didn't move");
    game->ui->Navigate(lantern:::testing:::PointerAt(playCentre, false, false, false));
    assert((game->ui->Focused() ?? 0) == quit.node, "a still mouse leaves the keyboard's focus alone");
    delete game;
    print("a still mouse leaves keyboard focus alone");
    return 0;
}
