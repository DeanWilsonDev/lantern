NyxC :: import NyxC;
lantern :: import lantern;

IndexOfText :: (nodes: Array<lantern:::chaosui:::UiNode>, text: string) -> usize {
    for index~ usize = 0; index < nodes.length(); index++ {
        if nodes[index].text == text {
            return index;
        }
    }
    assert(false, "the text is in the tree");
    return 0;
}

main :: () -> i32 {
    game := new lantern:::testing:::MenuGame();
    game->MountMenu();
    nodes: Array<lantern:::chaosui:::UiNode> = game->ui->nodes;
    expectedBackground: lantern:::core:::Color = lantern:::core:::Color:::Rgba(16.0f / 255.0f, 32.0f / 255.0f, 48.0f / 255.0f, 1.0f);
    if background := nodes[0].style.background {
        assert(background == expectedBackground, "the menu's background comes from its class");
    } else {
        assert(false, "the menu has a background");
    }
    titleIndex: usize = IndexOfText(nodes, "LANTERN");
    assert((nodes[titleIndex].style.fontSize ?? 0.0f) == 32.0f, "the title's font size comes from its class");
    firstButton~ usize = 0;
    secondButton~ usize = 0;
    buttonCount~ usize = 0;
    for index~ usize = 0; index < nodes.length(); index++ {
        if nodes[index].focusable {
            if buttonCount == 0 {
                firstButton = index;
            } else {
                secondButton = index;
            }
            buttonCount++;
        }
    }
    assert(buttonCount == 2, "both buttons are focusable");
    assert(nodes[firstButton].hover != null, "the :hover block resolves");
    playIndex: usize = IndexOfText(nodes, "Play");
    assert(nodes[playIndex].style.textColor == null, "color inherits, so Play has none of its own");
    overlay := new lantern:::renderer:::Overlay();
    game->ui->Draw(overlay, Vec2 { x: 800.0f, y: 600.0f }, 1.0f);
    assert(overlay->vertices.length() > 0, "the menu draws into the overlay");
    delete overlay;
    rects: Array<lantern:::chaosui:::Rect> = game->ui->rects;
    assert(rects[titleIndex].min.x == 10.0f && rects[titleIndex].min.y == 10.0f, "the title starts inside the padding");
    assert(rects[titleIndex].Size().y == 32.0f, "the title is 32 pixels tall at font scale 4");
    assert(rects[firstButton].Size().x == rects[0].Size().x - 20.0f, "the buttons stretch across the column");
    assert(rects[firstButton].min.y == rects[titleIndex].max.y + 4.0f, "the gap separates the title from the first button");
    assert(secondButton > firstButton, "the buttons are in order");
    delete game;
    print("cosmos styles reach the nodes and the layout");
    return 0;
}
