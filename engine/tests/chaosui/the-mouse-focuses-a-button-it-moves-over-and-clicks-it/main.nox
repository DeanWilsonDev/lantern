NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    game := new lantern:::testing:::MenuGame();
    game->MountMenu();
    buttons: Array<lantern:::chaosui:::ButtonRect>! = lantern:::testing:::ButtonCentres(game);
    play: lantern:::chaosui:::ButtonRect = buttons[0];
    quit: lantern:::chaosui:::ButtonRect = buttons[1];
    delete buttons;
    game->ui->Navigate(lantern:::testing:::PointerAt(lantern:::testing:::Centre(quit.rect), false, false, false));
    assert((game->ui->Focused() ?? 0) == quit.node, "moving over Quit focuses it");
    assert(game->Moves() == 1, "and calls its onFocus");
    game->ui->Navigate(lantern:::testing:::PointerAt(lantern:::testing:::Centre(play.rect), true, true, false));
    assert((game->ui->Focused() ?? 0) == play.node, "a quick click on Play focuses it");
    chosen: string! = game->Chosen();
    assert(chosen == "play", "and chooses it");
    delete chosen;
    messageCount: usize = game->MessageCount();
    assert(messageCount == 0, "nothing was reported");
    delete game;
    print("the mouse focuses a button it moves over and clicks it");
    return 0;
}
