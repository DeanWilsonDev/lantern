NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    game := new lantern:::testing:::MenuGame();
    game->MountMenu();
    game->ui->Navigate(lantern:::chaosui:::Navigation { });
    first: u64 = game->ui->Focused() ?? 0;
    assert(game->ui->Focused() != null, "the first frame focuses the first button");
    assert(game->Moves() == 0, "without calling onFocus");
    game->ui->Navigate(lantern:::chaosui:::Navigation { next: true });
    assert((game->ui->Focused() ?? 0) != first, "next moves the focus");
    assert(game->Moves() == 1, "and calls onFocus");
    game->ui->Navigate(lantern:::chaosui:::Navigation { confirm: true });
    chosen: string! = game->Chosen();
    assert(chosen == "quit", "confirm calls the focused button's onRelease");
    delete chosen;
    game->ui->Navigate(lantern:::chaosui:::Navigation { next: true });
    assert((game->ui->Focused() ?? 0) == first, "the focus wraps around");
    messageCount: usize = game->MessageCount();
    assert(messageCount == 0, "nothing was reported");
    delete game;
    print("navigation focuses buttons and confirm calls on release");
    return 0;
}
