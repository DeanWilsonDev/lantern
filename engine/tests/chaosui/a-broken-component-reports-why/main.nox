NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    game := new lantern:::testing:::MenuGame();
    noArguments: Array<lantern:::nyx:::Value*>! = [];
    mounted := game->ui->Mount("ui/Broken.chaos", "Broken", noArguments);
    when mounted! {
        Result:::Ok(mount) -> {
            assert(false, "a broken component doesn't mount");
        },
        Result:::Err(message) -> {
            if !message.contains("Broken") {
                print(message);
            }
            assert(message.contains("Broken"), "the failure names the component");
            delete message;
        }
    }
    delete noArguments;
    delete game;
    print("a broken component reports why");
    return 0;
}
