NyxC :: import NyxC;
lantern :: import lantern;

main :: () -> i32 {
    game := new lantern:::testing:::MenuGame();
    game->MountMenu();
    texts: string! = game->Texts();
    if texts != "LANTERN,Play,Quit" {
        print(`the texts were '${texts}'`);
    }
    assert(texts == "LANTERN,Play,Quit", "the menu shows the model's title and its buttons");
    delete texts;
    title := game->runtime->MakeString("PAUSED");
    arguments~ Array<lantern:::nyx:::Value*>! = [];
    arguments.push(title);
    returned := lantern:::testing:::ValueOrFail(game->program->CallApplicationMethod("Rename", arguments));
    delete returned;
    delete arguments;
    delete title;
    game->ui->Update();
    renamedTexts: string! = game->Texts();
    assert(renamedTexts == "PAUSED,Play,Quit", "writing the signal re-renders the slot on the next update");
    delete renamedTexts;
    messageCount: usize = game->MessageCount();
    assert(messageCount == 0, "nothing was reported");
    delete game;
    print("a component mounts on the game runtime and follows its signals");
    return 0;
}
