NyxC :: import NyxC;
lantern :: import lantern;

ExpectChosen :: (game: lantern:::testing:::MenuGame*, expected: string, reason: string) -> void {
    chosen: string! = game->Chosen();
    if chosen != expected {
        print(`${reason}: chosen was '${chosen}'`);
    }
    assert(chosen == expected, "the click chooses only on a release over the pressed button");
    delete chosen;
}

main :: () -> i32 {
    game := new lantern:::testing:::MenuGame();
    game->MountMenu();
    buttons: Array<lantern:::chaosui:::ButtonRect>! = lantern:::testing:::ButtonCentres(game);
    playCentre: Vec2 = lantern:::testing:::Centre(buttons[0].rect);
    quitCentre: Vec2 = lantern:::testing:::Centre(buttons[1].rect);
    delete buttons;
    game->ui->Navigate(lantern:::testing:::PointerAt(playCentre, true, false, true));
    game->ui->Navigate(lantern:::testing:::PointerAt(quitCentre, false, true, false));
    ExpectChosen(game, "", "releasing off the pressed button cancels the click");
    game->ui->Navigate(lantern:::testing:::PointerAt(quitCentre, true, false, true));
    game->ui->Navigate(lantern:::testing:::PointerAt(quitCentre, false, false, true));
    ExpectChosen(game, "", "holding the button doesn't click it yet");
    game->ui->Navigate(lantern:::testing:::PointerAt(quitCentre, false, true, false));
    ExpectChosen(game, "quit", "releasing on the pressed button clicks it");
    delete game;
    print("releasing the mouse off the pressed button cancels the click");
    return 0;
}
