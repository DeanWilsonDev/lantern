lantern :: import lantern;

main :: () -> i32 {
    root: string! = `/tmp/lantern-session-test-${monotonicNanoseconds()}`;
    defer delete root;
    createDirectories(root);

    engineFound: string!? = lantern:::project:::AbsolutePath("..");
    defer delete engineFound;
    guard engineFolder := engineFound return 1;

    projectFolder: string! = `${root}/space-game`;
    defer delete projectFolder;
    created := lantern:::project:::CreateProject(projectFolder, "Space Game", "empty", engineFolder);
    defer delete created;
    if message := created {
        print(message);
    }
    assert(created == null, "the project is made");

    assetsFolder := lantern:::project:::GameAssetsFolder(projectFolder);
    defer delete assetsFolder;
    guard assets := assetsFolder return 1;
    assert(assets.endsWith("/space-game/assets"), "the assets folder is inside the project");

    startingWorld := lantern:::project:::StartingWorld(assets);
    defer delete startingWorld;
    assert(startingWorld.endsWith("worlds/start.world.json"), "the starting world is start.world.json");

    nowhere: string! = `${root}/nowhere`;
    defer delete nowhere;
    emptyWorld := lantern:::project:::StartingWorld(nowhere);
    defer delete emptyWorld;
    assert(emptyWorld.length() == 0, "a folder with no worlds gives an empty path");

    return 0;
}
