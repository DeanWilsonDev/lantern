lantern :: import lantern;

Same :: (actual: string!, expected: string) -> bool {
    defer delete actual;
    return actual == expected;
}

main :: () -> i32 {
    assert(Same(lantern:::project:::NormalizedPath("/a/b/../c/./d//"), "/a/c/d"), "dots and doubled slashes are tidied");
    assert(Same(lantern:::project:::NormalizedPath("../x/./y"), "../x/y"), "a leading .. in a relative path stays");
    assert(Same(lantern:::project:::NormalizedPath("/../x"), "/x"), "an absolute path can't climb above the root");
    assert(Same(lantern:::project:::RelativePath("/home/me/games/alpha", "/home/me/lantern"), "../../lantern"), "a sibling folder of the parent");
    assert(Same(lantern:::project:::RelativePath("/home/me/lantern", "/home/me/lantern"), "."), "the same folder is a dot");
    assert(Same(lantern:::project:::RelativePath("/a", "/a/b/c"), "b/c"), "a folder inside");
    assert(Same(lantern:::project:::ResolvedPath("/home/me/games/alpha", "../../lantern"), "/home/me/lantern"), "a relative record resolves against the project");
    assert(Same(lantern:::project:::ResolvedPath("/home/me/games/alpha", "/opt/lantern"), "/opt/lantern"), "an absolute record stays");
    assert(Same(lantern:::project:::LastPart("/x/y/"), "y"), "the last part ignores a trailing slash");
    assert(Same(lantern:::project:::Slug("My  Great Game!"), "my-great-game"), "a name becomes a package name");
    assert(Same(lantern:::project:::Slug("!!!"), "game"), "a name with no letters gets a default");
    print("paths are normalised, related and slugged");
    return 0;
}
