#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct MaterialSurface
{
    float3 base_color;
    float metallic;
    float roughness;
    float3 emissive;
    float3 tangent_normal;
    float normal_strength;
    float2 normal_uv;
    float opacity_mask;
    float opacity;
};

struct LightUniforms
{
    float4 camera_position;
};

struct MaterialUniforms
{
    float4 parameters[2];
};

struct main0_in
{
    float2 surface_uv [[user(locn2)]];
};

static inline __attribute__((always_inline))
MaterialSurface DefaultSurface(thread const float2& uv)
{
    MaterialSurface surface;
    surface.base_color = float3(1.0);
    surface.metallic = 0.0;
    surface.roughness = 0.800000011920928955078125;
    surface.emissive = float3(0.0);
    surface.tangent_normal = float3(0.0, 0.0, 1.0);
    surface.normal_strength = 0.0;
    surface.normal_uv = uv;
    surface.opacity_mask = 1.0;
    surface.opacity = 1.0;
    return surface;
}

static inline __attribute__((always_inline))
MaterialSurface SurfaceOf(thread const float2& uv)
{
    float2 param = uv;
    MaterialSurface surface = DefaultSurface(param);
    surface.opacity_mask = 0.0;
    return surface;
}

fragment void main0(main0_in in [[stage_in]])
{
    float2 param = in.surface_uv;
    if (SurfaceOf(param).opacity_mask < 0.5)
    {
        discard_fragment();
    }
}

