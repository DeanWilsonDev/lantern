lantern :: import lantern;

main :: () -> i32 {
    assert(lantern:::gpu:::MipLevelCount(1, 1) == 1, "a single texel has one level");
    assert(lantern:::gpu:::MipLevelCount(256, 256) == 9, "256 down to 1 is nine levels");
    assert(lantern:::gpu:::MipLevelCount(256, 64) == 9, "the larger side decides");
    assert(lantern:::gpu:::MipLevelCount(300, 10) == 9, "a side that isn't a power of two rounds down");
    print("mip chain lengths");
    return 0;
}
