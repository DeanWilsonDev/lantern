lantern :: import lantern;

PixelAt :: (pixels: Array<u8>, width: u32, x: u32, y: u32) -> u8[4] {
    offset: usize = usize((y * width + x) * 4);
    return [pixels[offset], pixels[offset + 1], pixels[offset + 2], pixels[offset + 3]];
}

main :: () -> i32 {
    created := lantern:::gpu:::GpuRenderer:::CreateOffscreen(lantern:::gpu:::GpuOptions { debug: false, vsync: false });
    when created! {
        Result:::Ok(renderer) -> {
            defer delete renderer;
            cubeData := lantern:::renderer:::Cube(1.0f);
            defer delete cubeData;
            cube~ lantern:::core:::Handle<lantern:::renderer:::MeshTag> = lantern:::core:::Handle<lantern:::renderer:::MeshTag> { };
            when renderer->CreateMesh(cubeData) {
                Result:::Ok(handle) -> {
                    cube = handle;
                },
                Result:::Err(message) -> {
                    print(message);
                    delete message;
                    return 1;
                }
            }
            world := new lantern:::renderer:::RenderWorld();
            defer delete world;
            world->camera = lantern:::renderer:::Camera:::LookAt(Vec3 { x: 0.0f, y: 0.0f, z: 3.0f }, Vec3 { });
            world->clearColor = lantern:::core:::Color:::Rgb(0.0f, 0.0f, 1.0f);
            world->Draw(cube, null, Mat4 { }, lantern:::core:::Color:::Rgb(1.0f, 0.0f, 0.0f));
            world->Draw(cube, null, Mat4:::translation(Vec3 { x: 0.0f, y: 0.0f, z: 10.0f }), lantern:::core:::Color:::White());
            for size in [u32(96), u32(160)] {
                when renderer->RenderOffscreen(world, size, size) {
                    Result:::Ok(report) -> {
                        assert(renderer->offscreenPixels.length() == usize(size * size * 4), "the pixels match the requested size");
                        assert(report.drawsSubmitted == 1 && report.drawsCulled == 1, "the report counts the drawn and the culled cube");
                        center: u8[4] = PixelAt(renderer->offscreenPixels, size, size / 2, size / 2);
                        assert(center[0] > 60 && center[1] < 40 && center[2] < 40, "the cube's lit front face is red");
                        corner: u8[4] = PixelAt(renderer->offscreenPixels, size, size - 1, size - 1);
                        assert(corner[2] > 200 && corner[0] < 30, "the clear colour fills the corner");
                    },
                    Result:::Err(message) -> {
                        print(message);
                        delete message;
                        return 1;
                    }
                }
            }
        },
        Result:::Err(message) -> {
            lantern:::gputest:::Skip(message);
            delete message;
        }
    }
    print("an off-screen renderer draws without a window");
    return 0;
}
