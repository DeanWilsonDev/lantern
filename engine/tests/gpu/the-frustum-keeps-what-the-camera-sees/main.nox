lantern :: import lantern;

UnitBox :: (center: Vec3) -> lantern:::core:::Aabb {
    return lantern:::core:::Aabb:::FromCenterHalfExtents(center, lantern:::core:::Splat3(0.5f));
}

main :: () -> i32 {
    camera: lantern:::renderer:::Camera = lantern:::renderer:::Camera:::LookAt(Vec3 { x: 0.0f, y: 0.0f, z: 5.0f }, Vec3 { });
    frustum: lantern:::gpu:::Frustum = lantern:::gpu:::Frustum:::FromViewProjection(camera.ViewProjection(1.0f));
    assert(frustum.Intersects(UnitBox(Vec3 { })), "the box at the target is visible");
    assert(!frustum.Intersects(UnitBox(Vec3 { x: 0.0f, y: 0.0f, z: 10.0f })), "behind the camera");
    assert(!frustum.Intersects(UnitBox(Vec3 { x: 50.0f, y: 0.0f, z: 0.0f })), "far to the side");
    assert(!frustum.Intersects(UnitBox(Vec3 { x: 0.0f, y: 0.0f, z: -400.0f })), "beyond the far plane");
    assert(frustum.Intersects(UnitBox(Vec3 { x: 2.5f, y: 0.0f, z: 0.0f })), "partly visible at the edge");
    print("the frustum keeps what the camera sees");
    return 0;
}
