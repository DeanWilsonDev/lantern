// The navigation graph links a 1.5 m gap with a jump and a 1.5 m drop with a step down, leaves a 4.5 m gap and a high
// ledge unlinked, and stops a path at the edge nearest the goal.
lantern :: import lantern;

KindCount :: (path: lantern:::navigation:::NavigationPath*, kind: i32) -> i32 {
    found~ i32 = 0;
    for pointKind in path->kinds {
        if pointKind == kind {
            found += 1;
        }
    }
    return found;
}

AddPlatform :: (
    world: lantern:::physics:::CollisionWorld~*,
    minimumX: f32,
    maximumX: f32,
    top: f32
) -> void {
    world->AddStaticBox(
        Vec3 { x: (minimumX + maximumX) * 0.5f, y: top - 0.5f, z: 0.0f },
        Vec3 { x: (maximumX - minimumX) * 0.5f, y: 0.5f, z: 4.0f }
    );
}

Pathfinder :: (world: lantern:::physics:::CollisionWorld*) -> lantern:::navigation:::NavigationMesh*! {
    mesh := new lantern:::navigation:::NavigationMesh();
    mesh->Build(world, lantern:::navigation:::NavigationAgent { });
    return mesh!;
}

main :: () -> i32 {
    gapWorld := new lantern:::physics:::CollisionWorld();
    defer delete gapWorld;
    AddPlatform(gapWorld, -10.0f, -1.0f, 0.0f);
    AddPlatform(gapWorld, 0.5f, 10.0f, 0.0f);
    gapMesh := Pathfinder(gapWorld);
    defer delete gapMesh;
    gapPath := gapMesh->FindPath(
        gapWorld,
        Vec3 { x: -5.0f, y: 0.0f, z: 0.0f },
        Vec3 { x: 5.0f, y: 0.0f, z: 0.0f }
    );
    defer delete gapPath;
    assert(gapPath->isComplete, "a 1.5 m gap can be jumped");
    assert(KindCount(gapPath, lantern:::navigation:::LINK_JUMP) == 1, "with one jump link");

    wideWorld := new lantern:::physics:::CollisionWorld();
    defer delete wideWorld;
    AddPlatform(wideWorld, -10.0f, -1.0f, 0.0f);
    AddPlatform(wideWorld, 3.5f, 10.0f, 0.0f);
    wideMesh := Pathfinder(wideWorld);
    defer delete wideMesh;
    widePath := wideMesh->FindPath(
        wideWorld,
        Vec3 { x: -5.0f, y: 0.0f, z: 0.0f },
        Vec3 { x: 5.0f, y: 0.0f, z: 0.0f }
    );
    defer delete widePath;
    assert(!widePath->isComplete, "a 4.5 m gap can't");
    assert(
        widePath->points[widePath->points.length() - 1].x < -0.5f,
        "the path stops at the edge nearest the goal"
    );

    dropWorld := new lantern:::physics:::CollisionWorld();
    defer delete dropWorld;
    AddPlatform(dropWorld, -10.0f, -1.0f, 0.0f);
    AddPlatform(dropWorld, -1.0f, 10.0f, -1.5f);
    dropMesh := Pathfinder(dropWorld);
    defer delete dropMesh;
    downPath := dropMesh->FindPath(
        dropWorld,
        Vec3 { x: -5.0f, y: 0.0f, z: 0.0f },
        Vec3 { x: 5.0f, y: -1.5f, z: 0.0f }
    );
    defer delete downPath;
    assert(downPath->isComplete, "a 1.5 m drop is taken");
    assert(KindCount(downPath, lantern:::navigation:::LINK_DROP) == 1, "with one drop link");
    upPath := dropMesh->FindPath(
        dropWorld,
        Vec3 { x: 5.0f, y: -1.5f, z: 0.0f },
        Vec3 { x: -5.0f, y: 0.0f, z: 0.0f }
    );
    defer delete upPath;
    assert(!upPath->isComplete, "but she can't climb back up it");

    ledgeWorld := new lantern:::physics:::CollisionWorld();
    defer delete ledgeWorld;
    AddPlatform(ledgeWorld, -10.0f, 10.0f, 0.0f);
    ledgeWorld->AddStaticBox(
        Vec3 { x: 4.0f, y: 0.45f, z: 0.0f },
        Vec3 { x: 2.0f, y: 0.45f, z: 2.0f }
    );
    ledgeWorld->AddStaticBox(
        Vec3 { x: -4.0f, y: 1.25f, z: 0.0f },
        Vec3 { x: 2.0f, y: 1.25f, z: 2.0f }
    );
    ledgeMesh := Pathfinder(ledgeWorld);
    defer delete ledgeMesh;
    crateTop := ledgeMesh->FindPath(
        ledgeWorld,
        Vec3 { x: 0.0f, y: 0.0f, z: 0.0f },
        Vec3 { x: 4.0f, y: 0.9f, z: 0.0f }
    );
    defer delete crateTop;
    assert(crateTop->isComplete, "she hops onto a 0.9 m crate");
    wallTop := ledgeMesh->FindPath(
        ledgeWorld,
        Vec3 { x: 0.0f, y: 0.0f, z: 0.0f },
        Vec3 { x: -4.0f, y: 2.5f, z: 0.0f }
    );
    defer delete wallTop;
    assert(!wallTop->isComplete, "a 2.5 m block is a climb, which she can't do");
    print("gaps are jumped, drops are taken and high ledges are not");
    return 0;
}
