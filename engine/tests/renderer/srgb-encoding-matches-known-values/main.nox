lantern :: import lantern;

main :: () -> i32 {
    assert(lantern:::renderer:::ToSrgbByte(0.0f) == 0, "black stays black");
    assert(lantern:::renderer:::ToSrgbByte(1.0f) == 255, "white stays white");
    assert(lantern:::renderer:::ToSrgbByte(0.2159f) == 128, "sRGB 128 is about 21.6% linear");
    checker := lantern:::renderer:::TextureData:::Checker(8, 2, lantern:::core:::Color:::White(), lantern:::core:::Color:::Black());
    defer delete checker;
    assert(checker->rgba8.length() == 256, "8 by 8 RGBA");
    assert(checker->rgba8[0] == 255 && checker->rgba8[checker->PixelOffset(4, 0)] == 0, "the cells alternate every four pixels");
    print("srgb encoding matches known values");
    return 0;
}
