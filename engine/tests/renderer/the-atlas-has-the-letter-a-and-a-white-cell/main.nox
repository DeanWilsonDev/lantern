lantern :: import lantern;

main :: () -> i32 {
    atlas := lantern:::renderer:::FontAtlas();
    defer delete atlas;
    assert(atlas->rgba8.length() == usize(lantern:::renderer:::ATLAS_WIDTH * lantern:::renderer:::ATLAS_HEIGHT * 4), "the atlas is 128 by 48 RGBA");
    cell: u32 = lantern:::renderer:::GlyphCell(65);
    originX: u32 = lantern:::renderer:::CellOriginX(cell);
    originY: u32 = lantern:::renderer:::CellOriginY(cell);
    litPixels~ u32 = 0;
    for pixelIndex~ u32 = 0; pixelIndex < 64; pixelIndex += 1 {
        offset: usize = atlas->PixelOffset(originX + pixelIndex % 8, originY + pixelIndex / 8);
        if atlas->rgba8[offset + 3] == 255 {
            litPixels += 1;
        }
    }
    assert(litPixels > 10, "the letter A has pixels");
    white: Vec2 = lantern:::renderer:::WhiteTexelUv();
    whiteOffset: usize = atlas->PixelOffset(u32(white.x * f32(lantern:::renderer:::ATLAS_WIDTH)), u32(white.y * f32(lantern:::renderer:::ATLAS_HEIGHT)));
    assert(atlas->rgba8[whiteOffset + 3] == 255, "the white cell is opaque");
    print("the atlas has the letter a and a white cell");
    return 0;
}
