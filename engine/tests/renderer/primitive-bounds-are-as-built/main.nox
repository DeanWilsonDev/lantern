lantern :: import lantern;

main :: () -> i32 {
    box := lantern:::renderer:::BoxMesh(Vec3 { x: 2.0f, y: 0.5f, z: 3.0f }, true);
    defer delete box;
    boxBounds: lantern:::core:::Aabb = box->Bounds();
    assert(boxBounds.min == Vec3 { x: -2.0f, y: -0.5f, z: -3.0f }, "the box's minimum corner");
    capsule := lantern:::renderer:::Capsule(0.4f, 0.5f, 16, 8);
    defer delete capsule;
    capsuleBounds: lantern:::core:::Aabb = capsule->Bounds();
    assert(Math:::abs(capsuleBounds.max.y - 0.9f) < 0.00001f && Math:::abs(capsuleBounds.min.y + 0.9f) < 0.00001f, "the capsule is 1.8 tall");
    ramp := lantern:::renderer:::Ramp(2.0f, 1.0f, 4.0f);
    defer delete ramp;
    rampBounds: lantern:::core:::Aabb = ramp->Bounds();
    assert(rampBounds.min == Vec3 { x: -1.0f, y: 0.0f, z: -2.0f }, "the ramp's minimum corner");
    assert(rampBounds.max == Vec3 { x: 1.0f, y: 1.0f, z: 2.0f }, "the ramp's maximum corner");
    print("primitive bounds are as built");
    return 0;
}
