lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::renderer:::RenderWorld();
    defer delete world;
    for index~ u32 = 0; index < 12; index++ {
        position := Vec3 { x: f32(index) * 10.0f, y: 1.0f, z: 0.0f };
        id: u32 = world->AddLight(lantern:::renderer:::Light:::Point(position, lantern:::core:::Color:::White(), 5.0f));
        assert(id == index + 1, "ids count up from 1");
    }
    camera := Vec3 { x: 85.0f, y: 1.0f, z: 0.0f };
    chosen: Array<u32>! = lantern:::renderer:::SelectLocalLights(world->lights, camera);
    defer delete chosen;
    assert(chosen.length() == usize(lantern:::renderer:::MAX_LOCAL_LIGHTS), "no more than the shader's limit");
    assert(chosen[0] == 8 || chosen[0] == 9, "the light nearest the camera comes first");
    for index~ usize = 0; index < chosen.length(); index++ {
        assert(chosen[index] >= 4, "the four lights farthest from the camera are left out");
    }

    assert(world->RemoveLight(3), "a light is removed by id");
    assert(!world->RemoveLight(3), "removing it again reports nothing to remove");
    assert(world->lights.length() == 11, "one light fewer");
    assert(world->FindLight(4) != null, "other ids still resolve");
    world->Clear();
    assert(world->lights.length() == 11, "clearing a frame leaves the lights in place");

    few: Array<u32>! = lantern:::renderer:::SelectLocalLights(world->lights, camera);
    defer delete few;
    assert(few.length() == usize(lantern:::renderer:::MAX_LOCAL_LIGHTS), "eleven lights still give eight");
    print("the nearest local lights are chosen");
    return 0;
}
