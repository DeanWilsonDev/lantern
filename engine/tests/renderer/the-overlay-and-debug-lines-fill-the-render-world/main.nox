lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::renderer:::RenderWorld();
    defer delete world;
    world->overlay->Rect(Vec2 { }, Vec2 { x: 10.0f, y: 10.0f }, lantern:::core:::Color:::Red());
    assert(world->overlay->vertices.length() == 6, "a rectangle is two triangles");
    world->AabbLines(lantern:::core:::Aabb { min: Vec3 { x: -1.0f, y: -1.0f, z: -1.0f }, max: Vec3 { x: 1.0f, y: 1.0f, z: 1.0f } }, lantern:::core:::Color:::Green());
    assert(world->lines.length() == 24, "a box is twelve lines");
    world->CircleLines(Vec3 { }, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, 2.0f, 8, lantern:::core:::Color:::Blue());
    assert(world->lines.length() == 40, "eight segments make eight lines");
    lastPoint: Vec3 = Vec3 { x: world->lines[39].position[0], y: world->lines[39].position[1], z: world->lines[39].position[2] };
    assert(Math:::abs(lastPoint.length() - 2.0f) < 0.0001f, "the circle has the radius asked for");
    world->Draw(lantern:::core:::Handle<lantern:::renderer:::MeshTag> { }, null, Mat4 { }, lantern:::core:::Color:::White());
    assert(world->draws.length() == 1, "one draw is queued");
    world->Clear();
    assert(world->draws.length() == 0 && world->lines.length() == 0 && world->overlay->vertices.length() == 0, "clearing empties every list");
    print("the overlay and debug lines fill the render world");
    return 0;
}
