lantern :: import lantern;

main :: () -> i32 {
    mesh := lantern:::renderer:::Cube(1.0f);
    defer delete mesh;
    valid: string!? = mesh->Validate();
    assert(valid == null, "a cube is valid");
    delete valid;
    mesh->indices.push(9999);
    invalid: string!? = mesh->Validate();
    assert(invalid != null, "an index past the vertices is caught");
    delete invalid;
    print("validation catches bad indices");
    return 0;
}
