lantern :: import lantern;

VertexFloats :: struct {
    values~ f32[12] = filled<f32, 12>(0.0f);
}

main :: () -> i32 {
    assert(lantern:::renderer:::VERTEX_STRIDE == 48, "a vertex is 48 bytes");
    vertex~ lantern:::renderer:::Vertex = lantern:::renderer:::Vertex:::Create(
        Vec3 { x: 1.0f, y: 2.0f, z: 3.0f },
        Vec3 { x: 4.0f, y: 5.0f, z: 6.0f },
        Vec2 { x: 7.0f, y: 8.0f },
        Vec4 { x: 9.0f, y: 10.0f, z: 11.0f, w: 12.0f });
    unsafe {
        floats: VertexFloats~* = reinterpret<VertexFloats>(vertex);
        assert(floats->values[3] == 4.0f, "the normal starts at byte 12");
        assert(floats->values[6] == 7.0f, "the uv starts at byte 24");
        assert(floats->values[8] == 9.0f, "the colour starts at byte 32");
        assert(floats->values[11] == 12.0f, "the colour ends at byte 48");
    }
    print("the vertex layout matches the shader");
    return 0;
}
