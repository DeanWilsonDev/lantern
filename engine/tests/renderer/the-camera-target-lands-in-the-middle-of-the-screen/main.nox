lantern :: import lantern;

main :: () -> i32 {
    target: Vec3 = Vec3 { x: -1.0f, y: 0.5f, z: 0.0f };
    camera: lantern:::renderer:::Camera = lantern:::renderer:::Camera:::LookAt(Vec3 { x: 3.0f, y: 4.0f, z: 5.0f }, target);
    ndc: Vec3 = lantern:::meshchecks:::ProjectToNdc(camera, 16.0f / 9.0f, target);
    assert(Math:::abs(ndc.x) < 0.00001f && Math:::abs(ndc.y) < 0.00001f, "the target is centred");
    assert(ndc.z > 0.0f && ndc.z < 1.0f, "the target is inside the depth range");
    print("the camera target lands in the middle of the screen");
    return 0;
}
