lantern :: import lantern;

main :: () -> i32 {
    box := lantern:::renderer:::BoxMesh(Vec3 { x: 2.0f, y: 0.5f, z: 3.0f }, true);
    defer delete box;
    largestU~ f32 = 0.0f;
    for vertex in box->vertices {
        largestU = Math:::max(largestU, vertex.uv[0]);
    }
    assert(largestU == 6.0f, "the 6 m side spans six texture repeats");
    print("world uvs tile per metre");
    return 0;
}
