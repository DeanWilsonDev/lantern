lantern :: import lantern;

main :: () -> i32 {
    camera~ lantern:::renderer:::Camera = lantern:::renderer:::Camera:::LookAt(Vec3 { x: 0.0f, y: 10.0f, z: 0.0f }, Vec3 { });
    camera.orthographicHalfHeight = 5.0f;
    near: Vec3 = lantern:::meshchecks:::ProjectToNdc(camera, 1.0f, Vec3 { x: 2.5f, y: 0.0f, z: 0.0f });
    far: Vec3 = lantern:::meshchecks:::ProjectToNdc(camera, 1.0f, Vec3 { x: 2.5f, y: -50.0f, z: 0.0f });
    assert(Math:::abs(near.x - far.x) < 0.00001f, "depth doesn't move a point sideways");
    assert(Math:::abs(near.x - 0.5f) < 0.00001f, "half the half-width is half way to the edge");
    print("an orthographic camera keeps parallel lines parallel");
    return 0;
}
