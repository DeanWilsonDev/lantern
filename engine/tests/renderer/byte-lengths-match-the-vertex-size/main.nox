lantern :: import lantern;

main :: () -> i32 {
    mesh := lantern:::renderer:::Cube(1.0f);
    defer delete mesh;
    assert(mesh->VertexByteLength() == mesh->vertices.length() * 48, "48 bytes per vertex");
    assert(mesh->IndexByteLength() == mesh->indices.length() * 4, "4 bytes per index");
    print("byte lengths match the vertex size");
    return 0;
}
