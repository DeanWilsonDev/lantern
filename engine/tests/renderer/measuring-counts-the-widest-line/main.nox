lantern :: import lantern;

main :: () -> i32 {
    size: Vec2 = lantern:::renderer:::MeasureText("abc\nde", 2.0f);
    assert(size.x == 48.0f && size.y == 36.0f, "three glyphs wide, two lines tall");
    assert(lantern:::renderer:::ScaleForDensity(2, 2.0f) == 4.0f, "double density doubles the scale");
    assert(lantern:::renderer:::ScaleForDensity(2, 1.25f) == 3.0f, "the scale rounds to whole pixels");
    print("measuring counts the widest line");
    return 0;
}
