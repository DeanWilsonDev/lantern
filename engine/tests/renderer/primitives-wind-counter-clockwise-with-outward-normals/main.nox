lantern :: import lantern;

main :: () -> i32 {
    cube := lantern:::renderer:::Cube(1.0f);
    defer delete cube;
    lantern:::meshchecks:::AssertOutwardAndCounterClockwise(cube, "cube");
    box := lantern:::renderer:::BoxMesh(Vec3 { x: 2.0f, y: 0.5f, z: 3.0f }, true);
    defer delete box;
    lantern:::meshchecks:::AssertOutwardAndCounterClockwise(box, "box");
    plane := lantern:::renderer:::Plane(4.0f, 4.0f);
    defer delete plane;
    lantern:::meshchecks:::AssertOutwardAndCounterClockwise(plane, "plane");
    ramp := lantern:::renderer:::Ramp(2.0f, 1.0f, 4.0f);
    defer delete ramp;
    lantern:::meshchecks:::AssertOutwardAndCounterClockwise(ramp, "ramp");
    capsule := lantern:::renderer:::Capsule(0.4f, 0.5f, 16, 8);
    defer delete capsule;
    lantern:::meshchecks:::AssertOutwardAndCounterClockwise(capsule, "capsule");
    sphere := lantern:::renderer:::Sphere(1.0f, 12, 6);
    defer delete sphere;
    lantern:::meshchecks:::AssertOutwardAndCounterClockwise(sphere, "sphere");
    gem := lantern:::renderer:::Gem(0.3f, 0.8f);
    defer delete gem;
    lantern:::meshchecks:::AssertOutwardAndCounterClockwise(gem, "gem");
    print("primitives wind counter clockwise with outward normals");
    return 0;
}
