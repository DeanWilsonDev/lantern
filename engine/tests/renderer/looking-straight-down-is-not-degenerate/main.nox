lantern :: import lantern;

main :: () -> i32 {
    camera: lantern:::renderer:::Camera = lantern:::renderer:::Camera:::LookAt(Vec3 { x: 0.0f, y: 10.0f, z: 0.0f }, Vec3 { });
    assert(lantern:::meshchecks:::IsFiniteMatrix(camera.View()), "the view has no NaN or infinity");
    print("looking straight down is not degenerate");
    return 0;
}
