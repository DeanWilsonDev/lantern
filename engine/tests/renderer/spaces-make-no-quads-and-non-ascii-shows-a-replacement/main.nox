lantern :: import lantern;

main :: () -> i32 {
    overlay := new lantern:::renderer:::Overlay();
    defer delete overlay;
    lantern:::renderer:::PushText(overlay, "a b", Vec2 { }, 2.0f, lantern:::core:::Color:::White());
    assert(overlay->vertices.length() == 12, "two glyphs make two quads");
    overlay->Clear();
    overlay->Text("é", Vec2 { }, 1.0f, lantern:::core:::Color:::White());
    assert(overlay->vertices.length() == 6, "a two-byte character is one glyph");
    replacementUv: f32 = f32(lantern:::renderer:::CellOriginX(lantern:::renderer:::GlyphCell(63))) / f32(lantern:::renderer:::ATLAS_WIDTH);
    assert(overlay->vertices[0].uv[0] == replacementUv, "it shows the replacement glyph");
    assert(lantern:::renderer:::GlyphCell(233) == lantern:::renderer:::GlyphCell(63), "a byte past ASCII is a question mark");
    print("spaces make no quads and non ascii shows a replacement");
    return 0;
}
