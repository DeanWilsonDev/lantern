lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::renderer:::RenderWorld();
    defer delete world;
    white := lantern:::core:::Color:::White();
    world->particles->Emit(Vec3 { x: 0.0f, y: 10.0f, z: 0.0f }, Vec3 { x: 2.0f, y: 0.0f, z: 0.0f }, white, 1.0f, 0.1f, 10.0f);
    world->StepParticles(0.5f);
    assert(world->lines.length() == 2, "a live particle draws one streak");
    assert(Math:::abs(world->particles->particles[0].position.x - 1.0f) < 0.0001f, "it moves along its velocity");
    assert(Math:::abs(world->particles->particles[0].position.y - 7.5f) < 0.01f, "gravity pulls it down");
    assert(Math:::abs(world->lines[0].color[3] - 0.5f) < 0.0001f, "half way through its life it is half faded");
    world->Clear();
    world->StepParticles(0.6f);
    assert(world->particles->particles.length() == 0, "a particle past its life is gone");
    assert(world->lines.length() == 0, "and draws nothing");

    world->particles->budget = 3;
    for index~ u32 = 0; index < 10; index++ {
        world->particles->Emit(Vec3 { }, Vec3 { }, white, 1.0f, 0.1f, 0.0f);
    }
    assert(world->particles->particles.length() == 3, "emits past the budget are dropped");
    world->particles->Clear();
    assert(world->particles->particles.length() == 0, "clear removes them all");
    print("particles fall, fade and respect the quality budget");
    return 0;
}
