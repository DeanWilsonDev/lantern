// A Silhouette that can't be resolved (a missing base, say) reports why instead of crashing.
lantern :: import lantern;

Fails :: (library: lantern:::silhouette:::SilhouetteLibrary*, name: string, part: string) -> void {
    when library->Resolve(name) {
        Result:::Ok(resolved) -> {
            delete resolved;
            print(name);
            assert(false, "the silhouette should not resolve");
        },
        Result:::Err(message) -> {
            if !message.contains(part) {
                print(message);
            }
            assert(message.contains(part), "the error should say why");
            delete message;
        }
    }
}

main :: () -> i32 {
    library := new lantern:::silhouette:::SilhouetteLibrary("tests/support/silhouette-library");
    defer delete library;
    Fails(library, "silhouettes/loop_a", "silhouette cycle: silhouettes/loop_a -> silhouettes/loop_b -> silhouettes/loop_a");
    Fails(library, "silhouettes/missing_base", "missing silhouette 'silhouettes/nowhere'");
    Fails(library, "silhouettes/not_there", "missing silhouette 'silhouettes/not_there'");
    print("broken silhouettes report why");
    return 0;
}
