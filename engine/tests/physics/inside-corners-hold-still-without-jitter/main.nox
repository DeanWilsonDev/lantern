lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    world->AddStaticBox(Vec3 { x: 0.0f, y: 1.0f, z: -3.0f }, Vec3 { x: 5.0f, y: 1.0f, z: 0.5f });
    world->AddStaticBox(Vec3 { x: -3.0f, y: 1.0f, z: 0.0f }, Vec3 { x: 0.5f, y: 1.0f, z: 5.0f });
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { });
    lantern:::physicsrig:::Settle(controller, world);
    intoCorner := lantern:::physicsrig:::Walk(Vec3 { x: -1.0f, y: 0.0f, z: -1.0f }.normalized());
    lantern:::physicsrig:::Run(controller, world, intoCorner, 2.0f);
    resting: Vec3 = controller.feetPosition;
    step~ u32 = 0;
    while step < 60 {
        controller.Step(world, intoCorner, lantern:::physicsrig:::STEP_SECONDS);
        assert(lantern:::physicsrig:::Distance3(controller.feetPosition, resting) < 0.001f, "the player doesn't jitter in the corner");
        step += 1;
    }
    assert(resting.x > -2.5f + 0.35f - 0.001f && resting.z > -2.5f + 0.35f - 0.001f, "the player stays outside both walls");
    print("inside corners hold still without jitter");
    return 0;
}
