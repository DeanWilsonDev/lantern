lantern :: import lantern;

main :: () -> i32 {
    triangle := lantern:::physics:::Triangle:::Create(Vec3 { x: -1.0f, y: 0.0f, z: -1.0f }, Vec3 { x: 0.0f, y: 0.0f, z: 1.0f }, Vec3 { x: 1.0f, y: 0.0f, z: -1.0f });
    assert(lantern:::physicsrig:::Near3(lantern:::physics:::ClosestPointOnTriangle(Vec3 { x: 0.0f, y: 2.0f, z: 0.0f }, triangle), Vec3 { }, 0.000001f), "a point above the face projects onto it");
    assert(lantern:::physicsrig:::Near3(lantern:::physics:::ClosestPointOnTriangle(Vec3 { x: 0.0f, y: 1.0f, z: 3.0f }, triangle), Vec3 { x: 0.0f, y: 0.0f, z: 1.0f }, 0.000001f), "a point past a vertex snaps to it");
    assert(lantern:::physicsrig:::Near3(lantern:::physics:::ClosestPointOnTriangle(Vec3 { x: 0.0f, y: 0.0f, z: -5.0f }, triangle), Vec3 { x: 0.0f, y: 0.0f, z: -1.0f }, 0.000001f), "a point past an edge lands on it");
    print("closest points on a triangle cover face edge and vertex regions");
    return 0;
}
