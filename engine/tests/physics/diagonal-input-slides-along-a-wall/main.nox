lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    world->AddStaticBox(Vec3 { x: 0.0f, y: 1.0f, z: -3.0f }, Vec3 { x: 10.0f, y: 1.0f, z: 0.5f });
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { });
    lantern:::physicsrig:::Settle(controller, world);
    diagonal: Vec3 = Vec3 { x: 1.0f, y: 0.0f, z: -1.0f }.normalized();
    lantern:::physicsrig:::Run(controller, world, lantern:::physicsrig:::Walk(diagonal), 2.0f);
    assert(controller.feetPosition.x > 5.0f, "the player keeps moving along the wall");
    assert(Math:::abs(controller.velocity.x - 6.0f * Math:::sqrt(0.5f)) < 0.3f, "at the walk speed's share along it");
    print("diagonal input slides along a wall");
    return 0;
}
