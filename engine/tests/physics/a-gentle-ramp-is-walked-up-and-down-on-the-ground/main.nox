lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    ramp: Array<lantern:::physics:::Triangle>! = lantern:::physicsrig:::RampTriangles(Vec3 { x: 0.0f, y: 0.0f, z: -3.0f }, 3.0f, 1.5f, 4.0f);
    world->AddStaticTriangles(ramp);
    delete ramp;
    world->AddStaticBox(Vec3 { x: 0.0f, y: 0.75f, z: -6.5f }, Vec3 { x: 1.5f, y: 0.75f, z: 1.5f });
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 0.0f, z: 1.0f });
    lantern:::physicsrig:::Settle(controller, world);
    wasEverAirborne~ bool = false;
    step~ u32 = 0;
    while step < 90 {
        controller.Step(world, lantern:::physicsrig:::Walk(lantern:::physicsrig:::Forward()), lantern:::physicsrig:::STEP_SECONDS);
        wasEverAirborne = wasEverAirborne || !controller.grounded;
        step += 1;
    }
    assert(!wasEverAirborne, "the player keeps the ground walking up");
    assert(Math:::abs(controller.feetPosition.y - 1.5f) < 0.05f, "and ends on the ledge");
    step = 0;
    while step < 90 {
        controller.Step(world, lantern:::physicsrig:::Walk(-lantern:::physicsrig:::Forward()), lantern:::physicsrig:::STEP_SECONDS);
        wasEverAirborne = wasEverAirborne || !controller.grounded;
        step += 1;
    }
    assert(!wasEverAirborne, "the player keeps the ground walking down");
    assert(Math:::abs(controller.feetPosition.y) < 0.05f, "and ends on the floor");
    print("a gentle ramp is walked up and down on the ground");
    return 0;
}
