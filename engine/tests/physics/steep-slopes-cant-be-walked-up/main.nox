lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    steep: Array<lantern:::physics:::Triangle>! = lantern:::physicsrig:::RampTriangles(Vec3 { x: 0.0f, y: 0.0f, z: -3.0f }, 3.0f, 2.5f, 1.5f);
    world->AddStaticTriangles(steep);
    delete steep;
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { });
    lantern:::physicsrig:::Settle(controller, world);
    lantern:::physicsrig:::Run(controller, world, lantern:::physicsrig:::Walk(lantern:::physicsrig:::Forward()), 3.0f);
    assert(controller.feetPosition.y < 0.05f, "the player stays at the foot of a 59 degree slope");
    assert(controller.grounded, "on the ground");
    print("steep slopes can't be walked up");
    return 0;
}
