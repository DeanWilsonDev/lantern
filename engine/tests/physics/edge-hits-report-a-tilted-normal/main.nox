lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(10.0f);
    defer delete world;
    hit := world->CapsuleCast(lantern:::physics:::Capsule:::Sphere(0.5f), Vec3 { x: 10.3f, y: 2.0f, z: 0.0f }, Vec3 { x: 0.0f, y: -5.0f, z: 0.0f }, null);
    guard found := hit return 1;
    assert(found.normal.x > 0.3f && found.normal.y > 0.3f, "a sphere falling past the edge hits the edge, not the face");
    print("edge hits report a tilted normal");
    return 0;
}
