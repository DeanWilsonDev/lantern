lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    world->AddStaticBox(Vec3 { x: 0.0f, y: 1.0f, z: -3.0f }, Vec3 { x: 5.0f, y: 1.0f, z: 0.5f });
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { });
    lantern:::physicsrig:::Settle(controller, world);
    lantern:::physicsrig:::Run(controller, world, lantern:::physicsrig:::Walk(lantern:::physicsrig:::Forward()), 2.0f);
    radius: f32 = controller.settings.radius;
    assert(controller.feetPosition.z > -2.5f + radius - 0.001f, "the player stops outside the wall");
    assert(controller.feetPosition.z < -2.5f + radius + 0.05f, "and right against it");
    assert(Math:::abs(controller.velocity.z) < 0.001f, "with no speed into it");
    assert(controller.grounded, "still on the ground");
    print("walls stop the player without penetration");
    return 0;
}
