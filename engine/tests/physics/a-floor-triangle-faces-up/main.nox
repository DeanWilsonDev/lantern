lantern :: import lantern;

main :: () -> i32 {
    triangle := lantern:::physics:::Triangle:::Create(Vec3 { x: -1.0f, y: 0.0f, z: -1.0f }, Vec3 { x: 0.0f, y: 0.0f, z: 1.0f }, Vec3 { x: 1.0f, y: 0.0f, z: -1.0f });
    assert(lantern:::physicsrig:::Near3(triangle.Normal(), Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, 0.000001f), "the floor triangle's normal is up");
    print("a floor triangle faces up");
    return 0;
}
