lantern :: import lantern;

main :: () -> i32 {
    stairs := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete stairs;
    tops: f32[3] = [0.25f, 0.5f, 0.75f];
    index~ usize = 0;
    while index < 3 {
        top: f32 = tops[index];
        frontZ: f32 = -1.5f - f32(index);
        backZ: f32 = -10.0f;
        stairs->AddStaticBox(Vec3 { x: 0.0f, y: top * 0.5f, z: (frontZ + backZ) * 0.5f }, Vec3 { x: 1.5f, y: top * 0.5f, z: (frontZ - backZ) * 0.5f });
        index += 1;
    }
    climber~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 0.0f, z: 1.0f });
    lantern:::physicsrig:::Settle(climber, stairs);
    lantern:::physicsrig:::Run(climber, stairs, lantern:::physicsrig:::Walk(lantern:::physicsrig:::Forward()), 1.2f);
    assert(Math:::abs(climber.feetPosition.y - 0.75f) < 0.05f, "the player climbs three 0.25 m stairs");
    lantern:::physicsrig:::Run(climber, stairs, lantern:::physicsrig:::Walk(-lantern:::physicsrig:::Forward()), 1.5f);
    assert(Math:::abs(climber.feetPosition.y) < 0.05f, "and walks back down them");
    assert(climber.grounded, "onto the floor");
    ledge := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete ledge;
    ledge->AddStaticBox(Vec3 { x: 0.0f, y: 0.3f, z: -3.0f }, Vec3 { x: 1.5f, y: 0.3f, z: 1.0f });
    blocked~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { });
    lantern:::physicsrig:::Settle(blocked, ledge);
    lantern:::physicsrig:::Run(blocked, ledge, lantern:::physicsrig:::Walk(lantern:::physicsrig:::Forward()), 2.0f);
    assert(blocked.feetPosition.y < 0.05f, "a 0.6 m ledge is too tall to step up");
    print("stairs are climbed and tall ledges aren't");
    return 0;
}
