lantern :: import lantern;

main :: () -> i32 {
    triangle := lantern:::physics:::Triangle:::Create(Vec3 { x: -1.0f, y: 0.0f, z: -1.0f }, Vec3 { x: 0.0f, y: 0.0f, z: 1.0f }, Vec3 { x: 1.0f, y: 0.0f, z: -1.0f });
    pierce := lantern:::physics:::ClosestPointsSegmentTriangle(Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, Vec3 { x: 0.0f, y: -1.0f, z: 0.0f }, triangle);
    assert(lantern:::physicsrig:::Distance3(pierce.first, pierce.second) == 0.0f, "a piercing segment meets the triangle");
    hovering := lantern:::physics:::ClosestPointsSegmentTriangle(Vec3 { x: 0.0f, y: 0.5f, z: 0.0f }, Vec3 { x: 0.0f, y: 2.0f, z: 0.0f }, triangle);
    assert(lantern:::physicsrig:::Near3(hovering.first, Vec3 { x: 0.0f, y: 0.5f, z: 0.0f }, 0.000001f), "a hovering segment's lower end is closest");
    assert(lantern:::physicsrig:::Near3(hovering.second, Vec3 { }, 0.000001f), "and the face point below it");
    beside := lantern:::physics:::ClosestPointsSegmentTriangle(Vec3 { x: -2.0f, y: 0.0f, z: 2.0f }, Vec3 { x: 2.0f, y: 0.0f, z: 2.0f }, triangle);
    assert(Math:::abs(lantern:::physicsrig:::Distance3(beside.first, beside.second) - 1.0f) < 0.00001f, "a segment beside an edge is one away");
    print("segments pierce and miss a triangle");
    return 0;
}
