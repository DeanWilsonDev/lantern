lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    world->AddStaticBox(Vec3 { x: 0.0f, y: 2.15f, z: 0.0f }, Vec3 { x: 1.5f, y: 0.15f, z: 1.5f });
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { });
    lantern:::physicsrig:::Settle(controller, world);
    first := controller.Step(world, lantern:::physics:::ControllerInput { jumpPressed: true, jumpHeld: true }, lantern:::physicsrig:::STEP_SECONDS);
    hitCeiling~ bool = first.hitCeiling;
    highestFeet~ f32 = 0.0f;
    step~ u32 = 0;
    while step < 90 {
        events := controller.Step(world, lantern:::physics:::ControllerInput { jumpHeld: true }, lantern:::physicsrig:::STEP_SECONDS);
        hitCeiling = hitCeiling || events.hitCeiling;
        highestFeet = Math:::max(highestFeet, controller.feetPosition.y);
        step += 1;
    }
    assert(first.jumped, "the press jumps");
    assert(hitCeiling, "the jump hits the ceiling");
    headRoom: f32 = 2.0f - controller.settings.height;
    assert(highestFeet <= headRoom + 0.001f, "the head never passes the ceiling");
    assert(controller.grounded, "the player comes back down");
    print("ceilings stop the jump");
    return 0;
}
