lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(10.0f);
    defer delete world;
    hit := world->Raycast(Vec3 { x: 1.0f, y: 3.0f, z: 1.0f }, Vec3 { x: 0.0f, y: -1.0f, z: 0.0f }, 10.0f);
    guard found := hit return 1;
    assert(Math:::abs(found.distance - 3.0f) < 0.00001f, "the floor is three below");
    assert(lantern:::physicsrig:::Near3(found.normal, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, 0.00001f), "its normal is up");
    upward := world->Raycast(Vec3 { x: 1.0f, y: 3.0f, z: 1.0f }, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, 10.0f);
    assert(upward == null, "nothing is above");
    print("a raycast finds the nearest surface");
    return 0;
}
