lantern :: import lantern;

main :: () -> i32 {
    center: Vec3 = Vec3 { x: 1.0f, y: 2.0f, z: 3.0f };
    triangles: Array<lantern:::physics:::Triangle>! = lantern:::physics:::BoxTriangles(center, Vec3 { x: 1.0f, y: 2.0f, z: 3.0f });
    assert(triangles.length() == 12, "a box has twelve triangles");
    for triangle in triangles {
        centroid: Vec3 = (triangle.a + triangle.b + triangle.c) * (1.0f / 3.0f);
        assert(triangle.Normal().dot(centroid - center) > 0.0f, "every face points away from the centre");
    }
    delete triangles;
    print("box triangles face outward");
    return 0;
}
