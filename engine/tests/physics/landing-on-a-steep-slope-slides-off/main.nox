lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    steep: Array<lantern:::physics:::Triangle>! = lantern:::physicsrig:::RampTriangles(Vec3 { x: 0.0f, y: 0.0f, z: -3.0f }, 3.0f, 2.5f, 1.5f);
    world->AddStaticTriangles(steep);
    delete steep;
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 3.0f, z: -3.0f });
    lantern:::physicsrig:::Run(controller, world, lantern:::physicsrig:::Idle(), 2.0f);
    assert(controller.grounded, "the player ends on the ground");
    assert(controller.feetPosition.y < 0.05f, "at the foot of the slope, not stuck on it");
    print("landing on a steep slope slides off");
    return 0;
}
