lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 2.0f, z: 0.0f });
    while controller.feetPosition.y > 0.5f {
        controller.Step(world, lantern:::physicsrig:::Idle(), lantern:::physicsrig:::STEP_SECONDS);
    }
    assert(!controller.grounded, "the player is still falling");
    pressed := controller.Step(world, lantern:::physics:::ControllerInput { jumpPressed: true, jumpHeld: true }, lantern:::physicsrig:::STEP_SECONDS);
    jumped~ bool = pressed.jumped;
    step~ u32 = 0;
    while step < 6 {
        events := controller.Step(world, lantern:::physics:::ControllerInput { jumpHeld: true }, lantern:::physicsrig:::STEP_SECONDS);
        jumped = jumped || events.jumped;
        step += 1;
    }
    assert(jumped, "the buffered press jumps on landing");
    assert(controller.velocity.y > 0.0f || controller.feetPosition.y > 0.1f, "and the player is going up");
    print("a jump pressed just before landing is buffered");
    return 0;
}
