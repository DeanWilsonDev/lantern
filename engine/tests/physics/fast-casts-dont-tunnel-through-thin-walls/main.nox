lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::physics:::CollisionWorld();
    defer delete world;
    world->AddStaticBox(Vec3 { x: 0.0f, y: 1.0f, z: -5.0f }, Vec3 { x: 5.0f, y: 1.0f, z: 0.01f });
    hit := world->CapsuleCast(lantern:::physics:::Capsule:::Sphere(0.25f), Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, Vec3 { x: 0.0f, y: 0.0f, z: -1000.0f }, null);
    guard found := hit return 1;
    stop: f32 = 1000.0f * found.fraction;
    assert(Math:::abs(stop - (5.0f - 0.01f - 0.25f)) < 0.01f, "the cast stops at the wall's face");
    print("fast casts don't tunnel through thin walls");
    return 0;
}
