lantern :: import lantern;

main :: () -> i32 {
    crossing := lantern:::physics:::ClosestPointsBetweenSegments(Vec3 { x: -1.0f, y: 0.0f, z: 0.0f }, Vec3 { x: 1.0f, y: 0.0f, z: 0.0f }, Vec3 { x: 0.0f, y: 1.0f, z: -1.0f }, Vec3 { x: 0.0f, y: 1.0f, z: 1.0f });
    assert(lantern:::physicsrig:::Near3(crossing.first, Vec3 { }, 0.000001f), "the first segment's point is the origin");
    assert(lantern:::physicsrig:::Near3(crossing.second, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, 0.000001f), "the second segment's point is above it");
    parallel := lantern:::physics:::ClosestPointsBetweenSegments(Vec3 { }, Vec3 { x: 1.0f, y: 0.0f, z: 0.0f }, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, Vec3 { x: 1.0f, y: 1.0f, z: 0.0f });
    assert(Math:::abs(lantern:::physicsrig:::Distance3(parallel.first, parallel.second) - 1.0f) < 0.000001f, "parallel segments give a pair one apart");
    print("segments find their closest points");
    return 0;
}
