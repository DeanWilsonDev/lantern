lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(10.0f);
    defer delete world;
    capsule := lantern:::physics:::Capsule:::Upright(0.5f, 2.0f);
    hit := world->CapsuleCast(capsule, Vec3 { x: 0.0f, y: 5.0f, z: 0.0f }, Vec3 { x: 0.0f, y: -10.0f, z: 0.0f }, null);
    guard found := hit return 1;
    assert(Math:::abs(found.fraction - 0.4f) < 0.001f, "the centre stops at y 1, four of the ten metres down");
    assert(lantern:::physicsrig:::Near3(found.normal, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, 0.001f), "the floor pushes up");
    assert(found.collider == lantern:::physics:::ColliderId:::Static(), "the floor is static");
    print("a falling capsule stops one radius above the floor");
    return 0;
}
