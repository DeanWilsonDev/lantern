lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(10.0f);
    defer delete world;
    contacts: Array<lantern:::physics:::Contact>! = world->CapsuleContacts(lantern:::physics:::Capsule:::Sphere(0.5f), Vec3 { x: 0.0f, y: 0.3f, z: 0.0f }, null);
    assert(contacts.length() > 0, "a sunken sphere touches the floor");
    assert(Math:::abs(contacts[0].depth - 0.2f) < 0.0001f, "it is 0.2 deep");
    assert(lantern:::physicsrig:::Near3(contacts[0].normal, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, 0.0001f), "and pushed up");
    delete contacts;
    print("contacts report depth and push direction");
    return 0;
}
