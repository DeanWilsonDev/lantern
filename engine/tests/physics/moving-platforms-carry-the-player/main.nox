lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::physics:::CollisionWorld();
    defer delete world;
    platformTriangles: Array<lantern:::physics:::Triangle>! = lantern:::physics:::BoxTriangles(Vec3 { }, Vec3 { x: 2.0f, y: 0.25f, z: 2.0f });
    platform := world->AddBody(platformTriangles, Mat4 { });
    delete platformTriangles;
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 0.3f, z: 0.0f });
    position~ Vec3 = Vec3 { };
    step~ u32 = 0;
    while step < 120 {
        world->BeginStep();
        if step >= 30 {
            position.x += 1.0f * lantern:::physicsrig:::STEP_SECONDS;
            world->SetBodyTransform(platform, Mat4:::translation(position));
        }
        controller.Step(world, lantern:::physicsrig:::Idle(), lantern:::physicsrig:::STEP_SECONDS);
        step += 1;
    }
    guard ground := controller.groundCollider return 1;
    assert(ground == lantern:::physics:::ColliderId:::Body(platform), "the player stands on the platform");
    assert(Math:::abs(controller.feetPosition.x - position.x) < 0.02f, "and rode along with it");
    assert(Math:::abs(controller.feetPosition.y - 0.25f) < 0.03f, "on its top");
    print("moving platforms carry the player");
    return 0;
}
