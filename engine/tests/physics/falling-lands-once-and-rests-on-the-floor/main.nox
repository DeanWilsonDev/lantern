lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 3.0f, z: 0.0f });
    landings~ u32 = 0;
    landingSpeed~ f32 = 0.0f;
    steps: u32 = lantern:::physicsrig:::StepsFor(2.0f);
    step~ u32 = 0;
    while step < steps {
        events := controller.Step(world, lantern:::physicsrig:::Idle(), lantern:::physicsrig:::STEP_SECONDS);
        if speed := events.landedWithSpeed {
            landings += 1;
            landingSpeed = speed;
        }
        step += 1;
    }
    assert(landings == 1, "the controller lands once");
    assert(Math:::abs(landingSpeed - 12.96f) < 1.0f, "from three metres it lands at about 13 m/s");
    assert(controller.grounded, "it rests on the floor");
    assert(Math:::abs(controller.feetPosition.y) < 0.03f, "with its feet on the floor");
    print("falling lands once and rests on the floor");
    return 0;
}
