lantern :: import lantern;

ApexHeight :: (holdSteps: u32) -> f32 {
    world := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete world;
    controller~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { });
    lantern:::physicsrig:::Settle(controller, world);
    controller.Step(world, lantern:::physics:::ControllerInput { jumpPressed: true, jumpHeld: true }, lantern:::physicsrig:::STEP_SECONDS);
    apex~ f32 = 0.0f;
    step~ u32 = 0;
    while step < 120 {
        controller.Step(world, lantern:::physics:::ControllerInput { jumpHeld: step < holdSteps }, lantern:::physicsrig:::STEP_SECONDS);
        apex = Math:::max(apex, controller.feetPosition.y);
        step += 1;
    }
    return apex;
}

main :: () -> i32 {
    full: f32 = ApexHeight(120);
    tapped: f32 = ApexHeight(3);
    assert(Math:::abs(full - lantern:::physics:::ControllerSettings { }.jumpHeight) < 0.1f, "a held jump reaches the jump height");
    assert(tapped < full * 0.6f, "a tap goes much lower");
    print("holding jump goes higher than tapping");
    return 0;
}
