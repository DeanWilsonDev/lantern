lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::physicsrig:::FloorWorld(10.0f);
    defer delete world;
    capsule := lantern:::physics:::Capsule:::Upright(0.5f, 2.0f);
    resting: Vec3 = Vec3 { x: 0.0f, y: 1.0f, z: 0.0f };
    sliding := world->CapsuleCast(capsule, resting, Vec3 { x: 3.0f, y: 0.0f, z: 0.0f }, null);
    assert(sliding == null, "sliding along the floor hits nothing");
    leaving := world->CapsuleCast(capsule, resting, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }, null);
    assert(leaving == null, "leaving the floor hits nothing");
    intoFloor := world->CapsuleCast(capsule, resting, Vec3 { x: 0.0f, y: -1.0f, z: 0.0f }, null);
    guard found := intoFloor return 1;
    assert(found.fraction == 0.0f, "pushing into the floor stops at once");
    print("touching surfaces allow sliding and leaving");
    return 0;
}
