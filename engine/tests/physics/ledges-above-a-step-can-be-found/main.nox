lantern :: import lantern;

main :: () -> i32 {
    forward: Vec3 = lantern:::physicsrig:::Forward();
    low := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete low;
    low->AddStaticBox(Vec3 { x: 0.0f, y: 0.15f, z: -2.0f }, Vec3 { x: 2.0f, y: 0.15f, z: 1.0f });
    stepper~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 0.0f, z: -0.6f });
    lantern:::physicsrig:::Settle(stepper, low);
    found1: bool = stepper.FindLedge(low, forward);
    assert(!found1, "a 0.3 m block is walked up, not mantled");

    ledge := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete ledge;
    ledge->AddStaticBox(Vec3 { x: 0.0f, y: 0.6f, z: -3.0f }, Vec3 { x: 2.0f, y: 0.6f, z: 1.5f });
    climber~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 0.0f, z: -0.9f });
    lantern:::physicsrig:::Settle(climber, ledge);
    found2: bool = climber.FindLedge(ledge, forward);
    assert(found2, "a 1.2 m ledge in reach is found");
    assert(Math:::abs(climber.ledgeStandPoint.y - 1.2f) < 0.02f, "its stand point is on the top");
    assert(climber.ledgeStandPoint.z < -1.5f, "set back from the edge");
    found3: bool = climber.FindLedge(ledge, -forward);
    assert(!found3, "nothing is found when facing away");

    far~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 0.0f, z: 3.0f });
    lantern:::physicsrig:::Settle(far, ledge);
    found4: bool = far.FindLedge(ledge, forward);
    assert(!found4, "a ledge out of reach is not found");

    tall := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete tall;
    tall->AddStaticBox(Vec3 { x: 0.0f, y: 1.5f, z: -3.0f }, Vec3 { x: 2.0f, y: 1.5f, z: 1.5f });
    short~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 0.0f, z: -0.9f });
    lantern:::physicsrig:::Settle(short, tall);
    found5: bool = short.FindLedge(tall, forward);
    assert(!found5, "a 3 m wall is too high to mantle");

    lowCeiling := lantern:::physicsrig:::FloorWorld(20.0f);
    defer delete lowCeiling;
    lowCeiling->AddStaticBox(Vec3 { x: 0.0f, y: 0.6f, z: -3.0f }, Vec3 { x: 2.0f, y: 0.6f, z: 1.5f });
    lowCeiling->AddStaticBox(Vec3 { x: 0.0f, y: 2.2f, z: -3.0f }, Vec3 { x: 2.0f, y: 0.5f, z: 1.5f });
    cramped~ lantern:::physics:::CharacterController = lantern:::physicsrig:::ControllerAt(Vec3 { x: 0.0f, y: 0.0f, z: -0.9f });
    lantern:::physicsrig:::Settle(cramped, lowCeiling);
    found6: bool = cramped.FindLedge(lowCeiling, forward);
    assert(!found6, "no room to stand on top means no mantle");
    print("ledges above a step can be found");
    return 0;
}
