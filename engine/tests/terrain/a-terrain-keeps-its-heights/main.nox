// A terrain's heights survive being written as text and read back to the centimetre, and a size or text that doesn't
// fit is refused.
lantern :: import lantern;

main :: () -> i32 {
    field := new lantern:::terrain:::Heightfield(5, 2.0f);
    defer delete field;
    field->SetHeight(0, 0, 1.234f);
    field->SetHeight(4, 4, -7.5f);
    field->SetHeight(2, 3, 300.0f);
    text: string! = field->Encode();
    defer delete text;
    assert(text.length() == 5 * 5 * 4, "four characters per vertex");
    decoded := lantern:::terrain:::Heightfield:::Decode(text, 5, 2.0f);
    when decoded! {
        Result:::Ok(restored) -> {
            assert(
                Math:::abs(restored->HeightAtVertex(0, 0) - 1.23f) < 0.001f,
                "centimetres are kept"
            );
            assert(
                Math:::abs(restored->HeightAtVertex(4, 4) + 7.5f) < 0.001f,
                "negative heights are kept"
            );
            assert(
                Math:::abs(restored->HeightAtVertex(2, 3) - 300.0f) < 0.001f,
                "a tall vertex is kept"
            );
            assert(
                Math:::abs(restored->HalfSpan() - 4.0f) < 0.0001f,
                "five columns of 2 metre cells span 8 metres"
            );
            delete restored;
        },
        Result:::Err(message) -> {
            delete message;
            return 1;
        }
    }
    tooShort := lantern:::terrain:::Heightfield:::Decode("0000", 5, 2.0f);
    assert(tooShort.isErr(), "text of the wrong length is refused");
    delete tooShort;
    tooSmall := lantern:::terrain:::Heightfield:::Decode(text, 1, 2.0f);
    assert(tooSmall.isErr(), "a single column is refused");
    delete tooSmall;
    flat := new lantern:::terrain:::Heightfield(3, 1.0f);
    defer delete flat;
    flat->SetHeight(0, 0, 4.0f);
    flat->SetHeight(1, 0, 4.0f);
    flat->SetHeight(0, 1, 4.0f);
    flat->SetHeight(1, 1, 4.0f);
    assert(
        Math:::abs(flat->HeightAtLocal(-0.5f, -0.5f) - 4.0f) < 0.0001f,
        "heights blend between vertices"
    );
    assert(
        Math:::abs(flat->HeightAtLocal(-50.0f, -50.0f) - 4.0f) < 0.0001f,
        "outside takes the nearest edge"
    );
    print("a terrain keeps its heights");
    return 0;
}
