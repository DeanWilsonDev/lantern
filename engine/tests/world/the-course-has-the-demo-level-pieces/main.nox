lantern :: import lantern;

main :: () -> i32 {
    world := lantern:::world:::LoadOrExit("../assets/worlds/course.world.json");
    defer delete world;
    assert(world->CountOfKind(lantern:::world:::BlockKind()) == 18, "eighteen blocks");
    assert(world->CountOfKind(lantern:::world:::RampKind()) == 2, "two ramps");
    assert(world->CountOfKind(lantern:::world:::GemKind()) == 6, "six gems");
    assert(world->CountOfKind(lantern:::world:::SpawnKind()) == 1, "one spawn");
    assert(world->CountOfKind(lantern:::world:::KillPlaneKind()) == 1, "one kill plane");
    platformIndex: usize? = world->FirstOfKind(lantern:::world:::MovingPlatformKind());
    guard platformAt := platformIndex return 1;
    platform: lantern:::world:::WorldEntity* = world->entities[platformAt];
    assert((platform->collider ?? lantern:::world:::ColliderKind:::Static) == lantern:::world:::ColliderKind:::Kinematic, "the moving platform is kinematic");
    assert((platform->NumberProperty("period_seconds") ?? 0.0f) == 6.0f, "its period is six seconds");
    assert((platform->VectorProperty("travel") ?? Vec3 { }) == Vec3 { x: 0.0f, y: 0.0f, z: -6.0f }, "it travels six metres along -z");
    spawnIndex: usize? = world->FirstOfKind(lantern:::world:::SpawnKind());
    guard spawnAt := spawnIndex return 1;
    killIndex: usize? = world->FirstOfKind(lantern:::world:::KillPlaneKind());
    guard killAt := killIndex return 1;
    assert(world->entities[spawnAt]->transform.position.y > world->entities[killAt]->transform.position.y, "the spawn is above the kill plane");
    print("the course has the demo level pieces");
    return 0;
}
