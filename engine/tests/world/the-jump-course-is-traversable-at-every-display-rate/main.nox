lantern :: import lantern;

main :: () -> i32 {
    rates: f64[4] = [30.0f, 60.0f, 144.0f, 240.0f];
    for displayHz in rates {
        result := lantern:::courserun:::RunCourse(displayHz, false);
        if problem := result->problem {
            print(problem);
        }
        assert(result->Succeeded(), "the pilot finishes the course on the goal");
        delete result;
    }
    print("the jump course is traversable at every display rate");
    return 0;
}
