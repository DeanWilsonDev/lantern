lantern :: import lantern;

main :: () -> i32 {
    world := new lantern:::world:::WorldFile("test");
    defer delete world;
    parent := lantern:::world:::Marker(1, "parent", null, Vec3 { x: 1.0f, y: 0.0f, z: 0.0f });
    parent->transform.rotationDegrees = Vec3 { x: 0.0f, y: 90.0f, z: 0.0f };
    world->Add(parent!);
    child := lantern:::world:::Marker(2, "child", 1, Vec3 { x: 0.0f, y: 0.0f, z: -2.0f });
    child->shape = lantern:::world:::Shape:::Box(lantern:::core:::Splat3(0.5f));
    world->Add(child!);
    pieces~ Array<lantern:::world:::WorldPiece*!>! = lantern:::world:::BuildPieces(world);
    childPosition: Vec3 = lantern:::core:::TransformPoint3(pieces[1]->worldMatrix, Vec3 { });
    assert((childPosition - Vec3 { x: -1.0f, y: 0.0f, z: 0.0f }).length() < 0.00001f, "a yaw of +90 degrees turns the child's -z into -x");
    pieces.freeAll();
    print("parents compose transforms");
    return 0;
}
