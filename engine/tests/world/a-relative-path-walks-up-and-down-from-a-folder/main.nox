// A path to a scene file, written from the folder of the world that places it.
lantern :: import lantern;

Check :: (fromDirectory: string, target: string, expected: string) -> void {
    result: string! = lantern:::world:::RelativePath(fromDirectory, target);
    defer delete result;
    if result != expected {
        print(result);
    }
    assert(result == expected, "the relative path is as expected");
}

main :: () -> i32 {
    Check("worlds", "worlds/scenes/hall.world.json", "scenes/hall.world.json");
    Check("worlds/levels", "worlds/scenes/hall.world.json", "../scenes/hall.world.json");
    Check("worlds/levels/deep", "worlds/scenes/hall.world.json", "../../scenes/hall.world.json");
    Check("worlds", "worlds/hall.world.json", "hall.world.json");
    Check("", "hall.world.json", "hall.world.json");
    print("a relative path walks up and down from a folder");
    return 0;
}
