// A scene dragged near a socket that is already in the world snaps so its socket lies on that one, facing the other way;
// the nearest pair wins, and a scene out of reach does not snap.
lantern :: import lantern;

main :: () -> i32 {
    ownPositions~ Array<Vec3>! = [Vec3 { x: 0.0f, y: 0.0f, z: -20.0f }, Vec3 { x: 0.0f, y: 0.0f, z: 20.0f }];
    ownYaws~ Array<f32>! = [0.0f, 180.0f];
    worldPositions~ Array<Vec3>! = [Vec3 { x: 0.0f, y: 0.0f, z: 100.0f }, Vec3 { x: 0.0f, y: 0.0f, z: -20.0f }];
    worldYaws~ Array<f32>! = [180.0f, 0.0f];
    defer delete ownPositions;
    defer delete ownYaws;
    defer delete worldPositions;
    defer delete worldYaws;

    near: lantern:::world:::SceneSnap = lantern:::world:::NearestSocketSnap(Vec3 { x: 0.5f, y: 0.0f, z: -40.5f }, 0.0f, ownPositions.borrow(), ownYaws.borrow(), worldPositions.borrow(), worldYaws.borrow(), 3.0f);
    assert(near.found, "a scene dragged beside a socket snaps");
    assert(near.ownIndex == 1 && near.worldIndex == 1, "its far socket meets the world socket it is nearest");
    assert(Math:::abs(near.placement.position.z - (-40.0f)) < 0.001f, "the scene lands one length past the socket");
    assert(Math:::abs(near.placement.position.x) < 0.001f, "and lines up in x");
    assert(Math:::abs(near.placement.rotationDegrees.y - 0.0f) < 0.001f, "facing the opposite way keeps the yaw");

    far: lantern:::world:::SceneSnap = lantern:::world:::NearestSocketSnap(Vec3 { x: 0.0f, y: 0.0f, z: -200.0f }, 0.0f, ownPositions.borrow(), ownYaws.borrow(), worldPositions.borrow(), worldYaws.borrow(), 3.0f);
    assert(!far.found, "a scene out of reach does not snap");

    print("sockets snap a dragged scene to the nearest pair");
    return 0;
}
