lantern :: import lantern;

main :: () -> i32 {
    loaded: string!? = tryReadTextFile("../assets/worlds/course.world.json");
    guard text := loaded return 1;
    when lantern:::world:::FromJson(text, "../assets/worlds/course.world.json") {
        Result:::Ok(world) -> {
            written: string! = world->ToJson();
            assert(written == text, "writing the course gives back the file byte for byte");
            delete written;
            delete world;
        },
        Result:::Err(message) -> {
            print(message);
            delete message;
            delete loaded;
            return 1;
        }
    }
    delete loaded;
    print("the course loads and is in canonical form");
    return 0;
}
