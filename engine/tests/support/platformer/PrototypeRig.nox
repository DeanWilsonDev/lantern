lantern:::testing :: namespace {
    HoldTwoKeys :: (scriptedPlatform: ScriptedPlatform~*, first: lantern:::core:::KeyCode, second: lantern:::core:::KeyCode, frames: usize) -> void {
        QueueEvent(scriptedPlatform, lantern:::platform:::PlatformEvent:::KeyDown(first, false));
        scriptedPlatform->AddEventToLastFrame(lantern:::platform:::PlatformEvent:::KeyDown(second, false));
        QueueFrames(scriptedPlatform, frames - 1);
        QueueEvent(scriptedPlatform, lantern:::platform:::PlatformEvent:::KeyUp(first));
        scriptedPlatform->AddEventToLastFrame(lantern:::platform:::PlatformEvent:::KeyUp(second));
    }

    HoldKeyAndRun :: (gameHost: lantern:::host:::GameHost~*, scriptedPlatform: ScriptedPlatform~*, frameLoop: lantern:::engine:::GameLoop~*, key: lantern:::core:::KeyCode, frames: usize) -> void {
        HoldKey(scriptedPlatform, key, frames);
        RunQueued(frameLoop, scriptedPlatform, gameHost);
    }

    HoldTwoKeysAndRun :: (gameHost: lantern:::host:::GameHost~*, scriptedPlatform: ScriptedPlatform~*, frameLoop: lantern:::engine:::GameLoop~*, first: lantern:::core:::KeyCode, second: lantern:::core:::KeyCode, frames: usize) -> void {
        HoldTwoKeys(scriptedPlatform, first, second, frames);
        RunQueued(frameLoop, scriptedPlatform, gameHost);
    }

    WaitFrames :: (gameHost: lantern:::host:::GameHost~*, scriptedPlatform: ScriptedPlatform~*, frameLoop: lantern:::engine:::GameLoop~*, frames: usize) -> void {
        QueueFrames(scriptedPlatform, frames);
        RunQueued(frameLoop, scriptedPlatform, gameHost);
    }

    TapKey :: (gameHost: lantern:::host:::GameHost~*, scriptedPlatform: ScriptedPlatform~*, frameLoop: lantern:::engine:::GameLoop~*, key: lantern:::core:::KeyCode) -> void {
        PressKey(scriptedPlatform, key);
        QueueFrames(scriptedPlatform, 2);
        RunQueued(frameLoop, scriptedPlatform, gameHost);
    }

    OpenPrototypeRoom :: (gameHost: lantern:::host:::GameHost~*, scriptedPlatform: ScriptedPlatform~*, frameLoop: lantern:::engine:::GameLoop~*, roomNumber: i32) -> void {
        for index~ i32 = 0; index < 4; index++ {
            TapKey(gameHost, scriptedPlatform, frameLoop, lantern:::core:::KeyCode:::Down);
        }
        TapKey(gameHost, scriptedPlatform, frameLoop, lantern:::core:::KeyCode:::Enter);
        for index~ i32 = 1; index < roomNumber; index++ {
            TapKey(gameHost, scriptedPlatform, frameLoop, lantern:::core:::KeyCode:::Down);
        }
        TapKey(gameHost, scriptedPlatform, frameLoop, lantern:::core:::KeyCode:::Enter);
        WaitFrames(gameHost, scriptedPlatform, frameLoop, 30);
    }

    PlayerX :: (gameHost: lantern:::host:::GameHost*) -> f32 {
        return FirstComponent(DebugText(gameHost, "Player/Position"));
    }

    PlayerY :: (gameHost: lantern:::host:::GameHost*) -> f32 {
        return SecondComponent(DebugText(gameHost, "Player/Position"));
    }

    PlayerZ :: (gameHost: lantern:::host:::GameHost*) -> f32 {
        return ThirdComponent(DebugText(gameHost, "Player/Position"));
    }

    PartnerX :: (gameHost: lantern:::host:::GameHost*) -> f32 {
        return FirstComponent(DebugText(gameHost, "Partner/Position"));
    }

    PartnerY :: (gameHost: lantern:::host:::GameHost*) -> f32 {
        return SecondComponent(DebugText(gameHost, "Partner/Position"));
    }

    PartnerZ :: (gameHost: lantern:::host:::GameHost*) -> f32 {
        return ThirdComponent(DebugText(gameHost, "Partner/Position"));
    }

    PartnerBeat :: (gameHost: lantern:::host:::GameHost*) -> f32 {
        return ParseDecimalOrFail(DebugText(gameHost, "Partner/Beat"), "the partner's beat");
    }
}
