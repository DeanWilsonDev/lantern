MenuModel :: import MenuModel;

// A small menu that the Chaos UI tests mount: a title in a <slot>, so it re-renders when the model's title changes, and
// two buttons.
// Focusing a button counts a move on the model, and releasing it records which button was chosen (`play` or `quit`).
// Because the model is a plain object shared with the test, a test checks what the menu did by reading it.
Menu :: (model~ MenuModel) -> lantern:::ui:::Element {
    return (
        <frame class="menu">
            <slot>
                !{(() -> lantern:::ui:::Element {
                    return (<text class="title">{model.title}</text>);
                })()}
            </slot>
            <frame class="button" onFocus={() -> void { model.moves += 1; }} onRelease={() -> void { model.chosen = "play"; }}>
                <text>Play</text>
            </frame>
            <frame class="button" onFocus={() -> void { model.moves += 1; }} onRelease={() -> void { model.chosen = "quit"; }}>
                <text>Quit</text>
            </frame>
        </frame>
    );
}
