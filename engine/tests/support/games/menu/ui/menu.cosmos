/* The look of Menu.chaos for the Chaos UI tests: a column on a dark blue panel, a large yellow title, and buttons that
   fill with yellow under the pointer. The tests check that these values reach the nodes and the drawn overlay. */
.menu {
    display: stack;
    flex-direction: column;
    padding: 10px;
    gap: 4px;
    background-color: #102030;
}

.title {
    font-size: 32px;
    color: #FFD24D;
}

.button {
    padding: 2px 6px;
    background-color: #00000080;
}

.button:hover {
    background-color: #FFD24D;
}
