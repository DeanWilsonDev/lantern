NyxC :: import NyxC;

lantern:::testing :: namespace {
    HeadlessState :: () -> lantern:::host:::EngineState*! {
        when lantern:::host:::EngineState:::Create(new lantern:::host:::HeadlessRenderer(), new lantern:::engine:::AudioSystem(null), null) {
            Result:::Ok(state) -> {
                return state!;
            },
            Result:::Err(message) -> {
                print(`the engine state failed: ${message}`);
                delete message;
                assert(false, "the headless engine state starts");
                return new lantern:::host:::EngineState(new lantern:::host:::HeadlessRenderer(), new lantern:::engine:::AudioSystem(null), null);
            }
        }
    }

    RegisterEngineOrFail :: (runtime: lantern:::nyx:::Runtime~*, state: lantern:::host:::EngineState~*, math: lantern:::host:::MathTypes~*) -> void {
        failed~ lantern:::nyx:::NyxError*!? = null;
        unsafe {
            statePointer: raw lantern:::host:::EngineState~* = state;
            failed = lantern:::host:::RegisterEngineApis(runtime, statePointer, math);
        }
        if error := failed {
            text: string! = error->Text();
            print(`the engine API failed to register: ${text}`);
            delete text;
        }
        assert(failed == null, "the engine API registers");
        delete failed;
    }

    CallOrFail :: (program: lantern:::nyx:::Program*, name: string) -> void {
        noArguments: Array<lantern:::nyx:::Value*>! = [];
        value := ValueOrFail(program->CallFunction(name, noArguments));
        delete noArguments;
        delete value;
    }
}
