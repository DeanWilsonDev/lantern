NyxC :: import NyxC;

lantern:::testing :: namespace {
    HeadlessState :: () -> lantern:::host:::EngineState*! {
        when lantern:::host:::EngineState:::Create(new lantern:::host:::HeadlessRenderer(), new lantern:::engine:::AudioSystem(null), null) {
            Result:::Ok(state) -> {
                return state!;
            },
            Result:::Err(message) -> {
                print(`the engine state failed: ${message}`);
                delete message;
                assert(false, "the headless engine state starts");
                return new lantern:::host:::EngineState(new lantern:::host:::HeadlessRenderer(), new lantern:::engine:::AudioSystem(null), null);
            }
        }
    }

    RegisterEngineOrFail :: (runtime: lantern:::nyx:::Runtime~*, state: lantern:::host:::EngineState~*, math: lantern:::host:::MathTypes~*) -> void {
        failed~ lantern:::nyx:::NyxError*!? = null;
        unsafe {
            statePointer: raw lantern:::host:::EngineState~* = state;
            failed = lantern:::host:::RegisterEngineApis(runtime, statePointer, math);
        }
        if error := failed {
            text: string! = error->Text();
            print(`the engine API failed to register: ${text}`);
            delete text;
        }
        assert(failed == null, "the engine API registers");
        delete failed;
    }

    CallOrFail :: (program: lantern:::nyx:::Program*, name: string) -> void {
        noArguments: Array<lantern:::nyx:::Value*>! = [];
        value := ValueOrFail(program->CallFunction(name, noArguments));
        delete noArguments;
        delete value;
    }

    F32Result :: (program: lantern:::nyx:::Program*, name: string) -> f32 {
        noArguments: Array<lantern:::nyx:::Value*>! = [];
        value := ValueOrFail(program->CallFunction(name, noArguments));
        delete noArguments;
        result: f32 = F32OrFail(value->F32());
        delete value;
        return result;
    }

    BoolResult :: (program: lantern:::nyx:::Program*, name: string) -> bool {
        noArguments: Array<lantern:::nyx:::Value*>! = [];
        value := ValueOrFail(program->CallFunction(name, noArguments));
        delete noArguments;
        result: bool = BoolOrFail(value->Bool());
        delete value;
        return result;
    }

    TextResult :: (program: lantern:::nyx:::Program*, name: string) -> string! {
        noArguments: Array<lantern:::nyx:::Value*>! = [];
        value := ValueOrFail(program->CallFunction(name, noArguments));
        delete noArguments;
        result: string! = TextOrFail(value->Text());
        delete value;
        return result!;
    }

    ExpectText :: (program: lantern:::nyx:::Program*, name: string, expected: string) -> void {
        text: string! = TextResult(program, name);
        if text != expected {
            print(`${name} returned '${text}', not '${expected}'`);
        }
        assert(text == expected, "the script returns the expected text");
        delete text;
    }

    ExpectTextStart :: (program: lantern:::nyx:::Program*, name: string, expectedStart: string) -> void {
        text: string! = TextResult(program, name);
        if !text.startsWith(expectedStart) {
            print(`${name} returned '${text}', which doesn't start with '${expectedStart}'`);
        }
        assert(text.startsWith(expectedStart), "the script's text starts as expected");
        delete text;
    }
}
