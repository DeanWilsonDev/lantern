lantern:::testing :: namespace {
    LEVEL: u32 : 1;

    Level :: () -> lantern:::engine:::SceneId {
        return lantern:::engine:::SceneId { value: LEVEL };
    }

    Near3 :: (first: Vec3, second: Vec3) -> bool {
        return (first - second).length() < 0.00001f;
    }

    PositionOf :: (world: lantern:::engine:::World*, id: lantern:::core:::Handle<lantern:::engine:::EntityTag>) -> Vec3 {
        guard record := world->Get(id) return Vec3 { x: 1000000.0f, y: 1000000.0f, z: 1000000.0f };
        return record.WorldPosition();
    }
}
