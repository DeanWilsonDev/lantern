lantern:::testing :: namespace {
    FakeSink :: class {
        implements:
            lantern:::platform:::AudioSink;
    public:
        queuedFrames~ usize = 0;
        pushedSampleCount~ usize = 0;

        FakeSink~: () { }

        SampleRate :: () -> u32 {
            return 1000;
        }

        QueuedFrames :: () -> usize {
            return queuedFrames;
        }

        PushFrames~: (interleavedStereo: Array<f32>) -> void {
            queuedFrames += interleavedStereo.length() / 2;
            pushedSampleCount += interleavedStereo.length();
        }
    }

    FakeSinkOf :: (audioSystem: lantern:::engine:::AudioSystem~*) -> FakeSink~*? {
        guard device ~= audioSystem->sink return null;
        return device as FakeSink~*;
    }

    QueuedFramesOf :: (audioSystem: lantern:::engine:::AudioSystem~*) -> usize {
        guard sink ~= FakeSinkOf(audioSystem) return 0;
        return sink->queuedFrames;
    }

    PushedSamplesOf :: (audioSystem: lantern:::engine:::AudioSystem~*) -> usize {
        guard sink ~= FakeSinkOf(audioSystem) return 0;
        return sink->pushedSampleCount;
    }

    PlayFramesDownTo :: (audioSystem: lantern:::engine:::AudioSystem~*, remainingFrames: usize) -> void {
        if sink ~= FakeSinkOf(audioSystem) {
            sink->queuedFrames = remainingFrames;
        }
    }
}
