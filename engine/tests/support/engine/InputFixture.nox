lantern:::testing :: namespace {
    InputFixture :: class {
    public:
        router~ lantern:::engine:::InputRouter*!;
        jump~ lantern:::core:::ActionId = lantern:::core:::ActionId { };
        movement~ lantern:::core:::ActionId = lantern:::core:::ActionId { };
        look~ lantern:::core:::ActionId = lantern:::core:::ActionId { };

        InputFixture~: () {
            actions := new lantern:::core:::ActionSet();
            jump = actions->Register("jump", lantern:::core:::ActionKind:::Button);
            movement = actions->Register("move", lantern:::core:::ActionKind:::Axis2D);
            look = actions->Register("look", lantern:::core:::ActionKind:::Axis2D);
            bindings := new lantern:::core:::Bindings();
            bindings->Bind(jump, lantern:::core:::Binding:::Key(lantern:::core:::KeyCode:::Space));
            bindings->Bind(jump, lantern:::core:::Binding:::Gamepad(lantern:::core:::GamepadButton:::South));
            bindings->Bind(movement, lantern:::core:::Binding:::KeyVector(
                lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::S, lantern:::core:::KeyCode:::A, lantern:::core:::KeyCode:::D));
            bindings->Bind(movement, lantern:::core:::Binding:::Stick(lantern:::core:::GamepadStick:::Left, 1.0f));
            bindings->Bind(look, lantern:::core:::Binding:::MouseMotion(0.5f));
            router = new lantern:::engine:::InputRouter(actions!, bindings!);
        }

        !InputFixture~: () {
            delete router;
        }
    }

    SpaceDown :: () -> lantern:::platform:::PlatformEvent {
        return lantern:::platform:::PlatformEvent:::KeyDown(lantern:::core:::KeyCode:::Space, false);
    }

    SpaceUp :: () -> lantern:::platform:::PlatformEvent {
        return lantern:::platform:::PlatformEvent:::KeyUp(lantern:::core:::KeyCode:::Space);
    }

    EmptyFrame :: (router: lantern:::engine:::InputRouter~*) -> void {
        router->EndFrameEvents();
    }

    FrameWith :: (router: lantern:::engine:::InputRouter~*, event: lantern:::platform:::PlatformEvent) -> void {
        router->HandleEvent(event);
        router->EndFrameEvents();
    }

    FrameWithBoth :: (router: lantern:::engine:::InputRouter~*, first: lantern:::platform:::PlatformEvent, second: lantern:::platform:::PlatformEvent) -> void {
        router->HandleEvent(first);
        router->HandleEvent(second);
        router->EndFrameEvents();
    }

    Report :: (name: string, state: lantern:::core:::ActionState) -> void {
        print(`${name} held ${state.held} pressed ${state.pressed} released ${state.released} value ${state.value.x:.3f} ${state.value.y:.3f}`);
    }
}
