lantern:::world :: namespace {
    Marker :: (id: u64, name: string, parent: u64?, position: Vec3) -> WorldEntity*! {
        entity := new WorldEntity(id, name, "marker");
        entity->parent = parent;
        entity->transform = TransformData:::FromPosition(position);
        return entity!;
    }

    LoadOrExit :: (path: string) -> WorldFile*! {
        when Load(path) {
            Result:::Ok(world) -> {
                return world!;
            },
            Result:::Err(message) -> {
                print(message);
                delete message;
                assert(false, "the world loads");
                return new WorldFile("unreachable");
            }
        }
    }
}
