lantern:::testing :: namespace {
    ConstantSound :: (value: f32, frames: usize) -> lantern:::audio:::SoundData*! {
        sound := new lantern:::audio:::SoundData(48000);
        for index~ usize = 0; index < frames * 2; index++ {
            sound->samples.push(value);
        }
        return sound!;
    }

    QuietMixer :: () -> lantern:::audio:::Mixer*! {
        mixer := new lantern:::audio:::Mixer(48000);
        mixer->volumes = lantern:::audio:::Volumes { master: 1.0f, music: 1.0f, effects: 1.0f };
        return mixer!;
    }

    AddConstant :: (mixer: lantern:::audio:::Mixer~*, value: f32, frames: usize) -> lantern:::core:::Handle<lantern:::audio:::SoundTag> {
        sound := ConstantSound(value, frames);
        handle: lantern:::core:::Handle<lantern:::audio:::SoundTag> = mixer->AddSound(sound);
        delete sound;
        return handle;
    }

    DecodeOrExit :: (bytes: Array<u8>) -> lantern:::audio:::SoundData*! {
        when lantern:::audio:::DecodeWav(bytes) {
            Result:::Ok(sound) -> {
                return sound!;
            },
            Result:::Err(message) -> {
                print(message);
                delete message;
                return new lantern:::audio:::SoundData(0);
            }
        }
    }

    FailureOf :: (bytes: Array<u8>) -> string! {
        when lantern:::audio:::DecodeWav(bytes) {
            Result:::Ok(sound) -> {
                delete sound;
                decoded~ string! = "";
                decoded += "decoded";
                return decoded!;
            },
            Result:::Err(message) -> {
                return message!;
            }
        }
    }
}
