// A small leg rig and a joint-position helper for the animation tests that check how a pose moves a skeleton.
lantern:::animation_support :: namespace {
    /**
     * A rig of a hip joint at one metre and two straight legs, 0.5 m of thigh and 0.5 m of shin each, so the ankles rest
     * on the ground at y 0. The joints use the mannequin's names (`leftThigh`, `leftShin`, `leftFoot` and the right ones),
     * so a `FootPlacer` finds them. The model faces -z.
     */
    MakeLegRig :: () -> lantern:::animation:::Rig*! {
        rig := new lantern:::animation:::Rig();
        skeleton: lantern:::animation:::Skeleton~* = rig->skeleton;
        hips: i32 = skeleton->AddJoint("hips", -1, lantern:::animation:::JointTransform:::At(Vec3 { y: 1.0f }));
        skeleton->AddJoint("leftThigh", hips, lantern:::animation:::JointTransform:::At(Vec3 { x: -0.1f }));
        skeleton->AddJoint("leftShin", 1, lantern:::animation:::JointTransform:::At(Vec3 { y: -0.5f }));
        skeleton->AddJoint("leftFoot", 2, lantern:::animation:::JointTransform:::At(Vec3 { y: -0.5f }));
        skeleton->AddJoint("rightThigh", hips, lantern:::animation:::JointTransform:::At(Vec3 { x: 0.1f }));
        skeleton->AddJoint("rightShin", 4, lantern:::animation:::JointTransform:::At(Vec3 { y: -0.5f }));
        skeleton->AddJoint("rightFoot", 5, lantern:::animation:::JointTransform:::At(Vec3 { y: -0.5f }));
        return rig!;
    }

    /** Where a joint is in model space for a pose. */
    JointPosition :: (rig: lantern:::animation:::Rig*, pose: Array<lantern:::animation:::JointTransform>, joint: i32) -> Vec3 {
        matrices: Array<Mat4>! = rig->skeleton->ModelMatrices(pose);
        position: Vec3 = lantern:::core:::TransformPoint3(matrices[usize(joint)], Vec3 { });
        delete matrices;
        return position;
    }
}
