Sdl :: import Sdl;
lantern :: import lantern;

main :: () -> i32 {
    unsafe {
        Sdl:::SDL_SetHint(Sdl:::SDL_HINT_VIDEO_DRIVER, "offscreen");
        Sdl:::SDL_SetHint(Sdl:::SDL_HINT_AUDIO_DRIVER, "dummy");
    }
    context := lantern:::sdl:::SdlContext:::Init();
    guard context return 1;
    defer delete context;
    output := lantern:::sdl:::SdlAudioOutput:::Open(context, 48000);
    guard output return 2;
    defer delete output;
    print(`sample rate ${output->SampleRate()}`);
    frames~ Array<f32>! = [];
    defer delete frames;
    for sample~ usize = 0; sample < 960; sample++ {
        frames.push(0.0f);
    }
    output->PushFrames(frames);
    print(`queued at least one frame ${output->QueuedFrames() > 0}`);
    return 0;
}
