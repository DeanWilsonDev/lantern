// The sunlit street (sun, shadows, procedural sky, fog) matches its reference screenshot on the software renderer. Skips elsewhere.
lantern :: import lantern;

main :: () -> i32 {
    if lantern:::screenshots:::ReadyToCompare("lit-street") {
        created := lantern:::gpu:::GpuRenderer:::CreateOffscreen(lantern:::gpu:::GpuOptions { debugEnabled: false, vsync: false });
        when created! {
            Result:::Ok(renderer) -> {
                defer delete renderer;
                assets := lantern:::screenshots:::LoadAssets(renderer);
                world := lantern:::screenshots:::LitStreet(assets);
                defer delete world;
                lantern:::screenshots:::CaptureAndCheck(renderer, world, "lit-street");
            },
            Result:::Err(message) -> {
                lantern:::gputest:::Skip(message);
                delete message;
            }
        }
    }
    print("the lit street matches its screenshot");
    return 0;
}
