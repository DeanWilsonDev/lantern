// Overlay text, panels, a gradient triangle and debug lines over a small scene match the reference screenshot on the software renderer. Skips elsewhere.
lantern :: import lantern;

main :: () -> i32 {
    if lantern:::screenshots:::ReadyToCompare("overlay-ui") {
        created := lantern:::gpu:::GpuRenderer:::CreateOffscreen(lantern:::gpu:::GpuOptions { debugEnabled: false, vsync: false });
        when created! {
            Result:::Ok(renderer) -> {
                defer delete renderer;
                assets := lantern:::screenshots:::LoadAssets(renderer);
                world := lantern:::screenshots:::OverlayMenu(assets);
                defer delete world;
                lantern:::screenshots:::CaptureAndCheck(renderer, world, "overlay-ui");
            },
            Result:::Err(message) -> {
                lantern:::gputest:::Skip(message);
                delete message;
            }
        }
    }
    print("the overlay UI matches its screenshot");
    return 0;
}
