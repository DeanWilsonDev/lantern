// A sun, a point light and a spot light casting shadows over a plain floor match the reference screenshot on the software renderer. Skips elsewhere.
lantern :: import lantern;

main :: () -> i32 {
    if lantern:::screenshots:::ReadyToCompare("shadows") {
        created := lantern:::gpu:::GpuRenderer:::CreateOffscreen(lantern:::gpu:::GpuOptions { debugEnabled: false, vsync: false });
        when created! {
            Result:::Ok(renderer) -> {
                defer delete renderer;
                assets := lantern:::screenshots:::LoadAssets(renderer);
                world := lantern:::screenshots:::ShadowYard(assets);
                defer delete world;
                lantern:::screenshots:::CaptureAndCheck(renderer, world, "shadows");
            },
            Result:::Err(message) -> {
                lantern:::gputest:::Skip(message);
                delete message;
            }
        }
    }
    print("the shadows match their screenshot");
    return 0;
}
