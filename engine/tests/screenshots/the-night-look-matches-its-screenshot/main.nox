// The street at night (moon, dark sky and fog, glowing lamps, wet road, bloom, grade, vignette) matches its reference screenshot on the software renderer. Skips elsewhere.
lantern :: import lantern;

main :: () -> i32 {
    if lantern:::screenshots:::ReadyToCompare("night-look") {
        created := lantern:::gpu:::GpuRenderer:::CreateOffscreen(lantern:::gpu:::GpuOptions { debugEnabled: false, vsync: false });
        when created! {
            Result:::Ok(renderer) -> {
                defer delete renderer;
                assets := lantern:::screenshots:::LoadAssets(renderer);
                world := lantern:::screenshots:::NightStreet(assets);
                defer delete world;
                lantern:::screenshots:::CaptureAndCheck(renderer, world, "night-look");
            },
            Result:::Err(message) -> {
                lantern:::gputest:::Skip(message);
                delete message;
            }
        }
    }
    print("the night look matches its screenshot");
    return 0;
}
