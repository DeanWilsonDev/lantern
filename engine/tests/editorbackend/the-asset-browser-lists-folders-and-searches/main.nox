lantern :: import lantern;

main :: () -> i32 {
    top: string! = lantern:::editorbackend:::ListAssetEntries("../games/platformer/assets", "", "");
    assert(top.contains("folder\tSilhouettes\tSilhouettes\n"), "the top lists the Silhouettes root");
    assert(top.contains("folder\tScripts\tScripts\n"), "the top lists the Scripts root");
    assert(top.contains("folder\tTextures\tTextures\n"), "the top lists the Textures root");
    delete top;

    silhouettes: string! = lantern:::editorbackend:::ListAssetEntries("../games/platformer/assets", "Silhouettes", "");
    assert(silhouettes.contains("silhouette\tblock\tSilhouettes/block\n"), "a folder with a root file is a silhouette");
    delete silhouettes;

    textures: string! = lantern:::editorbackend:::ListAssetEntries("../games/platformer/assets", "Textures", "");
    assert(textures.contains("texture\tground.png\tTextures/ground.png\n"), "a png is a texture");
    delete textures;

    found: string! = lantern:::editorbackend:::ListAssetEntries("../games/platformer/assets", "", "LAMP");
    assert(found.contains("silhouette\tlamp_post\tSilhouettes/lamp_post\n"), "a search ignores case and finds a silhouette");
    assert(found.contains("graph\tlamp_pulse\tGraphs/lamp_pulse.graph.json\n"), "a search finds a graph");
    assert(!found.contains("texture"), "a search leaves out what doesn't match");
    delete found;

    scripts: string! = lantern:::editorbackend:::ListAssetEntries("../games/platformer/assets", "", "crumble");
    assert(scripts.contains("script\tcrumble-platform.nyx\tScripts/game-entities/crumble-platform.nyx\n"), "a search reaches into script folders");
    delete scripts;

    missing: string! = lantern:::editorbackend:::ListAssetEntries("../games/platformer/assets", "Nowhere", "");
    assert(missing.length() == 0, "an unknown folder lists nothing");
    delete missing;

    print("the asset browser lists folders and searches");
    return 0;
}
