// A graph saved from the editor goes to the game's own graphs folder in a checkout, and to `graphs` beside the assets
// anywhere else.
lantern :: import lantern;

main :: () -> i32 {
    inCheckout: string! = lantern:::editorbackend:::GraphsFolder("../games/platformer/assets");
    defer delete inCheckout;
    if !inCheckout.endsWith("/games/platformer/game-graphs") {
        print(inCheckout);
        return 1;
    }
    elsewhere: string! = lantern:::editorbackend:::GraphsFolder("/nowhere/assets");
    defer delete elsewhere;
    if elsewhere != "/nowhere/assets/graphs" {
        print(elsewhere);
        return 2;
    }
    print("the editor saves graphs where the game reads them");
    return 0;
}
