lantern :: import lantern;

SCRATCH: string : "/tmp/lantern-silhouette-values-test";

Succeeded :: (problem: string!?) -> bool {
    worked: bool = problem == null;
    delete problem;
    return worked;
}

Copy :: (name: string) -> bool {
    from: string! = `../games/platformer/assets/silhouettes/${name}/root.calamus`;
    defer delete from;
    folder: string! = `${SCRATCH}/assets/silhouettes/${name}`;
    defer delete folder;
    createDirectories(folder);
    to: string! = `${folder}/root.calamus`;
    defer delete to;
    when readTextFile(from) {
        Result:::Err(error) -> {
            delete error;
            return false;
        },
        Result:::Ok(text) -> {
            defer delete text;
            when writeTextFile(to, text) {
                Result:::Err(error) -> {
                    delete error;
                    return false;
                },
                Result:::Ok(written) -> {
                    return true;
                }
            }
        }
    }
}

HasLine :: (template: lantern:::editor:::EntityTemplate*, wanted: string) -> bool {
    lines := lantern:::editorbackend:::ComponentValueLines(template, 0);
    defer delete lines;
    for line in lines->lines {
        if line == wanted {
            return true;
        }
    }
    return false;
}

main :: () -> i32 {
    assets: string = "/tmp/lantern-silhouette-values-test/assets";
    if directoryExists(SCRATCH) {
        Succeeded(lantern:::editorbackend:::RemoveTree(SCRATCH));
    }
    assert(Copy("moving_platform"), "the base is copied");
    assert(Copy("moving_platform_wide"), "the variant is copied");
    palette := new lantern:::editor:::Palette();
    defer delete palette;
    lantern:::editorbackend:::AddSilhouetteTemplates(palette, assets);

    assert(Succeeded(lantern:::editorbackend:::EditSilhouetteValue(assets, "moving_platform", "", "material", "\"wall\"", false)), "a base value is set");
    assert(Succeeded(lantern:::editorbackend:::EditSilhouetteValue(assets, "moving_platform", "", "extra.depth.level", "3", false)), "a value is added under new keys");
    assert(Succeeded(lantern:::editorbackend:::RefreshSilhouetteTemplate(palette, assets, "moving_platform")), "the base loads");
    guard base := palette->Template("moving_platform") return 1;
    assert(HasLine(base, "material: \"wall\""), "the base shows the new material");
    assert(HasLine(base, "extra.depth.level: 3"), "the nested key was added");

    assert(Succeeded(lantern:::editorbackend:::EditSilhouetteValue(assets, "moving_platform_wide", "", "material", "\"glass\"", false)), "a variant sets a value");
    assert(Succeeded(lantern:::editorbackend:::RefreshSilhouetteTemplate(palette, assets, "moving_platform_wide")), "the variant loads");
    guard wide := palette->Template("moving_platform_wide") return 2;
    assert(HasLine(wide, "* material: \"glass\""), "the variant marks its own material");
    assert(HasLine(wide, "* shape.half_extents: [2.5, 0.2, 2.5]"), "the variant keeps its other marked values");

    assert(Succeeded(lantern:::editorbackend:::EditSilhouetteValue(assets, "moving_platform_wide", "", "material", "", true)), "the value is reverted");
    assert(Succeeded(lantern:::editorbackend:::RefreshSilhouetteTemplate(palette, assets, "moving_platform_wide")), "the variant loads again");
    guard reverted := palette->Template("moving_platform_wide") return 3;
    assert(HasLine(reverted, "  material: \"wall\""), "the reverted value is inherited again");

    assert(Succeeded(lantern:::editorbackend:::EditSilhouetteValue(assets, "moving_platform_wide", "", "name", "", true)), "the name is reverted");
    assert(Succeeded(lantern:::editorbackend:::RefreshSilhouetteTemplate(palette, assets, "moving_platform_wide")), "the variant loads once more");
    guard renamedBack := palette->Template("moving_platform_wide") return 4;
    assert(HasLine(renamedBack, "  name: \"Moving platform\""), "the reverted name is inherited again");

    badValue: bool = !Succeeded(lantern:::editorbackend:::EditSilhouetteValue(assets, "moving_platform", "", "material", "wall", false));
    assert(badValue, "text without quotes is refused");
    badKey: bool = !Succeeded(lantern:::editorbackend:::EditSilhouetteValue(assets, "moving_platform", "", "a..b", "1", false));
    assert(badKey, "a malformed key is refused");
    noBase: bool = !Succeeded(lantern:::editorbackend:::EditSilhouetteValue(assets, "moving_platform", "", "material", "", true));
    assert(noBase, "a Silhouette with no base has nothing to revert to");

    assert(Succeeded(lantern:::editorbackend:::RemoveTree(SCRATCH)), "the scratch folder is removed");
    print("a silhouette value is set and reverted");
    return 0;
}
