SilhouetteCategories :: import SilhouetteCategories;
EditorModes :: import EditorModes;
PanelDocking :: import PanelDocking;

// The checks of the editor's mode, Silhouettes panel and panel docking rules, each adding one to the count when it fails.
EditorModeChecks :: namespace {
    Has :: (names: Array<string>, wanted: string) -> bool {
        for name in names {
            if name == wanted {
                return true;
            }
        }
        return false;
    }

    Failures :: () -> i32 {
        failures~ i32 = 0;
        if Has(EditorModes:::MenuNames("select"), "Add") { failures += 1; }
        if !Has(EditorModes:::MenuNames("select"), "Selection") { failures += 1; }
        if EditorModes:::HasBottomPage("select", "silhouettes") || !EditorModes:::HasBottomPage("silhouette", "silhouettes") { failures += 1; }
        if Has(EditorModes:::MenuNames("select"), "Terrain") { failures += 1; }
        if !Has(EditorModes:::MenuNames("terrain"), "Terrain") { failures += 1; }
        if Has(EditorModes:::MenuNames("terrain"), "Selection") { failures += 1; }
        if Has(EditorModes:::MenuNames("silhouette"), "View") { failures += 1; }
        if EditorModes:::MenuNames("graph").length() != 4 { failures += 1; }
        if EditorModes:::Names().length() != 2 { failures += 1; }
        if EditorModes:::ForDigit("2") != "terrain" { failures += 1; }
        if EditorModes:::ForDigit("3") != "" { failures += 1; }
        if !EditorModes:::ShowsRightDock("select") || EditorModes:::ShowsRightDock("terrain") { failures += 1; }
        if EditorModes:::BottomPageShown("terrain", "assets") != "terrain" { failures += 1; }
        if EditorModes:::BottomPageShown("terrain", "console") != "console" { failures += 1; }
        if EditorModes:::BottomPageShown("graph", "silhouettes") != "console" { failures += 1; }
        if EditorModes:::ModeOfPage("terrain") != "terrain" || EditorModes:::ModeOfPage("history") != "" { failures += 1; }
        if SilhouetteCategories:::CategoryOf("block", 1) != "Shapes" { failures += 1; }
        if SilhouetteCategories:::CategoryOf("block", 2) != "Props" { failures += 1; }
        if SilhouetteCategories:::CategoryOf("sun", 1) != "Lights" { failures += 1; }
        if SilhouetteCategories:::CategoryOf("terrain", 1) != "Terrain" { failures += 1; }
        if SilhouetteCategories:::CategoryOf("gem", 1) != "Props" { failures += 1; }
        if !SilhouetteCategories:::InCategory("All", "Lights") || SilhouetteCategories:::InCategory("Shapes", "Lights") { failures += 1; }
        if !SilhouetteCategories:::Matches("", "Lamp post", "lamp_post") { failures += 1; }
        if !SilhouetteCategories:::Matches(" LAMP ", "Lamp post", "lamp_post") { failures += 1; }
        if !SilhouetteCategories:::Matches("post", "Street light", "lamp_post") { failures += 1; }
        if SilhouetteCategories:::Matches("gem", "Lamp post", "lamp_post") { failures += 1; }
        if SilhouetteCategories:::PanelX(1000.0f, 1920.0f) != 1000.0f - SilhouetteCategories:::PANEL_WIDTH - SilhouetteCategories:::RAIL_GAP { failures += 1; }
        if SilhouetteCategories:::PanelX(100.0f, 1920.0f) != SilhouetteCategories:::EDGE_MARGIN { failures += 1; }
        if SilhouetteCategories:::PanelY(20.0f, 1080.0f) != SilhouetteCategories:::TOP_LIMIT { failures += 1; }
        if SilhouetteCategories:::PanelY(1070.0f, 1080.0f) != 1080.0f - SilhouetteCategories:::PANEL_HEIGHT - SilhouetteCategories:::BOTTOM_LIMIT { failures += 1; }
        if SilhouetteCategories:::PlacedTemplate(SilhouetteCategories:::PlaceCommand("ramp")) != "ramp" { failures += 1; }
        if SilhouetteCategories:::PlacedTemplate("mode:terrain") != "" { failures += 1; }
        if PanelDocking:::DropPlace(30.0f, 500.0f, 1920.0f, 1080.0f) != "left" { failures += 1; }
        if PanelDocking:::DropPlace(1900.0f, 1050.0f, 1920.0f, 1080.0f) != "right" { failures += 1; }
        if PanelDocking:::DropPlace(900.0f, 1040.0f, 1920.0f, 1080.0f) != "bottom" { failures += 1; }
        if PanelDocking:::DropPlace(900.0f, 500.0f, 1920.0f, 1080.0f) != "float" { failures += 1; }
        if PanelDocking:::DefaultPlace("drawer") != "bottom" || PanelDocking:::DefaultPlace("outliner") != "right" { failures += 1; }
        if PanelDocking:::IsPlace("middle") || !PanelDocking:::IsPlace("float") { failures += 1; }
        if PanelDocking:::BelongsToMode("outliner", false) || !PanelDocking:::BelongsToMode("drawer", false) { failures += 1; }
        if PanelDocking:::FloatCorner(500.0f, 40.0f, 320.0f, 1920.0f) != 460.0f { failures += 1; }
        if PanelDocking:::FloatCorner(10.0f, 40.0f, 320.0f, 1920.0f) != 0.0f { failures += 1; }
        if PanelDocking:::FloatCorner(1900.0f, 40.0f, 320.0f, 1920.0f) != 1600.0f { failures += 1; }
        if PanelDocking:::PreviewRect("right", "details", 1920.0f, 1080.0f, 0.0f, 0.0f).x != 1920.0f - PanelDocking:::SIDE_PREVIEW_WIDTH { failures += 1; }
        if PanelDocking:::PreviewRect("float", "drawer", 1920.0f, 1080.0f, 50.0f, 60.0f).width != PanelDocking:::FloatWidth("drawer") { failures += 1; }
        return failures;
    }
}
