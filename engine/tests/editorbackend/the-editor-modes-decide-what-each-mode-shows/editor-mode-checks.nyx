AddMenuItems :: import AddMenuItems;
EditorModes :: import EditorModes;

// The checks of the editor's mode and Add menu rules, each adding one to the count when it fails.
EditorModeChecks :: namespace {
    Has :: (names: Array<string>, wanted: string) -> bool {
        for name in names {
            if name == wanted {
                return true;
            }
        }
        return false;
    }

    Failures :: () -> i32 {
        failures~ i32 = 0;
        if !Has(EditorModes:::MenuNames("select"), "Add") { failures += 1; }
        if Has(EditorModes:::MenuNames("select"), "Terrain") { failures += 1; }
        if !Has(EditorModes:::MenuNames("terrain"), "Terrain") { failures += 1; }
        if Has(EditorModes:::MenuNames("terrain"), "Selection") { failures += 1; }
        if Has(EditorModes:::MenuNames("silhouette"), "View") { failures += 1; }
        if EditorModes:::MenuNames("graph").length() != 4 { failures += 1; }
        if EditorModes:::Names().length() != 2 { failures += 1; }
        if EditorModes:::ForDigit("2") != "terrain" { failures += 1; }
        if EditorModes:::ForDigit("3") != "" { failures += 1; }
        if !EditorModes:::ShowsRightDock("select") || EditorModes:::ShowsRightDock("terrain") { failures += 1; }
        if EditorModes:::BottomPageShown("terrain", "assets") != "terrain" { failures += 1; }
        if EditorModes:::BottomPageShown("terrain", "console") != "console" { failures += 1; }
        if EditorModes:::BottomPageShown("graph", "silhouettes") != "console" { failures += 1; }
        if EditorModes:::ModeOfPage("terrain") != "terrain" || EditorModes:::ModeOfPage("history") != "" { failures += 1; }
        if AddMenuItems:::CategoryOf("block", true, 1) != "Shapes" { failures += 1; }
        if AddMenuItems:::CategoryOf("block", true, 2) != "Silhouettes" { failures += 1; }
        if AddMenuItems:::CategoryOf("sun", false, 1) != "Lights" { failures += 1; }
        if AddMenuItems:::CategoryOf("gem", true, 1) != "Silhouettes" { failures += 1; }
        if AddMenuItems:::CategoryOf("gem", false, 1) != "Other" { failures += 1; }
        if AddMenuItems:::PlacedTemplate(AddMenuItems:::PlaceCommand("ramp")) != "ramp" { failures += 1; }
        if AddMenuItems:::PlacedTemplate("mode:terrain") != "" { failures += 1; }
        return failures;
    }
}
