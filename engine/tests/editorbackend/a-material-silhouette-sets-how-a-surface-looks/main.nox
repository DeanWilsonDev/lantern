lantern :: import lantern;

main :: () -> i32 {
    steel: lantern:::silhouette:::MaterialDefinition*!? = lantern:::silhouette:::LoadMaterialSilhouette("../games/platformer/assets", "brushed_steel");
    defer delete steel;
    assert(steel != null, "a material in the materials folder is found by name");
    if found := steel {
        assert(found->metallic == 1.0f, "metallic is read");
        assert(found->roughness == 0.35f, "roughness is read");
        assert(found->texture == "wall", "the texture name is read");
        assert(found->tint.r > 0.7f && found->tint.r < 0.8f, "the tint is read");
    }

    neon: lantern:::silhouette:::MaterialDefinition*!? = lantern:::silhouette:::LoadMaterialSilhouette("../games/platformer/assets", "neon_sign");
    defer delete neon;
    if found := neon {
        assert(found->texture.length() == 0, "a material can have no texture");
        assert(found->emissive.r > 0.9f, "emissive is read");
    }

    block: lantern:::silhouette:::MaterialDefinition*!? = lantern:::silhouette:::LoadMaterialSilhouette("../games/platformer/assets", "block");
    defer delete block;
    assert(block == null, "a Silhouette of another type is not a material");
    ground: lantern:::silhouette:::MaterialDefinition*!? = lantern:::silhouette:::LoadMaterialSilhouette("../games/platformer/assets", "ground");
    defer delete ground;
    assert(ground == null, "a texture name with no material Silhouette falls back");

    listed: string! = lantern:::editorbackend:::ListAssetEntries("../games/platformer/assets", "Silhouettes/materials", "");
    assert(listed.contains("material\tbrushed_steel\tSilhouettes/materials/brushed_steel\n"), "the browser shows a material Silhouette as a material");
    delete listed;

    print("a material Silhouette sets how a surface looks");
    return 0;
}
