lantern :: import lantern;

main :: () -> i32 {
    found: string!? = lantern:::editorbackend:::WorkspaceRoot("../assets");
    defer delete found;
    guard root := found return 1;
    marker: string! = `${root}/engine/nox.json`;
    defer delete marker;
    if !pathExists(marker) {
        return 2;
    }
    missing: string!? = lantern:::editorbackend:::WorkspaceRoot("/nowhere/assets");
    defer delete missing;
    if missing != null {
        return 3;
    }
    print("the workspace is found from its assets");
    return 0;
}
