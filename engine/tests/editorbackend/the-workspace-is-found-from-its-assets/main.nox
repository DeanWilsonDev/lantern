// The workspace root is found by walking up from the game's assets folder to the one that holds engine/nox.json, and a
// folder that isn't in a workspace finds nothing.
lantern :: import lantern;

main :: () -> i32 {
    found: string!? = lantern:::editorbackend:::WorkspaceRoot("../games/platformer/assets");
    defer delete found;
    guard root := found return 1;
    marker: string! = `${root}/engine/nox.json`;
    defer delete marker;
    if !pathExists(marker) {
        return 2;
    }
    missing: string!? = lantern:::editorbackend:::WorkspaceRoot("/nowhere/assets");
    defer delete missing;
    if missing != null {
        return 3;
    }
    print("the workspace is found from its assets");
    return 0;
}
