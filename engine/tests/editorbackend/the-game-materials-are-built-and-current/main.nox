lantern :: import lantern;

main :: () -> i32 {
    when lantern:::editorbackend:::BuildGameMaterials("../assets", "../games/platformer/game-assets", false) {
        Result:::Err(message) -> {
            print(message);
            delete message;
            return 1;
        },
        Result:::Ok(stale) -> {
            if stale {
                print("out of date, run: mist run materials");
                return 2;
            }
        }
    }
    print("the game materials are current");
    return 0;
}
