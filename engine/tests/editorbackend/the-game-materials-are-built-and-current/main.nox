// The materials built from the game's material Silhouettes, and the shaders built from their material graphs, are up to
// date; if not, the test says to run `mist run materials`.
lantern :: import lantern;

main :: () -> i32 {
    when lantern:::editorbackend:::BuildGameMaterials("../games/platformer/assets", "../games/platformer/game-assets", false) {
        Result:::Err(message) -> {
            print(message);
            delete message;
            return 1;
        },
        Result:::Ok(stale) -> {
            if stale {
                print("out of date, run: mist run materials");
                return 2;
            }
        }
    }
    shaders~ Array<lantern:::editorbackend:::GeneratedMaterialShader*!>! = lantern:::editorbackend:::GenerateMaterialShaders("../games/platformer/assets");
    defer shaders.freeAll();
    assert(shaders.length() == 1 && shaders[0]->name == "painted_metal", "the one material with a graph gets a shader");
    assert(shaders[0]->failure == null && shaders[0]->textureNames.length() == 1, "its graph becomes a shader sampling one texture");
    assert(shaders[0]->source.contains("    float node_wear = 0.3;"), "a parameter takes the Silhouette's value");
    registrations: string! = lantern:::editorbackend:::MaterialShaderRegistrations(shaders);
    defer delete registrations;
    assert(registrations.contains("SetMaterialShader(\"painted_metal\", \"../game-assets/materials\", \"painted_metal\", Texture(\"textures/wall.png\"), 0, 0, 0);"), "the baked Nyx loads its compiled shader with its texture");
    print("the game materials are current");
    return 0;
}
