lantern :: import lantern;

main :: () -> i32 {
    pool := new lantern:::core:::Pool<i32>();
    defer delete pool;
    first := pool->Insert(1);
    assert((pool->Remove(first) ?? 0) == 1, "removing gives the value back");
    second := pool->Insert(2);
    assert(first.Index() == second.Index(), "the slot is reused");
    assert(pool->Get(first) == null, "but the old handle is stale");
    assert((pool->Get(second) ?? 0) == 2, "the new handle resolves");
    assert(pool->Remove(first) == null, "a stale handle removes nothing");
    assert(pool->Length() == 1, "one value is live");
    print("stale handles stop resolving after removal");
    return 0;
}
