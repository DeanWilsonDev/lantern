lantern :: import lantern;

main :: () -> i32 {
    loaded: string!? = tryReadTextFile("../assets/worlds/course.world.json");
    guard source := loaded return 1;
    when lantern:::json:::Parse(source) {
        Result:::Ok(document) -> {
            written~ string! = document->Write(document->root);
            written += "\n";
            assert(written == source, "writing the parsed course gives back the same text");
            delete written;
            delete document;
        },
        Result:::Err(message) -> {
            print(message);
            delete message;
            delete loaded;
            return 1;
        }
    }
    delete loaded;
    print("json round trips the course unchanged");
    return 0;
}
