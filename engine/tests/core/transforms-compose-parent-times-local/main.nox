lantern :: import lantern;
Near :: (left: Vec3, right: Vec3) -> bool {
    return (left - right).length() < 0.00001f;
}

main :: () -> i32 {
    parent := Mat4:::translation(Vec3 { x: 10.0f, y: 0.0f, z: 0.0f });
    local := lantern:::core:::MatrixFromRotationTranslation(lantern:::core:::YawRotation(Math:::PI / 2.0f), Vec3 { x: 0.0f, y: 0.0f, z: -1.0f });
    world := parent * local;
    point := world.transform(Vec4 { x: 0.0f, y: 0.0f, z: -1.0f, w: 1.0f });
    assert(Near(Vec3 { x: point.x, y: point.y, z: point.z }, Vec3 { x: 9.0f, y: 0.0f, z: -1.0f }), "the child is rotated, then moved by the parent");
    print("transforms compose parent times local");
    return 0;
}
