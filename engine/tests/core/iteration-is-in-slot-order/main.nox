lantern :: import lantern;

main :: () -> i32 {
    pool := new lantern:::core:::Pool<i32>();
    defer delete pool;
    handles~ Array<lantern:::core:::Handle<i32>>! = [];
    defer delete handles;
    for value~ i32 = 0; value < 5; value++ {
        handles.push(pool->Insert(value));
    }
    pool->Remove(handles[1]);
    pool->Remove(handles[3]);
    pool->Insert(10);
    live~ Array<lantern:::core:::Handle<i32>>! = pool->LiveHandles();
    defer delete live;
    line~ string! = "";
    defer delete line;
    for handle in live {
        if line.length() > 0 {
            line += " ";
        }
        line += `${pool->Get(handle) ?? -1}`;
    }
    print(line);
    print("iteration is in slot order");
    return 0;
}
