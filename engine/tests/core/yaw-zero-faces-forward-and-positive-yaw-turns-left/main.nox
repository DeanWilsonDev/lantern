lantern :: import lantern;
Near :: (left: Vec3, right: Vec3) -> bool {
    return (left - right).length() < 0.00001f;
}

main :: () -> i32 {
    assert(Near(lantern:::core:::DirectionFromYaw(0.0f), lantern:::core:::WorldForward()), "yaw zero faces forward");
    assert(Near(lantern:::core:::DirectionFromYaw(Math:::PI / 2.0f), -lantern:::core:::WorldRight()), "a quarter turn faces left");
    print("yaw zero faces forward and positive yaw turns left");
    return 0;
}
