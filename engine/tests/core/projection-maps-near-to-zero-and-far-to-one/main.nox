lantern :: import lantern;
main :: () -> i32 {
    projection := lantern:::core:::Perspective(1.0f, 1.0f, 0.1f, 100.0f);
    nearPoint := projection.transform(Vec4 { x: 0.0f, y: 0.0f, z: -0.1f, w: 1.0f });
    farPoint := projection.transform(Vec4 { x: 0.0f, y: 0.0f, z: -100.0f, w: 1.0f });
    assert(Math:::abs(nearPoint.z / nearPoint.w) < 0.00001f, "near maps to depth 0");
    assert(Math:::abs(farPoint.z / farPoint.w - 1.0f) < 0.00001f, "far maps to depth 1");
    above := projection.transform(Vec4 { x: 0.0f, y: 1.0f, z: -1.0f, w: 1.0f });
    assert(above.y / above.w > 0.0f, "up in view space is up in clip space");
    print("projection maps near to zero and far to one");
    return 0;
}
