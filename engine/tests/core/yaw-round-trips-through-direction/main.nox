lantern :: import lantern;
main :: () -> i32 {
    yaws: f32[5] = [-3.0f, -1.0f, 0.0f, 0.5f, 2.5f];
    for yaw in yaws {
        back: f32 = lantern:::core:::YawFromDirection(lantern:::core:::DirectionFromYaw(yaw));
        assert(Math:::abs(lantern:::core:::WrapAngle(back - yaw)) < 0.00001f, "the yaw comes back");
    }
    print("yaw round-trips through direction");
    return 0;
}
