lantern :: import lantern;
Near :: (left: Vec3, right: Vec3) -> bool {
    return (left - right).length() < 0.00001f;
}

main :: () -> i32 {
    right := lantern:::core:::WorldRight();
    assert(Near(right.cross(lantern:::core:::WorldUp()), -lantern:::core:::WorldForward()), "right x up is backward");
    print("axes are right-handed");
    return 0;
}
