lantern :: import lantern;

Near :: (left: Vec3, right: Vec3) -> bool {
    return (left - right).length() < 0.00001f;
}

main :: () -> i32 {
    unit := lantern:::core:::Aabb:::FromCenterHalfExtents(Vec3 { }, lantern:::core:::Splat3(0.5f));
    moved := unit.Transformed(Mat4:::translation(Vec3 { x: 2.0f, y: 0.0f, z: 0.0f }));
    assert(Near(moved.Center(), Vec3 { x: 2.0f, y: 0.0f, z: 0.0f }), "the moved box is centred at x 2");
    assert(!unit.Overlaps(moved), "boxes two apart don't overlap");
    assert(unit.Overlaps(unit.Expanded(0.1f)), "a box overlaps its expansion");
    rotated := unit.Transformed(lantern:::core:::MatrixFromQuaternion(lantern:::core:::YawRotation(Math:::PI / 4.0f)));
    diagonal~ f32 = 0.0f;
    unsafe {
        diagonal = lantern:::libm:::hypotf(0.5f, 0.5f);
    }
    assert(Math:::abs(rotated.HalfExtents().x - diagonal) < 0.00001f, "an eighth turn grows the box to the diagonal");
    assert(lantern:::core:::Aabb:::Empty().IsEmpty(), "the empty box is empty");
    print("aabb transforms and overlaps");
    return 0;
}
