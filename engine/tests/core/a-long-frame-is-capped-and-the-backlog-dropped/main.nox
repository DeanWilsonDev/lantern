lantern :: import lantern;

STEP: f64 : 1.0f / 60.0f;

main :: () -> i32 {
    clock~ lantern:::core:::FixedStepClock = lantern:::core:::FixedStepClock { };
    plan := clock.Advance(0.2f);
    assert(plan.stepCount == lantern:::core:::MAX_STEPS_PER_FRAME, "capped at the most steps a frame");
    assert(plan.droppedSeconds > 0.0f, "the backlog is dropped");
    assert(plan.alpha < 1.0f, "less than a step is left");
    assert(clock.Advance(STEP).stepCount == 1, "the next normal frame is one step");
    print("a long frame is capped and the backlog dropped");
    return 0;
}
