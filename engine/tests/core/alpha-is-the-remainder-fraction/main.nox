lantern :: import lantern;

STEP: f64 : 1.0f / 60.0f;

main :: () -> i32 {
    clock~ lantern:::core:::FixedStepClock = lantern:::core:::FixedStepClock { };
    plan := clock.Advance(STEP * 1.5f);
    assert(plan.stepCount == 1, "one step");
    assert(Math:::abs(plan.alpha - 0.5f) < 0.0001f, "half a step left over");
    print("alpha is the remainder fraction");
    return 0;
}
