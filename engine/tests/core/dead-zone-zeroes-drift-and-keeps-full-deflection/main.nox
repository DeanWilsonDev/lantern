lantern :: import lantern;

main :: () -> i32 {
    assert(lantern:::core:::ApplyRadialDeadZone(Vec2 { x: 0.1f, y: 0.05f }, 0.2f) == Vec2 { }, "drift reads as zero");
    full := lantern:::core:::ApplyRadialDeadZone(Vec2 { x: 1.0f, y: 0.0f }, 0.2f);
    assert(Math:::abs(lantern:::core:::Vec2Length(full) - 1.0f) < 0.000001f, "full deflection stays one");
    half := lantern:::core:::ApplyRadialDeadZone(Vec2 { x: 0.0f, y: 0.6f }, 0.2f);
    assert(Math:::abs(half.y - 0.5f) < 0.000001f, "the rest is rescaled");
    print("dead zone zeroes drift and keeps full deflection");
    return 0;
}
