lantern :: import lantern;

STEP: f64 : 1.0f / 60.0f;

main :: () -> i32 {
    clock~ lantern:::core:::FixedStepClock = lantern:::core:::FixedStepClock { };
    assert(clock.Advance(30.0f).stepCount <= lantern:::core:::MAX_STEPS_PER_FRAME, "a huge frame is capped");
    assert(clock.Advance(-1.0f).stepCount == 0, "a negative frame runs nothing");
    print("huge and negative frame times are clamped");
    return 0;
}
