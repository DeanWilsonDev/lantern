lantern :: import lantern;

main :: () -> i32 {
    line: string! = lantern:::core:::FormatLogLine(12.3456f, lantern:::core:::LogLevel:::Info, "renderer", "selected GPU driver: vulkan");
    print(line);
    delete line;
    warning: string! = lantern:::core:::FormatLogLine(0.5f, lantern:::core:::LogLevel:::Warn, "audio", "no device");
    print(warning);
    delete warning;
    assert((lantern:::core:::ParseLogLevelFilter("DEBUG") ?? lantern:::core:::LogLevelFilter:::Off) == lantern:::core:::LogLevelFilter:::Debug, "levels parse in any case");
    assert(lantern:::core:::ParseLogLevelFilter("loud") == null, "an unknown level doesn't parse");
    lantern:::core:::LogInfo("core", "not installed, so not written");
    print("log lines match the Rust logger");
    return 0;
}
