lantern :: import lantern;

STEP: f64 : 1.0f / 60.0f;

main :: () -> i32 {
    clock~ lantern:::core:::FixedStepClock = lantern:::core:::FixedStepClock { };
    for frame~ i32 = 0; frame < 1000; frame++ {
        jitter: f64 = when (frame % 2 == 0) {
            true -> 0.00015f,
            false -> -0.00015f,
        };
        if clock.Advance(STEP + jitter).stepCount != 1 {
            print(`frame ${frame} doubled up`);
            return 1;
        }
    }
    print("vsync jitter is snapped so steps never double up");
    return 0;
}
