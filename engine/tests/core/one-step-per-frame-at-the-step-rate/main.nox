lantern :: import lantern;

STEP: f64 : 1.0f / 60.0f;

main :: () -> i32 {
    clock~ lantern:::core:::FixedStepClock = lantern:::core:::FixedStepClock { };
    for frame~ i32 = 0; frame < 100; frame++ {
        assert(clock.Advance(STEP).stepCount == 1, "one step a frame");
    }
    assert(clock.TotalSteps() == 100, "a hundred steps");
    print("one step per frame at the step rate");
    return 0;
}
