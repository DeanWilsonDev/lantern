lantern :: import lantern;

main :: () -> i32 {
    values := new lantern:::core:::DebugValues();
    defer delete values;
    values->SetNumber("Frame/FPS", 60.0f);
    values->SetFlag("Player/Grounded", true);
    values->SetNumber("Frame/FPS", 59.0f);
    for index~ usize = 0; index < values->Length(); index++ {
        shown: string! = values->DisplayAt(index);
        print(`${values->PathAt(index)} = ${shown}`);
        delete shown;
    }
    assert(values->Length() == 2, "two entries");
    fps~ f64 = 0.0f;
    if value := values->Get("Frame/FPS") {
        fps = when value {
            lantern:::core:::DebugValue:::Number(number) -> number,
            default -> -1.0f,
        };
    }
    assert(fps == 59.0f, "FPS was updated in place");
    assert(lantern:::core:::DebugGroup(values->PathAt(1)) == "Player", "the group is before the slash");
    assert(lantern:::core:::DebugName(values->PathAt(1)) == "Grounded", "the name is after it");
    print("entries keep first insertion order and update in place");
    return 0;
}
