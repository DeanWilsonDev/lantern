lantern :: import lantern;

main :: () -> i32 {
    actions := new lantern:::core:::ActionSet();
    defer delete actions;
    jump := actions->Register("jump", lantern:::core:::ActionKind:::Button);
    movement := actions->Register("move", lantern:::core:::ActionKind:::Axis2D);
    assert((actions->Find("jump") ?? movement) == jump, "jump is found");
    assert((actions->Find("move") ?? jump) == movement, "move is found");
    assert(actions->Find("fly") == null, "fly isn't registered");
    assert(actions->Kind(movement) == lantern:::core:::ActionKind:::Axis2D, "move is two axes");
    print("actions are found by name");
    return 0;
}
