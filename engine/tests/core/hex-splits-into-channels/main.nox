lantern :: import lantern;

main :: () -> i32 {
    color := lantern:::core:::Color:::FromHex(16744448);
    channels := color.ToArray();
    assert(channels[0] == 1.0f && channels[1] == 128.0f / 255.0f && channels[2] == 0.0f && channels[3] == 1.0f, "0xFF8000 is orange");
    print("hex splits into channels");
    return 0;
}
