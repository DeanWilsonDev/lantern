lantern :: import lantern;

main :: () -> i32 {
    pool := new lantern:::core:::Pool<i32>();
    defer delete pool;
    handle~ lantern:::core:::Handle<i32> = pool->Insert(1);
    pool->Remove(handle);
    handle = pool->Insert(2);
    assert(lantern:::core:::HandleFromBits<i32>(handle.ToBits()) == handle, "a handle survives packing");
    print("bits round-trip");
    return 0;
}
