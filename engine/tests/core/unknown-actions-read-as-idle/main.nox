lantern :: import lantern;

main :: () -> i32 {
    snapshot := new lantern:::core:::InputSnapshot();
    defer delete snapshot;
    unknown := lantern:::core:::ActionId { value: 3 };
    assert(!snapshot->Held(unknown), "an unknown action isn't held");
    assert(snapshot->Vector(unknown) == Vec2 { }, "an unknown action has no value");
    print("unknown actions read as idle");
    return 0;
}
