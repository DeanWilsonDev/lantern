lantern :: import lantern;

main :: () -> i32 {
    stats~ lantern:::core:::FrameStats = lantern:::core:::FrameStats { };
    plan := lantern:::core:::FixedStepPlan { stepCount: 1 };
    for frame~ i32 = 0; frame < 10; frame++ {
        stats.Record(0.02f, plan);
    }
    difference~ f64 = stats.FramesPerSecond() - 50.0f;
    if difference < 0.0f {
        difference = -difference;
    }
    assert(difference < 0.000001f, "fifty frames a second");
    print("frame stats average");
    return 0;
}
