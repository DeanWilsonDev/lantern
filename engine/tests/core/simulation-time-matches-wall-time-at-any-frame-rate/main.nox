lantern :: import lantern;

STEP: f64 : 1.0f / 60.0f;

main :: () -> i32 {
    rates: f64[6] = [30.0f, 59.0f, 60.0f, 75.0f, 144.0f, 240.0f];
    for hertz in rates {
        clock~ lantern:::core:::FixedStepClock = lantern:::core:::FixedStepClock { };
        frames: i64 = i64(hertz * 10.0f);
        steps~ i64 = 0;
        for frame~ i64 = 0; frame < frames; frame++ {
            steps += i64(clock.Advance(1.0f / hertz).stepCount);
        }
        if steps < 599 || steps > 601 {
            print(`${hertz} Hz gave ${steps} steps in 10 s`);
            return 1;
        }
    }
    print("simulation time matches wall time at any frame rate");
    return 0;
}
