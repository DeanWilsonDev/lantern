lantern :: import lantern;
main :: () -> i32 {
    assert(lantern:::core:::MoveTowards(0.0f, 10.0f, 3.0f) == 3.0f, "a step of at most 3");
    assert(lantern:::core:::MoveTowards(9.0f, 10.0f, 3.0f) == 10.0f, "stops at the target");
    assert(Math:::abs(lantern:::core:::WrapAngle(3.0f * Math:::PI) - Math:::PI) < 0.00001f, "three half turns wrap to one");
    print("helpers behave");
    return 0;
}
