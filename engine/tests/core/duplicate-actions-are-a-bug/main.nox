// Registering the same action name twice is a programming error and stops the program.
lantern :: import lantern;

main :: () -> i32 {
    actions := new lantern:::core:::ActionSet();
    defer delete actions;
    actions->Register("jump", lantern:::core:::ActionKind:::Button);
    actions->Register("jump", lantern:::core:::ActionKind:::Button);
    return 0;
}
