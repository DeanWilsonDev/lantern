lantern :: import lantern;

main :: () -> i32 {
    values := new lantern:::core:::DebugValues();
    defer delete values;
    values->SetText("Script/Error", "x");
    values->SetNumber("Frame/FPS", 1.0f);
    values->RemovePrefix("Script/");
    values->SetNumber("Frame/FPS", 2.0f);
    assert(values->Length() == 1, "one entry is left");
    fps~ f64 = 0.0f;
    if value := values->Get("Frame/FPS") {
        fps = when value {
            lantern:::core:::DebugValue:::Number(number) -> number,
            default -> -1.0f,
        };
    }
    assert(fps == 2.0f, "the remaining entry is found again");
    print("remove prefix reindexes");
    return 0;
}
