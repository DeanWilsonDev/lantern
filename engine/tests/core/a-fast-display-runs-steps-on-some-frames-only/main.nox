lantern :: import lantern;

STEP: f64 : 1.0f / 60.0f;

main :: () -> i32 {
    clock~ lantern:::core:::FixedStepClock = lantern:::core:::FixedStepClock { };
    steps~ u32 = 0;
    for frame~ i32 = 0; frame < 240; frame++ {
        steps += clock.Advance(1.0f / 240.0f).stepCount;
    }
    if steps < 59 || steps > 60 {
        print(`one second of 240 Hz frames gave ${steps} steps`);
        return 1;
    }
    print("a fast display runs steps on some frames only");
    return 0;
}
