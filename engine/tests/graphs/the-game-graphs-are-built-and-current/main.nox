// The Nyx generated from the game's graph files is up to date; if not, the test says to run `mist run graphs`.
lantern :: import lantern;

main :: () -> i32 {
    when lantern:::editorbackend:::BuildGameGraphs("../games/platformer/game-graphs", "../games/platformer/game-graphs/generated", false) {
        Result:::Err(message) -> {
            print(message);
            delete message;
            return 1;
        },
        Result:::Ok(stale) -> {
            if stale.length() > 0 {
                print(`out of date, run: mist run graphs\n${stale}`);
                delete stale;
                return 2;
            }
            delete stale;
        }
    }
    print("the game graphs are current");
    return 0;
}
