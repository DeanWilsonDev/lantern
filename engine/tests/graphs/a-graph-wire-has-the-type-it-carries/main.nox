// Every wire has the type of what it carries: a comparison or a not gives a bool, an input its declared type, a whole-
// number literal an integer and a literal ending in f a float.
lantern :: import lantern;

main :: () -> i32 {
    when readTextFile("../games/platformer/game-graphs/crumble_phase.graph.json") {
        Result:::Err(error) -> {
            delete error;
            return 1;
        },
        Result:::Ok(text) -> {
            defer delete text;
            when lantern:::graphs:::LoadGraph(text) {
                Result:::Err(message) -> {
                    delete message;
                    return 2;
                },
                Result:::Ok(loaded) -> {
                    graph: lantern:::graphs:::Graph*! = loaded!;
                    function: lantern:::graphs:::GraphFunction* = graph->functions[0];

                    comparison: string! = lantern:::graphs:::ValueTypeOf(function, "idle", 0);
                    assert(comparison == "bool", "a comparison gives a bool");
                    delete comparison;
                    negation: string! = lantern:::graphs:::ValueTypeOf(function, "delayPassed", 0);
                    assert(negation == "bool", "a not gives a bool");
                    delete negation;
                    input: string! = lantern:::graphs:::ValueTypeOf(function, "phaseSeconds", 0);
                    assert(input == "f32", "an input has its declared type");
                    delete input;
                    literal: string! = lantern:::graphs:::ValueTypeOf(function, "#2", 0);
                    assert(literal == "i32", "a whole-number literal is an integer");
                    delete literal;
                    floating: string! = lantern:::graphs:::ValueTypeOf(function, "#0.5f", 0);
                    assert(floating == "f32", "a literal ending in f is a float");
                    delete floating;
                    unknown: string! = lantern:::graphs:::ValueTypeOf(function, "nothingLikeThis", 0);
                    assert(unknown.length() == 0, "an unknown name has no type");
                    delete unknown;

                    assert(lantern:::graphs:::TypeColor("bool") != lantern:::graphs:::TypeColor("f32"), "bool and float differ in colour");
                    assert(lantern:::graphs:::TypeColor("i32") == lantern:::graphs:::TypeColor("u8"), "integers share a colour");
                    assert(lantern:::graphs:::TypeColor("") == lantern:::graphs:::COLOR_TYPE_NONE, "no type is grey");
                    delete graph;
                }
            }
        }
    }
    print("a graph wire has the type it carries");
    return 0;
}
