lantern :: import lantern;

CRUMBLE: string : "../games/platformer/game-graphs/generated/CrumblePhase.nyx";

main :: () -> i32 {
    when readTextFile(CRUMBLE) {
        Result:::Err(error) -> {
            delete error;
            assert(false, "the generated file is there");
        },
        Result:::Ok(text) -> {
            rows := text.lines();
            standingLine~ i32 = 0;
            for index~ usize = 0; index < rows.length(); index++ {
                if rows[index].contains("if isStoodOn {") {
                    standingLine = i32(index + 1);
                }
            }
            delete rows;
            delete text;
            assert(standingLine > 0, "the standing branch is in the file");
            description: string! = lantern:::graphs:::DescribeGraphLine(CRUMBLE, standingLine);
            assert(description == "graph crumble_phase, node standing", "a line names its graph and node");
            delete description;
            commentLine: string! = lantern:::graphs:::DescribeGraphLine(CRUMBLE, 1);
            assert(commentLine == "", "the header line belongs to no node");
            delete commentLine;
            notGenerated: string! = lantern:::graphs:::DescribeGraphLine("../games/platformer/main.nyx", 10);
            assert(notGenerated == "", "a hand-written file names no node");
            delete notGenerated;
        }
    }
    print("a script error names the graph node");
    return 0;
}
