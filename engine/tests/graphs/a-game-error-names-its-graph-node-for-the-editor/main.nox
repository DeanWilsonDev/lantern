lantern :: import lantern;

main :: () -> i32 {
    message: string = "OnUpdate: boom\n    in graph crumble_phase, node isIdle\n    called from Update";
    found: string! = lantern:::graphs:::FailureFromText(message);
    assert(found == "crumble_phase\nisIdle", "the graph and node are read out of the error text");
    delete found;

    inCaller: string = "OnUpdate: boom\n    called from Update (graph lamp_pulse, node glow)";
    foundInCaller: string! = lantern:::graphs:::FailureFromText(inCaller);
    assert(foundInCaller == "lamp_pulse\nglow", "a node named in a calling frame is read too");
    delete foundInCaller;

    plain: string! = lantern:::graphs:::FailureFromText("OnUpdate: boom");
    assert(plain.length() == 0, "an error from hand-written script names no node");
    delete plain;
    print("a game error names its graph node for the editor");
    return 0;
}
