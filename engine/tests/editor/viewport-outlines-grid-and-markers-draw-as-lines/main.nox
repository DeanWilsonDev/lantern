lantern :: import lantern;

main :: () -> i32 {
    renderWorld := new lantern:::renderer:::RenderWorld();
    turned: Mat4 = lantern:::core:::MatrixFromRotationTranslation(lantern:::core:::QuaternionFromRotationY(Math:::PI * 0.5f), Vec3 { x: 1.0f, y: 0.0f, z: 0.0f });
    ramp: lantern:::world:::Shape = lantern:::world:::Shape:::Ramp(2.0f, 1.0f, 4.0f);
    lantern:::editor:::OrientedBoxLines(renderWorld, lantern:::editor:::ShapeLocalBounds(ramp), turned, lantern:::editor:::SelectionColor());
    assert(renderWorld->lines.length() == 24, "an outline is twelve edges");
    farthest~ f32 = 0.0f;
    for vertex in renderWorld->lines {
        farthest = Math:::max(farthest, vertex.position[0]);
    }
    assert(Math:::abs(farthest - 3.0f) < 0.0001f, "a ramp turned a quarter puts its length along x");
    renderWorld->Clear();
    lantern:::editor:::DrawGrid(renderWorld, Vec3 { x: 12.0f, y: 0.0f, z: -3.0f }, 1.0f);
    assert(renderWorld->lines.length() == 2 * (2 * 61 - 2 + 2), "the grid is 61 lines each way, less the two on the world axes, plus the axes themselves");
    renderWorld->Clear();
    lantern:::editor:::DrawArrow(renderWorld, Vec3 { }, Vec3 { x: 0.0f, y: 0.0f, z: -6.0f }, lantern:::editor:::VectorPropertyColor());
    assert(renderWorld->lines.length() == 10, "an arrow is a shaft and four head lines");
    renderWorld->Clear();
    lantern:::editor:::DrawArrow(renderWorld, Vec3 { }, Vec3 { }, lantern:::editor:::VectorPropertyColor());
    assert(renderWorld->lines.length() == 2, "a zero-length arrow has no head");
    capsule: Vec3 = lantern:::editor:::MarkerLocalMatrix(lantern:::editor:::MarkerMesh:::Capsule).transformPoint(Vec3 { });
    assert(capsule.y == 0.9f, "a capsule marker stands on its origin");
    assert(lantern:::editor:::MarkerLocalBounds(lantern:::editor:::MarkerMesh:::Gem).max.y == 0.4f, "a gem's outline fits the gem");
    delete renderWorld;
    print("viewport outlines, grid and markers draw as lines");
    return 0;
}
