// A scene socket is drawn as the rectangle of the opening it marks (four edges) with an arrow out of its facing side (a shaft
// and four head lines), so nine lines of two vertices each.
lantern :: import lantern;

main :: () -> i32 {
    renderWorld := new lantern:::renderer:::RenderWorld();
    defer delete renderWorld;
    socket := new lantern:::world:::WorldEntity(1, "far", lantern:::world:::SCENE_SOCKET_KIND);
    defer delete socket;
    socket->SetNumberProperty("width", 6.0f);
    socket->SetNumberProperty("height", 4.0f);
    before: usize = renderWorld->lines.length();
    lantern:::editor:::DrawSocketOpening(renderWorld, socket, Mat4:::translation(Vec3 { }), lantern:::core:::Color:::White());
    assert(renderWorld->lines.length() - before == 18, "an opening is four edges and an arrow of five lines");
    print("a scene socket is drawn as its opening");
    return 0;
}
