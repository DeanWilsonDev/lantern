lantern :: import lantern;

main :: () -> i32 {
    when readTextFile("../games/platformer/settings/chapter-looks.nyx") {
        Result:::Err(error) -> {
            delete error;
            return 1;
        },
        Result:::Ok(text) -> {
            defer delete text;
            chapterOne: string = "SetNight(\"070B1A\", \"141C34\", \"05070E\", 30.0f, 120.0f, \"8CA4D8\", \"34456E\", \"161B2C\", 1.1f, 0.95f, 1.05f, \"F2F6FF\", 0.25f)";
            assert(text.contains(chapterOne), "the editor's game look is still the game's chapter one night");
        }
    }

    renderWorld := new lantern:::renderer:::RenderWorld();
    lantern:::editor:::ApplyGameLook(renderWorld);
    assert(renderWorld->fogStart == 30.0f, "the fog starts where the game's does");
    assert(renderWorld->fogEnd == 120.0f, "the fog ends where the game's does");
    assert(renderWorld->post.exposure == 1.1f, "the exposure matches");
    assert(renderWorld->post.grade.vignette == 0.25f, "the vignette matches");
    assert(renderWorld->light.color.b > renderWorld->light.color.r, "the moon is blue");

    options~ lantern:::editor:::ViewOptions = lantern:::editor:::ViewOptions { };
    assert(!options.gameLighting, "game lighting is off until asked for");
    problem: string!? = options.Set("game_lighting", "true");
    assert(problem == null, "game_lighting is a view option");
    delete problem;
    assert(options.gameLighting, "game lighting turns on");

    print("the viewport can wear the games night look");
    return 0;
}
