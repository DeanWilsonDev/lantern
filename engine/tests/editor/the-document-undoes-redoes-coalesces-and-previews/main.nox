lantern :: import lantern;

PositionX :: (document: lantern:::editor:::EditorDocument*, key: u64) -> f32 {
    found: usize? = document->world->IndexOf(key);
    guard index := found return -1000.0f;
    return document->world->entities[index]->transform.position.x;
}

MovedTo :: (document: lantern:::editor:::EditorDocument*, key: u64, x: f32) -> lantern:::world:::WorldEntity*! {
    found: usize? = document->world->IndexOf(key);
    moved := document->world->entities[found ?? 0]->Copy();
    moved->transform.position.x = x;
    return moved!;
}

OneEdit :: (edit: lantern:::editor:::Edit*!) -> Array<lantern:::editor:::Edit*!>! {
    edits~ Array<lantern:::editor:::Edit*!>! = [];
    edits.push(edit!);
    return edits!;
}

Executes :: (failure: string!?) -> bool {
    if message := failure {
        print(message);
    }
    succeeded: bool = failure == null;
    delete failure;
    return succeeded;
}

UndoAndRedoWalkTheHistory :: (document: lantern:::editor:::EditorDocument~*) -> void {
    assert(!document->IsDirty() && !document->CanUndo(), "a fresh document is clean with nothing to undo");
    moved: bool = Executes(document->Execute("Move", OneEdit(lantern:::editor:::Edit:::Replace(MovedTo(document, 1, 3.0f)))));
    assert(moved, "a move executes");
    assert(PositionX(document, 1) == 3.0f && document->IsDirty(), "the move applies and dirties the document");
    added: bool = Executes(document->Execute("Add", OneEdit(lantern:::editor:::Edit:::Insert(1, lantern:::world:::Marker(7, "new", null, Vec3 { })))));
    assert(added && document->world->entities.length() == 3, "an insert adds an entity");
    assert((document->UndoLabel() ?? "") == "Add", "the undo label names the last edit");
    undid: bool = document->Undo();
    assert(undid && document->world->entities.length() == 2, "undo removes the inserted entity");
    assert((document->RedoLabel() ?? "") == "Add", "the redo label names the undone edit");
    undidMove: bool = document->Undo();
    assert(undidMove && PositionX(document, 1) == 0.0f && !document->IsDirty(), "undoing everything restores the saved state");
    redid: bool = document->Redo();
    assert(redid && PositionX(document, 1) == 3.0f, "redo reapplies the move");
    labels~ Array<string!>! = document->HistoryLabels();
    assert(labels.length() == 2 && labels[0] == "Move" && labels[1] == "Add", "the history lists done and undone edits in order");
    labels.freeAll();
    jumped: bool = document->JumpHistory(2);
    assert(jumped && document->world->entities.length() == 3 && document->HistoryPosition() == 2, "jumping forward redoes up to the position");
    jumpedBack: bool = document->JumpHistory(0);
    assert(jumpedBack && document->world->entities.length() == 2 && PositionX(document, 1) == 0.0f, "jumping back undoes to the start");
    failed: string!? = document->Execute("Broken", OneEdit(lantern:::editor:::Edit:::Remove(99)));
    assert(failed != null, "an edit on a missing entity fails");
    delete failed;
    assert(document->HistoryPosition() == 0 && document->CanRedo(), "a failed edit leaves the history alone");
}

TypingCoalescesIntoOneStep :: (document: lantern:::editor:::EditorDocument~*) -> void {
    before: usize = document->HistoryPosition();
    first: bool = Executes(document->ExecuteCoalescing("Edit x", OneEdit(lantern:::editor:::Edit:::Replace(MovedTo(document, 2, 1.0f))), 2, "x"));
    second: bool = Executes(document->ExecuteCoalescing("Edit x", OneEdit(lantern:::editor:::Edit:::Replace(MovedTo(document, 2, 12.0f))), 2, "x"));
    assert(first && second && PositionX(document, 2) == 12.0f, "both keystrokes apply");
    assert(document->HistoryPosition() == before + 1, "keystrokes on the same field are one undo step");
    document->SealHistory();
    third: bool = Executes(document->ExecuteCoalescing("Edit x", OneEdit(lantern:::editor:::Edit:::Replace(MovedTo(document, 2, 20.0f))), 2, "x"));
    assert(third && document->HistoryPosition() == before + 2, "a sealed step doesn't take more keystrokes");
    undid: bool = document->Undo();
    undidAgain: bool = document->Undo();
    assert(undid && undidAgain && PositionX(document, 2) == 0.0f, "undoing the coalesced step goes back before the first keystroke");
}

PreviewsCommitAsOneStepOrCancel :: (document: lantern:::editor:::EditorDocument~*) -> void {
    before: usize = document->HistoryPosition();
    document->PreviewReplace(MovedTo(document, 1, 4.0f));
    document->PreviewReplace(MovedTo(document, 1, 5.0f));
    assert(document->IsPreviewing() && PositionX(document, 1) == 5.0f && document->IsDirty(), "a preview shows in the world");
    document->CancelPreview();
    assert(!document->IsPreviewing() && PositionX(document, 1) == 0.0f, "cancelling a preview puts the entity back");
    document->PreviewReplace(MovedTo(document, 1, 6.0f));
    document->CommitPreview("Drag");
    assert(document->HistoryPosition() == before + 1 && PositionX(document, 1) == 6.0f, "a committed preview is one undo step");
    undid: bool = document->Undo();
    assert(undid && PositionX(document, 1) == 0.0f, "undoing the drag goes back to where it started");
    document->PreviewReplace(MovedTo(document, 1, 8.0f));
    undidPreview: bool = document->Undo();
    assert(undidPreview && !document->IsPreviewing() && PositionX(document, 1) == 0.0f, "undo during a preview cancels it");
}

SavingClearsDirty :: (document: lantern:::editor:::EditorDocument~*) -> void {
    moved: bool = Executes(document->Execute("Move", OneEdit(lantern:::editor:::Edit:::Replace(MovedTo(document, 1, 2.0f)))));
    assert(moved && document->IsDirty(), "an edit dirties the document");
    when createDirectories("build") {
        Result:::Ok(created) -> { },
        Result:::Err(error) -> {
            delete error;
        }
    }
    path: string = "build/lantern-editor-document.world.json";
    when document->Save(path) {
        Result:::Ok(saved) -> {
            assert(saved == path, "saving reports the path it wrote");
            delete saved;
        },
        Result:::Err(message) -> {
            print(message);
            delete message;
            assert(false, "the document saves");
        }
    }
    assert(!document->IsDirty(), "saving clears dirty");
    undid: bool = document->Undo();
    assert(undid && document->IsDirty(), "undoing past the save dirties the document again");
    when lantern:::editor:::EditorDocument:::Open(path) {
        Result:::Ok(reopened) -> {
            assert(PositionX(reopened, 1) == 2.0f, "the saved file has the edit");
            delete reopened;
        },
        Result:::Err(message) -> {
            print(message);
            delete message;
            assert(false, "the saved document opens");
        }
    }
    when removeFile(path) {
        Result:::Ok(removed) -> { },
        Result:::Err(error) -> {
            delete error;
        }
    }
}

main :: () -> i32 {
    world := new lantern:::world:::WorldFile("document");
    world->Add(lantern:::world:::Marker(1, "a", null, Vec3 { }));
    world->Add(lantern:::world:::Marker(2, "b", null, Vec3 { }));
    document := new lantern:::editor:::EditorDocument(world!, null);
    UndoAndRedoWalkTheHistory(document);
    TypingCoalescesIntoOneStep(document);
    PreviewsCommitAsOneStepOrCancel(document);
    SavingClearsDirty(document);
    delete document;
    print("the document undoes, redoes, coalesces and previews");
    return 0;
}
