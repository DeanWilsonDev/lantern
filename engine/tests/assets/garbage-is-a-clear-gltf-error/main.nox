lantern :: import lantern;

main :: () -> i32 {
    garbage: Array<u8>! = [110, 111, 116, 32, 97, 32, 103, 108, 116, 102];
    defer delete garbage;
    when lantern:::renderer:::GltfMeshFromBytes(garbage, ".") {
        Result:::Ok(mesh) -> {
            delete mesh;
            return 1;
        },
        Result:::Err(message) -> {
            assert(message.indexOf("not valid glTF", 0) != null, "the error says the file isn't glTF");
            delete message;
        }
    }
    print("garbage is a clear gltf error");
    return 0;
}
