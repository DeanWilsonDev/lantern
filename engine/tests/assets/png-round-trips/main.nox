lantern :: import lantern;

main :: () -> i32 {
    texture := lantern:::renderer:::TextureData:::Checker(8, 2, lantern:::core:::Color:::White(), lantern:::core:::Color:::Black());
    defer delete texture;
    encoded: Array<u8>! = texture->ToPngBytes();
    defer delete encoded;
    when lantern:::renderer:::TextureData:::FromPngBytes(encoded) {
        Result:::Ok(decoded) -> {
            assert(decoded->width == 8 && decoded->height == 8, "the size survives");
            assert(decoded->rgba8.length() == texture->rgba8.length(), "every pixel survives");
            for byteIndex~ usize = 0; byteIndex < texture->rgba8.length(); byteIndex += 1 {
                assert(decoded->rgba8[byteIndex] == texture->rgba8[byteIndex], "every pixel survives");
            }
            assert(decoded->rgba8[0] == 255 && decoded->rgba8[3] == 255, "row 0 is the top-left white cell");
            delete decoded;
        },
        Result:::Err(message) -> {
            print(message);
            delete message;
            return 1;
        }
    }
    print("png round trips");
    return 0;
}
