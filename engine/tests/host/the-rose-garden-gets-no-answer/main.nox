// The rose garden: she is just past the thorns, you call, and for the first time nothing answers; the level ends when you stand still.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenFindingHerRoom(host, platform, frameLoop, 3);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the rose garden");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/finding-her-rose-garden.world.json", "the fifteenth prototype is the rose garden");
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "searching", "she is already lost");
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::Q);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 80);
    assert(lantern:::testing:::DebugText(host, "Search/Calls") == "1", "one call was made");
    assert(lantern:::testing:::DebugText(host, "Search/Answers") == "0", "she does not answer");
    for index~ i32 = 0; index < 60; index++ {
        if lantern:::testing:::DebugText(host, "Search/Phase") == "ended" {
            break;
        }
        lantern:::testing:::WaitFrames(host, platform, frameLoop, 10);
    }
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "ended", "standing still after the call ends it");
    assert(lantern:::testing:::DebugText(host, "Game/Complete") == "yes", "the level counts as complete");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the rose garden: no answer, and the level ends");
    return 0;
}
