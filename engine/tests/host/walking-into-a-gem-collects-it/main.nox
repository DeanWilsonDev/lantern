NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::A, 50);
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 70);
    lantern:::testing:::QueueFrames(platform, 58);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after walking");
    gems: string = lantern:::testing:::DebugText(host, "Game/Gems");
    if gems != "1 / 6" {
        print(`the player at ${lantern:::testing:::DebugText(host, "Player/Position")} has ${gems}`);
    }
    assert(gems == "1 / 6", "the player collected the gem on the stair top");
    delete frameLoop;
    delete platform;
    delete host;
    delete manifest;
    print("walking into a gem collects it");
    return 0;
}