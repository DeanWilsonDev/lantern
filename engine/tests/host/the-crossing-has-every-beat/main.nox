NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 7);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the crossing");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/the-crossing.world.json", "the seventh entry is the crossing");
    assert(lantern:::testing:::DebugText(host, "Photo/Photos") == "0 / 5", "the crossing has five photo sights");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 60);

    lantern:::testing:::QueueEvent(platform, lantern:::platform:::PlatformEvent:::KeyDown(lantern:::core:::KeyCode:::W, false));
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 400);
    lantern:::testing:::QueueEvent(platform, lantern:::platform:::PlatformEvent:::KeyUp(lantern:::core:::KeyCode:::W));
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 10);
    assert(lantern:::testing:::PlayerZ(host) < -30.0f, "the player walks the opening ground");
    assert(lantern:::testing:::PlayerZ(host) > -50.0f, "the door in the second beat stops the player");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 700);
    assert(lantern:::testing:::DebugText(host, "Partner/Mode") == "acting stand", "she goes to the plate on her own and holds it for the player");
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "her weight opens the door");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the crossing loads, the opening walks, and she holds the first door unprompted");
    return 0;
}
