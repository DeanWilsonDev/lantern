// The lantern walk: chapter 5, the lantern is the only light, calling does nothing, and the level ends at the end of the street.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenFindingHerRoom(host, platform, frameLoop, 5);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the lantern walk");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/finding-her-lantern-walk.world.json", "the seventeenth prototype is the lantern walk");
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::Q);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 60);
    assert(lantern:::testing:::DebugText(host, "Search/Answers") == "0", "nothing answers");
    for index~ i32 = 0; index < 80; index++ {
        if lantern:::testing:::DebugText(host, "Search/Phase") == "ended" {
            break;
        }
        lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 60);
    }
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "ended", "reaching the end of the street ends the walk");
    assert(lantern:::testing:::DebugText(host, "Glow/Carrying lantern") == "yes", "the player carries the lantern");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the lantern walk: nothing answers, and you keep walking");
    return 0;
}
