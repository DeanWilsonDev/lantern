// The word market room: it asks for the grounded feel, eight words wait to be found and two stalls sell a meal.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 9);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the word market");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/word-market.world.json", "the ninth prototype is the word market");
    assert(lantern:::testing:::DebugText(host, "Player/Feel") == "grounded", "the market asks for the grounded feel");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);
    assert(lantern:::testing:::DebugText(host, "Minigames/Words") == "0 / 8", "eight words wait to be found");
    assert(lantern:::testing:::DebugText(host, "Minigames/Meals") == "0 / 2", "two stalls sell a meal");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 60);
    assert(lantern:::testing:::PlayerZ(host) < 8.0f, "the player walks into the street");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the word market: eight words and two stalls load");
    return 0;
}
