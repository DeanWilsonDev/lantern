NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 12);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the lift");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/the-lift.world.json", "the twelfth prototype is the lift");
    sawRide~ bool = false;
    sawPathBeforeRide~ bool = false;
    for sample~ i32 = 0; sample < 180; sample++ {
        lantern:::testing:::WaitFrames(host, platform, frameLoop, 5);
        mode := lantern:::testing:::DebugText(host, "Partner/Mode");
        if mode == "leading (riding)" {
            sawRide = true;
        }
        if mode == "leading (path)" {
            sawPathBeforeRide = true;
        }
    }
    lantern:::testing:::ExpectWithState(host, sawPathBeforeRide, "she walks to the platform along a path");
    lantern:::testing:::ExpectWithState(host, sawRide, "she stands on the platform while it carries her");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PartnerZ(host) < -19.1f, "she steps off on the far side");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PartnerY(host) > -0.5f, "without falling");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the lift: she waits for the platform, rides it across the chasm and steps off");
    return 0;
}
