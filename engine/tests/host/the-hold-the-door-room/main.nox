NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 1);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the first prototype room");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/hold-the-door.world.json", "the prototypes menu starts the hold-the-door room");
    assert(lantern:::testing:::DebugText(host, "Partner/Mode") == "waiting", "the partner waits at the start");
    assert(lantern:::testing:::DebugText(host, "Gate/1/door") == "solid", "the door starts shut");

    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::F);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 200);
    assert(lantern:::testing:::DebugText(host, "Partner/Mode") == "acting stand", "F sends her to the plate she stands on");
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "her weight holds the plate down");
    assert(lantern:::testing:::DebugText(host, "Gate/1/door") == "away", "the door is open while she holds it");

    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 190);
    assert(lantern:::testing:::PlayerZ(host) < -11.0f, "the player walks through the open door");
    lantern:::testing:::AssertNoScriptError(host, "after the door");

    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::A, 50);
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "the player's weight on the far plate holds the door too");
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::Q);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 360);
    assert(lantern:::testing:::PartnerZ(host) < -11.0f, "called, she follows the player's trail through the doorway");
    assert(lantern:::testing:::DebugText(host, "Partner/Mode") == "following", "she is following");

    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 40);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 70);
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::F);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 200);
    assert(lantern:::testing:::DebugText(host, "Channel/2") == "on", "she holds the bridge plate");
    assert(lantern:::testing:::DebugText(host, "Gate/2/bridge") == "solid", "the bridge is there while she holds it");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 230);
    assert(lantern:::testing:::PlayerZ(host) < -38.5f, "the player crosses the bridge she holds");
    assert(lantern:::testing:::SecondComponent(lantern:::testing:::DebugText(host, "Player/Position")) > -0.1f, "standing on the far side, not fallen");
    lantern:::testing:::AssertNoScriptError(host, "after the bridge");

    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::R);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 10);
    assert(lantern:::testing:::DebugText(host, "Partner/Mode") == "waiting", "a restart puts the partner back");
    assert(lantern:::testing:::DebugText(host, "Channel/2") == "off", "a restart puts the plates back");

    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 52);
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "the timed plate opens the door");
    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::A, 80);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 130);
    assert(lantern:::testing:::PlayerZ(host) < -10.8f, "the timed plate leaves time to run through the door");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 240);
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "off", "the timed plate lets go after its hold time");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the hold-the-door room opens its doors for her and for a timed plate");
    return 0;
}
