NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 1);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the first prototype room");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/hold-the-door.world.json", "the prototypes menu starts the hold-the-door room");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Gate/1/door") == "solid", "the door starts shut");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 300);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Partner/Mode") == "acting stand", "she walks to the plate on her own and stands on it");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Channel/1") == "on", "her weight holds the plate down");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Gate/1/door") == "away", "the door is open while she holds it");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 180);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::A, 45);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PlayerZ(host) < -11.0f, "the player walks through the door she holds open");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Partner/Mode") != "waiting", "she is not told anything: she moves on once the player stands on the far plate");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 300);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PartnerZ(host) < -11.0f, "she follows through the door the player holds open for her");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PartnerBeat(host) >= 2.0f, "and her next beat is under way");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 100);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 420);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Channel/2") == "on", "the player on the plate raises the bridge");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PartnerZ(host) < -38.0f, "she crosses the bridge first");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Partner/Mode") == "acting stand", "and stands on the far plate");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 50);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 200);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PlayerZ(host) < -38.5f, "the player crosses the bridge she holds");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PlayerY(host) > -0.1f, "standing on the far side, not fallen");
    lantern:::testing:::AssertNoScriptError(host, "after the bridge");
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::R);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 10);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Partner/Beat") == "0", "a restart sends her back to her first beat");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Channel/2") == "off", "a restart puts the plates back");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 52);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Channel/1") == "on", "the timed plate still opens the door for a player in a hurry");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the hold-the-door room: she holds the door for the player, the player holds the bridge for her");
    return 0;
}
