NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Down);
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::QueueFrames(platform, 30);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the streets");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/streets.world.json", "the second menu button plays the streets");
    assert(lantern:::testing:::DebugText(host, "Photo/Photos") == "0 / 5", "the streets have five sights and none is photographed yet");
    assert(lantern:::testing:::DebugText(host, "Photo/Camera raised") == "no", "the camera starts down");

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::C);
    lantern:::testing:::QueueFrames(platform, 10);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after raising the camera");
    assert(lantern:::testing:::DebugText(host, "Photo/Camera raised") == "yes", "C raises the camera");
    assert(lantern:::testing:::DebugText(host, "Photo/Verdict") == "ready", "the first street lamp is in frame, close and in the clear");

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::QueueFrames(platform, 10);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(lantern:::testing:::DebugText(host, "Photo/Photos") == "1 / 5", "the shutter counts the sight");
    assert(host->state->pendingCapturePath == null, "the frame after the shutter took the capture the photo asked for");
    assert(lantern:::testing:::DebugText(host, "Photo/Verdict") == "too far", "a photographed sight is not offered again: the far sight in view is judged instead");

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::QueueFrames(platform, 10);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(lantern:::testing:::DebugText(host, "Photo/Photos") == "1 / 5", "a second photo of the same sight does not count again");

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::C);
    lantern:::testing:::QueueFrames(platform, 10);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(lantern:::testing:::DebugText(host, "Photo/Camera raised") == "no", "C lowers the camera again");
    lantern:::testing:::AssertNoScriptError(host, "after lowering the camera");
    return 0;
}
