NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, true);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::RunFrames(frameLoop, platform, host, 30);
    lantern:::testing:::AssertNoScriptError(host, "after loading");
    before: lantern:::renderer:::HeadlessStats = lantern:::testing:::StatsOf(host);
    entities: usize = host->state->world->Length();
    assert(before.liveMeshes > 0 && before.liveTextures > 1 && entities > 10, "the platformer made meshes, textures and entities");
    for reload~ u32 = 0; reload < 3; reload++ {
        lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::F5);
        lantern:::testing:::RunFrames(frameLoop, platform, host, 30);
    }
    lantern:::testing:::AssertNoScriptError(host, "after three reloads");
    after: lantern:::renderer:::HeadlessStats = lantern:::testing:::StatsOf(host);
    assert(after.liveMeshes == before.liveMeshes, "the meshes after three reloads");
    assert(after.liveTextures == before.liveTextures, "the textures after three reloads");
    assert(host->state->world->Length() == entities, "the entities after three reloads");
    host->Shutdown();
    shutDown: lantern:::renderer:::HeadlessStats = lantern:::testing:::StatsOf(host);
    assert(shutDown.liveMeshes == 0, "no meshes are left");
    assert(shutDown.liveTextures == 1, "only the engine's font atlas is left");
    assert(host->state->world->Length() == 0, "no entities are left");
    delete frameLoop;
    delete platform;
    delete host;
    delete manifest;
    print("reloading the platformer releases what it made");
    return 0;
}