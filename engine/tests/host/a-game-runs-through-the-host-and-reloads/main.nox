NyxC :: import NyxC;
lantern :: import lantern;

GAME_DIRECTORY: string : "tests/support/games/drop";

LoadManifest :: () -> lantern:::host:::GameManifest*! {
    when lantern:::host:::GameManifest:::Load(GAME_DIRECTORY) {
        Result:::Ok(manifest) -> {
            return manifest!;
        },
        Result:::Err(message) -> {
            print(`the manifest failed to load: ${message}`);
            delete message;
            assert(false, "the test game's manifest loads");
            return new lantern:::host:::GameManifest("", "", "", "");
        }
    }
}

StateWithAssets :: (manifest: lantern:::host:::GameManifest*) -> lantern:::host:::EngineState*! {
    assets: string!? = manifest->AssetsDirectory(GAME_DIRECTORY);
    defer delete assets;
    assetsView~ string? = null;
    if path := assets {
        assetsView = path;
    }
    when lantern:::host:::EngineState:::Create(new lantern:::host:::HeadlessRenderer(), new lantern:::engine:::AudioSystem(null), assetsView) {
        Result:::Ok(state) -> {
            return state!;
        },
        Result:::Err(message) -> {
            print(`the engine state failed: ${message}`);
            delete message;
            assert(false, "the headless engine state starts");
            return new lantern:::host:::EngineState(new lantern:::host:::HeadlessRenderer(), new lantern:::engine:::AudioSystem(null), null);
        }
    }
}

DebugText :: (host: lantern:::host:::GameHost*, path: string) -> string {
    if index := host->state->debugValues->IndexOf(path) {
        return host->state->debugValues->TextAt(index);
    }
    return "";
}

RunFrames :: (frameLoop: lantern:::engine:::FrameLoop~*, platform: lantern:::testing:::ScriptedPlatform~*, host: lantern:::host:::GameHost~*) -> void {
    while platform->HasFrames() {
        frameLoop->RunFrame(platform, host);
    }
}

AddFrames :: (platform: lantern:::testing:::ScriptedPlatform~*, count: usize) -> void {
    for index~ usize = 0; index < count; index++ {
        platform->AddFrame(f64(platform->frames.length()) / 60.0f);
    }
}

LiveMeshes :: (host: lantern:::host:::GameHost~*) -> usize {
    guard headless ~= host->state->renderer as lantern:::host:::HeadlessRenderer~* return 0;
    headless->UpdateLiveCounts();
    return headless->Stats().liveMeshes;
}

LiveTextures :: (host: lantern:::host:::GameHost~*) -> usize {
    guard headless ~= host->state->renderer as lantern:::host:::HeadlessRenderer~* return 0;
    headless->UpdateLiveCounts();
    return headless->Stats().liveTextures;
}

main :: () -> i32 {
    manifest := LoadManifest();
    assert(manifest->title == "Drop", "the manifest's title is read");
    host := new lantern:::host:::GameHost(StateWithAssets(manifest), manifest->ScriptSourceFor(GAME_DIRECTORY));
    assert(host->IsRunningScript(), "the game loads");
    assert(host->ScriptErrorCount() == 0, "OnStart runs without an error");
    platform := new lantern:::testing:::ScriptedPlatform();
    frameLoop := new lantern:::engine:::FrameLoop(new lantern:::engine:::InputRouter(new lantern:::core:::ActionSet(), new lantern:::core:::Bindings()));
    AddFrames(platform, 90);
    RunFrames(frameLoop, platform, host);
    assert(host->ScriptErrorCount() == 0, "the hooks run without an error");
    assert(DebugText(host, "Drop/Landed") == "yes", "the player lands on the course");
    assert(DebugText(host, "Drop/Grounded") == "true", "and stays grounded");
    assert(host->state->world->Length() == 30, "the course and the player are in the world");
    assert(host->state->renderWorld->draws.length() > 0, "the world's meshes are extracted for drawing");
    assert(usize(host->lastFrameReport.drawsSubmitted) == host->state->renderWorld->draws.length(), "and the renderer gets every one");
    assert(host->state->renderWorld->clearColor == lantern:::core:::Color:::FromHex(8893920), "OnStart's clear colour is kept");
    meshesBeforeReload: usize = LiveMeshes(host);
    texturesBeforeReload: usize = LiveTextures(host);
    assert(meshesBeforeReload > 1, "the course and the player have meshes");
    platform->AddFrameWith(f64(platform->frames.length()) / 60.0f, lantern:::platform:::PlatformEvent:::KeyDown(lantern:::core:::KeyCode:::F5, false));
    platform->AddFrameWith(f64(platform->frames.length()) / 60.0f, lantern:::platform:::PlatformEvent:::KeyUp(lantern:::core:::KeyCode:::F5));
    AddFrames(platform, 30);
    RunFrames(frameLoop, platform, host);
    assert(host->IsRunningScript(), "F5 reloads the game");
    assert(host->ScriptErrorCount() == 0, "the reloaded game runs without an error");
    assert(LiveMeshes(host) == meshesBeforeReload, "a reload releases the meshes the last session made");
    assert(LiveTextures(host) == texturesBeforeReload, "and its textures");
    platform->AddFrameWith(f64(platform->frames.length()) / 60.0f, lantern:::platform:::PlatformEvent:::KeyDown(lantern:::core:::KeyCode:::F1, false));
    platform->AddFrameWith(f64(platform->frames.length()) / 60.0f, lantern:::platform:::PlatformEvent:::KeyUp(lantern:::core:::KeyCode:::F1));
    RunFrames(frameLoop, platform, host);
    assert(host->state->debugHud->visible, "F1 shows the HUD");
    assert(DebugText(host, "Script/Source") == "tests/support/games/drop/main.nyx", "the HUD names the game's entry file");
    host->state->SetFlag("DROP_QUIT", true);
    AddFrames(platform, 120);
    RunFrames(frameLoop, platform, host);
    assert(host->WantsToQuit(), "the game's Quit reaches the host");
    host->Shutdown();
    assert(!host->IsRunningScript(), "shutting down unloads the game");
    assert(LiveMeshes(host) == 0, "no meshes are left");
    assert(LiveTextures(host) == 1, "only the engine's font atlas is left");
    delete frameLoop;
    delete platform;
    delete host;
    delete manifest;
    print("a game runs through the host and reloads");
    return 0;
}
