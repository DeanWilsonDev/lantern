NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::RunFrames(frameLoop, platform, host, 60);
    lantern:::testing:::AssertNoScriptError(host, "behind the menu");
    assert(lantern:::testing:::DebugText(host, "Game/Time") == "0.0", "nothing simulates behind the menu");
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::RunFrames(frameLoop, platform, host, 60);
    lantern:::testing:::AssertNoScriptError(host, "after Play");
    time: f32 = lantern:::testing:::ParseDecimalOrFail(lantern:::testing:::DebugText(host, "Game/Time"), "Game/Time");
    assert(time > 0.5f, "Play was chosen");
    assert(platform->mouseCaptured, "playing captures the mouse");
    delete frameLoop;
    delete platform;
    delete host;
    delete manifest;
    print("the main menu waits for play");
    return 0;
}