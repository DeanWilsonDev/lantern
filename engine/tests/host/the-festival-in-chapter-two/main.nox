// The festival in chapter 2: she walks beside you and holds your hand, the crowd pulls you apart, you call and she answers, and you find her.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenFindingHerRoom(host, platform, frameLoop, 1);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the festival");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/finding-her-festival-chapter-2.world.json", "the thirteenth prototype is the chapter 2 festival");
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "together", "the festival begins together");
    assert(lantern:::testing:::DebugText(host, "Search/Figures") == "68", "sixty-eight figures walk the lanes");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);

    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::Q);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 40);
    assert(lantern:::testing:::DebugText(host, "Search/Calls") == "1", "one call was made");
    assert(lantern:::testing:::DebugText(host, "Search/Answers") == "1", "she answered the call in chapter 2");

    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::G, lantern:::core:::KeyCode:::W, 90);
    lantern:::testing:::AssertNoScriptError(host, "while holding hands");
    assert(lantern:::testing:::PlayerZ(host) < 27.0f, "the pair walked forward");
    assert(lantern:::testing:::PartnerZ(host) < 27.5f, "she walked beside the player");

    for index~ i32 = 0; index < 30; index++ {
        if lantern:::testing:::DebugText(host, "Search/Phase") != "together" {
            break;
        }
        lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 30);
    }
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "separated", "the crowd pulls the pair apart");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 200);
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "searching", "the search begins after the surge");

    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::E, 40);
    assert(lantern:::testing:::DebugText(host, "Search/Look") != "", "the look is published");
    assert(lantern:::testing:::DebugText(host, "Search/Look") != "0.00", "holding look eased the look in");
    lantern:::testing:::AssertNoScriptError(host, "after looking");

    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::S, lantern:::core:::KeyCode:::A, 150);
    lantern:::testing:::AssertNoScriptError(host, "walking back to her");
    for index~ i32 = 0; index < 60; index++ {
        if lantern:::testing:::DebugText(host, "Search/Phase") == "ended" {
            break;
        }
        lantern:::testing:::WaitFrames(host, platform, frameLoop, 10);
    }
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "ended", "she was found and the level ended");
    assert(lantern:::testing:::DebugText(host, "Game/Complete") == "yes", "finding her completes the level");
    print("the chapter 2 festival: hold hands, be pulled apart, call, find her");
    return 0;
}
