// The cable car: hold her hand and, however hard you hold, it slips away after a while.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenFindingHerRoom(host, platform, frameLoop, 4);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the cable car");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/finding-her-cable-car.world.json", "the sixteenth prototype is the cable car");
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "together", "she is beside you");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::G, 200);
    assert(lantern:::testing:::DebugText(host, "Search/Slipped") == "no", "the hand holds at first");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::G, 480);
    assert(lantern:::testing:::DebugText(host, "Search/Slipped") == "yes", "the hand slips away however long you hold");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the cable car: her hand slips away");
    return 0;
}
