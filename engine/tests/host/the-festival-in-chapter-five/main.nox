// The festival in chapter 5: the same space and crowd, nobody to find. Calls get no answer, the places she liked are only places, and the level ends when you stop calling and stand still.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenFindingHerRoom(host, platform, frameLoop, 2);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the festival");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/finding-her-festival-chapter-5.world.json", "the fourteenth prototype is the chapter 5 festival");
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "searching", "with nobody there the level begins searching");
    assert(lantern:::testing:::DebugText(host, "Search/Figures") == "68", "the same crowd walks the lanes");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);

    for index~ i32 = 0; index < 3; index++ {
        lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::Q);
        lantern:::testing:::WaitFrames(host, platform, frameLoop, 70);
    }
    assert(lantern:::testing:::DebugText(host, "Search/Calls") == "3", "three calls were made");
    assert(lantern:::testing:::DebugText(host, "Search/Answers") == "0", "nothing answers in chapter 5");
    assert(lantern:::testing:::DebugText(host, "Game/Complete") == "no", "calling is not the ending");

    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 240);
    assert(lantern:::testing:::DebugText(host, "Search/Memories") == "1", "the stall she liked was visited");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 450);
    assert(lantern:::testing:::DebugText(host, "Search/Phase") == "ended", "standing still after calling ends the level");
    assert(lantern:::testing:::DebugText(host, "Game/Complete") == "yes", "the level counts as complete");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the chapter 5 festival: nobody answers, and the level ends when you stop");
    return 0;
}
