// The flow and fragile room: the companion leads across the slabs, which crumble behind her, and the player stops at
// the
// edge of the broken floor.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 6);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the fragile floor");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 2);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Scripted/Count") == "1", "the lamp whose behaviour is a graph is running");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/flow-and-fragile.world.json", "the sixth prototype is the fragile floor");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 420);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PartnerZ(host) < -18.0f, "she leads across the slabs");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Crumble/0") == "gone", "the slabs she crossed are gone");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 90);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 120);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PlayerZ(host) > -9.0f, "the player stops at the edge of the broken floor");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the fragile floor: she crosses it first and the slabs stay broken behind her");
    return 0;
}
