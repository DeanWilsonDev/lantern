NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 6);
    lantern:::testing:::AssertNoScriptError(host, "after choosing flow and fragile");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/flow-and-fragile.world.json", "the sixth prototype is flow and fragile");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 60);

    lantern:::testing:::QueueEvent(platform, lantern:::platform:::PlatformEvent:::KeyDown(lantern:::core:::KeyCode:::W, false));
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 172);
    lantern:::testing:::QueueEvent(platform, lantern:::platform:::PlatformEvent:::KeyUp(lantern:::core:::KeyCode:::W));
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 2);
    assert(lantern:::testing:::PlayerY(host) > 2.5f, "the first pad throws the player onto the high landing");
    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 40);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 10);
    assert(lantern:::testing:::PlayerY(host) > 2.5f, "the player jumps onto the first crumbling slab");
    lowestY~ f32 = 99.0f;
    for round~ i32 = 0; round < 18; round++ {
        lantern:::testing:::WaitFrames(host, platform, frameLoop, 5);
        if lantern:::testing:::PlayerY(host) < lowestY {
            lowestY = lantern:::testing:::PlayerY(host);
        }
    }
    assert(lowestY < 2.0f, "the slab gives way under the player standing on it, and the player falls");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("flow and fragile: the pad throws the player up and a slab gives way");
    return 0;
}
