NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

HoldTwoKeys :: (platform: lantern:::testing:::ScriptedPlatform~*, first: lantern:::core:::KeyCode, second: lantern:::core:::KeyCode, frames: usize) -> void {
    lantern:::testing:::QueueEvent(platform, lantern:::platform:::PlatformEvent:::KeyDown(first, false));
    platform->AddEventToLastFrame(lantern:::platform:::PlatformEvent:::KeyDown(second, false));
    lantern:::testing:::QueueFrames(platform, frames - 1);
    lantern:::testing:::QueueEvent(platform, lantern:::platform:::PlatformEvent:::KeyUp(first));
    platform->AddEventToLastFrame(lantern:::platform:::PlatformEvent:::KeyUp(second));
}

FeetHeight :: (host: lantern:::host:::GameHost*) -> f32 {
    return lantern:::testing:::SecondComponent(lantern:::testing:::DebugText(host, "Player/Position"));
}

FeetDepth :: (host: lantern:::host:::GameHost*) -> f32 {
    return lantern:::testing:::ThirdComponent(lantern:::testing:::DebugText(host, "Player/Position"));
}

WalkUntilDepth :: (host: lantern:::host:::GameHost~*, platform: lantern:::testing:::ScriptedPlatform~*, frameLoop: lantern:::engine:::GameLoop~*, depth: f32) -> void {
    attempts~ i32 = 0;
    while FeetDepth(host) > depth && attempts < 60 {
        attempts++;
        lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 4);
        lantern:::testing:::RunQueued(frameLoop, platform, host);
    }
}

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Down);
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::QueueFrames(platform, 30);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the streets");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Gems") == "0 / 9", "the streets have nine gems");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Stop") == "0", "the companion waits at her first stop");

    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::A, 15);
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 80);
    HoldTwoKeys(platform, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 24);
    lantern:::testing:::QueueFrames(platform, 6);
    HoldTwoKeys(platform, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 24);
    lantern:::testing:::QueueFrames(platform, 20);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, FeetHeight(host) > 2.1f, "the crate gets the player up the 2.2 m street, which a normal jump can't");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Gems") == "1 / 9", "the gem on the crate was collected");

    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::D, 14);
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 160);
    lantern:::testing:::QueueFrames(platform, 120);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Offering boost") == "yes", "the companion crouches at the wall and offers the boost");
    lantern:::testing:::ExpectWithState(host, FeetHeight(host) < 2.3f, "the player is still on the upper street");

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Space);
    lantern:::testing:::QueueFrames(platform, 1);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, FeetHeight(host) > 2.5f, "the tap is a boosted take-off: it rises past a normal jump's start");
    lantern:::testing:::QueueFrames(platform, 59);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, FeetHeight(host) < 2.3f, "a boosted jump let go of at once falls back to the upper street");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Offering boost") == "yes", "after a failed boost the companion stays crouched and the offer stands");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Stop") == "1", "she did not walk on");

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Space);
    lantern:::testing:::QueueFrames(platform, 26);
    HoldTwoKeys(platform, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 50);
    lantern:::testing:::QueueFrames(platform, 40);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after the boost");
    lantern:::testing:::ExpectWithState(host, FeetHeight(host) > 5.3f, "the boost reaches the 5.4 m rooftop");
    lantern:::testing:::QueueFrames(platform, 160);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Stop") == "3", "the companion followed up to the rooftop");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Offering boost") == "no", "the boost was used");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Respawn") == "0.00, 5.45, -30.50", "the rooftop checkpoint is the respawn point");

    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 180);
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 185);
    lantern:::testing:::QueueFrames(platform, 240);
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 220);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "walking to the first swing");
    lantern:::testing:::ExpectWithState(host, FeetHeight(host) > 5.3f, "the lantern lit the second gap, and the player is on the last block before the chasm");

    WalkUntilDepth(host, platform, frameLoop, -98.6f);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 90);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Position") == "0.00, 5.40, -112.80", "the companion swung the cooperative arc first and waits at its far post");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Mode") == "waiting at the landing", "she holds the far post until the player has swung over");
    lantern:::testing:::ExpectWithState(host, FeetDepth(host) > -100.0f, "the player stops beside the post, on the block");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Anchor/Ready") == "yes", "beside the post with the companion waiting at the far post, a jump would swing");
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Space);
    lantern:::testing:::QueueFrames(platform, 20);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Anchor/Swinging") == "yes", "the swing is under way");
    lantern:::testing:::ExpectWithState(host, FeetDepth(host) < -101.0f, "a jump beside the post starts the swing, which carries the player out over the chasm");
    lantern:::testing:::ExpectWithState(host, FeetHeight(host) < 5.0f, "the arc dips below the ledge, as a rope swing does");
    lantern:::testing:::QueueFrames(platform, 100);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after the first swing");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Player/Position") == "0.00, 5.40, -112.80", "the swing ends on the far post, 12 m across");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Mode") != "waiting at the landing", "she walks on once the player is over");

    WalkUntilDepth(host, platform, frameLoop, -123.0f);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Anchor/Ready") == "yes", "the second post is ready whether or not she is near: it is the solo form");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Respawn") == "0.00, 5.45, -116.00", "the checkpoint on the far block is reached");
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Space);
    lantern:::testing:::QueueFrames(platform, 120);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after the second swing");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Player/Position") == "0.00, 5.40, -136.80", "the second swing works without her: it is the solo form");
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 30);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Respawn") == "0.00, 5.45, -140.00", "the last checkpoint is reached");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Gems") == "7 / 9", "the gems hanging along the arcs were collected on the way, with the others left off the lane");

    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Complete") == "no", "the level is not complete before the goal");
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 60);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Complete") == "yes", "touching the goal completes the level");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Level") == "worlds/streets.world.json", "the completion message shows on the same level first");
    lantern:::testing:::QueueFrames(platform, 270);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after finishing the level");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Level") == "worlds/rooftops.world.json", "the goal's next_level is loaded after a few seconds");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Complete") == "no", "the next level starts fresh");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Gems") == "0 / 6", "and with its gems back");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Player/Position") == "0.00, 0.00, 0.00", "and the player at its spawn");

    delete frameLoop;
    delete platform;
    delete host;
    delete manifest;
    print("the anchor swings across the gap");
    return 0;
}
