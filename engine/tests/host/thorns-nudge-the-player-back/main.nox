NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

HoldTwoKeys :: (platform: lantern:::testing:::ScriptedPlatform~*, first: lantern:::core:::KeyCode, second: lantern:::core:::KeyCode, frames: usize) -> void {
    lantern:::testing:::QueueEvent(platform, lantern:::platform:::PlatformEvent:::KeyDown(first, false));
    platform->AddEventToLastFrame(lantern:::platform:::PlatformEvent:::KeyDown(second, false));
    lantern:::testing:::QueueFrames(platform, frames - 1);
    lantern:::testing:::QueueEvent(platform, lantern:::platform:::PlatformEvent:::KeyUp(first));
    platform->AddEventToLastFrame(lantern:::platform:::PlatformEvent:::KeyUp(second));
}

FeetHeight :: (host: lantern:::host:::GameHost*) -> f32 {
    return lantern:::testing:::SecondComponent(lantern:::testing:::DebugText(host, "Player/Position"));
}

FeetDepth :: (host: lantern:::host:::GameHost*) -> f32 {
    return lantern:::testing:::ThirdComponent(lantern:::testing:::DebugText(host, "Player/Position"));
}

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Down);
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Down);
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Down);
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::QueueFrames(platform, 30);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the streets");
    assert(lantern:::testing:::DebugText(host, "Game/Gems") == "0 / 9", "the streets have nine gems");
    assert(lantern:::testing:::DebugText(host, "Companion/Stop") == "0", "the companion waits at her first stop");

    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::A, 15);
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 80);
    HoldTwoKeys(platform, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 24);
    lantern:::testing:::QueueFrames(platform, 6);
    HoldTwoKeys(platform, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 24);
    lantern:::testing:::QueueFrames(platform, 20);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(FeetHeight(host) > 2.1f, "the crate gets the player up the 2.2 m street, which a normal jump can't");
    assert(lantern:::testing:::DebugText(host, "Game/Gems") == "1 / 9", "the gem on the crate was collected");

    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::D, 14);
    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 160);
    lantern:::testing:::QueueFrames(platform, 120);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(lantern:::testing:::DebugText(host, "Companion/Offering boost") == "yes", "the companion crouches at the wall and offers the boost");
    assert(FeetHeight(host) < 2.3f, "the player is still on the upper street");

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Space);
    lantern:::testing:::QueueFrames(platform, 1);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(FeetHeight(host) > 2.5f, "the tap is a boosted take-off: it rises past a normal jump's start");
    lantern:::testing:::QueueFrames(platform, 59);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(FeetHeight(host) < 2.3f, "a boosted jump let go of at once falls back to the upper street");
    assert(lantern:::testing:::DebugText(host, "Companion/Offering boost") == "yes", "after a failed boost the companion stays crouched and the offer stands");
    assert(lantern:::testing:::DebugText(host, "Companion/Stop") == "1", "she did not walk on");

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Space);
    lantern:::testing:::QueueFrames(platform, 26);
    HoldTwoKeys(platform, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 50);
    lantern:::testing:::QueueFrames(platform, 40);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after the boost");
    assert(FeetHeight(host) > 5.3f, "the boost reaches the 5.4 m rooftop");
    lantern:::testing:::QueueFrames(platform, 160);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(lantern:::testing:::DebugText(host, "Companion/Stop") == "3", "the companion followed up to the rooftop");
    assert(lantern:::testing:::DebugText(host, "Companion/Offering boost") == "no", "the boost was used");
    assert(lantern:::testing:::DebugText(host, "Game/Respawn") == "0.00, 5.45, -30.50", "the rooftop checkpoint is the respawn point");

    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 100);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    assert(FeetDepth(host) < -38.0f, "the player walks along the safe lane beside the thorns on the rooftop");

    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::A, 60);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "walking into the thorns");
    assert(FeetDepth(host) > -36.0f, "touching the thorns put the player back where they last stood safely");
    assert(FeetHeight(host) > 5.3f, "the nudge keeps the player on the rooftop: nothing is lost");

    delete frameLoop;
    delete platform;
    delete host;
    delete manifest;
    print("thorns nudge the player back");
    return 0;
}
