// The companion walks to her goals along paths from the navigation graph rather than in straight lines, and reaches the
// plate the path leads to.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 4);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the hand-off");
    lantern:::testing:::ExpectWithState(
        host,
        lantern:::testing:::DebugText(
            host,
            "Game/Level"
        ) == "worlds/prototypes/hand-off.world.json",
        "the fourth prototype is the hand-off"
    );
    lantern:::testing:::ExpectWithState(
        host,
        lantern:::testing:::DebugText(host, "Partner/Navigation") != "0 nodes, no path",
        "the level has a navigation graph"
    );
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 250);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 158);
    lantern:::testing:::HoldTwoKeysAndRun(
        host,
        platform,
        frameLoop,
        lantern:::core:::KeyCode:::W,
        lantern:::core:::KeyCode:::Space,
        40
    );
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 15);
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::F);
    sawPath~ bool = false;
    for sample~ i32 = 0; sample < 140; sample++ {
        lantern:::testing:::WaitFrames(host, platform, frameLoop, 5);
        if lantern:::testing:::DebugText(host, "Partner/Mode") == "leading (path)" {
            sawPath = true;
        }
    }
    lantern:::testing:::ExpectWithState(host, sawPath, "she walks to the plate along a path");
    lantern:::testing:::ExpectWithState(
        host,
        lantern:::testing:::DebugText(host, "Partner/Mode") == "acting stand",
        "and stands on it"
    );
    lantern:::testing:::ExpectWithState(
        host,
        lantern:::testing:::PartnerY(host) > 3.0f,
        "up the stair on the ledge"
    );
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the partner follows navigation paths");
    return 0;
}
