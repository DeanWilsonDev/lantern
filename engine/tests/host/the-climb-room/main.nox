// The climb prototype: the room asks for the grounded feel, the building stops the player at the wall, and pressing F
// grabs the pipe and climbs it.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 8);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the climb");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/the-climb.world.json", "the eighth prototype is the climb");
    assert(lantern:::testing:::DebugText(host, "Player/Feel") == "grounded", "the climb room asks for the grounded feel");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);

    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 66);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);
    assert(lantern:::testing:::PlayerX(host) > 4.0f && lantern:::testing:::PlayerX(host) < 6.0f, "the player is in front of the pipe");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 330);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);
    assert(lantern:::testing:::PlayerZ(host) > -14.0f, "the building stops the player at the wall");
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::F);
    assert(lantern:::testing:::DebugText(host, "Climb/Holding") == "yes", "F grabs the pipe");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 420);
    assert(lantern:::testing:::DebugText(host, "Climb/Holding") == "no", "the climb ends at the top");
    assert(lantern:::testing:::PlayerY(host) > 6.3f, "the player is on the roof");
    assert(lantern:::testing:::PlayerZ(host) < -14.3f, "the player stands over the wall");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the climb: the player climbs the pipe onto the roof");
    return 0;
}
