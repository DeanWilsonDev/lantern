NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 4);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the hand-off");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/hand-off.world.json", "the fourth prototype is the hand-off");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 250);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Partner/Mode") == "acting crouch", "she kneels by the ledge on her own");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 158);
    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 40);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PlayerY(host) > 3.1f && lantern:::testing:::PlayerZ(host) < -12.0f, "the boost gets the player onto the ledge");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PartnerBeat(host) >= 1.0f, "she stands up once the player has landed");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 15);
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::F);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 60);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Gate/1/bridge") == "solid", "the lever raises the stair");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 700);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Partner/Mode") == "acting stand", "she climbs the stair and stands on the plate");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PartnerY(host) > 3.0f, "she is on the ledge");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Gate/2/door") == "away", "the door is open while she holds the plate");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 130);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::PlayerZ(host) < -25.0f, "the player walks through the door");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the hand-off: she kneels, the player lowers a stair for her, she holds the door");
    return 0;
}
