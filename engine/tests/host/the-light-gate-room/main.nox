// The light gate room: the companion walks to the lit spot on her own, her light reaches the crystal, the door opens
// and
// the player picks up the lantern.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 3);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the light gate");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/light-gate.world.json", "the third prototype is the light gate");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 300);
    assert(lantern:::testing:::DebugText(host, "Partner/Mode") == "acting stand", "she walks to the lit spot on her own");
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "her light reaches the crystal from the lit spot");
    assert(lantern:::testing:::DebugText(host, "Gate/1/door") == "away", "the door opens");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 50);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 30);
    assert(lantern:::testing:::DebugText(host, "Glow/Carrying lantern") == "yes", "the lantern is picked up");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::A, 50);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 250);
    assert(lantern:::testing:::PlayerZ(host) < -22.0f, "the player walks through the door she holds open with her light");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 25);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 500);
    assert(lantern:::testing:::PartnerZ(host) < -21.0f, "she follows through while the lantern lights the second crystal");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the light gate: her light opens the door for the player, the lantern keeps it open for her");
    return 0;
}
