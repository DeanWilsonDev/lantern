NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 3);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the light gate");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/light-gate.world.json", "the third prototype is the light gate");
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::F);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 200);
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "her light reaches the crystal from the lit spot");
    assert(lantern:::testing:::DebugText(host, "Gate/1/door") == "away", "the gate opens");

    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::R);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 10);
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "off", "a restart puts the crystal out");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 50);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 30);
    assert(lantern:::testing:::DebugText(host, "Glow/Carrying lantern") == "yes", "the lantern is picked up");
    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::A, 86);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 40);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 300);
    assert(lantern:::testing:::PlayerZ(host) < -7.0f && lantern:::testing:::PlayerZ(host) > -10.0f, "the player stands level with the pillar");
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "off", "the pillar's shadow keeps the lantern's light off the crystal");

    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::S, lantern:::core:::KeyCode:::A, 30);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::S, 25);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 10);
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "from the lit spot the lantern reaches the crystal");
    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::D, 60);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 150);
    assert(lantern:::testing:::PlayerZ(host) < -21.5f, "the player runs through the gate before the crystal's glow fades");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the light gate opens for her light, and for the lantern from the right spot");
    return 0;
}
