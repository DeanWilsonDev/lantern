NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 8);
    assert(lantern:::testing:::DebugText(host, "Player/Feel") == "grounded", "the climb room asks for the grounded feel");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::A, 80);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 90);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);
    assert(lantern:::testing:::PlayerY(host) < 0.1f, "the loading dock is 1.3 m high, too tall to step or jump onto");
    assert(lantern:::testing:::PlayerZ(host) > 3.0f, "the player is in front of it");
    sawHaul~ bool = false;
    frame~ usize = 0;
    while frame < 90 {
        lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 1);
        if lantern:::testing:::DebugText(host, "Mantle/Active") == "yes" {
            sawHaul = true;
        }
        frame += 1;
    }
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 60);
    assert(sawHaul, "a jump against the ledge hauls the player up");
    assert(lantern:::testing:::DebugText(host, "Mantle/Active") == "no", "and the haul ends");
    assert(lantern:::testing:::PlayerY(host) > 1.2f, "the player stands on the dock");
    assert(lantern:::testing:::PlayerZ(host) < 2.9f, "over its edge");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the player mantles a ledge after a jump");
    return 0;
}
