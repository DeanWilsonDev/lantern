lantern :: import lantern;

main :: () -> i32 {
    root: string! = `/tmp/lantern-content-watcher-test-${monotonicNanoseconds()}`;
    defer delete root;
    silhouette: string! = `${root}/assets/silhouettes/materials/steel`;
    defer delete silhouette;
    graphs: string! = `${root}/game-graphs`;
    defer delete graphs;
    assets: string! = `${root}/assets`;
    defer delete assets;
    material: string! = `${silhouette}/root.calamus`;
    defer delete material;
    createDirectories(silhouette);
    createDirectories(graphs);
    gameAssets: string! = `${root}/game-assets`;
    defer delete gameAssets;
    createDirectories(gameAssets);
    steelText~ string! = "".copy();
    when readTextFile("../games/platformer/assets/silhouettes/materials/brushed_steel/root.calamus") {
        Result:::Ok(text) -> {
            delete steelText;
            steelText = text!;
        },
        Result:::Err(error) -> {
            delete error;
        }
    }
    defer delete steelText;
    writeTextFile(material, steelText);
    graphText~ string! = "".copy();
    when readTextFile("tests/support/graphs/lamp_pulse.graph.json") {
        Result:::Ok(text) -> {
            delete graphText;
            graphText = text!;
        },
        Result:::Err(error) -> {
            delete error;
        }
    }
    defer delete graphText;

    packagedRoot: string! = `${root}/packaged`;
    defer delete packagedRoot;
    createDirectories(packagedRoot);
    packaged := lantern:::application:::ContentWatcher:::For(packagedRoot, packagedRoot);
    packagedIsNull: bool = packaged == null;
    assert(packagedIsNull, "a game with no Silhouettes or graphs is not watched");
    delete packaged;

    found~ lantern:::application:::ContentWatcher*!? = lantern:::application:::ContentWatcher:::For(root, assets);
    guard watcher ~= found return 1;
    poll1: bool = watcher->Poll(0.1f);
    assert(!poll1, "it doesn't look before the poll interval");
    poll2: bool = watcher->Poll(0.6f);
    assert(!poll2, "nothing changed, so nothing reloads");

    changedSteel: string! = steelText.replace("roughness : 0.35", "roughness : 0.2");
    defer delete changedSteel;
    writeTextFile(material, changedSteel);
    poll3: bool = watcher->Poll(0.1f);
    assert(!poll3, "a change is noticed at the next poll");
    poll4: bool = watcher->Poll(0.6f);
    assert(poll4, "a changed Silhouette asks for a reload");
    poll5: bool = watcher->Poll(0.6f);
    assert(!poll5, "and only once");

    graphFile: string! = `${graphs}/example.graph.json`;
    defer delete graphFile;
    writeTextFile(graphFile, graphText);
    poll6: bool = watcher->Poll(0.6f);
    assert(poll6, "a new graph file asks for a reload");

    bakedFile: string! = `${root}/game-assets/BakedMaterials.nyx`;
    defer delete bakedFile;
    generatedFile: string! = `${graphs}/generated`;
    defer delete generatedFile;
    assert(pathExists(bakedFile), "the baked materials were written");
    assert(directoryExists(generatedFile), "the graphs' Nyx was written");
    delete found;
    removeDirectory(root);
    print("the content watcher regenerates when a silhouette or graph changes");
    return 0;
}
