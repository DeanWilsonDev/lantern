// A rule message such as "Collect every gem!" shows in the bottom right box, not as a centred card.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::QueueFrames(platform, 30);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after starting the course");
    assert(lantern:::testing:::DebugText(host, "Game/Message") == "Collect every gem!", "starting a level shows its message");
    assert(lantern:::testing:::DebugText(host, "Game/Corner box") == "Collect every gem!", "the message is in the corner box");
    assert(lantern:::testing:::DebugText(host, "Game/Card") == "", "no centred card is up");
    return 0;
}
