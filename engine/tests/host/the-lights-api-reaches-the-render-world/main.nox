// Light calls from a game script reach the render world: the sun's direction is set and normalised, point and spot
// lights are added with their range and strength and get ids in order, and a bad call fails with the engine's message.
NyxC :: import NyxC;
lantern :: import lantern;

SCRIPT: string : "Lights :: () -> void { eye: lantern:::math:::Vec3 = { x: 1.0f, y: 2.0f, z: 3.0f }; sun: lantern:::math:::Vec3 = { y: -2.0f }; lantern:::lights:::SetSun(sun, \"FFFFFF\", \"102030\", \"050607\"); lantern:::lights:::AddPoint(eye, \"FF0000\", 2.0f, 8.0f); }\nSpotId :: () -> i64 { above: lantern:::math:::Vec3 = { y: 5.0f }; return lantern:::lights:::AddSpot(above, lantern:::math:::Vec3:::Zero(), \"00FF00\", 1.0f, 12.0f, 10.0f, 20.0f); }\nEdit :: () -> void { light: i64 = 2; side: lantern:::math:::Vec3 = { x: 4.0f }; lantern:::lights:::Move(light, side); lantern:::lights:::SetShadows(light, true); lantern:::lights:::SetColor(light, \"0000FF\", 3.0f); }\nRemove :: () -> void { lantern:::lights:::Remove(2); }\nQuality :: () -> void { lantern:::lights:::SetSunShadows(false); lantern:::lights:::SetShadowQuality(true, 2048, 100, 40.0f); }\nCount :: () -> i64 { return lantern:::lights:::Count(); }\nMissing :: () -> string { caught~ string = \"no failure\"; when lantern:::lights:::Remove(999) { Error:::Unknown(message) -> { caught = `Unknown: ${message}`; }, Error:::NotFound(message) -> { caught = `NotFound: ${message}`; }, override -> { caught = \"another failure\"; } } return caught; }";

BoolResult :: (program: lantern:::nyx:::Program*, name: string) -> bool {
    noArguments: Array<lantern:::nyx:::Value*>! = [];
    value := lantern:::testing:::ValueOrFail(program->CallFunction(name, noArguments));
    delete noArguments;
    result: bool = lantern:::testing:::BoolOrFail(value->Bool());
    delete value;
    return result;
}

TextResult :: (program: lantern:::nyx:::Program*, name: string) -> string! {
    noArguments: Array<lantern:::nyx:::Value*>! = [];
    value := lantern:::testing:::ValueOrFail(program->CallFunction(name, noArguments));
    delete noArguments;
    result: string! = lantern:::testing:::TextOrFail(value->Text());
    delete value;
    return result!;
}

ExpectFailure :: (program: lantern:::nyx:::Program*, name: string, expected: string) -> void {
    failure: string! = TextResult(program, name);
    if failure != expected {
        print(`${name} failed with '${failure}'`);
    }
    assert(failure == expected, "the call fails with the engine's message");
    delete failure;
}


IntegerResult :: (program: lantern:::nyx:::Program*, name: string) -> i64 {
    noArguments: Array<lantern:::nyx:::Value*>! = [];
    value := lantern:::testing:::ValueOrFail(program->CallFunction(name, noArguments));
    delete noArguments;
    result: i64 = lantern:::testing:::I64OrFail(value->I64());
    delete value;
    return result;
}

main :: () -> i32 {
    state := lantern:::testing:::HeadlessState();
    runtime := new lantern:::nyx:::Runtime();
    math~ lantern:::host:::MathTypes = lantern:::host:::MathTypes { };
    gameUi := lantern:::testing:::RegisterEngineOrFail(runtime, state, math);
    program := lantern:::testing:::Mount(runtime, SCRIPT);
    lantern:::testing:::CallOrFail(program, "Lights");
    assert(state->renderWorld->light.direction.y < -0.99f, "the sun's direction is set and normalised");
    assert(state->renderWorld->lights.length() == 1, "the point light is added");
    assert(state->renderWorld->lights[0].range == 8.0f && state->renderWorld->lights[0].color.r == 2.0f, "its range and strength reach the renderer");
    spot: i64 = IntegerResult(program, "SpotId");
    assert(spot == 2, "the second light gets id 2");
    lantern:::testing:::CallOrFail(program, "Edit");
    assert(state->renderWorld->lights[1].castsShadows, "shadows are switched on");
    assert(state->renderWorld->lights[1].position.x == 4.0f && state->renderWorld->lights[1].color.b == 3.0f, "the light moved and changed colour");
    lantern:::testing:::CallOrFail(program, "Remove");
    assert(IntegerResult(program, "Count") == 1, "one light is left after removing the spot light");
    lantern:::testing:::CallOrFail(program, "Quality");
    assert(!state->renderWorld->light.castsShadows, "the sun's shadows are switched off");
    assert(state->renderWorld->shadows.sunMapSize == 2048 && state->renderWorld->shadows.localTileSize == 256, "the shadow quality is set and clamped");
    assert(state->renderWorld->shadows.distance == 40.0f, "the shadow distance is set");
    ExpectFailure(program, "Missing", "NotFound: no light with id 999");
    delete program;
    delete runtime;
    delete gameUi;
    delete state;
    print("the lights API reaches the render world");
    return 0;
}
