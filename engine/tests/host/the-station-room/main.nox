// The station room: it asks for the grounded feel, eight words are in the station, the ticket gates start shut and a
// shut gate stops the player.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 10);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the station");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/the-station.world.json", "the tenth entry is the station");
    assert(lantern:::testing:::DebugText(host, "Player/Feel") == "grounded", "the station asks for the grounded feel");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 30);
    assert(lantern:::testing:::DebugText(host, "Minigames/Words") == "0 / 8", "eight words are in the station");
    assert(lantern:::testing:::DebugText(host, "Gate/1/door") == "solid", "the ticket gates start shut");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 360);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 20);
    assert(lantern:::testing:::PlayerZ(host) > -13.9f && lantern:::testing:::PlayerZ(host) < -12.0f, "a shut ticket gate stops the player");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the station: the ticket gates stop the player until they buy a ticket");
    return 0;
}
