NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::RunFrames(frameLoop, platform, host, 2);
    playCentre~ Vec2 = Vec2 { x: 0.0f, y: 0.0f };
    if session := host->session {
        buttons: Array<lantern:::chaosui:::ButtonRect>! = session->UiButtonRects();
        assert(buttons.length() == 2, "the menu has Play and Quit");
        if buttons.length() > 0 {
            play: lantern:::chaosui:::Rect = buttons[0].rect;
            playCentre = Vec2 { x: (play.min.x + play.max.x) * 0.5f, y: (play.min.y + play.max.y) * 0.5f };
        }
        delete buttons;
    } else {
        assert(false, "the game loaded");
    }
    lantern:::testing:::Click(platform, playCentre);
    lantern:::testing:::RunFrames(frameLoop, platform, host, 60);
    lantern:::testing:::AssertNoScriptError(host, "after clicking Play");
    time: f32 = lantern:::testing:::ParseDecimalOrFail(lantern:::testing:::DebugText(host, "Game/Time"), "Game/Time");
    assert(time > 0.5f, "Play was clicked");
    assert(platform->mouseCaptured, "playing captures the mouse");
    delete frameLoop;
    delete platform;
    delete host;
    delete manifest;
    print("clicking play with the mouse starts the game");
    return 0;
}