NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();
    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 2);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the narrow way");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/the-narrow-way.world.json", "the second prototype is the narrow way");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 60);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 100);
    assert(lantern:::testing:::PlayerX(host) < 8.1f, "the player is too wide for the slot");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 400);
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "she went through the slot and pulled the lever without being told");
    assert(lantern:::testing:::DebugText(host, "Gate/1/door") == "away", "the door opened");
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 300);
    assert(lantern:::testing:::PartnerX(host) < 8.0f, "she came back out through the slot to meet the player");
    lantern:::testing:::AssertNoScriptError(host, "at the end");
    print("the narrow way: she passes the slot the player cannot, opens the door and comes back");
    return 0;
}
