NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;


main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::OpenPrototypeRoom(host, platform, frameLoop, 2);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the narrow way");
    assert(lantern:::testing:::DebugText(host, "Game/Level") == "worlds/prototypes/the-narrow-way.world.json", "the second prototype is the narrow way");
    lantern:::testing:::TapKey(host, platform, frameLoop, lantern:::core:::KeyCode:::F);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 360);
    assert(lantern:::testing:::DebugText(host, "Partner/Mode") == "acting pull", "she walks through the slot to the lever");
    assert(lantern:::testing:::PartnerX(host) > 10.0f, "she is in the chamber");
    assert(lantern:::testing:::DebugText(host, "Channel/1") == "on", "the lever is pulled");
    assert(lantern:::testing:::DebugText(host, "Gate/1/door") == "away", "the door opened");
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 110);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::D, 120);
    assert(lantern:::testing:::PlayerZ(host) < -5.0f, "the player is level with the slot");
    assert(lantern:::testing:::PlayerX(host) < 8.1f, "the player is too wide for the slot");
    lantern:::testing:::AssertNoScriptError(host, "after the lever");
    print("the narrow way: she passes the slot the player cannot and opens the door");
    return 0;
}
