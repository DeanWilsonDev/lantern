// A level much longer than the load distance, split into rooms, stays cheap: walking it end to end keeps the live entity,
// triangle and light counts bounded, never spends more than the budget outside the urgent ring, and always leaves a floor
// under the walker.
NyxC :: import NyxC;
lantern :: import lantern;

ROOM_COUNT: i32 : 40;
SLABS_PER_ROOM: i32 : 10;
ROOM_LENGTH: f32 : 30.0f;
LOAD_DISTANCE: f32 : 70.0f;
UNLOAD_DISTANCE: f32 : 95.0f;
URGENT_DISTANCE: f32 : 24.0f;
BUDGET: i32 : 12;

MakeEntity :: (key: u64, name: string, kind: string, position: Vec3, roomName: string) -> lantern:::world:::WorldEntity*! {
    entity := new lantern:::world:::WorldEntity(key, name, kind);
    entity->transform.position = position;
    if roomName.length() > 0 {
        entity->SetTextProperty("room", roomName);
    }
    return entity!;
}

BuildRoad :: () -> lantern:::world:::WorldFile*! {
    road := new lantern:::world:::WorldFile("long road");
    key~ u64 = 1;
    startMarker := MakeEntity(key, "start", "marker", Vec3 { x: 0.0f, y: 0.0f, z: 5.0f }, "");
    road->Add(startMarker!);
    key++;
    slabLength: f32 = ROOM_LENGTH / f32(SLABS_PER_ROOM);
    for room~ i32 = 0; room < ROOM_COUNT; room++ {
        roomName: string! = `room-${room:d}`;
        defer delete roomName;
        roomStart: f32 = -f32(room) * ROOM_LENGTH;
        for slab~ i32 = 0; slab < SLABS_PER_ROOM; slab++ {
            slabName: string! = `slab-${room:d}-${slab:d}`;
            defer delete slabName;
            entity := MakeEntity(key, slabName, "block", Vec3 { x: 0.0f, y: -0.5f, z: roomStart - slabLength * (f32(slab) + 0.5f) }, roomName);
            entity->shape = lantern:::world:::Shape:::Box(Vec3 { x: 4.0f, y: 0.5f, z: slabLength * 0.5f });
            entity->collider = lantern:::world:::ColliderKind:::Static;
            road->Add(entity!);
            key++;
        }
        lamp := MakeEntity(key, "lamp", "point_light", Vec3 { x: 3.0f, y: 3.0f, z: roomStart - ROOM_LENGTH * 0.5f }, roomName);
        road->Add(lamp!);
        key++;
    }
    return road!;
}

FloorBelow :: (state: lantern:::host:::EngineState*, z: f32) -> bool {
    hit := state->collision->Raycast(Vec3 { x: 0.0f, y: 2.0f, z: z }, Vec3 { x: 0.0f, y: -1.0f, z: 0.0f }, 5.0f);
    return hit != null;
}

main :: () -> i32 {
    state := lantern:::testing:::HeadlessState();
    runtime := new lantern:::nyx:::Runtime();
    math~ lantern:::host:::MathTypes = lantern:::host:::MathTypes { };
    gameUi := lantern:::testing:::RegisterEngineOrFail(runtime, state, math);
    loaded~ Result<usize, string!> = Result<usize, string!>:::Ok(0);
    unsafe {
        loaded = lantern:::host:::LoadWorldFile(state, BuildRoad());
    }
    assert(loaded.isOk(), "the long road loads");
    entityTotal: usize = loaded.unwrap();
    delete loaded;
    assert(entityTotal == usize(1 + ROOM_COUNT * (SLABS_PER_ROOM + 1)), "the load counts every entity, streamed or not");
    assert(state->streaming->rooms.length() == usize(ROOM_COUNT), "every room is registered");
    assert(state->entityWorld->Length() == 1, "only the resident marker is spawned until rooms stream");
    assert(state->collision->StaticTriangleCount() == 0, "no floor yet");

    unsafe {
        lantern:::host:::LoadAllRoomsOf(state);
    }
    assert(state->entityWorld->Length() == entityTotal, "loading every room spawns the whole level");
    fullTriangles: usize = state->collision->StaticTriangleCount();
    fullLights: usize = state->renderWorld->lights.length();
    assert(fullLights == usize(ROOM_COUNT), "each room has its lamp");

    maxEntities~ usize = 0;
    maxTriangles~ usize = 0;
    maxLights~ usize = 0;
    maxSpawnedOutsideUrgent~ i32 = 0;
    floorMissing~ i32 = 0;
    walkerZ~ f32 = -0.5f;
    totalSteps: i32 = 11600;
    for step~ i32 = 0; step < totalSteps; step++ {
        walkerZ -= 0.1f;
        spawned~ i32 = 0;
        unsafe {
            lantern:::host:::AddStreamFocusTo(state, Vec3 { x: 0.0f, y: 1.0f, z: walkerZ });
            spawned = lantern:::host:::StreamRoomsOf(state, LOAD_DISTANCE, UNLOAD_DISTANCE, URGENT_DISTANCE, BUDGET);
        }
        if step > 0 && spawned > maxSpawnedOutsideUrgent {
            maxSpawnedOutsideUrgent = spawned;
        }
        if !FloorBelow(state, walkerZ) {
            floorMissing++;
        }
        if state->entityWorld->Length() > maxEntities {
            maxEntities = state->entityWorld->Length();
        }
        if state->collision->StaticTriangleCount() > maxTriangles {
            maxTriangles = state->collision->StaticTriangleCount();
        }
        if state->renderWorld->lights.length() > maxLights {
            maxLights = state->renderWorld->lights.length();
        }
    }
    assert(floorMissing == 0, "there was a floor under the walker on every step");
    assert(maxEntities < entityTotal / 3, "the live entities stay a fraction of the level");
    assert(maxTriangles < fullTriangles / 3, "the collision world stays a fraction of the level");
    assert(maxLights < usize(ROOM_COUNT) / 3, "the lights stay a fraction of the level");
    assert(maxSpawnedOutsideUrgent <= BUDGET + SLABS_PER_ROOM + 1, "a step spawns at most the budget plus the one room that turned urgent");
    assert(state->collision->deadStaticCount < 8192, "compaction keeps the dead triangles from piling up");
    assert(state->worldMeshes.length() == state->entityWorld->Length() - 1 - state->renderWorld->lights.length(), "every live block has exactly one mesh and unloaded rooms gave theirs back");
    delete gameUi;
    delete runtime;
    delete state;
    print("rooms stream in and out as the player walks");
    return 0;
}
