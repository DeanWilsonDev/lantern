// The companion waits at her first stop while the player is far away, sets off ahead and stops to wait when the player
// lags, and walks on to the next stop once the player closes the gap.
NyxC :: import NyxC;
ChaosUiC :: import ChaosUiC;
lantern :: import lantern;

main :: () -> i32 {
    manifest := lantern:::testing:::LoadPlatformerManifest();
    host := lantern:::testing:::StartPlatformer(manifest, false);
    platform := lantern:::testing:::NewPlatformerPlatform();
    frameLoop := lantern:::testing:::NewFrameLoop();

    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Down);
    lantern:::testing:::PressKey(platform, lantern:::core:::KeyCode:::Enter);
    lantern:::testing:::QueueFrames(platform, 30);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after choosing the streets");

    lantern:::testing:::QueueFrames(platform, 300);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Mode") == "waiting", "with the player far away she stays at her first stop");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Stop") == "0", "she has not walked on without them");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Position") == "2.00, 2.20, -16.00", "and has not moved");

    lantern:::testing:::HoldKey(platform, lantern:::core:::KeyCode:::W, 90);
    lantern:::testing:::QueueFrames(platform, 150);
    lantern:::testing:::RunQueued(frameLoop, platform, host);
    lantern:::testing:::AssertNoScriptError(host, "after the player came near");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Mode") == "paused", "she set off ahead, then stopped to wait for a player who stayed behind");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Stop") == "0", "she is still on her way to the boost stop");

    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::A, 15);
    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 24);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 6);
    lantern:::testing:::HoldTwoKeysAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, lantern:::core:::KeyCode:::Space, 24);
    lantern:::testing:::HoldKeyAndRun(host, platform, frameLoop, lantern:::core:::KeyCode:::W, 60);
    lantern:::testing:::WaitFrames(host, platform, frameLoop, 120);
    lantern:::testing:::AssertNoScriptError(host, "after the player caught up");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Stop") == "1", "she walked on to the boost stop once the player closed the gap");
    lantern:::testing:::ExpectWithState(host, lantern:::testing:::DebugText(host, "Companion/Offering boost") == "yes", "and crouches there, ahead of the player");

    delete frameLoop;
    delete platform;
    delete host;
    delete manifest;
    print("the companion leads the way");
    return 0;
}
