lantern:::assetgen:::bytes :: namespace {
    /**
     * Appends a 16-bit value, least significant byte first.
     */
    PushU16 :: (output: Array<u8>!~*, value: u32) -> void {
        output->push(u8(value & 255));
        output->push(u8((value >> 8) & 255));
    }

    /**
     * Appends a 32-bit value, least significant byte first.
     */
    PushU32 :: (output: Array<u8>!~*, value: u32) -> void {
        PushU16(output, value & 65535);
        PushU16(output, (value >> 16) & 65535);
    }

    /**
     * Appends a 32-bit value, most significant byte first, as PNG chunks are written.
     */
    PushU32BigEndian :: (output: Array<u8>!~*, value: u32) -> void {
        output->push(u8((value >> 24) & 255));
        output->push(u8((value >> 16) & 255));
        output->push(u8((value >> 8) & 255));
        output->push(u8(value & 255));
    }

    /**
     * Appends an `f32` as its four little-endian bytes.
     */
    PushF32 :: (output: Array<u8>!~*, value: f32) -> void {
        PushU32(output, value.bitsAs<u32>());
    }

    /**
     * Appends the characters of a tag.
     */
    PushTag :: (output: Array<u8>!~*, tag: string) -> void {
        for index~ usize = 0; index < tag.length(); index++ {
            output->push(tag.byteAt(index));
        }
    }
}
