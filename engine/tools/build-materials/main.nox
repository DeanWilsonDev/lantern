lantern :: import lantern;

main :: (arguments: Array<string>) -> i32 {
    gameFolder: string = arguments.length() > 1 ? arguments[1] : "../games/platformer";
    assetsFolder: string! = `${gameFolder}/assets`;
    defer delete assetsFolder;
    silhouettesFolder: string! = `${assetsFolder}/silhouettes`;
    defer delete silhouettesFolder;
    if !directoryExists(silhouettesFolder) {
        print("the game has no material Silhouettes to bake");
        return 0;
    }
    bakedFolder: string! = `${gameFolder}/game-assets`;
    defer delete bakedFolder;
    when lantern:::editorbackend:::BuildGameMaterials(assetsFolder, bakedFolder, true) {
        Result:::Err(message) -> {
            print(message);
            delete message;
            return 1;
        },
        Result:::Ok(changed) -> {
            print(changed ? "wrote BakedMaterials.nyx" : "the game materials were already current");
            return 0;
        }
    }
}
