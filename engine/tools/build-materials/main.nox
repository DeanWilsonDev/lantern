lantern :: import lantern;

main :: () -> i32 {
    when lantern:::editorbackend:::BuildGameMaterials("../assets", "../games/platformer/game-assets", true) {
        Result:::Err(message) -> {
            print(message);
            delete message;
            return 1;
        },
        Result:::Ok(changed) -> {
            print(changed ? "wrote BakedMaterials.nyx" : "the game materials were already current");
            return 0;
        }
    }
}
