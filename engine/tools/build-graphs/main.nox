lantern :: import lantern;

main :: () -> i32 {
    when lantern:::editorbackend:::BuildGameGraphs("../games/platformer/game-graphs", "../games/platformer/game-graphs/generated", true) {
        Result:::Err(message) -> {
            print(message);
            delete message;
            return 1;
        },
        Result:::Ok(written) -> {
            if written.length() == 0 {
                print("the game graphs were already current");
            } else {
                print("wrote:");
                print(written);
            }
            delete written;
            return 0;
        }
    }
}
