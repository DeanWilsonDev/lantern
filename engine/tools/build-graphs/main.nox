lantern :: import lantern;

main :: (arguments: Array<string>) -> i32 {
    gameFolder: string = arguments.length() > 1 ? arguments[1] : "../games/platformer";
    graphsFolder: string! = `${gameFolder}/game-graphs`;
    defer delete graphsFolder;
    if !directoryExists(graphsFolder) {
        print("the game has no game-graphs folder");
        return 0;
    }
    generatedFolder: string! = `${graphsFolder}/generated`;
    defer delete generatedFolder;
    when lantern:::editorbackend:::BuildGameGraphs(graphsFolder, generatedFolder, true) {
        Result:::Err(message) -> {
            print(message);
            delete message;
            return 1;
        },
        Result:::Ok(written) -> {
            if written.length() == 0 {
                print("the game graphs were already current");
            } else {
                print("wrote:");
                print(written);
            }
            delete written;
            return 0;
        }
    }
}
