// The C library's memcpy, used to copy pixel bytes into a buffer the caller owns.
lantern:::editorapicopy :: foreign "c" {
    memcpy :: (destination: Array<u8~>, source: Array<u8>, byteCount: usize) -> raw u8~*;
}

// The editor's C API. This is the one door between the editor (Nox code in engine/src/editor and
// engine/src/editorbackend) and its interface: the world editor's Nox host calls these functions and
// sets them up as host functions for the interface's Nyx code. It is built to be called from C (the editor-backend folder
// has a C test of it), so it uses only plain things: numbers, text, and a handle to the editor. Rules that follow from that:
// - entities are named by a whole number key (0 means none), and lists are read one item at a time
// (a count, then an item by index), with a part number to say which piece of an item you want;
// - a function that cannot do its job returns false or an empty value, and the reason is put in the
// status line, which the interface shows;
// - pictures are drawn into the editor's own memory and then copied into a buffer the caller gives.
// See docs/editor.md for the full list of rules.
lantern:::editorapi :: namespace {
    EditorBackend :: import lantern:::editorbackend:::EditorBackend;
    EditorSession :: import lantern:::editor:::EditorSession;
    OutlineRow :: import lantern:::editor:::OutlineRow;
    InspectorField :: import lantern:::editor:::InspectorField;

    // The parts of an inspector field that Field can be asked for, and of a template that Template can be
    // asked for.
    FIELD_KEY: u32 : 0;
    FIELD_LABEL: u32 : 1;
    FIELD_GROUP: u32 : 2;
    FIELD_VALUE: u32 : 3;
    FIELD_KIND: u32 : 4;
    FIELD_MIXED: u32 : 5;

    TEMPLATE_ID: u32 : 0;
    TEMPLATE_LABEL: u32 : 1;
    TEMPLATE_KIND: u32 : 2;
    TEMPLATE_SILHOUETTE: u32 : 3;
    COMPONENT_NAME: u32 : 0;
    COMPONENT_KIND: u32 : 1;
    COMPONENT_ORIGIN: u32 : 2;

    // Turns the API's signed entity number into the editor's key; a negative number becomes 0 (no entity).
    EntityKey :: (entity: i64) -> u64 {
        if entity < 0 {
            return 0;
        }
        return u64(entity);
    }

    // The reverse: an optional key as a number, with none as 0.
    EntityId :: (key: u64?) -> i64 {
        if found := key {
            return i64(found);
        }
        return 0;
    }

    // "true" or "false" as text, for the bool values returned in text form.
    BoolText :: (value: bool) -> string! {
        if value {
            return "true".copy();
        }
        return "false".copy();
    }

    // Copies bytes into the caller's buffer, which must be at least as big; false if it is too small.
    CopyInto :: (source: Array<u8>, target: Array<u8~>) -> bool {
        if target.length() < source.length() {
            return false;
        }
        if source.length() == 0 {
            return true;
        }
        unsafe {
            lantern:::editorapicopy:::memcpy(target, source, source.length());
        }
        return true;
    }

    // What the C handle points at: the backend, an optional message of the API's own (such as a drawing
    // failure, which the session knows nothing of), and caches of the outline rows and inspector fields.
    // The caches are rebuilt only when the editor's revision number changes, so the interface can ask
    // for row 0, row 1, row 2 and so on without the list being rebuilt for each.
    export Editor :: class {
    public:
        backend~ EditorBackend*!;
        apiStatus~ string!? = null;
        outline~ Array<OutlineRow*!>! = [];
        outlineRevision~ u64? = null;
        inspector~ Array<InspectorField*!>! = [];
        inspectorRevision~ u64? = null;
        thumbnailSide~ u32 = 0;
        graphEditor~ lantern:::graphs:::GraphEditor*!? = null;
        openGraphIsMaterial~ bool = false;
        graphCanvas~ lantern:::graphs:::PixelCanvas*!;

        Editor~: (assets: string, worldPath: string) {
            backend = new EditorBackend(assets, worldPath);
            graphCanvas = new lantern:::graphs:::PixelCanvas();
        }

        !Editor~: () {
            delete backend;
            delete graphEditor;
            delete graphCanvas;
            delete apiStatus;
            outline.freeAll();
            inspector.freeAll();
        }

        // The editor's session.
        Session :: () -> EditorSession~* {
            return backend->session;
        }

        // Forgets the API's own message. Actions the person takes clear it.
        ClearApiStatus~: () -> void {
            delete apiStatus;
            apiStatus = null;
        }

        // Keeps an API error to show as the status line, unless it is already showing.
        ShowError~: (error: string!) -> void {
            if current := apiStatus {
                if current == error {
                    delete error;
                    return;
                }
            }
            delete apiStatus;
            apiStatus = error!;
        }

        // Rebuilds the outline rows if the revision has moved on.
        RefreshOutline~: () -> void {
            revision: u64 = backend->session->UiRevision();
            if cached := outlineRevision {
                if cached == revision {
                    return;
                }
            }
            outline.freeAll();
            outline = backend->session->Outline();
            outlineRevision = revision;
        }

        // Rebuilds the inspector fields if the revision has moved on.
        RefreshInspector~: () -> void {
            revision: u64 = backend->session->UiRevision();
            if cached := inspectorRevision {
                if cached == revision {
                    return;
                }
            }
            inspector.freeAll();
            inspector = backend->session->Inspector();
            inspectorRevision = revision;
        }

        // The outline row at a position, or null past the end.
        OutlineRowAt~: (row: u32) -> OutlineRow*? {
            RefreshOutline();
            if usize(row) >= outline.length() {
                return null;
            }
            return outline[usize(row)];
        }

        // The inspector field at a position, or null past the end.
        InspectorFieldAt~: (index: u32) -> InspectorField*? {
            RefreshInspector();
            if usize(index) >= inspector.length() {
                return null;
            }
            return inspector[usize(index)];
        }

        // An entity's name or kind, or empty if there is no such entity.
        EntityText :: (entity: i64, wantKind: bool) -> string! {
            worldFile := backend->session->World();
            guard index := worldFile->IndexOf(EntityKey(entity)) return "".copy();
            if wantKind {
                return worldFile->entities[index]->kind.copy();
            }
            return worldFile->entities[index]->name.copy();
        }
    }

    // Makes an editor for an assets folder and a level file (empty for the default level).
    export Create :: (assets: string, worldPath: string) -> Editor*! {
        return new Editor(assets, worldPath);
    }

    // Frees an editor.
    export Destroy :: (editorInstance: Editor*!) -> void {
        delete editorInstance;
    }

    // The number that changes whenever anything the interface shows may have changed. An API message
    // counts as a change.
    export Revision :: (editorInstance: Editor*) -> u64 {
        extra: u64 = when (editorInstance->apiStatus == null) { true -> 0, false -> 1 };
        return editorInstance->backend->session->UiRevision() + extra;
    }

    // The status line: the API's message if it has one, else the session's.
    export Status :: (editorInstance: Editor*) -> string! {
        if status := editorInstance->apiStatus {
            return status.copy();
        }
        return editorInstance->backend->session->status.copy();
    }

    export Title :: (editorInstance: Editor*) -> string! {
        return editorInstance->backend->session->Title();
    }

    export DocumentPath :: (editorInstance: Editor*) -> string! {
        if path := editorInstance->backend->session->document->path {
            return path.copy();
        }
        return "".copy();
    }

    export IsDirty :: (editorInstance: Editor*) -> bool {
        return editorInstance->backend->session->document->IsDirty();
    }

    // Opens a level file.
    export Open :: (editorInstance: Editor~*, path: string) -> bool {
        editorInstance->ClearApiStatus();
        return editorInstance->Session()->Load(path);
    }

    export Save :: (editorInstance: Editor~*) -> bool {
        editorInstance->ClearApiStatus();
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        rebuilt: string!? = lantern:::editorbackend:::RebuildGameMaterials(assetsDirectory);
        delete rebuilt;
        delete assetsDirectory;
        return editorInstance->Session()->Save();
    }

    export SaveAs :: (editorInstance: Editor~*, path: string) -> bool {
        editorInstance->ClearApiStatus();
        if path.trim().length() == 0 {
            return false;
        }
        return editorInstance->Session()->SaveAs(path);
    }

    export NewWorld :: (editorInstance: Editor~*, name: string) -> void {
        editorInstance->ClearApiStatus();
        if name.length() == 0 {
            editorInstance->Session()->NewWorld("untitled");
        } else {
            editorInstance->Session()->NewWorld(name);
        }
    }

    // Draws the viewport at a size into the editor's pixel buffer. A failure is shown in the status line
    // and false is returned.
    export Render :: (editorInstance: Editor~*, width: u32, height: u32) -> bool {
        failure: string!? = editorInstance->backend->Render(width, height);
        if problem := failure {
            editorInstance->ShowError(problem.copy());
            delete failure;
            return false;
        }
        return true;
    }

    // The size of the last picture drawn, or 0 if none has been drawn.
    export PixelWidth :: (editorInstance: Editor*) -> u32 {
        if editorInstance->backend->pixels.length() == 0 {
            return 0;
        }
        return editorInstance->backend->pixelWidth;
    }

    export PixelHeight :: (editorInstance: Editor*) -> u32 {
        if editorInstance->backend->pixels.length() == 0 {
            return 0;
        }
        return editorInstance->backend->pixelHeight;
    }

    // Copies the last picture's RGBA bytes into a buffer.
    export CopyPixels :: (editorInstance: Editor*, target: Array<u8~>) -> bool {
        return CopyInto(editorInstance->backend->pixels, target);
    }

    // Pointer, wheel, key and tick input from the viewport. They are handed straight to the session.
    export PointerMove :: (editorInstance: Editor~*, x: f32, y: f32) -> void {
        editorInstance->Session()->PointerMoved(Vec2 { x: x, y: y });
    }

    export PointerButton :: (editorInstance: Editor~*, button: u32, down: bool, modifiers: u32) -> void {
        guard pressed := lantern:::editor:::PointerButtonAt(button) return;
        editorInstance->ClearApiStatus();
        editorInstance->Session()->SetPointerButton(pressed, down, lantern:::editor:::Modifiers:::FromBits(modifiers));
    }

    export Wheel :: (editorInstance: Editor~*, notches: f32) -> void {
        editorInstance->Session()->Wheel(notches);
    }

    export Key :: (editorInstance: Editor~*, keyName: string, down: bool, modifiers: u32) -> bool {
        guard editorKey := lantern:::editor:::EditorKey:::FromName(keyName) return false;
        return editorInstance->Session()->Key(editorKey, down, lantern:::editor:::Modifiers:::FromBits(modifiers));
    }

    export ReleaseKeys :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->ReleaseKeys();
    }

    // One tick of time, limited to between 0 and a quarter of a second so a long pause (a window being
    // dragged, a breakpoint) does not fling the fly camera. It also checks whether the game being
    // played has quit.
    export Update :: (editorInstance: Editor~*, seconds: f32) -> void {
        clamped~ f32 = seconds;
        if !(clamped >= 0.0f) {
            clamped = 0.0f;
        }
        if clamped > 0.25f {
            clamped = 0.25f;
        }
        editorInstance->Session()->Update(clamped);
        editorInstance->backend->PollPlay();
    }

    export FrameSelection :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->FrameSelection();
    }

    export SetTool :: (editorInstance: Editor~*, name: string) -> void {
        guard tool := lantern:::editor:::GizmoToolNamed(name) return;
        editorInstance->Session()->SetTool(tool);
    }

    export Tool :: (editorInstance: Editor*) -> string! {
        return lantern:::editor:::GizmoToolName(editorInstance->backend->session->tool).copy();
    }

    export SetSnap :: (editorInstance: Editor~*, enabled: bool) -> void {
        editorInstance->Session()->SetSnapEnabled(enabled);
    }

    export Snap :: (editorInstance: Editor*) -> bool {
        return editorInstance->backend->session->snap.enabled;
    }

    export SetSocketSnap :: (editorInstance: Editor~*, enabled: bool) -> void {
        editorInstance->Session()->SetSocketSnapEnabled(enabled);
    }

    export SocketSnap :: (editorInstance: Editor*) -> bool {
        return editorInstance->backend->session->snap.sockets;
    }

    // The outliner: rows are read by position; ids, depths and parents are returned as numbers.
    export OutlineCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->World()->entities.length());
    }

    export OutlineId :: (editorInstance: Editor~*, row: u32) -> i64 {
        guard found := editorInstance->OutlineRowAt(row) return 0;
        return i64(found->key);
    }

    export OutlineDepth :: (editorInstance: Editor~*, row: u32) -> u32 {
        guard found := editorInstance->OutlineRowAt(row) return 0;
        return found->depth;
    }

    export OutlineParent :: (editorInstance: Editor~*, row: u32) -> i64 {
        guard found := editorInstance->OutlineRowAt(row) return 0;
        return EntityId(found->parent);
    }

    export OutlineHasChildren :: (editorInstance: Editor~*, row: u32) -> bool {
        guard found := editorInstance->OutlineRowAt(row) return false;
        return found->hasChildren;
    }

    export EntityName :: (editorInstance: Editor*, entity: i64) -> string! {
        return editorInstance->EntityText(entity, false);
    }

    export EntityKind :: (editorInstance: Editor*, entity: i64) -> string! {
        return editorInstance->EntityText(entity, true);
    }

    export IsSelected :: (editorInstance: Editor*, entity: i64) -> bool {
        return editorInstance->backend->session->IsSelected(EntityKey(entity));
    }

    // Selects an entity (adding to the selection if `additive`).
    export Select :: (editorInstance: Editor~*, entity: i64, additive: bool) -> void {
        if additive {
            editorInstance->Session()->ToggleSelected(EntityKey(entity));
        } else {
            editorInstance->Session()->SelectOnly(EntityKey(entity));
        }
    }

    export ClearSelection :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->ClearSelection();
    }

    export PrimarySelection :: (editorInstance: Editor*) -> i64 {
        return EntityId(editorInstance->backend->session->PrimarySelection());
    }

    export SelectionCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->selection.length());
    }

    // The inspector: how many fields there are, and one piece of a field (`part` is one of the
    // FIELD_ numbers) as text. Booleans come back as "true" or "false".
    export FieldCount :: (editorInstance: Editor~*) -> u32 {
        editorInstance->RefreshInspector();
        return u32(editorInstance->inspector.length());
    }

    export Field :: (editorInstance: Editor~*, index: u32, part: u32) -> string! {
        guard field := editorInstance->InspectorFieldAt(index) return "".copy();
        if part == FIELD_KEY {
            return field->key.copy();
        }
        if part == FIELD_LABEL {
            return field->label.copy();
        }
        if part == FIELD_GROUP {
            return field->group.copy();
        }
        if part == FIELD_VALUE {
            return field->value.copy();
        }
        if part == FIELD_KIND {
            return lantern:::editor:::FieldKindName(field->kind).copy();
        }
        if part == FIELD_MIXED {
            return BoolText(field->mixed);
        }
        return "".copy();
    }

    // The choices of a drop down field, one at a time.
    export FieldChoiceCount :: (editorInstance: Editor~*, index: u32) -> u32 {
        guard field := editorInstance->InspectorFieldAt(index) return 0;
        return u32(field->choices.length());
    }

    export FieldChoice :: (editorInstance: Editor~*, index: u32, choice: u32) -> string! {
        guard field := editorInstance->InspectorFieldAt(index) return "".copy();
        if usize(choice) >= field->choices.length() {
            return "".copy();
        }
        return field->choices[usize(choice)].copy();
    }

    // Sets one field of an entity from text typed in the inspector, and CommitField ends the typing so
    // the next change is a new undo step.
    export SetField :: (editorInstance: Editor~*, entity: i64, field: string, text: string) -> bool {
        editorInstance->ClearApiStatus();
        return editorInstance->Session()->SetField(EntityKey(entity), field, text);
    }

    export CommitField :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->CommitField();
    }

    // The palette: how many templates there are, and one piece of one (TEMPLATE_ID, LABEL or KIND).
    export TemplateCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->palette->templates.length());
    }

    export Template :: (editorInstance: Editor*, index: u32, part: u32) -> string! {
        templates: lantern:::editor:::Palette* = editorInstance->backend->session->palette;
        if usize(index) >= templates->templates.length() {
            return "".copy();
        }
        template: lantern:::editor:::EntityTemplate* = templates->templates[usize(index)];
        if part == TEMPLATE_ID {
            return template->id.copy();
        }
        if part == TEMPLATE_LABEL {
            return template->label.copy();
        }
        if part == TEMPLATE_KIND {
            return template->prototype->kind.copy();
        }
        if part == TEMPLATE_SILHOUETTE {
            return when template->fromSilhouette { true -> "1".copy(), false -> "".copy() };
        }
        return "".copy();
    }

    // The components of a template as the Silhouette editor lists them: the root first, then its
    // descendants in order. A template that is not from a Silhouette has just the root.
    export SilhouetteComponentCount :: (editorInstance: Editor*, templateId: string) -> u32 {
        guard template := editorInstance->backend->session->palette->Template(templateId) return 0;
        return u32(template->descendants.length() + 1);
    }

    // How deep a component is in its Silhouette: the root is 0, its children 1, and so on.
    export SilhouetteComponentDepth :: (editorInstance: Editor*, templateId: string, index: u32) -> u32 {
        guard template := editorInstance->backend->session->palette->Template(templateId) return 0;
        if index == 0 || usize(index) > template->descendants.length() {
            return 0;
        }
        depth~ u32 = 1;
        ancestor~ usize = template->descendantParents[usize(index) - 1];
        while ancestor > 0 {
            depth += 1;
            ancestor = template->descendantParents[ancestor - 1];
        }
        return depth;
    }

    // One piece (COMPONENT_NAME, COMPONENT_KIND or COMPONENT_ORIGIN) of one component of a template. The origin is
    // where the component comes from, as `lantern:::editorbackend:::ComponentOrigin` says, and empty for a template
    // that isn't a Silhouette.
    export SilhouetteComponent :: (editorInstance: Editor*, templateId: string, index: u32, part: u32) -> string! {
        guard template := editorInstance->backend->session->palette->Template(templateId) return "".copy();
        if usize(index) > template->descendants.length() {
            return "".copy();
        }
        if part == COMPONENT_ORIGIN {
            if !template->fromSilhouette || usize(index) >= template->componentPaths.length() {
                return "".copy();
            }
            return lantern:::editorbackend:::ComponentOrigin(editorInstance->backend->assetsDirectory, templateId, template->componentPaths[usize(index)]);
        }
        entity~ lantern:::world:::WorldEntity* = template->prototype;
        if index > 0 {
            entity = template->descendants[usize(index) - 1];
        }
        if part == COMPONENT_NAME {
            return entity->name.copy();
        }
        if part == COMPONENT_KIND {
            return entity->kind.copy();
        }
        return "".copy();
    }

    // How many lines the details panel shows for a component, and one of them. The values are the
    // component's resolved values (the editor's own `editor` entry included), one line per value.
    export SilhouetteValueCount :: (editorInstance: Editor*, templateId: string, index: u32) -> u32 {
        guard template := editorInstance->backend->session->palette->Template(templateId) return 0;
        lines := lantern:::editorbackend:::ComponentValueLines(template, usize(index));
        count: u32 = u32(lines->lines.length());
        delete lines;
        return count;
    }

    export SilhouetteValue :: (editorInstance: Editor*, templateId: string, index: u32, line: u32) -> string! {
        guard template := editorInstance->backend->session->palette->Template(templateId) return "".copy();
        lines := lantern:::editorbackend:::ComponentValueLines(template, usize(index));
        defer delete lines;
        if usize(line) >= lines->lines.length() {
            return "".copy();
        }
        return lines->lines[usize(line)].copy();
    }

    // Edits to a Silhouette's files from its tab. `index` names the component the edit applies to (the parent for an
    // add), and each returns an error message, empty when it worked. The Silhouette's palette template is then
    // read again, so the tab shows the files as they are now.
    ProblemText :: (problem: string!?) -> string! {
        message~ string! = "".copy();
        if text := problem {
            delete message;
            message = text.copy();
        }
        delete problem;
        return message!;
    }

    SilhouetteEdit :: (editorInstance: Editor~*, templateId: string, problemText: string) -> string! {
        if problemText.length() > 0 {
            return problemText.copy();
        }
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        defer delete assetsDirectory;
        refreshed: string!? = lantern:::editorbackend:::RefreshSilhouetteTemplate(editorInstance->Session()->palette, assetsDirectory, templateId);
        editorInstance->Session()->paletteRevision += 1;
        rebuilt: string!? = lantern:::editorbackend:::RebuildGameMaterials(assetsDirectory);
        delete rebuilt;
        editorInstance->backend->ForgetMaterials();
        return ProblemText(refreshed!);
    }

    SilhouetteHasComponent :: (editorInstance: Editor*, templateId: string, index: u32) -> bool {
        guard template := editorInstance->backend->session->palette->Template(templateId) return false;
        return usize(index) < template->componentPaths.length();
    }

    // The dotted path of a component, empty for the root or an index past the end.
    SilhouetteComponentPath :: (editorInstance: Editor*, templateId: string, index: u32) -> string! {
        guard template := editorInstance->backend->session->palette->Template(templateId) return "".copy();
        if usize(index) >= template->componentPaths.length() {
            return "".copy();
        }
        return template->componentPaths[usize(index)].copy();
    }

    export SilhouetteAddChild :: (editorInstance: Editor~*, templateId: string, parentIndex: u32, kind: string) -> string! {
        if !SilhouetteHasComponent(editorInstance, templateId, parentIndex) {
            return "No such component.".copy();
        }
        parentPath: string! = SilhouetteComponentPath(editorInstance, templateId, parentIndex);
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        problem: string!? = lantern:::editorbackend:::AddSilhouetteChild(assetsDirectory, templateId, parentPath, kind);
        delete parentPath;
        delete assetsDirectory;
        problemText: string! = ProblemText(problem!);
        result: string! = SilhouetteEdit(editorInstance, templateId, problemText);
        delete problemText;
        return result!;
    }

    export SilhouetteRenameComponent :: (editorInstance: Editor~*, templateId: string, index: u32, newName: string) -> string! {
        if !SilhouetteHasComponent(editorInstance, templateId, index) {
            return "No such component.".copy();
        }
        componentPath: string! = SilhouetteComponentPath(editorInstance, templateId, index);
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        problem: string!? = lantern:::editorbackend:::RenameSilhouetteComponent(assetsDirectory, templateId, componentPath, newName);
        delete componentPath;
        delete assetsDirectory;
        problemText: string! = ProblemText(problem!);
        result: string! = SilhouetteEdit(editorInstance, templateId, problemText);
        delete problemText;
        return result!;
    }

    export SilhouetteDeleteComponent :: (editorInstance: Editor~*, templateId: string, index: u32) -> string! {
        if !SilhouetteHasComponent(editorInstance, templateId, index) {
            return "No such component.".copy();
        }
        componentPath: string! = SilhouetteComponentPath(editorInstance, templateId, index);
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        problem: string!? = lantern:::editorbackend:::DeleteSilhouetteComponent(assetsDirectory, templateId, componentPath);
        delete componentPath;
        delete assetsDirectory;
        problemText: string! = ProblemText(problem!);
        result: string! = SilhouetteEdit(editorInstance, templateId, problemText);
        delete problemText;
        return result!;
    }

    // Sets one value of a component (`key` is dotted, `valueText` is JSON), or with `revert` puts a variant's value back to its
    // base's. Returns an error message, empty when it worked.
    export SilhouetteEditValue :: (editorInstance: Editor~*, templateId: string, index: u32, key: string, valueText: string, revert: bool) -> string! {
        if !SilhouetteHasComponent(editorInstance, templateId, index) {
            return "No such component.".copy();
        }
        componentPath: string! = SilhouetteComponentPath(editorInstance, templateId, index);
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        problem: string!? = lantern:::editorbackend:::EditSilhouetteValue(assetsDirectory, templateId, componentPath, key, valueText, revert);
        delete componentPath;
        delete assetsDirectory;
        problemText: string! = ProblemText(problem!);
        result: string! = SilhouetteEdit(editorInstance, templateId, problemText);
        delete problemText;
        return result!;
    }

    // Moves a component (and what hangs from it) under another component of the same Silhouette.
    export SilhouetteMoveComponent :: (editorInstance: Editor~*, templateId: string, index: u32, parentIndex: u32) -> string! {
        if !SilhouetteHasComponent(editorInstance, templateId, index) || !SilhouetteHasComponent(editorInstance, templateId, parentIndex) {
            return "No such component.".copy();
        }
        componentPath: string! = SilhouetteComponentPath(editorInstance, templateId, index);
        parentPath: string! = SilhouetteComponentPath(editorInstance, templateId, parentIndex);
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        problem: string!? = lantern:::editorbackend:::MoveSilhouetteComponent(assetsDirectory, templateId, componentPath, parentPath);
        delete componentPath;
        delete parentPath;
        delete assetsDirectory;
        problemText: string! = ProblemText(problem!);
        result: string! = SilhouetteEdit(editorInstance, templateId, problemText);
        delete problemText;
        return result!;
    }

    // Points a variant at another Silhouette as its base.
    export SilhouetteSetBase :: (editorInstance: Editor~*, templateId: string, newBase: string) -> string! {
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        problem: string!? = lantern:::editorbackend:::SetSilhouetteBase(assetsDirectory, templateId, newBase);
        delete assetsDirectory;
        problemText: string! = ProblemText(problem!);
        result: string! = SilhouetteEdit(editorInstance, templateId, problemText);
        delete problemText;
        return result!;
    }

    // Deletes a whole Silhouette and takes it out of the palette. Returns an error message, empty when it worked.
    export SilhouetteDelete :: (editorInstance: Editor~*, templateId: string) -> string! {
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        problem: string!? = lantern:::editorbackend:::DeleteSilhouette(assetsDirectory, templateId);
        delete assetsDirectory;
        problemText: string! = ProblemText(problem!);
        if problemText.length() == 0 {
            editorInstance->Session()->palette->RemoveTemplate(templateId);
            editorInstance->Session()->paletteRevision += 1;
        }
        return problemText!;
    }

    // Renames a whole Silhouette and the variants made from it, and updates the palette. Returns an error message, empty when
    // it worked.
    export SilhouetteRename :: (editorInstance: Editor~*, templateId: string, newName: string) -> string! {
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        defer delete assetsDirectory;
        users~ Array<string!>! = lantern:::editorbackend:::SilhouettesUsing(assetsDirectory, templateId);
        defer users.freeAll();
        problem: string!? = lantern:::editorbackend:::RenameSilhouette(assetsDirectory, templateId, newName);
        problemText: string! = ProblemText(problem!);
        defer delete problemText;
        if problemText.length() > 0 {
            return problemText.copy();
        }
        editorInstance->Session()->palette->RemoveTemplate(templateId);
        result~ string! = SilhouetteEdit(editorInstance, newName, "");
        for user in users {
            if result.length() == 0 {
                delete result;
                result = SilhouetteEdit(editorInstance, user, "");
            }
        }
        return result!;
    }

    // Rebuilds every placed Silhouette instance in the open level from its Silhouette as it is now. Returns a sentence for
    // the status line.
    export SilhouetteRefreshInstances :: (editorInstance: Editor~*) -> string! {
        refreshed: usize = editorInstance->Session()->RefreshSilhouetteInstances();
        if refreshed == 0 {
            return "No placed Silhouette instances to refresh.".copy();
        }
        if refreshed == 1 {
            return "Refreshed 1 placed instance.".copy();
        }
        return `Refreshed ${refreshed} placed instances.`;
    }

    // Creates a Silhouette called `newName`: an empty one of `kind`, or, with `baseTemplateId` set, a variant of that
    // Silhouette. Returns an error message, empty when it worked.
    export SilhouetteCreate :: (editorInstance: Editor~*, newName: string, kind: string, baseTemplateId: string) -> string! {
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        defer delete assetsDirectory;
        problem~ string!? = null;
        if baseTemplateId.length() == 0 {
            problem = lantern:::editorbackend:::CreateSilhouette(assetsDirectory, newName, kind);
        } else {
            guard base := editorInstance->backend->session->palette->Template(baseTemplateId) return "No such Silhouette.".copy();
            if !base->fromSilhouette {
                return "Only a Silhouette can have variants.".copy();
            }
            problem = lantern:::editorbackend:::DeriveSilhouette(assetsDirectory, baseTemplateId, newName, base->prototype->kind, base->prototype->name, base->label);
        }
        problemText: string! = ProblemText(problem!);
        result: string! = SilhouetteEdit(editorInstance, newName, problemText);
        delete problemText;
        return result!;
    }

    // Places a new entity from a template at the centre of the view and returns its key, or 0.
    export AddEntity :: (editorInstance: Editor~*, templateId: string) -> i64 {
        editorInstance->ClearApiStatus();
        return EntityId(editorInstance->Session()->AddEntity(templateId, false));
    }

    // Places a scene instance of the world file the asset browser calls `virtualWorldPath` (`Worlds/scenes/hall.world.json`) at
    // the centre of the view and returns its key, or 0. The scene is named from the folder of the level being edited, so the
    // level has to be saved first and the asset has to live under the same assets folder as the level.
    export AddSceneInstance :: (editorInstance: Editor~*, virtualWorldPath: string) -> i64 {
        editorInstance->ClearApiStatus();
        assetsDirectory: string! = editorInstance->backend->assetsDirectory.copy();
        defer delete assetsDirectory;
        if editorInstance->Session()->document->path == null {
            editorInstance->Session()->SetStatus("Save the level before placing a scene in it".copy());
            return 0;
        }
        sceneFile: string! = lantern:::editorbackend:::ResolveAssetFile(assetsDirectory, virtualWorldPath);
        defer delete sceneFile;
        levelDirectory~ string! = "".copy();
        if levelPath := editorInstance->Session()->document->path {
            delete levelDirectory;
            levelDirectory = lantern:::world:::DirectoryOf(levelPath);
        }
        defer delete levelDirectory;
        relative: string! = lantern:::world:::RelativePath(levelDirectory, sceneFile);
        defer delete relative;
        return EntityId(editorInstance->Session()->AddSceneInstance(relative, false));
    }

