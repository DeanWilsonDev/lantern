    // A number for the stats readout: the entity count, the selection count, the play time, or one of the
    // render statistics by name. Unknown names give empty text.
    export Stat :: (editorInstance: Editor*, name: string) -> string! {
        if name == "entities" {
            return `${editorInstance->backend->session->World()->entities.length()}`;
        }
        if name == "selected" {
            return `${editorInstance->backend->session->selection.length()}`;
        }
        if name == "play_seconds" {
            return lantern:::core:::FixedDecimals(f64(editorInstance->backend->PlaySeconds()), 0, 0);
        }
        valueFound: string!? = editorInstance->backend->stats.Get(name);
        if value := valueFound {
            copied: string! = value.copy();
            delete valueFound;
            return copied!;
        }
        return "".copy();
    }

    // Draws the spinning template preview. `spin` is the angle in radians.
    export RenderPreview :: (editorInstance: Editor~*, templateId: string, width: u32, height: u32, spin: f32) -> bool {
        failure: string!? = editorInstance->backend->RenderTemplatePreview(templateId, width, height, spin);
        if problem := failure {
            editorInstance->ShowError(problem.copy());
            delete failure;
            return false;
        }
        return true;
    }

    // Draws one placed entity with its current values, turning by `spin` radians, into the preview pixels.
    export RenderEntityPreview :: (editorInstance: Editor~*, entity: i64, width: u32, height: u32, spin: f32) -> bool {
        failure: string!? = editorInstance->backend->RenderEntityPreview(EntityKey(entity), width, height, spin);
        if problem := failure {
            editorInstance->ShowError(problem.copy());
            delete failure;
            return false;
        }
        return true;
    }

    export PreviewWidth :: (editorInstance: Editor*) -> u32 {
        if editorInstance->backend->previewPixels.length() == 0 {
            return 0;
        }
        return editorInstance->backend->previewWidth;
    }

    export PreviewHeight :: (editorInstance: Editor*) -> u32 {
        if editorInstance->backend->previewPixels.length() == 0 {
            return 0;
        }
        return editorInstance->backend->previewHeight;
    }

    // Copies the preview's RGBA bytes into a buffer.
    export CopyPreviewPixels :: (editorInstance: Editor*, target: Array<u8~>) -> bool {
        return CopyInto(editorInstance->backend->previewPixels, target);
    }

    // Draws a palette thumbnail if it is out of date, and returns its side in pixels (0 on failure).
    export Thumbnail :: (editorInstance: Editor~*, templateId: string, size: u32) -> u32 {
        failure: string!? = editorInstance->backend->RenderThumbnail(templateId, size);
        if problem := failure {
            editorInstance->ShowError(problem.copy());
            delete failure;
            return 0;
        }
        guard index := editorInstance->backend->ThumbnailIndex(templateId) return 0;
        return editorInstance->backend->thumbnails[index]->size;
    }

    // Copies a thumbnail's RGBA bytes into a buffer.
    export CopyThumbnailPixels :: (editorInstance: Editor*, templateId: string, target: Array<u8~>) -> bool {
        guard index := editorInstance->backend->ThumbnailIndex(templateId) return false;
        return CopyInto(editorInstance->backend->thumbnails[index]->pixels, target);
    }

    // ---- the Graph tab ----
    // One graph is open at a time (`GraphOpen`), drawn into the editor's own pixels (`GraphRender`, then
    // `GraphCopyPixels`), moved by the pointer events, and edited by field. Every function that changes the graph
    // bumps `GraphRevision`, so the interface knows when to ask again.

    // The names of the graphs in the assets folder, one per line.
    export GraphList :: (editorInstance: Editor*) -> string! {
        return lantern:::editorbackend:::ListGraphNames(editorInstance->backend->assetsDirectory);
    }

    // Makes a loaded graph the open one.
    InstallGraph :: (editorInstance: Editor~*, name: string, graph: lantern:::graphs:::Graph*!) -> string! {
        delete editorInstance->graphEditor;
        editorInstance->graphEditor = new lantern:::graphs:::GraphEditor(name, graph!);
        if open ~= editorInstance->graphEditor {
            lantern:::graphs:::ArrangeUnplacedFunctions(open->graph);
        }
        return "".copy();
    }

    // Opens a graph from its file, or makes it when `create` is true. Returns an error message, or "" when it is open.
    export GraphOpen :: (editorInstance: Editor~*, name: string, create: bool) -> string! {
        makeMaterialGraph~ bool = false;
        if lantern:::editorbackend:::IsMaterialGraphName(name) {
            found: string!? = lantern:::editorbackend:::MaterialGraphFile(editorInstance->backend->assetsDirectory, lantern:::editorbackend:::MaterialOfGraphName(name));
            if file := found {
                makeMaterialGraph = !pathExists(file);
            }
            delete found;
        }
        if create || makeMaterialGraph {
            when lantern:::editorbackend:::CreateGraphFile(editorInstance->backend->assetsDirectory, name) {
                Result:::Err(message) -> {
                    return message!;
                },
                Result:::Ok(graph) -> {
                    return InstallGraph(editorInstance, name, graph!);
                }
            }
        }
        when lantern:::editorbackend:::LoadGraphByName(editorInstance->backend->assetsDirectory, name) {
            Result:::Err(message) -> {
                return message!;
            },
            Result:::Ok(graph) -> {
                return InstallGraph(editorInstance, name, graph!);
            }
        }
    }

    // Lays the open function's nodes out left to right and brings them into view. Returns false when no graph is open.
    // The open graph's name (`material:<material>` for a material's graph), or "" when none is open.
    export GraphName :: (editorInstance: Editor*) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        return open->name.copy();
    }

    // Every material Silhouette, one per line as `<material>\t<yes or no>`: whether it has a graph yet.
    export MaterialList :: (editorInstance: Editor*) -> string! {
        return lantern:::editorbackend:::ListMaterials(editorInstance->backend->assetsDirectory);
    }

    export GraphFormat :: (editorInstance: Editor~*) -> bool {
        guard open ~= editorInstance->graphEditor return false;
        lantern:::graphs:::ArrangeFunction(open->graph->functions[open->functionIndex]);
        open->fitPending = true;
        open->SetStatus("Formatted.");
        open->Touch();
        return true;
    }

    export GraphClose :: (editorInstance: Editor~*) -> void {
        delete editorInstance->graphEditor;
        editorInstance->graphEditor = null;
    }

    export GraphIsOpen :: (editorInstance: Editor*) -> bool {
        return editorInstance->graphEditor != null;
    }

    // Draws the open graph at a size. False when none is open.
    export GraphRender :: (editorInstance: Editor~*, width: u32, height: u32) -> bool {
        guard open ~= editorInstance->graphEditor return false;
        if open->fitPending {
            open->fitPending = false;
            lantern:::graphs:::FitToView(open, i32(width), i32(height));
        }
        delete open->failedNode;
        open->failedNode = "".copy();
        if editorInstance->backend->failureGraph == open->name {
            open->failedNode = `${editorInstance->backend->failureNode}`;
        }
        lantern:::graphs:::DrawGraph(open, editorInstance->graphCanvas, width, height);
        return true;
    }

    export GraphPixelWidth :: (editorInstance: Editor*) -> u32 {
        return editorInstance->graphCanvas->width;
    }

    export GraphPixelHeight :: (editorInstance: Editor*) -> u32 {
        return editorInstance->graphCanvas->height;
    }

    export GraphCopyPixels :: (editorInstance: Editor*, target: Array<u8~>) -> bool {
        return CopyInto(editorInstance->graphCanvas->pixels, target);
    }

    export GraphPointerMove :: (editorInstance: Editor~*, x: f32, y: f32) -> void {
        guard open ~= editorInstance->graphEditor return;
        lantern:::graphs:::PointerMoved(open, i32(x), i32(y));
    }

    export GraphPointerButton :: (editorInstance: Editor~*, button: u32, down: bool) -> void {
        guard open ~= editorInstance->graphEditor return;
        if down {
            lantern:::graphs:::PointerPressed(open, button);
        } else {
            lantern:::graphs:::PointerReleased(open, button);
        }
    }

    export GraphWheel :: (editorInstance: Editor~*, notches: f32, notchesX: f32) -> void {
        guard open ~= editorInstance->graphEditor return;
        lantern:::graphs:::WheelTurned(open, notches, notchesX);
    }

    export GraphKey :: (editorInstance: Editor~*, keyName: string, shortcut: bool) -> bool {
        guard open ~= editorInstance->graphEditor return false;
        return lantern:::graphs:::KeyPressed(open, keyName, shortcut);
    }

    // Counts up on every change to the open graph or what is selected, so the interface redraws its panels.
    export GraphRevision :: (editorInstance: Editor*) -> u32 {
        guard open := editorInstance->graphEditor return 0;
        return open->generation + editorInstance->backend->failureVersion;
    }

    export GraphIsDirty :: (editorInstance: Editor*) -> bool {
        guard open := editorInstance->graphEditor return false;
        return open->isDirty;
    }

    export GraphStatus :: (editorInstance: Editor*) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        return open->status.copy();
    }

    // The text of the open function's functions, one name per line.
    export GraphFunctions :: (editorInstance: Editor*) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        names~ string! = "".copy();
        for index~ usize = 0; index < open->graph->functions.length(); index++ {
            if index > 0 {
                names += "\n";
            }
            names += open->graph->functions[index]->name;
        }
        return names!;
    }

    export GraphSelectFunction :: (editorInstance: Editor~*, index: u32) -> void {
        guard open ~= editorInstance->graphEditor return;
        if usize(index) < open->graph->functions.length() {
            open->functionIndex = usize(index);
            open->fitPending = true;
            lantern:::graphs:::SelectNode(open, "");
            open->Touch();
        }
    }

    // Selects the node that wrote a line of the generated Nyx (1 is the first line), the way to find the node behind an error
    // line. Returns the node's id, or "" when no node wrote that line.
    export GraphSelectLine :: (editorInstance: Editor~*, lineNumber: u32) -> string! {
        guard open ~= editorInstance->graphEditor return "".copy();
        id: string! = lantern:::graphs:::NodeAtLine(open->graph, lineNumber);
        if id.length() > 0 {
            lantern:::graphs:::SelectNode(open, id);
            open->Touch();
        }
        return id!;
    }

    export GraphSelectedFunction :: (editorInstance: Editor*) -> u32 {
        guard open := editorInstance->graphEditor return 0;
        return u32(open->functionIndex);
    }

    // Adds a function and shows it. Returns an error message or "".
    export GraphAddFunction :: (editorInstance: Editor~*, name: string, returns: string) -> string! {
        guard open ~= editorInstance->graphEditor return "No graph is open.".copy();
        problem: string!? = lantern:::graphs:::AddFunction(open->graph, name, returns);
        if problem != null {
            return ProblemText(problem!);
        }
        delete problem;
        open->functionIndex = open->graph->functions.length() - 1;
        open->Touch();
        return "".copy();
    }

    // Adds a node of a kind near the middle of what is showing and selects it. Returns its id, or "" for an unknown kind.
    export GraphAddNode :: (editorInstance: Editor~*, kind: string) -> string! {
        guard open ~= editorInstance->graphEditor return "".copy();
        centreX: i32 = open->WorldX(i32(editorInstance->graphCanvas->width / 2));
        centreY: i32 = open->WorldY(i32(editorInstance->graphCanvas->height / 2));
        function: lantern:::graphs:::GraphFunction~* = open->graph->functions[open->functionIndex];
        id: string! = lantern:::graphs:::AddNode(function, kind, f32(lantern:::graphs:::Snapped(centreX)), f32(lantern:::graphs:::Snapped(centreY)));
        if id.length() > 0 {
            lantern:::graphs:::SelectNode(open, id);
            open->Touch();
        }
        return id!;
    }

    // Counts up each time the canvas asks for its add-node menu (a right click on empty canvas, or a wire let go over nothing).
    export GraphMenuRequest :: (editorInstance: Editor*) -> u32 {
        guard open := editorInstance->graphEditor return 0;
        return open->menuRequest;
    }

    // The kinds that menu offers, one per line, most likely first, with a `-` line between the likely ones and the rest.
    export GraphMenuKinds :: (editorInstance: Editor*) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        function: lantern:::graphs:::GraphFunction* = open->graph->functions[open->functionIndex];
        return lantern:::graphs:::SuggestedKinds(function, open->menuSourceNode, open->menuSourceIsExecution);
    }

    // Adds a node of a kind where the menu was opened and wires it to the pin the menu came from. Returns its id.
    export GraphAddNodeFromMenu :: (editorInstance: Editor~*, kind: string) -> string! {
        guard open ~= editorInstance->graphEditor return "".copy();
        function: lantern:::graphs:::GraphFunction~* = open->graph->functions[open->functionIndex];
        if kind == "comment" {
            commentIndex: usize = lantern:::graphs:::AddComment(function, "Comment", lantern:::graphs:::Snapped(open->menuWorldX), lantern:::graphs:::Snapped(open->menuWorldY));
            delete open->selected;
            open->selected = "".copy();
            open->selectedComment = i32(commentIndex);
            open->Touch();
            return "comment".copy();
        }
        id: string! = lantern:::graphs:::AddMenuNode(function, kind, f32(lantern:::graphs:::Snapped(open->menuWorldX)), f32(lantern:::graphs:::Snapped(open->menuWorldY)));
        if id.length() > 0 {
            lantern:::graphs:::WireFromMenu(function, id, open->menuSourceNode, open->menuSourcePort, open->menuSourceIsExecution);
            lantern:::graphs:::SelectNode(open, id);
            open->Touch();
        }
        return id!;
    }

    // Which comment box is selected (its index), or -1.
    export GraphCommentIndex :: (editorInstance: Editor*) -> i32 {
        guard open := editorInstance->graphEditor return -1;
        function: lantern:::graphs:::GraphFunction* = open->Function();
        if open->selectedComment < 0 || usize(open->selectedComment) >= function->commentTexts.length() {
            return -1;
        }
        return open->selectedComment;
    }

    export GraphCommentText :: (editorInstance: Editor*) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        function: lantern:::graphs:::GraphFunction* = open->Function();
        if open->selectedComment < 0 || usize(open->selectedComment) >= function->commentTexts.length() {
            return "".copy();
        }
        return function->commentTexts[usize(open->selectedComment)].copy();
    }

    export GraphSetCommentText :: (editorInstance: Editor~*, text: string) -> void {
        guard open ~= editorInstance->graphEditor return;
        function: lantern:::graphs:::GraphFunction~* = open->graph->functions[open->functionIndex];
        if open->selectedComment < 0 || usize(open->selectedComment) >= function->commentTexts.length() {
            return;
        }
        index: usize = usize(open->selectedComment);
        removedText := function->commentTexts.remove(index);
        delete removedText;
        function->commentTexts.insert(index, text.copy());
        open->Touch();
    }

    // The open function's variables, one per line as `name<TAB>type<TAB>default`.
    export GraphVariables :: (editorInstance: Editor*) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        function: lantern:::graphs:::GraphFunction* = open->graph->functions[open->functionIndex];
        text~ string! = "".copy();
        for index~ usize = 0; index < function->variableNames.length(); index++ {
            text += function->variableNames[index];
            text += "\t";
            text += function->variableTypes[index];
            text += "\t";
            text += function->variableDefaults[index];
            text += "\n";
        }
        return text!;
    }

    // Adds a variable to the open function. An empty `initial` takes the type's default. Returns an error message or "".
    export GraphAddVariable :: (editorInstance: Editor~*, name: string, typeName: string, initial: string) -> string! {
        guard open ~= editorInstance->graphEditor return "No graph is open.".copy();
        function: lantern:::graphs:::GraphFunction~* = open->graph->functions[open->functionIndex];
        problem: string!? = lantern:::graphs:::AddVariable(function, name, typeName, initial);
        if problem != null {
            return ProblemText(problem!);
        }
        delete problem;
        open->Touch();
        return "".copy();
    }

    // Removes a variable and the get and set nodes that named it. Returns false when there is none by that name.
    export GraphRemoveVariable :: (editorInstance: Editor~*, name: string) -> bool {
        guard open ~= editorInstance->graphEditor return false;
        function: lantern:::graphs:::GraphFunction~* = open->graph->functions[open->functionIndex];
        removed: bool = lantern:::graphs:::RemoveVariable(function, name);
        if removed {
            open->selected = "".copy();
            open->Touch();
        }
        return removed;
    }

    // Adds a get or set node for a variable near the middle of what is showing and selects it. Returns its id.
    export GraphAddVariableNode :: (editorInstance: Editor~*, kind: string, name: string) -> string! {
        guard open ~= editorInstance->graphEditor return "".copy();
        centreX: i32 = open->WorldX(i32(editorInstance->graphCanvas->width / 2));
        centreY: i32 = open->WorldY(i32(editorInstance->graphCanvas->height / 2));
        function: lantern:::graphs:::GraphFunction~* = open->graph->functions[open->functionIndex];
        line: string! = `${kind} ${name}`;
        defer delete line;
        stagger: i32 = i32(function->nodes.length() % 4) * 40;
        id: string! = lantern:::graphs:::AddMenuNode(function, line, f32(lantern:::graphs:::Snapped(centreX + stagger)), f32(lantern:::graphs:::Snapped(centreY + stagger)));
        if id.length() > 0 {
            lantern:::graphs:::SelectNode(open, id);
            open->Touch();
        }
        return id!;
    }

    // The selected node's id, or "".
    export GraphSelected :: (editorInstance: Editor*) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        return open->selected.copy();
    }

    // One field of the selected node: `kind`, `name`, `type`, `function`, `text`, or a port (`a`, `b`, `value`, `condition`,
    // `next`, `then`, `else`, `arg0`...). A literal reads as `#` and its text.
    export GraphField :: (editorInstance: Editor*, field: string) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        function: lantern:::graphs:::GraphFunction* = open->Function();
        guard index := function->IndexOfNode(open->selected) return "".copy();
        node: lantern:::graphs:::GraphNode* = function->nodes[index];
        if field == "kind" {
            return node->kind.copy();
        }
        if field == "name" {
            return node->name.copy();
        }
        if field == "type" {
            return node->typeName.copy();
        }
        if field == "function" {
            return node->functionPath.copy();
        }
        if field == "text" {
            return node->text.copy();
        }
        return lantern:::graphs:::PortReference(node, field).copy();
    }

    // Sets one field of the selected node. Returns an error message or "".
    export GraphSetField :: (editorInstance: Editor~*, field: string, value: string) -> string! {
        guard open ~= editorInstance->graphEditor return "No graph is open.".copy();
        function: lantern:::graphs:::GraphFunction~* = open->graph->functions[open->functionIndex];
        selectedId: string! = open->selected.copy();
        defer delete selectedId;
        problem: string!? = lantern:::graphs:::SetPort(function, selectedId, field, value);
        if problem != null {
            return ProblemText(problem!);
        }
        delete problem;
        open->Touch();
        return "".copy();
    }

    // The Nyx the open graph generates, or a comment saying what stops it.
    export GraphNyx :: (editorInstance: Editor*) -> string! {
        guard open := editorInstance->graphEditor return "".copy();
        return lantern:::editorbackend:::GeneratedTextOf(editorInstance->backend->assetsDirectory, open->name, open->graph);
    }

    // Writes the graph and its Nyx. Returns an error message or "".
    export GraphSave :: (editorInstance: Editor~*) -> string! {
        result~ string! = SaveOpenGraph(editorInstance);
        if editorInstance->graphEditor != null && editorInstance->openGraphIsMaterial {
            editorInstance->backend->ForgetMaterials();
        }
        return result!;
    }

    SaveOpenGraph :: (editorInstance: Editor~*) -> string! {
        guard open ~= editorInstance->graphEditor return "No graph is open.".copy();
        editorInstance->openGraphIsMaterial = lantern:::editorbackend:::IsMaterialGraphName(open->name);
        problem: string!? = lantern:::editorbackend:::SaveGraphFiles(editorInstance->backend->assetsDirectory, open->name, open->graph);
        if problem != null {
            return ProblemText(problem!);
        }
        delete problem;
        open->isDirty = false;
        open->generation += 1;
        open->SetStatus("Saved.");
        return "".copy();
    }

}
