lantern:::editorapicopy :: foreign "c" {
    memcpy :: (destination: Array<u8~>, source: Array<u8>, byteCount: usize) -> raw u8~*;
}

lantern:::editorapi :: namespace {
    EditorBackend :: import lantern:::editorbackend:::EditorBackend;
    EditorSession :: import lantern:::editor:::EditorSession;
    OutlineRow :: import lantern:::editor:::OutlineRow;
    InspectorField :: import lantern:::editor:::InspectorField;

    FIELD_KEY: u32 : 0;
    FIELD_LABEL: u32 : 1;
    FIELD_GROUP: u32 : 2;
    FIELD_VALUE: u32 : 3;
    FIELD_KIND: u32 : 4;
    FIELD_MIXED: u32 : 5;

    TEMPLATE_ID: u32 : 0;
    TEMPLATE_LABEL: u32 : 1;
    TEMPLATE_KIND: u32 : 2;

    EntityKey :: (entity: i64) -> u64 {
        if entity < 0 {
            return 0;
        }
        return u64(entity);
    }

    EntityId :: (key: u64?) -> i64 {
        if found := key {
            return i64(found);
        }
        return 0;
    }

    BoolText :: (value: bool) -> string! {
        if value {
            return "true".copy();
        }
        return "false".copy();
    }

    CopyInto :: (source: Array<u8>, target: Array<u8~>) -> bool {
        if target.length() < source.length() {
            return false;
        }
        if source.length() == 0 {
            return true;
        }
        unsafe {
            lantern:::editorapicopy:::memcpy(target, source, source.length());
        }
        return true;
    }

    export Editor :: class {
    public:
        backend~ EditorBackend*!;
        apiStatus~ string!? = null;
        outline~ Array<OutlineRow*!>! = [];
        outlineRevision~ u64? = null;
        inspector~ Array<InspectorField*!>! = [];
        inspectorRevision~ u64? = null;
        thumbnailSide~ u32 = 0;

        Editor~: (assets: string, worldPath: string) {
            backend = new EditorBackend(assets, worldPath);
        }

        !Editor~: () {
            delete backend;
            delete apiStatus;
            outline.freeAll();
            inspector.freeAll();
        }

        Session :: () -> EditorSession~* {
            return backend->session;
        }

        ClearApiStatus~: () -> void {
            delete apiStatus;
            apiStatus = null;
        }

        ShowError~: (error: string!) -> void {
            if current := apiStatus {
                if current == error {
                    delete error;
                    return;
                }
            }
            delete apiStatus;
            apiStatus = error!;
        }

        RefreshOutline~: () -> void {
            revision: u64 = backend->session->UiRevision();
            if cached := outlineRevision {
                if cached == revision {
                    return;
                }
            }
            outline.freeAll();
            outline = backend->session->Outline();
            outlineRevision = revision;
        }

        RefreshInspector~: () -> void {
            revision: u64 = backend->session->UiRevision();
            if cached := inspectorRevision {
                if cached == revision {
                    return;
                }
            }
            inspector.freeAll();
            inspector = backend->session->Inspector();
            inspectorRevision = revision;
        }

        OutlineRowAt~: (row: u32) -> OutlineRow*? {
            RefreshOutline();
            if usize(row) >= outline.length() {
                return null;
            }
            return outline[usize(row)];
        }

        InspectorFieldAt~: (index: u32) -> InspectorField*? {
            RefreshInspector();
            if usize(index) >= inspector.length() {
                return null;
            }
            return inspector[usize(index)];
        }

        EntityText :: (entity: i64, wantKind: bool) -> string! {
            worldFile := backend->session->World();
            guard index := worldFile->IndexOf(EntityKey(entity)) return "".copy();
            if wantKind {
                return worldFile->entities[index]->kind.copy();
            }
            return worldFile->entities[index]->name.copy();
        }
    }

    export Create :: (assets: string, worldPath: string) -> Editor*! {
        return new Editor(assets, worldPath);
    }

    export Destroy :: (editorInstance: Editor*!) -> void {
        delete editorInstance;
    }

    export Revision :: (editorInstance: Editor*) -> u64 {
        extra: u64 = when (editorInstance->apiStatus == null) { true -> 0, false -> 1 };
        return editorInstance->backend->session->UiRevision() + extra;
    }

    export Status :: (editorInstance: Editor*) -> string! {
        if status := editorInstance->apiStatus {
            return status.copy();
        }
        return editorInstance->backend->session->status.copy();
    }

    export Title :: (editorInstance: Editor*) -> string! {
        return editorInstance->backend->session->Title();
    }

    export DocumentPath :: (editorInstance: Editor*) -> string! {
        if path := editorInstance->backend->session->document->path {
            return path.copy();
        }
        return "".copy();
    }

    export IsDirty :: (editorInstance: Editor*) -> bool {
        return editorInstance->backend->session->document->IsDirty();
    }

    export Open :: (editorInstance: Editor~*, path: string) -> bool {
        editorInstance->ClearApiStatus();
        return editorInstance->Session()->Load(path);
    }

    export Save :: (editorInstance: Editor~*) -> bool {
        editorInstance->ClearApiStatus();
        return editorInstance->Session()->Save();
    }

    export SaveAs :: (editorInstance: Editor~*, path: string) -> bool {
        editorInstance->ClearApiStatus();
        if path.trim().length() == 0 {
            return false;
        }
        return editorInstance->Session()->SaveAs(path);
    }

    export NewWorld :: (editorInstance: Editor~*, name: string) -> void {
        editorInstance->ClearApiStatus();
        if name.length() == 0 {
            editorInstance->Session()->NewWorld("untitled");
        } else {
            editorInstance->Session()->NewWorld(name);
        }
    }

    export Render :: (editorInstance: Editor~*, width: u32, height: u32) -> bool {
        failure: string!? = editorInstance->backend->Render(width, height);
        if problem := failure {
            editorInstance->ShowError(problem.copy());
            delete failure;
            return false;
        }
        return true;
    }

    export PixelWidth :: (editorInstance: Editor*) -> u32 {
        if editorInstance->backend->pixels.length() == 0 {
            return 0;
        }
        return editorInstance->backend->pixelWidth;
    }

    export PixelHeight :: (editorInstance: Editor*) -> u32 {
        if editorInstance->backend->pixels.length() == 0 {
            return 0;
        }
        return editorInstance->backend->pixelHeight;
    }

    export CopyPixels :: (editorInstance: Editor*, target: Array<u8~>) -> bool {
        return CopyInto(editorInstance->backend->pixels, target);
    }

    export PointerMove :: (editorInstance: Editor~*, x: f32, y: f32) -> void {
        editorInstance->Session()->PointerMoved(Vec2 { x: x, y: y });
    }

    export PointerButton :: (editorInstance: Editor~*, button: u32, down: bool, modifiers: u32) -> void {
        guard pressed := lantern:::editor:::PointerButtonAt(button) return;
        editorInstance->ClearApiStatus();
        editorInstance->Session()->SetPointerButton(pressed, down, lantern:::editor:::Modifiers:::FromBits(modifiers));
    }

    export Wheel :: (editorInstance: Editor~*, notches: f32) -> void {
        editorInstance->Session()->Wheel(notches);
    }

    export Key :: (editorInstance: Editor~*, keyName: string, down: bool, modifiers: u32) -> bool {
        guard editorKey := lantern:::editor:::EditorKey:::FromName(keyName) return false;
        return editorInstance->Session()->Key(editorKey, down, lantern:::editor:::Modifiers:::FromBits(modifiers));
    }

    export ReleaseKeys :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->ReleaseKeys();
    }

    export Update :: (editorInstance: Editor~*, seconds: f32) -> void {
        clamped~ f32 = seconds;
        if !(clamped >= 0.0f) {
            clamped = 0.0f;
        }
        if clamped > 0.25f {
            clamped = 0.25f;
        }
        editorInstance->Session()->Update(clamped);
        editorInstance->backend->PollPlay();
    }

    export FrameSelection :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->FrameSelection();
    }

    export SetTool :: (editorInstance: Editor~*, name: string) -> void {
        guard tool := lantern:::editor:::GizmoToolNamed(name) return;
        editorInstance->Session()->SetTool(tool);
    }

    export Tool :: (editorInstance: Editor*) -> string! {
        return lantern:::editor:::GizmoToolName(editorInstance->backend->session->tool).copy();
    }

    export SetSnap :: (editorInstance: Editor~*, enabled: bool) -> void {
        editorInstance->Session()->SetSnapEnabled(enabled);
    }

    export Snap :: (editorInstance: Editor*) -> bool {
        return editorInstance->backend->session->snap.enabled;
    }

    export OutlineCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->World()->entities.length());
    }

    export OutlineId :: (editorInstance: Editor~*, row: u32) -> i64 {
        guard found := editorInstance->OutlineRowAt(row) return 0;
        return i64(found->key);
    }

    export OutlineDepth :: (editorInstance: Editor~*, row: u32) -> u32 {
        guard found := editorInstance->OutlineRowAt(row) return 0;
        return found->depth;
    }

    export OutlineParent :: (editorInstance: Editor~*, row: u32) -> i64 {
        guard found := editorInstance->OutlineRowAt(row) return 0;
        return EntityId(found->parent);
    }

    export OutlineHasChildren :: (editorInstance: Editor~*, row: u32) -> bool {
        guard found := editorInstance->OutlineRowAt(row) return false;
        return found->hasChildren;
    }

    export EntityName :: (editorInstance: Editor*, entity: i64) -> string! {
        return editorInstance->EntityText(entity, false);
    }

    export EntityKind :: (editorInstance: Editor*, entity: i64) -> string! {
        return editorInstance->EntityText(entity, true);
    }

    export IsSelected :: (editorInstance: Editor*, entity: i64) -> bool {
        return editorInstance->backend->session->IsSelected(EntityKey(entity));
    }

    export Select :: (editorInstance: Editor~*, entity: i64, additive: bool) -> void {
        if additive {
            editorInstance->Session()->ToggleSelected(EntityKey(entity));
        } else {
            editorInstance->Session()->SelectOnly(EntityKey(entity));
        }
    }

    export ClearSelection :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->ClearSelection();
    }

    export PrimarySelection :: (editorInstance: Editor*) -> i64 {
        return EntityId(editorInstance->backend->session->PrimarySelection());
    }

    export SelectionCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->selection.length());
    }

    export FieldCount :: (editorInstance: Editor~*) -> u32 {
        editorInstance->RefreshInspector();
        return u32(editorInstance->inspector.length());
    }

    export Field :: (editorInstance: Editor~*, index: u32, part: u32) -> string! {
        guard field := editorInstance->InspectorFieldAt(index) return "".copy();
        if part == FIELD_KEY {
            return field->key.copy();
        }
        if part == FIELD_LABEL {
            return field->label.copy();
        }
        if part == FIELD_GROUP {
            return field->group.copy();
        }
        if part == FIELD_VALUE {
            return field->value.copy();
        }
        if part == FIELD_KIND {
            return lantern:::editor:::FieldKindName(field->kind).copy();
        }
        if part == FIELD_MIXED {
            return BoolText(field->mixed);
        }
        return "".copy();
    }

    export FieldChoiceCount :: (editorInstance: Editor~*, index: u32) -> u32 {
        guard field := editorInstance->InspectorFieldAt(index) return 0;
        return u32(field->choices.length());
    }

    export FieldChoice :: (editorInstance: Editor~*, index: u32, choice: u32) -> string! {
        guard field := editorInstance->InspectorFieldAt(index) return "".copy();
        if usize(choice) >= field->choices.length() {
            return "".copy();
        }
        return field->choices[usize(choice)].copy();
    }

    export SetField :: (editorInstance: Editor~*, entity: i64, field: string, text: string) -> bool {
        editorInstance->ClearApiStatus();
        return editorInstance->Session()->SetField(EntityKey(entity), field, text);
    }

    export CommitField :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->CommitField();
    }

    export TemplateCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->palette->templates.length());
    }

    export Template :: (editorInstance: Editor*, index: u32, part: u32) -> string! {
        templates: lantern:::editor:::Palette* = editorInstance->backend->session->palette;
        if usize(index) >= templates->templates.length() {
            return "".copy();
        }
        template: lantern:::editor:::EntityTemplate* = templates->templates[usize(index)];
        if part == TEMPLATE_ID {
            return template->id.copy();
        }
        if part == TEMPLATE_LABEL {
            return template->label.copy();
        }
        if part == TEMPLATE_KIND {
            return template->prototype->kind.copy();
        }
        return "".copy();
    }

    export AddEntity :: (editorInstance: Editor~*, templateId: string) -> i64 {
        editorInstance->ClearApiStatus();
        return EntityId(editorInstance->Session()->AddEntity(templateId, false));
    }

    export DeleteSelection :: (editorInstance: Editor~*) -> bool {
        return editorInstance->Session()->DeleteSelection();
    }

    export DuplicateSelection :: (editorInstance: Editor~*) -> bool {
        return editorInstance->Session()->DuplicateSelection();
    }

    export Undo :: (editorInstance: Editor~*) -> bool {
        editorInstance->ClearApiStatus();
        return editorInstance->Session()->Undo();
    }

    export Redo :: (editorInstance: Editor~*) -> bool {
        editorInstance->ClearApiStatus();
        return editorInstance->Session()->Redo();
    }

    export CanUndo :: (editorInstance: Editor*) -> bool {
        return editorInstance->backend->session->document->CanUndo();
    }

    export CanRedo :: (editorInstance: Editor*) -> bool {
        return editorInstance->backend->session->document->CanRedo();
    }

    export RecentFileCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->recentFiles.length());
    }

    export RecentFile :: (editorInstance: Editor*, index: u32) -> string! {
        files: EditorSession* = editorInstance->backend->session;
        if usize(index) >= files->recentFiles.length() {
            return "".copy();
        }
        return files->recentFiles[usize(index)].copy();
    }

    export Preference :: (editorInstance: Editor*, name: string) -> string! {
        if value := editorInstance->backend->preferences->Get(name) {
            return value.copy();
        }
        return "".copy();
    }

    export SetPreference :: (editorInstance: Editor~*, name: string, value: string) -> bool {
        return editorInstance->backend->preferences->Set(name, value);
    }

    export SavePreferences :: (editorInstance: Editor~*) -> bool {
        return editorInstance->backend->SavePreferences();
    }

    export AssetsDirectory :: (editorInstance: Editor*) -> string! {
        return editorInstance->backend->assetsDirectory.copy();
    }

    export SetSpace :: (editorInstance: Editor~*, name: string) -> void {
        guard space := lantern:::editor:::GizmoSpaceNamed(name) return;
        editorInstance->Session()->SetSpace(space);
    }

    export Space :: (editorInstance: Editor*) -> string! {
        return lantern:::editor:::GizmoSpaceName(editorInstance->backend->session->space).copy();
    }

    export SetPivotMode :: (editorInstance: Editor~*, name: string) -> void {
        guard mode := lantern:::editor:::PivotModeNamed(name) return;
        editorInstance->Session()->SetPivotMode(mode);
    }

    export PivotMode :: (editorInstance: Editor*) -> string! {
        return lantern:::editor:::PivotModeName(editorInstance->backend->session->pivotMode).copy();
    }

    export SetSnapStep :: (editorInstance: Editor~*, name: string, value: f32) -> bool {
        return editorInstance->Session()->SetSnapStep(name, value);
    }

    export SnapStep :: (editorInstance: Editor*, name: string) -> f32 {
        if value := editorInstance->backend->session->SnapStep(name) {
            return value;
        }
        return 0.0f;
    }

    export SetViewOption :: (editorInstance: Editor~*, name: string, value: string) -> bool {
        return editorInstance->Session()->SetViewOption(name, value);
    }

    export ViewOption :: (editorInstance: Editor*, name: string) -> string! {
        valueFound: string!? = editorInstance->backend->session->view.Get(name);
        if value := valueFound {
            copied: string! = value.copy();
            delete valueFound;
            return copied!;
        }
        return "".copy();
    }

    export HoveredHandle :: (editorInstance: Editor*) -> string! {
        if handle := editorInstance->backend->session->HoveredHandle() {
            return handle.Describe();
        }
        return "".copy();
    }

    export CameraPreset :: (editorInstance: Editor~*, name: string) -> bool {
        return editorInstance->Session()->CameraPreset(name);
    }

    export SetOrthographic :: (editorInstance: Editor~*, orthographic: bool) -> void {
        editorInstance->Session()->SetOrthographic(orthographic);
    }

    export IsOrthographic :: (editorInstance: Editor*) -> bool {
        return editorInstance->backend->session->camera.orthographic;
    }

    export CameraDescription :: (editorInstance: Editor*) -> string! {
        return editorInstance->backend->session->CameraDescription();
    }

    export FrameAll :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->FrameAll();
    }

    export SetBookmark :: (editorInstance: Editor~*, slot: u32) -> bool {
        return editorInstance->Session()->SetBookmark(usize(slot));
    }

    export GoToBookmark :: (editorInstance: Editor~*, slot: u32) -> bool {
        return editorInstance->Session()->GoToBookmark(usize(slot));
    }

    export HasBookmark :: (editorInstance: Editor*, slot: u32) -> bool {
        return editorInstance->backend->session->HasBookmark(usize(slot));
    }

    export AlignCameraToSelection :: (editorInstance: Editor~*) -> bool {
        return editorInstance->Session()->AlignCameraToSelection();
    }

    export AlignSelectionToCamera :: (editorInstance: Editor~*) -> bool {
        return editorInstance->Session()->AlignSelectionToCamera();
    }

    export EntityCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->World()->entities.length());
    }

    export IsHidden :: (editorInstance: Editor*, entity: i64) -> bool {
        return editorInstance->backend->session->IsHidden(EntityKey(entity));
    }

    export SetHidden :: (editorInstance: Editor~*, entity: i64, hidden: bool) -> void {
        editorInstance->Session()->SetHidden(EntityKey(entity), hidden);
    }

    export IsLocked :: (editorInstance: Editor*, entity: i64) -> bool {
        return editorInstance->backend->session->IsLocked(EntityKey(entity));
    }

    export SetLocked :: (editorInstance: Editor~*, entity: i64, locked: bool) -> void {
        editorInstance->Session()->SetLocked(EntityKey(entity), locked);
    }

    export HideSelection :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->HideSelection();
    }

    export UnhideAll :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->UnhideAll();
    }

    export LockSelection :: (editorInstance: Editor~*, locked: bool) -> void {
        editorInstance->Session()->LockSelection(locked);
    }

    export SelectAll :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->SelectAll();
    }

    export InvertSelection :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->InvertSelection();
    }

    export SelectKind :: (editorInstance: Editor~*, kind: string) -> void {
        editorInstance->Session()->SelectKind(kind);
    }

    export SelectChildren :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->SelectChildren();
    }

    export SetParent :: (editorInstance: Editor~*, child: i64, parent: i64) -> bool {
        editorInstance->Session()->CommitField();
        parentKey~ u64? = null;
        if parent > 0 {
            parentKey = EntityKey(parent);
        }
        return editorInstance->Session()->SetParent(EntityKey(child), parentKey);
    }

    export MoveBefore :: (editorInstance: Editor~*, child: i64, sibling: i64) -> bool {
        editorInstance->Session()->CommitField();
        siblingKey~ u64? = null;
        if sibling > 0 {
            siblingKey = EntityKey(sibling);
        }
        return editorInstance->Session()->MoveBefore(EntityKey(child), siblingKey);
    }

    export SetSelectionField :: (editorInstance: Editor~*, field: string, text: string) -> bool {
        return editorInstance->Session()->SetFieldOnSelection(field, text);
    }

    export RenameProperty :: (editorInstance: Editor~*, oldName: string, newName: string) -> bool {
        return editorInstance->Session()->RenameProperty(oldName, newName);
    }

    export AddEntityAtCursor :: (editorInstance: Editor~*, templateId: string) -> i64 {
        editorInstance->Session()->CommitField();
        return EntityId(editorInstance->Session()->AddEntity(templateId, true));
    }

    export DuplicateAlong :: (editorInstance: Editor~*, axisName: string) -> bool {
        guard axis := lantern:::editor:::AxisNamed(axisName) return false;
        return editorInstance->Session()->DuplicateSelectionAlong(axis);
    }

    export MirrorSelection :: (editorInstance: Editor~*, axisName: string) -> bool {
        guard axis := lantern:::editor:::AxisNamed(axisName) return false;
        return editorInstance->Session()->MirrorSelection(axis);
    }

    export SnapSelectionToGround :: (editorInstance: Editor~*) -> bool {
        return editorInstance->Session()->SnapSelectionToGround();
    }

    export GroupSelection :: (editorInstance: Editor~*) -> bool {
        return editorInstance->Session()->GroupSelection();
    }

    export AlignSelection :: (editorInstance: Editor~*, axisName: string) -> bool {
        guard axis := lantern:::editor:::AxisNamed(axisName) return false;
        return editorInstance->Session()->AlignSelection(axis);
    }

    export DistributeSelection :: (editorInstance: Editor~*, axisName: string) -> bool {
        guard axis := lantern:::editor:::AxisNamed(axisName) return false;
        return editorInstance->Session()->DistributeSelection(axis);
    }

    export RevertToTemplate :: (editorInstance: Editor~*) -> bool {
        return editorInstance->Session()->RevertSelectionToTemplate();
    }

    export ApplyToTemplate :: (editorInstance: Editor~*) -> bool {
        return editorInstance->Session()->ApplyPrimaryToTemplate();
    }

    export HistoryCount :: (editorInstance: Editor*) -> u32 {
        labels~ Array<string!>! = editorInstance->backend->session->document->HistoryLabels();
        count: u32 = u32(labels.length());
        labels.freeAll();
        return count;
    }

    export HistoryLabel :: (editorInstance: Editor*, index: u32) -> string! {
        labels~ Array<string!>! = editorInstance->backend->session->document->HistoryLabels();
        label~ string! = "".copy();
        if usize(index) < labels.length() {
            delete label;
            label = labels[usize(index)].copy();
        }
        labels.freeAll();
        return label!;
    }

    export HistoryPosition :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->document->HistoryPosition());
    }

    export JumpHistory :: (editorInstance: Editor~*, position: u32) -> bool {
        editorInstance->Session()->CommitField();
        return editorInstance->Session()->JumpHistory(usize(position));
    }

    export LogCount :: (editorInstance: Editor*) -> u32 {
        return u32(editorInstance->backend->session->log.length());
    }

    export LogText :: (editorInstance: Editor*, index: u32) -> string! {
        session: EditorSession* = editorInstance->backend->session;
        if usize(index) >= session->log.length() {
            return "".copy();
        }
        return session->log[usize(index)]->text.copy();
    }

    export LogLevel :: (editorInstance: Editor*, index: u32) -> string! {
        session: EditorSession* = editorInstance->backend->session;
        if usize(index) >= session->log.length() {
            return "".copy();
        }
        return lantern:::editor:::LogLevelName(session->log[usize(index)]->level).copy();
    }

    export ClearLog :: (editorInstance: Editor~*) -> void {
        editorInstance->Session()->ClearLog();
    }

    export Play :: (editorInstance: Editor~*) -> bool {
        return editorInstance->backend->StartPlay();
    }

    export StopPlay :: (editorInstance: Editor~*) -> bool {
        return editorInstance->backend->StopPlay();
    }

    export IsPlaying :: (editorInstance: Editor~*) -> bool {
        return editorInstance->backend->IsPlaying();
    }

    export Stat :: (editorInstance: Editor*, name: string) -> string! {
        if name == "entities" {
            return `${editorInstance->backend->session->World()->entities.length()}`;
        }
        if name == "selected" {
            return `${editorInstance->backend->session->selection.length()}`;
        }
        if name == "play_seconds" {
            return lantern:::core:::FixedDecimals(f64(editorInstance->backend->PlaySeconds()), 0, 0);
        }
        valueFound: string!? = editorInstance->backend->stats.Get(name);
        if value := valueFound {
            copied: string! = value.copy();
            delete valueFound;
            return copied!;
        }
        return "".copy();
    }

    export RenderPreview :: (editorInstance: Editor~*, templateId: string, width: u32, height: u32, spin: f32) -> bool {
        failure: string!? = editorInstance->backend->RenderTemplatePreview(templateId, width, height, spin);
        if problem := failure {
            editorInstance->ShowError(problem.copy());
            delete failure;
            return false;
        }
        return true;
    }

    export PreviewWidth :: (editorInstance: Editor*) -> u32 {
        if editorInstance->backend->previewPixels.length() == 0 {
            return 0;
        }
        return editorInstance->backend->previewWidth;
    }

    export PreviewHeight :: (editorInstance: Editor*) -> u32 {
        if editorInstance->backend->previewPixels.length() == 0 {
            return 0;
        }
        return editorInstance->backend->previewHeight;
    }

    export CopyPreviewPixels :: (editorInstance: Editor*, target: Array<u8~>) -> bool {
        return CopyInto(editorInstance->backend->previewPixels, target);
    }

    export Thumbnail :: (editorInstance: Editor~*, templateId: string, size: u32) -> u32 {
        failure: string!? = editorInstance->backend->RenderThumbnail(templateId, size);
        if problem := failure {
            editorInstance->ShowError(problem.copy());
            delete failure;
            return 0;
        }
        guard index := editorInstance->backend->ThumbnailIndex(templateId) return 0;
        return editorInstance->backend->thumbnails[index]->size;
    }

    export CopyThumbnailPixels :: (editorInstance: Editor*, templateId: string, target: Array<u8~>) -> bool {
        guard index := editorInstance->backend->ThumbnailIndex(templateId) return false;
        return CopyInto(editorInstance->backend->thumbnails[index]->pixels, target);
    }
}
