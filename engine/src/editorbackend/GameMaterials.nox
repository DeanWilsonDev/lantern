lantern:::editorbackend :: namespace {
    MATERIALS_NYX_FILE: string : "BakedMaterials.nyx";

    GameAssetsFolder :: (assetsDirectory: string) -> string!? {
        found: string!? = WorkspaceRoot(assetsDirectory);
        guard root := found return null;
        folder: string! = `${root}/games/platformer/game-assets`;
        delete found;
        if !directoryExists(folder) {
            delete folder;
            return null;
        }
        return folder!;
    }

    // Writes (or with `writeFiles` false only checks) `<outputFolder>/BakedMaterials.nyx` and each material graph's compiled
    // shader in `<outputFolder>/materials`. The Ok value is whether anything was out of date.
    BuildGameMaterials :: (assetsDirectory: string, outputFolder: string, writeFiles: bool) -> Result<bool, string!> {
        shaders~ Array<GeneratedMaterialShader*!>! = GenerateMaterialShaders(assetsDirectory);
        defer shaders.freeAll();
        shadersChanged~ bool = false;
        when BuildMaterialShaders(shaders, assetsDirectory, outputFolder, writeFiles) {
            Result:::Err(message) -> {
                return Result<bool, string!>:::Err(message!);
            },
            Result:::Ok(stale) -> {
                shadersChanged = stale;
            }
        }
        shaderLines: string! = MaterialShaderRegistrations(shaders);
        defer delete shaderLines;
        source: string! = lantern:::silhouette:::GenerateMaterialsNyx(assetsDirectory, shaderLines);
        defer delete source;
        when SyncOutput(outputFolder, MATERIALS_NYX_FILE, source, writeFiles) {
            Result:::Err(message) -> {
                return Result<bool, string!>:::Err(message!);
            },
            Result:::Ok(stale) -> {
                return Result<bool, string!>:::Ok(stale || shadersChanged);
            }
        }
    }

    // Rebuilds the game's baked materials when the game's folder is found beside the assets. Returns an error message, or null.
    RebuildGameMaterials :: (assetsDirectory: string) -> string!? {
        game: string!? = GameAssetsFolder(assetsDirectory);
        guard folder := game return null;
        defer delete game;
        when BuildGameMaterials(assetsDirectory, folder, true) {
            Result:::Err(message) -> {
                return message!;
            },
            Result:::Ok(changed) -> {
                return null;
            }
        }
    }
}
