lantern:::editorbackend :: namespace {
    // The editor's GPU side cache. Making a mesh or texture is slow, so each is made once and reused.
    // A shape's mesh that goes 600 frames (about ten seconds) without being drawn is released, so
    // resizing a box in the inspector does not leave a mesh behind for every size it passed through.
    UNUSED_FRAMES_BEFORE_RELEASE: u64 : 600;

    // A shape's mesh and the last frame it was used on. A shape is its size, so two entities with the
    // same shape share one mesh.
    CachedShapeMesh :: struct {
        shape~ lantern:::world:::Shape = lantern:::world:::Shape { };
        mesh~ lantern:::core:::Handle<lantern:::renderer:::MeshTag> = lantern:::core:::Handle<lantern:::renderer:::MeshTag> { };
        lastUsedFrame~ u64 = 0;
    }

    // The mesh of one marker kind (spawn, pickup and so on). There are few, so they are kept for good.
    CachedMarkerMesh :: struct {
        marker~ lantern:::editor:::MarkerMesh = lantern:::editor:::MarkerMesh:::Cube;
        mesh~ lantern:::core:::Handle<lantern:::renderer:::MeshTag> = lantern:::core:::Handle<lantern:::renderer:::MeshTag> { };
    }

    // A material name and its texture, or null when the texture could not be made. The failure is
    // kept too, so a missing file is reported once and not on every frame.
    CachedMaterial :: class {
    public:
        name~ string!;
        texture~ lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = null;
        look~ lantern:::renderer:::MaterialLook? = null;

        CachedMaterial~: (materialName: string, materialTexture: lantern:::core:::Handle<lantern:::renderer:::TextureTag>?, materialLook: lantern:::renderer:::MaterialLook?) {
            name = `${materialName}`;
            texture = materialTexture;
            look = materialLook;
        }

        !CachedMaterial~: () {
            delete name;
        }
    }

    // Compares floats by what they are, not by `==`: two not-a-numbers match, and 0 and -0 do not.
    // A cache must treat shapes as the same only when they would build the same mesh.
    SameFloatBits :: (left: f32, right: f32) -> bool {
        if left != right {
            return left != left && right != right;
        }
        if left == 0.0f {
            return (1.0f / left > 0.0f) == (1.0f / right > 0.0f);
        }
        return true;
    }

    // True when two shapes would build the same mesh: the same kind and the same size numbers.
    SameShape :: (left: lantern:::world:::Shape, right: lantern:::world:::Shape) -> bool {
        if left.kind != right.kind {
            return false;
        }
        if left.kind == lantern:::world:::ShapeKind:::Box {
            return SameFloatBits(left.halfExtents.x, right.halfExtents.x) && SameFloatBits(left.halfExtents.y, right.halfExtents.y) && SameFloatBits(left.halfExtents.z, right.halfExtents.z);
        }
        return SameFloatBits(left.width, right.width) && SameFloatBits(left.height, right.height) && SameFloatBits(left.length, right.length);
    }

    // Sends a mesh to the GPU. On failure it logs what was being uploaded and returns null, so one bad
    // mesh costs a missing object and not a crashed editor.
    UploadMesh :: (gpuRenderer: lantern:::gpu:::GpuRenderer~*, mesh: lantern:::renderer:::MeshData*, what: string) -> lantern:::core:::Handle<lantern:::renderer:::MeshTag>? {
        when gpuRenderer->CreateMesh(mesh) {
            Result:::Ok(handle) -> {
                return handle;
            },
            Result:::Err(failure) -> {
                message: string! = `uploading the ${what} mesh failed: ${failure}`;
                lantern:::core:::LogError("editor", message);
                delete message;
                delete failure;
                return null;
            }
        }
    }

    // The viewport's resources on a real GPU renderer: it implements the ViewportResources interface
    // the editor draws through, so the editor code never names the GPU. It holds the renderer, the
    // assets folder and the caches above, and the font atlas for text in the viewport.
    GpuViewportResources :: class {
        implements:
            lantern:::editor:::ViewportResources;
    public:
        viewportRenderer~ lantern:::gpu:::GpuRenderer*!;
        assetsDirectory~ string!;
        shapes~ Array<CachedShapeMesh>! = [];
        markers~ Array<CachedMarkerMesh>! = [];
        materials~ Array<CachedMaterial*!>! = [];
        frame~ u64 = 0;
        fontAtlas~ lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = null;
        fontAtlasFailed~ bool = false;

        GpuViewportResources~: (gpuRenderer: lantern:::gpu:::GpuRenderer*!, assets: string) {
            viewportRenderer = gpuRenderer!;
            assetsDirectory = `${assets}`;
        }

        !GpuViewportResources~: () {
            delete shapes;
            delete markers;
            materials.freeAll();
            delete assetsDirectory;
            delete viewportRenderer;
        }

        // Called once per frame: counts the frame and releases shape meshes unused for a long time.
        Prepare~: () -> void {
            frame += 1;
            kept~ Array<CachedShapeMesh>! = [];
            for cached in shapes {
                if frame - cached.lastUsedFrame < UNUSED_FRAMES_BEFORE_RELEASE {
                    kept.push(cached);
                } else {
                    viewportRenderer->RemoveMesh(cached.mesh);
                }
            }
            delete shapes;
            shapes = kept!;
        }

        // The mesh for a shape, making and caching it on first use. Null if the upload failed.
        ShapeMesh~: (shape: lantern:::world:::Shape) -> lantern:::core:::Handle<lantern:::renderer:::MeshTag>? {
            for index~ usize = 0; index < shapes.length(); index++ {
                if SameShape(shapes[index].shape, shape) {
                    shapes[index].lastUsedFrame = frame;
                    return shapes[index].mesh;
                }
            }
            data := lantern:::world:::ShapeMesh(shape);
            uploaded: lantern:::core:::Handle<lantern:::renderer:::MeshTag>? = UploadMesh(viewportRenderer, data, "shape");
            delete data;
            guard mesh := uploaded return null;
            shapes.push(CachedShapeMesh { shape: shape, mesh: mesh, lastUsedFrame: frame });
            return mesh;
        }

        // The texture of the built-in font, for the viewport's overlay text (the view cube). It is made on
        // first use; if that fails it is logged once and the text is skipped from then on.
        FontTexture~: () -> lantern:::core:::Handle<lantern:::renderer:::TextureTag>? {
            if fontAtlas != null || fontAtlasFailed {
                return fontAtlas;
            }
            atlas := lantern:::renderer:::FontAtlas();
            defer delete atlas;
            when viewportRenderer->CreateTexture(atlas) {
                Result:::Ok(texture) -> {
                    fontAtlas = texture;
                },
                Result:::Err(message) -> {
                    fontAtlasFailed = true;
                    lantern:::core:::LogWarn("editor", message);
                    delete message;
                }
            }
            return fontAtlas;
        }

        // The texture for a material name, loaded from `textures/NAME.png` in the assets folder. A missing
        // or unreadable file falls back to a grey checker with a warning, so the entity is still visible. No
        // material gives null (untextured).
        MaterialLook~: (material: string?) -> lantern:::renderer:::MaterialLook? {
            guard name := material return null;
            MaterialTexture(material);
            for cached in materials {
                if cached->name == name {
                    return cached->look;
                }
            }
            return null;
        }

        MaterialTexture~: (material: string?) -> lantern:::core:::Handle<lantern:::renderer:::TextureTag>? {
            guard name := material return null;
            for cached in materials {
                if cached->name == name {
                    return cached->texture;
                }
            }
            textureName~ string! = name.copy();
            look~ lantern:::renderer:::MaterialLook? = null;
            loadedDefinition: lantern:::silhouette:::MaterialDefinition*!? = lantern:::silhouette:::LoadMaterialSilhouette(assetsDirectory, name);
            if definition := loadedDefinition {
                delete textureName;
                textureName = definition->texture.copy();
                look = definition->Look();
            }
            delete loadedDefinition;
            if textureName.length() == 0 {
                delete textureName;
                materials.push(new CachedMaterial(name, null, look));
                return null;
            }
            path: string! = `${assetsDirectory}/textures/${textureName}.png`;
            delete textureName;
            data~ lantern:::renderer:::TextureData*!? = null;
            when lantern:::renderer:::TextureData:::LoadPng(path) {
                Result:::Ok(loaded) -> {
                    data = loaded!;
                },
                Result:::Err(failure) -> {
                    message: string! = `material '${name}': ${failure}; using a checker`;
                    lantern:::core:::LogWarn("editor", message);
                    delete message;
                    delete failure;
                    data = lantern:::renderer:::TextureData:::Checker(64, 8, lantern:::core:::Color:::Rgb(0.8f, 0.8f, 0.8f), lantern:::core:::Color:::Rgb(0.55f, 0.55f, 0.6f));
                }
            }
            delete path;
            texture~ lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = null;
            if loadedData := data {
                when viewportRenderer->CreateTexture(loadedData) {
                    Result:::Ok(handle) -> {
                        texture = handle;
                    },
                    Result:::Err(failure) -> {
                        message: string! = `uploading '${name}' failed: ${failure}`;
                        lantern:::core:::LogError("editor", message);
                        delete message;
                        delete failure;
                    }
                }
            }
            delete data;
            materials.push(new CachedMaterial(name, texture, look));
            return texture;
        }

        // The mesh for a marker kind, made on first use. A plane marker has no mesh (it is drawn as lines).
        MarkerMeshHandle~: (marker: lantern:::editor:::MarkerMesh) -> lantern:::core:::Handle<lantern:::renderer:::MeshTag>? {
            if marker == lantern:::editor:::MarkerMesh:::Plane {
                return null;
            }
            for cached in markers {
                if cached.marker == marker {
                    return cached.mesh;
                }
            }
            data := MarkerMeshData(marker);
            uploaded: lantern:::core:::Handle<lantern:::renderer:::MeshTag>? = UploadMesh(viewportRenderer, data, "marker");
            delete data;
            guard mesh := uploaded return null;
            markers.push(CachedMarkerMesh { marker: marker, mesh: mesh });
            return mesh;
        }

        // Builds a marker kind's mesh data: a sphere, a capsule the height of a character, the gem model
        // (or a generated gem when `models/gem.glb` cannot be loaded), otherwise a small cube.
        MarkerMeshData :: (marker: lantern:::editor:::MarkerMesh) -> lantern:::renderer:::MeshData*! {
            if marker == lantern:::editor:::MarkerMesh:::Sphere {
                return lantern:::renderer:::Sphere(0.3f, 16, 8);
            }
            if marker == lantern:::editor:::MarkerMesh:::Capsule {
                return lantern:::renderer:::Capsule(0.35f, 0.55f, 16, 8);
            }
            if marker == lantern:::editor:::MarkerMesh:::Gem {
                path: string! = `${assetsDirectory}/models/gem.glb`;
                defer delete path;
                when lantern:::renderer:::LoadGltfMesh(path) {
                    Result:::Ok(model) -> {
                        return model!;
                    },
                    Result:::Err(failure) -> {
                        message: string! = `gem model: ${failure}; using the generated gem`;
                        lantern:::core:::LogWarn("editor", message);
                        delete message;
                        delete failure;
                        return lantern:::renderer:::Gem(0.3f, 0.8f);
                    }
                }
            }
            return lantern:::renderer:::Cube(0.6f);
        }
    }
}
