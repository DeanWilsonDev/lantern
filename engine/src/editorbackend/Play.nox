Sdl :: import Sdl;

lantern:::processenvironment :: foreign "SDL3" {
    SDL_SetPointerProperty :: (properties: Sdl:::SDL_PropertiesID, name: string, value: raw Sdl:::SDL_Environment~*) -> bool;
}

lantern:::editorbackend :: namespace {
    Sdl :: import Sdl;

    // Play in editor runs the real game in a separate process. The editor saves the level being edited
    // to this scratch file and starts the game runner on it, so the game loads exactly what is on screen
    // without touching the file the person is editing. GAME_DIRECTORY is where the platformer lives
    // in the repository.
    SCRATCH_LEVEL_FILE: string : ".editor-play.world.json";
    ERROR_FILE: string : ".editor-play.error.txt";
    GAME_DIRECTORY: string : "games/platformer";

    // The argument list of the game process as SDL wants it: a C array of C strings ending in a null
    // pointer. The three fields sit side by side in memory so a pointer to the struct reads as that array.
    ProcessArguments :: struct {
        program~ raw u8~* = null;
        gameDirectory~ raw u8~* = null;
        terminator~ raw u8~* = null;
    }

    // True on Windows, asked of SDL. Only the runner's file name differs (lantern.exe).
    RunningOnWindows :: () -> bool {
        platformName~ string! = "".copy();
        unsafe {
            delete platformName;
            platformName = copyCString(Sdl:::SDL_GetPlatform());
        }
        windows: bool = platformName == "Windows";
        delete platformName;
        return windows;
    }

    // The game runner's file name for this platform.
    RunnerFileName :: () -> string {
        return when RunningOnWindows() { true -> "lantern.exe", false -> "lantern" };
    }

    // The folder above a path: trailing slashes are dropped, then everything from the last separator
    // on. A path with no separator gives ".".
    ParentDirectory :: (path: string) -> string! {
        trimmed~ string! = `${path}`;
        while trimmed.length() > 1 && (trimmed.endsWith("/") || trimmed.endsWith("\\")) {
            shorter: string! = trimmed.substring(0, trimmed.length() - 1).copy();
            delete trimmed;
            trimmed = shorter!;
        }
        separator: usize? = lantern:::editor:::LastSeparator(trimmed);
        if position := separator {
            parent: string! = trimmed.substring(0, position).copy();
            delete trimmed;
            return parent!;
        }
        delete trimmed;
        return ".".copy();
    }

    // The repository root when the assets folder sits inside a checkout, found by looking for
    // `engine/nox.json` next to the assets folder. Null for an installed editor with no checkout beside it.
    WorkspaceRoot :: (assetsDirectory: string) -> string!? {
        parent: string! = ParentDirectory(assetsDirectory);
        marker: string! = `${parent}/engine/nox.json`;
        found: bool = pathExists(marker);
        delete marker;
        if !found {
            delete parent;
            return null;
        }
        return parent!;
    }

    // Finds the game runner to start, trying in order: the LANTERN_RUNNER environment variable, a
    // `lantern` program beside the editor, then the build folder of a checkout (`engine/build`). Null
    // when none exists, which the editor reports as "no runner found".
    ChooseRunner :: (assetsDirectory: string) -> string!? {
        explicit: string!? = environmentVariable("LANTERN_RUNNER");
        if text := explicit {
            if text.length() > 0 {
                return explicit!;
            }
        }
        delete explicit;
        basePath~ string! = "".copy();
        unsafe {
            delete basePath;
            basePath = copyCString(Sdl:::SDL_GetBasePath());
        }
        sibling: string! = `${basePath}${RunnerFileName()}`;
        delete basePath;
        if pathExists(sibling) {
            return sibling!;
        }
        delete sibling;
        workspace: string!? = WorkspaceRoot(assetsDirectory);
        guard root := workspace return null;
        built: string! = `${root}/engine/build/${RunnerFileName()}`;
        delete workspace;
        if pathExists(built) {
            return built!;
        }
        delete built;
        return null;
    }

    // The game's folder: inside the checkout when there is one, else next to the assets folder.
    GameDirectoryFor :: (assetsDirectory: string) -> string! {
        workspace: string!? = WorkspaceRoot(assetsDirectory);
        if root := workspace {
            directory: string! = `${root}/${GAME_DIRECTORY}`;
            delete workspace;
            return directory!;
        }
        return `${assetsDirectory}/../${GAME_DIRECTORY}`;
    }

    // A running game process started by the editor. It remembers the process, the scratch level it was
    // started on and when it started. Dropping it frees the process handle.
    PlaySession :: class {
    public:
        process~ raw Sdl:::SDL_Process~* = null;
        levelPath~ string!;
        startedTicks~ u64 = 0;

        PlaySession~: (runningProcess: raw Sdl:::SDL_Process~*, scratchLevel: string) {
            process = runningProcess;
            levelPath = `${scratchLevel}`;
            unsafe {
                startedTicks = Sdl:::SDL_GetTicks();
            }
        }

        !PlaySession~: () {
            unsafe {
                if process != null {
                    Sdl:::SDL_DestroyProcess(process);
                }
            }
            delete levelPath;
        }

        // How long the game has been running, in seconds.
        Seconds :: () -> f32 {
            now~ u64 = 0;
            unsafe {
                now = Sdl:::SDL_GetTicks();
            }
            return f32(now - startedTicks) / 1000.0f;
        }

        // Stops the game process and waits for it to go away. Used when the person presses Stop.
        Kill~: () -> void {
            exitCode~ i32 = 0;
            unsafe {
                if process != null {
                    Sdl:::SDL_KillProcess(process, true);
                    Sdl:::SDL_WaitProcess(process, true, exitCode);
                }
            }
        }

        // Checks without waiting whether the game has exited: null while it still runs, else its exit code.
        Finished~: () -> i32? {
            exitCode~ i32 = 0;
            finished~ bool = false;
            unsafe {
                if process != null {
                    finished = Sdl:::SDL_WaitProcess(process, false, exitCode);
                }
            }
            if !finished {
                return null;
            }
            return exitCode;
        }
    }

    // Starts the game runner as a child process in `gameDirectory`. LANTERN_LEVEL names the level to
    // load and LANTERN_ASSETS the assets folder, both passed through a fresh copy of the environment so
    // the editor's own is left alone. The game has no input (stdin is null) and writes to the editor's
    // console. Returns null if the process could not start. The strings given to SDL are freed once the
    // process has been created.
    SpawnRunner :: (runner: string, gameDirectory: string, levelAssetPath: string, assetsDirectory: string, errorFilePath: string) -> raw Sdl:::SDL_Process~* {
        arguments~ ProcessArguments = ProcessArguments { };
        process~ raw Sdl:::SDL_Process~* = null;
        unsafe {
            environment: raw Sdl:::SDL_Environment~* = Sdl:::SDL_CreateEnvironment(true);
            Sdl:::SDL_SetEnvironmentVariable(environment, "LANTERN_LEVEL", levelAssetPath, true);
            Sdl:::SDL_SetEnvironmentVariable(environment, "LANTERN_ASSETS", assetsDirectory, true);
            Sdl:::SDL_SetEnvironmentVariable(environment, "LANTERN_ERROR_FILE", errorFilePath, true);
            arguments.program = Sdl:::SDL_strdup(runner);
            arguments.gameDirectory = Sdl:::SDL_strdup(gameDirectory);
            properties: Sdl:::SDL_PropertiesID = Sdl:::SDL_CreateProperties();
            argumentBytes: u8~* = reinterpret<u8>(arguments);
            Sdl:::SDL_SetPointerProperty(properties, Sdl:::SDL_PROP_PROCESS_CREATE_ARGS_POINTER, argumentBytes);
            lantern:::processenvironment:::SDL_SetPointerProperty(properties, Sdl:::SDL_PROP_PROCESS_CREATE_ENVIRONMENT_POINTER, environment);
            Sdl:::SDL_SetNumberProperty(properties, Sdl:::SDL_PROP_PROCESS_CREATE_STDIN_NUMBER, i64(Sdl:::SDL_PROCESS_STDIO_NULL));
            Sdl:::SDL_SetNumberProperty(properties, Sdl:::SDL_PROP_PROCESS_CREATE_STDOUT_NUMBER, i64(Sdl:::SDL_PROCESS_STDIO_INHERITED));
            Sdl:::SDL_SetNumberProperty(properties, Sdl:::SDL_PROP_PROCESS_CREATE_STDERR_NUMBER, i64(Sdl:::SDL_PROCESS_STDIO_INHERITED));
            process = Sdl:::SDL_CreateProcessWithProperties(properties);
            Sdl:::SDL_DestroyProperties(properties);
            Sdl:::SDL_DestroyEnvironment(environment);
            Sdl:::SDL_free(arguments.program);
            Sdl:::SDL_free(arguments.gameDirectory);
        }
        return process;
    }
}
