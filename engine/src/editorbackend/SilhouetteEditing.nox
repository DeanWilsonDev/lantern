lantern:::editorbackend :: namespace {
    // Edits a Silhouette's files for the editor's Silhouette tab. Each function returns an error message,
    // or null when it worked, and the caller reloads the Silhouette's palette template afterwards.
    // A component is named by its dotted path inside the Silhouette: `lamp` is the file `lamp.calamus` in the
    // Silhouette's folder, and `pole.lamp` is `pole/lamp.calamus`.

    SILHOUETTE_FILE_EXTENSION: string : ".calamus";
    SILHOUETTE_ROOT_FILE: string : "root.calamus";

    // The folder of one Silhouette.
    SilhouetteFolderOf :: (assetsDirectory: string, silhouetteName: string) -> string! {
        return `${assetsDirectory}/${SILHOUETTES_FOLDER}/${silhouetteName}`;
    }

    // The path of a component without its extension: the folder holding its children.
    ComponentStem :: (silhouetteFolder: string, componentPath: string) -> string! {
        slashed: string! = componentPath.replace(".", "/");
        defer delete slashed;
        return `${silhouetteFolder}/${slashed}`;
    }

    // The file of a component: `root.calamus` for the root (an empty path), else its stem plus the extension.
    ComponentFile :: (silhouetteFolder: string, componentPath: string) -> string! {
        if componentPath.length() == 0 {
            return `${silhouetteFolder}/${SILHOUETTE_ROOT_FILE}`;
        }
        stem: string! = ComponentStem(silhouetteFolder, componentPath);
        defer delete stem;
        return `${stem}${SILHOUETTE_FILE_EXTENSION}`;
    }

    // True when a component has a file of its own, which a component inherited from a base does not.
    ComponentHasFile :: (silhouetteFolder: string, componentPath: string) -> bool {
        file: string! = ComponentFile(silhouetteFolder, componentPath);
        defer delete file;
        return pathExists(file);
    }

    // A name a component can take: not empty, and with nothing that would break out of its quotes.
    NameIsUsable :: (name: string) -> bool {
        if name.trim().length() == 0 {
            return false;
        }
        return !name.contains("\"") && !name.contains("\\") && !name.contains("\n");
    }

    // Removes a file, or says why not.
    RemoveFileText :: (path: string) -> string!? {
        when removeFile(path) {
            Result:::Ok(removed) -> {
                return null;
            },
            Result:::Err(error) -> {
                failure: string! = `${path}: ${error.message()}`;
                delete error;
                return failure!;
            }
        }
    }

    // Removes a folder and everything in it.
    RemoveTree :: (directory: string) -> string!? {
        when lantern:::silhouette:::SortedEntries(directory) {
            Result:::Err(message) -> {
                return message!;
            },
            Result:::Ok(listed) -> {
                entries~ Array<string!>! = listed!;
                for entry in entries {
                    child: string! = `${directory}/${entry}`;
                    problem~ string!? = null;
                    if directoryExists(child) {
                        problem = RemoveTree(child);
                    } else {
                        problem = RemoveFileText(child);
                    }
                    delete child;
                    if problem != null {
                        entries.freeAll();
                        return problem!;
                    }
                }
                entries.freeAll();
            }
        }
        when removeDirectory(directory) {
            Result:::Ok(removed) -> {
                return null;
            },
            Result:::Err(error) -> {
                failure: string! = `${directory}: ${error.message()}`;
                delete error;
                return failure!;
            }
        }
    }

    // Writes a file, or says why not.
    WriteFileText :: (path: string, text: string) -> string!? {
        when writeTextFile(path, text) {
            Result:::Ok(written) -> {
                return null;
            },
            Result:::Err(error) -> {
                failure: string! = `${path}: ${error.message()}`;
                delete error;
                return failure!;
            }
        }
    }

    // Adds a new child of `kind` under the component at `parentPath` (empty for the root). It gets the first
    // free name from the kind: `block`, `block2`, `block3`... Returns an error message or null.
    AddSilhouetteChild :: (assetsDirectory: string, silhouetteName: string, parentPath: string, kind: string) -> string!? {
        if !NameIsUsable(kind) {
            return "A child needs a kind.".copy();
        }
        silhouetteFolder: string! = SilhouetteFolderOf(assetsDirectory, silhouetteName);
        defer delete silhouetteFolder;
        if !directoryExists(silhouetteFolder) {
            return `No Silhouette folder ${silhouetteFolder}.`.copy();
        }
        if !ComponentHasFile(silhouetteFolder, parentPath) {
            return "That component comes from the base Silhouette, so it can't hold new children here.".copy();
        }
        childFolder~ string! = `${silhouetteFolder}`;
        if parentPath.length() > 0 {
            delete childFolder;
            childFolder = ComponentStem(silhouetteFolder, parentPath);
        }
        defer delete childFolder;
        when createDirectories(childFolder) {
            Result:::Ok(created) -> { },
            Result:::Err(error) -> {
                failure: string! = `${childFolder}: ${error.message()}`;
                delete error;
                return failure!;
            }
        }
        childName~ string! = `${kind}`;
        defer delete childName;
        number~ u32 = 1;
        while true {
            candidate: string! = `${childFolder}/${childName}${SILHOUETTE_FILE_EXTENSION}`;
            taken~ bool = pathExists(candidate);
            delete candidate;
            candidateFolder: string! = `${childFolder}/${childName}`;
            taken = taken || pathExists(candidateFolder);
            delete candidateFolder;
            if !taken {
                break;
            }
            number += 1;
            next: string! = `${kind}${number}`;
            delete childName;
            childName = next!;
        }
        text~ string! = "@version 1\n".copy();
        text += "@type ";
        text += kind;
        text += "\n\n  name : \"";
        text += childName;
        text += "\"\n";
        text += "  transform:\n";
        text += "    position : [0.0, 0.0, 0.0]\n";
        file: string! = `${childFolder}/${childName}${SILHOUETTE_FILE_EXTENSION}`;
        problem: string!? = WriteFileText(file, text);
        delete file;
        delete text;
        return problem!;
    }

    // Gives the component at `componentPath` a new `name` value, rewriting that one line of its file. A file with
    // an `@base` line sets its name through a marked value, which this doesn't edit yet.
    RenameSilhouetteComponent :: (assetsDirectory: string, silhouetteName: string, componentPath: string, newName: string) -> string!? {
        if !NameIsUsable(newName) {
            return "A name can't be empty or hold quotes or line breaks.".copy();
        }
        silhouetteFolder: string! = SilhouetteFolderOf(assetsDirectory, silhouetteName);
        defer delete silhouetteFolder;
        if !ComponentHasFile(silhouetteFolder, componentPath) {
            return "That component comes from the base Silhouette, so it can't be renamed here.".copy();
        }
        file: string! = ComponentFile(silhouetteFolder, componentPath);
        defer delete file;
        when readTextFile(file) {
            Result:::Err(error) -> {
                failure: string! = `${file}: ${error.message()}`;
                delete error;
                return failure!;
            },
            Result:::Ok(original) -> {
                defer delete original;
                lines := original.lines();
                defer delete lines;
                rewritten~ string! = "".copy();
                changed~ bool = false;
                for line in lines {
                    if line.startsWith("@base") {
                        delete rewritten;
                        return "This Silhouette is a variant, and a variant's own values can't be renamed here yet.".copy();
                    }
                    isNameLine: bool = line.startsWith("  name :") || line.startsWith("  name:") || line.startsWith("* name :");
                    if isNameLine && !changed {
                        rewritten += "  name : \"";
                        rewritten += newName;
                        rewritten += "\"\n";
                        changed = true;
                    } else {
                        rewritten += line;
                        rewritten += "\n";
                    }
                }
                if !changed {
                    delete rewritten;
                    return "That file has no name line to change.".copy();
                }
                problem: string!? = WriteFileText(file, rewritten);
                delete rewritten;
                return problem!;
            }
        }
    }

    // Deletes a component and everything under it. The root can't be deleted, and nor can a component the
    // Silhouette gets from its base.
    DeleteSilhouetteComponent :: (assetsDirectory: string, silhouetteName: string, componentPath: string) -> string!? {
        if componentPath.length() == 0 {
            return "The root can't be deleted; delete the Silhouette instead.".copy();
        }
        silhouetteFolder: string! = SilhouetteFolderOf(assetsDirectory, silhouetteName);
        defer delete silhouetteFolder;
        if !ComponentHasFile(silhouetteFolder, componentPath) {
            return "That component comes from the base Silhouette, so it can't be deleted here.".copy();
        }
        stem: string! = ComponentStem(silhouetteFolder, componentPath);
        defer delete stem;
        if directoryExists(stem) {
            problem: string!? = RemoveTree(stem);
            if problem != null {
                return problem!;
            }
        }
        file: string! = ComponentFile(silhouetteFolder, componentPath);
        defer delete file;
        return RemoveFileText(file);
    }

    // A Silhouette's folder name: letters, digits and underscores only, so it is also a safe id and file name.
    SilhouetteNameIsUsable :: (name: string) -> bool {
        if name.length() == 0 {
            return false;
        }
        for index~ usize = 0; index < name.length(); index++ {
            character: u8 = name.byteAt(index);
            isLower: bool = character >= 97 && character <= 122;
            isDigit: bool = character >= 48 && character <= 57;
            if !isLower && !isDigit && character != 95 {
                return false;
            }
        }
        return true;
    }

    // Writes a new Silhouette's root file in a new folder. Returns an error message or null.
    WriteNewSilhouette :: (assetsDirectory: string, silhouetteName: string, rootText: string) -> string!? {
        if !SilhouetteNameIsUsable(silhouetteName) {
            return "A Silhouette's name can only hold lowercase letters, digits and underscores.".copy();
        }
        silhouetteFolder: string! = SilhouetteFolderOf(assetsDirectory, silhouetteName);
        defer delete silhouetteFolder;
        if pathExists(silhouetteFolder) {
            return "A Silhouette with that name already exists.".copy();
        }
        when createDirectories(silhouetteFolder) {
            Result:::Ok(created) -> { },
            Result:::Err(error) -> {
                failure: string! = `${silhouetteFolder}: ${error.message()}`;
                delete error;
                return failure!;
            }
        }
        file: string! = ComponentFile(silhouetteFolder, "");
        problem: string!? = WriteFileText(file, rootText);
        delete file;
        return problem!;
    }

    // Creates an empty Silhouette: one entity of `kind`, labelled with its name.
    CreateSilhouette :: (assetsDirectory: string, silhouetteName: string, kind: string) -> string!? {
        if !NameIsUsable(kind) {
            return "A Silhouette needs a kind.".copy();
        }
        text~ string! = "@version 1\n@type ".copy();
        text += kind;
        text += "\n\n  name : \"";
        text += silhouetteName;
        text += "\"\n  transform:\n    position : [0.0, 0.0, 0.0]\n  editor:\n    label : \"";
        text += silhouetteName;
        text += "\"\n";
        problem: string!? = WriteNewSilhouette(assetsDirectory, silhouetteName, text);
        delete text;
        return problem!;
    }

    // Derives a variant of `baseName`: a new Silhouette whose root has the base as its `@base` and sets only its name and
    // menu label (marked, with the base's values beside them). `baseKind`, `baseEntityName` and `baseLabel` are the base
    // root's kind, name and menu label.
    DeriveSilhouette :: (assetsDirectory: string, baseName: string, silhouetteName: string, baseKind: string, baseEntityName: string, baseLabel: string) -> string!? {
        text~ string! = "@version 1\n@type ".copy();
        text += baseKind;
        text += "\n@base \"";
        text += SILHOUETTES_FOLDER;
        text += "/";
        text += baseName;
        text += "\"\n\n* name : \"";
        text += silhouetteName;
        text += "\" | \"";
        text += baseEntityName;
        text += "\"\n* editor:\n*   label : \"";
        text += silhouetteName;
        text += "\" | \"";
        text += baseLabel;
        text += "\"\n";
        problem: string!? = WriteNewSilhouette(assetsDirectory, silhouetteName, text);
        delete text;
        return problem!;
    }

    // The last name in a dotted path, and everything before it ("" when there is one name).
    LastSegment :: (componentPath: string) -> string! {
        dot: usize? = componentPath.lastIndexOf(".");
        if position := dot {
            return `${componentPath.substring(position + 1, componentPath.length() - position - 1)}`;
        }
        return componentPath.copy();
    }

    ParentPathOf :: (componentPath: string) -> string! {
        dot: usize? = componentPath.lastIndexOf(".");
        if position := dot {
            return `${componentPath.substring(0, position)}`;
        }
        return "".copy();
    }

    // The folder that holds a component's children: the Silhouette's own folder for the root.
    ChildrenFolder :: (silhouetteFolder: string, componentPath: string) -> string! {
        if componentPath.length() == 0 {
            return `${silhouetteFolder}`;
        }
        return ComponentStem(silhouetteFolder, componentPath);
    }

    // Moves a component, and everything under it, to hang from another component. `newParentPath` is empty for the root.
    // The component keeps its name and its place in the files only changes.
    MoveSilhouetteComponent :: (assetsDirectory: string, silhouetteName: string, componentPath: string, newParentPath: string) -> string!? {
        if componentPath.length() == 0 {
            return "The root can't be moved.".copy();
        }
        descendantPrefix: string! = `${componentPath}.`;
        defer delete descendantPrefix;
        if newParentPath == componentPath || newParentPath.startsWith(descendantPrefix) {
            return "A component can't go under itself.".copy();
        }
        silhouetteFolder: string! = SilhouetteFolderOf(assetsDirectory, silhouetteName);
        defer delete silhouetteFolder;
        if !ComponentHasFile(silhouetteFolder, componentPath) || !ComponentHasFile(silhouetteFolder, newParentPath) {
            return "Both components have to be the Silhouette's own, not inherited from a base.".copy();
        }
        currentParent: string! = ParentPathOf(componentPath);
        defer delete currentParent;
        if currentParent == newParentPath {
            return "It already hangs from there.".copy();
        }
        childName: string! = LastSegment(componentPath);
        defer delete childName;
        targetFolder: string! = ChildrenFolder(silhouetteFolder, newParentPath);
        defer delete targetFolder;
        targetFile: string! = `${targetFolder}/${childName}${SILHOUETTE_FILE_EXTENSION}`;
        defer delete targetFile;
        targetStem: string! = `${targetFolder}/${childName}`;
        defer delete targetStem;
        if pathExists(targetFile) || pathExists(targetStem) {
            return `That component already has a child called ${childName}.`.copy();
        }
        when createDirectories(targetFolder) {
            Result:::Ok(created) -> { },
            Result:::Err(error) -> {
                failure: string! = `${targetFolder}: ${error.message()}`;
                delete error;
                return failure!;
            }
        }
        sourceFile: string! = ComponentFile(silhouetteFolder, componentPath);
        defer delete sourceFile;
        sourceStem: string! = ComponentStem(silhouetteFolder, componentPath);
        defer delete sourceStem;
        when renameFile(sourceFile, targetFile) {
            Result:::Ok(moved) -> { },
            Result:::Err(error) -> {
                failure: string! = `${sourceFile}: ${error.message()}`;
                delete error;
                return failure!;
            }
        }
        if directoryExists(sourceStem) {
            when renameFile(sourceStem, targetStem) {
                Result:::Ok(moved) -> { },
                Result:::Err(error) -> {
                    failure: string! = `${sourceStem}: ${error.message()}`;
                    delete error;
                    return failure!;
                }
            }
        }
        return null;
    }

    // Points a variant at another Silhouette as its base by rewriting the `@base` line of its root file. If the result
    // doesn't resolve (a missing Silhouette, or a cycle), the file is put back and the reason returned.
    SetSilhouetteBase :: (assetsDirectory: string, silhouetteName: string, newBase: string) -> string!? {
        if newBase == silhouetteName {
            return "A Silhouette can't be its own base.".copy();
        }
        silhouetteFolder: string! = SilhouetteFolderOf(assetsDirectory, silhouetteName);
        defer delete silhouetteFolder;
        file: string! = ComponentFile(silhouetteFolder, "");
        defer delete file;
        baseFolder: string! = SilhouetteFolderOf(assetsDirectory, newBase);
        defer delete baseFolder;
        if !directoryExists(baseFolder) {
            return "There is no Silhouette with that name.".copy();
        }
        when readTextFile(file) {
            Result:::Err(error) -> {
                failure: string! = `${file}: ${error.message()}`;
                delete error;
                return failure!;
            },
            Result:::Ok(original) -> {
                defer delete original;
                lines := original.lines();
                defer delete lines;
                rewritten~ string! = "".copy();
                changed~ bool = false;
                for line in lines {
                    if line.startsWith("@base") && !line.startsWith("@base_hash") {
                        rewritten += "@base \"";
                        rewritten += SILHOUETTES_FOLDER;
                        rewritten += "/";
                        rewritten += newBase;
                        rewritten += "\"\n";
                        changed = true;
                    } else if !line.startsWith("@base_hash") {
                        rewritten += line;
                        rewritten += "\n";
                    }
                }
                if !changed {
                    delete rewritten;
                    return "Only a variant has a base to change.".copy();
                }
                writeProblem: string!? = WriteFileText(file, rewritten);
                delete rewritten;
                if writeProblem != null {
                    return writeProblem!;
                }
                library := new lantern:::silhouette:::SilhouetteLibrary(assetsDirectory);
                defer delete library;
                resolvedName: string! = `${SILHOUETTES_FOLDER}/${silhouetteName}`;
                defer delete resolvedName;
                when library->Resolve(resolvedName) {
                    Result:::Ok(resolved) -> {
                        delete resolved;
                        return null;
                    },
                    Result:::Err(message) -> {
                        restoreProblem: string!? = WriteFileText(file, original);
                        delete restoreProblem;
                        return message!;
                    }
                }
            }
        }
    }

    // True when any file of another Silhouette names this one (as a base, or as the base of a child).
    SilhouetteIsUsed :: (assetsDirectory: string, silhouetteName: string) -> bool {
        folder: string! = `${assetsDirectory}/${SILHOUETTES_FOLDER}`;
        defer delete folder;
        needle: string! = `"${SILHOUETTES_FOLDER}/${silhouetteName}"`;
        defer delete needle;
        when lantern:::silhouette:::SortedEntries(folder) {
            Result:::Err(message) -> {
                delete message;
                return false;
            },
            Result:::Ok(listed) -> {
                names~ Array<string!>! = listed!;
                used~ bool = false;
                for name in names {
                    if name != silhouetteName && !used {
                        entryFolder: string! = `${folder}/${name}`;
                        used = FolderMentions(entryFolder, needle);
                        delete entryFolder;
                    }
                }
                names.freeAll();
                return used;
            }
        }
    }

    FolderMentions :: (directory: string, needle: string) -> bool {
        when lantern:::silhouette:::SortedEntries(directory) {
            Result:::Err(message) -> {
                delete message;
                return false;
            },
            Result:::Ok(listed) -> {
                entries~ Array<string!>! = listed!;
                found~ bool = false;
                for entry in entries {
                    if !found {
                        child: string! = `${directory}/${entry}`;
                        if directoryExists(child) {
                            found = FolderMentions(child, needle);
                        } else if entry.endsWith(SILHOUETTE_FILE_EXTENSION) {
                            when readTextFile(child) {
                                Result:::Err(error) -> {
                                    delete error;
                                },
                                Result:::Ok(text) -> {
                                    found = text.contains(needle);
                                    delete text;
                                }
                            }
                        }
                        delete child;
                    }
                }
                entries.freeAll();
                return found;
            }
        }
    }

    // The text of a file with every occurrence of `oldNeedle` replaced by `newNeedle`, and no `@base_hash` line (a changed base
    // path makes the old hash stale, as in SetSilhouetteBase).
    RewrittenBaseText :: (original: string, oldNeedle: string, newNeedle: string) -> string! {
        lines := original.lines();
        defer delete lines;
        rewritten~ string! = "".copy();
        for line in lines {
            if !line.startsWith("@base_hash") {
                rewritten += line.replace(oldNeedle, newNeedle);
                rewritten += "\n";
            }
        }
        return rewritten!;
    }

    // Rewrites every file under a folder that mentions `oldNeedle`. Returns an error message or null.
    RewriteFolderMentions :: (directory: string, oldNeedle: string, newNeedle: string) -> string!? {
        when lantern:::silhouette:::SortedEntries(directory) {
            Result:::Err(message) -> {
                return message!;
            },
            Result:::Ok(listed) -> {
                entries~ Array<string!>! = listed!;
                defer entries.freeAll();
                for entry in entries {
                    child: string! = `${directory}/${entry}`;
                    defer delete child;
                    if directoryExists(child) {
                        problem: string!? = RewriteFolderMentions(child, oldNeedle, newNeedle);
                        if problem != null {
                            return problem!;
                        }
                    } else if entry.endsWith(SILHOUETTE_FILE_EXTENSION) {
                        when readTextFile(child) {
                            Result:::Err(error) -> {
                                failure: string! = `${child}: ${error.message()}`;
                                delete error;
                                return failure!;
                            },
                            Result:::Ok(text) -> {
                                defer delete text;
                                if text.contains(oldNeedle) {
                                    rewritten: string! = RewrittenBaseText(text, oldNeedle, newNeedle);
                                    writeProblem: string!? = WriteFileText(child, rewritten);
                                    delete rewritten;
                                    if writeProblem != null {
                                        return writeProblem!;
                                    }
                                }
                            }
                        }
                    }
                }
                return null;
            }
        }
    }

    // The names of the other Silhouettes with a file that names this one.
    SilhouettesUsing :: (assetsDirectory: string, silhouetteName: string) -> Array<string!>! {
        users~ Array<string!>! = [];
        folder: string! = `${assetsDirectory}/${SILHOUETTES_FOLDER}`;
        defer delete folder;
        needle: string! = `"${SILHOUETTES_FOLDER}/${silhouetteName}"`;
        defer delete needle;
        when lantern:::silhouette:::SortedEntries(folder) {
            Result:::Err(message) -> {
                delete message;
            },
            Result:::Ok(listed) -> {
                names~ Array<string!>! = listed!;
                for name in names {
                    if name != silhouetteName {
                        entryFolder: string! = `${folder}/${name}`;
                        if FolderMentions(entryFolder, needle) {
                            users.push(`${name}`);
                        }
                        delete entryFolder;
                    }
                }
                names.freeAll();
            }
        }
        return users!;
    }

    // Renames a whole Silhouette: its folder, and the `@base` line of every Silhouette made from it. Nothing is changed when the
    // new name is taken or unusable. Returns an error message or null.
    RenameSilhouette :: (assetsDirectory: string, silhouetteName: string, newName: string) -> string!? {
        if !SilhouetteNameIsUsable(silhouetteName) {
            return "No such Silhouette.".copy();
        }
        if !SilhouetteNameIsUsable(newName) {
            return "A Silhouette's name can only hold lowercase letters, digits and underscores.".copy();
        }
        if newName == silhouetteName {
            return "That is already its name.".copy();
        }
        silhouetteFolder: string! = SilhouetteFolderOf(assetsDirectory, silhouetteName);
        defer delete silhouetteFolder;
        if !directoryExists(silhouetteFolder) {
            return "No such Silhouette.".copy();
        }
        newFolder: string! = SilhouetteFolderOf(assetsDirectory, newName);
        defer delete newFolder;
        if pathExists(newFolder) {
            return "A Silhouette with that name already exists.".copy();
        }
        oldNeedle: string! = `"${SILHOUETTES_FOLDER}/${silhouetteName}"`;
        defer delete oldNeedle;
        newNeedle: string! = `"${SILHOUETTES_FOLDER}/${newName}"`;
        defer delete newNeedle;
        users~ Array<string!>! = SilhouettesUsing(assetsDirectory, silhouetteName);
        defer users.freeAll();
        for user in users {
            userFolder: string! = SilhouetteFolderOf(assetsDirectory, user);
            problem: string!? = RewriteFolderMentions(userFolder, oldNeedle, newNeedle);
            delete userFolder;
            if problem != null {
                return problem!;
            }
        }
        when renameFile(silhouetteFolder, newFolder) {
            Result:::Ok(moved) -> { },
            Result:::Err(error) -> {
                failure: string! = `${silhouetteFolder}: ${error.message()}`;
                delete error;
                return failure!;
            }
        }
        library := new lantern:::silhouette:::SilhouetteLibrary(assetsDirectory);
        defer delete library;
        for user in users {
            resolvedName: string! = `${SILHOUETTES_FOLDER}/${user}`;
            when library->Resolve(resolvedName) {
                Result:::Ok(resolved) -> {
                    delete resolved;
                },
                Result:::Err(message) -> {
                    delete resolvedName;
                    return message!;
                }
            }
            delete resolvedName;
        }
        return null;
    }

    // Deletes a whole Silhouette folder, unless another Silhouette is made from it.
    DeleteSilhouette :: (assetsDirectory: string, silhouetteName: string) -> string!? {
        if !SilhouetteNameIsUsable(silhouetteName) {
            return "No such Silhouette.".copy();
        }
        silhouetteFolder: string! = SilhouetteFolderOf(assetsDirectory, silhouetteName);
        defer delete silhouetteFolder;
        if !directoryExists(silhouetteFolder) {
            return "No such Silhouette.".copy();
        }
        if SilhouetteIsUsed(assetsDirectory, silhouetteName) {
            return "Another Silhouette is made from this one, so it can't be deleted.".copy();
        }
        return RemoveTree(silhouetteFolder);
    }

    // Reads a Silhouette's folder again and replaces its palette template, so the editor shows what the files say now.
    // Returns an error message or null.
    RefreshSilhouetteTemplate :: (palette: lantern:::editor:::Palette~*, assetsDirectory: string, silhouetteName: string) -> string!? {
        library := new lantern:::silhouette:::SilhouetteLibrary(assetsDirectory);
        defer delete library;
        when SilhouetteTemplate(library, assetsDirectory, silhouetteName) {
            Result:::Err(message) -> {
                return message!;
            },
            Result:::Ok(template) -> {
                palette->AddTemplate(template!);
                return null;
            }
        }
    }
}
