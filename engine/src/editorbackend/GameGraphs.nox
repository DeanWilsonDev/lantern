lantern:::editorbackend :: namespace {
    // Turns a game's graphs into the Nyx it imports: every `<graphsFolder>/<name>.graph.json` becomes
    // `<outputFolder>/<Name>.nyx` (`crumble_phase` is `CrumblePhase.nyx`), every Silhouette with a graph
    // (`<graphsFolder>/../assets/silhouettes/<name>/graph.json`) becomes its behaviour class (`<Name>Behaviour.nyx`), and
    // `GraphBehaviours.nyx` lets the game make the behaviour of a placed Silhouette by its name.
    BEHAVIOURS_FILE: string : "GraphBehaviours.nyx";

    GeneratedFileName :: (graphName: string) -> string! {
        namespaceName: string! = lantern:::graphs:::NamespaceName(graphName);
        name: string! = `${namespaceName}.nyx`;
        delete namespaceName;
        return name!;
    }

    // The Nyx of one graph file, or the problem naming the file.
    GenerateGameGraph :: (graphFile: string) -> Result<string!, string!> {
        when readTextFile(graphFile) {
            Result:::Err(error) -> {
                failure: string! = `${graphFile}: ${error.message()}`;
                delete error;
                return Result<string!, string!>:::Err(failure!);
            },
            Result:::Ok(text) -> {
                defer delete text;
                when lantern:::graphs:::GenerateNyxFromText(text) {
                    Result:::Err(message) -> {
                        failure: string! = `${graphFile}: ${message}`;
                        delete message;
                        return Result<string!, string!>:::Err(failure!);
                    },
                    Result:::Ok(source) -> {
                        return Result<string!, string!>:::Ok(source!);
                    }
                }
            }
        }
    }

    // Where a game's Silhouettes are, from its graphs folder: both sit in the game's folder.
    SilhouettesFolderOf :: (graphsFolder: string) -> string! {
        return `${graphsFolder}/../assets/silhouettes`;
    }

    // Writes `source` to `<outputFolder>/<fileName>` when it differs (or only reports that it differs when `writeFiles` is false).
    // The Ok value is whether the file was out of date.
    SyncOutput :: (outputFolder: string, fileName: string, source: string, writeFiles: bool) -> Result<bool, string!> {
        outputFile: string! = `${outputFolder}/${fileName}`;
        defer delete outputFile;
        current~ string! = "".copy();
        defer delete current;
        when readTextFile(outputFile) {
            Result:::Err(error) -> { delete error; },
            Result:::Ok(existing) -> {
                delete current;
                current = existing!;
            }
        }
        if current == source {
            return Result<bool, string!>:::Ok(false);
        }
        if writeFiles {
            problem: string!? = WriteFileText(outputFile, source);
            if failed := problem {
                message: string! = failed.copy();
                delete problem;
                return Result<bool, string!>:::Err(message!);
            }
            delete problem;
        }
        return Result<bool, string!>:::Ok(true);
    }

    // Generates every graph in `graphsFolder` into `outputFolder`. With `writeFiles` false nothing is written, and the Ok text
    // lists the files that differ from what is on disk, one per line (empty when every file is current).
    BuildGameGraphs :: (graphsFolder: string, outputFolder: string, writeFiles: bool) -> Result<string!, string!> {
        stale~ string! = "".copy();
        if !directoryExists(graphsFolder) {
            return Result<string!, string!>:::Ok(stale!);
        }
        if writeFiles {
            when createDirectories(outputFolder) {
                Result:::Ok(created) -> { },
                Result:::Err(error) -> {
                    failure: string! = `${outputFolder}: ${error.message()}`;
                    delete error;
                    delete stale;
                    return Result<string!, string!>:::Err(failure!);
                }
            }
        }
        branches~ string! = "".copy();
        imports~ string! = "".copy();
        when lantern:::silhouette:::SortedEntries(graphsFolder) {
            Result:::Err(message) -> {
                delete stale;
                delete branches;
                delete imports;
                return Result<string!, string!>:::Err(message!);
            },
            Result:::Ok(listed) -> {
                entries~ Array<string!>! = listed!;
                for entry in entries {
                    if !entry.endsWith(".graph.json") {
                        continue;
                    }
                    graphName: string = entry.substring(0, entry.length() - ".graph.json".length());
                    graphFile: string! = `${graphsFolder}/${entry}`;
                    when GenerateGameGraph(graphFile) {
                        Result:::Err(message) -> {
                            delete graphFile;
                            delete stale;
                            delete branches;
                            delete imports;
                            entries.freeAll();
                            return Result<string!, string!>:::Err(message!);
                        },
                        Result:::Ok(source) -> {
                            fileName: string! = GeneratedFileName(graphName);
                            when SyncOutput(outputFolder, fileName, source, writeFiles) {
                                Result:::Err(message) -> {
                                    delete fileName;
                                    delete source;
                                    delete graphFile;
                                    delete stale;
                                    delete branches;
                                    delete imports;
                                    entries.freeAll();
                                    return Result<string!, string!>:::Err(message!);
                                },
                                Result:::Ok(changed) -> {
                                    if changed {
                                        if stale.length() > 0 {
                                            stale += "\n";
                                        }
                                        stale += fileName;
                                    }
                                }
                            }
                            delete fileName;
                            delete source;
                        }
                    }
                    delete graphFile;
                }
                entries.freeAll();
            }
        }
        silhouettesFolder: string! = SilhouettesFolderOf(graphsFolder);
        defer delete silhouettesFolder;
        if directoryExists(silhouettesFolder) {
            when lantern:::silhouette:::SortedEntries(silhouettesFolder) {
                Result:::Err(message) -> {
                    delete stale;
                    delete branches;
                    delete imports;
                    return Result<string!, string!>:::Err(message!);
                },
                Result:::Ok(listed) -> {
                    silhouetteNames~ Array<string!>! = listed!;
                    for silhouetteName in silhouetteNames {
                        graphFile: string! = `${silhouettesFolder}/${silhouetteName}/graph.json`;
                        if !pathExists(graphFile) {
                            delete graphFile;
                            continue;
                        }
                        when GenerateGameGraph(graphFile) {
                            Result:::Err(message) -> {
                                delete graphFile;
                                delete stale;
                                delete branches;
                                delete imports;
                                silhouetteNames.freeAll();
                                return Result<string!, string!>:::Err(message!);
                            },
                            Result:::Ok(source) -> {
                                className: string! = lantern:::graphs:::BehaviourClassName(silhouetteName);
                                classLine: string! = `${className} :: class : SilhouetteBehaviour {`;
                                isBehaviour: bool = source.contains(classLine);
                                delete classLine;
                                if !isBehaviour {
                                    failure: string! = `${graphFile}: a Silhouette's graph needs at least one event`;
                                    delete className;
                                    delete source;
                                    delete graphFile;
                                    delete stale;
                                    delete branches;
                                    delete imports;
                                    silhouetteNames.freeAll();
                                    return Result<string!, string!>:::Err(failure!);
                                }
                                fileName: string! = `${className}.nyx`;
                                when SyncOutput(outputFolder, fileName, source, writeFiles) {
                                    Result:::Err(message) -> {
                                        delete fileName;
                                        delete className;
                                        delete source;
                                        delete graphFile;
                                        delete stale;
                                        delete branches;
                                        delete imports;
                                        silhouetteNames.freeAll();
                                        return Result<string!, string!>:::Err(message!);
                                    },
                                    Result:::Ok(changed) -> {
                                        if changed {
                                            if stale.length() > 0 {
                                                stale += "\n";
                                            }
                                            stale += fileName;
                                        }
                                    }
                                }
                                imports += `${className} :: import ${className};`;
                                imports += "\n";
                                branches += `        if silhouette == "${silhouetteName}" {`;
                                branches += "\n";
                                branches += `            return new ${className}(entity);`;
                                branches += "\n";
                                branches += "        }\n";
                                delete fileName;
                                delete className;
                                delete source;
                            }
                        }
                        delete graphFile;
                    }
                    silhouetteNames.freeAll();
                }
            }
        }
        behaviours~ string! = "// Generated by lantern:::editorbackend from the game's Silhouette graphs. Edit the graphs, not this file.\n".copy();
        behaviours += "SilhouetteBehaviour :: import SilhouetteBehaviour;\n";
        behaviours += imports;
        behaviours += "GraphBehaviours :: namespace {\n";
        behaviours += "    // The behaviour of a placed Silhouette, made from its graph, or null when its Silhouette has no graph.\n";
        behaviours += "    Create :: (silhouette: string, entity: i64) -> SilhouetteBehaviour? {\n";
        behaviours += branches;
        behaviours += "        return null;\n";
        behaviours += "    }\n";
        behaviours += "}\n";
        delete branches;
        delete imports;
        when SyncOutput(outputFolder, BEHAVIOURS_FILE, behaviours, writeFiles) {
            Result:::Err(message) -> {
                delete behaviours;
                delete stale;
                return Result<string!, string!>:::Err(message!);
            },
            Result:::Ok(changed) -> {
                if changed {
                    if stale.length() > 0 {
                        stale += "\n";
                    }
                    stale += BEHAVIOURS_FILE;
                }
            }
        }
        delete behaviours;
        return Result<string!, string!>:::Ok(stale!);
    }
}
