lantern:::editorbackend :: namespace {
    // Turns a game's graphs into the Nyx it imports: every `<graphsFolder>/<name>.graph.json` becomes
    // `<outputFolder>/<Name>.nyx` (`crumble_phase` is `CrumblePhase.nyx`), and `GraphBehaviours.nyx` lets the game run a
    // graph's behaviour function by name. A behaviour function is `Update :: (entity: i64, time: f32) -> void`.
    BEHAVIOURS_FILE: string : "GraphBehaviours.nyx";

    GeneratedFileName :: (graphName: string) -> string! {
        namespaceName: string! = lantern:::graphs:::NamespaceName(graphName);
        name: string! = `${namespaceName}.nyx`;
        delete namespaceName;
        return name!;
    }

    // The Nyx of one graph file, or the problem naming the file.
    GenerateGameGraph :: (graphFile: string) -> Result<string!, string!> {
        when readTextFile(graphFile) {
            Result:::Err(error) -> {
                failure: string! = `${graphFile}: ${error.message()}`;
                delete error;
                return Result<string!, string!>:::Err(failure!);
            },
            Result:::Ok(text) -> {
                defer delete text;
                when lantern:::graphs:::GenerateNyxFromText(text) {
                    Result:::Err(message) -> {
                        failure: string! = `${graphFile}: ${message}`;
                        delete message;
                        return Result<string!, string!>:::Err(failure!);
                    },
                    Result:::Ok(source) -> {
                        return Result<string!, string!>:::Ok(source!);
                    }
                }
            }
        }
    }

    // The `GraphBehaviours.Run` branches for the behaviour functions of one graph file.
    BehaviourBranches :: (graphFile: string) -> string! {
        branches~ string! = "".copy();
        when readTextFile(graphFile) {
            Result:::Err(error) -> {
                delete error;
            },
            Result:::Ok(text) -> {
                defer delete text;
                when lantern:::graphs:::LoadGraph(text) {
                    Result:::Err(message) -> {
                        delete message;
                    },
                    Result:::Ok(graph) -> {
                        namespaceName: string! = lantern:::graphs:::NamespaceName(graph->name);
                        for index~ usize = 0; index < graph->functions.length(); index++ {
                            function: lantern:::graphs:::GraphFunction* = graph->functions[index];
                            isVoid: bool = function->returns.length() == 0 || function->returns == "void";
                            if isVoid && function->inputNames.length() == 2 && function->inputNames[0] == "entity" && function->inputTypes[0] == "i64"
                                && function->inputNames[1] == "time" && function->inputTypes[1] == "f32" {
                                branches += `        if graph == "${graph->name}" && function == "${function->name}" {`;
                                branches += "\n";
                                branches += `            ${namespaceName}:::${function->name}(entity, time);`;
                                branches += "\n";
                                branches += "            return true;\n";
                                branches += "        }\n";
                            }
                        }
                        delete namespaceName;
                        delete graph;
                    }
                }
            }
        }
        return branches!;
    }

    // Writes `source` to `<outputFolder>/<fileName>` when it differs (or only reports that it differs when `writeFiles` is false).
    // The Ok value is whether the file was out of date.
    SyncOutput :: (outputFolder: string, fileName: string, source: string, writeFiles: bool) -> Result<bool, string!> {
        outputFile: string! = `${outputFolder}/${fileName}`;
        defer delete outputFile;
        current~ string! = "".copy();
        defer delete current;
        when readTextFile(outputFile) {
            Result:::Err(error) -> { delete error; },
            Result:::Ok(existing) -> {
                delete current;
                current = existing!;
            }
        }
        if current == source {
            return Result<bool, string!>:::Ok(false);
        }
        if writeFiles {
            problem: string!? = WriteFileText(outputFile, source);
            if failed := problem {
                message: string! = failed.copy();
                delete problem;
                return Result<bool, string!>:::Err(message!);
            }
            delete problem;
        }
        return Result<bool, string!>:::Ok(true);
    }

    // Generates every graph in `graphsFolder` into `outputFolder`. With `writeFiles` false nothing is written, and the Ok text
    // lists the files that differ from what is on disk, one per line (empty when every file is current).
    BuildGameGraphs :: (graphsFolder: string, outputFolder: string, writeFiles: bool) -> Result<string!, string!> {
        stale~ string! = "".copy();
        if !directoryExists(graphsFolder) {
            return Result<string!, string!>:::Ok(stale!);
        }
        if writeFiles {
            when createDirectories(outputFolder) {
                Result:::Ok(created) -> { },
                Result:::Err(error) -> {
                    failure: string! = `${outputFolder}: ${error.message()}`;
                    delete error;
                    delete stale;
                    return Result<string!, string!>:::Err(failure!);
                }
            }
        }
        branches~ string! = "".copy();
        imports~ string! = "".copy();
        when lantern:::silhouette:::SortedEntries(graphsFolder) {
            Result:::Err(message) -> {
                delete stale;
                delete branches;
                delete imports;
                return Result<string!, string!>:::Err(message!);
            },
            Result:::Ok(listed) -> {
                entries~ Array<string!>! = listed!;
                for entry in entries {
                    if !entry.endsWith(".graph.json") {
                        continue;
                    }
                    graphName: string = entry.substring(0, entry.length() - ".graph.json".length());
                    graphFile: string! = `${graphsFolder}/${entry}`;
                    when GenerateGameGraph(graphFile) {
                        Result:::Err(message) -> {
                            delete graphFile;
                            delete stale;
                            delete branches;
                            delete imports;
                            entries.freeAll();
                            return Result<string!, string!>:::Err(message!);
                        },
                        Result:::Ok(source) -> {
                            fileName: string! = GeneratedFileName(graphName);
                            when SyncOutput(outputFolder, fileName, source, writeFiles) {
                                Result:::Err(message) -> {
                                    delete fileName;
                                    delete source;
                                    delete graphFile;
                                    delete stale;
                                    delete branches;
                                    delete imports;
                                    entries.freeAll();
                                    return Result<string!, string!>:::Err(message!);
                                },
                                Result:::Ok(changed) -> {
                                    if changed {
                                        if stale.length() > 0 {
                                            stale += "\n";
                                        }
                                        stale += fileName;
                                    }
                                }
                            }
                            delete fileName;
                            delete source;
                            piece: string! = BehaviourBranches(graphFile);
                            if piece.length() > 0 {
                                namespaceName: string! = lantern:::graphs:::NamespaceName(graphName);
                                imports += `${namespaceName} :: import ${namespaceName};`;
                                imports += "\n";
                                delete namespaceName;
                            }
                            branches += piece;
                            delete piece;
                        }
                    }
                    delete graphFile;
                }
                entries.freeAll();
            }
        }
        behaviours~ string! = "// Generated by lantern:::editorbackend from the game's graphs. Edit the graphs, not this file.\n".copy();
        behaviours += imports;
        behaviours += "GraphBehaviours :: namespace {\n";
        behaviours += "    // Runs a graph's behaviour function by name. False when no graph has one with that name.\n";
        behaviours += "    Run :: (graph: string, function: string, entity: i64, time: f32) -> bool {\n";
        behaviours += branches;
        behaviours += "        return false;\n";
        behaviours += "    }\n";
        behaviours += "}\n";
        delete branches;
        delete imports;
        when SyncOutput(outputFolder, BEHAVIOURS_FILE, behaviours, writeFiles) {
            Result:::Err(message) -> {
                delete behaviours;
                delete stale;
                return Result<string!, string!>:::Err(message!);
            },
            Result:::Ok(changed) -> {
                if changed {
                    if stale.length() > 0 {
                        stale += "\n";
                    }
                    stale += BEHAVIOURS_FILE;
                }
            }
        }
        delete behaviours;
        return Result<string!, string!>:::Ok(stale!);
    }
}
