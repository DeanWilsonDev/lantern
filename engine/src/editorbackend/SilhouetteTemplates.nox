lantern:::editorbackend :: namespace {
    // The palette file lists what the editor can place, and a game's Silhouettes are things it can place
    // too. This reads every Silhouette folder under `<assets>/silhouettes` and adds one template for each,
    // named after the folder. A Silhouette's `editor` values (`label` for the menu and `lift` for how far
    // to raise it off the surface) are read from its root and are not part of the entity itself. A
    // Silhouette that fails to resolve is logged and left out; the rest still load.
    SILHOUETTES_FOLDER: string : "silhouettes";

    // The menu label a root's `editor` values ask for, or the fallback.
    EditorLabel :: (valuesJson: string, fallbackLabel: string) -> string! {
        label~ string! = `${fallbackLabel}`;
        when lantern:::json:::Parse(valuesJson) {
            Result:::Err(message) -> {
                delete message;
            },
            Result:::Ok(document) -> {
                if editorAt := document->Member(document->root, "editor") {
                    if labelAt := document->Member(editorAt, "label") {
                        if document->Kind(labelAt) == lantern:::json:::JsonKind:::Text {
                            delete label;
                            label = `${document->Text(labelAt)}`;
                        }
                    }
                }
                delete document;
            }
        }
        return label!;
    }

    // How far a root's `editor` values ask to lift it off the surface, or 0.
    EditorLift :: (valuesJson: string) -> f32 {
        lift~ f32 = 0.0f;
        when lantern:::json:::Parse(valuesJson) {
            Result:::Err(message) -> {
                delete message;
            },
            Result:::Ok(document) -> {
                if editorAt := document->Member(document->root, "editor") {
                    if liftAt := document->Member(editorAt, "lift") {
                        if document->Kind(liftAt) == lantern:::json:::JsonKind:::Number {
                            lift = f32(document->Node(liftAt).number);
                        }
                    }
                }
                delete document;
            }
        }
        return lift;
    }

    // The base a Silhouette's root names with `@base`, or null for a Silhouette that has none.
    RootBaseName :: (assetsDirectory: string, name: string) -> string!? {
        rootPath: string! = `${assetsDirectory}/${SILHOUETTES_FOLDER}/${name}/${lantern:::silhouette:::ROOT_FILE_NAME}`;
        defer delete rootPath;
        when lantern:::silhouette:::ReadCalamusFile(rootPath) {
            Result:::Err(message) -> {
                delete message;
                return null;
            },
            Result:::Ok(document) -> {
                found: string!? = document->BaseName();
                delete document;
                return found!;
            }
        }
    }

    // The flattened lines of a JSON text as one array.
    LinesOf :: (valuesJson: string) -> ValueLines*! {
        lines := new ValueLines();
        when lantern:::json:::Parse(valuesJson) {
            Result:::Err(message) -> {
                delete message;
            },
            Result:::Ok(document) -> {
                lines->Flatten(document, document->root, "");
                delete document;
            }
        }
        return lines!;
    }

    // True when a line is in a list of lines.
    HasLine :: (lines: ValueLines*, wanted: string) -> bool {
        for line in lines->lines {
            if line == wanted {
                return true;
            }
        }
        return false;
    }

    // For each entity of a resolved Silhouette, the lines of its values that differ from the same entity
    // (by path) in its base, joined with newlines. An entity the base does not have is all its own lines.
    OwnLines :: (library: lantern:::silhouette:::SilhouetteLibrary*, baseName: string, resolved: lantern:::silhouette:::ResolvedSilhouette*) -> Array<string!>! {
        own~ Array<string!>! = [];
        when library->Resolve(baseName) {
            Result:::Err(message) -> {
                delete message;
                for entity in resolved->entities {
                    own.push("".copy());
                }
            },
            Result:::Ok(baseSilhouette) -> {
                for entity in resolved->entities {
                    entityLines := LinesOf(entity->valuesJson);
                    baseLines~ ValueLines*!? = null;
                    if baseIndex := baseSilhouette->IndexOf(entity->path) {
                        baseLines = LinesOf(baseSilhouette->entities[baseIndex]->valuesJson);
                    }
                    text~ string! = "|~|".copy();
                    for line in entityLines->lines {
                        isOwn~ bool = true;
                        if present := baseLines {
                            isOwn = !HasLine(present, line);
                        }
                        if isOwn {
                            extended: string! = `${text}${line}|~|`;
                            delete text;
                            text = extended!;
                        }
                    }
                    own.push(text!);
                    delete entityLines;
                    delete baseLines;
                }
                delete baseSilhouette;
            }
        }
        return own!;
    }

    // Builds the template for one Silhouette: the root becomes the prototype and every other entity a
    // descendant, with its parent given as a position in the group.
    SilhouetteTemplate :: (library: lantern:::silhouette:::SilhouetteLibrary*, assetsDirectory: string, name: string) -> Result<lantern:::editor:::EntityTemplate*!, string!> {
        silhouetteName: string! = `${SILHOUETTES_FOLDER}/${name}`;
        defer delete silhouetteName;
        valuesJson~ string! = "".copy();
        allValues~ Array<string!>! = [];
        ownLines~ Array<string!>! = [];
        allPaths~ Array<string!>! = [];
        baseName~ string!? = RootBaseName(assetsDirectory, name);
        when library->Resolve(silhouetteName) {
            Result:::Err(message) -> {
                allValues.freeAll();
                allPaths.freeAll();
                ownLines.freeAll();
                delete baseName;
                delete valuesJson;
                return Result<lantern:::editor:::EntityTemplate*!, string!>:::Err(message!);
            },
            Result:::Ok(resolved) -> {
                delete valuesJson;
                valuesJson = `${resolved->entities[0]->valuesJson}`;
                for resolvedEntity in resolved->entities {
                    allValues.push(`${resolvedEntity->valuesJson}`);
                    allPaths.push(`${resolvedEntity->path}`);
                }
                if base := baseName {
                    ownLines.freeAll();
                    ownLines = OwnLines(library, base, resolved);
                }
                delete resolved;
            }
        }
        rootValues: string = valuesJson;
        label: string! = EditorLabel(rootValues, name);
        menuLift: f32 = EditorLift(rootValues);
        delete valuesJson;
        when lantern:::silhouette:::SilhouetteWorld(library, silhouetteName) {
            Result:::Err(message) -> {
                delete label;
                allValues.freeAll();
                allPaths.freeAll();
                ownLines.freeAll();
                delete baseName;
                return Result<lantern:::editor:::EntityTemplate*!, string!>:::Err(message!);
            },
            Result:::Ok(loaded) -> {
                worldFile: lantern:::world:::WorldFile* = loaded;
                root: lantern:::world:::WorldEntity* = worldFile->entities[0];
                template := new lantern:::editor:::EntityTemplate(name, label, root->kind);
                delete label;
                template->lift = menuLift;
                template->fromSilhouette = true;
                template->componentValues.freeAll();
                template->componentValues = allValues!;
                template->componentOwn.freeAll();
                template->componentOwn = ownLines!;
                template->componentPaths.freeAll();
                template->componentPaths = allPaths!;
                delete template->baseName;
                template->baseName = baseName!;
                delete template->prototype;
                template->prototype = root->Copy();
                template->prototype->SetTextProperty("silhouette", name);
                for index~ usize = 1; index < worldFile->entities.length(); index++ {
                    descendant := worldFile->entities[index]->Copy();
                    parentPosition~ usize = 0;
                    if parentId := descendant->parent {
                        parentPosition = usize(parentId) - 1;
                    }
                    template->descendants.push(descendant!);
                    template->descendantParents.push(parentPosition);
                }
                delete loaded;
                return Result<lantern:::editor:::EntityTemplate*!, string!>:::Ok(template!);
            }
        }
    }

    // The values of one component, flattened into one line per value, such as `transform.position: [0, 1, 0]`.
    ValueLines :: class {
    public:
        lines~ Array<string!>! = [];

        ValueLines~: () { }

        !ValueLines~: () {
            lines.freeAll();
        }

        Replace~: (newLines: Array<string!>!) -> void {
            lines.freeAll();
            lines = newLines!;
        }

        // Adds the lines for a node and everything under it. `path` is the dotted name so far.
        Flatten~: (document: lantern:::json:::JsonDocument*, node: u32, path: string) -> void {
            kind: lantern:::json:::JsonKind = document->Kind(node);
            if kind == lantern:::json:::JsonKind:::Object {
                child~ u32 = document->FirstChild(node);
                while child != lantern:::json:::NO_NODE {
                    isRoot: bool = path.length() == 0;
                    childPath: string! = when isRoot { true -> `${document->Key(child)}`, false -> `${path}.${document->Key(child)}` };
                    Flatten(document, child, childPath);
                    delete childPath;
                    child = document->NextSibling(child);
                }
                return;
            }
            written: string! = document->Write(node);
            lines.push(`${path}: ${written.trim()}`);
            delete written;
        }
    }

    // The flattened values of one component of a template, or no lines for an unknown component.
    ComponentValueLines :: (template: lantern:::editor:::EntityTemplate*, index: usize) -> ValueLines*! {
        lines := new ValueLines();
        if index >= template->componentValues.length() {
            return lines!;
        }
        when lantern:::json:::Parse(template->componentValues[index]) {
            Result:::Err(message) -> {
                delete message;
            },
            Result:::Ok(document) -> {
                lines->Flatten(document, document->root, "");
                delete document;
            }
        }
        if template->baseName != null && index < template->componentOwn.length() {
            marked~ Array<string!>! = [];
            ownText: string = template->componentOwn[index];
            for line in lines->lines {
                lineEnd: string! = `|~|${line}|~|`;
                prefix: string = when ownText.contains(lineEnd) { true -> "* ", false -> "  " };
                marked.push(`${prefix}${line}`);
                delete lineEnd;
            }
            lines->Replace(marked!);
        }
        return lines!;
    }

    // Adds a template for every Silhouette folder under `<assets>/silhouettes`. A missing folder adds
    // nothing.
    AddSilhouetteTemplates :: (palette: lantern:::editor:::Palette~*, assetsDirectory: string) -> void {
        folder: string! = `${assetsDirectory}/${SILHOUETTES_FOLDER}`;
        defer delete folder;
        if !directoryExists(folder) {
            return;
        }
        library := new lantern:::silhouette:::SilhouetteLibrary(assetsDirectory);
        defer delete library;
        when lantern:::silhouette:::SortedEntries(folder) {
            Result:::Err(message) -> {
                lantern:::core:::LogWarn("editor", message);
                delete message;
            },
            Result:::Ok(listed) -> {
                names~ Array<string!>! = listed!;
                for name in names {
                    entryPath: string! = `${folder}/${name}`;
                    isFolder: bool = directoryExists(entryPath);
                    isMaterial: bool = isFolder && lantern:::silhouette:::IsMaterialSilhouetteFolder(entryPath);
                    delete entryPath;
                    if !isFolder || isMaterial {
                        continue;
                    }
                    when SilhouetteTemplate(library, assetsDirectory, name) {
                        Result:::Err(message) -> {
                            warning: string! = `silhouette '${name}' not added to the palette: ${message}`;
                            lantern:::core:::LogWarn("editor", warning);
                            delete warning;
                            delete message;
                        },
                        Result:::Ok(template) -> {
                            palette->AddTemplate(template!);
                        }
                    }
                }
                names.freeAll();
            }
        }
    }
}
