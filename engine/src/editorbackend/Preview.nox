lantern:::editorbackend :: namespace {
    // The colours of the small preview of an entity template (the thumbnail in the palette): a dark
    // backdrop, a faint floor grid and a pale outline around shapes.
    PreviewSkyColor :: () -> lantern:::core:::Color {
        return lantern:::core:::Color:::Rgb(0.13f, 0.13f, 0.13f);
    }

    PreviewGridColor :: () -> lantern:::core:::Color {
        return lantern:::core:::Color:::Rgb(0.28f, 0.28f, 0.28f);
    }

    PreviewOutlineColor :: () -> lantern:::core:::Color {
        return lantern:::core:::Color:::Rgb(0.6f, 0.65f, 0.75f);
    }

    // The local box to frame in the preview: the shape's bounds for a template with a shape, otherwise
    // the bounds of its marker mesh. An empty box becomes a one metre cube so the camera still has
    // something to look at.
    EntityBounds :: (entity: lantern:::world:::WorldEntity*, palette: lantern:::editor:::Palette*) -> lantern:::core:::Aabb {
        bounds~ lantern:::core:::Aabb = lantern:::core:::Aabb { };
        if shape := entity->shape {
            bounds = lantern:::editor:::ShapeLocalBounds(shape);
        } else {
            style := palette->MarkerStyleFor(entity->kind);
            bounds = lantern:::editor:::MarkerLocalBounds(style->mesh);
            delete style;
        }
        if bounds.IsEmpty() {
            return lantern:::core:::Aabb:::FromCenterHalfExtents(Vec3 { }, lantern:::core:::Splat3(0.5f));
        }
        return bounds;
    }

    // Fills a render world with one spinning template: a camera orbiting the template's box (the
    // angle is `spin`), a floor grid under it, then the template's mesh with its material and tint, or
    // its marker. A flat marker (a plane) is drawn as an outline instead. Fog is pushed far away so
    // the backdrop is not tinted.
    BuildEntityPreview :: (entity: lantern:::world:::WorldEntity*, palette: lantern:::editor:::Palette*, resources: lantern:::editor:::ViewportResources~*, renderWorld: lantern:::renderer:::RenderWorld~*, spin: f32) -> void {
        renderWorld->Clear();
        renderWorld->lights.clear();
        renderWorld->light = lantern:::renderer:::DirectionalLight:::Default();
        renderWorld->sky = lantern:::renderer:::SkySettings { };
        renderWorld->post.exposure = 1.0f;
        renderWorld->clearColor = PreviewSkyColor();
        renderWorld->sky.zenith = lantern:::core:::Color:::Rgb(0.2f, 0.21f, 0.23f);
        renderWorld->sky.horizon = lantern:::core:::Color:::Rgb(0.3f, 0.31f, 0.32f);
        renderWorld->sky.ground = lantern:::core:::Color:::Rgb(0.18f, 0.18f, 0.18f);
        renderWorld->sky.sunDiscStrength = 0.0f;
        renderWorld->fogStart = 1000.0f;
        renderWorld->fogEnd = 2000.0f;
        bounds: lantern:::core:::Aabb = EntityBounds(entity, palette);
        radius: f32 = Math:::max(bounds.HalfExtents().length(), 0.3f);
        center: Vec3 = bounds.Center();
        orbitDirection: Vec3 = Vec3 { x: Math:::sin(spin + 0.7f), y: 0.65f, z: Math:::cos(spin + 0.7f) };
        orbit: Vec3 = lantern:::core:::NormalizeOr3(orbitDirection, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f });
        camera~ lantern:::renderer:::Camera = lantern:::renderer:::Camera:::LookAt(center + orbit * radius * 2.6f, center);
        camera.verticalFieldOfViewRadians = 45.0f * (Math:::PI / 180.0f);
        camera.nearPlane = 0.05f;
        camera.farPlane = 200.0f;
        renderWorld->camera = camera;
        floorHeight: f32 = bounds.min.y - 0.01f;
        step: f32 = Math:::max(radius * 0.5f, 0.25f);
        for index~ i32 = -4; index <= 4; index++ {
            offset: f32 = f32(index) * step;
            renderWorld->Line(Vec3 { x: center.x + offset, y: floorHeight, z: center.z - 4.0f * step }, Vec3 { x: center.x + offset, y: floorHeight, z: center.z + 4.0f * step }, PreviewGridColor());
            renderWorld->Line(Vec3 { x: center.x - 4.0f * step, y: floorHeight, z: center.z + offset }, Vec3 { x: center.x + 4.0f * step, y: floorHeight, z: center.z + offset }, PreviewGridColor());
        }
        if shape := entity->shape {
            if mesh := resources->ShapeMesh(shape) {
                materialName~ string? = null;
                if material := entity->material {
                    materialName = material;
                }
                texture: lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = resources->MaterialTexture(materialName);
                tint~ lantern:::core:::Color = lantern:::core:::Color:::White();
                if tintText := entity->tint {
                    tint = lantern:::world:::ParseHexColor(tintText) ?? lantern:::core:::Color:::White();
                }
                look: lantern:::renderer:::MaterialLook? = resources->MaterialLook(materialName);
                if found := look {
                    tint = lantern:::core:::Color:::Rgba(tint.r * found.tint.r, tint.g * found.tint.g, tint.b * found.tint.b, tint.a);
                    renderWorld->DrawWithLook(mesh, texture, Mat4 { }, tint, found);
                } else {
                    renderWorld->Draw(mesh, texture, Mat4 { }, tint);
                }
            }
            lantern:::editor:::OrientedBoxLines(renderWorld, bounds, Mat4 { }, PreviewOutlineColor());
            return;
        }
        style := palette->MarkerStyleFor(entity->kind);
        color: lantern:::core:::Color = lantern:::world:::ParseHexColor(style->color) ?? lantern:::core:::Color:::White();
        marker: lantern:::editor:::MarkerMesh = style->mesh;
        delete style;
        if marker == lantern:::editor:::MarkerMesh:::Plane {
            corners: Vec3[4] = [Vec3 { x: -1.0f, y: 0.0f, z: -1.0f }, Vec3 { x: 1.0f, y: 0.0f, z: -1.0f }, Vec3 { x: 1.0f, y: 0.0f, z: 1.0f }, Vec3 { x: -1.0f, y: 0.0f, z: 1.0f }];
            for index~ usize = 0; index < 4; index++ {
                renderWorld->Line(corners[index], corners[(index + 1) % 4], color);
            }
            return;
        }
        if mesh := resources->MarkerMeshHandle(marker) {
            renderWorld->Draw(mesh, null, lantern:::editor:::MarkerLocalMatrix(marker), color);
        }
    }

    TemplateBounds :: (template: lantern:::editor:::EntityTemplate*, palette: lantern:::editor:::Palette*) -> lantern:::core:::Aabb {
        return EntityBounds(template->prototype, palette);
    }

    BuildTemplatePreview :: (template: lantern:::editor:::EntityTemplate*, palette: lantern:::editor:::Palette*, resources: lantern:::editor:::ViewportResources~*, renderWorld: lantern:::renderer:::RenderWorld~*, spin: f32) -> void {
        BuildEntityPreview(template->prototype, palette, resources, renderWorld, spin);
    }

    // One rendered palette thumbnail kept in memory: which template it is for, its pixels and size,
    // and the palette revision it was drawn at, so it is drawn again when the palette changes.
    Thumbnail :: class {
    public:
        templateId~ string!;
        pixels~ Array<u8>! = [];
        size~ u32 = 0;
        paletteRevision~ u64 = 0;

        Thumbnail~: (id: string) {
            templateId = `${id}`;
        }

        !Thumbnail~: () {
            delete templateId;
            delete pixels;
        }
    }

    // The material preview's studio: a dark room with a bright band of light around the horizon, so a metal shows a clear
    // reflection and a rough surface a soft one, a warm key light from the upper left and a cool fill from below. The
    // sphere turns by `spin` while the lights stay put, so the highlight shows the material rather than moving with it.
    // A see-through material gets a checkered wall behind the sphere, so what shows through it reads at a glance.
    BuildMaterialPreview :: (materialName: string, resources: GpuViewportResources~*, renderWorld: lantern:::renderer:::RenderWorld~*, spin: f32) -> void {
        renderWorld->Clear();
        renderWorld->lights.clear();
        renderWorld->clearColor = lantern:::core:::Color:::Rgb(0.07f, 0.075f, 0.085f);
        renderWorld->sky = lantern:::renderer:::SkySettings { };
        renderWorld->sky.zenith = lantern:::core:::Color:::Rgb(0.16f, 0.17f, 0.2f);
        renderWorld->sky.horizon = lantern:::core:::Color:::Rgb(1.1f, 1.04f, 0.95f);
        renderWorld->sky.ground = lantern:::core:::Color:::Rgb(0.05f, 0.05f, 0.058f);
        renderWorld->sky.sunDiscStrength = 0.0f;
        renderWorld->sky.backdropVisible = false;
        renderWorld->sky.lightingStrength = 1.0f;
        renderWorld->sky.lightingIntensity = 0.9f;
        renderWorld->fogStart = 1000.0f;
        renderWorld->fogEnd = 2000.0f;
        renderWorld->post.exposure = 1.0f;
        renderWorld->light = lantern:::renderer:::DirectionalLight {
            direction: lantern:::core:::Normalize3(Vec3 { x: 0.55f, y: -0.7f, z: -0.45f }),
            color: lantern:::core:::Color:::Rgb(2.0f, 1.9f, 1.72f),
            ambient: lantern:::core:::Color:::Rgb(0.12f, 0.13f, 0.16f),
            groundAmbient: lantern:::core:::Color:::Rgb(0.03f, 0.03f, 0.04f),
            castsShadows: false
        };
        renderWorld->AddLight(lantern:::renderer:::Light:::Point(Vec3 { x: -1.4f, y: 0.9f, z: -1.6f }, lantern:::core:::Color:::Rgb(1.2f, 1.4f, 1.9f), 6.0f));
        camera~ lantern:::renderer:::Camera = lantern:::renderer:::Camera:::LookAt(Vec3 { x: 0.0f, y: 1.05f, z: 1.45f }, Vec3 { x: 0.0f, y: -0.04f, z: 0.0f });
        camera.verticalFieldOfViewRadians = 38.0f * (Math:::PI / 180.0f);
        camera.nearPlane = 0.05f;
        camera.farPlane = 200.0f;
        renderWorld->camera = camera;
        guard mesh := resources->PreviewSphereMesh() return;
        if resources->MaterialIsTranslucent(materialName) {
            if backdrop := resources->PreviewBackdropMesh() {
                behind: Mat4 = lantern:::core:::MatrixFromRotationTranslation(lantern:::core:::QuaternionFromRotationY(0.0f), Vec3 { x: 0.0f, y: 0.1f, z: -1.1f });
                renderWorld->Draw(backdrop, resources->PreviewCheckerTexture(), behind, lantern:::core:::Color:::White());
            }
        }
        turn: Mat4 = lantern:::core:::MatrixFromQuaternion(lantern:::core:::QuaternionFromRotationY(spin));
        texture: lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = resources->MaterialTexture(materialName);
        look: lantern:::renderer:::MaterialLook? = resources->MaterialLook(materialName);
        if found := look {
            renderWorld->DrawWithLook(mesh, texture, turn, found.tint, found);
        } else {
            renderWorld->Draw(mesh, texture, turn, lantern:::core:::Color:::White());
        }
    }
}
