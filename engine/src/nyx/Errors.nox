NyxC :: import NyxC;

lantern:::nyx :: namespace {
    /**
     * The name of a C API status code, such as "NYX_ERROR_FAILURE", for messages.
     */
    StatusName :: (status: NyxC:::nyx_status) -> string! {
        unsafe {
            return copyCString(NyxC:::nyx_status_name(status));
        }
    }

    /**
     * One line of a Nyx call stack: a function, the file and the line and column in it.
     */
    StackFrame :: class {
    public:
        function~ string! = "";
        path~ string! = "";
        line~ i32 = 0;
        column~ i32 = 0;

        StackFrame~: (raw: NyxC:::nyx_stack_frame) {
            delete function;
            function = ReadText(raw.function);
            delete path;
            path = ReadText(raw.path);
            line = raw.line;
            column = raw.column;
        }

        !StackFrame~: () {
            delete function;
            delete path;
        }

        Text :: () -> string! {
            return `${function} (${path}:${line}:${column})`;
        }
    }

    /**
     * What a failed C API call returns: the status code, Nyx's message, and the stack at the point it failed. For a
     * script's own `throw` (status NYX_ERROR_FAILURE) it also holds the error value that was thrown. Nothing in the
     * bridge throws a Nox exception; every fallible call returns one of these inside a `Result`.
     */
    NyxError :: class {
    public:
        status~ NyxC:::nyx_status = 0;
        message~ string! = "";
        failure~ Value*!? = null;
        stack~ Array<StackFrame*!>! = [];

        NyxError~: (errorStatus: NyxC:::nyx_status, errorMessage: string) {
            status = errorStatus;
            message += errorMessage;
        }

        !NyxError~: () {
            delete message;
            delete failure;
            stack.freeAll();
        }

        /**
         * Replaces the stack with `frames`, taking ownership of them.
         */
        TakeStack~: (frames: Array<StackFrame*!>!) -> void {
            stack.freeAll();
            stack = frames!;
        }

        /**
         * True when the script itself threw (a Nyx `throw`), as opposed to the call being refused or invalid.
         */
        IsFailure :: () -> bool {
            return status == NyxC:::NYX_ERROR_FAILURE;
        }

        /**
         * The innermost frame, where the error happened, or null when there is no stack.
         */
        Location :: () -> StackFrame*? {
            if stack.length() == 0 {
                return null;
            }
            return stack[0];
        }

        Text :: () -> string! {
            name: string! = StatusName(status);
            text~ string! = `${name}: ${message}`;
            delete name;
            if frame := Location() {
                where: string! = frame->Text();
                text += ` at ${where}`;
                delete where;
            }
            return text!;
        }
    }

    /**
     * Reads the stack the runtime recorded for its last error.
     */
    LastErrorStack :: (runtime: raw NyxC:::nyx_runtime~*) -> Array<StackFrame*!>! {
        frames~ Array<StackFrame*!>! = [];
        unsafe {
            count: usize = NyxC:::nyx_runtime_last_error_frame_count(runtime);
            for index~ usize = 0; index < count; index++ {
                frame~ NyxC:::nyx_stack_frame = NyxC:::nyx_stack_frame { };
                if NyxC:::nyx_runtime_last_error_frame(runtime, index, frame) == NyxC:::NYX_OK {
                    frames.push(new StackFrame(frame));
                }
            }
        }
        return frames!;
    }

    /**
     * Reads the message the runtime recorded for its last error.
     */
    LastErrorMessage :: (runtime: raw NyxC:::nyx_runtime~*) -> string! {
        message~ NyxC:::nyx_str = NyxC:::nyx_str { };
        unsafe {
            NyxC:::nyx_runtime_last_error(runtime, message);
        }
        return ReadText(message);
    }

    /**
     * Turns a status code into null (success) or a NyxError carrying the runtime's message and stack. Every C API call
     * in this layer ends with it.
     */
    CheckStatus :: (runtime: raw NyxC:::nyx_runtime~*, status: NyxC:::nyx_status) -> NyxError*!? {
        if status == NyxC:::NYX_OK {
            return null;
        }
        message: string! = LastErrorMessage(runtime);
        error := new NyxError(status, message);
        delete message;
        error->TakeStack(LastErrorStack(runtime));
        return error!;
    }

    /**
     * How serious a diagnostic is.
     */
    Severity :: enum {
        Error,
        Warning,
        Note,
        Help
    }

    /**
     * The C API's severity code as a Severity. Unknown codes count as errors.
     */
    SeverityFromRaw :: (raw: NyxC:::nyx_severity) -> Severity {
        if raw == NyxC:::NYX_SEVERITY_WARNING {
            return Severity:::Warning;
        }
        if raw == NyxC:::NYX_SEVERITY_NOTE {
            return Severity:::Note;
        }
        if raw == NyxC:::NYX_SEVERITY_HELP {
            return Severity:::Help;
        }
        return Severity:::Error;
    }

    /**
     * One message from Nyx's checker about a script: a code ("NYX0123"), the text, and where in which file it points
     * (line and column, and byte offsets).
     */
    Diagnostic :: class {
    public:
        severity~ Severity = Severity:::Error;
        code~ string! = "";
        message~ string! = "";
        path~ string! = "";
        startLine~ i32 = 0;
        startColumn~ i32 = 0;
        endLine~ i32 = 0;
        endColumn~ i32 = 0;
        startOffset~ u32 = 0;
        endOffset~ u32 = 0;

        Diagnostic~: (raw: NyxC:::nyx_diagnostic) {
            severity = SeverityFromRaw(raw.severity);
            delete code;
            code = ReadText(raw.code);
            delete message;
            message = ReadText(raw.message);
            delete path;
            path = ReadText(raw.path);
            startLine = raw.start_line;
            startColumn = raw.start_column;
            endLine = raw.end_line;
            endColumn = raw.end_column;
            startOffset = raw.start_offset;
            endOffset = raw.end_offset;
        }

        !Diagnostic~: () {
            delete code;
            delete message;
            delete path;
        }
    }
}
