NyxC :: import NyxC;

lantern:::nyx :: namespace {
    /**
     * The version of the Nyx C API the loaded library reports. Compare it with HEADER_VERSION.
     */
    CapiVersion :: () -> i32 {
        unsafe {
            return NyxC:::nyx_capi_version();
        }
    }

    /**
     * The C API version this bridge was written against (the header's version). A library that reports another one
     * may have changed a signature.
     */
    HEADER_VERSION: i32 : 13;

    /**
     * Counts the values and programs still alive for a runtime. A Nyx runtime must outlive everything made from it,
     * and the C API can't enforce that, so Value and Program add to the ledger on creation and take away on delete,
     * and the Runtime checks it is empty before it is destroyed.
     */
    RuntimeLedger :: class {
    public:
        handle~ raw NyxC:::nyx_runtime~* = null;
        liveValues~ usize = 0;
        livePrograms~ usize = 0;

        RuntimeLedger~: (runtimeHandle: raw NyxC:::nyx_runtime~*) {
            handle = runtimeHandle;
        }

        IsEmpty :: () -> bool {
            return liveValues == 0 && livePrograms == 0;
        }

        Remaining :: () -> string! {
            return `${liveValues} values and ${livePrograms} programs`;
        }
    }

    /**
     * One Nyx interpreter. It mounts source files into Programs, registers the engine's functions and types for
     * scripts to call, and makes Values. It must be deleted after every Value and Program made from it; deleting it
     * earlier prints what is left and panics, which turns a use-after-free into an immediate, clear failure. The host
     * functions and types it registered stay alive in `functions` and `types` because Nyx calls back into them.
     */
    Runtime :: class {
    public:
        handle~ raw NyxC:::nyx_runtime~* = null;
        ledger~ RuntimeLedger*!;
        ledgerPointer~ raw RuntimeLedger~* = null;
        functions~ Array<HostCall*!>! = [];
        types~ Array<HostType*!>! = [];

        Runtime~: () {
            unsafe {
                NyxC:::nyx_runtime_create(handle);
            }
            ledger = new RuntimeLedger(handle);
            unsafe {
                ledgerPointer = ledger;
            }
        }

        !Runtime~: () {
            if !ledger->IsEmpty() {
                remaining: string! = ledger->Remaining();
                message~ string! = `a Nyx runtime was deleted while ${remaining} from it were still alive; delete them before the runtime`;
                message += "\n";
                delete remaining;
                unsafe {
                    lantern:::nyxoutput:::write(2, message, message.length());
                }
                delete message;
                panic("a Nyx runtime was deleted before its values and programs");
            }
            unsafe {
                NyxC:::nyx_runtime_destroy(handle);
            }
            if !CallbacksReleased() {
                panic("Nyx still holds a host function or type after its runtime was destroyed");
            }
            functions.freeAll();
            types.freeAll();
            delete ledger;
        }

        /**
         * True when Nyx has let go of every registered function and type (its `free` callbacks have run). They have to be
         * before the Runtime frees them.
         */
        CallbacksReleased :: () -> bool {
            for function in functions {
                if !function->released {
                    return false;
                }
            }
            for hostType in types {
                if !hostType->released {
                    return false;
                }
            }
            return true;
        }

        /**
         * True when the runtime was created.
         */
        IsUsable :: () -> bool {
            return handle != null;
        }

        /**
         * Turns a status into null or an error, using this runtime's last error.
         */
        Check :: (status: NyxC:::nyx_status) -> NyxError*!? {
            return CheckStatus(handle, status);
        }

        /**
         * Adds a folder where `import` in a script looks for other files.
         */
        AddImportSearchPath~: (path: string) -> NyxError*!? {
            text := new CText(path);
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = NyxC:::nyx_runtime_add_import_search_path(handle, text->Str());
            }
            delete text;
            return Check(status);
        }

        /**
         * Parses and checks a script from text, naming it `name` in messages, and returns a Program whose entry is
         * `applicationClass`. Diagnostics are available from `Diagnostics` when it fails.
         */
        MountSource~: (source: string, name: string, applicationClass: string) -> Result<Program*!, NyxError*!> {
            sourceText := new CText(source);
            nameText := new CText(name);
            classText := new CText(applicationClass);
            mounted~ raw NyxC:::nyx_program~* = null;
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = NyxC:::nyx_runtime_mount_source(handle, sourceText->Str(), nameText->Str(), classText->Str(), mounted);
            }
            delete sourceText;
            delete nameText;
            delete classText;
            failed := Check(status);
            guard failed return Result<Program*!, NyxError*!>:::Ok(new Program(mounted, ledgerPointer));
            return Result<Program*!, NyxError*!>:::Err(failed!);
        }

        /**
         * Like MountSource, but reads the script from a file. Imports resolve relative to it and to the search paths.
         */
        MountFile~: (path: string, applicationClass: string) -> Result<Program*!, NyxError*!> {
            pathText := new CText(path);
            classText := new CText(applicationClass);
            mounted~ raw NyxC:::nyx_program~* = null;
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = NyxC:::nyx_runtime_mount_file(handle, pathText->Str(), classText->Str(), mounted);
            }
            delete pathText;
            delete classText;
            failed := Check(status);
            guard failed return Result<Program*!, NyxError*!>:::Ok(new Program(mounted, ledgerPointer));
            return Result<Program*!, NyxError*!>:::Err(failed!);
        }

        /**
         * Everything the checker reported for the last mount.
         */
        Diagnostics :: () -> Array<Diagnostic*!>! {
            diagnostics~ Array<Diagnostic*!>! = [];
            unsafe {
                count: usize = NyxC:::nyx_runtime_diagnostic_count(handle);
                for index~ usize = 0; index < count; index++ {
                    raw~ NyxC:::nyx_diagnostic = NyxC:::nyx_diagnostic { };
                    if NyxC:::nyx_runtime_diagnostic(handle, index, raw) == NyxC:::NYX_OK {
                        diagnostics.push(new Diagnostic(raw));
                    }
                }
            }
            return diagnostics!;
        }

        /**
         * Reads a text value produced by a C API call, releasing it and turning a bad status into an error.
         */
        TextValue :: (status: NyxC:::nyx_status, made: raw NyxC:::nyx_value~*) -> Result<string!, NyxError*!> {
            failed := Check(status);
            if failed == null {
                if made == null {
                    return Result<string!, NyxError*!>:::Ok("");
                }
                text := new Value(made, ledgerPointer);
                read := text->Text();
                when read! {
                    Result:::Ok(contents) -> {
                        delete text;
                        return Result<string!, NyxError*!>:::Ok(contents!);
                    },
                    Result:::Err(error) -> {
                        delete text;
                        return Result<string!, NyxError*!>:::Err(error!);
                    }
                }
            }
            guard failed return Result<string!, NyxError*!>:::Ok("");
            return Result<string!, NyxError*!>:::Err(failed!);
        }

        /**
         * The last diagnostics rendered as readable text.
         */
        RenderDiagnostics :: () -> Result<string!, NyxError*!> {
            made~ raw NyxC:::nyx_value~* = null;
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = NyxC:::nyx_runtime_render_diagnostics(handle, made);
            }
            return TextValue(status, made);
        }

        /**
         * The functions and types registered here as a JSON host surface, the file Nyx's language server and checker read
         * to know the engine's names (see `games/platformer/engine-host-surface.json`).
         */
        WriteHostSurface :: () -> Result<string!, NyxError*!> {
            made~ raw NyxC:::nyx_value~* = null;
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = NyxC:::nyx_runtime_write_host_surface(handle, made);
            }
            return TextValue(status, made);
        }

        /**
         * Takes a namespace of Nyx's standard library (such as `File`) away from scripts. The engine removes the ones a
         * game shouldn't have, so game code reaches the outside world only through the engine's own functions.
         */
        RemoveStandardNamespace~: (standardNamespace: string) -> NyxError*!? {
            text := new CText(standardNamespace);
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = NyxC:::nyx_runtime_remove_standard_namespace(handle, text->Str());
            }
            delete text;
            return Check(status);
        }

        /**
         * Wraps a handle the C API gave this caller (which now owns one reference) in a Value.
         */
        Adopt :: (made: raw NyxC:::nyx_value~*) -> Value*! {
            return new Value(made, ledgerPointer);
        }

        /**
         * A Nyx `null` value. MakeBool, MakeI32, MakeI64, MakeF32, MakeF64 and MakeString make the other simple
         * kinds.
         */
        MakeNull :: () -> Value*! {
            made~ raw NyxC:::nyx_value~* = null;
            unsafe {
                NyxC:::nyx_value_new_null(handle, made);
            }
            return Adopt(made);
        }

        MakeBool :: (value: bool) -> Value*! {
            made~ raw NyxC:::nyx_value~* = null;
            unsafe {
                NyxC:::nyx_value_new_bool(handle, value, made);
            }
            return Adopt(made);
        }

        MakeI32 :: (value: i32) -> Value*! {
            made~ raw NyxC:::nyx_value~* = null;
            unsafe {
                NyxC:::nyx_value_new_i32(handle, value, made);
            }
            return Adopt(made);
        }

        MakeI64 :: (value: i64) -> Value*! {
            made~ raw NyxC:::nyx_value~* = null;
            unsafe {
                NyxC:::nyx_value_new_i64(handle, value, made);
            }
            return Adopt(made);
        }

        MakeF32 :: (value: f32) -> Value*! {
            made~ raw NyxC:::nyx_value~* = null;
            unsafe {
                NyxC:::nyx_value_new_f32(handle, value, made);
            }
            return Adopt(made);
        }

        MakeF64 :: (value: f64) -> Value*! {
            made~ raw NyxC:::nyx_value~* = null;
            unsafe {
                NyxC:::nyx_value_new_f64(handle, value, made);
            }
            return Adopt(made);
        }

        MakeString :: (value: string) -> Value*! {
            text := new CText(value);
            made~ raw NyxC:::nyx_value~* = null;
            unsafe {
                NyxC:::nyx_value_new_string(handle, text->Str(), made);
            }
            delete text;
            return Adopt(made);
        }

        /**
         * A Nyx error value of the given variant and message, which a host function may return in place of a result.
         */
        MakeError :: (variant: string, message: string) -> Result<Value*!, NyxError*!> {
            variantText := new CText(variant);
            messageText := new CText(message);
            made~ raw NyxC:::nyx_value~* = null;
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = NyxC:::nyx_value_new_error(handle, variantText->Str(), messageText->Str(), made);
            }
            delete variantText;
            delete messageText;
            failed := Check(status);
            guard failed return Result<Value*!, NyxError*!>:::Ok(Adopt(made));
            return Result<Value*!, NyxError*!>:::Err(failed!);
        }

        /**
         * A Nyx array holding the given values.
         */
        MakeArray :: (items: Array<Value*>) -> Result<Value*!, NyxError*!> {
            if !AllBelongTo(handle, items) {
                return Result<Value*!, NyxError*!>:::Err(ForeignValueError());
            }
            handles: Array<raw NyxC:::nyx_value~*>! = HandlesOf(items);
            made~ raw NyxC:::nyx_value~* = null;
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = lantern:::nyxcalls:::nyx_value_new_array(handle, handles, handles.length(), made);
            }
            delete handles;
            failed := Check(status);
            guard failed return Result<Value*!, NyxError*!>:::Ok(Adopt(made));
            return Result<Value*!, NyxError*!>:::Err(failed!);
        }

        /**
         * Makes a Nox function callable from scripts under a qualified name. `signature` is the Nyx signature the checker
         * uses (such as `(x: f32) -> f32`); `body` receives a CallContext to read arguments from and return a result into.
         */
        RegisterFunction~: (name: string, signature: string, body: ((context: CallContext~*) -> void)!) -> NyxError*!? {
            entry := new HostCall(HostCallKind:::Function, name, signature, body!);
            entry->ledger = ledgerPointer;
            status~ NyxC:::nyx_status = 0;
            unsafe {
                status = NyxC:::nyx_runtime_register_function(handle, entry->nameText->Str(), entry->signatureText->Str(), HostCallTrampoline, entry->Userdata(), FreeHostCallTrampoline);
            }
            failed := Check(status);
            if failed == null {
                functions.push(entry!);
                return null;
            }
            delete entry;
            return failed!;
        }

        /**
         * Registers a host type (see HostType) so scripts can name it, construct it and call its methods.
         */
        RegisterType~: (hostType: HostType*!) -> NyxError*!? {
            failed := hostType->Register(ledgerPointer);
            if failed == null {
                types.push(hostType!);
                return null;
            }
            delete hostType;
            return failed!;
        }
    }
}
