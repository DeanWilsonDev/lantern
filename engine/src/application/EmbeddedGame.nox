lantern:::application :: namespace {
    /**
     * The bytes of the running program: /proc/self/exe where there is one, else the file its first argument names.
     */
    ReadOwnProgram :: (arguments: Array<string>) -> Result<Array<u8>!, FileError> {
        if pathExists("/proc/self/exe") {
            return readFileBytes("/proc/self/exe");
        }
        return readFileBytes(arguments.length() > 0 ? arguments[0] : "");
    }

    /**
     * When the running program has a game archive appended (`mist run package`), unpacks it into the player's private
     * folder if this build hasn't been unpacked there yet, points the shader directory at it and runs the game. Returns
     * null for a program with no archive.
     */
    RunEmbeddedGame :: (arguments: Array<string>) -> i32? {
        when ReadOwnProgram(arguments) {
            Result:::Err(error) -> {
                delete error;
                return null;
            },
            Result:::Ok(program) -> {
                programBytes: Array<u8>! = program!;
                defer delete programBytes;
                return RunEmbeddedFrom(programBytes);
            }
        }
    }

    // The folder this build unpacks into: the fingerprint inside a folder only this user can write. The unpacked game runs
    // with the player's rights, so a shared folder such as /tmp is never used as it stands (lantern:::privatedirectory).
    // Logs why and returns null when no such folder can be had.
    PrivateUnpackDirectory :: (fingerprint: u32) -> string!? {
        root: string!? = lantern:::privatedirectory:::UnpackRoot();
        if rootPath := root {
            problem: string!? = lantern:::privatedirectory:::EnsurePrivate(rootPath);
            if message := problem {
                lantern:::core:::LogError("game", message);
                delete problem;
                delete root;
                return null;
            }
            delete problem;
            directory: string! = `${rootPath}/${fingerprint}`;
            delete root;
            // The build's own folder gets the same checks as the root, so one planted there (a link, or a folder
            // another user made) is refused before its marker is believed.
            folderProblem: string!? = lantern:::privatedirectory:::EnsurePrivate(directory);
            if folderMessage := folderProblem {
                lantern:::core:::LogError("game", folderMessage);
                delete folderProblem;
                delete directory;
                return null;
            }
            delete folderProblem;
            return directory!;
        }
        delete root;
        lantern:::core:::LogError("game", "no private folder to unpack into: set LANTERN_CACHE_DIRECTORY to one you own");
        return null;
    }

    RunEmbeddedFrom :: (programBytes: Array<u8>) -> i32? {
        start: usize? = lantern:::archive:::FindStart(programBytes);
        guard archiveStart := start return null;
        fingerprint: u32 = lantern:::archive:::Fingerprint(programBytes, archiveStart);
        choice: string!? = PrivateUnpackDirectory(fingerprint);
        defer delete choice;
        guard directory := choice return 1;
        // The marker is written last and holds the fingerprint, so a start reuses the folder only when a complete
        // unpack of this very build is already there, and otherwise unpacks again over it.
        if !lantern:::archive:::IsUnpacked(directory, fingerprint) {
            problem: string!? = lantern:::archive:::Unpack(programBytes, archiveStart, directory);
            if message := problem {
                lantern:::core:::LogError("game", message);
                delete problem;
                return 1;
            }
            delete problem;
        }
        shaders: string! = `${directory}/shaders/compiled`;
        defer delete shaders;
        unsafe {
            lantern:::archivecalls:::setenv("LANTERN_SHADER_DIRECTORY", shaders, 1);
        }
        gameDirectory: string! = `${directory}/game`;
        defer delete gameDirectory;
        return RunGame(gameDirectory);
    }
}
