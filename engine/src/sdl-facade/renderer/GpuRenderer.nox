// GpuRenderer: the RenderBackend over SDL GPU. This is where a RenderWorld becomes GPU commands.
//
// What it owns, for its whole life:
//   - the device (the connection to the graphics card) and, when drawing to a window, the window's swapchain;
//   - three pipelines, one per kind of thing it draws: lit meshes, debug lines and the 2D overlay (GpuPipelines.nox);
//   - every mesh and texture a game uploaded, in pools so they are named by generational handles (GpuResources.nox);
//   - a 1x1 white texture, used wherever a draw has no texture, so every draw can sample one;
//   - two growable vertex buffers for the per-frame lines and overlay, and the depth buffer.
//
// What one frame does (Render):
//   1. Acquire a command buffer: a list of GPU work recorded on the CPU and submitted in one go.
//   2. Copy this frame's line and overlay vertices into their GPU buffers (a copy pass).
//   3. Acquire the swapchain image to draw into, and make sure the depth buffer is the same size.
//   4. Record the frame (RecordFrame): cull and sort the meshes, then one render pass that draws the meshes, the
//      lines over them and the overlay on top.
//   5. Submit the command buffer. SDL presents the swapchain image when the GPU finishes.
//
// Capture and RenderOffscreen record the same frame into a texture of their own instead of the swapchain, then copy
// its pixels back to the CPU.
Sdl :: import Sdl;

lantern:::copyreadback :: foreign "c" {
    memcpy :: (destination: Array<u8~>, source: raw u8*, byteCount: usize) -> raw u8~*;
}

lantern:::gpu :: namespace {
    Sdl :: import Sdl;

    NO_BINDING: u32 : 4294967295;

    GpuRenderer :: class {
        implements:
            lantern:::renderer:::RenderBackend;
    public:
        device~ raw Sdl:::SDL_GPUDevice~* = null;
        window~ raw Sdl:::SDL_Window~* = null;
        windowClaimed~ bool = false;
        pipelines~ Pipelines = Pipelines { };
        samplers~ Samplers = Samplers { };
        meshes~ lantern:::core:::Pool<GpuMesh>*!;
        textures~ lantern:::core:::Pool<GpuTexture>*!;
        whiteTexture~ GpuTexture = GpuTexture { };
        lineBuffer~ DynamicBuffer = DynamicBuffer { };
        overlayBuffer~ DynamicBuffer = DynamicBuffer { };
        depthTexture~ raw Sdl:::SDL_GPUTexture~* = null;
        depthWidth~ u32 = 0;
        depthHeight~ u32 = 0;
        colorFormat~ Sdl:::SDL_GPUTextureFormat = 0;
        depthFormat~ Sdl:::SDL_GPUTextureFormat = 0;
        encodeSrgbInShader~ bool = false;
        debug~ bool = false;
        driverName~ string!;
        ownsVideoSubsystem~ bool = false;
        offscreenColor~ raw Sdl:::SDL_GPUTexture~* = null;
        offscreenDepth~ raw Sdl:::SDL_GPUTexture~* = null;
        offscreenDownload~ raw Sdl:::SDL_GPUTransferBuffer~* = null;
        offscreenWidth~ u32 = 0;
        offscreenHeight~ u32 = 0;

        GpuRenderer~: () {
            driverName = "" + "";
            meshes = new lantern:::core:::Pool<GpuMesh>();
            textures = new lantern:::core:::Pool<GpuTexture>();
            lineBuffer.usage = Sdl:::SDL_GPU_BUFFERUSAGE_VERTEX;
            overlayBuffer.usage = Sdl:::SDL_GPU_BUFFERUSAGE_VERTEX;
        }

        !GpuRenderer~: () {
            ReleaseDevice();
            delete meshes;
            delete textures;
            delete driverName;
        }

        // Opens the device. SDL picks a driver unless LANTERN_GPU_DRIVER names one ("vulkan", "metal"). The shaders
        // ship as SPIR-V for Vulkan and MSL for Metal, so the device must accept one of those.
        OpenDevice~: (options: GpuOptions) -> string!? {
            debug = options.debug;
            driverText: string!? = environmentVariable("LANTERN_GPU_DRIVER");
            defer delete driverText;
            requestedDriver~ string? = null;
            if text := driverText {
                if text.length() > 0 {
                    requestedDriver = text;
                }
            }
            formats: Sdl:::SDL_GPUShaderFormat = Sdl:::SDL_GPU_SHADERFORMAT_SPIRV | Sdl:::SDL_GPU_SHADERFORMAT_MSL;
            unsafe {
                device = Sdl:::SDL_CreateGPUDevice(formats, options.debug, requestedDriver);
            }
            if device == null {
                return SdlFailure("SDL_CreateGPUDevice");
            }
            unsafe {
                delete driverName;
                driverName = copyCString(Sdl:::SDL_GetGPUDeviceDriver(device));
            }
            return null;
        }

        // A renderer without a window, drawing only into its own textures: the editor's viewport and tests use it.
        static CreateOffscreen :: (options: GpuOptions) -> Result<GpuRenderer*!, string!> {
            videoStarted~ bool = false;
            unsafe {
                videoStarted = Sdl:::SDL_InitSubSystem(Sdl:::SDL_INIT_VIDEO);
            }
            if !videoStarted {
                return Result<GpuRenderer*!, string!>:::Err(SdlFailure("SDL_InitSubSystem(VIDEO)"));
            }
            renderer := new GpuRenderer();
            renderer->ownsVideoSubsystem = true;
            deviceProblem: string!? = renderer->OpenDevice(options);
            if problem := deviceProblem {
                failure: string! = `${problem}`;
                delete deviceProblem;
                delete renderer;
                unsafe {
                    Sdl:::SDL_QuitSubSystem(Sdl:::SDL_INIT_VIDEO);
                }
                return Result<GpuRenderer*!, string!>:::Err(failure!);
            }
            shaderFormat: ShaderFormat = ChooseShaderFormat(renderer->device);
            srgbSupported~ bool = false;
            unsafe {
                srgbSupported = Sdl:::SDL_GPUTextureSupportsFormat(renderer->device, Sdl:::SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM_SRGB, Sdl:::SDL_GPU_TEXTURETYPE_2D, Sdl:::SDL_GPU_TEXTUREUSAGE_COLOR_TARGET);
            }
            if srgbSupported {
                renderer->colorFormat = Sdl:::SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM_SRGB;
            } else {
                renderer->colorFormat = Sdl:::SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
            }
            renderer->encodeSrgbInShader = !srgbSupported;
            renderer->depthFormat = ChooseDepthFormat(renderer->device);
            return GpuRenderer:::Finish(renderer!, shaderFormat);
        }

        // A renderer that draws to a window: claim the window's swapchain for the device, then pick formats.
        static Create :: (window: raw Sdl:::SDL_Window~*, options: GpuOptions) -> Result<GpuRenderer*!, string!> {
            renderer := new GpuRenderer();
            renderer->window = window;
            deviceProblem: string!? = renderer->OpenDevice(options);
            if problem := deviceProblem {
                failure: string! = `${problem}`;
                delete deviceProblem;
                delete renderer;
                return Result<GpuRenderer*!, string!>:::Err(failure!);
            }
            shaderFormat: ShaderFormat = ChooseShaderFormat(renderer->device);
            claimed~ bool = false;
            unsafe {
                claimed = Sdl:::SDL_ClaimWindowForGPUDevice(renderer->device, window);
            }
            if !claimed {
                failure: string! = SdlFailure("SDL_ClaimWindowForGPUDevice");
                delete renderer;
                return Result<GpuRenderer*!, string!>:::Err(failure!);
            }
            renderer->windowClaimed = true;
            renderer->encodeSrgbInShader = ConfigureSwapchain(renderer->device, window, options.vsync);
            unsafe {
                renderer->colorFormat = Sdl:::SDL_GetGPUSwapchainTextureFormat(renderer->device, window);
            }
            renderer->depthFormat = ChooseDepthFormat(renderer->device);
            return GpuRenderer:::Finish(renderer!, shaderFormat);
        }

        // The steps both kinds of renderer share once the device and colour format are known: build the three
        // pipelines, the samplers and the white texture.
        static Finish :: (renderer: GpuRenderer*!, shaderFormat: ShaderFormat) -> Result<GpuRenderer*!, string!> {
            debugName~ string = "off";
            if renderer->debug {
                debugName = "on";
            }
            outputName~ string = "hardware sRGB";
            if renderer->encodeSrgbInShader {
                outputName = "shader-encoded sRGB";
            }
            targetName~ string = "swapchain";
            if renderer->ownsVideoSubsystem {
                targetName = "off-screen colour";
            }
            message: string! = `GPU driver: ${renderer->driverName} (${ShaderFormatName(shaderFormat)} shaders), debug ${debugName}, ${targetName} format ${renderer->colorFormat}, depth format ${renderer->depthFormat}, ${outputName} output`;
            lantern:::core:::LogInfo("renderer", message);
            delete message;
            when CreatePipelines(renderer->device, shaderFormat, renderer->colorFormat, renderer->depthFormat) {
                Result:::Ok(created) -> {
                    renderer->pipelines = created;
                },
                Result:::Err(failure) -> {
                    delete renderer;
                    return Result<GpuRenderer*!, string!>:::Err(failure!);
                }
            }
            if created := Samplers:::Create(renderer->device) {
                renderer->samplers = created;
            } else {
                failure: string! = SdlFailure("SDL_CreateGPUSampler");
                delete renderer;
                return Result<GpuRenderer*!, string!>:::Err(failure!);
            }
            white := lantern:::renderer:::TextureData:::Solid(lantern:::core:::Color:::White());
            defer delete white;
            when UploadTexture(renderer->device, renderer->samplers, white) {
                Result:::Ok(uploaded) -> {
                    renderer->whiteTexture = uploaded;
                },
                Result:::Err(failure) -> {
                    delete renderer;
                    return Result<GpuRenderer*!, string!>:::Err(failure!);
                }
            }
            return Result<GpuRenderer*!, string!>:::Ok(renderer!);
        }

        ReleaseDevice~: () -> void {
            if device == null {
                return;
            }
            videoInitialised~ bool = false;
            unsafe {
                videoInitialised = Sdl:::SDL_WasInit(Sdl:::SDL_INIT_VIDEO) != 0;
            }
            if !videoInitialised {
                lantern:::core:::LogWarn("renderer", "SDL video was shut down before the GPU device; the device is not destroyed");
                device = null;
                return;
            }
            unsafe {
                Sdl:::SDL_WaitForGPUIdle(device);
            }
            liveMeshes: Array<GpuMesh>! = meshes->Drain();
            for mesh in liveMeshes {
                mesh.Release(device);
            }
            delete liveMeshes;
            liveTextures: Array<GpuTexture>! = textures->Drain();
            for texture in liveTextures {
                texture.Release(device);
            }
            delete liveTextures;
            whiteTexture.Release(device);
            lineBuffer.Release(device);
            overlayBuffer.Release(device);
            unsafe {
                if depthTexture != null {
                    Sdl:::SDL_ReleaseGPUTexture(device, depthTexture);
                }
            }
            samplers.Release(device);
            pipelines.Release(device);
            ReleaseOffscreenTarget();
            unsafe {
                if windowClaimed {
                    Sdl:::SDL_ReleaseWindowFromGPUDevice(device, window);
                }
                Sdl:::SDL_DestroyGPUDevice(device);
            }
            device = null;
            lantern:::core:::LogInfo("renderer", "GPU device destroyed");
            if ownsVideoSubsystem {
                unsafe {
                    Sdl:::SDL_QuitSubSystem(Sdl:::SDL_INIT_VIDEO);
                }
                ownsVideoSubsystem = false;
            }
        }

        DriverName :: () -> string {
            return driverName;
        }

        DebugEnabled :: () -> bool {
            return debug;
        }

        MeshCount :: () -> usize {
            return meshes->Length();
        }

        TextureCount :: () -> usize {
            return textures->Length();
        }

        CreateMesh~: (mesh: lantern:::renderer:::MeshData*) -> Result<lantern:::core:::Handle<lantern:::renderer:::MeshTag>, string!> {
            problem: string!? = mesh->Validate();
            if invalid := problem {
                text: string! = `${invalid}`;
                delete problem;
                return Result<lantern:::core:::Handle<lantern:::renderer:::MeshTag>, string!>:::Err(text!);
            }
            when UploadMesh(device, mesh) {
                Result:::Ok(uploaded) -> {
                    handle: lantern:::core:::Handle<GpuMesh> = meshes->Insert(uploaded);
                    return Result<lantern:::core:::Handle<lantern:::renderer:::MeshTag>, string!>:::Ok(lantern:::core:::CastHandle<GpuMesh, lantern:::renderer:::MeshTag>(handle));
                },
                Result:::Err(failure) -> {
                    return Result<lantern:::core:::Handle<lantern:::renderer:::MeshTag>, string!>:::Err(failure!);
                }
            }
        }

        RemoveMesh~: (handle: lantern:::core:::Handle<lantern:::renderer:::MeshTag>) -> void {
            if removed := meshes->Remove(lantern:::core:::CastHandle<lantern:::renderer:::MeshTag, GpuMesh>(handle)) {
                removed.Release(device);
            }
        }

        CreateTexture~: (texture: lantern:::renderer:::TextureData*) -> Result<lantern:::core:::Handle<lantern:::renderer:::TextureTag>, string!> {
            when UploadTexture(device, samplers, texture) {
                Result:::Ok(uploaded) -> {
                    handle: lantern:::core:::Handle<GpuTexture> = textures->Insert(uploaded);
                    return Result<lantern:::core:::Handle<lantern:::renderer:::TextureTag>, string!>:::Ok(lantern:::core:::CastHandle<GpuTexture, lantern:::renderer:::TextureTag>(handle));
                },
                Result:::Err(failure) -> {
                    return Result<lantern:::core:::Handle<lantern:::renderer:::TextureTag>, string!>:::Err(failure!);
                }
            }
        }

        RemoveTexture~: (handle: lantern:::core:::Handle<lantern:::renderer:::TextureTag>) -> void {
            if removed := textures->Remove(lantern:::core:::CastHandle<lantern:::renderer:::TextureTag, GpuTexture>(handle)) {
                removed.Release(device);
            }
        }

        // A draw with no texture, or a released one, samples the 1x1 white texture, so the shader needs no branch.
        TextureOrWhite :: (handle: lantern:::core:::Handle<lantern:::renderer:::TextureTag>?) -> GpuTexture {
            if wanted := handle {
                if found := textures->Get(lantern:::core:::CastHandle<lantern:::renderer:::TextureTag, GpuTexture>(wanted)) {
                    return found;
                }
            }
            return whiteTexture;
        }

        // One frame to the window. The numbered steps are in the comment at the top of this file.
        Render~: (world: lantern:::renderer:::RenderWorld*) -> Result<lantern:::renderer:::RenderReport, string!> {
            commandBuffer~ raw Sdl:::SDL_GPUCommandBuffer~* = null;
            unsafe {
                commandBuffer = Sdl:::SDL_AcquireGPUCommandBuffer(device);
            }
            if commandBuffer == null {
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(SdlFailure("SDL_AcquireGPUCommandBuffer"));
            }
            uploadProblem: string!? = UploadDynamicGeometry(commandBuffer, world);
            if problem := uploadProblem {
                text: string! = `${problem}`;
                delete uploadProblem;
                unsafe {
                    Sdl:::SDL_CancelGPUCommandBuffer(commandBuffer);
                }
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(text!);
            }
            swapchainTexture~ raw Sdl:::SDL_GPUTexture~* = null;
            width~ u32 = 0;
            height~ u32 = 0;
            acquired~ bool = false;
            unsafe {
                acquired = Sdl:::SDL_WaitAndAcquireGPUSwapchainTexture(commandBuffer, window, swapchainTexture, width, height);
            }
            if !acquired {
                failure: string! = SdlFailure("SDL_WaitAndAcquireGPUSwapchainTexture");
                unsafe {
                    Sdl:::SDL_CancelGPUCommandBuffer(commandBuffer);
                }
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(failure!);
            }
            report~ lantern:::renderer:::RenderReport = lantern:::renderer:::RenderReport { };
            if swapchainTexture == null {
                unsafe {
                    Sdl:::SDL_SubmitGPUCommandBuffer(commandBuffer);
                }
                return Result<lantern:::renderer:::RenderReport, string!>:::Ok(report);
            }
            depthProblem: string!? = EnsureDepthTarget(width, height);
            if problem := depthProblem {
                text: string! = `${problem}`;
                delete depthProblem;
                unsafe {
                    Sdl:::SDL_CancelGPUCommandBuffer(commandBuffer);
                }
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(text!);
            }
            report = RecordFrame(commandBuffer, swapchainTexture, depthTexture, width, height, world);
            submitted~ bool = false;
            unsafe {
                submitted = Sdl:::SDL_SubmitGPUCommandBuffer(commandBuffer);
            }
            if !submitted {
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(SdlFailure("SDL_SubmitGPUCommandBuffer"));
            }
            report.presented = true;
            return Result<lantern:::renderer:::RenderReport, string!>:::Ok(report);
        }

        Capture~: (world: lantern:::renderer:::RenderWorld*, width: u32, height: u32) -> Result<lantern:::renderer:::TextureData*!, string!> {
            color: raw Sdl:::SDL_GPUTexture~* = CreateRenderTexture(device, colorFormat, width, height, false);
            depth: raw Sdl:::SDL_GPUTexture~* = CreateRenderTexture(device, depthFormat, width, height, true);
            byteCount: u32 = width * height * 4;
            download: raw Sdl:::SDL_GPUTransferBuffer~* = CreateTransferBuffer(device, byteCount, false);
            if color == null || depth == null || download == null {
                failure: string! = SdlFailure("creating the capture target");
                ReleaseCaptureTarget(color, depth, download);
                return Result<lantern:::renderer:::TextureData*!, string!>:::Err(failure!);
            }
            commandBuffer~ raw Sdl:::SDL_GPUCommandBuffer~* = null;
            unsafe {
                commandBuffer = Sdl:::SDL_AcquireGPUCommandBuffer(device);
            }
            if commandBuffer == null {
                failure: string! = SdlFailure("SDL_AcquireGPUCommandBuffer");
                ReleaseCaptureTarget(color, depth, download);
                return Result<lantern:::renderer:::TextureData*!, string!>:::Err(failure!);
            }
            uploadProblem: string!? = UploadDynamicGeometry(commandBuffer, world);
            if problem := uploadProblem {
                text: string! = `${problem}`;
                delete uploadProblem;
                unsafe {
                    Sdl:::SDL_CancelGPUCommandBuffer(commandBuffer);
                }
                ReleaseCaptureTarget(color, depth, download);
                return Result<lantern:::renderer:::TextureData*!, string!>:::Err(text!);
            }
            RecordFrame(commandBuffer, color, depth, width, height, world);
            fence~ raw Sdl:::SDL_GPUFence~* = null;
            unsafe {
                source := Sdl:::SDL_GPUTextureRegion { texture: color, w: width, h: height, d: 1 };
                destination := Sdl:::SDL_GPUTextureTransferInfo { transfer_buffer: download };
                copyPass := Sdl:::SDL_BeginGPUCopyPass(commandBuffer);
                Sdl:::SDL_DownloadFromGPUTexture(copyPass, source, destination);
                Sdl:::SDL_EndGPUCopyPass(copyPass);
                fence = Sdl:::SDL_SubmitGPUCommandBufferAndAcquireFence(commandBuffer);
            }
            if fence == null {
                failure: string! = SdlFailure("SDL_SubmitGPUCommandBufferAndAcquireFence");
                ReleaseCaptureTarget(color, depth, download);
                return Result<lantern:::renderer:::TextureData*!, string!>:::Err(failure!);
            }
            captured := new lantern:::renderer:::TextureData(width, height, lantern:::renderer:::TextureFilter:::Nearest, lantern:::renderer:::TextureWrap:::Clamp);
            for byteIndex~ u32 = 0; byteIndex < byteCount; byteIndex += 1 {
                captured->rgba8.push(0);
            }
            mapped~ raw u8~* = null;
            unsafe {
                Sdl:::SDL_WaitForGPUFences(device, true, fence, 1);
                Sdl:::SDL_ReleaseGPUFence(device, fence);
                mapped = Sdl:::SDL_MapGPUTransferBuffer(device, download, false);
                if mapped != null {
                    lantern:::copyreadback:::memcpy(captured->rgba8.borrow().mutable(), mapped, usize(byteCount));
                    Sdl:::SDL_UnmapGPUTransferBuffer(device, download);
                }
            }
            if mapped == null {
                failure: string! = SdlFailure("SDL_MapGPUTransferBuffer");
                delete captured;
                ReleaseCaptureTarget(color, depth, download);
                return Result<lantern:::renderer:::TextureData*!, string!>:::Err(failure!);
            }
            ReleaseCaptureTarget(color, depth, download);
            if IsBgra(colorFormat) {
                for pixelOffset~ usize = 0; pixelOffset < usize(byteCount); pixelOffset += 4 {
                    blue: u8 = captured->rgba8[pixelOffset];
                    captured->rgba8[pixelOffset] = captured->rgba8[pixelOffset + 2];
                    captured->rgba8[pixelOffset + 2] = blue;
                }
            }
            return Result<lantern:::renderer:::TextureData*!, string!>:::Ok(captured!);
        }

        ReleaseOffscreenTarget~: () -> void {
            ReleaseCaptureTarget(offscreenColor, offscreenDepth, offscreenDownload);
            offscreenColor = null;
            offscreenDepth = null;
            offscreenDownload = null;
            offscreenWidth = 0;
            offscreenHeight = 0;
        }

        EnsureOffscreenTarget~: (width: u32, height: u32) -> string!? {
            if offscreenColor != null && offscreenWidth == width && offscreenHeight == height {
                return null;
            }
            if offscreenColor != null {
                unsafe {
                    Sdl:::SDL_WaitForGPUIdle(device);
                }
                ReleaseOffscreenTarget();
            }
            color: raw Sdl:::SDL_GPUTexture~* = CreateRenderTexture(device, colorFormat, width, height, false);
            depth: raw Sdl:::SDL_GPUTexture~* = CreateRenderTexture(device, depthFormat, width, height, true);
            download: raw Sdl:::SDL_GPUTransferBuffer~* = CreateTransferBuffer(device, width * height * 4, false);
            if color == null || depth == null || download == null {
                failure: string! = SdlFailure("creating the off-screen target");
                ReleaseCaptureTarget(color, depth, download);
                return failure!;
            }
            offscreenColor = color;
            offscreenDepth = depth;
            offscreenDownload = download;
            offscreenWidth = width;
            offscreenHeight = height;
            return null;
        }

        RenderOffscreen~: (world: lantern:::renderer:::RenderWorld*, requestedWidth: u32, requestedHeight: u32, pixels: Array<u8>!~*) -> Result<lantern:::renderer:::RenderReport, string!> {
            width: u32 = when (requestedWidth == 0) { true -> 1, false -> requestedWidth };
            height: u32 = when (requestedHeight == 0) { true -> 1, false -> requestedHeight };
            targetProblem: string!? = EnsureOffscreenTarget(width, height);
            if problem := targetProblem {
                text: string! = `${problem}`;
                delete targetProblem;
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(text!);
            }
            byteCount: u32 = width * height * 4;
            commandBuffer~ raw Sdl:::SDL_GPUCommandBuffer~* = null;
            unsafe {
                commandBuffer = Sdl:::SDL_AcquireGPUCommandBuffer(device);
            }
            if commandBuffer == null {
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(SdlFailure("SDL_AcquireGPUCommandBuffer"));
            }
            uploadProblem: string!? = UploadDynamicGeometry(commandBuffer, world);
            if problem := uploadProblem {
                text: string! = `${problem}`;
                delete uploadProblem;
                unsafe {
                    Sdl:::SDL_CancelGPUCommandBuffer(commandBuffer);
                }
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(text!);
            }
            report: lantern:::renderer:::RenderReport = RecordFrame(commandBuffer, offscreenColor, offscreenDepth, width, height, world);
            fence~ raw Sdl:::SDL_GPUFence~* = null;
            unsafe {
                source := Sdl:::SDL_GPUTextureRegion { texture: offscreenColor, w: width, h: height, d: 1 };
                destination := Sdl:::SDL_GPUTextureTransferInfo { transfer_buffer: offscreenDownload };
                copyPass := Sdl:::SDL_BeginGPUCopyPass(commandBuffer);
                Sdl:::SDL_DownloadFromGPUTexture(copyPass, source, destination);
                Sdl:::SDL_EndGPUCopyPass(copyPass);
                fence = Sdl:::SDL_SubmitGPUCommandBufferAndAcquireFence(commandBuffer);
            }
            if fence == null {
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(SdlFailure("SDL_SubmitGPUCommandBufferAndAcquireFence"));
            }
            while pixels->length() < usize(byteCount) {
                pixels->push(0);
            }
            while pixels->length() > usize(byteCount) {
                pixels->pop();
            }
            mapped~ raw u8~* = null;
            unsafe {
                Sdl:::SDL_WaitForGPUFences(device, true, fence, 1);
                Sdl:::SDL_ReleaseGPUFence(device, fence);
                mapped = Sdl:::SDL_MapGPUTransferBuffer(device, offscreenDownload, false);
                if mapped != null {
                    lantern:::copyreadback:::memcpy(pixels->borrow().mutable(), mapped, usize(byteCount));
                    Sdl:::SDL_UnmapGPUTransferBuffer(device, offscreenDownload);
                }
            }
            if mapped == null {
                return Result<lantern:::renderer:::RenderReport, string!>:::Err(SdlFailure("SDL_MapGPUTransferBuffer"));
            }
            if IsBgra(colorFormat) {
                for pixelOffset~ usize = 0; pixelOffset < usize(byteCount); pixelOffset += 4 {
                    blue: u8 = pixels[pixelOffset];
                    pixels[pixelOffset] = pixels[pixelOffset + 2];
                    pixels[pixelOffset + 2] = blue;
                }
            }
            presentedReport~ lantern:::renderer:::RenderReport = report;
            presentedReport.presented = true;
            return Result<lantern:::renderer:::RenderReport, string!>:::Ok(presentedReport);
        }

        ReleaseCaptureTarget :: (color: raw Sdl:::SDL_GPUTexture~*, depth: raw Sdl:::SDL_GPUTexture~*, download: raw Sdl:::SDL_GPUTransferBuffer~*) -> void {
            unsafe {
                if download != null {
                    Sdl:::SDL_ReleaseGPUTransferBuffer(device, download);
                }
                if color != null {
                    Sdl:::SDL_ReleaseGPUTexture(device, color);
                }
                if depth != null {
                    Sdl:::SDL_ReleaseGPUTexture(device, depth);
                }
            }
        }

        // Lines and overlay vertices change every frame, so they are copied into GPU buffers each frame. A copy pass
        // maps a staging buffer the CPU can write, then copies it into the vertex buffer the pipeline reads.
        UploadDynamicGeometry~: (commandBuffer: raw Sdl:::SDL_GPUCommandBuffer~*, world: lantern:::renderer:::RenderWorld*) -> string!? {
            lineByteCount: u32 = u32(world->lines.length()) * lantern:::renderer:::LINE_VERTEX_STRIDE;
            overlayByteCount: u32 = u32(world->overlay->vertices.length()) * lantern:::renderer:::OVERLAY_VERTEX_STRIDE;
            if lineByteCount == 0 && overlayByteCount == 0 {
                return null;
            }
            lineProblem: string!? = lineBuffer.Reserve(device, lineByteCount);
            if problem := lineProblem {
                text: string! = `${problem}`;
                delete lineProblem;
                return text!;
            }
            overlayProblem: string!? = overlayBuffer.Reserve(device, overlayByteCount);
            if problem := overlayProblem {
                text: string! = `${problem}`;
                delete overlayProblem;
                return text!;
            }
            unsafe {
                copyPass := Sdl:::SDL_BeginGPUCopyPass(commandBuffer);
                if lineByteCount > 0 {
                    mapped: raw u8~* = lineBuffer.Map(device);
                    if mapped != null {
                        lantern:::copylines:::memcpy(mapped, world->lines, usize(lineByteCount));
                        lineBuffer.FinishUpload(device, copyPass, lineByteCount);
                    }
                }
                if overlayByteCount > 0 {
                    mapped: raw u8~* = overlayBuffer.Map(device);
                    if mapped != null {
                        lantern:::copyoverlay:::memcpy(mapped, world->overlay->vertices, usize(overlayByteCount));
                        overlayBuffer.FinishUpload(device, copyPass, overlayByteCount);
                    }
                }
                Sdl:::SDL_EndGPUCopyPass(copyPass);
            }
            return null;
        }

        // The depth buffer must match the colour target's size, so it is recreated when the window resizes.
        EnsureDepthTarget~: (width: u32, height: u32) -> string!? {
            if depthTexture != null && depthWidth == width && depthHeight == height {
                return null;
            }
            unsafe {
                if depthTexture != null {
                    Sdl:::SDL_ReleaseGPUTexture(device, depthTexture);
                }
            }
            depthTexture = CreateRenderTexture(device, depthFormat, width, height, true);
            if depthTexture == null {
                return SdlFailure("SDL_CreateGPUTexture");
            }
            depthWidth = width;
            depthHeight = height;
            message: string! = `depth buffer recreated at ${width}x${height}`;
            lantern:::core:::LogDebug("renderer", message);
            delete message;
            return null;
        }

        // Culling: a draw whose mesh bounds, moved by its transform, lie wholly outside the camera's view volume
        // can't put a pixel on screen, so it is dropped before any GPU work. The rest are sorted (GpuDrawList.nox).
        CollectVisibleDraws :: (world: lantern:::renderer:::RenderWorld*, frustum: lantern:::renderer:::Frustum, report: lantern:::renderer:::RenderReport~*) -> Array<VisibleDraw>! {
            visible~ Array<VisibleDraw>! = [];
            for drawIndex~ usize = 0; drawIndex < world->draws.length(); drawIndex++ {
                draw: lantern:::renderer:::DrawItem = world->draws[drawIndex];
                if mesh := meshes->Get(lantern:::core:::CastHandle<lantern:::renderer:::MeshTag, GpuMesh>(draw.mesh)) {
                    if !frustum.Intersects(mesh.bounds.Transformed(draw.transform)) {
                        report->drawsCulled += 1;
                        continue;
                    }
                    textureKey~ u32 = UNTEXTURED_KEY;
                    if texture := draw.texture {
                        textureKey = texture.Index();
                    }
                    visible.push(VisibleDraw { textureKey: textureKey, meshIndex: draw.mesh.Index(), drawIndex: drawIndex });
                } else {
                    message: string! = `draw item ${drawIndex} uses a released mesh`;
                    lantern:::core:::LogWarn("renderer", message);
                    delete message;
                }
            }
            sorted: Array<VisibleDraw>! = SortedVisibleDraws(visible);
            delete visible;
            return sorted!;
        }

        // Records one whole frame into `colorTexture`, which is the swapchain image or an off-screen texture.
        //
        // A render pass is a stretch of drawing into a fixed set of targets. Its "load op" says what the targets
        // start as (CLEAR: the clear colour, and depth 1.0, the far plane) and its "store op" whether to keep them
        // afterwards (the colour, yes; the depth, no one reads it again). Inside the one pass, three steps draw in
        // order, each with its own pipeline: the lit meshes, the debug lines, then the 2D overlay on top.
        RecordFrame~: (commandBuffer: raw Sdl:::SDL_GPUCommandBuffer~*, colorTexture: raw Sdl:::SDL_GPUTexture~*, depthTarget: raw Sdl:::SDL_GPUTexture~*, width: u32, height: u32, world: lantern:::renderer:::RenderWorld*) -> lantern:::renderer:::RenderReport {
            report~ lantern:::renderer:::RenderReport = lantern:::renderer:::RenderReport { };
            clear~ lantern:::core:::Color = world->clearColor;
            encodeFlag~ f32 = 0.0f;
            if encodeSrgbInShader {
                clear = EncodeSrgb(world->clearColor);
                encodeFlag = 1.0f;
            }
            safeHeight~ u32 = height;
            if safeHeight < 1 {
                safeHeight = 1;
            }
            aspect: f32 = f32(width) / f32(safeHeight);
            viewProjection: Mat4 = world->camera.ViewProjection(aspect);
            frustum: lantern:::renderer:::Frustum = lantern:::renderer:::Frustum:::FromViewProjection(viewProjection);
            visibleDraws: Array<VisibleDraw>! = CollectVisibleDraws(world, frustum, report);
            defer delete visibleDraws;
            unsafe {
                colorTarget := Sdl:::SDL_GPUColorTargetInfo {
                    texture: colorTexture,
                    clear_color: Sdl:::SDL_FColor { r: clear.r, g: clear.g, b: clear.b, a: 1.0f },
                    load_op: Sdl:::SDL_GPU_LOADOP_CLEAR,
                    store_op: Sdl:::SDL_GPU_STOREOP_STORE
                };
                depthTargetInfo := Sdl:::SDL_GPUDepthStencilTargetInfo {
                    texture: depthTarget,
                    clear_depth: 1.0f,
                    load_op: Sdl:::SDL_GPU_LOADOP_CLEAR,
                    store_op: Sdl:::SDL_GPU_STOREOP_DONT_CARE,
                    stencil_load_op: Sdl:::SDL_GPU_LOADOP_DONT_CARE,
                    stencil_store_op: Sdl:::SDL_GPU_STOREOP_DONT_CARE,
                    cycle: true
                };
                pass := Sdl:::SDL_BeginGPURenderPass(commandBuffer, colorTarget, 1, depthTargetInfo);
                DrawMeshes(commandBuffer, pass, world, visibleDraws, viewProjection, encodeFlag, report);
                DrawLines(commandBuffer, pass, world, viewProjection, encodeFlag, report);
                DrawOverlay(commandBuffer, pass, world, width, height, encodeFlag);
                Sdl:::SDL_EndGPURenderPass(pass);
            }
            return report;
        }

        // Step 1: the lit meshes. The per-frame uniforms (camera and light) are pushed once; then for each visible
        // draw, rebind the mesh and texture only if they changed, push the per-draw uniforms and draw its indices.
        DrawMeshes~: (commandBuffer: raw Sdl:::SDL_GPUCommandBuffer~*, pass: raw Sdl:::SDL_GPURenderPass~*, world: lantern:::renderer:::RenderWorld*, visibleDraws: Array<VisibleDraw>, viewProjection: Mat4, encodeFlag: f32, report: lantern:::renderer:::RenderReport~*) -> void {
            cameraPosition: Vec3 = world->camera.position;
            frameUniforms := MatrixAndVectorUniforms { matrix: viewProjection.elements, vector: [cameraPosition.x, cameraPosition.y, cameraPosition.z, 1.0f] };
            directionToLight: Vec3 = lantern:::core:::NormalizeOr3(Vec3 { } - world->light.direction, lantern:::core:::WorldUp());
            lightUniforms := LightUniforms {
                directionToLight: [directionToLight.x, directionToLight.y, directionToLight.z, 0.0f],
                lightColor: world->light.color.ToArray(),
                ambientColor: world->light.ambient.ToArray(),
                fogColor: world->clearColor.ToArray(),
                fogAndOutput: [world->fogStart, world->fogEnd, 0.0f, encodeFlag],
                cameraPosition: [cameraPosition.x, cameraPosition.y, cameraPosition.z, 1.0f]
            };
            unsafe {
                Sdl:::SDL_BindGPUGraphicsPipeline(pass, pipelines.lit);
                PushVertexUniforms(commandBuffer, 0, reinterpret<u8>(frameUniforms), 80);
                PushFragmentUniforms(commandBuffer, 0, reinterpret<u8>(lightUniforms), 96);
                boundMesh~ u32 = NO_BINDING;
                boundTexture~ u32 = NO_BINDING;
                textureBound~ bool = false;
                for visible in visibleDraws {
                    draw: lantern:::renderer:::DrawItem = world->draws[visible.drawIndex];
                    if mesh := meshes->Get(lantern:::core:::CastHandle<lantern:::renderer:::MeshTag, GpuMesh>(draw.mesh)) {
                        if visible.meshIndex != boundMesh {
                            vertexBinding := Sdl:::SDL_GPUBufferBinding { buffer: mesh.vertexBuffer, offset: 0 };
                            indexBinding := Sdl:::SDL_GPUBufferBinding { buffer: mesh.indexBuffer, offset: 0 };
                            Sdl:::SDL_BindGPUVertexBuffers(pass, 0, vertexBinding, 1);
                            Sdl:::SDL_BindGPUIndexBuffer(pass, indexBinding, Sdl:::SDL_GPU_INDEXELEMENTSIZE_32BIT);
                            boundMesh = visible.meshIndex;
                        }
                        if !textureBound || boundTexture != visible.textureKey {
                            texture: GpuTexture = TextureOrWhite(draw.texture);
                            samplerBinding := Sdl:::SDL_GPUTextureSamplerBinding { texture: texture.texture, sampler: texture.sampler };
                            Sdl:::SDL_BindGPUFragmentSamplers(pass, 0, samplerBinding, 1);
                            boundTexture = visible.textureKey;
                            textureBound = true;
                        }
                        objectUniforms := ObjectUniforms { model: draw.transform.elements, normalMatrix: NormalMatrix4(draw.transform) };
                        colorUniforms := VectorUniforms { values: draw.color.ToArray() };
                        PushVertexUniforms(commandBuffer, 1, reinterpret<u8>(objectUniforms), 128);
                        PushFragmentUniforms(commandBuffer, 1, reinterpret<u8>(colorUniforms), 16);
                        Sdl:::SDL_DrawGPUIndexedPrimitives(pass, mesh.indexCount, 1, 0, 0, 0);
                        report->drawsSubmitted += 1;
                        report->triangles += u64(mesh.indexCount / 3);
                    }
                }
            }
        }

        // Step 2: debug lines, two vertices each, already uploaded to lineBuffer. They test against the depth the
        // meshes wrote, so walls hide them, but don't write depth themselves.
        DrawLines~: (commandBuffer: raw Sdl:::SDL_GPUCommandBuffer~*, pass: raw Sdl:::SDL_GPURenderPass~*, world: lantern:::renderer:::RenderWorld*, viewProjection: Mat4, encodeFlag: f32, report: lantern:::renderer:::RenderReport~*) -> void {
            lineVertexCount: u32 = u32(world->lines.length());
            if lineVertexCount == 0 {
                return;
            }
            unsafe {
                Sdl:::SDL_BindGPUGraphicsPipeline(pass, pipelines.lines);
                lineUniforms := MatrixAndVectorUniforms { matrix: viewProjection.elements, vector: [0.0f, 0.0f, 0.0f, encodeFlag] };
                PushVertexUniforms(commandBuffer, 0, reinterpret<u8>(lineUniforms), 80);
                lineBinding := Sdl:::SDL_GPUBufferBinding { buffer: lineBuffer.buffer, offset: 0 };
                Sdl:::SDL_BindGPUVertexBuffers(pass, 0, lineBinding, 1);
                Sdl:::SDL_DrawGPUPrimitives(pass, lineVertexCount, 1, 0, 0);
            }
            report->lineCount = lineVertexCount / 2;
        }

        // Step 3: the 2D overlay (HUD, menus, text) in screen pixels, with no depth test so it lands on top of
        // everything. Every quad samples the font atlas; solid quads use its white cell.
        DrawOverlay~: (commandBuffer: raw Sdl:::SDL_GPUCommandBuffer~*, pass: raw Sdl:::SDL_GPURenderPass~*, world: lantern:::renderer:::RenderWorld*, width: u32, height: u32, encodeFlag: f32) -> void {
            overlayVertexCount: u32 = u32(world->overlay->vertices.length());
            if overlayVertexCount == 0 {
                return;
            }
            atlas: GpuTexture = TextureOrWhite(world->overlayTexture);
            unsafe {
                Sdl:::SDL_BindGPUGraphicsPipeline(pass, pipelines.overlay);
                screenUniforms := VectorUniforms { values: [f32(width), f32(height), 0.0f, encodeFlag] };
                PushVertexUniforms(commandBuffer, 0, reinterpret<u8>(screenUniforms), 16);
                atlasBinding := Sdl:::SDL_GPUTextureSamplerBinding { texture: atlas.texture, sampler: atlas.sampler };
                Sdl:::SDL_BindGPUFragmentSamplers(pass, 0, atlasBinding, 1);
                overlayBinding := Sdl:::SDL_GPUBufferBinding { buffer: overlayBuffer.buffer, offset: 0 };
                Sdl:::SDL_BindGPUVertexBuffers(pass, 0, overlayBinding, 1);
                Sdl:::SDL_DrawGPUPrimitives(pass, overlayVertexCount, 1, 0, 0);
            }
        }
    }
}
