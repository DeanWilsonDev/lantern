// A material graph: the node graph that decides how a material Silhouette's surface looks (docs/material-graphs.md). It is an
// ordinary graph file, one function called `material` whose nodes are the `mat_` kinds below, so the graph tab's canvas, file
// format and editing work on it unchanged.
//
// The graph never runs. `GenerateMaterialShader` turns it into GLSL: a `SurfaceOf` function that sits between
// `lit-common.glsl` and `lit-main.glsl`, so the material gets a lit fragment shader of its own and the lighting code stays in
// one place. The bake compiles that shader, and the game only ever sees the compiled result.
//
// | Kind | Ports | Gives |
// | --- | --- | --- |
// | `mat_scalar` | `a`: a literal such as `#0.5f` | a number |
// | `mat_color` | `text`: `#RRGGBB` | a colour |
// | `mat_param` | `name`: a value of the Silhouette's `properties`; `a`: the default | a number |
// | `mat_uv` | | the surface's texture coordinate |
// | `mat_texture` | `name`: a texture in `textures/`; `a`: the coordinate (the surface's own when unwired) | a colour |
// | `mat_normal_map` | `name`: a normal-map texture; `a`: the coordinate; `b`: strength (1) | a tangent-space normal |
// | `mat_add` `mat_sub` `mat_mul` | `a`, `b` | the sum, difference or product, per channel; a number joins anything |
// | `mat_lerp` | `a`, `b`, `value` | `a` towards `b` by `value` |
// | `mat_one_minus` `mat_clamp` | `a` | `1 - a`, or `a` held between 0 and 1 |
// | `mat_output` | `arg0` base colour, `arg1` metallic, `arg2` roughness, `arg3` emissive, `arg4` normal | the material |
lantern:::materialgraph :: namespace {
    MATERIAL_FUNCTION_NAME: string : "material";
    OUTPUT_KIND: string : "mat_output";
    FIRST_TEXTURE_BINDING: u32 : 4;
    MAX_MATERIAL_TEXTURES: usize : 4;
    MAX_NODE_DEPTH: i32 : 64;

    // The ports of the output node, in `arguments` order.
    OutputPortName :: (portIndex: usize) -> string {
        names: string[5] = ["base colour", "metallic", "roughness", "emissive", "normal"];
        return names[portIndex];
    }

    OUTPUT_PORT_COUNT: usize : 5;

    // The GLSL type of a node's value. A number joins any other type, as GLSL lets it.
    ValueShape :: enum {
        Number,
        Coordinate,
        Color,
        Normal
    }

    GlslTypeOf :: (shape: ValueShape) -> string {
        return when shape {
            ValueShape:::Number -> "float",
            ValueShape:::Coordinate -> "vec2",
            ValueShape:::Color -> "vec3",
            ValueShape:::Normal -> "vec3"
        };
    }

    // One generated material shader: the GLSL text and the textures it samples, in binding order from binding 4.
    MaterialShader :: class {
    public:
        source~ string!;
        textureNames~ Array<string!>! = [];

        MaterialShader~: () {
            source = "".copy();
        }

        !MaterialShader~: () {
            delete source;
            textureNames.freeAll();
        }
    }

    // What the generator has written so far: the statements of SurfaceOf, which nodes they cover, and each node's shape.
    ShaderWriter :: class {
    public:
        statements~ string!;
        failure~ string!;
        writtenIds~ Array<string!>! = [];
        writtenShapes~ Array<ValueShape>! = [];
        textureNames~ Array<string!>! = [];
        parameterNames~ Array<string!>! = [];
        parameterValues~ Array<f32>! = [];

        ShaderWriter~: () {
            statements = "".copy();
            failure = "".copy();
        }

        !ShaderWriter~: () {
            delete statements;
            delete failure;
            writtenIds.freeAll();
            delete writtenShapes;
            textureNames.freeAll();
            parameterNames.freeAll();
            delete parameterValues;
        }

        ShapeOfWritten :: (nodeId: string) -> ValueShape? {
            for index~ usize = 0; index < writtenIds.length(); index++ {
                if writtenIds[index] == nodeId {
                    return writtenShapes[index];
                }
            }
            return null;
        }

        // The binding slot of a texture, adding it when it is new. Null when the material already samples four textures.
        TextureSlot~: (textureName: string) -> usize? {
            for index~ usize = 0; index < textureNames.length(); index++ {
                if textureNames[index] == textureName {
                    return index;
                }
            }
            if textureNames.length() >= MAX_MATERIAL_TEXTURES {
                return null;
            }
            textureNames.push(`${textureName}`);
            return textureNames.length() - 1;
        }

        KeepFailure~: (message: string!) -> void {
            delete failure;
            failure = message!;
        }

        TakeFailure~: () -> string! {
            taken: string! = failure!;
            failure = "".copy();
            return taken!;
        }

        ParameterValue :: (parameterName: string) -> f32? {
            for index~ usize = 0; index < parameterNames.length(); index++ {
                if parameterNames[index] == parameterName {
                    return parameterValues[index];
                }
            }
            return null;
        }
    }

    // One value as the generator writes it: its GLSL expression and its shape.
    GlslValue :: class {
    public:
        expression~ string!;
        shape~ ValueShape;

        GlslValue~: (newExpression: string, newShape: ValueShape) {
            expression = `${newExpression}`;
            shape = newShape;
        }

        !GlslValue~: () {
            delete expression;
        }
    }

    // A number as GLSL writes it: always with a decimal point, so `1` is `1.0`.
    GlslFloat :: (value: f32) -> string! {
        text~ string! = `${value}`;
        if !text.contains(".") && !text.contains("e") {
            text += ".0";
        }
        return text!;
    }

    ParseNumber :: (text: string) -> f32? {
        body~ string = text;
        if body.endsWith("f") {
            body = body.substring(0, body.length() - 1);
        }
        when lantern:::json:::Parse(body) {
            Result:::Err(message) -> {
                delete message;
                return null;
            },
            Result:::Ok(parsed) -> {
                defer delete parsed;
                if parsed->Kind(parsed->root) != lantern:::json:::JsonKind:::Number {
                    return null;
                }
                return f32(parsed->Node(parsed->root).number);
            }
        }
    }

    // A literal reference such as `#0.5f`, or null when the text isn't one.
    LiteralNumber :: (reference: string) -> f32? {
        if !reference.startsWith(lantern:::graphs:::LITERAL_MARK) || reference.length() < 2 {
            return null;
        }
        return ParseNumber(reference.substring(1, reference.length() - 1));
    }

    // A texture name as `textures/` holds it: letters, digits, `_`, `-` and `/` for a subfolder.
    IsTextureName :: (text: string) -> bool {
        if text.length() == 0 || text.startsWith("/") || text.contains("..") {
            return false;
        }
        for position~ usize = 0; position < text.length(); position++ {
            byte: u8 = text.byteAt(position);
            isLetter: bool = (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90);
            isDigit: bool = byte >= 48 && byte <= 57;
            if !isLetter && !isDigit && byte != 95 && byte != 45 && byte != 47 {
                return false;
            }
        }
        return true;
    }

    IsMaterialKind :: (kind: string) -> bool {
        return kind == "mat_scalar" || kind == "mat_color" || kind == "mat_param" || kind ==
            "mat_uv" || kind == "mat_texture" || kind == "mat_normal_map"
            || kind == "mat_add" || kind == "mat_sub" || kind == "mat_mul" || kind == "mat_lerp" ||
                kind == "mat_one_minus" || kind == "mat_clamp"
            || kind == OUTPUT_KIND;
    }

    // The expression of `value` widened to `shape`: a number becomes a vector of that number, anything else stays as it is.
    Widened :: (value: GlslValue*, shape: ValueShape) -> string! {
        if value->shape == ValueShape:::Number && shape != ValueShape:::Number {
            return `${GlslTypeOf(shape)}(${value->expression})`;
        }
        return `${value->expression}`;
    }

    // The shape two values combine into, or null when they can't be combined (a coordinate and a colour).
    CombinedShape :: (first: ValueShape, second: ValueShape) -> ValueShape? {
        if first == ValueShape:::Number {
            return second;
        }
        if second == ValueShape:::Number || first == second {
            return first;
        }
        if (first == ValueShape:::Color && second == ValueShape:::Normal) ||
            (first == ValueShape:::Normal && second == ValueShape:::Color) {
            return ValueShape:::Color;
        }
        return null;
    }

    Failure :: (message: string!) -> Result<GlslValue*!, string!> {
        return Result<GlslValue*!, string!>:::Err(message!);
    }

    // The value of a reference: a literal number, or a node (whose statement is written first). An empty reference is `fallback`.
    ValueOfReference :: (
        function: lantern:::graphs:::GraphFunction*,
        writer: ShaderWriter~*,
        reference: string,
        fallback: string,
        fallbackShape: ValueShape,
        depth: i32
    ) -> Result<GlslValue*!, string!> {
        if reference.length() == 0 {
            return Result<GlslValue*!, string!>:::Ok(new GlslValue(fallback, fallbackShape));
        }
        if number := LiteralNumber(reference) {
            text: string! = GlslFloat(number);
            defer delete text;
            return Result<GlslValue*!, string!>:::Ok(new GlslValue(text, ValueShape:::Number));
        }
        guard index := function->IndexOfNode(reference) return Failure(`'${reference}' is neither a number nor a node`);
        return WriteNode(function, writer, function->nodes[index], depth + 1);
    }

    // The value of a reference, or null with the reason kept on the writer.
    Operand :: (
        function: lantern:::graphs:::GraphFunction*,
        writer: ShaderWriter~*,
        reference: string,
        fallback: string,
        fallbackShape: ValueShape,
        depth: i32
    ) -> GlslValue*!? {
        when ValueOfReference(function, writer, reference, fallback, fallbackShape, depth) {
            Result:::Err(message) -> {
                writer->KeepFailure(message!);
                return null;
            },
            Result:::Ok(value) -> {
                return value!;
            }
        }
    }

    Expression :: (text: string!, shape: ValueShape) -> Result<GlslValue*!, string!> {
        value := new GlslValue(text, shape);
        delete text;
        return Result<GlslValue*!, string!>:::Ok(value!);
    }

    // The GLSL expression a node computes, from the locals of the nodes it reads (which are written first).
    NodeExpression :: (
        function: lantern:::graphs:::GraphFunction*,
        writer: ShaderWriter~*,
        node: lantern:::graphs:::GraphNode*,
        depth: i32
    ) -> Result<GlslValue*!, string!> {
        kind: string = node->kind;
        if kind == "mat_scalar" {
            guard number := LiteralNumber(node->a) return Failure(`node '${node->id}' needs a number`);
            return Expression(GlslFloat(number), ValueShape:::Number);
        }
        if kind == "mat_param" {
            if !lantern:::graphs:::IsName(node->name) {
                return Failure(`node '${node->id}' needs the name of a Silhouette value`);
            }
            number: f32 = writer->ParameterValue(node->name) ?? LiteralNumber(node->a) ?? 0.0f;
            return Expression(GlslFloat(number), ValueShape:::Number);
        }
        if kind == "mat_color" {
            guard color := lantern:::world:::ParseHexColor(node->text) return Failure(`node '${node->id}' needs a colour written #RRGGBB`);
            red: string! = GlslFloat(color.r);
            defer delete red;
            green: string! = GlslFloat(color.g);
            defer delete green;
            blue: string! = GlslFloat(color.b);
            defer delete blue;
            return Expression(`vec3(${red}, ${green}, ${blue})`, ValueShape:::Color);
        }
        if kind == "mat_uv" {
            return Expression("uv".copy(), ValueShape:::Coordinate);
        }
        if kind == "mat_texture" || kind == "mat_normal_map" {
            if !IsTextureName(node->name) {
                return Failure(`node '${node->id}' needs the name of a texture`);
            }
            guard slot := writer->TextureSlot(node->name) return Failure(`node '${node->id}': a material samples at most four textures`);
            held := Operand(function, writer, node->a, "uv", ValueShape:::Coordinate, depth);
            defer delete held;
            guard coordinate := held return Failure(writer->TakeFailure());
            if coordinate->shape != ValueShape:::Coordinate {
                return Failure(`node '${node->id}' samples at a coordinate, not a ${GlslTypeOf(coordinate->shape)}`);
            }
            if kind == "mat_texture" {
                return Expression(
                    `texture(material_texture_${slot}, ${coordinate->expression}).rgb`,
                    ValueShape:::Color
                );
            }
            strengthHeld := Operand(function, writer, node->b, "1.0", ValueShape:::Number, depth);
            defer delete strengthHeld;
            guard strength := strengthHeld return Failure(writer->TakeFailure());
            if strength->shape != ValueShape:::Number {
                return Failure(`node '${node->id}' takes a number for its strength, not a ${GlslTypeOf(strength->shape)}`);
            }
            return Expression(
                `ScaleTangentNormal(LinearToSrgbExact(texture(material_texture_${slot}, ${coordinate->expression}).rgb) * 2.0 - 1.0, ${strength->expression})`,
                ValueShape:::Normal
            );
        }
        if kind == "mat_one_minus" || kind == "mat_clamp" {
            held := Operand(function, writer, node->a, "0.0", ValueShape:::Number, depth);
            defer delete held;
            guard input := held return Failure(writer->TakeFailure());
            if kind == "mat_clamp" {
                return Expression(`clamp(${input->expression}, 0.0, 1.0)`, input->shape);
            }
            return Expression(`1.0 - ${input->expression}`, input->shape);
        }
        if kind == "mat_add" || kind == "mat_sub" || kind == "mat_mul" || kind == "mat_lerp" {
            emptyValue: string = kind == "mat_mul" ? "1.0" : "0.0";
            firstHeld := Operand(function, writer, node->a, emptyValue, ValueShape:::Number, depth);
            defer delete firstHeld;
            guard first := firstHeld return Failure(writer->TakeFailure());
            secondHeld := Operand(
                function,
                writer,
                node->b,
                emptyValue,
                ValueShape:::Number,
                depth
            );
            defer delete secondHeld;
            guard second := secondHeld return Failure(writer->TakeFailure());
            guard combined := CombinedShape(
                first->shape,
                second->shape
            ) return Failure(`node '${node->id}' can't combine a ${GlslTypeOf(first->shape)} with a ${GlslTypeOf(second->shape)}`);
            if kind != "mat_lerp" {
                operatorText: string = kind == "mat_add" ? "+" : (kind == "mat_sub" ? "-" : "*");
                return Expression(
                    `${first->expression} ${operatorText} ${second->expression}`,
                    combined
                );
            }
            weightHeld := Operand(function, writer, node->value, "0.5", ValueShape:::Number, depth);
            defer delete weightHeld;
            guard weight := weightHeld return Failure(writer->TakeFailure());
            if weight->shape != ValueShape:::Number {
                return Failure(`node '${node->id}' mixes by a number, not a ${GlslTypeOf(weight->shape)}`);
            }
            firstText: string! = Widened(first, combined);
            defer delete firstText;
            secondText: string! = Widened(second, combined);
            defer delete secondText;
            return Expression(
                `mix(${firstText}, ${secondText}, clamp(${weight->expression}, 0.0, 1.0))`,
                combined
            );
        }
        if kind == OUTPUT_KIND {
            return Failure(`node '${node->id}': the output can't feed another node`);
        }
        return Failure(`node '${node->id}' has the unknown material kind '${kind}'`);
    }

    // Writes the statement for a node, after the statements of every node it reads, and gives its local's name. A node is
    // written once, however many nodes read it.
    WriteNode :: (
        function: lantern:::graphs:::GraphFunction*,
        writer: ShaderWriter~*,
        node: lantern:::graphs:::GraphNode*,
        depth: i32
    ) -> Result<GlslValue*!, string!> {
        if depth > MAX_NODE_DEPTH {
            return Failure(`node '${node->id}' is part of a loop`);
        }
        if !lantern:::graphs:::IsName(node->id) {
            return Failure(`node '${node->id}' needs an id of letters, digits and underscores`);
        }
        local: string! = `node_${node->id}`;
        defer delete local;
        if written := writer->ShapeOfWritten(node->id) {
            return Result<GlslValue*!, string!>:::Ok(new GlslValue(local, written));
        }
        when NodeExpression(function, writer, node, depth) {
            Result:::Err(message) -> {
                return Result<GlslValue*!, string!>:::Err(message!);
            },
            Result:::Ok(computed) -> {
                defer delete computed;
                writer->statements += `    ${GlslTypeOf(computed->shape)} ${local} = ${computed->expression};`;
                writer->statements += "\n";
                writer->writtenIds.push(`${node->id}`);
                writer->writtenShapes.push(computed->shape);
                return Result<GlslValue*!, string!>:::Ok(new GlslValue(local, computed->shape));
            }
        }
    }

    OutputReference :: (node: lantern:::graphs:::GraphNode*, portIndex: usize) -> string {
        if portIndex < node->arguments.length() {
            return node->arguments[portIndex];
        }
        return "";
    }

    // The function called `material`, or null.
    MaterialFunction :: (graph: lantern:::graphs:::Graph*) -> lantern:::graphs:::GraphFunction*? {
        for index~ usize = 0; index < graph->functions.length(); index++ {
            if graph->functions[index]->name == MATERIAL_FUNCTION_NAME {
                return graph->functions[index];
            }
        }
        return null;
    }

    // What an unwired output gives: the same as a material Silhouette with no properties (white, not metallic, roughness 0.8,
    // no light, flat).
    OutputDefault :: (portIndex: usize) -> string {
        defaults: string[5] = ["vec3(1.0)", "0.0", "0.8", "vec3(0.0)", "vec3(0.0, 0.0, 1.0)"];
        return defaults[portIndex];
    }

    OutputShape :: (portIndex: usize) -> ValueShape {
        if portIndex == 1 || portIndex == 2 {
            return ValueShape:::Number;
        }
        if portIndex == 4 {
            return ValueShape:::Normal;
        }
        return ValueShape:::Color;
    }

    // The expression one output port takes: a number widens to a colour, a colour gives its red channel to a number.
    OutputExpression :: (value: GlslValue*, portIndex: usize) -> Result<string!, string!> {
        wanted: ValueShape = OutputShape(portIndex);
        if value->shape == ValueShape:::Coordinate {
            return Result<string!, string!>:::Err(`the ${OutputPortName(portIndex)} output can't take a coordinate`);
        }
        if wanted == ValueShape:::Number && value->shape != ValueShape:::Number {
            return Result<string!, string!>:::Ok(`${value->expression}.r`);
        }
        if portIndex == 4 && value->shape != ValueShape:::Normal {
            return Result<string!, string!>:::Err("the normal output takes a mat_normal_map".copy());
        }
        return Result<string!, string!>:::Ok(Widened(value, wanted));
    }

    // Turns a material graph into its lit fragment shader. `parameterNames` and `parameterValues` are the Silhouette's numeric
    // values, which `mat_param` nodes read (and which are baked into the shader as constants). The error names the node at fault.
    GenerateMaterialShader :: (
        graph: lantern:::graphs:::Graph*,
        parameterNames: Array<string!>,
        parameterValues: Array<f32>
    ) -> Result<MaterialShader*!, string!> {
        guard function := MaterialFunction(graph) return Result<MaterialShader*!, string!>:::Err("a material graph needs a function called 'material'".copy());
        outputIndex~ usize? = null;
        for index~ usize = 0; index < function->nodes.length(); index++ {
            node: lantern:::graphs:::GraphNode* = function->nodes[index];
            if !IsMaterialKind(node->kind) {
                return Result<MaterialShader*!, string!>:::Err(`node '${node->id}' has the kind '${node->kind}', which a material graph doesn't have`);
            }
            if node->kind == OUTPUT_KIND {
                if outputIndex != null {
                    return Result<MaterialShader*!, string!>:::Err("a material graph has more than one mat_output node".copy());
                }
                outputIndex = index;
            }
        }
        guard foundOutput := outputIndex return Result<MaterialShader*!, string!>:::Err("a material graph needs a mat_output node".copy());
        output: lantern:::graphs:::GraphNode* = function->nodes[foundOutput];

        writer := new ShaderWriter();
        defer delete writer;
        for index~ usize = 0; index < parameterNames.length() &&
            index < parameterValues.length(); index++ {
            writer->parameterNames.push(`${parameterNames[index]}`);
            writer->parameterValues.push(parameterValues[index]);
        }
        assignments~ string! = "".copy();
        defer delete assignments;
        fieldNames: string[5] = [
            "base_color",
            "metallic",
            "roughness",
            "emissive",
            "tangent_normal"
        ];
        for portIndex~ usize = 0; portIndex < OUTPUT_PORT_COUNT; portIndex++ {
            when ValueOfReference(
                function,
                writer,
                OutputReference(output, portIndex),
                OutputDefault(portIndex),
                OutputShape(portIndex),
                0
            ) {
                Result:::Err(message) -> {
                    return Result<MaterialShader*!, string!>:::Err(message!);
                },
                Result:::Ok(value) -> {
                    defer delete value;
                    when OutputExpression(value, portIndex) {
                        Result:::Err(message) -> {
                            return Result<MaterialShader*!, string!>:::Err(message!);
                        },
                        Result:::Ok(expression) -> {
                            assignments += `    surface.${fieldNames[portIndex]} = ${expression};`;
                            assignments += "\n";
                            delete expression;
                        }
                    }
                }
            }
        }
        hasNormal: bool = OutputReference(output, 4).length() > 0;
        normalStrength: string = hasNormal ? "1.0" : "0.0";
        assignments += `    surface.normal_strength = ${normalStrength};`;
        assignments += "\n";

        shader := new MaterialShader();
        shader->source += `// Generated from the material graph '${graph->name}' by lantern:::materialgraph. Edit the graph, not this file.`;
        shader->source += "\n";
        shader->source += "#version 450\n";
        shader->source += "#extension GL_GOOGLE_include_directive : require\n";
        shader->source += "#include \"sky-common.glsl\"\n";
        shader->source += "#include \"surface-common.glsl\"\n";
        shader->source += "#include \"lit-common.glsl\"\n\n";
        for slot~ usize = 0; slot < writer->textureNames.length(); slot++ {
            shader->source += `// ${writer->textureNames[slot]}`;
            shader->source += "\n";
            shader->source += `layout(set = 2, binding = ${u32(slot) + FIRST_TEXTURE_BINDING}) uniform sampler2D material_texture_${slot};`;
            shader->source += "\n";
            shader->textureNames.push(`${writer->textureNames[slot]}`);
        }
        shader->source += "\nMaterialSurface SurfaceOf(vec2 uv) {\n";
        shader->source += writer->statements;
        shader->source += "    MaterialSurface surface;\n";
        shader->source += assignments;
        shader->source += "    return surface;\n";
        shader->source += "}\n\n";
        shader->source += "#include \"lit-main.glsl\"\n";
        return Result<MaterialShader*!, string!>:::Ok(shader!);
    }

    // `GenerateMaterialShader` from the text of a `.graph.json` file.
    GenerateMaterialShaderFromText :: (
        jsonText: string,
        parameterNames: Array<string!>,
        parameterValues: Array<f32>
    ) -> Result<MaterialShader*!, string!> {
        when lantern:::graphs:::LoadGraph(jsonText) {
            Result:::Err(message) -> {
                return Result<MaterialShader*!, string!>:::Err(message!);
            },
            Result:::Ok(graph) -> {
                defer delete graph;
                return GenerateMaterialShader(graph, parameterNames, parameterValues);
            }
        }
    }
}
