// The C maths library, for the few functions Nox's own `Math` namespace lacks. Other code calls these through
// wrappers in VectorMath.nox, never directly.
lantern:::libm :: foreign "m" {
    fmodf :: (x: f32, y: f32) -> f32;
    floor :: (x: f64) -> f64;
    fabs :: (x: f64) -> f64;
    hypotf :: (x: f32, y: f32) -> f32;
}
