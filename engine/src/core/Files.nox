lantern:::cfiles :: foreign "c" {
    FileHandle :: opaque;
    fopen :: (path: string, mode: string) -> raw FileHandle~*;
    fwrite :: (data: Array<u8>, size: usize, count: usize, file: raw FileHandle~*) -> usize;
    fclose :: (file: raw FileHandle~*) -> i32;
    rename :: (from: string, to: string) -> i32;
}

lantern:::core :: namespace {
    WriteBytes :: (path: string, bytes: Array<u8>) -> bool {
        unsafe {
            file := lantern:::cfiles:::fopen(path, "wb");
            if file == null {
                return false;
            }
            written: usize = lantern:::cfiles:::fwrite(bytes, 1, bytes.length(), file);
            closed: i32 = lantern:::cfiles:::fclose(file);
            return written == bytes.length() && closed == 0;
        }
    }
}
