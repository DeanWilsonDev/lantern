lantern:::core :: namespace {
    INFINITY: f32 : 1.0f / 0.0f;

    Splat3 :: (value: f32) -> Vec3 {
        return Vec3 { x: value, y: value, z: value };
    }

    ComponentMin3 :: (left: Vec3, right: Vec3) -> Vec3 {
        return Vec3 { x: Math:::min(left.x, right.x), y: Math:::min(left.y, right.y), z: Math:::min(left.z, right.z) };
    }

    ComponentMax3 :: (left: Vec3, right: Vec3) -> Vec3 {
        return Vec3 { x: Math:::max(left.x, right.x), y: Math:::max(left.y, right.y), z: Math:::max(left.z, right.z) };
    }

    Abs3 :: (vector: Vec3) -> Vec3 {
        return Vec3 { x: Math:::abs(vector.x), y: Math:::abs(vector.y), z: Math:::abs(vector.z) };
    }

    Vec2Length :: (vector: Vec2) -> f32 {
        return Math:::sqrt(vector.x * vector.x + vector.y * vector.y);
    }

    ComponentMax2 :: (left: Vec2, right: Vec2) -> Vec2 {
        return Vec2 { x: Math:::max(left.x, right.x), y: Math:::max(left.y, right.y) };
    }

    ClampLengthMax2 :: (vector: Vec2, maximumLength: f32) -> Vec2 {
        lengthSquared: f32 = vector.x * vector.x + vector.y * vector.y;
        if lengthSquared > maximumLength * maximumLength {
            return vector / Math:::sqrt(lengthSquared) * maximumLength;
        }
        return vector;
    }

    NormalizeOrZero2 :: (vector: Vec2) -> Vec2 {
        reciprocalLength: f32 = 1.0f / Vec2Length(vector);
        if reciprocalLength > 0.0f && reciprocalLength < INFINITY {
            return vector * reciprocalLength;
        }
        return Vec2 { };
    }

    LengthReciprocal3 :: (vector: Vec3) -> f32 {
        return 1.0f / Math:::sqrt(vector.dot(vector));
    }

    Normalize3 :: (vector: Vec3) -> Vec3 {
        return vector * LengthReciprocal3(vector);
    }

    NormalizeOr3 :: (vector: Vec3, fallback: Vec3) -> Vec3 {
        reciprocal: f32 = LengthReciprocal3(vector);
        if reciprocal > 0.0f && reciprocal < INFINITY {
            return vector * reciprocal;
        }
        return fallback;
    }

    LengthSquared3 :: (vector: Vec3) -> f32 {
        return vector.dot(vector);
    }

    IsFinite3 :: (vector: Vec3) -> bool {
        return IsFinite(vector.x) && IsFinite(vector.y) && IsFinite(vector.z);
    }

    IsFinite :: (value: f32) -> bool {
        return value == value && value < INFINITY && value > -INFINITY;
    }

    Signum :: (value: f32) -> f32 {
        if value != value {
            return value;
        }
        if value < 0.0f || (value == 0.0f && 1.0f / value < 0.0f) {
            return -1.0f;
        }
        return 1.0f;
    }

    AnyOrthonormalVector3 :: (vector: Vec3) -> Vec3 {
        sign: f32 = Signum(vector.z);
        a: f32 = -1.0f / (sign + vector.z);
        b: f32 = vector.x * vector.y * a;
        return Vec3 { x: b, y: sign + vector.y * vector.y * a, z: -vector.y };
    }

    LookToRightHanded :: (eye: Vec3, direction: Vec3, up: Vec3) -> Mat4 {
        forward := direction;
        side := Normalize3(forward.cross(up));
        upward := side.cross(forward);
        return MatrixFromColumns(
            Vec4 { x: side.x, y: upward.x, z: -forward.x, w: 0.0f },
            Vec4 { x: side.y, y: upward.y, z: -forward.y, w: 0.0f },
            Vec4 { x: side.z, y: upward.z, z: -forward.z, w: 0.0f },
            Vec4 { x: -eye.dot(side), y: -eye.dot(upward), z: eye.dot(forward), w: 1.0f });
    }

    OrthographicRightHanded :: (left: f32, right: f32, bottom: f32, top: f32, nearPlane: f32, farPlane: f32) -> Mat4 {
        reciprocalWidth: f32 = 1.0f / (right - left);
        reciprocalHeight: f32 = 1.0f / (top - bottom);
        reciprocalDepth: f32 = 1.0f / (nearPlane - farPlane);
        return MatrixFromColumns(
            Vec4 { x: reciprocalWidth + reciprocalWidth, y: 0.0f, z: 0.0f, w: 0.0f },
            Vec4 { x: 0.0f, y: reciprocalHeight + reciprocalHeight, z: 0.0f, w: 0.0f },
            Vec4 { x: 0.0f, y: 0.0f, z: reciprocalDepth, w: 0.0f },
            Vec4 { x: -(left + right) * reciprocalWidth, y: -(top + bottom) * reciprocalHeight, z: reciprocalDepth * nearPlane, w: 1.0f });
    }

    QuaternionFromRotationY :: (radians: f32) -> Quaternion {
        half: f32 = radians * 0.5f;
        return Quaternion { x: 0.0f, y: Math:::sin(half), z: 0.0f, w: Math:::cos(half) };
    }

    RotateVector :: (rotation: Quaternion, vector: Vec3) -> Vec3 {
        axis := Vec3 { x: rotation.x, y: rotation.y, z: rotation.z };
        axisLengthSquared: f32 = axis.dot(axis);
        scaledVector := vector * (rotation.w * rotation.w - axisLengthSquared);
        scaledAxis := axis * (vector.dot(axis) * 2.0f);
        scaledCross := axis.cross(vector) * (rotation.w * 2.0f);
        return scaledVector + scaledAxis + scaledCross;
    }

    MatrixFromColumns :: (xAxis: Vec4, yAxis: Vec4, zAxis: Vec4, wAxis: Vec4) -> Mat4 {
        result~ Mat4 = Mat4 { };
        result.elements = [xAxis.x, xAxis.y, xAxis.z, xAxis.w, yAxis.x, yAxis.y, yAxis.z, yAxis.w,
            zAxis.x, zAxis.y, zAxis.z, zAxis.w, wAxis.x, wAxis.y, wAxis.z, wAxis.w];
        return result;
    }

    MatrixFromRotationTranslation :: (rotation: Quaternion, translation: Vec3) -> Mat4 {
        x2: f32 = rotation.x + rotation.x;
        y2: f32 = rotation.y + rotation.y;
        z2: f32 = rotation.z + rotation.z;
        xx: f32 = rotation.x * x2;
        xy: f32 = rotation.x * y2;
        xz: f32 = rotation.x * z2;
        yy: f32 = rotation.y * y2;
        yz: f32 = rotation.y * z2;
        zz: f32 = rotation.z * z2;
        wx: f32 = rotation.w * x2;
        wy: f32 = rotation.w * y2;
        wz: f32 = rotation.w * z2;
        return MatrixFromColumns(
            Vec4 { x: 1.0f - (yy + zz), y: xy + wz, z: xz - wy, w: 0.0f },
            Vec4 { x: xy - wz, y: 1.0f - (xx + zz), z: yz + wx, w: 0.0f },
            Vec4 { x: xz + wy, y: yz - wx, z: 1.0f - (xx + yy), w: 0.0f },
            Vec4 { x: translation.x, y: translation.y, z: translation.z, w: 1.0f });
    }

    QuaternionFromEulerYxz :: (yawRadians: f32, pitchRadians: f32, rollRadians: f32) -> Quaternion {
        yawSine: f32 = Math:::sin(yawRadians * 0.5f);
        yawCosine: f32 = Math:::cos(yawRadians * 0.5f);
        pitchSine: f32 = Math:::sin(pitchRadians * 0.5f);
        pitchCosine: f32 = Math:::cos(pitchRadians * 0.5f);
        rollSine: f32 = Math:::sin(rollRadians * 0.5f);
        rollCosine: f32 = Math:::cos(rollRadians * 0.5f);
        cc: f32 = yawCosine * rollCosine;
        cs: f32 = yawCosine * rollSine;
        sc: f32 = yawSine * rollCosine;
        ss: f32 = yawSine * rollSine;
        return Quaternion {
            x: pitchCosine * ss + pitchSine * cc,
            y: pitchCosine * sc - pitchSine * cs,
            z: pitchCosine * cs - pitchSine * sc,
            w: pitchCosine * cc + pitchSine * ss
        };
    }

    MatrixFromScaleRotationTranslation :: (scale: Vec3, rotation: Quaternion, translation: Vec3) -> Mat4 {
        rotationOnly: Mat4 = MatrixFromQuaternion(rotation);
        e := rotationOnly.elements;
        return MatrixFromColumns(
            Vec4 { x: e[0] * scale.x, y: e[1] * scale.x, z: e[2] * scale.x, w: 0.0f },
            Vec4 { x: e[4] * scale.y, y: e[5] * scale.y, z: e[6] * scale.y, w: 0.0f },
            Vec4 { x: e[8] * scale.z, y: e[9] * scale.z, z: e[10] * scale.z, w: 0.0f },
            Vec4 { x: translation.x, y: translation.y, z: translation.z, w: 1.0f });
    }

    MatrixFromQuaternion :: (rotation: Quaternion) -> Mat4 {
        return MatrixFromRotationTranslation(rotation, Vec3 { });
    }

    TransformPoint3 :: (transform: Mat4, point: Vec3) -> Vec3 {
        e := transform.elements;
        return Vec3 {
            x: e[0] * point.x + e[4] * point.y + e[8] * point.z + e[12],
            y: e[1] * point.x + e[5] * point.y + e[9] * point.z + e[13],
            z: e[2] * point.x + e[6] * point.y + e[10] * point.z + e[14]
        };
    }

    MatrixColumn3 :: (matrix: Mat4, column: usize) -> Vec3 {
        return Vec3 { x: matrix.elements[column * 4], y: matrix.elements[column * 4 + 1], z: matrix.elements[column * 4 + 2] };
    }

    Determinant3 :: (matrix: Mat4) -> f32 {
        return MatrixColumn3(matrix, 2).dot(MatrixColumn3(matrix, 0).cross(MatrixColumn3(matrix, 1)));
    }

    NormalMatrix :: struct {
        xAxis~ Vec3 = Vec3 { };
        yAxis~ Vec3 = Vec3 { };
        zAxis~ Vec3 = Vec3 { };

        static FromTransform :: (transform: Mat4) -> NormalMatrix {
            xAxis: Vec3 = MatrixColumn3(transform, 0);
            yAxis: Vec3 = MatrixColumn3(transform, 1);
            zAxis: Vec3 = MatrixColumn3(transform, 2);
            first: Vec3 = yAxis.cross(zAxis);
            second: Vec3 = zAxis.cross(xAxis);
            third: Vec3 = xAxis.cross(yAxis);
            inverseDeterminant: f32 = 1.0f / zAxis.dot(third);
            return NormalMatrix { xAxis: first * inverseDeterminant, yAxis: second * inverseDeterminant, zAxis: third * inverseDeterminant };
        }

        Apply :: (normal: Vec3) -> Vec3 {
            return xAxis * normal.x + yAxis * normal.y + zAxis * normal.z;
        }
    }
}
