lantern:::core :: namespace {
    /**
     * `text` with spaces added on the left until it is `width` characters. Used to right-align numbers in the HUD.
     */
    PadStart :: (text: string, width: usize) -> string! {
        padded~ string! = "";
        for padding~ usize = text.length(); padding < width; padding++ {
            padded += " ";
        }
        padded += text;
        return padded!;
    }

    /**
     * `text` with spaces added on the right until it is `width` characters. Used to line up log columns.
     */
    PadEnd :: (text: string, width: usize) -> string! {
        padded~ string! = `${text}`;
        for padding~ usize = text.length(); padding < width; padding++ {
            padded += " ";
        }
        return padded!;
    }

    /**
     * `value` written with `decimals` digits after the point (0 to 3; any other count gives 6), right-aligned in
     * `width` characters. Nox has no general number formatting, so the few forms the HUD needs are spelled out.
     */
    FixedDecimals :: (value: f64, decimals: i32, width: usize) -> string! {
        formatted~ string! = when decimals {
            0 -> `${value:.0f}`,
            1 -> `${value:.1f}`,
            2 -> `${value:.2f}`,
            3 -> `${value:.3f}`,
            default -> `${value:.6f}`,
        };
        defer delete formatted;
        return PadStart(formatted, width);
    }

    /**
     * Reads a string of decimal digits. Returns null for an empty string or any other character, so "12a" is
     * not a number. It is how `LANTERN_*` environment variables become numbers.
     */
    ParseUnsigned :: (text: string) -> u64? {
        if text.length() == 0 {
            return null;
        }
        value~ u64 = 0;
        for index~ usize = 0; index < text.length(); index++ {
            digit := text.substring(index, 1);
            if place := "0123456789".indexOf(digit, 0) {
                value = value * 10 + u64(place);
            } else {
                return null;
            }
        }
        return value;
    }
}
