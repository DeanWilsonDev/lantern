lantern:::core :: namespace {
    PadStart :: (text: string, width: usize) -> string! {
        padded~ string! = "";
        for padding~ usize = text.length(); padding < width; padding++ {
            padded += " ";
        }
        padded += text;
        return padded!;
    }

    PadEnd :: (text: string, width: usize) -> string! {
        padded~ string! = `${text}`;
        for padding~ usize = text.length(); padding < width; padding++ {
            padded += " ";
        }
        return padded!;
    }

    FixedDecimals :: (value: f64, decimals: i32, width: usize) -> string! {
        formatted~ string! = when decimals {
            0 -> `${value:.0f}`,
            1 -> `${value:.1f}`,
            2 -> `${value:.2f}`,
            3 -> `${value:.3f}`,
            default -> `${value:.6f}`,
        };
        defer delete formatted;
        return PadStart(formatted, width);
    }

    ParseUnsigned :: (text: string) -> u64? {
        if text.length() == 0 {
            return null;
        }
        value~ u64 = 0;
        for index~ usize = 0; index < text.length(); index++ {
            digit := text.substring(index, 1);
            if place := "0123456789".indexOf(digit, 0) {
                value = value * 10 + u64(place);
            } else {
                return null;
            }
        }
        return value;
    }
}
