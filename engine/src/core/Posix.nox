// Two POSIX calls the engine needs: `write` (logging goes straight to standard error, with no buffering to flush
// at a crash) and `usleep` (the loop sleeps off spare frame time).
lantern:::posix :: foreign "c" {
    write :: (fileDescriptor: i32, text: string, length: usize) -> isize;
    usleep :: (microseconds: u32) -> i32;
}
