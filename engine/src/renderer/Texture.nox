lantern:::stbmemory :: foreign "stb_image" {
    stbi_load_from_memory :: (buffer: Array<u8>, length: i32, width: raw i32~*, height: raw i32~*, channelsInFile: raw i32~*, desiredChannels: i32) -> raw u8~*;
}

lantern:::bytecopy :: foreign "c" {
    memcpy :: (destination: Array<u8~>, source: raw u8*, byteCount: usize) -> raw u8~*;
}

lantern:::renderer :: namespace {
    StbImage :: import StbImage;

    RGBA_CHANNELS: i32 : 4;

    TextureFilter :: enum {
        Linear,
        Nearest
    }

    TextureWrap :: enum {
        Repeat,
        Clamp
    }

    ToSrgbByte :: (linear: f32) -> u8 {
        clamped: f32 = Math:::clamp(linear, 0.0f, 1.0f);
        encoded~ f32 = clamped * 12.92f;
        if clamped > 0.0031308f {
            encoded = 1.055f * Math:::pow(clamped, 1.0f / 2.4f) - 0.055f;
        }
        return u8(encoded * 255.0f + 0.5f);
    }

    TextureData :: class {
    public:
        width~ u32 = 0;
        height~ u32 = 0;
        rgba8~ Array<u8>! = [];
        filter~ TextureFilter = TextureFilter:::Linear;
        wrap~ TextureWrap = TextureWrap:::Repeat;

        TextureData~: (newWidth: u32, newHeight: u32, newFilter: TextureFilter, newWrap: TextureWrap) {
            width = newWidth;
            height = newHeight;
            filter = newFilter;
            wrap = newWrap;
        }

        !TextureData~: () {
            delete rgba8;
        }

        static Solid :: (color: lantern:::core:::Color) -> TextureData*! {
            texture := new TextureData(1, 1, TextureFilter:::Nearest, TextureWrap:::Repeat);
            texture->rgba8.push(ToSrgbByte(color.r));
            texture->rgba8.push(ToSrgbByte(color.g));
            texture->rgba8.push(ToSrgbByte(color.b));
            texture->rgba8.push(u8(color.a * 255.0f));
            return texture!;
        }

        static Checker :: (size: u32, cells: u32, first: lantern:::core:::Color, second: lantern:::core:::Color) -> TextureData*! {
            cellSize~ u32 = size / cells;
            if cellSize < 1 {
                cellSize = 1;
            }
            texture := new TextureData(size, size, TextureFilter:::Linear, TextureWrap:::Repeat);
            for y~ u32 = 0; y < size; y += 1 {
                for x~ u32 = 0; x < size; x += 1 {
                    color~ lantern:::core:::Color = second;
                    if ((x / cellSize) + (y / cellSize)) % 2 == 0 {
                        color = first;
                    }
                    texture->rgba8.push(ToSrgbByte(color.r));
                    texture->rgba8.push(ToSrgbByte(color.g));
                    texture->rgba8.push(ToSrgbByte(color.b));
                    texture->rgba8.push(255);
                }
            }
            return texture!;
        }

        static FromStbPixels :: (pixels: raw u8~*, width: i32, height: i32) -> TextureData*! {
            texture := new TextureData(u32(width), u32(height), TextureFilter:::Linear, TextureWrap:::Repeat);
            byteCount: usize = usize(width) * usize(height) * 4;
            for byteIndex~ usize = 0; byteIndex < byteCount; byteIndex += 1 {
                texture->rgba8.push(0);
            }
            unsafe {
                lantern:::bytecopy:::memcpy(texture->rgba8.borrow().mutable(), pixels, byteCount);
                StbImage:::stbi_image_free(pixels);
            }
            return texture!;
        }

        static StbFailure :: (context: string) -> string! {
            reason~ string! = "unknown failure" + "";
            unsafe {
                failure: raw u8* = StbImage:::stbi_failure_reason();
                if failure != null {
                    delete reason;
                    reason = copyCString(failure);
                }
            }
            message: string! = `${context}: ${reason}`;
            delete reason;
            return message!;
        }

        static FromPngBytes :: (bytes: Array<u8>) -> Result<TextureData*!, string!> {
            width~ i32 = 0;
            height~ i32 = 0;
            channels~ i32 = 0;
            pixels~ raw u8~* = null;
            unsafe {
                pixels = lantern:::stbmemory:::stbi_load_from_memory(bytes, i32(bytes.length()), width, height, channels, RGBA_CHANNELS);
            }
            if pixels == null {
                return Result<TextureData*!, string!>:::Err(TextureData:::StbFailure("PNG data"));
            }
            return Result<TextureData*!, string!>:::Ok(TextureData:::FromStbPixels(pixels, width, height));
        }

        static LoadPng :: (path: string) -> Result<TextureData*!, string!> {
            width~ i32 = 0;
            height~ i32 = 0;
            channels~ i32 = 0;
            pixels~ raw u8~* = null;
            unsafe {
                pixels = StbImage:::stbi_load(path, width, height, channels, RGBA_CHANNELS);
            }
            if pixels == null {
                return Result<TextureData*!, string!>:::Err(TextureData:::StbFailure(path));
            }
            return Result<TextureData*!, string!>:::Ok(TextureData:::FromStbPixels(pixels, width, height));
        }

        ToPngBytes :: () -> Array<u8>! {
            return EncodePng(this);
        }

        PixelOffset :: (x: u32, y: u32) -> usize {
            return usize((y * width + x) * 4);
        }
    }
}
