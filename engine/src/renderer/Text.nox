lantern:::renderer :: namespace {
    GLYPH_SIZE: u32 : 8;
    ATLAS_COLUMNS: u32 : 16;
    ATLAS_ROWS: u32 : 6;
    ATLAS_WIDTH: u32 : 128;
    ATLAS_HEIGHT: u32 : 48;
    WHITE_CELL: u32 : 95;
    LINE_HEIGHT_IN_GLYPH_PIXELS: f32 : 10.0f;
    REPLACEMENT_GLYPH: u8 : 63;
    NEWLINE: u8 : 10;
    SPACE: u8 : 32;

    CellOriginX :: (cell: u32) -> u32 {
        return (cell % ATLAS_COLUMNS) * GLYPH_SIZE;
    }

    CellOriginY :: (cell: u32) -> u32 {
        return (cell / ATLAS_COLUMNS) * GLYPH_SIZE;
    }

    SetAtlasPixel :: (atlas: TextureData~*, x: u32, y: u32, alpha: u8) -> void {
        offset: usize = atlas->PixelOffset(x, y);
        atlas->rgba8[offset] = 255;
        atlas->rgba8[offset + 1] = 255;
        atlas->rgba8[offset + 2] = 255;
        atlas->rgba8[offset + 3] = alpha;
    }

    FontAtlas :: () -> TextureData*! {
        atlas := new TextureData(ATLAS_WIDTH, ATLAS_HEIGHT, TextureFilter:::Nearest, TextureWrap:::Clamp);
        for byteIndex~ u32 = 0; byteIndex < ATLAS_WIDTH * ATLAS_HEIGHT * 4; byteIndex += 1 {
            atlas->rgba8.push(0);
        }
        packedGlyphs: Array<u64>! = PackedGlyphRows();
        for cell~ u32 = 0; usize(cell) < GLYPH_COUNT; cell += 1 {
            originX: u32 = CellOriginX(cell);
            originY: u32 = CellOriginY(cell);
            for row~ u32 = 0; row < GLYPH_SIZE; row += 1 {
                bits: u8 = GlyphRow(packedGlyphs, usize(cell), row);
                for column~ u32 = 0; column < GLYPH_SIZE; column += 1 {
                    if (bits & (u8(1) << u8(column))) != 0 {
                        SetAtlasPixel(atlas, originX + column, originY + row, 255);
                    }
                }
            }
        }
        delete packedGlyphs;
        whiteX: u32 = CellOriginX(WHITE_CELL);
        whiteY: u32 = CellOriginY(WHITE_CELL);
        for y~ u32 = 0; y < GLYPH_SIZE; y += 1 {
            for x~ u32 = 0; x < GLYPH_SIZE; x += 1 {
                SetAtlasPixel(atlas, whiteX + x, whiteY + y, 255);
            }
        }
        return atlas!;
    }

    WhiteTexelUv :: () -> Vec2 {
        return Vec2 {
            x: (f32(CellOriginX(WHITE_CELL)) + 4.0f) / f32(ATLAS_WIDTH),
            y: (f32(CellOriginY(WHITE_CELL)) + 4.0f) / f32(ATLAS_HEIGHT)
        };
    }

    GlyphCell :: (character: u8) -> u32 {
        glyph~ u8 = REPLACEMENT_GLYPH;
        if character >= FIRST_GLYPH && usize(character - FIRST_GLYPH) < GLYPH_COUNT {
            glyph = character;
        }
        return u32(glyph - FIRST_GLYPH);
    }

    IsUtf8Continuation :: (byte: u8) -> bool {
        return (byte & 192) == 128;
    }

    MeasureText :: (text: string, scale: f32) -> Vec2 {
        glyph: f32 = f32(GLYPH_SIZE) * scale;
        widest~ usize = 0;
        lineCount~ usize = 1;
        lineLength~ usize = 0;
        for byteIndex~ usize = 0; byteIndex < text.length(); byteIndex += 1 {
            byte: u8 = text.byteAt(byteIndex);
            if byte == NEWLINE {
                if lineLength > widest {
                    widest = lineLength;
                }
                lineLength = 0;
                lineCount += 1;
            } else if !IsUtf8Continuation(byte) {
                lineLength += 1;
            }
        }
        if lineLength > widest {
            widest = lineLength;
        }
        height: f32 = glyph + f32(lineCount - 1) * LINE_HEIGHT_IN_GLYPH_PIXELS * scale;
        return Vec2 { x: f32(widest) * glyph, y: height };
    }

    PushText :: (overlay: Overlay~*, text: string, topLeft: Vec2, scale: f32, color: lantern:::core:::Color) -> void {
        glyph: f32 = f32(GLYPH_SIZE) * scale;
        glyphUvSize: Vec2 = Vec2 { x: f32(GLYPH_SIZE) / f32(ATLAS_WIDTH), y: f32(GLYPH_SIZE) / f32(ATLAS_HEIGHT) };
        pen~ Vec2 = topLeft;
        for byteIndex~ usize = 0; byteIndex < text.length(); byteIndex += 1 {
            byte: u8 = text.byteAt(byteIndex);
            if IsUtf8Continuation(byte) {
                continue;
            }
            if byte == NEWLINE {
                pen = Vec2 { x: topLeft.x, y: pen.y + LINE_HEIGHT_IN_GLYPH_PIXELS * scale };
                continue;
            }
            if byte != SPACE {
                cell: u32 = GlyphCell(byte);
                uvMin: Vec2 = Vec2 { x: f32(CellOriginX(cell)) / f32(ATLAS_WIDTH), y: f32(CellOriginY(cell)) / f32(ATLAS_HEIGHT) };
                corner: Vec2 = Vec2 { x: Math:::round(pen.x), y: Math:::round(pen.y) };
                overlay->Quad(corner, corner + Vec2 { x: glyph, y: glyph }, uvMin, uvMin + glyphUvSize, color);
            }
            pen = Vec2 { x: pen.x + glyph, y: pen.y };
        }
    }

    ScaleForDensity :: (baseScale: u32, pixelDensity: f32) -> f32 {
        return Math:::max(Math:::round(f32(baseScale) * pixelDensity), 1.0f);
    }
}
