    /** One row of one glyph as eight bits, bit n for column n. */
    GlyphRow :: (packedGlyphs: Array<u64>, glyphIndex: usize, row: u32) -> u8 {
        return u8((packedGlyphs[glyphIndex] >> u64(row * 8)) & 255);
    }
