lantern:::editor :: namespace {
    // Numbers the editor session uses. A press that moves less than CLICK_SLOP_PIXELS before the button
    // comes up is a click and not a drag. Clicking again on the same spot cycles through the entities
    // under it, up to MAX_CLICK_CYCLE_LENGTH of them. There are BOOKMARK_COUNT camera bookmarks (the digit
    // keys), the recent files list keeps RECENT_FILE_LIMIT, and the console keeps its last LOG_LIMIT lines.
    // LAST_INDEX is the largest usize, meaning "the end of a list".
    CLICK_SLOP_PIXELS: f32 : 4.0f;
    MAX_CLICK_CYCLE_LENGTH: usize : 64;
    BOOKMARK_COUNT: usize : 9;
    RECENT_FILE_LIMIT: usize : 10;
    LOG_LIMIT: usize : 500;
    LAST_INDEX: usize : 18446744073709551615;

    // The three mouse buttons the editor uses.
    PointerButton :: enum {
        Left,
        Middle,
        Right
    }

    // The button for a number from the platform (0 left, 1 middle, 2 right), or null for others.
    PointerButtonAt :: (index: u32) -> PointerButton? {
        if index == 0 {
            return PointerButton:::Left;
        }
        if index == 1 {
            return PointerButton:::Middle;
        }
        if index == 2 {
            return PointerButton:::Right;
        }
        return null;
    }

    // A button's number, for indexing the session's array of pressed buttons.
    PointerButtonIndex :: (button: PointerButton) -> usize {
        return when button {
            PointerButton:::Left -> 0,
            PointerButton:::Middle -> 1,
            PointerButton:::Right -> 2
        };
    }

    // The platform reports held modifier keys as bits of one number. `command` is Ctrl on Windows and
    // Linux and Cmd on macOS.
    MODIFIER_SHIFT: u32 : 1;
    MODIFIER_COMMAND: u32 : 2;
    MODIFIER_ALT: u32 : 4;

    // Shift, command and alt as three flags.
    Modifiers :: struct {
        shift~ bool = false;
        command~ bool = false;
        alt~ bool = false;

        // Unpacks the platform's modifier bits.
        static FromBits :: (bits: u32) -> Modifiers {
            return Modifiers { shift: (bits & MODIFIER_SHIFT) != 0, command: (bits & MODIFIER_COMMAND) != 0, alt: (bits & MODIFIER_ALT) != 0 };
        }
    }

    // The kinds of key the editor reacts to: a letter, a digit, and four named keys.
    EditorKeyKind :: enum {
        Letter,
        Digit,
        Delete,
        Escape,
        Home,
        End
    }

    // One key press as the editor sees it: its kind plus the letter or digit.
    EditorKey :: struct {
        kind~ EditorKeyKind = EditorKeyKind:::Escape;
        letter~ u8 = 0;
        digit~ u8 = 0;

        // A key of a named kind with no letter or digit.
        static Of :: (keyKind: EditorKeyKind) -> EditorKey {
            return EditorKey { kind: keyKind };
        }

        // A letter key (always lower case).
        static Letter :: (character: u8) -> EditorKey {
            return EditorKey { kind: EditorKeyKind:::Letter, letter: character };
        }

        // A digit key, 0 to 9.
        static Digit :: (value: u8) -> EditorKey {
            return EditorKey { kind: EditorKeyKind:::Digit, digit: value };
        }

        // Reads the key name the platform gives. Delete and Backspace are one key; letters are made lower
        // case; names the editor does not use give null.
        static FromName :: (name: string) -> EditorKey? {
            if name == "Delete" || name == "Backspace" {
                return EditorKey:::Of(EditorKeyKind:::Delete);
            }
            if name == "Escape" {
                return EditorKey:::Of(EditorKeyKind:::Escape);
            }
            if name == "Home" {
                return EditorKey:::Of(EditorKeyKind:::Home);
            }
            if name == "End" {
                return EditorKey:::Of(EditorKeyKind:::End);
            }
            if name.length() != 1 {
                return null;
            }
            byte: u8 = name.byteAt(0);
            if byte >= u8(65) && byte <= u8(90) {
                return EditorKey:::Letter(byte + u8(32));
            }
            if byte >= u8(97) && byte <= u8(122) {
                return EditorKey:::Letter(byte);
            }
            if byte >= u8(48) && byte <= u8(57) {
                return EditorKey:::Digit(byte - u8(48));
            }
            return null;
        }

        // True when this is the given letter key.
        IsLetter :: (character: string) -> bool {
            return kind == EditorKeyKind:::Letter && letter == character.byteAt(0);
        }
    }

    // One row of the outliner (the tree of entities): the entity's key and parent, its name and kind, how
    // deeply it is nested, and whether it is selected, hidden, locked or has children. The UI draws these.
    OutlineRow :: class {
    public:
        key~ u64 = 0;
        parent~ u64? = null;
        name~ string!;
        kind~ string!;
        depth~ u32 = 0;
        selected~ bool = false;
        hidden~ bool = false;
        locked~ bool = false;
        hasChildren~ bool = false;

        OutlineRow~: (rowKey: u64, rowName: string, rowKind: string) {
            key = rowKey;
            name = `${rowName}`;
            kind = `${rowKind}`;
        }

        !OutlineRow~: () {
            delete name;
            delete kind;
        }
    }

    // The console's three levels of message.
    LogLevel :: enum {
        Info,
        Warning,
        Error
    }

    // The word for a level, as the console filter shows it.
    LogLevelName :: (level: LogLevel) -> string {
        return when level {
            LogLevel:::Info -> "info",
            LogLevel:::Warning -> "warning",
            LogLevel:::Error -> "error"
        };
    }

    // One console line: its level and text.
    LogEntry :: class {
    public:
        level~ LogLevel = LogLevel:::Info;
        text~ string!;

        LogEntry~: (entryLevel: LogLevel, entryText: string) {
            level = entryLevel;
            text = `${entryText}`;
        }

        !LogEntry~: () {
            delete text;
        }
    }

    // Reads on/off, true/false or 1/0 from the command line or a setting.
    ParseFlag :: (value: string) -> Result<bool, string!> {
        trimmed: string = value.trim();
        if trimmed == "true" || trimmed == "on" || trimmed == "1" {
            return Result<bool, string!>:::Ok(true);
        }
        if trimmed == "false" || trimmed == "off" || trimmed == "0" {
            return Result<bool, string!>:::Ok(false);
        }
        return Result<bool, string!>:::Err(`'${trimmed}' is not on or off`);
    }

    ParseQuality :: (value: string) -> Result<lantern:::renderer:::QualityLevel, string!> {
        trimmed: string = value.trim();
        if trimmed == "low" {
            return Result<lantern:::renderer:::QualityLevel, string!>:::Ok(lantern:::renderer:::QualityLevel:::Low);
        }
        if trimmed == "medium" {
            return Result<lantern:::renderer:::QualityLevel, string!>:::Ok(lantern:::renderer:::QualityLevel:::Medium);
        }
        if trimmed == "high" {
            return Result<lantern:::renderer:::QualityLevel, string!>:::Ok(lantern:::renderer:::QualityLevel:::High);
        }
        return Result<lantern:::renderer:::QualityLevel, string!>:::Err(`'${trimmed}' is not low, medium or high`);
    }

    QualityName :: (level: lantern:::renderer:::QualityLevel) -> string {
        return when level {
            lantern:::renderer:::QualityLevel:::Low -> "low",
            lantern:::renderer:::QualityLevel:::Medium -> "medium",
            lantern:::renderer:::QualityLevel:::High -> "high"
        };
    }

    // The switches of the View menu: grid and its spacing, colliders, markers, wireframe, the level
    // box, hidden entities and the stats readout. They can be read and set by name, which is how the
    // console and the menu share one code path.
    ViewOptions :: struct {
        quality~ lantern:::renderer:::QualityLevel = lantern:::renderer:::QualityLevel:::Medium;
        shadowQuality~ lantern:::renderer:::QualityLevel = lantern:::renderer:::QualityLevel:::Medium;
        bloom~ bool = true;
        ambientOcclusion~ bool = true;
        antiAliasing~ bool = true;
        lightShafts~ bool = true;
        reflections~ bool = true;
        showGrid~ bool = true;
        gridSpacing~ f32 = 1.0f;
        showColliders~ bool = false;
        showMarkers~ bool = true;
        wireframe~ bool = false;
        showLevelBounds~ bool = false;
        showHidden~ bool = false;
        showStats~ bool = false;

        // The names of every view option.
        static Names :: () -> Array<string>! {
            names~ Array<string>! = [];
            names.push("grid");
            names.push("grid_spacing");
            names.push("colliders");
            names.push("markers");
            names.push("wireframe");
            names.push("level_bounds");
            names.push("hidden");
            names.push("stats");
            names.push("quality");
            names.push("shadow_quality");
            names.push("bloom");
            names.push("ambient_occlusion");
            names.push("anti_aliasing");
            names.push("light_shafts");
            names.push("reflections");
            return names!;
        }

        // An option's value as text, or null for an unknown name.
        Get :: (name: string) -> string!? {
            if name == "grid" {
                return `${showGrid}`;
            }
            if name == "grid_spacing" {
                return FormatNumber(gridSpacing);
            }
            if name == "colliders" {
                return `${showColliders}`;
            }
            if name == "markers" {
                return `${showMarkers}`;
            }
            if name == "wireframe" {
                return `${wireframe}`;
            }
            if name == "level_bounds" {
                return `${showLevelBounds}`;
            }
            if name == "hidden" {
                return `${showHidden}`;
            }
            if name == "stats" {
                return `${showStats}`;
            }
            if name == "quality" {
                return `${QualityName(quality)}`;
            }
            if name == "shadow_quality" {
                return `${QualityName(shadowQuality)}`;
            }
            if name == "bloom" {
                return `${bloom}`;
            }
            if name == "ambient_occlusion" {
                return `${ambientOcclusion}`;
            }
            if name == "anti_aliasing" {
                return `${antiAliasing}`;
            }
            if name == "light_shafts" {
                return `${lightShafts}`;
            }
            if name == "reflections" {
                return `${reflections}`;
            }
            return null;
        }

        // Sets an option from text. Returns an error message for an unknown name or a bad value (the grid
        // spacing must be a positive number), or null on success.
        Set~: (name: string, value: string) -> string!? {
            if name == "grid_spacing" {
                parsed: f32? = ParsedNumber(value.trim());
                guard spacing := parsed return `'${value}' is not a number`;
                if !(spacing > 0.0f && lantern:::core:::IsFinite(spacing)) {
                    return "the grid spacing must be positive".copy();
                }
                gridSpacing = spacing;
                return null;
            }
            if name == "quality" || name == "shadow_quality" {
                level~ lantern:::renderer:::QualityLevel = lantern:::renderer:::QualityLevel:::Medium;
                when ParseQuality(value) {
                    Result:::Ok(parsed) -> {
                        level = parsed;
                    },
                    Result:::Err(message) -> {
                        return message!;
                    }
                }
                if name == "shadow_quality" {
                    shadowQuality = level;
                    return null;
                }
                quality = level;
                shadowQuality = level;
                bloom = level != lantern:::renderer:::QualityLevel:::Low;
                ambientOcclusion = level != lantern:::renderer:::QualityLevel:::Low;
                antiAliasing = level != lantern:::renderer:::QualityLevel:::Low;
                lightShafts = level != lantern:::renderer:::QualityLevel:::Low;
                reflections = level != lantern:::renderer:::QualityLevel:::Low;
                return null;
            }
            if name != "grid" && name != "colliders" && name != "markers" && name != "wireframe" && name != "level_bounds" && name != "hidden" && name != "stats" && name != "bloom" && name != "ambient_occlusion" && name != "anti_aliasing" && name != "light_shafts" && name != "reflections" {
                return `unknown view option '${name}'`;
            }
            flag~ bool = false;
            when ParseFlag(value) {
                Result:::Ok(parsed) -> {
                    flag = parsed;
                },
                Result:::Err(message) -> {
                    return message!;
                }
            }
            if name == "grid" {
                showGrid = flag;
            } else if name == "colliders" {
                showColliders = flag;
            } else if name == "markers" {
                showMarkers = flag;
            } else if name == "wireframe" {
                wireframe = flag;
            } else if name == "level_bounds" {
                showLevelBounds = flag;
            } else if name == "hidden" {
                showHidden = flag;
            } else if name == "bloom" {
                bloom = flag;
            } else if name == "ambient_occlusion" {
                ambientOcclusion = flag;
            } else if name == "anti_aliasing" {
                antiAliasing = flag;
            } else if name == "light_shafts" {
                lightShafts = flag;
            } else if name == "reflections" {
                reflections = flag;
            } else {
                showStats = flag;
            }
            return null;
        }
    }

    // What a drag needs to remember about each entity it moves: a copy as it was, its parent's world
    // matrix, and its world position. Every frame of the drag is worked out from these starting values
    // rather than from the last frame, so no error builds up.
    DragOriginal :: class {
    public:
        entity~ lantern:::world:::WorldEntity*!;
        parentWorld~ Mat4 = Mat4 { };
        worldPosition~ Vec3 = Vec3 { };

        DragOriginal~: (originalEntity: lantern:::world:::WorldEntity*!, originalParentWorld: Mat4, originalWorldPosition: Vec3) {
            entity = originalEntity!;
            parentWorld = originalParentWorld;
            worldPosition = originalWorldPosition;
        }

        !DragOriginal~: () {
            delete entity;
        }

        // Turns a new world position into the entity's position inside its parent.
        LocalPosition :: (newWorld: Vec3) -> Vec3 {
            return InverseOrIdentity(parentWorld).transformPoint(newWorld);
        }

        // The rotation of the entity's parent in the world.
        ParentRotation :: () -> Quaternion {
            return lantern:::core:::DecomposeMatrix(parentWorld).rotation;
        }
    }

    // What a mouse drag is doing. Pending means the button is down and it is not yet known whether this is
    // a click or a drag. The others are camera orbit and pan, a gizmo handle, moving the body of the
    // selection, and the selection rectangle.
    DragKind :: enum {
        Pending,
        Orbit,
        Pan,
        Gizmo,
        Body,
        RubberBand
    }

    // The state of a mouse drag in progress: its kind, where it began, what was under the press, the
    // gizmo tool, handle and frame it started with, the starting measurement along the handle, and the
    // originals of the entities being moved.
    Drag :: class {
    public:
        kind~ DragKind = DragKind:::Orbit;
        press~ Vec2 = Vec2 { };
        hit~ u64? = null;
        additive~ bool = false;
        tool~ GizmoTool = GizmoTool:::Translate;
        handle~ Handle = Handle { };
        frame~ GizmoFrame = GizmoFrame { };
        start~ f32 = 0.0f;
        startPoint~ Vec3 = Vec3 { };
        originals~ Array<DragOriginal*!>! = [];

        Drag~: (dragKind: DragKind) {
            kind = dragKind;
        }

        !Drag~: () {
            originals.freeAll();
        }

        // Takes ownership of the list of originals, freeing any earlier list.
        TakeOriginals~: (dragOriginals: Array<DragOriginal*!>!) -> void {
            originals.freeAll();
            originals = dragOriginals!;
        }
    }

    // A matrix's inverse, or the identity for one that cannot be inverted.
    InverseOrIdentity :: (matrix: Mat4) -> Mat4 {
        inverted: Mat4? = matrix.inverse();
        return inverted ?? Mat4 { };
    }

    // True when the list holds the key.
    ContainsKeyIn :: (keys: Array<u64>, key: u64) -> bool {
        for candidate in keys {
            if candidate == key {
                return true;
            }
        }
        return false;
    }

    // Where the key is in the list, or null.
    KeyPosition :: (keys: Array<u64>, key: u64) -> usize? {
        for index~ usize = 0; index < keys.length(); index++ {
            if keys[index] == key {
                return index;
            }
        }
        return null;
    }

    // Copies a list of keys.
    CopyKeys :: (keys: Array<u64>) -> Array<u64>! {
        copied~ Array<u64>! = [];
        for key in keys {
            copied.push(key);
        }
        return copied!;
    }

    // True when two optional keys are both empty or hold the same number.
    SameOptionalU64 :: (left: u64?, right: u64?) -> bool {
        return lantern:::world:::SameOptionalKey(left, right);
    }

    // How much to scale by when dragging a scale handle: the distance of the mouse point from the pivot
    // over the distance at the start. Never less than 0.01 so an entity cannot be squashed to nothing,
    // and 1 when the drag started on the pivot.
    ScaleRatio :: (pivot: Vec3, startPoint: Vec3, point: Vec3) -> f32 {
        startDistance: f32 = (startPoint - pivot).length();
        if startDistance < 0.0001f {
            return 1.0f;
        }
        return Math:::max((point - pivot).length() / startDistance, 0.01f);
    }

    // "entity" for one, or a count and "entities", for undo labels.
    CountEntities :: (count: usize) -> string! {
        if count == 1 {
            return "entity".copy();
        }
        return `${count} entities`;
    }

    // The text with its first letter in upper case.
    Capitalise :: (text: string) -> string! {
        if text.length() == 0 {
            return "".copy();
        }
        first: string! = text.substring(0, 1).toUpper();
        joined: string! = `${first}${text.substring(1, text.length() - 1)}`;
        delete first;
        return joined!;
    }

    // The file name of a path, for the title bar and the recent files list.
    DisplayName :: (path: string) -> string! {
        if separator := LastSeparator(path) {
            if separator + 1 < path.length() {
                return `${path.substring(separator + 1, path.length() - separator - 1)}`;
            }
        }
        return `${path}`;
    }

    // True for a non-empty run of digits.
    AllDigits :: (text: string) -> bool {
        if text.length() == 0 {
            return false;
        }
        for index~ usize = 0; index < text.length(); index++ {
            if !IsAsciiDigit(text.byteAt(index)) {
                return false;
            }
        }
        return true;
    }

    // A name not in the list, made from `base` by adding _1, _2 and so on. A number already at the end of
    // `base` is replaced, so copying `crate_2` gives `crate_3` and not `crate_2_1`.
    UniqueNameAmong :: (names: Array<string!>, base: string) -> string! {
        stem~ string = base;
        lastUnderscore~ usize? = null;
        for index~ usize = 0; index < base.length(); index++ {
            if base.byteAt(index) == u8(95) {
                lastUnderscore = index;
            }
        }
        if underscore := lastUnderscore {
            if AllDigits(base.substring(underscore + 1, base.length() - underscore - 1)) {
                stem = base.substring(0, underscore);
            }
        }
        number~ u64 = 1;
        while true {
            candidate: string! = `${stem}_${number}`;
            taken~ bool = false;
            for name in names {
                if name == candidate {
                    taken = true;
                }
            }
            if !taken {
                return candidate!;
            }
            delete candidate;
            number += 1;
        }
        return `${stem}`;
    }

    // The names of every entity in a level.
    EntityNames :: (worldFile: lantern:::world:::WorldFile*) -> Array<string!>! {
        names~ Array<string!>! = [];
        for entity in worldFile->entities {
            names.push(`${entity->name}`);
        }
        return names!;
    }

    // A name that no entity in the level has yet, based on `base`.
    UniqueName :: (worldFile: lantern:::world:::WorldFile*, base: string) -> string! {
        names~ Array<string!>! = EntityNames(worldFile);
        unique: string! = UniqueNameAmong(names, base);
        names.freeAll();
        return unique!;
    }

    // The vector with one axis (x, y or z) replaced.
    WithAxis :: (vector: Vec3, axis: Axis, value: f32) -> Vec3 {
        return WithComponent(vector, AxisIndex(axis), value);
    }

    // One axis of a vector.
    AlongAxis :: (vector: Vec3, axis: Axis) -> f32 {
        return AxisComponent(vector, AxisIndex(axis));
    }
}
