lantern:::editor :: namespace {
    // The editor's whole state and everything the person can do, with no knowledge of windows or the GPU. The
    // app feeds it pointer, key and menu events; it keeps the open document, the selection, the camera and
    // gizmo, the drag in progress, the console and the status line, and it answers questions the UI draws
    // from (the outliner rows, the inspector fields). Because it has no window, tests drive it directly.
    //
    // Two counters tell the UI when to redraw: the document's `revision` (the level changed) and
    // `localRevision` (something outside the level, such as the selection, the tool or the status, changed);
    // UiRevision adds them. `hidden` and `locked` are view states kept here and not saved in the level.
    EditorSession :: class {
    public:
        document~ EditorDocument*!;
        palette~ Palette*!;
        palettePath~ string!? = null;
        selection~ Array<u64>! = [];
        camera~ OrbitCamera = OrbitCamera { };
        tool~ GizmoTool = GizmoTool:::Translate;
        space~ GizmoSpace = GizmoSpace:::World;
        pivotMode~ PivotMode = PivotMode:::Primary;
        snap~ SnapSettings = SnapSettings { };
        view~ ViewOptions = ViewOptions { };
        hidden~ Array<u64>! = [];
        locked~ Array<u64>! = [];
        bookmarkSet~ Array<bool>! = [];
        bookmarkCameras~ Array<OrbitCamera>! = [];
        geometry~ SceneGeometry*!;
        viewportSize~ Vec2 = Vec2 { x: 1280.0f, y: 720.0f };
        pointer~ Vec2 = Vec2 { };
        drag~ Drag*!? = null;
        hoveredHandle~ Handle? = null;
        hoveredEntity~ u64? = null;
        hoveredViewCubeFace~ usize? = null;
        clickCycle~ Array<u64>! = [];
        clickCyclePixel~ Vec2? = null;
        clickCycleCamera~ OrbitCamera = OrbitCamera { };
        leftDown~ bool = false;
        middleDown~ bool = false;
        rightDown~ bool = false;
        keysHeld~ Array<u8>! = [];
        status~ string!;
        log~ Array<LogEntry*!>! = [];
        recentFiles~ Array<string!>! = [];
        paletteRevision~ u64 = 0;
        localRevision~ u64 = 0;

        // Builds the session for a document and palette, makes the pick geometry and the camera bookmark slots,
        // and frames the whole level.
        EditorSession~: (sessionDocument: EditorDocument*!, sessionPalette: Palette*!) {
            document = sessionDocument!;
            palette = sessionPalette!;
            status = "".copy();
            geometry = SceneGeometry:::Build(document->documentWorldFile, document->Revision());
            for slot~ usize = 0; slot < BOOKMARK_COUNT; slot++ {
                bookmarkSet.push(false);
                bookmarkCameras.push(OrbitCamera { });
            }
            FrameAll();
        }

        !EditorSession~: () {
            delete drag;
            delete geometry;
            delete document;
            delete palette;
            delete palettePath;
            delete selection;
            delete hidden;
            delete locked;
            delete bookmarkSet;
            delete bookmarkCameras;
            delete keysHeld;
            delete clickCycle;
            delete status;
            log.freeAll();
            recentFiles.freeAll();
        }

        // A session for a level that is already in memory, with an optional path to save it to.
        static Create :: (worldFile: lantern:::world:::WorldFile*!, path: string?, sessionPalette: Palette*!) -> EditorSession*! {
            ownedPath~ string!? = null;
            if given := path {
                ownedPath = `${given}`;
            }
            return new EditorSession(new EditorDocument(worldFile!, ownedPath!), sessionPalette!);
        }

        // A session for a level file. Adds it to the recent files and says so in the status line. Returns the
        // loader's error message when the file cannot be read.
        static Open :: (path: string, sessionPalette: Palette*!) -> Result<EditorSession*!, string!> {
            when EditorDocument:::Open(path) {
                Result:::Ok(opened) -> {
                    session := new EditorSession(opened!, sessionPalette!);
                    session->RememberRecentFile(path);
                    name: string! = DisplayName(path);
                    session->SetStatus(`Opened ${name}`);
                    delete name;
                    return Result<EditorSession*!, string!>:::Ok(session!);
                },
                Result:::Err(message) -> {
                    delete sessionPalette;
                    return Result<EditorSession*!, string!>:::Err(message!);
                }
            }
        }

        // Remembers the palette file's path, so the palette can be saved back to it.
        SetPalettePath~: (path: string?) -> void {
            delete palettePath;
            palettePath = null;
            if given := path {
                palettePath = `${given}`;
            }
        }

        // The level being edited.
        World :: () -> lantern:::world:::WorldFile* {
            return document->documentWorldFile;
        }

        // The number the UI watches: it changes whenever the level or the editor's own state changes.
        UiRevision :: () -> u64 {
            return document->Revision() + localRevision;
        }

        // Rebuilds the pick geometry when the level has changed since it was last built.
        RefreshGeometry~: () -> void {
            if geometry->revision != document->Revision() {
                delete geometry;
                geometry = SceneGeometry:::Build(document->documentWorldFile, document->Revision());
            }
        }

        // The entity the inspector and gizmo work on: the one most recently added to the selection.
        PrimarySelection :: () -> u64? {
            if selection.length() == 0 {
                return null;
            }
            return selection[selection.length() - 1];
        }

        // True when the entity is selected.
        IsSelected :: (key: u64) -> bool {
            return ContainsKeyIn(selection, key);
        }

        // True when the entity is hidden in the viewport.
        IsHidden :: (key: u64) -> bool {
            return ContainsKeyIn(hidden, key);
        }

        // True when the entity is locked: it can be selected but not moved.
        IsLocked :: (key: u64) -> bool {
            return ContainsKeyIn(locked, key);
        }

        // True when a camera bookmark slot has been set.
        HasBookmark :: (slot: usize) -> bool {
            return slot < bookmarkSet.length() && bookmarkSet[slot];
        }

        // The gizmo handle to highlight: the one being dragged, else the one under the mouse.
        HoveredHandle :: () -> Handle? {
            if current := drag {
                if current->kind == DragKind:::Gizmo {
                    return current->handle;
                }
            }
            return hoveredHandle;
        }

        // True while a selection rectangle is being dragged.
        IsRubberBanding :: () -> bool {
            if current := drag {
                return current->kind == DragKind:::RubberBand;
            }
            return false;
        }

        // The corner where the selection rectangle began.
        RubberBandStart :: () -> Vec2 {
            if current := drag {
                return current->press;
            }
            return pointer;
        }

        // The camera and viewport size together, for turning pixels into rays and points into pixels.
        Projection :: () -> ViewportProjection {
            return ViewportProjection:::Create(camera.RenderCamera(), viewportSize);
        }

        // The window title: the file name (or "untitled"), with a star when there are unsaved changes.
        Title :: () -> string! {
            name~ string! = "untitled".copy();
            if own := document->path {
                delete name;
                name = DisplayName(own);
            }
            if document->IsDirty() {
                name += " *";
            }
            return name!;
        }

        // The camera's mode, position and angles as a line of text for the status bar.
        CameraDescription :: () -> string! {
            position: Vec3 = camera.Position();
            mode: string = when camera.orthographic { true -> "ortho", false -> "persp" };
            x: string! = FormatNumber(position.x);
            y: string! = FormatNumber(position.y);
            z: string! = FormatNumber(position.z);
            yaw: string! = FormatNumber(camera.yaw * (180.0f / Math:::PI));
            pitch: string! = FormatNumber(camera.pitch * (180.0f / Math:::PI));
            description: string! = `${mode} at ${x}, ${y}, ${z}  yaw ${yaw}  pitch ${pitch}`;
            delete x;
            delete y;
            delete z;
            delete yaw;
            delete pitch;
            return description!;
        }

        // An entity's parent, or null when it has none or the parent is missing, so an orphan shows at the top
        // level of the outliner and not nowhere.
        ShownParent :: (entity: lantern:::world:::WorldEntity*) -> u64? {
            guard parent := entity->parent return null;
            if document->documentWorldFile->IndexOf(parent) == null {
                return null;
            }
            return parent;
        }

        // The rows of the outliner: the entities as a tree, parents before children, in file order, each with
        // its depth and its selected, hidden and locked state. It walks with a stack of keys and depths and not
        // by calling itself, and stops if it ever yields more rows than there are entities (which only a
        // parent cycle could cause).
        Outline :: () -> Array<OutlineRow*!>! {
            worldFile: lantern:::world:::WorldFile* = document->documentWorldFile;
            rows~ Array<OutlineRow*!>! = [];
            stackKeys~ Array<u64>! = [];
            stackDepths~ Array<u32>! = [];
            index~ usize = worldFile->entities.length();
            while index > 0 {
                index -= 1;
                if ShownParent(worldFile->entities[index]) == null {
                    stackKeys.push(worldFile->entities[index]->id);
                    stackDepths.push(0);
                }
            }
            while stackKeys.length() > 0 {
                key: u64 = stackKeys.remove(stackKeys.length() - 1);
                depth: u32 = stackDepths.remove(stackDepths.length() - 1);
                found: usize? = worldFile->IndexOf(key);
                guard entityIndex := found continue;
                entity: lantern:::world:::WorldEntity* = worldFile->entities[entityIndex];
                children~ Array<u64>! = [];
                for child in worldFile->entities {
                    if SameOptionalU64(ShownParent(child), key) {
                        children.push(child->id);
                    }
                }
                row := new OutlineRow(key, entity->name, entity->kind);
                row->parent = ShownParent(entity);
                row->depth = depth;
                row->selected = IsSelected(key);
                row->hidden = IsHidden(key);
                row->locked = IsLocked(key);
                row->hasChildren = children.length() > 0;
                rows.push(row!);
                if rows.length() > worldFile->entities.length() {
                    delete children;
                    break;
                }
                childIndex~ usize = children.length();
                while childIndex > 0 {
                    childIndex -= 1;
                    stackKeys.push(children[childIndex]);
                    stackDepths.push(depth + 1);
                }
                delete children;
            }
            delete stackKeys;
            delete stackDepths;
            return rows!;
        }

        // The inspector's fields for the current selection, with a mixed flag on those that differ between
        // the selected entities. Empty when nothing is selected.
        Inspector :: () -> Array<InspectorField*!>! {
            primaryFound: u64? = PrimarySelection();
            guard key := primaryFound return [];
            worldFile: lantern:::world:::WorldFile* = document->documentWorldFile;
            found: usize? = worldFile->IndexOf(key);
            guard primaryIndex := found return [];
            others~ Array<lantern:::world:::WorldEntity*>! = [];
            for other in selection {
                if other != key {
                    if otherIndex := worldFile->IndexOf(other) {
                        others.push(worldFile->entities[otherIndex]);
                    }
                }
            }
            fields: Array<InspectorField*!>! = FieldsForSelection(worldFile->entities[primaryIndex], others, worldFile, palette);
            delete others;
            return fields!;
        }

        // Shows a message in the status line and adds it to the console as information.
        SetStatus~: (text: string!) -> void {
            delete status;
            status = `${text}`;
            LogLine(LogLevel:::Info, text);
            delete text;
            localRevision += 1;
        }

        // Adds a line to the console, dropping the oldest once there are more than LOG_LIMIT. Empty text is ignored.
        LogLine~: (level: LogLevel, text: string) -> void {
            if text.length() == 0 {
                return;
            }
            log.push(new LogEntry(level, text));
            if log.length() > LOG_LIMIT {
                oldest := log.remove(0);
                delete oldest;
            }
        }

        // Records a message. Warnings and errors also go to the status line; information goes to the console only.
        Note~: (level: LogLevel, text: string) -> void {
            if level != LogLevel:::Info {
                delete status;
                status = `${text}`;
            }
            LogLine(level, text);
            localRevision += 1;
        }

        // Empties the console.
        ClearLog~: () -> void {
            log.freeAll();
            log = [];
            localRevision += 1;
        }

        // Takes the result of an operation that may have failed (an error message, or null for success). On
        // a failure it logs it, shows it in the status line and returns false; otherwise returns true. Most
        // menu actions end with it.
        Report~: (failure: string!?) -> bool {
            guard message := failure return true;
            lantern:::core:::LogWarn("editor", message);
            delete status;
            status = `${message}`;
            LogLine(LogLevel:::Error, message);
            delete failure;
            localRevision += 1;
            return false;
        }

        // Reports a refusal (an action the editor will not do) and returns false.
        Refuse~: (message: string!) -> bool {
            return Report(message!);
        }

        // Saves the level to its own path.
        Save~: () -> bool {
            when document->Save(null) {
                Result:::Ok(savedPath) -> {
                    return FinishSave(savedPath!);
                },
                Result:::Err(message) -> {
                    return Refuse(message!);
                }
            }
        }

        // Saves the level to a new path, which becomes its path.
        SaveAs~: (path: string) -> bool {
            when document->Save(path) {
                Result:::Ok(savedPath) -> {
                    return FinishSave(savedPath!);
                },
                Result:::Err(message) -> {
                    return Refuse(message!);
                }
            }
        }

        // The part of saving that follows success: remember the file and say so.
        FinishSave~: (path: string!) -> bool {
            RememberRecentFile(path);
            name: string! = DisplayName(path);
            SetStatus(`Saved ${name}`);
            delete name;
            delete path;
            return true;
        }

        // Opens another level file in place of the current one.
        Load~: (path: string) -> bool {
            when EditorDocument:::Open(path) {
                Result:::Ok(opened) -> {
                    ReplaceDocument(opened!);
                    RememberRecentFile(path);
                    name: string! = DisplayName(path);
                    SetStatus(`Opened ${name}`);
                    delete name;
                    return true;
                },
                Result:::Err(message) -> {
                    return Refuse(message!);
                }
            }
        }

        // Starts an empty level with a name and no path.
        NewWorld~: (name: string) -> void {
            ReplaceDocument(new EditorDocument(new lantern:::world:::WorldFile(name), null));
            SetStatus(`New world '${name}'`);
        }

        // Swaps in a different document and resets what belonged to the old one: selection, hidden and locked
        // sets, any drag and the pick geometry. The counter is carried forward so the UI sees a change.
        ReplaceDocument~: (replacement: EditorDocument*!) -> void {
            carriedRevision: u64 = UiRevision() + 1;
            delete document;
            document = replacement!;
            localRevision = carriedRevision;
            selection.clear();
            hidden.clear();
            locked.clear();
            delete drag;
            drag = null;
            delete geometry;
            geometry = SceneGeometry:::Build(document->documentWorldFile, document->Revision());
            FrameAll();
        }

        // Puts a path at the top of the recent files list (removing an earlier entry for it) and keeps at
        // most RECENT_FILE_LIMIT.
        RememberRecentFile~: (path: string) -> void {
            index~ usize = 0;
            while index < recentFiles.length() {
                if recentFiles[index] == path {
                    removed := recentFiles.remove(index);
                    delete removed;
                } else {
                    index += 1;
                }
            }
            recentFiles.insert(0, `${path}`);
            while recentFiles.length() > RECENT_FILE_LIMIT {
                removed := recentFiles.remove(recentFiles.length() - 1);
                delete removed;
            }
        }

        // Replaces the recent files list, for loading it from the preferences.
        SetRecentFiles~: (paths: Array<string!>) -> void {
            recentFiles.freeAll();
            recentFiles = [];
            for path in paths {
                if recentFiles.length() < RECENT_FILE_LIMIT {
                    recentFiles.push(`${path}`);
                }
            }
            localRevision += 1;
        }

        // Called after any change of selection. It ends the current undo merge, so edits made before and after
        // the selection changed are separate undo steps, and tells the UI.
        SelectionChanged~: () -> void {
            document->SealHistory();
            localRevision += 1;
        }

        // Replaces the selection with these entities.
        SetSelection~: (keys: Array<u64>!) -> void {
            delete selection;
            selection = keys!;
            SelectionChanged();
        }

        // Selects just this entity, if it exists.
        SelectOnly~: (key: u64) -> void {
            if document->documentWorldFile->IndexOf(key) != null {
                only~ Array<u64>! = [];
                only.push(key);
                SetSelection(only!);
            }
        }

        // Adds the entity to the selection, or removes it if it is already in (shift click).
        ToggleSelected~: (key: u64) -> void {
            if position := KeyPosition(selection, key) {
                selection.remove(position);
            } else if document->documentWorldFile->IndexOf(key) != null {
                selection.push(key);
            }
            SelectionChanged();
        }

        // Selects nothing.
        ClearSelection~: () -> void {
            if selection.length() > 0 {
                selection.clear();
                SelectionChanged();
            }
        }

        // Selects every entity.
        SelectAll~: () -> void {
            keys~ Array<u64>! = [];
            for entity in document->documentWorldFile->entities {
                keys.push(entity->id);
            }
            SetSelection(keys!);
        }

        // Selects what is not selected and deselects what is.
        InvertSelection~: () -> void {
            keys~ Array<u64>! = [];
            for entity in document->documentWorldFile->entities {
                if !IsSelected(entity->id) {
                    keys.push(entity->id);
                }
            }
            SetSelection(keys!);
        }

        // Selects every entity of a kind.
        SelectKind~: (kind: string) -> void {
            keys~ Array<u64>! = [];
            for entity in document->documentWorldFile->entities {
                if entity->kind == kind {
                    keys.push(entity->id);
                }
            }
            SetSelection(keys!);
        }

        // The given entities and all their children, grandchildren and so on, each listed once.
        Descendants :: (roots: Array<u64>) -> Array<u64>! {
            keys~ Array<u64>! = CopyKeys(roots);
            index~ usize = 0;
            while index < keys.length() {
                parent: u64 = keys[index];
                for entity in document->documentWorldFile->entities {
                    if SameOptionalU64(entity->parent, parent) && !ContainsKeyIn(keys, entity->id) {
                        keys.push(entity->id);
                    }
                }
                index += 1;
            }
            return keys!;
        }

        // Adds the descendants of the selection to it.
        SelectChildren~: () -> void {
            SetSelection(Descendants(selection));
        }

        // True when an entity with this key is in the level.
        Exists :: (key: u64) -> bool {
            return document->documentWorldFile->IndexOf(key) != null;
        }

        // The keys that still name an entity.
        Pruned :: (keys: Array<u64>) -> Array<u64>! {
            kept~ Array<u64>! = [];
            for key in keys {
                if Exists(key) {
                    kept.push(key);
                }
            }
            return kept!;
        }

        // Drops keys of deleted entities from the selection and the hidden and locked sets. Undo and redo call
        // it, since they can remove entities.
        PruneSelection~: () -> void {
            before: usize = selection.length();
            prunedSelection: Array<u64>! = Pruned(selection);
            delete selection;
            selection = prunedSelection!;
            prunedHidden: Array<u64>! = Pruned(hidden);
            delete hidden;
            hidden = prunedHidden!;
            prunedLocked: Array<u64>! = Pruned(locked);
            delete locked;
            locked = prunedLocked!;
            if selection.length() != before {
                localRevision += 1;
            }
        }

        // The selected entities that are not locked.
        MovableSelection :: () -> Array<u64>! {
            keys~ Array<u64>! = [];
            for key in selection {
                if !IsLocked(key) {
                    keys.push(key);
                }
            }
            return keys!;
        }

        // Hides or shows an entity in the viewport.
        SetHidden~: (key: u64, shouldHide: bool) -> void {
            position: usize? = KeyPosition(hidden, key);
            if shouldHide && position == null {
                hidden.push(key);
                localRevision += 1;
            } else if !shouldHide {
                if index := position {
                    hidden.remove(index);
                    localRevision += 1;
                }
            }
        }

        // Locks or unlocks an entity.
        SetLocked~: (key: u64, shouldLock: bool) -> void {
            position: usize? = KeyPosition(locked, key);
            if shouldLock && position == null {
                locked.push(key);
                localRevision += 1;
            } else if !shouldLock {
                if index := position {
                    locked.remove(index);
                    localRevision += 1;
                }
            }
        }

        // Hides the selected entities.
        HideSelection~: () -> void {
            keys: Array<u64>! = CopyKeys(selection);
            for key in keys {
                if !IsHidden(key) {
                    hidden.push(key);
                }
            }
            delete keys;
            count: string! = CountEntities(selection.length());
            SetStatus(`Hid ${count}`);
            delete count;
        }

        // Shows every hidden entity.
        UnhideAll~: () -> void {
            count: string! = CountEntities(hidden.length());
            hidden.clear();
            SetStatus(`Showed ${count}`);
            delete count;
        }

        // Locks or unlocks the selected entities.
        LockSelection~: (shouldLock: bool) -> void {
            keys: Array<u64>! = CopyKeys(selection);
            for key in keys {
                SetLocked(key, shouldLock);
            }
            delete keys;
            verb: string = when shouldLock { true -> "Locked", false -> "Unlocked" };
            count: string! = CountEntities(selection.length());
            SetStatus(`${verb} ${count}`);
            delete count;
        }

        // Chooses move, rotate or scale. The set functions below change the UI counter only when the value
        // really changes, so setting the same value again costs nothing.
        SetTool~: (newTool: GizmoTool) -> void {
            if tool != newTool {
                tool = newTool;
                localRevision += 1;
            }
        }

        // Chooses world or local handles.
        SetSpace~: (newSpace: GizmoSpace) -> void {
            if space != newSpace {
                space = newSpace;
                localRevision += 1;
            }
        }

        // Chooses where the gizmo sits for a multiple selection.
        SetPivotMode~: (mode: PivotMode) -> void {
            if pivotMode != mode {
                pivotMode = mode;
                localRevision += 1;
            }
        }

        // Turns the snapping of a dragged scene instance onto the sockets of its neighbours on or off.
        SetSocketSnapEnabled~: (enabled: bool) -> void {
            if snap.sockets != enabled {
                snap.sockets = enabled;
                localRevision += 1;
            }
        }

        // Turns snapping on or off.
        SetSnapEnabled~: (enabled: bool) -> void {
            if snap.enabled != enabled {
                snap.enabled = enabled;
                localRevision += 1;
            }
        }

        // Sets the step of the "translate", "rotate" or "scale" snap. A step that is not a positive, finite number
        // is refused.
        SetSnapStep~: (name: string, value: f32) -> bool {
            if !(value > 0.0f && lantern:::core:::IsFinite(value)) {
                shown: string! = FormatNumber(value);
                message: string! = `a snap step must be positive, not ${shown}`;
                delete shown;
                return Refuse(message!);
            }
            if name == "translate" {
                snap.translateStep = value;
            } else if name == "rotate" {
                snap.rotateStepDegrees = value;
            } else if name == "scale" {
                snap.scaleStep = value;
            } else {
                return Refuse(`unknown snap step '${name}'`);
            }
            localRevision += 1;
            return true;
        }

        // The step for a snap name, or null for an unknown name.
        SnapStep :: (name: string) -> f32? {
            if name == "translate" {
                return snap.translateStep;
            }
            if name == "rotate" {
                return snap.rotateStepDegrees;
            }
            if name == "scale" {
                return snap.scaleStep;
            }
            return null;
        }

        // Sets a View menu option by name and reports a bad name or value.
        SetViewOption~: (name: string, value: string) -> bool {
            failure: string!? = view.Set(name, value);
            succeeded: bool = Report(failure!);
            localRevision += 1;
            return succeeded;
        }

        // Throws away the drag in progress without restoring anything (the document does that).
        CancelDragState~: () -> void {
            delete drag;
            drag = null;
        }

        // Undoes the last step (or cancels a drag), forgets selected entities that no longer exist and says
        // what was undone.
        Undo~: () -> bool {
            CancelDragState();
            label~ string! = "drag".copy();
            if given := document->UndoLabel() {
                delete label;
                label = given.toLower();
            }
            undone: bool = document->Undo();
            if undone {
                PruneSelection();
                SetStatus(`Undid ${label}`);
            }
            delete label;
            return undone;
        }

        // Redoes the last undone step.
        Redo~: () -> bool {
            label~ string! = "".copy();
            if given := document->RedoLabel() {
                delete label;
                label = given.toLower();
            }
            redone: bool = document->Redo();
            if redone {
                PruneSelection();
                SetStatus(`Redid ${label}`);
            }
            delete label;
            return redone;
        }

        // Moves to a step of the history panel.
        JumpHistory~: (position: usize) -> bool {
            CancelDragState();
            moved: bool = document->JumpHistory(position);
            if moved {
                PruneSelection();
                SetStatus(`Went to history step ${position}`);
            }
            return moved;
        }

        // A copy of the entity with this key, or null.
        EntityCopy :: (key: u64) -> lantern:::world:::WorldEntity*!? {
            found: usize? = document->documentWorldFile->IndexOf(key);
            guard index := found return null;
            return document->documentWorldFile->entities[index]->Copy();
        }

        // Runs edits as one undo step and reports a failure. Everything that changes the level goes through
        // this or the document's Execute.
        ExecuteEdits~: (label: string, edits: Array<Edit*!>!) -> bool {
            return Report(document->Execute(label, edits!));
        }

        // Applies an edit from the inspector to one entity: ApplyField makes the changed copy, and if it really
        // differs it is run as an undo step called "Edit FIELD". Steps for the same field of the same entity
        // merge into one, so typing in a box is one undo.
        SetField~: (key: u64, field: string, text: string) -> bool {
            found: usize? = document->documentWorldFile->IndexOf(key);
            guard index := found return Refuse(`no entity ${key}`);
            entity: lantern:::world:::WorldEntity* = document->documentWorldFile->entities[index];
            when ApplyField(entity, field, text) {
                Result:::Ok(edited) -> {
                    if edited->SameAs(entity) {
                        delete edited;
                        return true;
                    }
                    fieldName: string = when field.startsWith("property:") { true -> field.substring(9, field.length() - 9), false -> field };
                    label: string! = `Edit ${fieldName}`;
                    edits~ Array<Edit*!>! = [];
                    edits.push(Edit:::Replace(edited!));
                    failure: string!? = document->ExecuteCoalescing(label, edits!, key, field);
                    delete label;
                    return Report(failure!);
                },
                Result:::Err(message) -> {
                    return Refuse(message!);
                }
            }
        }

        // Applies an inspector edit to every selected entity as one undo step. A name edit is applied to the
        // primary entity only, since giving many entities one name makes no sense. If any entity refuses the
        // value, nothing changes.
        SetFieldOnSelection~: (field: string, text: string) -> bool {
            if selection.length() <= 1 || field == "name" {
                primaryFound: u64? = PrimarySelection();
                guard primary := primaryFound return false;
                return SetField(primary, field, text);
            }
            document->SealHistory();
            edits~ Array<Edit*!>! = [];
            for key in selection {
                found: usize? = document->documentWorldFile->IndexOf(key);
                guard index := found continue;
                entity: lantern:::world:::WorldEntity* = document->documentWorldFile->entities[index];
                when ApplyField(entity, field, text) {
                    Result:::Ok(edited) -> {
                        if edited->SameAs(entity) {
                            delete edited;
                        } else {
                            edits.push(Edit:::Replace(edited!));
                        }
                    },
                    Result:::Err(message) -> {
                        edits.freeAll();
                        return Refuse(message!);
                    }
                }
            }
            if edits.length() == 0 {
                edits.freeAll();
                return true;
            }
            fieldName: string = when field.startsWith("property:") { true -> field.substring(9, field.length() - 9), false -> field };
            count: string! = CountEntities(edits.length());
            label: string! = `Edit ${fieldName} on ${count}`;
            delete count;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            return succeeded;
        }

        // Ends the merging of edits when a box loses focus, so the next edit is a new undo step.
        CommitField~: () -> void {
            document->SealHistory();
        }

        // Renames a property on every selected entity that has it, keeping its value.
        RenameProperty~: (oldName: string, requestedName: string) -> bool {
            newName: string = requestedName.trim();
            if newName.length() == 0 {
                return Refuse("a property needs a name".copy());
            }
            edits~ Array<Edit*!>! = [];
            for key in selection {
                found: usize? = document->documentWorldFile->IndexOf(key);
                guard index := found continue;
                entity: lantern:::world:::WorldEntity* = document->documentWorldFile->entities[index];
                propertyFound: usize? = entity->PropertyIndex(oldName);
                guard propertyIndex := propertyFound continue;
                value: lantern:::world:::PropertyValue = entity->propertyValues[propertyIndex];
                text: string! = `${entity->propertyTexts[propertyIndex]}`;
                edited := entity->Copy();
                edited->RemoveProperty(oldName);
                edited->SetProperty(newName, value, text);
                delete text;
                edits.push(Edit:::Replace(edited!));
            }
            if edits.length() == 0 {
                edits.freeAll();
                return false;
            }
            label: string! = `Rename ${oldName} to ${newName}`;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            return succeeded;
        }

        // Rebuilds every placed Silhouette instance (a root whose `silhouette` property names a Silhouette in the palette)
        // from the Silhouette as it is now. Each root keeps its id, name, parent and transform and takes everything else
        // from the Silhouette; its descendants are rebuilt, keeping their names in order. One undo step. Returns how many
        // instances were rebuilt.
        RefreshSilhouetteInstances~: () -> usize {
            rootKeys~ Array<u64>! = [];
            rootSilhouettes~ Array<string!>! = [];
            for entity in document->documentWorldFile->entities {
                if propertyAt := entity->PropertyIndex("silhouette") {
                    silhouetteName: string = entity->propertyTexts[propertyAt];
                    if known := palette->Template(silhouetteName) {
                        if known->fromSilhouette {
                            rootKeys.push(entity->id);
                            rootSilhouettes.push(`${silhouetteName}`);
                        }
                    }
                }
            }
            edits~ Array<Edit*!>! = [];
            pending~ Array<lantern:::world:::WorldEntity*!>! = [];
            nextKey~ u64 = document->documentWorldFile->NextEntityKey();
            removedCount~ usize = 0;
            refreshed~ usize = 0;
            for position~ usize = 0; position < rootKeys.length(); position++ {
                rootKey: u64 = rootKeys[position];
                guard template := palette->Template(rootSilhouettes[position]) continue;
                guard rootIndex := document->documentWorldFile->IndexOf(rootKey) continue;
                oldRoot: lantern:::world:::WorldEntity* = document->documentWorldFile->entities[rootIndex];
                single~ Array<u64>! = [];
                single.push(rootKey);
                oldKeys: Array<u64>! = Descendants(single);
                delete single;
                oldNames~ Array<string!>! = [];
                for oldKey in oldKeys {
                    if oldKey != rootKey {
                        if oldIndex := document->documentWorldFile->IndexOf(oldKey) {
                            oldNames.push(`${document->documentWorldFile->entities[oldIndex]->name}`);
                        }
                        edits.push(Edit:::Remove(oldKey));
                        removedCount += 1;
                    }
                }
                delete oldKeys;
                freshRoot := template->prototype->Copy();
                freshRoot->id = rootKey;
                freshRoot->parent = oldRoot->parent;
                freshRoot->SetName(oldRoot->name);
                freshRoot->transform = oldRoot->transform;
                edits.push(Edit:::Replace(freshRoot!));
                groupKeys~ Array<u64>! = [];
                groupKeys.push(rootKey);
                for descendantIndex~ usize = 0; descendantIndex < template->descendants.length(); descendantIndex++ {
                    groupKeys.push(nextKey);
                    nextKey += 1;
                }
                for descendantIndex~ usize = 0; descendantIndex < template->descendants.length(); descendantIndex++ {
                    descendant := template->descendants[descendantIndex]->Copy();
                    descendant->id = groupKeys[descendantIndex + 1];
                    descendant->parent = groupKeys[template->descendantParents[descendantIndex]];
                    if descendantIndex < oldNames.length() {
                        descendant->SetName(oldNames[descendantIndex]);
                    }
                    pending.push(descendant!);
                }
                delete groupKeys;
                oldNames.freeAll();
                refreshed += 1;
            }
            delete rootKeys;
            rootSilhouettes.freeAll();
            if refreshed == 0 {
                edits.freeAll();
                pending.freeAll();
                return 0;
            }
            insertAt~ usize = document->documentWorldFile->entities.length() - removedCount;
            while pending.length() > 0 {
                inserted := pending.remove(0);
                edits.push(Edit:::Insert(insertAt, inserted!));
                insertAt += 1;
            }
            pending.freeAll();
            label: string! = "Refresh Silhouette instances".copy();
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            if !succeeded {
                return 0;
            }
            return refreshed;
        }

        // Places a new entity from a palette template and selects it. The position is where the mouse ray
        // (or the centre of the viewport) meets the level, rounded to the snap step on x and z, then raised so
        // a box rests on the surface and by the template's lift. The name is made unique (`block_1`,
        // `block_2`...). Returns the new key, or null if it failed.
        AddEntity~: (templateId: string, atCursor: bool) -> u64? {
            templateFound: EntityTemplate*? = palette->Template(templateId);
            if templateFound == null {
                Refuse(`no template '${templateId}'`);
                return null;
            }
            pixel: Vec2 = when atCursor { true -> pointer, false -> viewportSize * 0.5f };
            ray: Ray = Projection().RayThrough(pixel);
            RefreshGeometry();
            placed: Vec3? = geometry->PlacementPoint(ray);
            surface: Vec3 = placed ?? camera.target;
            step: f32 = when snap.enabled { true -> snap.translateStep, false -> 0.0f };
            position~ Vec3 = Vec3 { x: Snap(surface.x, step), y: surface.y, z: Snap(surface.z, step) };
            guard template := palette->Template(templateId) return null;
            if shape := template->prototype->shape {
                if shape.kind == lantern:::world:::ShapeKind:::Box {
                    position.y += shape.halfExtents.y;
                }
            }
            position.y += template->lift;
            key: u64 = document->documentWorldFile->NextEntityKey();
            entity := template->prototype->Copy();
            entity->id = key;
            name: string! = UniqueName(document->documentWorldFile, template->id);
            entity->SetName(name);
            delete name;
            entity->transform = lantern:::world:::TransformData:::FromPosition(position);
            label: string! = `Add ${template->label}`;
            lowered: string! = template->label.toLower();
            edits~ Array<Edit*!>! = [];
            edits.push(Edit:::Insert(document->documentWorldFile->entities.length(), entity!));
            for descendantIndex~ usize = 0; descendantIndex < template->descendants.length(); descendantIndex++ {
                descendant := template->descendants[descendantIndex]->Copy();
                descendant->id = key + 1 + u64(descendantIndex);
                parentPosition: usize = template->descendantParents[descendantIndex];
                descendant->parent = key + u64(parentPosition);
                descendantName: string! = UniqueName(document->documentWorldFile, descendant->name);
                descendant->SetName(descendantName);
                delete descendantName;
                edits.push(Edit:::Insert(document->documentWorldFile->entities.length() + 1 + descendantIndex, descendant!));
            }
            added: bool = ExecuteEdits(label, edits!);
            if !added {
                delete label;
                delete lowered;
                return null;
            }
            delete label;
            SelectOnly(key);
            SetStatus(`Added ${lowered}`);
            delete lowered;
            return key;
        }

        // Deletes the selected entities and all their descendants as one undo step. The removes are ordered
        // from the last position to the first, so the positions stay valid, and undo puts each back where it
        // was.
        DeleteSelection~: () -> bool {
            if selection.length() == 0 {
                return false;
            }
            doomed: Array<u64>! = Descendants(selection);
            positions~ Array<usize>! = [];
            for key in doomed {
                if index := document->documentWorldFile->IndexOf(key) {
                    positions.push(index);
                }
            }
            delete doomed;
            edits~ Array<Edit*!>! = [];
            while positions.length() > 0 {
                largestAt~ usize = 0;
                for index~ usize = 1; index < positions.length(); index++ {
                    if positions[index] > positions[largestAt] {
                        largestAt = index;
                    }
                }
                position: usize = positions.remove(largestAt);
                edits.push(Edit:::Remove(document->documentWorldFile->entities[position]->id));
            }
            delete positions;
            count: usize = edits.length();
            countText: string! = CountEntities(count);
            label: string! = `Delete ${countText}`;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            if !succeeded {
                delete countText;
                return false;
            }
            selection.clear();
            SelectionChanged();
            SetStatus(`Deleted ${countText}`);
            delete countText;
            return true;
        }

        // Duplicates the selection, offset along x: four snap steps (at least one metre) with snapping
        // on, otherwise one metre.
        DuplicateSelection~: () -> bool {
            offset: f32 = when snap.enabled { true -> Math:::max(snap.translateStep, 0.25f) * 4.0f, false -> 1.0f };
            return DuplicateWithOffset(Vec3 { x: offset, y: 0.0f, z: 0.0f }, "Duplicate");
        }

        // Duplicates the selection one body's width along an axis, so repeated duplicates make a row of
        // bricks that touch. With snapping on the distance is rounded to the step.
        DuplicateSelectionAlong~: (axis: Axis) -> bool {
            RefreshGeometry();
            bounds: lantern:::core:::Aabb = geometry->BoundsOf(selection);
            extent: f32 = when bounds.IsEmpty() { true -> 1.0f, false -> Math:::max(AlongAxis(bounds.max - bounds.min, axis), 0.25f) };
            step: f32 = when snap.enabled { true -> Math:::max(Snap(extent, snap.translateStep), snap.translateStep), false -> extent };
            verb: string! = `Duplicate along ${AxisUpperName(axis)}`;
            duplicated: bool = DuplicateWithOffset(AxisUnit(axis) * step, verb);
            delete verb;
            return duplicated;
        }

        // Copies each selected entity (keeping its parent), gives the copy a unique name and moves it by an
        // offset in world space, then selects the copies. One undo step, named with `verb`.
        DuplicateWithOffset~: (worldOffset: Vec3, verb: string) -> bool {
            if selection.length() == 0 {
                return false;
            }
            keys: Array<u64>! = CopyKeys(selection);
            originals~ Array<DragOriginal*!>! = DragOriginalsFor(keys);
            delete keys;
            nextKey~ u64 = document->documentWorldFile->NextEntityKey();
            names~ Array<string!>! = EntityNames(document->documentWorldFile);
            edits~ Array<Edit*!>! = [];
            copies~ Array<u64>! = [];
            for original in originals {
                copy := original->entity->Copy();
                copy->id = nextKey;
                nextKey += 1;
                name: string! = UniqueNameAmong(names, original->entity->name);
                copy->SetName(name);
                names.push(name!);
                copy->transform.position = original->LocalPosition(original->worldPosition + worldOffset);
                copies.push(copy->id);
                edits.push(Edit:::Insert(LAST_INDEX, copy!));
            }
            names.freeAll();
            originals.freeAll();
            count: string! = CountEntities(copies.length());
            label: string! = `${verb} ${count}`;
            delete count;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            if !succeeded {
                delete copies;
                return false;
            }
            SetSelection(copies!);
            return true;
        }

        // Mirrors the movable selection across the plane through the centre of the selection, at right
        // angles to an axis: positions flip along the axis, and the rotation angles about the other two axes
        // are negated.
        MirrorSelection~: (axis: Axis) -> bool {
            movable: Array<u64>! = MovableSelection();
            if movable.length() == 0 {
                delete movable;
                return false;
            }
            centerFound: Vec3? = PivotPoint(PivotMode:::Center);
            center: Vec3 = centerFound ?? Vec3 { };
            originals~ Array<DragOriginal*!>! = DragOriginalsFor(movable);
            delete movable;
            edits~ Array<Edit*!>! = [];
            for original in originals {
                entity := original->entity->Copy();
                newWorld: Vec3 = WithAxis(original->worldPosition, axis, 2.0f * AlongAxis(center, axis) - AlongAxis(original->worldPosition, axis));
                entity->transform.position = original->LocalPosition(newWorld);
                rotation~ Vec3 = entity->transform.rotationDegrees;
                rotation = WithAxis(rotation, FirstOtherAxis(axis), -AlongAxis(rotation, FirstOtherAxis(axis)));
                rotation = WithAxis(rotation, SecondOtherAxis(axis), -AlongAxis(rotation, SecondOtherAxis(axis)));
                entity->transform.rotationDegrees = rotation;
                edits.push(Edit:::Replace(entity!));
            }
            originals.freeAll();
            count: string! = CountEntities(edits.length());
            label: string! = `Mirror ${count} across ${AxisUpperName(axis)}`;
            delete count;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            return succeeded;
        }

        // Drops each movable entity straight down until its lowest point rests on whatever is below (not
        // counting the selection), or on the ground at y = 0.
        SnapSelectionToGround~: () -> bool {
            movable: Array<u64>! = MovableSelection();
            if movable.length() == 0 {
                delete movable;
                return false;
            }
            originals~ Array<DragOriginal*!>! = DragOriginalsFor(movable);
            delete movable;
            RefreshGeometry();
            edits~ Array<Edit*!>! = [];
            for original in originals {
                placedFound: EntityGeometry*? = geometry->Find(original->entity->id);
                guard placed := placedFound continue;
                bottom: f32 = placed->bounds.min.y;
                ray := Ray { origin: Vec3 { x: original->worldPosition.x, y: bottom + 0.001f, z: original->worldPosition.z }, direction: Vec3 { x: 0.0f, y: -1.0f, z: 0.0f } };
                hit: PickHit? = geometry->PickExcluding(ray, selection);
                surfaceY~ f32 = 0.0f;
                if below := hit {
                    surfaceY = below.point.y;
                }
                delta: f32 = surfaceY - bottom;
                if Math:::abs(delta) < 0.0001f {
                    continue;
                }
                entity := original->entity->Copy();
                entity->transform.position = original->LocalPosition(original->worldPosition + Vec3 { x: 0.0f, y: delta, z: 0.0f });
                edits.push(Edit:::Replace(entity!));
            }
            originals.freeAll();
            if edits.length() == 0 {
                edits.freeAll();
                SetStatus("Already on the ground".copy());
                return true;
            }
            count: string! = CountEntities(edits.length());
            label: string! = `Snap ${count} to ground`;
            delete count;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            return succeeded;
        }

        // The world matrix of an entity (the identity for none), which includes all its parents.
        WorldMatrixOf~: (key: u64?) -> Mat4 {
            guard present := key return Mat4 { };
            RefreshGeometry();
            found: EntityGeometry*? = geometry->Find(present);
            guard placed := found return Mat4 { };
            return placed->worldMatrix;
        }

        // An entity's position in the world.
        WorldOriginOf~: (key: u64) -> Vec3 {
            RefreshGeometry();
            found: EntityGeometry*? = geometry->Find(key);
            guard placed := found return Vec3 { };
            return placed->Origin();
        }

        // Puts an entity under another (or at the top level for null), keeping it where it is in the world.
        // Parenting an entity under itself or its own descendant is refused.
        SetParent~: (child: u64, parent: u64?) -> bool {
            entityFound: lantern:::world:::WorldEntity*!? = EntityCopy(child);
            guard entityFound return false;
            if SameOptionalU64(entityFound->parent, parent) {
                delete entityFound;
                return true;
            }
            if ParentChainContains(parent, child) {
                delete entityFound;
                return Refuse("an entity cannot be parented under itself".copy());
            }
            KeepWorldPositionUnder(entityFound, child, parent);
            edits~ Array<Edit*!>! = [];
            edits.push(Edit:::Replace(entityFound!));
            return ExecuteEdits("Change parent", edits!);
        }

        // Moves an entity in the list so it comes just before a sibling (or to the end for null), taking on the
        // sibling's parent. It is the outliner's drag and drop. Done as a remove and an insert in one undo step.
        MoveBefore~: (child: u64, sibling: u64?) -> bool {
            worldFile: lantern:::world:::WorldFile* = document->documentWorldFile;
            guard childIndex := worldFile->IndexOf(child) return false;
            newParent~ u64? = null;
            targetIndex~ usize = LAST_INDEX;
            if siblingKey := sibling {
                if siblingKey == child {
                    return true;
                }
                guard siblingIndex := worldFile->IndexOf(siblingKey) return false;
                newParent = worldFile->entities[siblingIndex]->parent;
                targetIndex = when (childIndex < siblingIndex) { true -> siblingIndex - 1, false -> siblingIndex };
            }
            sameParent: bool = SameOptionalU64(worldFile->entities[childIndex]->parent, newParent);
            alreadyLast: bool = sibling == null && childIndex + 1 == worldFile->entities.length();
            if sameParent && (targetIndex == childIndex || alreadyLast) {
                return true;
            }
            if ParentChainContains(newParent, child) {
                return Refuse("an entity cannot be parented under itself".copy());
            }
            entityFound: lantern:::world:::WorldEntity*!? = EntityCopy(child);
            guard entityFound return false;
            if !sameParent {
                KeepWorldPositionUnder(entityFound, child, newParent);
            }
            name: string! = `${entityFound->name}`;
            label: string! = `Move ${name}`;
            delete name;
            edits~ Array<Edit*!>! = [];
            edits.push(Edit:::Remove(child));
            edits.push(Edit:::Insert(targetIndex, entityFound!));
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            return succeeded;
        }

        // True when going up from `start` through its parents reaches `key`. It is how a parent cycle is
        // spotted, and the loop stops after as many steps as there are entities in case the file already
        // has a cycle.
        ParentChainContains~: (start: u64?, key: u64) -> bool {
            current~ u64? = start;
            steps~ usize = 0;
            while current != null && steps <= document->documentWorldFile->entities.length() {
                visited: u64 = current ?? 0;
                if visited == key {
                    return true;
                }
                found: usize? = document->documentWorldFile->IndexOf(visited);
                current = null;
                if index := found {
                    current = document->documentWorldFile->entities[index]->parent;
                }
                steps += 1;
            }
            return false;
        }

        // Gives an entity a new parent and recalculates its local position so its world position does
        // not change.
        KeepWorldPositionUnder~: (entity: lantern:::world:::WorldEntity~*, key: u64, parent: u64?) -> void {
            worldPosition: Vec3 = WorldOriginOf(key);
            newParentWorld: Mat4 = WorldMatrixOf(parent);
            entity->parent = parent;
            entity->transform.position = InverseOrIdentity(newParentWorld).transformPoint(worldPosition);
        }

        // Puts the selected entities under a new empty "group" entity placed at their centre. If they all
        // share a parent, the group goes under it too. Each member's position is made relative to the group, so
        // nothing moves on screen.
        GroupSelection~: () -> bool {
            if selection.length() == 0 {
                return false;
            }
            keys: Array<u64>! = CopyKeys(selection);
            centerFound: Vec3? = PivotPoint(PivotMode:::Center);
            center: Vec3 = centerFound ?? Vec3 { };
            worldFile: lantern:::world:::WorldFile* = document->documentWorldFile;
            firstParent~ u64? = null;
            if firstIndex := worldFile->IndexOf(keys[0]) {
                firstParent = worldFile->entities[firstIndex]->parent;
            }
            shared~ bool = true;
            for key in keys {
                if index := worldFile->IndexOf(key) {
                    if !SameOptionalU64(worldFile->entities[index]->parent, firstParent) {
                        shared = false;
                    }
                } else {
                    shared = false;
                }
            }
            commonParent: u64? = when shared { true -> firstParent, false -> null };
            groupKey: u64 = worldFile->NextEntityKey();
            parentWorld: Mat4 = WorldMatrixOf(commonParent);
            name: string! = UniqueName(document->documentWorldFile, "group");
            group := new lantern:::world:::WorldEntity(groupKey, name, "group");
            delete name;
            group->parent = commonParent;
            group->transform = lantern:::world:::TransformData:::FromPosition(InverseOrIdentity(parentWorld).transformPoint(center));
            edits~ Array<Edit*!>! = [];
            edits.push(Edit:::Insert(LAST_INDEX, group!));
            groupInverse: Mat4 = InverseOrIdentity(Mat4:::translation(center));
            for key in keys {
                editedFound: lantern:::world:::WorldEntity*!? = EntityCopy(key);
                guard editedFound continue;
                editedFound->parent = groupKey;
                editedFound->transform.position = groupInverse.transformPoint(WorldOriginOf(key));
                edits.push(Edit:::Replace(editedFound!));
            }
            count: string! = CountEntities(keys.length());
            delete keys;
            label: string! = `Group ${count}`;
            grouped: bool = ExecuteEdits(label, edits!);
            if !grouped {
                delete label;
                delete count;
                return false;
            }
            delete label;
            only~ Array<u64>! = [];
            only.push(groupKey);
            SetSelection(only!);
            SetStatus(`Grouped ${count}`);
            delete count;
            return true;
        }

        // Moves the other movable entities to the primary entity's position along one axis.
        AlignSelection~: (axis: Axis) -> bool {
            primaryFound: u64? = PrimarySelection();
            guard primary := primaryFound return false;
            movable~ Array<u64>! = [];
            all: Array<u64>! = MovableSelection();
            for key in all {
                if key != primary {
                    movable.push(key);
                }
            }
            delete all;
            if movable.length() == 0 {
                delete movable;
                return false;
            }
            target: f32 = AlongAxis(WorldOriginOf(primary), axis);
            originals~ Array<DragOriginal*!>! = DragOriginalsFor(movable);
            edits~ Array<Edit*!>! = [];
            for original in originals {
                entity := original->entity->Copy();
                entity->transform.position = original->LocalPosition(WithAxis(original->worldPosition, axis, target));
                edits.push(Edit:::Replace(entity!));
            }
            originals.freeAll();
            count: string! = CountEntities(movable.length());
            delete movable;
            label: string! = `Align ${count} on ${AxisUpperName(axis)}`;
            delete count;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            return succeeded;
        }

        // Spaces three or more movable entities evenly along an axis between the lowest and highest, in
        // their current order along it.
        DistributeSelection~: (axis: Axis) -> bool {
            movable: Array<u64>! = MovableSelection();
            if movable.length() < 3 {
                delete movable;
                return Refuse("distributing needs at least three entities".copy());
            }
            unsorted~ Array<DragOriginal*!>! = DragOriginalsFor(movable);
            originals~ Array<DragOriginal*!>! = [];
            while unsorted.length() > 0 {
                smallestAt~ usize = 0;
                for index~ usize = 1; index < unsorted.length(); index++ {
                    if AlongAxis(unsorted[index]->worldPosition, axis) < AlongAxis(unsorted[smallestAt]->worldPosition, axis) {
                        smallestAt = index;
                    }
                }
                taken := unsorted.remove(smallestAt);
                originals.push(taken!);
            }
            unsorted.freeAll();
            first: f32 = AlongAxis(originals[0]->worldPosition, axis);
            last: f32 = AlongAxis(originals[originals.length() - 1]->worldPosition, axis);
            step: f32 = (last - first) / f32(originals.length() - 1);
            edits~ Array<Edit*!>! = [];
            for index~ usize = 0; index < originals.length(); index++ {
                original: DragOriginal* = originals[index];
                entity := original->entity->Copy();
                entity->transform.position = original->LocalPosition(WithAxis(original->worldPosition, axis, first + step * f32(index)));
                edits.push(Edit:::Replace(entity!));
            }
            originals.freeAll();
            count: string! = CountEntities(movable.length());
            delete movable;
            label: string! = `Distribute ${count} along ${AxisUpperName(axis)}`;
            delete count;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            return succeeded;
        }

        // The first palette template that makes this kind of entity, or null.
        TemplateForKind :: (kind: string) -> EntityTemplate*? {
            for template in palette->templates {
                if template->Kind() == kind {
                    return template;
                }
            }
            return null;
        }

        // Resets each selected entity's shape, material, tint, collider and properties to its template's,
        // keeping its id, name, kind, parent and transform.
        RevertSelectionToTemplate~: () -> bool {
            edits~ Array<Edit*!>! = [];
            for key in selection {
                found: usize? = document->documentWorldFile->IndexOf(key);
                guard index := found continue;
                entity: lantern:::world:::WorldEntity* = document->documentWorldFile->entities[index];
                templateFound: EntityTemplate*? = TemplateForKind(entity->kind);
                guard template := templateFound continue;
                edited := template->prototype->Copy();
                edited->id = entity->id;
                edited->SetName(entity->name);
                edited->SetKind(entity->kind);
                edited->parent = entity->parent;
                edited->transform = entity->transform;
                if edited->SameAs(entity) {
                    delete edited;
                } else {
                    edits.push(Edit:::Replace(edited!));
                }
            }
            if edits.length() == 0 {
                edits.freeAll();
                SetStatus("Nothing to revert".copy());
                return false;
            }
            count: string! = CountEntities(edits.length());
            label: string! = `Revert ${count} to template`;
            delete count;
            succeeded: bool = ExecuteEdits(label, edits!);
            delete label;
            return succeeded;
        }

        // The reverse: makes the primary entity the new prototype of the template for its kind (without its
        // id, parent or transform) and saves the palette file, so later placements look like it.
        ApplyPrimaryToTemplate~: () -> bool {
            primaryFound: u64? = PrimarySelection();
            guard key := primaryFound return false;
            entityFound: lantern:::world:::WorldEntity*!? = EntityCopy(key);
            guard entityFound return false;
            templateIndex~ usize? = null;
            for index~ usize = 0; index < palette->templates.length(); index++ {
                if templateIndex == null && palette->templates[index]->Kind() == entityFound->kind {
                    templateIndex = index;
                }
            }
            if templateIndex == null {
                refusal: string! = `no template has the kind '${entityFound->kind}'`;
                return RefuseAndDelete(entityFound!, refusal!);
            }
            index: usize = templateIndex ?? 0;
            template: EntityTemplate~* = palette->templates[index];
            prototype := entityFound->Copy();
            prototype->id = 0;
            prototype->SetName(template->label);
            prototype->parent = null;
            prototype->transform = lantern:::world:::TransformData { };
            replaced := template->prototype!;
            template->prototype = prototype!;
            delete replaced;
            label: string! = `${template->label}`;
            entityName: string! = `${entityFound->name}`;
            delete entityFound;
            paletteRevision += 1;
            if path := palettePath {
                if !Report(palette->Save(path)) {
                    delete label;
                    delete entityName;
                    return false;
                }
                SetStatus(`Applied ${entityName} to the ${label} template`);
            } else {
                SetStatus(`Applied ${entityName} to the ${label} template (palette not saved: no path)`);
            }
            delete label;
            delete entityName;
            return true;
        }

        // Frees an entity copy and reports a refusal. A shortcut for the early returns of the function above.
        RefuseAndDelete~: (entity: lantern:::world:::WorldEntity*!, message: string!) -> bool {
            delete entity;
            return Refuse(message!);
        }

        // Moves the camera to look at the selection, or at the whole level when nothing is selected.
        FrameSelection~: () -> void {
            if selection.length() == 0 {
                FrameAll();
                return;
            }
            RefreshGeometry();
            camera.Frame(geometry->BoundsOf(selection));
        }

        // Moves the camera to look at the whole level, a little closer than a full fit.
        FrameAll~: () -> void {
            RefreshGeometry();
            bounds: lantern:::core:::Aabb = geometry->LevelBounds();
            if !bounds.IsEmpty() {
                camera.Frame(bounds);
                camera.distance *= 0.8f;
            }
        }

        // Snaps the camera to a named view (see OrbitCamera.ApplyPreset).
        CameraPreset~: (name: string) -> bool {
            if !camera.ApplyPreset(name) {
                return Refuse(`unknown camera preset '${name}'`);
            }
            capitalised: string! = Capitalise(name);
            SetStatus(`${capitalised} view`);
            delete capitalised;
            return true;
        }

        // Switches between perspective and orthographic.
        SetOrthographic~: (orthographic: bool) -> void {
            if camera.orthographic != orthographic {
                camera.orthographic = orthographic;
                localRevision += 1;
            }
        }

        // Saves the camera in one of the nine bookmark slots (control and a digit key).
        SetBookmark~: (slot: usize) -> bool {
            if slot >= BOOKMARK_COUNT {
                return false;
            }
            bookmarkSet[slot] = true;
            bookmarkCameras[slot] = camera;
            SetStatus(`Saved camera bookmark ${slot + 1}`);
            return true;
        }

        // Restores the camera from a bookmark slot (the digit key).
        GoToBookmark~: (slot: usize) -> bool {
            if !HasBookmark(slot) {
                return Refuse(`camera bookmark ${slot + 1} is empty`);
            }
            camera = bookmarkCameras[slot];
            SetStatus(`Camera bookmark ${slot + 1}`);
            return true;
        }

        // Puts the camera at the primary entity, 1.6 m up (about eye height), looking along its forward
        // direction. It is how a spawn point is checked from the player's point of view.
        AlignCameraToSelection~: () -> bool {
            primaryFound: u64? = PrimarySelection();
            guard primary := primaryFound return false;
            RefreshGeometry();
            placedFound: EntityGeometry*? = geometry->Find(primary);
            guard placed := placedFound return false;
            forward: Vec3 = placed->worldMatrix.transformDirection(Vec3 { x: 0.0f, y: 0.0f, z: -1.0f });
            eye: Vec3 = placed->Origin() + Vec3 { x: 0.0f, y: 1.6f, z: 0.0f };
            camera.orthographic = false;
            camera.LookFrom(eye, forward);
            SetStatus("Camera aligned to the selection".copy());
            return true;
        }

        // Where play in editor starts the player: the selected entity's position when something is selected,
        // else where the camera is. A selected `player_start` also carries its label, so the game uses that start as authored. A camera in an orthographic view (top, front and so on) sits far from the
        // scene, so there it is the point the camera is centred on. The heading is the camera's.
        PlayStart~: () -> PlayStartPoint {
            start~ PlayStartPoint = PlayStartPoint { };
            start.yaw = camera.yaw;
            start.position = when camera.orthographic { true -> camera.target, false -> camera.Position() };
            primaryFound: u64? = PrimarySelection();
            if primary := primaryFound {
                RefreshGeometry();
                placedFound: EntityGeometry*? = geometry->Find(primary);
                if placed := placedFound {
                    start.position = placed->Origin();
                    start.isFromSelection = true;
                    entityIndex: usize? = document->documentWorldFile->IndexOf(primary);
                    if index := entityIndex {
                        selected: lantern:::world:::WorldEntity* = document->documentWorldFile->entities[index];
                        if selected->kind == "player_start" {
                            if labelIndex := selected->PropertyIndex("label") {
                                start.startLabel = selected->propertyTexts[labelIndex];
                            }
                        }
                    }
                }
            }
            return start;
        }

        // The reverse: moves the primary entity to the camera and turns it to face where the camera faces.
        AlignSelectionToCamera~: () -> bool {
            primaryFound: u64? = PrimarySelection();
            guard primary := primaryFound return false;
            only~ Array<u64>! = [];
            only.push(primary);
            originals~ Array<DragOriginal*!>! = DragOriginalsFor(only);
            delete only;
            if originals.length() == 0 {
                originals.freeAll();
                return false;
            }
            original: DragOriginal* = originals[0];
            edited := original->entity->Copy();
            edited->transform.position = original->LocalPosition(camera.Position());
            worldRotation: Quaternion = lantern:::core:::QuaternionFromRotationY(camera.yaw) * Quaternion:::fromAxisAngle(Vec3 { x: 1.0f, y: 0.0f, z: 0.0f }, -camera.pitch);
            edited->transform.rotationDegrees = EulerDegrees(original->ParentRotation().conjugate() * worldRotation);
            originals.freeAll();
            edits~ Array<Edit*!>! = [];
            edits.push(Edit:::Replace(edited!));
            return ExecuteEdits("Align to camera", edits!);
        }

        // Tells the session how big the viewport is in pixels. Picking and the gizmo size need it.
        SetViewportSize~: (size: Vec2) -> void {
            viewportSize = lantern:::core:::ComponentMax2(size, Vec2 { x: 1.0f, y: 1.0f });
        }

        // Where the gizmo goes: the primary entity's position, or the centre of the selection's box in
        // centre mode. Null with nothing selected.
        PivotPoint~: (mode: PivotMode) -> Vec3? {
            primaryFound: u64? = PrimarySelection();
            guard primary := primaryFound return null;
            RefreshGeometry();
            placedFound: EntityGeometry*? = geometry->Find(primary);
            guard placed := placedFound return null;
            if mode == PivotMode:::Center {
                bounds: lantern:::core:::Aabb = geometry->BoundsOf(selection);
                if !bounds.IsEmpty() {
                    return bounds.Center();
                }
            }
            return placed->Origin();
        }

        // The primary entity's rotation in the world.
        PrimaryOrientation~: () -> Quaternion {
            primaryFound: u64? = PrimarySelection();
            guard primary := primaryFound return Quaternion { };
            return lantern:::core:::DecomposeMatrix(WorldMatrixOf(primary)).rotation;
        }

        // The gizmo as it would be drawn now, or null with nothing selected.
        CurrentGizmoFrame~: () -> GizmoFrame? {
            pivotFound: Vec3? = PivotPoint(pivotMode);
            guard pivot := pivotFound return null;
            return GizmoFrame:::Create(tool, space, pivot, PrimaryOrientation(), Projection());
        }

        // The gizmo to draw. During a gizmo drag it keeps the axes it started with and follows the pivot, so
        // the handles do not spin while the entity rotates under them.
        VisibleGizmo~: () -> GizmoFrame? {
            if current := drag {
                if current->kind == DragKind:::Gizmo {
                    frame~ GizmoFrame = current->frame;
                    if pivot := PivotPoint(pivotMode) {
                        frame.pivot = pivot;
                    }
                    return frame;
                }
            }
            return CurrentGizmoFrame();
        }

        // Records the starting state (a copy, the parent's matrix and the world position) of each entity a
        // drag will move.
        DragOriginalsFor~: (keys: Array<u64>) -> Array<DragOriginal*!>! {
            RefreshGeometry();
            originals~ Array<DragOriginal*!>! = [];
            for key in keys {
                entityFound: lantern:::world:::WorldEntity*!? = EntityCopy(key);
                guard entityFound continue;
                parentWorld: Mat4 = WorldMatrixOf(entityFound->parent);
                originals.push(new DragOriginal(entityFound!, parentWorld, WorldOriginOf(key)));
            }
            return originals!;
        }

        // The same for the selected entities that are not locked.
        MovableDragOriginals~: () -> Array<DragOriginal*!>! {
            movable: Array<u64>! = MovableSelection();
            originals: Array<DragOriginal*!>! = DragOriginalsFor(movable);
            delete movable;
            return originals!;
        }

        // The mouse moved. With no drag it only updates what is under the pointer. Otherwise it feeds the
        // drag: camera orbit and pan move the camera; a pending press that moves more than the click slop
        // becomes a body drag (when it began on an entity and the tool is move) or a selection rectangle
        // (when it began on empty space); gizmo and body drags update their previews. The drag is taken out of
        // the session while it is updated and put back after.
        PointerMoved~: (position: Vec2) -> void {
            delta: Vec2 = position - pointer;
            pointer = position;
            if drag == null {
                UpdateHover();
                return;
            }
            activeFound~ Drag*!? = drag!;
            drag = null;
            guard activeFound return;
            if activeFound->kind == DragKind:::Orbit {
                camera.Orbit(delta);
            } else if activeFound->kind == DragKind:::Pan {
                camera.Pan(delta, viewportSize.y);
            } else if activeFound->kind == DragKind:::Pending {
                moved: Vec2 = position - activeFound->press;
                if Math:::sqrt(Dot2(moved, moved)) > CLICK_SLOP_PIXELS {
                    if hit := activeFound->hit {
                        if tool == GizmoTool:::Translate && !ContainsKeyIn(locked, hit) {
                            if !ContainsKeyIn(selection, hit) {
                                if activeFound->additive {
                                    selection.push(hit);
                                } else {
                                    delete selection;
                                    selection = [];
                                    selection.push(hit);
                                }
                                SelectionChanged();
                            }
                            if BeginBodyDrag(activeFound->press) {
                                delete activeFound;
                                return;
                            }
                        }
                    } else {
                        activeFound->kind = DragKind:::RubberBand;
                        localRevision += 1;
                    }
                }
            } else if activeFound->kind == DragKind:::Gizmo {
                UpdateGizmoDrag(activeFound);
            } else if activeFound->kind == DragKind:::Body {
                UpdateBodyDrag(activeFound);
            }
            drag = activeFound!;
        }

        // Works out what the pointer is over, in priority order: a view cube face, a gizmo handle, an entity.
        UpdateHover~: () -> void {
            hoveredViewCubeFace = ViewCubeHit(camera, viewportSize, pointer);
            if hoveredViewCubeFace != null {
                hoveredHandle = null;
                hoveredEntity = null;
                return;
            }
            projection: ViewportProjection = Projection();
            handleFound~ Handle? = null;
            if frame := CurrentGizmoFrame() {
                handleFound = frame.HitTest(tool, projection, pointer);
            }
            hoveredHandle = handleFound;
            if handleFound != null {
                hoveredEntity = null;
            } else {
                hoveredEntity = Pick(projection.RayThrough(pointer));
            }
        }

        // The entity under a ray, or null. Hidden and locked entities, and markers when markers are not
        // shown, cannot be picked.
        Pick~: (ray: Ray) -> u64? {
            nothingSkipped~ Array<u64>! = [];
            found: u64? = PickSkipping(ray, nothingSkipped);
            delete nothingSkipped;
            return found;
        }

        // The same, also ignoring some entities. Click cycling uses it to look through the one it picked last.
        PickSkipping~: (ray: Ray, skipped: Array<u64>) -> u64? {
            RefreshGeometry();
            excluded~ Array<u64>! = CopyKeys(hidden);
            for key in locked {
                excluded.push(key);
            }
            for key in skipped {
                excluded.push(key);
            }
            if !view.showMarkers {
                for entity in geometry->entities {
                    if entity->IsMarker() {
                        excluded.push(entity->key);
                    }
                }
            }
            hit: PickHit? = geometry->PickExcluding(ray, excluded);
            delete excluded;
            guard found := hit return null;
            return found.key;
        }

        // A mouse button went down or up. Remembers it, and then runs the press or release.
        SetPointerButton~: (button: PointerButton, down: bool, modifiers: Modifiers) -> void {
            if button == PointerButton:::Left {
                leftDown = down;
            } else if button == PointerButton:::Middle {
                middleDown = down;
            } else {
                rightDown = down;
            }
            if down {
                PointerPressed(button, modifiers);
            } else {
                PointerReleased(button, modifiers);
            }
        }

        // A button went down. The right button orbits (with shift, pans), the middle button pans, alt and
        // the left button orbits. Otherwise a left press is tried against the view cube (a click snaps
        // the camera), then the gizmo (a drag begins, recording where on the handle it started), and
        // last it begins a pending press that the next move or release turns into a body drag, a rectangle or
        // a click.
        PointerPressed~: (button: PointerButton, modifiers: Modifiers) -> void {
            if drag != null {
                return;
            }
            if button == PointerButton:::Right {
                if modifiers.shift {
                    drag = new Drag(DragKind:::Pan);
                } else {
                    drag = new Drag(DragKind:::Orbit);
                }
                return;
            }
            if button == PointerButton:::Middle {
                drag = new Drag(DragKind:::Pan);
                return;
            }
            if modifiers.alt {
                drag = new Drag(DragKind:::Orbit);
                return;
            }
            if face := ViewCubeHit(camera, viewportSize, pointer) {
                CameraPreset(ViewCubeFacePreset(face));
                return;
            }
            projection: ViewportProjection = Projection();
            if frame := CurrentGizmoFrame() {
                if handle := frame.HitTest(tool, projection, pointer) {
                    ray: Ray = projection.RayThrough(pointer);
                    start~ f32? = 0.0f;
                    if handle.kind == HandleKind:::Axis {
                        if tool == GizmoTool:::Rotate {
                            start = frame.RingAngle(handle.axis, ray);
                        } else {
                            start = frame.AxisParameter(handle.axis, ray);
                        }
                    }
                    startPoint: Vec3 = frame.PlanePoint(handle, ray) ?? frame.pivot;
                    if startValue := start {
                        originals~ Array<DragOriginal*!>! = MovableDragOriginals();
                        if originals.length() > 0 {
                            gizmoDrag := new Drag(DragKind:::Gizmo);
                            gizmoDrag->tool = tool;
                            gizmoDrag->handle = handle;
                            gizmoDrag->frame = frame;
                            gizmoDrag->start = startValue;
                            gizmoDrag->startPoint = startPoint;
                            gizmoDrag->TakeOriginals(originals!);
                            drag = gizmoDrag!;
                            return;
                        }
                        originals.freeAll();
                    }
                }
            }
            hit: u64? = Pick(projection.RayThrough(pointer));
            pending := new Drag(DragKind:::Pending);
            pending->press = pointer;
            pending->hit = hit;
            pending->additive = modifiers.shift || modifiers.command;
            drag = pending!;
        }

        // A button went up, which ends the drag. A pending press that did not move is a click: it selects
        // what is under it (clicking again cycles), shift or the command key adds to the selection, and
        // clicking empty space clears it. A gizmo or body drag is committed as one undo step called Move,
        // Rotate or Scale. A rectangle selects what it covers. Pan and orbit drags simply end, except that
        // releasing a button that did not start the drag leaves the drag running.
        PointerReleased~: (button: PointerButton, modifiers: Modifiers) -> void {
            if drag == null {
                return;
            }
            activeFound~ Drag*!? = drag!;
            drag = null;
            guard activeFound return;
            kind: DragKind = activeFound->kind;
            keep~ bool = false;
            if button == PointerButton:::Left {
                if kind == DragKind:::Pending {
                    if key := activeFound->hit {
                        if activeFound->additive {
                            ResetClickCycle();
                            ToggleSelected(key);
                        } else {
                            SelectByClick(activeFound->press, key);
                        }
                    } else {
                        ResetClickCycle();
                        if !activeFound->additive {
                            ClearSelection();
                        }
                    }
                } else if kind == DragKind:::Gizmo || kind == DragKind:::Body {
                    verb~ string = "Move";
                    if kind == DragKind:::Gizmo && activeFound->tool == GizmoTool:::Rotate {
                        verb = "Rotate";
                    } else if kind == DragKind:::Gizmo && activeFound->tool == GizmoTool:::Scale {
                        verb = "Scale";
                    }
                    count: string! = CountEntities(activeFound->originals.length());
                    label: string! = `${verb} ${count}`;
                    document->CommitPreview(label);
                    delete label;
                    delete count;
                } else if kind == DragKind:::RubberBand {
                    FinishRubberBand(activeFound->press, activeFound->additive || modifiers.shift);
                } else if kind == DragKind:::Pan {
                    keep = true;
                }
            } else if kind != DragKind:::Orbit && kind != DragKind:::Pan {
                keep = true;
            }
            if kind != DragKind:::Pending && kind != DragKind:::Orbit && kind != DragKind:::Pan {
                ResetClickCycle();
            }
            if keep {
                drag = activeFound!;
            } else {
                delete activeFound;
            }
            UpdateHover();
        }

        // Forgets the click cycle (see SelectByClick).
        ResetClickCycle~: () -> void {
            delete clickCycle;
            clickCycle = [];
            clickCyclePixel = null;
        }

        // True when a click is a repeat of the last one: the same spot (within the click slop), the same camera
        // view, and the selection is still the one entity the last click picked.
        ContinuesClickCycle :: (press: Vec2) -> bool {
            guard previous := clickCyclePixel return false;
            moved: Vec2 = press - previous;
            if Math:::sqrt(Dot2(moved, moved)) > CLICK_SLOP_PIXELS {
                return false;
            }
            if clickCycle.length() == 0 || selection.length() != 1 {
                return false;
            }
            if !SameCameraView(clickCycleCamera, camera) {
                return false;
            }
            return selection[0] == clickCycle[clickCycle.length() - 1];
        }

        // How many entities lie along the ray, found by picking again and again with the earlier ones skipped.
        // The count is capped at MAX_CLICK_CYCLE_LENGTH.
        CountUnderCursor~: (ray: Ray) -> usize {
            counted~ Array<u64>! = [];
            while counted.length() < MAX_CLICK_CYCLE_LENGTH {
                next: u64? = PickSkipping(ray, counted);
                guard key := next break;
                counted.push(key);
            }
            count: usize = counted.length();
            delete counted;
            return count;
        }

        // Selects what a click hit. Clicking the same spot again picks the next entity behind the last one, so
        // entities hidden behind others can be reached; when there is nothing further back the cycle starts
        // again at the front. The status line says "2 of 3 under the cursor" when there is more than one.
        SelectByClick~: (press: Vec2, frontKey: u64) -> void {
            ray: Ray = Projection().RayThrough(press);
            chosen~ u64 = frontKey;
            if ContinuesClickCycle(press) {
                visited~ Array<u64>! = CopyKeys(clickCycle);
                next: u64? = PickSkipping(ray, visited);
                delete visited;
                if nextKey := next {
                    chosen = nextKey;
                } else {
                    delete clickCycle;
                    clickCycle = [];
                }
            } else {
                delete clickCycle;
                clickCycle = [];
                clickCyclePixel = press;
                clickCycleCamera = camera;
            }
            clickCycle.push(chosen);
            SelectOnly(chosen);
            stackCount: usize = CountUnderCursor(ray);
            if stackCount > 1 {
                if position := document->documentWorldFile->IndexOf(chosen) {
                    SetStatus(`Selected ${document->documentWorldFile->entities[position]->name} (${clickCycle.length()} of ${stackCount} under the cursor)`);
                }
            }
        }

        // Selects the entities whose origin falls inside the dragged rectangle (not hidden or locked ones).
        // With shift or the command key it adds to the selection instead of replacing it.
        FinishRubberBand~: (press: Vec2, additive: bool) -> void {
            projection: ViewportProjection = Projection();
            RefreshGeometry();
            picked~ Array<u64>! = [];
            for entity in geometry->entities {
                if ContainsKeyIn(hidden, entity->key) || ContainsKeyIn(locked, entity->key) {
                    continue;
                }
                if !view.showMarkers && entity->IsMarker() {
                    continue;
                }
                if pixel := projection.Project(entity->Origin()) {
                    if ViewportProjection:::PixelInRect(pixel, press, pointer) {
                        picked.push(entity->key);
                    }
                }
            }
            if additive {
                for key in picked {
                    if !ContainsKeyIn(selection, key) {
                        selection.push(key);
                    }
                }
                delete picked;
            } else {
                delete selection;
                selection = picked!;
            }
            SelectionChanged();
            if selection.length() > 0 {
                count: string! = CountEntities(selection.length());
                SetStatus(`Selected ${count}`);
                delete count;
            }
        }

        // Escape during a drag: abandons it, and puts the entities back where they were if it was moving
        // them. False when no drag was in progress.
        CancelDrag~: () -> bool {
            if drag == null {
                return false;
            }
            activeFound~ Drag*!? = drag!;
            drag = null;
            guard activeFound return false;
            previewing: bool = activeFound->kind == DragKind:::Gizmo || activeFound->kind == DragKind:::Body;
            delete activeFound;
            if previewing {
                document->CancelPreview();
            } else {
                localRevision += 1;
            }
            return true;
        }

        // The scroll wheel zooms the camera.
        Wheel~: (notches: f32) -> void {
            camera.Dolly(notches);
        }

        // Forgets every held key. The app calls it when the window loses focus so a key does not stay stuck.
        ReleaseKeys~: () -> void {
            delete keysHeld;
            keysHeld = [];
        }

        // Where a letter is in the list of held keys, or null.
        HeldPosition :: (letter: u8) -> usize? {
            for index~ usize = 0; index < keysHeld.length(); index++ {
                if keysHeld[index] == letter {
                    return index;
                }
            }
            return null;
        }

        // 1 when the letter is held, else 0, so the movement keys can be added and subtracted.
        Held :: (letter: string) -> f32 {
            if HeldPosition(letter.byteAt(0)) != null {
                return 1.0f;
            }
            return 0.0f;
        }

        // A key went down or up. It keeps track of held letters (for flying) and, on a press, handles the
        // named keys: Escape cancels a drag or clears the selection, Delete deletes, End drops to the ground,
        // Home frames everything, a digit goes to a camera bookmark (with the command key it saves one).
        // Letters are passed on to LetterKey. Returns true when the key did something, so the app can stop
        // the platform acting on it too.
        Key~: (key: EditorKey, down: bool, modifiers: Modifiers) -> bool {
            if key.kind == EditorKeyKind:::Letter {
                position: usize? = HeldPosition(key.letter);
                if down && position == null {
                    keysHeld.push(key.letter);
                }
                if !down {
                    if index := position {
                        keysHeld.swapRemove(index);
                    }
                }
            }
            if !down {
                return false;
            }
            if key.kind == EditorKeyKind:::Escape {
                if CancelDrag() {
                    return true;
                }
                ClearSelection();
                return true;
            }
            if key.kind == EditorKeyKind:::Delete {
                return DeleteSelection();
            }
            if key.kind == EditorKeyKind:::End {
                return SnapSelectionToGround();
            }
            if key.kind == EditorKeyKind:::Home {
                FrameAll();
                return true;
            }
            if key.kind == EditorKeyKind:::Digit {
                if key.digit == u8(0) || modifiers.alt {
                    return false;
                }
                slot: usize = usize(key.digit) - 1;
                if modifiers.command {
                    return SetBookmark(slot);
                }
                return GoToBookmark(slot);
            }
            return LetterKey(key, modifiers);
        }

        // The letter shortcuts. With the command key: undo (Z), redo (shift Z or Y), duplicate (D), save (S),
        // group (G) and select all (A). Without it: W, E and R choose move, rotate and scale; F frames the
        // selection; X switches world and local axes; Z switches the pivot; G shows or hides the grid; H hides
        // the selection and shift H shows everything. These are ignored while the right button is held,
        // because then W, A, S, D, Q and E fly the camera.
        LetterKey~: (key: EditorKey, modifiers: Modifiers) -> bool {
            if modifiers.command {
                if key.IsLetter("z") && modifiers.shift {
                    return Redo();
                }
                if key.IsLetter("z") {
                    return Undo();
                }
                if key.IsLetter("y") {
                    return Redo();
                }
                if key.IsLetter("d") {
                    return DuplicateSelection();
                }
                if key.IsLetter("s") {
                    return Save();
                }
                if key.IsLetter("g") {
                    return GroupSelection();
                }
                if key.IsLetter("a") {
                    SelectAll();
                    return true;
                }
            }
            if key.IsLetter("h") && modifiers.shift {
                UnhideAll();
                return true;
            }
            if rightDown {
                return true;
            }
            if key.IsLetter("w") {
                SetTool(GizmoTool:::Translate);
                return true;
            }
            if key.IsLetter("e") {
                SetTool(GizmoTool:::Rotate);
                return true;
            }
            if key.IsLetter("r") {
                SetTool(GizmoTool:::Scale);
                return true;
            }
            if key.IsLetter("f") {
                FrameSelection();
                return true;
            }
            if key.IsLetter("x") {
                SetSpace(ToggledSpace(space));
                return true;
            }
            if key.IsLetter("z") {
                SetPivotMode(ToggledPivot(pivotMode));
                return true;
            }
            if key.IsLetter("g") {
                view.showGrid = !view.showGrid;
                localRevision += 1;
                return true;
            }
            if key.IsLetter("h") {
                if selection.length() == 0 {
                    return false;
                }
                HideSelection();
                ClearSelection();
                return true;
            }
            return false;
        }

        // Called every frame. While the right button is held, W A S D move the camera and Q and E move it down
        // and up.
        Update~: (seconds: f32) -> void {
            if !rightDown {
                return;
            }
            direction: Vec3 = Vec3 { x: Held("d") - Held("a"), y: Held("e") - Held("q"), z: Held("w") - Held("s") };
            if direction.x != 0.0f || direction.y != 0.0f || direction.z != 0.0f {
                camera.Fly(direction, seconds);
            }
        }

        // Starts dragging the selected entities by grabbing their body (not a handle). The drag slides over
        // the horizontal plane through the pivot, starting from where the press hit it. False when nothing
        // can be moved.
        BeginBodyDrag~: (press: Vec2) -> bool {
            if PrimarySelection() == null {
                return false;
            }
            pivotFound: Vec3? = PivotPoint(pivotMode);
            guard pivot := pivotFound return false;
            ray: Ray = Projection().RayThrough(press);
            startFound: Vec3? = ray.IntersectPlane(pivot, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f });
            guard startPoint := startFound return false;
            originals~ Array<DragOriginal*!>! = MovableDragOriginals();
            if originals.length() == 0 {
                originals.freeAll();
                return false;
            }
            bodyDrag := new Drag(DragKind:::Body);
            bodyDrag->startPoint = startPoint;
            bodyDrag->TakeOriginals(originals!);
            UpdateBodyDrag(bodyDrag);
            drag = bodyDrag!;
            return true;
        }

        // Moves the previewed entities to follow the mouse on the horizontal plane. With snapping, the
        // primary entity lands on a snap step on x and z, and the rest keep their offsets from it.
        UpdateBodyDrag~: (active: Drag*) -> void {
            count: usize = active->originals.length();
            if count == 0 {
                return;
            }
            primary: DragOriginal* = active->originals[count - 1];
            ray: Ray = Projection().RayThrough(pointer);
            pointFound: Vec3? = ray.IntersectPlane(active->startPoint, Vec3 { x: 0.0f, y: 1.0f, z: 0.0f });
            guard point := pointFound return;
            delta~ Vec3 = point - active->startPoint;
            delta.y = 0.0f;
            if snap.enabled {
                step: f32 = snap.translateStep;
                target: Vec3 = primary->worldPosition + delta;
                delta.x = Snap(target.x, step) - primary->worldPosition.x;
                delta.z = Snap(target.z, step) - primary->worldPosition.z;
            }
            PreviewWorldTranslation(active, delta);
        }

        // Shows every dragged entity moved by a world offset. Nothing is added to the undo history until the
        // mouse is released.
        PreviewWorldTranslation~: (active: Drag*, worldDelta: Vec3) -> void {
            for original in active->originals {
                entity := original->entity->Copy();
                entity->transform.position = original->LocalPosition(original->worldPosition + worldDelta);
                document->PreviewReplace(entity!);
            }
            if active->originals.length() > 0 {
                SnapPrimaryToSockets(active->originals[active->originals.length() - 1]);
            }
        }

        // When the primary dragged entity is a scene instance with no parent and socket snapping is on, moves it (and turns it)
        // so its nearest socket lies on a socket within reach, facing the other way. Shown as part of the same preview, so
        // releasing the mouse commits one undo step.
        SnapPrimaryToSockets~: (primary: DragOriginal*) -> void {
            if !snap.sockets || primary->entity->kind != lantern:::world:::SCENE_INSTANCE_KIND || primary->entity->parent != null {
                return;
            }
            worldFile: lantern:::world:::WorldFile* = document->documentWorldFile;
            found~ usize? = null;
            for index~ usize = 0; index < worldFile->entities.length(); index++ {
                if worldFile->entities[index]->id == primary->entity->id {
                    found = index;
                }
            }
            guard instanceIndex := found return;
            current: lantern:::world:::WorldEntity* = worldFile->entities[instanceIndex];
            directory~ string! = "".copy();
            if own := document->path {
                delete directory;
                directory = lantern:::world:::DirectoryOf(own);
            }
            defer delete directory;
            result: lantern:::world:::SceneSnap = SnapSceneInstance(worldFile, directory, instanceIndex, current->transform.position, current->transform.rotationDegrees.y);
            if !result.found {
                return;
            }
            entity := current->Copy();
            entity->transform.position = result.placement.position;
            entity->transform.rotationDegrees = result.placement.rotationDegrees;
            document->PreviewReplace(entity!);
        }

        // Snaps the movement along one direction so the primary entity ends on a step of the grid.
        SnappedAlong :: (primary: DragOriginal*, delta: Vec3, direction: Vec3) -> Vec3 {
            component: f32 = primary->worldPosition.dot(direction);
            along: f32 = delta.dot(direction);
            return direction * (Snap(component + along, snap.translateStep) - component);
        }

        // The snapped version of a move, by handle: the centre handle snaps each axis, a plane handle snaps
        // along its two axes, and an axis handle along its one. Unchanged when snapping is off.
        SnappedTranslation :: (primary: DragOriginal*, delta: Vec3, frame: GizmoFrame, handle: Handle) -> Vec3 {
            if !snap.enabled {
                return delta;
            }
            step: f32 = snap.translateStep;
            if handle.kind == HandleKind:::Uniform {
                target: Vec3 = primary->worldPosition + delta;
                return Vec3 { x: Snap(target.x, step), y: Snap(target.y, step), z: Snap(target.z, step) } - primary->worldPosition;
            }
            if handle.kind == HandleKind:::Plane {
                first: Vec3 = SnappedAlong(primary, delta, frame.AxisVector(FirstOtherAxis(handle.axis)));
                second: Vec3 = SnappedAlong(primary, delta, frame.AxisVector(SecondOtherAxis(handle.axis)));
                return Vec3 { } + first + second;
            }
            return SnappedAlong(primary, delta, frame.AxisVector(handle.axis));
        }

        // Updates a gizmo drag from the current mouse ray. Move: along an axis by how far the closest point
        // on the axis has moved, in a plane or freely by how far the ray's point on the drag plane has moved.
        // Rotate: by the change of angle round the ring, snapped to the rotate step, turning each entity about
        // the pivot and turning its own rotation by the same amount (corrected for its parent's rotation).
        // Scale: along an axis by the ratio of the closest point on the axis to where the drag began, in a plane
        // or uniformly by the ratio of the distances from the pivot.
        UpdateGizmoDrag~: (active: Drag*) -> void {
            ray: Ray = Projection().RayThrough(pointer);
            count: usize = active->originals.length();
            if count == 0 {
                return;
            }
            primary: DragOriginal* = active->originals[count - 1];
            frame: GizmoFrame = active->frame;
            handle: Handle = active->handle;
            start: f32 = active->start;
            if active->tool == GizmoTool:::Translate {
                if handle.kind == HandleKind:::Axis {
                    parameterFound: f32? = frame.AxisParameter(handle.axis, ray);
                    guard parameter := parameterFound return;
                    delta: Vec3 = frame.AxisVector(handle.axis) * (parameter - start);
                    PreviewWorldTranslation(active, SnappedTranslation(primary, delta, frame, handle));
                    return;
                }
                pointFound: Vec3? = frame.PlanePoint(handle, ray);
                guard point := pointFound return;
                PreviewWorldTranslation(active, SnappedTranslation(primary, point - active->startPoint, frame, handle));
                return;
            }
            if active->tool == GizmoTool:::Rotate {
                if handle.kind != HandleKind:::Axis {
                    return;
                }
                angleFound: f32? = frame.RingAngle(handle.axis, ray);
                guard angle := angleFound return;
                turn~ f32 = lantern:::core:::WrapAngle(angle - start);
                if snap.enabled {
                    turn = Snap(turn * 57.29578f, snap.rotateStepDegrees) * 0.017453292f;
                }
                worldTurn: Quaternion = Quaternion:::fromAxisAngle(frame.AxisVector(handle.axis), turn);
                for original in active->originals {
                    entity := original->entity->Copy();
                    parentRotation: Quaternion = original->ParentRotation();
                    localTurn: Quaternion = parentRotation.conjugate() * worldTurn * parentRotation;
                    entity->transform.rotationDegrees = EulerDegrees(localTurn * original->entity->transform.Rotation());
                    newWorld: Vec3 = frame.pivot + worldTurn.rotate(original->worldPosition - frame.pivot);
                    entity->transform.position = original->LocalPosition(newWorld);
                    document->PreviewReplace(entity!);
                }
                return;
            }
            if handle.kind == HandleKind:::Axis {
                parameterFound: f32? = frame.AxisParameter(handle.axis, ray);
                guard parameter := parameterFound return;
                if Math:::abs(start) < 0.0001f {
                    return;
                }
                PreviewScale(active, WithAxis(Vec3 { x: 1.0f, y: 1.0f, z: 1.0f }, handle.axis, parameter / start));
                return;
            }
            pointFound: Vec3? = frame.PlanePoint(handle, ray);
            guard point := pointFound return;
            ratio: f32 = ScaleRatio(frame.pivot, active->startPoint, point);
            if handle.kind == HandleKind:::Plane {
                factors~ Vec3 = Vec3 { x: 1.0f, y: 1.0f, z: 1.0f };
                factors = WithAxis(factors, FirstOtherAxis(handle.axis), ratio);
                factors = WithAxis(factors, SecondOtherAxis(handle.axis), ratio);
                PreviewScale(active, factors);
                return;
            }
            PreviewScale(active, Vec3 { x: ratio, y: ratio, z: ratio });
        }

        // Snaps a scale to the scale step and keeps its size at least 0.01, with its sign, so a drag can never
        // scale an entity to nothing (a scale of zero cannot be edited back).
        TidyScale :: (value: f32) -> f32 {
            tidied~ f32 = value;
            if snap.enabled {
                tidied = Snap(tidied, snap.scaleStep);
            }
            if Math:::abs(tidied) < 0.01f {
                negative: bool = tidied < 0.0f || (tidied == 0.0f && 1.0f / tidied < 0.0f);
                tidied = when negative { true -> -0.01f, false -> 0.01f };
            }
            return tidied;
        }

        // Shows every dragged entity with its starting scale multiplied by the factors.
        PreviewScale~: (active: Drag*, factors: Vec3) -> void {
            for original in active->originals {
                entity := original->entity->Copy();
                scale: Vec3 = original->entity->transform.scale;
                entity->transform.scale = Vec3 { x: TidyScale(scale.x * factors.x), y: TidyScale(scale.y * factors.y), z: TidyScale(scale.z * factors.z) };
                document->PreviewReplace(entity!);
            }
        }
    }
}
