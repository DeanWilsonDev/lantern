lantern:::editor :: namespace {
    ORBIT_RADIANS_PER_PIXEL: f32 : 0.006f;
    DOLLY_FRACTION_PER_NOTCH: f32 : 0.12f;
    MIN_CAMERA_DISTANCE: f32 : 0.5f;
    MAX_CAMERA_DISTANCE: f32 : 250.0f;
    MAX_CAMERA_PITCH: f32 : 1.54f;

    Ray :: struct {
        origin~ Vec3 = Vec3 { };
        direction~ Vec3 = Vec3 { x: 0.0f, y: 0.0f, z: -1.0f };

        At :: (distance: f32) -> Vec3 {
            return origin + direction * distance;
        }

        IntersectPlane :: (point: Vec3, normal: Vec3) -> Vec3? {
            denominator: f32 = direction.dot(normal);
            if Math:::abs(denominator) < 0.000001f {
                return null;
            }
            distance: f32 = (point - origin).dot(normal) / denominator;
            if distance < 0.0f {
                return null;
            }
            return At(distance);
        }
    }

    OrbitCamera :: struct {
        target~ Vec3 = Vec3 { x: 0.0f, y: 0.0f, z: -8.0f };
        yaw~ f32 = 0.35f;
        pitch~ f32 = 0.55f;
        distance~ f32 = 30.0f;
        verticalFieldOfViewRadians~ f32 = 60.0f * (Math:::PI / 180.0f);
        flySpeed~ f32 = 10.0f;
        orthographic~ bool = false;

        Forward :: () -> Vec3 {
            cosinePitch: f32 = Math:::cos(pitch);
            return Vec3 { x: -Math:::sin(yaw) * cosinePitch, y: -Math:::sin(pitch), z: -Math:::cos(yaw) * cosinePitch };
        }

        Position :: () -> Vec3 {
            return target - Forward() * distance;
        }

        Right :: () -> Vec3 {
            return lantern:::core:::NormalizeOr3(Forward().cross(lantern:::core:::WorldUp()), Vec3 { x: 1.0f, y: 0.0f, z: 0.0f });
        }

        Up :: () -> Vec3 {
            return Right().cross(Forward());
        }

        RenderCamera :: () -> lantern:::renderer:::Camera {
            camera~ lantern:::renderer:::Camera = lantern:::renderer:::Camera:::LookAt(Position(), target);
            camera.verticalFieldOfViewRadians = verticalFieldOfViewRadians;
            camera.nearPlane = Math:::clamp(distance * 0.002f, 0.02f, 0.2f);
            camera.farPlane = 600.0f;
            if orthographic {
                camera.orthographicHalfHeight = OrthographicHalfHeight();
            }
            return camera;
        }

        OrthographicHalfHeight :: () -> f32 {
            return distance * Math:::tan(verticalFieldOfViewRadians * 0.5f);
        }

        ApplyPreset~: (name: string) -> bool {
            presetYaw~ f32 = 0.0f;
            presetPitch~ f32 = 0.0f;
            presetOrthographic~ bool = true;
            if name == "perspective" {
                presetYaw = 0.35f;
                presetPitch = 0.55f;
                presetOrthographic = false;
            } else if name == "front" {
                presetYaw = 0.0f;
            } else if name == "back" {
                presetYaw = Math:::PI;
            } else if name == "left" {
                presetYaw = -Math:::PI * 0.5f;
            } else if name == "right" {
                presetYaw = Math:::PI * 0.5f;
            } else if name == "top" {
                presetPitch = MAX_CAMERA_PITCH;
            } else if name == "bottom" {
                presetPitch = -MAX_CAMERA_PITCH;
            } else {
                return false;
            }
            yaw = presetYaw;
            pitch = presetPitch;
            orthographic = presetOrthographic;
            return true;
        }

        LookFrom~: (position: Vec3, forward: Vec3) -> void {
            direction: Vec3 = lantern:::core:::NormalizeOr3(forward, lantern:::core:::WorldForward());
            yaw = Math:::atan2(-direction.x, -direction.z);
            pitch = Math:::clamp(Math:::asin(Math:::clamp(-direction.y, -1.0f, 1.0f)), -MAX_CAMERA_PITCH, MAX_CAMERA_PITCH);
            target = position + Forward() * distance;
        }

        Orbit~: (mouseDelta: Vec2) -> void {
            yaw -= mouseDelta.x * ORBIT_RADIANS_PER_PIXEL;
            pitch = Math:::clamp(pitch + mouseDelta.y * ORBIT_RADIANS_PER_PIXEL, -MAX_CAMERA_PITCH, MAX_CAMERA_PITCH);
        }

        Pan~: (mouseDelta: Vec2, viewportHeight: f32) -> void {
            metresPerPixel: f32 = 2.0f * distance * Math:::tan(verticalFieldOfViewRadians * 0.5f) / Math:::max(viewportHeight, 1.0f);
            target = target + (Right() * -mouseDelta.x + Up() * mouseDelta.y) * metresPerPixel;
        }

        Dolly~: (notches: f32) -> void {
            factor: f32 = Math:::pow(1.0f - DOLLY_FRACTION_PER_NOTCH, notches);
            distance = Math:::clamp(distance * factor, MIN_CAMERA_DISTANCE, MAX_CAMERA_DISTANCE);
        }

        Fly~: (localDirection: Vec3, seconds: f32) -> void {
            direction: Vec3 = Right() * localDirection.x + lantern:::core:::WorldUp() * localDirection.y + Forward() * localDirection.z;
            target = target + lantern:::core:::NormalizeOr3(direction, Vec3 { }) * flySpeed * seconds;
        }

        Frame~: (bounds: lantern:::core:::Aabb) -> void {
            if bounds.IsEmpty() {
                return;
            }
            radius: f32 = Math:::max(bounds.HalfExtents().length(), 0.5f);
            target = bounds.Center();
            distance = Math:::clamp(radius / Math:::sin(verticalFieldOfViewRadians * 0.5f) * 1.1f, MIN_CAMERA_DISTANCE, MAX_CAMERA_DISTANCE);
        }
    }

    SameCameraView :: (first: OrbitCamera, second: OrbitCamera) -> bool {
        return first.target.x == second.target.x && first.target.y == second.target.y && first.target.z == second.target.z
            && first.yaw == second.yaw && first.pitch == second.pitch && first.distance == second.distance
            && first.verticalFieldOfViewRadians == second.verticalFieldOfViewRadians && first.orthographic == second.orthographic;
    }

    ViewportProjection :: struct {
        camera~ lantern:::renderer:::Camera = lantern:::renderer:::Camera { };
        size~ Vec2 = Vec2 { x: 1.0f, y: 1.0f };

        static Create :: (viewCamera: lantern:::renderer:::Camera, viewportSize: Vec2) -> ViewportProjection {
            return ViewportProjection { camera: viewCamera, size: lantern:::core:::ComponentMax2(viewportSize, Vec2 { x: 1.0f, y: 1.0f }) };
        }

        ViewProjectionMatrix :: () -> Mat4 {
            return camera.ViewProjection(size.x / size.y);
        }

        RayThrough :: (pixel: Vec2) -> Ray {
            ndcX: f32 = pixel.x / size.x * 2.0f - 1.0f;
            ndcY: f32 = 1.0f - pixel.y / size.y * 2.0f;
            inverseFound: Mat4? = ViewProjectionMatrix().inverse();
            guard inverse := inverseFound return Ray { origin: camera.position, direction: camera.forward };
            near: Vec3 = inverse.transformPoint(Vec3 { x: ndcX, y: ndcY, z: 0.0f });
            far: Vec3 = inverse.transformPoint(Vec3 { x: ndcX, y: ndcY, z: 1.0f });
            return Ray { origin: near, direction: lantern:::core:::NormalizeOr3(far - near, camera.forward) };
        }

        Project :: (point: Vec3) -> Vec2? {
            clip: Vec4 = ViewProjectionMatrix().transform(Vec4 { x: point.x, y: point.y, z: point.z, w: 1.0f });
            if clip.w <= 0.00001f {
                return null;
            }
            ndcX: f32 = clip.x / clip.w;
            ndcY: f32 = clip.y / clip.w;
            return Vec2 { x: (ndcX + 1.0f) * 0.5f * size.x, y: (1.0f - ndcY) * 0.5f * size.y };
        }

        WorldPerPixel :: (point: Vec3) -> f32 {
            if halfHeight := camera.orthographicHalfHeight {
                return 2.0f * halfHeight / size.y;
            }
            depth: f32 = Math:::max((point - camera.position).dot(camera.forward), camera.nearPlane);
            return 2.0f * depth * Math:::tan(camera.verticalFieldOfViewRadians * 0.5f) / size.y;
        }

        static PixelInRect :: (pixel: Vec2, firstCorner: Vec2, secondCorner: Vec2) -> bool {
            minimumX: f32 = Math:::min(firstCorner.x, secondCorner.x);
            maximumX: f32 = Math:::max(firstCorner.x, secondCorner.x);
            minimumY: f32 = Math:::min(firstCorner.y, secondCorner.y);
            maximumY: f32 = Math:::max(firstCorner.y, secondCorner.y);
            return pixel.x >= minimumX && pixel.x <= maximumX && pixel.y >= minimumY && pixel.y <= maximumY;
        }
    }
}
