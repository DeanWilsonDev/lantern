lantern:::editor :: namespace {
    GameColor :: (hex: string) -> lantern:::core:::Color {
        prefixed: string! = `#${hex}`;
        defer delete prefixed;
        return lantern:::world:::ParseHexColor(prefixed) ?? lantern:::core:::Color:::White();
    }

    /**
     * Gives the viewport the look the platformer has at night in its first chapter: the same sky, fog, moon, ambient
     * light, bloom, exposure and colour grade as `games/platformer/settings/chapter-looks.nyx`, so a level is lit
     * while it is built as it will be when played. Lights in the level still light it, since they are added after this.
     */
    ApplyGameLook :: (renderWorld: lantern:::renderer:::RenderWorld~*) -> void {
        horizon: lantern:::core:::Color = GameColor("141C34");
        renderWorld->clearColor = horizon;
        renderWorld->sky.zenith = GameColor("070B1A");
        renderWorld->sky.horizon = horizon;
        renderWorld->sky.ground = GameColor("05070E");
        renderWorld->sky.sunDiscRadiusRadians = 2.2f * 0.017453292f;
        renderWorld->sky.sunDiscStrength = 4.0f;
        renderWorld->atmosphere.fogColor = horizon;
        renderWorld->atmosphere.fogSunScattering = 0.5f;
        renderWorld->fogStart = 30.0f;
        renderWorld->fogEnd = 120.0f;
        moon~ lantern:::renderer:::DirectionalLight = renderWorld->light;
        moon.direction = lantern:::core:::NormalizeOr3(Vec3 { x: 0.35f, y: -0.55f, z: 0.75f }, Vec3 { x: 0.0f, y: -1.0f, z: 0.0f });
        moon.color = GameColor("8CA4D8");
        moon.ambient = GameColor("34456E");
        moon.groundAmbient = GameColor("161B2C");
        renderWorld->light = moon;
        renderWorld->post.bloomStrength = 0.35f;
        renderWorld->post.bloomThreshold = 1.0f;
        renderWorld->post.exposure = 1.1f;
        renderWorld->post.grade = lantern:::renderer:::ColorGrade {
            saturation: 0.95f,
            contrast: 1.05f,
            tint: GameColor("F2F6FF"),
            vignette: 0.25f
        };
    }
}
