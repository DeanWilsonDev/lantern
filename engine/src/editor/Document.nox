lantern:::editor :: namespace {
    // Every change to the level is made of edits of three kinds: replace an entity with a new version of
    // it, insert an entity at a position, or remove an entity by key. Undo and redo are just lists of
    // these, and applying an edit gives back the edit that reverses it.
    EditKind :: enum {
        Replace,
        Insert,
        Remove
    }

    // One change to the level: its kind, the position (for an insert), the entity's key, and the entity
    // itself (for a replace or an insert; a remove needs only the key). The edit owns its entity.
    Edit :: class {
    public:
        kind~ EditKind = EditKind:::Remove;
        index~ usize = 0;
        key~ u64 = 0;
        entity~ lantern:::world:::WorldEntity*!? = null;

        Edit~: (editKind: EditKind, editIndex: usize, editKey: u64, editEntity: lantern:::world:::WorldEntity*!?) {
            kind = editKind;
            index = editIndex;
            key = editKey;
            entity = editEntity!;
        }

        !Edit~: () {
            delete entity;
        }

        // Builds a replace edit. The key is taken from the entity.
        static Replace :: (replacement: lantern:::world:::WorldEntity*!) -> Edit*! {
            entityKey: u64 = replacement->id;
            return new Edit(EditKind:::Replace, 0, entityKey, replacement!);
        }

        // Builds an insert edit that puts the entity at `position`.
        static Insert :: (position: usize, inserted: lantern:::world:::WorldEntity*!) -> Edit*! {
            entityKey: u64 = inserted->id;
            return new Edit(EditKind:::Insert, position, entityKey, inserted!);
        }

        // Builds a remove edit for the entity with this key.
        static Remove :: (removedKey: u64) -> Edit*! {
            return new Edit(EditKind:::Remove, 0, removedKey, null);
        }

        // A deep copy of the edit, so one list of edits can be kept for undo and another for redo.
        Copy :: () -> Edit*! {
            copiedEntity~ lantern:::world:::WorldEntity*!? = null;
            if held := entity {
                copiedEntity = held->Copy();
            }
            return new Edit(kind, index, key, copiedEntity!);
        }
    }

    // Applies one edit to the level and returns the edit that undoes it: replacing returns the old
    // entity as a replace, inserting returns a remove, removing returns an insert at the same position.
    // Errors name the problem (no such entity, a duplicate key).
    ApplyEdit :: (edit: Edit~*, worldFile: lantern:::world:::WorldFile~*) -> Result<Edit*!, string!> {
        when edit->kind {
            EditKind:::Replace -> {
                guard position := worldFile->IndexOf(edit->key) return Result<Edit*!, string!>:::Err(`no entity ${edit->key}`);
                guard replacement ~= edit->entity return Result<Edit*!, string!>:::Err(OwnedEditorText("a replace edit has no entity"));
                previous := worldFile->entities.remove(position);
                worldFile->entities.insert(position, replacement->Copy());
                return Result<Edit*!, string!>:::Ok(Edit:::Replace(previous!));
            },
            EditKind:::Insert -> {
                if worldFile->IndexOf(edit->key) != null {
                    return Result<Edit*!, string!>:::Err(`entity ${edit->key} already exists`);
                }
                guard inserted ~= edit->entity return Result<Edit*!, string!>:::Err(OwnedEditorText("an insert edit has no entity"));
                worldFile->entities.insert(ClampIndex(edit->index, worldFile->entities.length()), inserted->Copy());
                return Result<Edit*!, string!>:::Ok(Edit:::Remove(edit->key));
            },
            EditKind:::Remove -> {
                guard position := worldFile->IndexOf(edit->key) return Result<Edit*!, string!>:::Err(`no entity ${edit->key}`);
                removed := worldFile->entities.remove(position);
                return Result<Edit*!, string!>:::Ok(Edit:::Insert(position, removed!));
            },
        }
    }

    // Keeps an insert position within the list.
    ClampIndex :: (index: usize, limit: usize) -> usize {
        if index > limit {
            return limit;
        }
        return index;
    }

    // Makes an owned copy of a message, since errors are returned as owned text.
    OwnedEditorText :: (text: string) -> string! {
        return `${text}`;
    }

    // One step in the undo list: a label for the menu, the edits that undo it and those that redo it, and
    // a state id that says which saved version of the document this step leads to. `coalesceEntity` and
    // `coalesceField` mark a step that later edits to the same field of the same entity may be merged into
    // (typing in an inspector box should be one undo step, not one per letter).
    HistoryEntry :: class {
    public:
        label~ string!;
        undo~ Array<Edit*!>! = [];
        redo~ Array<Edit*!>! = [];
        coalesceEntity~ u64? = null;
        coalesceField~ string!? = null;
        stateId~ u64 = 0;

        HistoryEntry~: (entryLabel: string, entryStateId: u64) {
            label = `${entryLabel}`;
            stateId = entryStateId;
        }

        !HistoryEntry~: () {
            delete label;
            delete coalesceField;
            undo.freeAll();
            redo.freeAll();
        }

        // True when a new edit to this entity and field may be merged into this step.
        CoalescesWith :: (entity: u64?, field: string?) -> bool {
            guard mineEntity := coalesceEntity return false;
            guard mineField := coalesceField return false;
            guard theirEntity := entity return false;
            guard theirField := field return false;
            return mineEntity == theirEntity && mineField == theirField;
        }
    }

    // Copies a list of edits.
    CopyEdits :: (edits: Array<Edit*!>) -> Array<Edit*!>! {
        copies~ Array<Edit*!>! = [];
        for edit in edits {
            copied~ Edit*! = edit->Copy();
            copies.push(copied!);
        }
        return copies!;
    }

    // Applies edits in order and returns the edits that undo them all, in reverse order. If one fails, the
    // ones already done are rolled back, so the level is never left half edited.
    ApplyAll :: (worldFile: lantern:::world:::WorldFile~*, edits: Array<Edit*!>!) -> Result<Array<Edit*!>!, string!> {
        inverses~ Array<Edit*!>! = [];
        pending~ Array<Edit*!>! = edits!;
        defer pending.freeAll();
        for index~ usize = 0; index < pending.length(); index++ {
            applied := ApplyEdit(pending[index], worldFile);
            when applied! {
                Result:::Ok(inverse) -> {
                    inverses.push(inverse!);
                },
                Result:::Err(message) -> {
                    RollBack(worldFile, inverses!);
                    return Result<Array<Edit*!>!, string!>:::Err(message!);
                }
            }
        }
        reversed~ Array<Edit*!>! = [];
        while inverses.length() > 0 {
            last := inverses.remove(inverses.length() - 1);
            reversed.push(last!);
        }
        inverses.freeAll();
        return Result<Array<Edit*!>!, string!>:::Ok(reversed!);
    }

    // Undoes edits already applied, newest first. A failure while rolling back is dropped, since there
    // is nothing left to do about it.
    RollBack :: (worldFile: lantern:::world:::WorldFile~*, inverses: Array<Edit*!>!) -> void {
        remaining~ Array<Edit*!>! = inverses!;
        while remaining.length() > 0 {
            last := remaining.remove(remaining.length() - 1);
            undone := ApplyEdit(last, worldFile);
            when undone! {
                Result:::Ok(edit) -> {
                    delete edit;
                },
                Result:::Err(message) -> {
                    delete message;
                }
            }
            delete last;
        }
        remaining.freeAll();
    }

    // The level being edited: the world file, its path, and the undo and redo stacks. `revision` goes up
    // after every change so anything built from the level (the pick geometry, the outliner) knows when
    // to rebuild. `savedStateId` is the state at the last save, so the document is dirty when the
    // current state differs. `previewOriginals` holds the entities as they were before a drag began,
    // see PreviewReplace.
    EditorDocument :: class {
    public:
        documentWorldFile~ lantern:::world:::WorldFile*!;
        path~ string!? = null;
        undoStack~ Array<HistoryEntry*!>! = [];
        redoStack~ Array<HistoryEntry*!>! = [];
        nextStateId~ u64 = 1;
        savedStateId~ u64 = 0;
        topOpenForCoalescing~ bool = false;
        previewOriginals~ Array<lantern:::world:::WorldEntity*!>! = [];
        revision~ u64 = 1;

        EditorDocument~: (documentWorld: lantern:::world:::WorldFile*!, documentPath: string!?) {
            documentWorldFile = documentWorld!;
            path = documentPath!;
        }

        !EditorDocument~: () {
            delete documentWorldFile;
            delete path;
            undoStack.freeAll();
            redoStack.freeAll();
            previewOriginals.freeAll();
        }

        // Loads a level file into a new document, or returns the loader's error message.
        static Open :: (filePath: string) -> Result<EditorDocument*!, string!> {
            loaded := lantern:::world:::Load(filePath);
            when loaded! {
                Result:::Ok(opened) -> {
                    return Result<EditorDocument*!, string!>:::Ok(new EditorDocument(opened!, `${filePath}`));
                },
                Result:::Err(message) -> {
                    return Result<EditorDocument*!, string!>:::Err(message!);
                }
            }
        }

        // The change counter described above.
        Revision :: () -> u64 {
            return revision;
        }

        // The state id of the newest undo step, or 0 with an empty history.
        CurrentStateId :: () -> u64 {
            if undoStack.length() == 0 {
                return 0;
            }
            return undoStack[undoStack.length() - 1]->stateId;
        }

        // True when there is anything not saved: the state differs from the last save, or a drag is
        // in progress.
        IsDirty :: () -> bool {
            return CurrentStateId() != savedStateId || previewOriginals.length() > 0;
        }

        // Writes the level as it stands, unsaved edits included, to `target` for play in editor, with one extra
        // `play_start` entity at `position` facing `yaw` (the camera's heading, the same convention as the
        // game's camera). The entity is added for the write and taken out again, so the open level, its undo
        // history and its saved state are untouched. Returns null on success, else a message.
        SavePlayCopy~: (target: string, position: Vec3, yaw: f32) -> string!? {
            playStart := new lantern:::world:::WorldEntity(documentWorldFile->NextEntityKey(), "Play start", "play_start");
            playStart->transform.position = position;
            playStart->SetNumberProperty("yaw", yaw);
            documentWorldFile->Add(playStart!);
            failure: string!? = documentWorldFile->Save(target);
            removed := documentWorldFile->entities.remove(documentWorldFile->entities.length() - 1);
            delete removed;
            return failure!;
        }

        // Writes the level, to `target` or else to its own path (an error if it has neither). A drag in
        // progress is committed first. On success the path and saved state are updated.
        Save~: (target: string?) -> Result<string!, string!> {
            CommitPreview("Edit");
            chosen~ string!? = null;
            if given := target {
                chosen = `${given}`;
            } else if own := path {
                chosen = `${own}`;
            }
            guard chosenPath := chosen return Result<string!, string!>:::Err(OwnedEditorText("the documentWorldFile has no file yet"));
            failure: string!? = documentWorldFile->Save(chosenPath);
            if message := failure {
                reason: string! = `${message}`;
                delete failure;
                delete chosen;
                return Result<string!, string!>:::Err(reason!);
            }
            delete failure;
            delete path;
            path = `${chosenPath}`;
            savedStateId = CurrentStateId();
            topOpenForCoalescing = false;
            revision += 1;
            savedPath: string! = `${chosenPath}`;
            delete chosen;
            return Result<string!, string!>:::Ok(savedPath!);
        }

        // Runs a group of edits as one undo step called `label`. Returns an error message, or null.
        Execute~: (label: string, edits: Array<Edit*!>!) -> string!? {
            return ExecuteCoalescing(label, edits!, null, null);
        }

        // Like Execute, but when the step on top of the history is still open and was made to the same
        // field of the same entity, merges into it by keeping its undo edits and replacing its redo edits. A
        // new change clears the redo stack. An empty list of edits does nothing.
        ExecuteCoalescing~: (label: string, edits: Array<Edit*!>!, coalesceEntity: u64?, coalesceField: string?) -> string!? {
            CommitPreview("Edit");
            if edits.length() == 0 {
                empty~ Array<Edit*!>! = edits!;
                empty.freeAll();
                return null;
            }
            redo~ Array<Edit*!>! = CopyEdits(edits);
            applied := ApplyAll(documentWorldFile, edits!);
            when applied! {
                Result:::Ok(undo~ Array<Edit*!>!) -> {
                    revision += 1;
                    redoStack.freeAll();
                    redoStack = [];
                    merge~ bool = false;
                    if topOpenForCoalescing && undoStack.length() > 0 {
                        merge = undoStack[undoStack.length() - 1]->CoalescesWith(coalesceEntity, coalesceField);
                    }
                    if merge {
                        top~ HistoryEntry~* = undoStack[undoStack.length() - 1];
                        top->redo.freeAll();
                        top->redo = redo!;
                        top->stateId = nextStateId;
                        undo.freeAll();
                    } else {
                        entry := new HistoryEntry(label, nextStateId);
                        entry->undo.freeAll();
                        entry->undo = undo!;
                        entry->redo.freeAll();
                        entry->redo = redo!;
                        entry->coalesceEntity = coalesceEntity;
                        if field := coalesceField {
                            entry->coalesceField = `${field}`;
                        }
                        undoStack.push(entry!);
                    }
                    nextStateId += 1;
                    topOpenForCoalescing = coalesceEntity != null && coalesceField != null;
                    return null;
                },
                Result:::Err(message) -> {
                    redo.freeAll();
                    return message!;
                }
            }
        }

        // Ends coalescing, so the next edit starts a new step. Called when a text box loses focus.
        SealHistory~: () -> void {
            topOpenForCoalescing = false;
        }

        // True when there is something to undo (a drag in progress counts, since undo cancels it).
        CanUndo :: () -> bool {
            return undoStack.length() > 0 || previewOriginals.length() > 0;
        }

        // True when there is something to redo.
        CanRedo :: () -> bool {
            return redoStack.length() > 0;
        }

        // The label of the step undo would undo, for the menu text.
        UndoLabel :: () -> string? {
            if undoStack.length() == 0 {
                return null;
            }
            return undoStack[undoStack.length() - 1]->label;
        }

        // The label of the step redo would redo.
        RedoLabel :: () -> string? {
            if redoStack.length() == 0 {
                return null;
            }
            return redoStack[redoStack.length() - 1]->label;
        }

        // Every step's label, oldest first, undone steps last. The history panel shows this.
        HistoryLabels :: () -> Array<string!>! {
            labels~ Array<string!>! = [];
            for entry in undoStack {
                labels.push(`${entry->label}`);
            }
            index~ usize = redoStack.length();
            while index > 0 {
                index -= 1;
                labels.push(`${redoStack[index]->label}`);
            }
            return labels!;
        }

        // How many steps are currently done. Steps past this position are the redo steps.
        HistoryPosition :: () -> usize {
            return undoStack.length();
        }

        // Undoes or redoes steps until the history is at `position`. Used when clicking a row of the history
        // panel. Returns whether anything moved.
        JumpHistory~: (position: usize) -> bool {
            moved~ bool = false;
            while HistoryPosition() > position && Undo() {
                moved = true;
            }
            while HistoryPosition() < position && Redo() {
                moved = true;
            }
            return moved;
        }

        // Cancels a drag in progress if there is one, else undoes the newest step and moves it to the redo
        // stack. Returns false when there was nothing to undo.
        Undo~: () -> bool {
            if previewOriginals.length() > 0 {
                CancelPreview();
                return true;
            }
            if undoStack.length() == 0 {
                return false;
            }
            entry := undoStack.remove(undoStack.length() - 1);
            ReportHistoryFailure("undo", entry->label, ApplyAll(documentWorldFile, CopyEdits(entry->undo)));
            redoStack.push(entry!);
            topOpenForCoalescing = false;
            revision += 1;
            return true;
        }

        // Redoes the newest undone step (after committing any drag).
        Redo~: () -> bool {
            CommitPreview("Edit");
            if redoStack.length() == 0 {
                return false;
            }
            entry := redoStack.remove(redoStack.length() - 1);
            ReportHistoryFailure("redo", entry->label, ApplyAll(documentWorldFile, CopyEdits(entry->redo)));
            undoStack.push(entry!);
            topOpenForCoalescing = false;
            revision += 1;
            return true;
        }

        // Where an entity's pre-drag copy sits in `previewOriginals`, or null.
        OriginalIndex :: (key: u64) -> usize? {
            for index~ usize = 0; index < previewOriginals.length(); index++ {
                if previewOriginals[index]->id == key {
                    return index;
                }
            }
            return null;
        }

        // Swaps in a changed entity without adding to the history. While the mouse drags a gizmo handle,
        // every frame replaces the entity this way, and the first time it keeps a copy of the original. Nothing
        // is undoable until the drag ends and CommitPreview records one step.
        PreviewReplace~: (entity: lantern:::world:::WorldEntity*!) -> void {
            positionFound: usize? = documentWorldFile->IndexOf(entity->id);
            position~ usize = 0;
            if found := positionFound {
                position = found;
            } else {
                delete entity;
                return;
            }
            if OriginalIndex(entity->id) == null {
                original~ lantern:::world:::WorldEntity*! = documentWorldFile->entities[position]->Copy();
                previewOriginals.push(original!);
            }
            previous := documentWorldFile->entities.remove(position);
            delete previous;
            documentWorldFile->entities.insert(position, entity!);
            revision += 1;
        }

        // True while a drag is in progress.
        IsPreviewing :: () -> bool {
            return previewOriginals.length() > 0;
        }

        // Ends a drag: compares each previewed entity with its original and records one history step
        // (replace edits both ways) for those that changed. If nothing really changed, no step is made.
        CommitPreview~: (label: string) -> void {
            if previewOriginals.length() == 0 {
                return;
            }
            entry := new HistoryEntry(label, nextStateId);
            for current in documentWorldFile->entities {
                guard originalIndex := OriginalIndex(current->id) continue;
                original~ lantern:::world:::WorldEntity~* = previewOriginals[originalIndex];
                if !original->SameAs(current) {
                    undoEdit~ Edit*! = Edit:::Replace(original->Copy());
                    entry->undo.push(undoEdit!);
                    redoEdit~ Edit*! = Edit:::Replace(current->Copy());
                    entry->redo.push(redoEdit!);
                }
            }
            previewOriginals.freeAll();
            previewOriginals = [];
            if entry->undo.length() == 0 {
                delete entry;
                return;
            }
            redoStack.freeAll();
            redoStack = [];
            undoStack.push(entry!);
            nextStateId += 1;
            topOpenForCoalescing = false;
            revision += 1;
        }

        // Ends a drag by putting the original entities back.
        CancelPreview~: () -> void {
            while previewOriginals.length() > 0 {
                original := previewOriginals.remove(previewOriginals.length() - 1);
                if position := documentWorldFile->IndexOf(original->id) {
                    previous := documentWorldFile->entities.remove(position);
                    delete previous;
                    documentWorldFile->entities.insert(position, original!);
                } else {
                    delete original;
                }
            }
            revision += 1;
        }
    }

    // Logs an undo or redo that failed to apply, since the menu action has no place to show it.
    ReportHistoryFailure :: (action: string, label: string, applied: Result<Array<Edit*!>!, string!>) -> void {
        when applied! {
            Result:::Ok(inverses~ Array<Edit*!>!) -> {
                inverses.freeAll();
            },
            Result:::Err(message) -> {
                logged: string! = `${action} of '${label}' failed: ${message}`;
                lantern:::core:::LogError("editor", logged);
                delete logged;
                delete message;
            }
        }
    }
}
