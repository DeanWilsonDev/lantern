    MouseButtonNamed :: (name: string) -> lantern:::core:::MouseButton? {
        if name == "Left" {
            return lantern:::core:::MouseButton:::Left;
        }
        if name == "Right" {
            return lantern:::core:::MouseButton:::Right;
        }
        if name == "Middle" {
            return lantern:::core:::MouseButton:::Middle;
        }
        return null;
    }

    GamepadButtonNamed :: (name: string) -> lantern:::core:::GamepadButton? {
        if name == "South" {
            return lantern:::core:::GamepadButton:::South;
        }
        if name == "East" {
            return lantern:::core:::GamepadButton:::East;
        }
        if name == "West" {
            return lantern:::core:::GamepadButton:::West;
        }
        if name == "North" {
            return lantern:::core:::GamepadButton:::North;
        }
        if name == "Back" {
            return lantern:::core:::GamepadButton:::Back;
        }
        if name == "Start" {
            return lantern:::core:::GamepadButton:::Start;
        }
        if name == "LeftStick" {
            return lantern:::core:::GamepadButton:::LeftStick;
        }
        if name == "RightStick" {
            return lantern:::core:::GamepadButton:::RightStick;
        }
        if name == "LeftShoulder" {
            return lantern:::core:::GamepadButton:::LeftShoulder;
        }
        if name == "RightShoulder" {
            return lantern:::core:::GamepadButton:::RightShoulder;
        }
        if name == "DPadUp" {
            return lantern:::core:::GamepadButton:::DPadUp;
        }
        if name == "DPadDown" {
            return lantern:::core:::GamepadButton:::DPadDown;
        }
        if name == "DPadLeft" {
            return lantern:::core:::GamepadButton:::DPadLeft;
        }
        if name == "DPadRight" {
            return lantern:::core:::GamepadButton:::DPadRight;
        }
        return null;
    }

    GamepadAxisNamed :: (name: string) -> lantern:::core:::GamepadAxis? {
        if name == "LeftX" {
            return lantern:::core:::GamepadAxis:::LeftX;
        }
        if name == "LeftY" {
            return lantern:::core:::GamepadAxis:::LeftY;
        }
        if name == "RightX" {
            return lantern:::core:::GamepadAxis:::RightX;
        }
        if name == "RightY" {
            return lantern:::core:::GamepadAxis:::RightY;
        }
        if name == "LeftTrigger" {
            return lantern:::core:::GamepadAxis:::LeftTrigger;
        }
        if name == "RightTrigger" {
            return lantern:::core:::GamepadAxis:::RightTrigger;
        }
        return null;
    }

    GamepadStickNamed :: (name: string) -> lantern:::core:::GamepadStick? {
        if name == "Left" {
            return lantern:::core:::GamepadStick:::Left;
        }
        if name == "Right" {
            return lantern:::core:::GamepadStick:::Right;
        }
        return null;
    }

    KeyArgument :: (context: lantern:::nyx:::CallContext~*, index: usize) -> lantern:::core:::KeyCode {
        name: string! = context->Text(index);
        defer delete name;
        if found := KeyNamed(name) {
            return found;
        }
        message: string! = `'${name}' is not a key name`;
        Invalid(context, message);
        delete message;
        return lantern:::core:::KeyCode:::A;
    }

    MouseButtonArgument :: (context: lantern:::nyx:::CallContext~*, index: usize) -> lantern:::core:::MouseButton {
        name: string! = context->Text(index);
        defer delete name;
        if found := MouseButtonNamed(name) {
            return found;
        }
        message: string! = `'${name}' is not a mouse button name`;
        Invalid(context, message);
        delete message;
        return lantern:::core:::MouseButton:::Left;
    }

    GamepadButtonArgument :: (context: lantern:::nyx:::CallContext~*, index: usize) -> lantern:::core:::GamepadButton {
