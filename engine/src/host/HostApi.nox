NyxC :: import NyxC;

lantern:::host :: namespace {
    OwnedText :: (text: string) -> string! {
        return `${text}`;
    }

    NOT_FOUND_VARIANT: string : "Error::NotFound";
    INVALID_VARIANT: string : "Error::Unknown";

    HostNamespace :: class {
    public:
        runtime~ raw lantern:::nyx:::Runtime~* = null;
        path~ string!;
        failure~ lantern:::nyx:::NyxError*!? = null;

        HostNamespace~: (owningRuntime: lantern:::nyx:::Runtime~*, namespacePath: string) {
            unsafe {
                runtime = owningRuntime;
            }
            path = `${namespacePath}`;
        }

        !HostNamespace~: () {
            delete path;
            delete failure;
        }

        Function~: (name: string, signature: string, body: ((context: lantern:::nyx:::CallContext~*) -> void)!) -> void {
            qualified: string! = `${path}::${name}`;
            failed~ lantern:::nyx:::NyxError*!? = null;
            unsafe {
                failed = runtime->RegisterFunction(qualified, signature, body!);
            }
            delete qualified;
            if failure == null {
                failure = failed!;
                return;
            }
            delete failed;
        }

        Finish~: () -> lantern:::nyx:::NyxError*!? {
            taken: lantern:::nyx:::NyxError*!? = failure!;
            failure = null;
            return taken!;
        }
    }

    FirstFailure :: (first: lantern:::nyx:::NyxError*!?, next: lantern:::nyx:::NyxError*!?) -> lantern:::nyx:::NyxError*!? {
        if first == null {
            return next!;
        }
        delete next;
        return first!;
    }

    MathTypes :: struct {
        vec2~ raw lantern:::nyx:::HostType~* = null;
        vec3~ raw lantern:::nyx:::HostType~* = null;
    }

    Vec3Bytes :: (vector: raw Vec3~*) -> raw u8~* {
        unsafe {
            viewed := reinterpret<raw u8~*>(vector);
            return viewed^*;
        }
    }

    Vec2Bytes :: (vector: raw Vec2~*) -> raw u8~* {
        unsafe {
            viewed := reinterpret<raw u8~*>(vector);
            return viewed^*;
        }
    }

    Vec3At :: (bytes: raw u8~*) -> Vec3 {
        if bytes == null {
            return Vec3 { };
        }
        unsafe {
            viewed := reinterpret<raw Vec3~*>(bytes);
            pointer: raw Vec3~* = viewed^*;
            return pointer^*;
        }
    }

    Vec2At :: (bytes: raw u8~*) -> Vec2 {
        if bytes == null {
            return Vec2 { };
        }
        unsafe {
            viewed := reinterpret<raw Vec2~*>(bytes);
            pointer: raw Vec2~* = viewed^*;
            return pointer^*;
        }
    }

    Vec3Argument :: (context: lantern:::nyx:::CallContext~*, index: usize, math: MathTypes) -> Vec3 {
        unsafe {
            return Vec3At(context->HostBytes(index, math.vec3));
        }
    }

    Vec2Argument :: (context: lantern:::nyx:::CallContext~*, index: usize, math: MathTypes) -> Vec2 {
        unsafe {
            return Vec2At(context->HostBytes(index, math.vec2));
        }
    }

    ReturnVec3 :: (context: lantern:::nyx:::CallContext~*, math: MathTypes, vector: Vec3) -> void {
        unsafe {
            returned~ Vec3 = vector;
            pointer: raw Vec3~* = returned;
            context->ReturnHostBytes(math.vec3, Vec3Bytes(pointer));
        }
    }

    ReturnVec2 :: (context: lantern:::nyx:::CallContext~*, math: MathTypes, vector: Vec2) -> void {
        unsafe {
            returned~ Vec2 = vector;
            pointer: raw Vec2~* = returned;
            context->ReturnHostBytes(math.vec2, Vec2Bytes(pointer));
        }
    }

    ReceiverVec3 :: (context: lantern:::nyx:::CallContext~*) -> Vec3 {
        return Vec3At(context->ReceiverBytes());
    }

    ReceiverVec2 :: (context: lantern:::nyx:::CallContext~*) -> Vec2 {
        return Vec2At(context->ReceiverBytes());
    }

    ColorArgument :: (context: lantern:::nyx:::CallContext~*, index: usize) -> lantern:::core:::Color {
        text: string! = context->Text(index);
        defer delete text;
        if context->Refused() {
            return lantern:::core:::Color:::White();
        }
        if color := ParseColor(text) {
            return color;
        }
        message: string! = `'${text}' is not a colour; write "RRGGBB" or "RRGGBBAA"`;
        Invalid(context, message);
        delete message;
        return lantern:::core:::Color:::White();
    }

    Stopped :: (context: lantern:::nyx:::CallContext~*) -> bool {
        return context->Refused() || context->outcome == lantern:::nyx:::CallOutcome:::Failed;
    }

    NotFound :: (context: lantern:::nyx:::CallContext~*, message: string) -> void {
        if Stopped(context) {
            return;
        }
        context->Fail(NOT_FOUND_VARIANT, message);
    }

    Invalid :: (context: lantern:::nyx:::CallContext~*, message: string) -> void {
        if Stopped(context) {
            return;
        }
        context->Fail(INVALID_VARIANT, message);
    }

    SIGN_BIT: u64 : 9223372036854775808;
    LARGEST_I64: i64 : 9223372036854775807;

    BitsToScript :: (bits: u64) -> i64 {
        if bits < SIGN_BIT {
            return i64(bits);
        }
        return i64(bits - SIGN_BIT) - LARGEST_I64 - 1;
    }

    BitsFromScript :: (id: i64) -> u64 {
        if id >= 0 {
            return u64(id);
        }
        return u64(id + LARGEST_I64 + 1) + SIGN_BIT;
    }

    EntityToScript :: (entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>) -> i64 {
        return BitsToScript(entity.ToBits());
    }

    EntityFromScript :: (id: i64) -> lantern:::core:::Handle<lantern:::engine:::EntityTag> {
        return lantern:::core:::HandleFromBits<lantern:::engine:::EntityTag>(BitsFromScript(id));
    }

    HandleToScript<T> :: (handle: lantern:::core:::Handle<T>) -> i64 {
        return BitsToScript(handle.ToBits());
    }

    HandleFromScript<T> :: (id: i64) -> lantern:::core:::Handle<T> {
        return lantern:::core:::HandleFromBits<T>(BitsFromScript(id));
    }
}
