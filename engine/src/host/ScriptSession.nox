lantern:::host :: namespace {
    GAME_HOOK_COUNT: usize : 5;

    GameHook :: enum {
        OnStart,
        OnFixedUpdate,
        OnUpdate,
        OnRender,
        OnExit
    }

    GameHookAt :: (index: usize) -> GameHook {
        return when index {
            0 -> GameHook:::OnStart,
            1 -> GameHook:::OnFixedUpdate,
            2 -> GameHook:::OnUpdate,
            3 -> GameHook:::OnRender,
            override -> GameHook:::OnExit,
        };
    }

    GameHookIndex :: (hook: GameHook) -> usize {
        return when hook {
            GameHook:::OnStart -> 0,
            GameHook:::OnFixedUpdate -> 1,
            GameHook:::OnUpdate -> 2,
            GameHook:::OnRender -> 3,
            GameHook:::OnExit -> 4,
        };
    }

    GameHookName :: (hook: GameHook) -> string {
        return when hook {
            GameHook:::OnStart -> "OnStart",
            GameHook:::OnFixedUpdate -> "OnFixedUpdate",
            GameHook:::OnUpdate -> "OnUpdate",
            GameHook:::OnRender -> "OnRender",
            GameHook:::OnExit -> "OnExit",
        };
    }

    HookTotal :: struct {
        seconds~ f64 = 0.0f;
        calls~ u64 = 0;
    }

    SecondsSince :: (startNanoseconds: u64) -> f64 {
        return f64(monotonicNanoseconds() - startNanoseconds) / 1000000000.0f;
    }

    NyxFailure :: (error: lantern:::nyx:::NyxError*!) -> string! {
        failure: string! = NyxFailureText(error);
        delete error;
        return failure!;
    }

    NyxFailureText :: (error: lantern:::nyx:::NyxError*) -> string! {
        text: string! = error->Text();
        defer delete text;
        return `nyx: ${text}`;
    }

    DescribeHookError :: (hook: GameHook, error: lantern:::nyx:::NyxError*) -> string! {
        errorText: string! = error->Text();
        description~ string! = `${GameHookName(hook)}: ${errorText}`;
        delete errorText;
        for index~ usize = 1; index < error->stack.length(); index++ {
            frameText: string! = error->stack[index]->Text();
            description += "\n";
            description += `    called from ${frameText}`;
            delete frameText;
        }
        return description!;
    }

    ScriptSession :: class {
    public:
        program~ lantern:::nyx:::Program*!? = null;
        runtime~ lantern:::nyx:::Runtime*!;
        math~ MathTypes = MathTypes { };
        definedHooks~ Array<bool>! = [];
        entryPath~ string!;
        scriptSeconds~ f64 = 0.0f;
        hookTotals~ Array<HookTotal>! = [];
        gameUi~ GameUiState*!;

        ScriptSession~: (sessionRuntime: lantern:::nyx:::Runtime*!, sessionProgram: lantern:::nyx:::Program*!, sessionMath: MathTypes, path: string!, sessionUi: GameUiState*!) {
            gameUi = sessionUi!;
            runtime = sessionRuntime!;
            program = sessionProgram!;
            math = sessionMath;
            entryPath = path!;
            for index~ usize = 0; index < GAME_HOOK_COUNT; index++ {
                definedHooks.push(false);
                hookTotals.push(HookTotal { });
            }
        }

        !ScriptSession~: () {
            delete gameUi;
            delete program;
            delete runtime;
            delete definedHooks;
            delete entryPath;
            delete hookTotals;
        }

        static Load :: (scriptsDirectory: string, entryFile: string, applicationClass: string, state: raw EngineState~*) -> Result<ScriptSession*!, string!> {
            entryPath: string! = `${scriptsDirectory}/${entryFile}`;
            runtime := new lantern:::nyx:::Runtime();
            if !runtime->IsUsable() {
                delete runtime;
                delete entryPath;
                return Result<ScriptSession*!, string!>:::Err(OwnedText("nyx: the runtime could not be created"));
            }
            math~ MathTypes = MathTypes { };
            gameUi := new GameUiState();
            uiPointer~ raw GameUiState~* = null;
            unsafe {
                uiPointer = gameUi;
            }
            registered: lantern:::nyx:::NyxError*!? = RegisterEngineApis(runtime, state, math, uiPointer);
            if error := registered {
                failure: string! = NyxFailureText(error);
                delete registered;
                delete gameUi;
                delete runtime;
                delete entryPath;
                return Result<ScriptSession*!, string!>:::Err(failure!);
            }
            delete registered;
            searchFailed: lantern:::nyx:::NyxError*!? = runtime->AddImportSearchPath(scriptsDirectory);
            if error := searchFailed {
                failure: string! = NyxFailureText(error);
                delete searchFailed;
                delete gameUi;
                delete runtime;
                delete entryPath;
                return Result<ScriptSession*!, string!>:::Err(failure!);
            }
            delete searchFailed;
            uiDirectory: string! = `${scriptsDirectory}/ui`;
            started := lantern:::chaosui:::ChaosUi:::Create(runtime, scriptsDirectory, uiDirectory);
            defer delete uiDirectory;
            when started! {
                Result:::Ok(chaos) -> {
                    gameUi->chaos = chaos!;
                },
                Result:::Err(message) -> {
                    delete gameUi;
                    delete runtime;
                    delete entryPath;
                    return Result<ScriptSession*!, string!>:::Err(message!);
                }
            }
            mounted := runtime->MountFile(entryPath, applicationClass);
            when mounted! {
                Result:::Ok(program) -> {
                    session := new ScriptSession(runtime!, program!, math, entryPath!, gameUi!);
                    hooksFailure: string!? = session->FindHooks();
                    if text := hooksFailure {
                        failure: string! = `${text}`;
                        delete hooksFailure;
                        delete session;
                        return Result<ScriptSession*!, string!>:::Err(failure!);
                    }
                    delete hooksFailure;
                    return Result<ScriptSession*!, string!>:::Ok(session!);
                },
                Result:::Err(error) -> {
                    failure: string! = MountFailure(runtime, entryPath, error!);
                    delete gameUi;
                    delete runtime;
                    delete entryPath;
                    return Result<ScriptSession*!, string!>:::Err(failure!);
                }
            }
        }

        static MountFailure :: (runtime: lantern:::nyx:::Runtime*, entryPath: string, error: lantern:::nyx:::NyxError*!) -> string! {
            errorText: string! = error->Text();
            delete error;
            defer delete errorText;
            rendered := runtime->RenderDiagnostics();
            when rendered! {
                Result:::Ok(diagnostics) -> {
                    trimmed: string = diagnostics.trimEnd();
                    if trimmed.trim().length() > 0 {
                        failure: string! = `${trimmed}`;
                        delete diagnostics;
                        return failure!;
                    }
                    delete diagnostics;
                },
                Result:::Err(renderError) -> {
                    delete renderError;
                }
            }
            return `${entryPath}: ${errorText}`;
        }

        FindHooks~: () -> string!? {
            guard mountedProgram ~= program return OwnedText("nyx: the program isn't mounted");
            found~ lantern:::nyx:::Value*!? = null;
            mountedApplication := mountedProgram->Application();
            when mountedApplication! {
                Result:::Ok(instance) -> {
                    found = instance!;
                },
                Result:::Err(error) -> {
                    return NyxFailure(error!);
                }
            }
            for index~ usize = 0; index < GAME_HOOK_COUNT; index++ {
                defines := mountedProgram->DefinesMethod(GameHookName(GameHookAt(index)));
                when defines! {
                    Result:::Ok(defined) -> {
                        definedHooks[index] = defined;
                    },
                    Result:::Err(error) -> {
                        delete found;
                        return NyxFailure(error!);
                    }
                }
            }
            delete gameUi->applicationValue;
            gameUi->applicationValue = found!;
            return null;
        }

        EntryPath :: () -> string {
            return entryPath;
        }

        Defines :: (hook: GameHook) -> bool {
            return definedHooks[GameHookIndex(hook)];
        }

        Call~: (hook: GameHook, arguments: Array<f32>) -> string!? {
            if !Defines(hook) {
                return null;
            }
            guard mountedProgram ~= program return null;
            values~ Array<lantern:::nyx:::Value*!>! = [];
            for argument in arguments {
                values.push(runtime->MakeF32(argument));
            }
            borrowed~ Array<lantern:::nyx:::Value*>! = [];
            for value in values {
                borrowed.push(value);
            }
            started: u64 = monotonicNanoseconds();
            result := mountedProgram->CallApplicationMethod(GameHookName(hook), borrowed);
            elapsed: f64 = SecondsSince(started);
            scriptSeconds += elapsed;
            index: usize = GameHookIndex(hook);
            total~ HookTotal = hookTotals[index];
            total.seconds += elapsed;
            total.calls += 1;
            hookTotals[index] = total;
            defer delete borrowed;
            defer values.freeAll();
            when result! {
                Result:::Ok(returned) -> {
                    delete returned;
                    return null;
                },
                Result:::Err(error) -> {
                    description: string! = DescribeHookError(hook, error);
                    delete error;
                    return description!;
                }
            }
        }

        UiNavigationActions :: () -> NavigationActions*? {
            return gameUi->navigation;
        }

        NavigateUi~: (navigation: lantern:::chaosui:::Navigation) -> void {
            guard chaos ~= gameUi->chaos return;
            started: u64 = monotonicNanoseconds();
            chaos->Navigate(navigation);
            scriptSeconds += SecondsSince(started);
        }

        UpdateUi~: () -> void {
            guard chaos ~= gameUi->chaos return;
            started: u64 = monotonicNanoseconds();
            chaos->Update();
            scriptSeconds += SecondsSince(started);
        }

        DrawUi~: (overlay: lantern:::renderer:::Overlay~*, screen: Vec2, scale: f32) -> void {
            guard chaos ~= gameUi->chaos return;
            chaos->Draw(overlay, screen, scale);
        }

        UiButtonRects :: () -> Array<lantern:::chaosui:::ButtonRect>! {
            guard chaos := gameUi->chaos return [];
            return chaos->ButtonRects();
        }

        TakeUiMessages~: () -> Array<string!>! {
            guard chaos ~= gameUi->chaos return [];
            return chaos->TakeMessages();
        }

        HookTotalOf :: (hook: GameHook) -> HookTotal {
            return hookTotals[GameHookIndex(hook)];
        }

        TakeScriptSeconds~: () -> f64 {
            taken: f64 = scriptSeconds;
            scriptSeconds = 0.0f;
            return taken;
        }
    }

    EngineHostSurface :: () -> Result<string!, string!> {
        created := EngineState:::Create(new lantern:::renderer:::HeadlessRenderer(), new lantern:::engine:::AudioSystem(null), null);
        when created! {
            Result:::Ok(state) -> {
                runtime := new lantern:::nyx:::Runtime();
                math~ MathTypes = MathTypes { };
                gameUi := new GameUiState();
                registered~ lantern:::nyx:::NyxError*!? = null;
                unsafe {
                    statePointer: raw EngineState~* = state;
                    uiPointer: raw GameUiState~* = gameUi;
                    registered = RegisterEngineApis(runtime, statePointer, math, uiPointer);
                }
                failure~ string!? = null;
                if error := registered {
                    failure = NyxFailureText(error);
                }
                delete registered;
                manifestText~ string!? = null;
                if failure == null {
                    started := lantern:::chaosui:::ChaosUi:::Create(runtime, "", "");
                    when started! {
                        Result:::Ok(chaos) -> {
                            gameUi->chaos = chaos!;
                        },
                        Result:::Err(message) -> {
                            delete failure;
                            failure = message!;
                        }
                    }
                }
                if failure == null {
                    written := runtime->WriteHostSurface();
                    when written! {
                        Result:::Ok(manifest) -> {
                            manifestText = manifest!;
                        },
                        Result:::Err(error) -> {
                            delete failure;
                            failure = NyxFailure(error!);
                        }
                    }
                }
                delete gameUi;
                delete runtime;
                delete state;
                if text := manifestText {
                    result: string! = `${text}`;
                    delete manifestText;
                    delete failure;
                    return Result<string!, string!>:::Ok(result!);
                }
                delete manifestText;
                if text := failure {
                    reason: string! = `${text}`;
                    delete failure;
                    return Result<string!, string!>:::Err(reason!);
                }
                delete failure;
                return Result<string!, string!>:::Err(OwnedText("the host surface couldn't be written"));
            },
            Result:::Err(message) -> {
                return Result<string!, string!>:::Err(message!);
            }
        }
    }
}
