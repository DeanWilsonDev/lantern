lantern:::host :: namespace {
    /**
     * The narrowest and widest lens game code can ask for. Outside this range the projection distorts too much to be a
     * camera at all, so the request is clamped instead of refused.
     */
    MINIMUM_FIELD_OF_VIEW_DEGREES: f32 : 10.0f;
    MAXIMUM_FIELD_OF_VIEW_DEGREES: f32 : 120.0f;

    /**
     * Registers `lantern:::engine`: `Log`, `Warn`, `Quit`, `Flag` and `Setting`. Entities and levels are in
     * `lantern:::world` (WorldApi.nox). See game-api.md.
     */
    RegisterEngineApi :: (runtime: lantern:::nyx:::Runtime~*, state: raw EngineState~*) -> lantern:::nyx:::NyxError*!? {
        engineNamespace := new HostNamespace(runtime, "lantern::engine");
        engineNamespace->Function("Log", "(text: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void {
            text: string! = context->Text(0);
            lantern:::core:::LogInfo("game", text);
            delete text;
        });
        engineNamespace->Function("Warn", "(text: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void {
            text: string! = context->Text(0);
            lantern:::core:::LogWarn("game", text);
            delete text;
        });
        engineNamespace->Function("Quit", "() -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                state->requests.quit = true;
            }
        });
        engineNamespace->Function("Flag", "(name: string) -> bool", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            name: string! = context->Text(0);
            unsafe {
                context->ReturnBool(state->Flag(name));
            }
            delete name;
        });
        engineNamespace->Function("Setting", "(name: string) -> string", new (context: lantern:::nyx:::CallContext~*) -> void {
            name: string! = context->Text(0);
            value: string!? = environmentVariable(name);
            if text := value {
                context->ReturnText(text);
            } else {
                context->ReturnText("");
            }
            delete value;
            delete name;
        });
        failure := engineNamespace->Finish();
        delete engineNamespace;
        return failure!;
    }

    /**
     * Registers `lantern:::overlay`: drawing rectangles and text over the frame, and measuring text (`Rect`, `Text`,
     * `TextWidth`, `TextHeight`, `GlyphSize`), for HUDs that don't use Chaos.
     */
    RegisterOverlayApi :: (runtime: lantern:::nyx:::Runtime~*, state: raw EngineState~*) -> lantern:::nyx:::NyxError*!? {
        overlay := new HostNamespace(runtime, "lantern::overlay");
        overlay->Function("Rect", "(x: f32, y: f32, width: f32, height: f32, color: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            minimum := Vec2 { x: context->F32(0), y: context->F32(1) };
            size := Vec2 { x: context->F32(2), y: context->F32(3) };
            color: lantern:::core:::Color = ColorArgument(context, 4);
            if Stopped(context) {
                return;
            }
            unsafe {
                state->renderWorld->overlay->Rect(minimum, minimum + size, color);
            }
        });
        overlay->Function("Text", "(text: string, x: f32, y: f32, scale: f32, color: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            text: string! = context->Text(0);
            topLeft := Vec2 { x: context->F32(1), y: context->F32(2) };
            scale: f32 = context->F32(3);
            color: lantern:::core:::Color = ColorArgument(context, 4);
            if !Stopped(context) {
                unsafe {
                    state->renderWorld->overlay->Text(text, topLeft, scale, color);
                }
            }
            delete text;
        });
        overlay->Function("TextWidth", "(text: string, scale: f32) -> f32", new (context: lantern:::nyx:::CallContext~*) -> void {
            text: string! = context->Text(0);
            scale: f32 = context->F32(1);
            context->ReturnF32(lantern:::renderer:::MeasureText(text, scale).x);
            delete text;
        });
        overlay->Function("TextHeight", "(text: string, scale: f32) -> f32", new (context: lantern:::nyx:::CallContext~*) -> void {
            text: string! = context->Text(0);
            scale: f32 = context->F32(1);
            context->ReturnF32(lantern:::renderer:::MeasureText(text, scale).y);
            delete text;
        });
        overlay->Function("GlyphSize", "() -> f32", new (context: lantern:::nyx:::CallContext~*) -> void {
            context->ReturnF32(f32(lantern:::renderer:::GLYPH_SIZE));
        });
        failure := overlay->Finish();
        delete overlay;
        return failure!;
    }

    /**
     * Registers `lantern:::camera` (`LookAt`, `SetFieldOfView`), `lantern:::renderer` (`SetClearColor`, `SetFog`) and `lantern:::screen`
     * (`Width`, `Height`, `UiScale`, `SetMouseCaptured`).
     */
    RegisterRenderingApi :: (runtime: lantern:::nyx:::Runtime~*, state: raw EngineState~*, math: MathTypes) -> lantern:::nyx:::NyxError*!? {
        camera := new HostNamespace(runtime, "lantern::camera");
        camera->Function("LookAt", "(eye: lantern:::math:::Vec3, target: lantern:::math:::Vec3) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            eye: Vec3 = Vec3Argument(context, 0, math);
            target: Vec3 = Vec3Argument(context, 1, math);
            if Stopped(context) {
                return;
            }
            unsafe {
                // LookAt builds a new camera, so the field of view the game set last is carried over: placing the
                // camera each frame must not undo a wider or narrower lens.
                fieldOfViewRadians: f32 = state->renderWorld->camera.verticalFieldOfViewRadians;
                state->renderWorld->camera = lantern:::renderer:::Camera:::LookAt(eye, target);
                state->renderWorld->camera.verticalFieldOfViewRadians = fieldOfViewRadians;
            }
        });
        camera->Function("SetFieldOfView", "(degrees: f32) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            degrees: f32 = context->F32(0);
            if Stopped(context) {
                return;
            }
            unsafe {
                state->renderWorld->camera.verticalFieldOfViewRadians = Math:::clamp(degrees, MINIMUM_FIELD_OF_VIEW_DEGREES, MAXIMUM_FIELD_OF_VIEW_DEGREES) * (Math:::PI / 180.0f);
            }
        });
        failure~ lantern:::nyx:::NyxError*!? = camera->Finish();
        delete camera;
        rendererNamespace := new HostNamespace(runtime, "lantern::renderer");
        rendererNamespace->Function("SetClearColor", "(color: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            color: lantern:::core:::Color = ColorArgument(context, 0);
            if Stopped(context) {
                return;
            }
            unsafe {
                state->renderWorld->clearColor = color;
            }
        });
        rendererNamespace->Function("SetFog", "(start: f32, end: f32) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            start: f32 = context->F32(0);
            end: f32 = context->F32(1);
            if Stopped(context) {
                return;
            }
            unsafe {
                state->renderWorld->fogStart = start;
                state->renderWorld->fogEnd = end;
            }
        });
        failure = FirstFailure(failure!, rendererNamespace->Finish());
        delete rendererNamespace;
        screen := new HostNamespace(runtime, "lantern::screen");
        screen->Function("Width", "() -> f32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                context->ReturnF32(state->screenSize.x);
            }
        });
        screen->Function("Height", "() -> f32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                context->ReturnF32(state->screenSize.y);
            }
        });
        screen->Function("UiScale", "() -> f32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                context->ReturnF32(state->uiScale);
            }
        });
        screen->Function("SetMouseCaptured", "(captured: bool) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            captured: bool = context->Bool(0);
            if Stopped(context) {
                return;
            }
            unsafe {
                state->requests.mouseCaptured = captured;
            }
        });
        screen->Function("Capture", "(path: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            path: string! = context->Text(0);
            if Stopped(context) {
                delete path;
                return;
            }
            unsafe {
                delete state->pendingCapturePath;
                state->pendingCapturePath = path!;
            }
        });
        failure = FirstFailure(failure!, screen->Finish());
        delete screen;
        return failure!;
    }
}
