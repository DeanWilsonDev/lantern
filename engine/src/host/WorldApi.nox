SceneLink :: import SceneLink;

lantern:::host :: namespace {
    // The parameters a baked material shader starts with, `name=value;name=value` in slot order: the values go into
    // `source.parameters` and the names come back, so `SetMaterialParameter` can find each slot by name.
    ParseShaderParameters :: (text: string, source: lantern:::renderer:::MaterialShaderSource~*) -> Array<string!>! {
        names~ Array<string!>! = [];
        start~ usize = 0;
        while start < text.length() && names.length() < usize(lantern:::renderer:::MAX_MATERIAL_SHADER_PARAMETERS) {
            end~ usize = start;
            while end < text.length() && text.byteAt(end) != 59 {
                end++;
            }
            entry: string = text.substring(start, end - start);
            equals~ usize? = null;
            for position~ usize = 0; position < entry.length(); position++ {
                if entry.byteAt(position) == 61 && equals == null {
                    equals = position;
                }
            }
            if split := equals {
                value~ f32 = 0.0f;
                when lantern:::json:::Parse(entry.substring(split + 1, entry.length() - split - 1)) {
                    Result:::Err(message) -> {
                        delete message;
                    },
                    Result:::Ok(parsed) -> {
                        if parsed->Kind(parsed->root) == lantern:::json:::JsonKind:::Number {
                            value = f32(parsed->Node(parsed->root).number);
                        }
                        delete parsed;
                    }
                }
                source->parameters[names.length()] = value;
                names.push(`${entry.substring(0, split)}`);
            }
            start = end + 1;
        }
        return names!;
    }

    /**
     * Reads argument `index` as an entity id and checks that entity still exists, failing the call with not-found if it
     * doesn't. A script that keeps an id past a despawn gets an error and not a crash.
     */
    LiveEntity :: (context: lantern:::nyx:::CallContext~*, state: raw EngineState~*, index: usize) -> lantern:::core:::Handle<lantern:::engine:::EntityTag>? {
        id: i64 = context->I64(index);
        if Stopped(context) {
            return null;
        }
        entity: lantern:::core:::Handle<lantern:::engine:::EntityTag> = EntityFromScript(id);
        unsafe {
            if state->entityWorld->Contains(entity) {
                return entity;
            }
        }
        message: string! = `no entity with id ${id}`;
        NotFound(context, message);
        delete message;
        return null;
    }

    /**
     * The name of what went wrong when setting a parent, or null when nothing did.
     */
    ParentChangeProblem :: (change: lantern:::engine:::ParentChange) -> string? {
        return when change {
            lantern:::engine:::ParentChange:::Done -> null,
            lantern:::engine:::ParentChange:::UnknownEntity -> "UnknownEntity",
            lantern:::engine:::ParentChange:::WouldCreateCycle -> "WouldCreateCycle",
        };
    }

    /**
     * Copies a world entity's kind and properties into the tags the script reads.
     */
    TagsFromWorldEntity :: (spawned: lantern:::core:::Handle<lantern:::engine:::EntityTag>, entity: lantern:::world:::WorldEntity*) -> EntityTags*! {
        tags := new EntityTags(spawned, entity->kind);
        for index~ usize = 0; index < entity->propertyKeys.length(); index++ {
            tags->AddProperty(entity->propertyKeys[index], entity->propertyValues[index], entity->propertyTexts[index]);
        }
        return tags!;
    }

    /**
     * The texture for an entity's material name, or null (with a warning) when no texture has that name.
     */
    PieceTexture :: (state: raw EngineState~*, entity: lantern:::world:::WorldEntity*) -> lantern:::core:::Handle<lantern:::renderer:::TextureTag>? {
        guard material := entity->material return null;
        unsafe {
            texture: lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = state->Material(material);
            if texture == null && state->LookOf(material) == null {
                message: string! = `'${entity->name}': no texture for material '${material}'`;
                lantern:::core:::LogWarn("world", message);
                delete message;
            }
            return texture;
        }
    }

    /**
     * Adds an entity's collider to the collision world: a static one is added where it stands, and a kinematic one becomes a
     * body that is moved by matrix and is joined to the entity.
     */
    AddPieceCollider :: (state: raw EngineState~*, piece: lantern:::world:::WorldPiece*, spawned: lantern:::core:::Handle<lantern:::engine:::EntityTag>) -> void {
        guard kind := piece->collider return;
        unsafe {
            when kind {
                lantern:::world:::ColliderKind:::Static -> {
                    triangles: Array<lantern:::physics:::Triangle>! = piece->WorldTriangles();
                    state->collision->AddStaticTriangles(triangles);
                    delete triangles;
                },
                lantern:::world:::ColliderKind:::Kinematic -> {
                    triangles: Array<lantern:::physics:::Triangle>! = piece->LocalTriangles();
                    body: lantern:::core:::Handle<lantern:::physics:::KinematicBody> = state->collision->AddBody(triangles, piece->worldMatrix);
                    state->SetBody(spawned, body);
                    delete triangles;
                }
            }
        }
    }

    /**
     * Spawns one entity of a loaded level, with a mesh and renderer when it has a shape.
     */
    SpawnPiece :: (state: raw EngineState~*, piece: lantern:::world:::WorldPiece*, entity: lantern:::world:::WorldEntity*) -> Result<lantern:::core:::Handle<lantern:::engine:::EntityTag>, string!> {
        transform: lantern:::engine:::Transform = lantern:::engine:::Transform:::FromMatrix(piece->localMatrix);
        unsafe {
            guard meshData := piece->mesh return Result<lantern:::core:::Handle<lantern:::engine:::EntityTag>, string!>:::Ok(state->entityWorld->Spawn(entity->name, GameScene(), transform));
            created := state->renderBackend->CreateMesh(meshData);
            when created! {
                Result:::Ok(mesh) -> {
                    state->worldMeshes.push(mesh);
                    meshRenderer~ lantern:::engine:::MeshRenderer = lantern:::engine:::MeshRenderer:::Create(mesh, PieceTexture(state, entity), piece->tint);
                    if materialName := entity->material {
                        if look := state->LookOf(materialName) {
                            meshRenderer.color = lantern:::core:::Color:::Rgba(piece->tint.r * look.tint.r, piece->tint.g * look.tint.g, piece->tint.b * look.tint.b, piece->tint.a);
                            meshRenderer.material = look.material;
                            meshRenderer.materialShader = look.shader;
                        }
                    }
                    return Result<lantern:::core:::Handle<lantern:::engine:::EntityTag>, string!>:::Ok(state->entityWorld->SpawnMesh(entity->name, GameScene(), transform, meshRenderer));
                },
                Result:::Err(message) -> {
                    return Result<lantern:::core:::Handle<lantern:::engine:::EntityTag>, string!>:::Err(message!);
                }
            }
        }
    }

    /**
     * Sets each spawned entity's parent from the file's parent ids. A parent loop or a missing entity is reported with the
     * entity's name.
     */
    LinkPieceParents :: (state: raw EngineState~*, worldFile: lantern:::world:::WorldFile*, pieces: Array<lantern:::world:::WorldPiece*!>, keys: Array<u64>, spawned: Array<lantern:::core:::Handle<lantern:::engine:::EntityTag>>) -> string!? {
        for index~ usize = 0; index < pieces.length(); index++ {
            piece: lantern:::world:::WorldPiece* = pieces[index];
            guard parentKey := piece->parent continue;
            for parentIndex~ usize = 0; parentIndex < keys.length(); parentIndex++ {
                if keys[parentIndex] != parentKey {
                    continue;
                }
                unsafe {
                    change: lantern:::engine:::ParentChange = state->entityWorld->SetParent(spawned[index], spawned[parentIndex]);
                    if problem := ParentChangeProblem(change) {
                        return `${worldFile->entities[piece->entityIndex]->name}: ${problem}`;
                    }
                }
                break;
            }
        }
        return null;
    }

    /**
     * Turns the world file's light entities into lights in the render world: each point and spot light is added and
     * its id remembered so `ClearWorld` can remove it, and a `sun` entity replaces the sun and ambient light (the last
     * one in the file wins). A light is placed by its own transform; a parent's transform is not applied.
     */
    AddWorldLights :: (state: raw EngineState~*, worldFile: lantern:::world:::WorldFile*, streams: Array<bool>) -> void {
        for lightIndex~ usize = 0; lightIndex < worldFile->entities.length(); lightIndex++ {
            if streams[lightIndex] {
                continue;
            }
            entity: lantern:::world:::WorldEntity* = worldFile->entities[lightIndex];
            placement: Mat4 = entity->transform.Matrix();
            unsafe {
                if light := lantern:::world:::LocalLightFromEntity(entity, placement) {
                    state->worldLightIds.push(state->renderWorld->AddLight(light));
                }
                if sun := lantern:::world:::SunFromEntity(entity, placement) {
                    state->renderWorld->light = sun;
                }
            }
        }
    }

    /**
     * Hands the openings between the level's scenes to the streamer, which keeps them for as long as the level.
     */
    KeepSceneLinks :: (state: raw EngineState~*, links: Array<SceneLink*!>!) -> void {
        unsafe {
            state->streaming->links = links!;
        }
    }

    /**
     * Forgets the last level's rooms and registers the new file's. Returns which entities of the file stream.
     */
    RegisterRoomsInState :: (state: raw EngineState~*, worldFile: lantern:::world:::WorldFile*) -> Array<bool>! {
        unsafe {
            state->streaming->Reset();
            return RegisterRooms(state->streaming, worldFile);
        }
    }

    /**
     * Turns a loaded world file into live entities: spawns each piece, adds its collider and tags, links parents, settles
     * the transforms and adds the lights. Returns how many entities were made, or the first error.
     */
    LoadWorldFile :: (state: raw EngineState~*, worldFile: lantern:::world:::WorldFile*!) -> Result<usize, string!> {
        streams := RegisterRoomsInState(state, worldFile);
        defer delete streams;
        pieces~ Array<lantern:::world:::WorldPiece*!>! = [];
        for fileIndex~ usize = 0; fileIndex < worldFile->entities.length(); fileIndex++ {
            if !streams[fileIndex] {
                pieces.push(lantern:::world:::BuildPiece(worldFile, fileIndex));
            }
        }
        keys~ Array<u64>! = [];
        spawned~ Array<lantern:::core:::Handle<lantern:::engine:::EntityTag>>! = [];
        for index~ usize = 0; index < pieces.length(); index++ {
            piece: lantern:::world:::WorldPiece* = pieces[index];
            entity: lantern:::world:::WorldEntity* = worldFile->entities[piece->entityIndex];
            made := SpawnPiece(state, piece, entity);
            when made! {
                Result:::Ok(entityHandle) -> {
                    AddPieceCollider(state, piece, entityHandle);
                    unsafe {
                        state->SetTags(TagsFromWorldEntity(entityHandle, entity));
                    }
                    keys.push(piece->key);
                    spawned.push(entityHandle);
                },
                Result:::Err(message) -> {
                    pieces.freeAll();
                    delete keys;
                    delete spawned;
                    delete worldFile;
                    return Result<usize, string!>:::Err(message!);
                }
            }
        }
        linkFailure: string!? = LinkPieceParents(state, worldFile, pieces, keys, spawned);
        count~ usize = pieces.length();
        for member in streams {
            if member {
                count++;
            }
        }
        pieces.freeAll();
        delete keys;
        delete spawned;
        if text := linkFailure {
            copied: string! = `${text}`;
            delete linkFailure;
            delete worldFile;
            return Result<usize, string!>:::Err(copied!);
        }
        delete linkFailure;
        unsafe {
            state->entityWorld->UpdateWorldTransforms();
            state->entityWorld->StorePreviousTransforms();
        }
        AddWorldLights(state, worldFile, streams);
        unsafe {
            if state->streaming->rooms.length() > 0 {
                state->streaming->worldFile = worldFile!;
            } else {
                delete worldFile;
            }
        }
        return Result<usize, string!>:::Ok(count);
    }

    /**
     * Sets an entity's local position, and moves its collision body with it when it has one.
     */
    MoveEntity :: (state: raw EngineState~*, entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>, position: Vec3) -> void {
        unsafe {
            guard record ~= state->entityWorld->BorrowMutable(entity) return;
            record->local.translation = position;
            matrix: Mat4 = record->local.Matrix();
            if body := state->Body(entity) {
                state->collision->SetBodyTransform(body, matrix);
            }
        }
    }

    /**
     * Where a property is in an entity's tags, failing the call with not-found when the entity has no such property.
     */
    PropertyIndexOf :: (context: lantern:::nyx:::CallContext~*, state: raw EngineState~*, entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>, key: string) -> usize? {
        unsafe {
            if tags := state->Tags(entity) {
                if index := tags->PropertyIndex(key) {
                    return index;
                }
            }
        }
        message: string! = `the entity has no property '${key}'`;
        NotFound(context, message);
        delete message;
        return null;
    }

    /**
     * The value of an entity's property, failing the call when it has none.
     */
    PropertyValueOf :: (context: lantern:::nyx:::CallContext~*, state: raw EngineState~*, entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>, key: string) -> lantern:::world:::PropertyValue? {
        guard index := PropertyIndexOf(context, state, entity, key) return null;
        unsafe {
            guard tags := state->Tags(entity) return null;
            return tags->propertyValues[index];
        }
    }

    /**
     * Fails the call when a property is a different kind from the one asked for (a number read as text, say).
     */
    WrongPropertyKind :: (context: lantern:::nyx:::CallContext~*, key: string, expected: string) -> void {
        message: string! = `the property '${key}' is not ${expected}`;
        NotFound(context, message);
        delete message;
    }

    /**
     * Adds `Find`, `FindByKind`, `Kind`, `HasProperty` and the property readers (`NumberProperty`, `TextProperty`,
     * `VectorProperty`) to `lantern:::world`.
     */
    RegisterWorldEntityQueries :: (worldNamespace: HostNamespace~*, state: raw EngineState~*, math: MathTypes) -> void {
        worldNamespace->Function("Find", "(name: string) -> i64", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            name: string! = context->Text(0);
            defer delete name;
            if Stopped(context) {
                return;
            }
            unsafe {
                if entity := state->entityWorld->FindByName(name) {
                    context->ReturnI64(EntityToScript(entity));
                    return;
                }
            }
            message: string! = `no entity named '${name}'`;
            NotFound(context, message);
            delete message;
        });
        worldNamespace->Function("FindByKind", "(kind: string) -> Array<i64>", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            wanted: string! = context->Text(0);
            defer delete wanted;
            if Stopped(context) {
                return;
            }
            found~ Array<i64>! = [];
            unsafe {
                ids: Array<lantern:::core:::Handle<lantern:::engine:::EntityTag>>! = state->entityWorld->Ids();
                for id in ids {
                    if tags := state->Tags(id) {
                        if tags->kind == wanted {
                            found.push(EntityToScript(id));
                        }
                    }
                }
                delete ids;
            }
            context->ReturnI64Array(found);
            delete found;
        });
        worldNamespace->Function("Kind", "(entity: i64) -> string", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            unsafe {
                if tags := state->Tags(entity) {
                    context->ReturnText(tags->kind);
                    return;
                }
            }
            context->ReturnText("");
        });
        worldNamespace->Function("HasProperty", "(entity: i64, key: string) -> bool", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            key: string! = context->Text(1);
            defer delete key;
            if Stopped(context) {
                return;
            }
            has~ bool = false;
            unsafe {
                if tags := state->Tags(entity) {
                    has = tags->PropertyIndex(key) != null;
                }
            }
            context->ReturnBool(has);
        });
        worldNamespace->Function("NumberProperty", "(entity: i64, key: string) -> f32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            key: string! = context->Text(1);
            defer delete key;
            if Stopped(context) {
                return;
            }
            guard value := PropertyValueOf(context, state, entity, key) return;
            when value.kind {
                lantern:::world:::PropertyKind:::Number -> context->ReturnF32(value.number),
                override -> WrongPropertyKind(context, key, "a number"),
            }
        });
        worldNamespace->Function("TextProperty", "(entity: i64, key: string) -> string", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            key: string! = context->Text(1);
            defer delete key;
            if Stopped(context) {
                return;
            }
            guard index := PropertyIndexOf(context, state, entity, key) return;
            unsafe {
                guard tags := state->Tags(entity) return;
                when tags->propertyValues[index].kind {
                    lantern:::world:::PropertyKind:::Text -> context->ReturnText(tags->propertyTexts[index]),
                    override -> WrongPropertyKind(context, key, "text"),
                }
            }
        });
        worldNamespace->Function("VectorProperty", "(entity: i64, key: string) -> lantern:::math:::Vec3", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            guard entity := LiveEntity(context, state, 0) return;
            key: string! = context->Text(1);
            defer delete key;
            if Stopped(context) {
                return;
            }
            guard value := PropertyValueOf(context, state, entity, key) return;
            when value.kind {
                lantern:::world:::PropertyKind:::Vector -> ReturnVec3(context, math, value.vector),
                override -> WrongPropertyKind(context, key, "a vector"),
            }
        });
    }

    /**
     * Adds the functions that change how an entity looks (`SetMaterial`, `SetMesh`, `SetTexturedMesh`, `SetNormalMap`,
     * `SetTint`, `SetSurface`, `SetGlow`, `SetCastsShadows`).
     */
    RegisterWorldEntityLooks :: (worldNamespace: HostNamespace~*, state: raw EngineState~*) -> void {
        worldNamespace->Function("SetMaterial", "(material: string, texture: i64) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            material: string! = context->Text(0);
            defer delete material;
            texture: i64 = context->I64(1);
            if Stopped(context) {
                return;
            }
            unsafe {
                state->SetMaterial(material, HandleFromScript<lantern:::renderer:::TextureTag>(texture));
            }
        });
        worldNamespace->Function("SetMaterialLook", "(material: string, texture: i64, tint: string, metallic: f32, roughness: f32, emissive: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            material: string! = context->Text(0);
            defer delete material;
            texture: i64 = context->I64(1);
            tint: lantern:::core:::Color = ColorArgument(context, 2);
            metallic: f32 = context->F32(3);
            roughness: f32 = context->F32(4);
            emissive: lantern:::core:::Color = ColorArgument(context, 5);
            if Stopped(context) {
                return;
            }
            look~ lantern:::renderer:::MaterialLook = lantern:::renderer:::MaterialLook { };
            look.tint = tint;
            look.material.metallic = metallic;
            look.material.roughness = roughness;
            look.material.emissive = emissive;
            unsafe {
                if texture != 0 {
                    state->SetMaterial(material, HandleFromScript<lantern:::renderer:::TextureTag>(texture));
                }
                state->SetMaterialLook(material, look);
            }
        });
        worldNamespace->Function("SetMaterialShader", "(material: string, folder: string, shader: string, texture0: i64, texture1: i64, texture2: i64, texture3: i64, parameters: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            material: string! = context->Text(0);
            defer delete material;
            folder: string! = AssetPathArgument(context, state, 1);
            defer delete folder;
            shaderName: string! = context->Text(2);
            defer delete shaderName;
            source~ lantern:::renderer:::MaterialShaderSource = lantern:::renderer:::MaterialShaderSource { name: shaderName, directory: folder };
            for slot~ usize = 0; slot < 4; slot++ {
                texture: i64 = context->I64(3 + slot);
                if texture != 0 {
                    unsafe {
                        source.textures[usize(source.textureCount)] = HandleFromScript<lantern:::renderer:::TextureTag>(texture);
                    }
                    source.textureCount += 1;
                }
            }
            parameterText: string! = context->Text(7);
            defer delete parameterText;
            if Stopped(context) {
                return;
            }
            parameterNames~ Array<string!>! = ParseShaderParameters(parameterText, source);
            defer parameterNames.freeAll();
            unsafe {
                when state->renderBackend->CreateMaterialShader(source) {
                    Result:::Ok(handle) -> {
                        state->scriptMaterialShaders.push(handle);
                        state->SetMaterialShader(material, handle);
                        for slot~ usize = 0; slot < parameterNames.length(); slot++ {
                            state->AddShaderParameter(material, parameterNames[slot], u32(slot));
                        }
                    },
                    Result:::Err(message) -> {
                        warning: string! = `material '${material}': ${message}; it keeps its plain look`;
                        lantern:::core:::LogWarn("world", warning);
                        delete warning;
                        delete message;
                    }
                }
            }
        });
        worldNamespace->Function("SetMaterialParameter", "(material: string, name: string, value: f32) -> bool", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            material: string! = context->Text(0);
            defer delete material;
            parameterName: string! = context->Text(1);
            defer delete parameterName;
            value: f32 = context->F32(2);
            if Stopped(context) {
                return;
            }
            changed~ bool = false;
            unsafe {
                if slot := state->ShaderParameterSlot(material, parameterName) {
                    if look := state->LookOf(material) {
                        if shader := look.shader {
                            state->renderBackend->SetMaterialShaderParameter(shader, slot, value);
                            changed = true;
                        }
                    }
                }
            }
            context->ReturnBool(changed);
        });
        worldNamespace->Function("SetMesh", "(entity: i64, mesh: i64, tint: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            mesh: i64 = context->I64(1);
            tint: lantern:::core:::Color = ColorArgument(context, 2);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                record->meshRenderer = lantern:::engine:::MeshRenderer:::Create(HandleFromScript<lantern:::renderer:::MeshTag>(mesh), null, tint);
            }
        });
        worldNamespace->Function("SetTexturedMesh", "(entity: i64, mesh: i64, texture: i64, tint: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            mesh: i64 = context->I64(1);
            texture: i64 = context->I64(2);
            tint: lantern:::core:::Color = ColorArgument(context, 3);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                record->meshRenderer = lantern:::engine:::MeshRenderer:::Create(HandleFromScript<lantern:::renderer:::MeshTag>(mesh), HandleFromScript<lantern:::renderer:::TextureTag>(texture), tint);
            }
        });
        worldNamespace->Function("SetNormalMap", "(entity: i64, texture: i64, strength: f32) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            texture: i64 = context->I64(1);
            strength: f32 = context->F32(2);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                guard current := record->meshRenderer return;
                updated~ lantern:::engine:::MeshRenderer = current;
                updated.normalTexture = HandleFromScript<lantern:::renderer:::TextureTag>(texture);
                updated.material.normalStrength = Math:::clamp(strength, 0.0f, 4.0f);
                record->meshRenderer = updated;
            }
        });
        worldNamespace->Function("SetTint", "(entity: i64, tint: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            tint: lantern:::core:::Color = ColorArgument(context, 1);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                guard current := record->meshRenderer return;
                updated~ lantern:::engine:::MeshRenderer = current;
                updated.color = tint;
                record->meshRenderer = updated;
            }
        });
        worldNamespace->Function("SetSurface", "(entity: i64, metallic: f32, roughness: f32, emissive: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            metallic: f32 = context->F32(1);
            roughness: f32 = context->F32(2);
            emissive: lantern:::core:::Color = ColorArgument(context, 3);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                guard current := record->meshRenderer return;
                updated~ lantern:::engine:::MeshRenderer = current;
                updated.material = lantern:::renderer:::Material { metallic: metallic, roughness: roughness, emissive: emissive, normalStrength: current.material.normalStrength, wetness: current.material.wetness, puddles: current.material.puddles };
                record->meshRenderer = updated;
            }
        });
        worldNamespace->Function("SetWetness", "(entity: i64, wetness: f32, puddles: f32) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            wetness: f32 = context->F32(1);
            puddles: f32 = context->F32(2);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                guard current := record->meshRenderer return;
                updated~ lantern:::engine:::MeshRenderer = current;
                updated.material.wetness = Math:::clamp(wetness, 0.0f, 1.0f);
                updated.material.puddles = Math:::clamp(puddles, 0.0f, 1.0f);
                record->meshRenderer = updated;
            }
        });
        worldNamespace->Function("SetGlow", "(entity: i64, color: string, strength: f32) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            color: lantern:::core:::Color = ColorArgument(context, 1);
            strength: f32 = context->F32(2);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                guard current := record->meshRenderer return;
                updated~ lantern:::engine:::MeshRenderer = current;
                updated.material.emissive = Strengthened(color, strength);
                record->meshRenderer = updated;
            }
        });
        worldNamespace->Function("SetCastsShadows", "(entity: i64, castsShadows: bool) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            castsShadows: bool = context->Bool(1);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                guard current := record->meshRenderer return;
                updated~ lantern:::engine:::MeshRenderer = current;
                updated.castsShadows = castsShadows;
                record->meshRenderer = updated;
            }
        });
    }

    /**
     * Adds `IsVisible` and `SetVisible`.
     */
    RegisterWorldEntityVisibility :: (worldNamespace: HostNamespace~*, state: raw EngineState~*) -> void {
        worldNamespace->Function("IsVisible", "(entity: i64) -> bool", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            shown~ bool = true;
            unsafe {
                if record := state->entityWorld->Get(entity) {
                    if meshRenderer := record.meshRenderer {
                        shown = meshRenderer.visible;
                    }
                }
            }
            context->ReturnBool(shown);
        });
        worldNamespace->Function("SetVisible", "(entity: i64, visible: bool) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            shown: bool = context->Bool(1);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                guard current := record->meshRenderer return;
                updated~ lantern:::engine:::MeshRenderer = current;
                updated.visible = shown;
                record->meshRenderer = updated;
            }
        });
    }

    /**
     * Adds the functions that move an entity (`SetParent`, `Position`, `WorldPosition`, `InterpolatedPosition`,
     * `SetPosition`, `Teleport`, `SetYaw`, `SetScale`).
     */
    RegisterWorldEntityTransforms :: (worldNamespace: HostNamespace~*, state: raw EngineState~*, math: MathTypes) -> void {
        worldNamespace->Function("SetParent", "(child: i64, parent: i64) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard child := LiveEntity(context, state, 0) return;
            guard parent := LiveEntity(context, state, 1) return;
            unsafe {
                change: lantern:::engine:::ParentChange = state->entityWorld->SetParent(child, parent);
                if problem := ParentChangeProblem(change) {
                    message: string! = `cannot parent: ${problem}`;
                    Invalid(context, message);
                    delete message;
                }
            }
        });
        worldNamespace->Function("Position", "(entity: i64) -> lantern:::math:::Vec3", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            guard entity := LiveEntity(context, state, 0) return;
            position~ Vec3 = Vec3 { };
            unsafe {
                if record := state->entityWorld->Get(entity) {
                    position = record.local.translation;
                }
            }
            ReturnVec3(context, math, position);
        });
        worldNamespace->Function("WorldPosition", "(entity: i64) -> lantern:::math:::Vec3", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            guard entity := LiveEntity(context, state, 0) return;
            position~ Vec3 = Vec3 { };
            unsafe {
                if record := state->entityWorld->Get(entity) {
                    position = record.WorldPosition();
                }
            }
            ReturnVec3(context, math, position);
        });
        worldNamespace->Function("InterpolatedPosition", "(entity: i64, alpha: f32) -> lantern:::math:::Vec3", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            guard entity := LiveEntity(context, state, 0) return;
            alpha: f32 = context->F32(1);
            if Stopped(context) {
                return;
            }
            position~ Vec3 = Vec3 { };
            unsafe {
                if record := state->entityWorld->Get(entity) {
                    position = lantern:::core:::MatrixColumn3(record.InterpolatedWorld(alpha), 3);
                }
            }
            ReturnVec3(context, math, position);
        });
        worldNamespace->Function("SetPosition", "(entity: i64, position: lantern:::math:::Vec3) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            position: Vec3 = Vec3Argument(context, 1, math);
            guard entity := LiveEntity(context, state, 0) return;
            MoveEntity(state, entity, position);
        });
        worldNamespace->Function("Teleport", "(entity: i64, position: lantern:::math:::Vec3) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            position: Vec3 = Vec3Argument(context, 1, math);
            guard entity := LiveEntity(context, state, 0) return;
            MoveEntity(state, entity, position);
            unsafe {
                state->entityWorld->Teleport(entity, position);
            }
        });
        worldNamespace->Function("Yaw", "(entity: i64) -> f32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            yaw~ f32 = 0.0f;
            unsafe {
                if record := state->entityWorld->Get(entity) {
                    facing: Vec3 = lantern:::core:::RotateVector(record.local.rotation, Vec3 { x: 0.0f, y: 0.0f, z: -1.0f });
                    yaw = Math:::atan2(-facing.x, -facing.z);
                }
            }
            context->ReturnF32(yaw);
        });
        worldNamespace->Function("SetYaw", "(entity: i64, yaw: f32) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            yaw: f32 = context->F32(1);
            if Stopped(context) {
                return;
            }
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                record->local.rotation = lantern:::core:::QuaternionFromRotationY(yaw);
            }
        });
        worldNamespace->Function("SetScale", "(entity: i64, scale: lantern:::math:::Vec3) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            scale: Vec3 = Vec3Argument(context, 1, math);
            guard entity := LiveEntity(context, state, 0) return;
            unsafe {
                guard record ~= state->entityWorld->BorrowMutable(entity) return;
                record->local.scale = scale;
            }
        });
    }

    /**
     * Adds the functions that stream a level's rooms (`LoadAllRooms`, `AddStreamFocus`, `StreamRooms` and the counts).
     */
    RegisterRoomStreaming :: (worldNamespace: HostNamespace~*, state: raw EngineState~*, math: MathTypes) -> void {
        worldNamespace->Function("RoomCount", "() -> i32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                context->ReturnI32(i32(state->streaming->rooms.length()));
            }
        });
        worldNamespace->Function("LoadedRoomCount", "() -> i32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                context->ReturnI32(state->streaming->CompleteCount());
            }
        });
        worldNamespace->Function("RoomIsLoaded", "(name: string) -> bool", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            name: string! = context->Text(0);
            defer delete name;
            if Stopped(context) {
                return;
            }
            loaded~ bool = false;
            unsafe {
                if index := state->streaming->IndexOf(name) {
                    loaded = state->streaming->rooms[index]->IsComplete();
                }
            }
            context->ReturnBool(loaded);
        });
        worldNamespace->Function("LoadAllRooms", "() -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            LoadAllRoomsOf(state);
        });
        worldNamespace->Function("AddStreamFocus", "(point: lantern:::math:::Vec3) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            point: Vec3 = Vec3Argument(context, 0, math);
            if Stopped(context) {
                return;
            }
            AddStreamFocusTo(state, point);
        });
        worldNamespace->Function("StreamRooms", "(loadDistance: f32, unloadDistance: f32, urgentDistance: f32, budget: i32) -> i32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            loadDistance: f32 = context->F32(0);
            unloadDistance: f32 = context->F32(1);
            urgentDistance: f32 = context->F32(2);
            budget: i32 = context->I32(3);
            if Stopped(context) {
                return;
            }
            context->ReturnI32(StreamRoomsOf(state, loadDistance, unloadDistance, urgentDistance, budget));
        });
        worldNamespace->Function("LiveEntityCount", "() -> i32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                context->ReturnI32(i32(state->entityWorld->Length()));
            }
        });
        worldNamespace->Function("CollisionTriangleCount", "() -> i32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                context->ReturnI32(i32(state->collision->StaticTriangleCount()));
            }
        });
    }

    /**
     * Registers `lantern:::world`: `Load` a level file, `Clear` it, `Spawn` and `Despawn` single entities, plus the groups
     * above. See game-api.md for each function's arguments.
     */
    RegisterWorldApi :: (runtime: lantern:::nyx:::Runtime~*, state: raw EngineState~*, math: MathTypes) -> lantern:::nyx:::NyxError*!? {
        worldNamespace := new HostNamespace(runtime, "lantern::world");
        worldNamespace->Function("Load", "(path: string) -> i32", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            path: string! = AssetPathArgument(context, state, 0);
            defer delete path;
            if Stopped(context) {
                return;
            }
            loaded := lantern:::world:::Load(path);
            when loaded! {
                Result:::Ok(worldFile) -> {
                    directory: string! = lantern:::world:::DirectoryOf(path);
                    defer delete directory;
                    expanded := lantern:::world:::ExpandScenes(worldFile, directory);
                    when expanded! {
                        Result:::Ok(links) -> {
                            problems~ Array<string!>! = worldFile->Validate();
                            for problem in problems {
                                warning: string! = `${path}: ${problem}`;
                                lantern:::core:::LogWarn("world", warning);
                                delete warning;
                            }
                            problems.freeAll();
                            sceneLinks~ Array<SceneLink*!>! = links!;
                            spawned := LoadWorldFile(state, worldFile!);
                            when spawned! {
                                Result:::Ok(count) -> {
                                    KeepSceneLinks(state, sceneLinks!);
                                    report: string! = `loaded ${path}: ${count} entities`;
                                    lantern:::core:::LogInfo("world", report);
                                    delete report;
                                    context->ReturnI32(i32(count));
                                },
                                Result:::Err(message) -> {
                                    sceneLinks.freeAll();
                                    Invalid(context, message);
                                    delete message;
                                }
                            }
                        },
                        Result:::Err(message) -> {
                            delete worldFile;
                            Invalid(context, message);
                            delete message;
                        }
                    }
                },
                Result:::Err(message) -> {
                    NotFound(context, message);
                    delete message;
                }
            }
        });
        worldNamespace->Function("Clear", "() -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            unsafe {
                state->ClearWorld();
            }
        });
        RegisterRoomStreaming(worldNamespace, state, math);
        worldNamespace->Function("Spawn", "(name: string, position: lantern:::math:::Vec3) -> i64", new (context: lantern:::nyx:::CallContext~*) -> void [state, math] {
            name: string! = context->Text(0);
            defer delete name;
            position: Vec3 = Vec3Argument(context, 1, math);
            if Stopped(context) {
                return;
            }
            unsafe {
                entity: lantern:::core:::Handle<lantern:::engine:::EntityTag> = state->entityWorld->Spawn(name, GameScene(), lantern:::engine:::Transform:::FromTranslation(position));
                context->ReturnI64(EntityToScript(entity));
            }
        });
        worldNamespace->Function("Despawn", "(entity: i64) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [state] {
            guard entity := LiveEntity(context, state, 0) return;
            unsafe {
                state->entityWorld->Despawn(entity);
                state->RemoveTags(entity);
            }
        });
        RegisterWorldEntityQueries(worldNamespace, state, math);
        RegisterWorldEntityLooks(worldNamespace, state);
        RegisterWorldEntityTransforms(worldNamespace, state, math);
        RegisterWorldEntityVisibility(worldNamespace, state);
        failure := worldNamespace->Finish();
        delete worldNamespace;
        return failure!;
    }
}
