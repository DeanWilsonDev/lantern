lantern:::host :: namespace {
    RegisterEngineApis :: (runtime: lantern:::nyx:::Runtime~*, state: raw EngineState~*, math: MathTypes~*) -> lantern:::nyx:::NyxError*!? {
        failure~ lantern:::nyx:::NyxError*!? = RegisterMathApi(runtime, math);
        failure = FirstFailure(failure!, RegisterEngineApi(runtime, state));
        failure = FirstFailure(failure!, RegisterInputApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterRenderingApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterAudioApi(runtime, state));
        failure = FirstFailure(failure!, RegisterOverlayApi(runtime, state));
        return failure!;
    }
}
