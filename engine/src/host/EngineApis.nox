lantern:::host :: namespace {
    /**
     * Registers everything a game script can call. Each `Register...Api` adds one namespace (`lantern:::world`, `lantern:::input`,
     * `lantern:::graphics` and so on, listed in game-api.md), and the first error from any is returned. The result is checked
     * against `games/platformer/engine-host-surface.json` by a test, so the list of functions can't change without the
     * file, and the docs, being updated.
     */
    RegisterEngineApis :: (runtime: lantern:::nyx:::Runtime~*, state: raw EngineState~*, math: MathTypes~*, ui: raw GameUiState~*) -> lantern:::nyx:::NyxError*!? {
        failure~ lantern:::nyx:::NyxError*!? = RegisterMathApi(runtime, math);
        failure = FirstFailure(failure!, RegisterEngineApi(runtime, state));
        failure = FirstFailure(failure!, RegisterInputApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterWorldApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterAssetsApi(runtime, state));
        failure = FirstFailure(failure!, RegisterPhysicsApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterNavigationApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterRenderingApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterLightsApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterGraphicsApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterSkyApi(runtime, state));
        failure = FirstFailure(failure!, RegisterAtmosphereApi(runtime, state));
        failure = FirstFailure(failure!, RegisterParticlesApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterAnimationApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterAudioApi(runtime, state, math^*));
        failure = FirstFailure(failure!, RegisterOverlayApi(runtime, state));
        failure = FirstFailure(failure!, RegisterGameUiApi(runtime, ui));
        failure = FirstFailure(failure!, RegisterDebugApi(runtime, state, math^*));
        return failure!;
    }
}
