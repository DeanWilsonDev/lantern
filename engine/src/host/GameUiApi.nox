lantern:::host :: namespace {
    CHAOS_MISSING_MESSAGE: string : "GameUi isn't available: Chaos didn't start";

    RegisterGameUiApi :: (runtime: lantern:::nyx:::Runtime~*) -> lantern:::nyx:::NyxError*!? {
        ui := new HostNamespace(runtime, "lantern::ui");
        ui->Function("Mount", "(file: string, component: string) -> i32", new (context: lantern:::nyx:::CallContext~*) -> void {
            Invalid(context, CHAOS_MISSING_MESSAGE);
        });
        ui->Function("Unmount", "(mount: i32) -> void", new (context: lantern:::nyx:::CallContext~*) -> void {
            mount: i32 = context->I32(0);
            if Stopped(context) {
                return;
            }
            message: string! = `lantern:::ui:::Unmount: nothing is mounted as ${mount}`;
            Invalid(context, message);
            delete message;
        });
        ui->Function("SetNavigation", "(previous: string, next: string, confirm: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void { });
        failure := ui->Finish();
        delete ui;
        return failure!;
    }
}
