lantern:::host :: namespace {
    /**
     * The error a UI function gives when Chaos didn't start, so a game without UI files still runs.
     */
    CHAOS_MISSING_MESSAGE: string : "GameUi isn't available: Chaos didn't start";
    /**
     * The error for mounting UI before the game's application exists.
     */
    APPLICATION_MISSING_MESSAGE: string : "lantern:::ui:::Mount needs the game to be loaded; call it from OnStart";

    /**
     * The names of the game's actions for moving through the UI: previous, next and confirm. A game picks them with
     * `lantern:::ui:::SetNavigation`, so the menu reads the game's own bindings.
     */
    NavigationActions :: class {
    public:
        previous~ string!;
        next~ string!;
        confirm~ string!;

        NavigationActions~: (previousAction: string!, nextAction: string!, confirmAction: string!) {
            previous = previousAction!;
            next = nextAction!;
            confirm = confirmAction!;
        }

        !NavigationActions~: () {
            delete previous;
            delete next;
            delete confirm;
        }
    }

    /**
     * What the `lantern:::ui` functions share: the running Chaos UI, the game's application object (handed to a mounted
     * component so its handlers can call back into the game), and the navigation action names.
     */
    GameUiState :: class {
    public:
        chaos~ lantern:::chaosui:::ChaosUi*!? = null;
        applicationValue~ lantern:::nyx:::Value*!? = null;
        navigation~ NavigationActions*!? = null;

        GameUiState~: () { }

        !GameUiState~: () {
            Release();
        }

        /**
         * Frees the UI, the application value and the navigation names. The UI goes first, so Chaos is gone before the
         * runtime it uses.
         */
        Release~: () -> void {
            delete chaos;
            chaos = null;
            delete applicationValue;
            applicationValue = null;
            delete navigation;
            navigation = null;
        }
    }

    /**
     * Mounts a component with the game's application as its argument, failing the call with Chaos's messages when it
     * can't.
     */
    MountOnChaos :: (context: lantern:::nyx:::CallContext~*, ui: raw GameUiState~*, file: string, component: string) -> void {
        unsafe {
            if ui->chaos == null {
                Invalid(context, CHAOS_MISSING_MESSAGE);
                return;
            }
            if ui->applicationValue == null {
                Invalid(context, APPLICATION_MISSING_MESSAGE);
                return;
            }
            guard chaos ~= ui->chaos return;
            guard applicationValue := ui->applicationValue return;
            arguments~ Array<lantern:::nyx:::Value*>! = [];
            arguments.push(applicationValue);
            mounted := chaos->Mount(file, component, arguments);
            when mounted! {
                Result:::Ok(number) -> {
                    context->ReturnI32(i32(number));
                },
                Result:::Err(message) -> {
                    Invalid(context, message);
                    delete message;
                }
            }
            delete arguments;
        }
    }

    /**
     * Registers the `lantern:::ui` functions: `Mount`, `Unmount` and `SetNavigation`. See
     * game-api.md.
     */
    RegisterGameUiApi :: (runtime: lantern:::nyx:::Runtime~*, ui: raw GameUiState~*) -> lantern:::nyx:::NyxError*!? {
        uiNamespace := new HostNamespace(runtime, "lantern::ui");
        uiNamespace->Function("Mount", "(file: string, component: string) -> i32", new (context: lantern:::nyx:::CallContext~*) -> void [ui] {
            file: string! = context->Text(0);
            component: string! = context->Text(1);
            if !Stopped(context) {
                MountOnChaos(context, ui, file, component);
            }
            delete file;
            delete component;
        });
        uiNamespace->Function("Unmount", "(mount: i32) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [ui] {
            mount: i32 = context->I32(0);
            if Stopped(context) {
                return;
            }
            removed~ bool = false;
            unsafe {
                if chaos ~= ui->chaos {
                    if mount >= 0 {
                        removed = chaos->Unmount(u32(mount));
                    }
                }
            }
            if !removed {
                message: string! = `lantern:::ui:::Unmount: nothing is mounted as ${mount}`;
                Invalid(context, message);
                delete message;
            }
        });
        uiNamespace->Function("SetNavigation", "(previous: string, next: string, confirm: string) -> void", new (context: lantern:::nyx:::CallContext~*) -> void [ui] {
            previous: string! = context->Text(0);
            next: string! = context->Text(1);
            confirm: string! = context->Text(2);
            if Stopped(context) {
                delete previous;
                delete next;
                delete confirm;
                return;
            }
            unsafe {
                delete ui->navigation;
                ui->navigation = new NavigationActions(previous!, next!, confirm!);
            }
        });
        failure := uiNamespace->Finish();
        delete uiNamespace;
        return failure!;
    }
}
