lantern:::host :: namespace {
    /**
     * The first line of the on-screen script error panel.
     */
    SCRIPT_ERROR_HEADING: string : "script error (F1 for details, F5 to reload):";
    /**
     * How many lines of the error message the panel shows below its heading.
     */
    SCRIPT_ERROR_LINES: usize : 4;
    /**
     * The colour of the panel's text, as a 0xRRGGBB number (a light red).
     */
    SCRIPT_ERROR_COLOR: u32 : 16737872;

    /**
     * How many bytes the first `codePoints` characters of a UTF-8 string take, so a long line can be cut between
     * characters and not through one.
     */
    ByteLengthOfCodePoints :: (text: string, codePoints: usize) -> usize {
        seen~ usize = 0;
        for index~ usize = 0; index < text.length(); index++ {
            byte: u8 = text.byteAt(index);
            if byte < 128 || byte >= 192 {
                if seen == codePoints {
                    return index;
                }
                seen++;
            }
        }
        return text.length();
    }

    /**
     * The mouse state the game's UI needs: where it is, and whether the left button went down or up since the last
     * frame or is held.
     */
    MouseForUi :: struct {
        position~ Vec2? = null;
        leftWentDown~ bool = false;
        leftWentUp~ bool = false;
        leftHeld~ bool = false;
    }

    /**
     * Something the game host asks every frame whether the game's scripts should reload.
     */
    ReloadSource :: interface {
        Poll~ (frameSeconds: f32) -> bool : 0;
    }

    /**
     * The `Game` that runs a Nyx game: it forwards each of the loop's hooks to the game's script (`OnFixedUpdate`,
     * `OnUpdate`, `OnRender`) and does the engine's own work around each call.
     */
    GameHost :: class {
        implements:
            lantern:::engine:::Game;
    public:
        session~ ScriptSession*!? = null;
        state~ EngineState*!;
        source~ ScriptSource*!;
        scriptError~ string!? = null;
        scriptErrorCount~ u32 = 0;
        lastFrameReport~ lantern:::renderer:::RenderReport = lantern:::renderer:::RenderReport { };
        frames~ u64 = 0;
        maxFrames~ u64? = null;
        capturePath~ string!? = null;
        quit~ bool = false;
        mouseCaptured~ bool = false;
        mouseCapturedNow~ bool = false;
        pixelsPerPoint~ f32 = 1.0f;
        mouse~ MouseForUi = MouseForUi { };
        contentWatcher~ ReloadSource*!? = null;

        GameHost~: (engineState: EngineState*!, scriptSource: ScriptSource*!) {
            state = engineState!;
            source = scriptSource!;
            StartSession();
        }

        !GameHost~: () {
            delete session;
            delete state;
            delete source;
            delete scriptError;
            delete capturePath;
            delete contentWatcher;
        }

        /**
         * A raw pointer to the engine state, for the registered host functions, which hold it for as long as the script
         * runs.
         */
        StatePointer~: () -> raw EngineState~* {
            unsafe {
                pointer: raw EngineState~* = state;
                return pointer;
            }
        }

        /**
         * True while a script session is loaded. After a failed load it is false and the screen shows the error.
         */
        IsRunningScript :: () -> bool {
            return session != null;
        }

        /**
         * How many script errors there have been, which the debug HUD shows.
         */
        ScriptErrorCount :: () -> u32 {
            return scriptErrorCount;
        }

        /**
         * Records a script error: counts it, logs it once (the same message twice in a row isn't logged again) and keeps it
         * to draw on screen until the next reload.
         */
        ReportError~: (message: string) -> void {
            scriptErrorCount += 1;
            if current := scriptError {
                if current == message {
                    return;
                }
            }
            lantern:::core:::LogError("script", message);
            lantern:::graphs:::WriteErrorForEditor(message);
            delete scriptError;
            scriptError = `${message}`;
        }

        /**
         * Calls a hook on the script, if one is loaded, and reports an error it raises. A script error never stops the
         * engine; the loop keeps running and the panel shows the message.
         */
        Call~: (hook: GameHook, arguments: Array<f32>) -> void {
            guard running ~= session return;
            timer: u64 = state->debugWindow->budget->Start();
            failure: string!? = running->Call(hook, arguments);
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_SCRIPTING, timer);
            if text := failure {
                ReportError(text);
            }
            delete failure;
        }

        /**
         * Starts the game's script: resets the engine state, loads the script, calls `OnStart` and runs a first UI update. A
         * load failure is reported on screen instead of crashing, so the game can be edited and reloaded with F5.
         */
        StartSession~: () -> void {
            state->ResetForNewSession();
            engineState: raw EngineState~* = StatePointer();
            loaded := ScriptSession:::Load(source->scriptsDirectory, source->entryFile, source->applicationClass, engineState);
            when loaded! {
                Result:::Ok(started) -> {
                    message: string! = `game: ${started->EntryPath()}`;
                    lantern:::core:::LogInfo("script", message);
                    delete message;
                    delete session;
                    session = started!;
                    delete scriptError;
                    scriptError = null;
                    noArguments: Array<f32>! = [];
                    Call(GameHook:::OnStart, noArguments);
                    delete noArguments;
                    if running ~= session {
                        running->UpdateUi();
                    }
                    ReportUiMessages();
                },
                Result:::Err(error) -> {
                    message~ string! = OwnedText("the game failed to load (F5 retries):");
                    message += "\n";
                    message += error;
                    ReportError(message);
                    delete message;
                    delete error;
                }
            }
        }

        /**
         * True when the action with this name went down this frame.
         */
        ActionPressed :: (name: string) -> bool {
            return state->input->Pressed(name) ?? false;
        }

        /**
         * Gives the game's UI this frame's input: the mouse (unless the game has captured it) and the game's own
         * previous, next and confirm actions.
         */
        NavigateUi~: () -> void {
            taken: MouseForUi = mouse;
            mouse = MouseForUi { position: taken.position, leftHeld: taken.leftHeld };
            uiNavigation~ lantern:::chaosui:::Navigation = lantern:::chaosui:::Navigation { };
            if position := taken.position {
                if !mouseCaptured {
                    uiNavigation.pointer = lantern:::chaosui:::Pointer {
                        position: Vec2 { x: position.x * pixelsPerPoint, y: position.y * pixelsPerPoint },
                        pressed: taken.leftWentDown,
                        released: taken.leftWentUp,
                        held: taken.leftHeld,
                    };
                }
            }
            guard running ~= session return;
            if actions := running->UiNavigationActions() {
                uiNavigation.previous = ActionPressed(actions->previous);
                uiNavigation.next = ActionPressed(actions->next);
                uiNavigation.confirm = ActionPressed(actions->confirm);
            }
            running->NavigateUi(uiNavigation);
            ReportUiMessages();
        }

        /**
         * Takes the messages Chaos reported. Style (`cosmos:`) messages are only logged as warnings; anything else is shown as a
         * script error.
         */
        ReportUiMessages~: () -> void {
            guard running ~= session return;
            messages~ Array<string!>! = running->TakeUiMessages();
            for message in messages {
                if message.startsWith("cosmos:") {
                    lantern:::core:::LogWarn("ui", message);
                } else {
                    reported: string! = `UI: ${message}`;
                    ReportError(reported);
                    delete reported;
                }
            }
            messages.freeAll();
        }

        /**
         * Calls `OnExit`, drops the script and resets the engine state.
         */
        Shutdown~: () -> void {
            noArguments: Array<f32>! = [];
            Call(GameHook:::OnExit, noArguments);
            delete noArguments;
            delete session;
            session = null;
            state->ResetForNewSession();
        }

        /**
         * Shuts the script down and starts it again from the files on disk (F5).
         */
        Reload~: () -> void {
            lantern:::core:::LogInfo("script", "reloading the game's scripts");
            Shutdown();
            StartSession();
        }

        /**
         * Publishes the engine's own debug HUD values: frame rate and times, fixed steps, script time and errors, renderer
         * draws and triangles, entity count and audio status. The "Errors/" group is removed when there is no error.
         */
        UpdateEngineDebugValues~: (frame: lantern:::engine:::FrameContext) -> void {
            PublishBudgetValues();
            scriptMilliseconds~ f64 = 0.0f;
            sourceText~ string! = "";
            if running ~= session {
                scriptMilliseconds = running->TakeScriptSeconds() * 1000.0f;
                sourceText += running->EntryPath();
            } else {
                sourceText += "(not loaded)";
            }
            driverName: string! = OwnedText(state->renderBackend->DriverName());
            defer delete driverName;
            errorText~ string!? = null;
            if error := scriptError {
                errorText = `${error}`;
            }
            defer delete errorText;
            values: lantern:::core:::DebugValues~* = state->debugValues;
            framesPerSecond: string! = lantern:::core:::FixedDecimals(frame.stats.FramesPerSecond(), 0, 0);
            values->SetText("Frame/FPS", framesPerSecond);
            delete framesPerSecond;
            values->SetNumber("Frame/Average ms", frame.stats.AverageFrameMilliseconds());
            values->SetNumber("Frame/Worst ms", frame.stats.WorstFrameMilliseconds());
            values->SetInteger("Frame/Fixed steps", i64(frame.plan.stepCount));
            values->SetNumber("Frame/Dropped s", frame.stats.droppedSecondsTotal);
            values->SetText("Script/Source", sourceText);
            delete sourceText;
            values->SetNumber("Script/ms this frame", scriptMilliseconds);
            values->SetInteger("Script/Errors", i64(scriptErrorCount));
            values->SetText("Renderer/Driver", driverName);
            values->SetInteger("Renderer/Draws", i64(lastFrameReport.drawsSubmitted));
            values->SetInteger("Renderer/Culled", i64(lastFrameReport.drawsCulled));
            values->SetInteger("Renderer/Triangles", BitsToScript(lastFrameReport.triangles));
            values->SetInteger("World/Entities", i64(state->entityWorld->Length()));
            audioStats: lantern:::engine:::AudioStats = state->audioSystemInstance->Stats();
            values->SetFlag("Audio/Device", audioStats.hasDevice);
            values->SetInteger("Audio/Voices", i64(audioStats.activeVoices));
            values->SetNumber("Audio/Queued ms", f64(audioStats.queuedMilliseconds));
            values->SetInteger("Audio/Underruns", i64(audioStats.underrunCount));
            busNames: Array<string>! = ["Music", "Ambience", "Effects", "Interface", "Master"];
            for bus~ usize = 0; bus < lantern:::audio:::BUS_COUNT; bus++ {
                busPath: string! = `Audio/Bus ${busNames[bus]}`;
                volumeText: string! = lantern:::core:::FixedDecimals(f64(state->audioSystemInstance->mixer->BusVolume(bus)), 2, 0);
                gainText: string! = lantern:::core:::FixedDecimals(f64(state->audioSystemInstance->mixer->BusGain(bus)), 2, 0);
                busText~ string! = `${volumeText} gain ${gainText}`;
                if state->audioSystemInstance->mixer->BusMuted(bus) {
                    delete busText;
                    busText = "muted" + "";
                }
                values->SetText(busPath, busText);
                delete busText;
                delete gainText;
                delete volumeText;
                delete busPath;
            }
            delete busNames;
            if error := errorText {
                values->SetText("Errors/Script", error);
            } else {
                values->RemovePrefix("Errors/");
            }
        }

        /**
         * Publishes the frame budget as `Budget/` values while the budget is recording, which gives the debug window its
         * Budget page, and removes them when it isn't: the latest frame, the average, the worst and the over-budget count,
         * then each phase as `this frame  avg  worst` in milliseconds.
         */
        PublishBudgetValues~: () -> void {
            values: lantern:::core:::DebugValues~* = state->debugValues;
            if !state->debugWindow->budget->recording {
                values->RemovePrefix("Budget/");
                return;
            }
            values->SetNumber("Budget/Frame ms", state->debugWindow->budget->FrameMillisecondsAgo(0));
            values->SetNumber("Budget/Average ms", state->debugWindow->budget->AverageFrameMilliseconds());
            values->SetNumber("Budget/Worst ms", state->debugWindow->budget->WorstFrameMilliseconds());
            values->SetInteger("Budget/Over in history", i64(state->debugWindow->budget->OverBudgetInHistory()));
            values->SetInteger("Budget/Over in total", i64(state->debugWindow->budget->overBudgetTotal));
            for phase~ usize = 0; phase < lantern:::core:::BUDGET_PHASE_COUNT; phase++ {
                latest: string! = lantern:::core:::FixedDecimals(state->debugWindow->budget->PhaseMillisecondsAgo(phase, 0), 2, 5);
                average: string! = lantern:::core:::FixedDecimals(state->debugWindow->budget->AveragePhaseMilliseconds(phase), 2, 5);
                worst: string! = lantern:::core:::FixedDecimals(state->debugWindow->budget->WorstPhaseMilliseconds(phase), 2, 5);
                phaseText: string! = `${latest} avg ${average} worst ${worst}`;
                phasePath: string! = `Budget/${lantern:::core:::BudgetPhaseName(phase)}`;
                values->SetText(phasePath, phaseText);
                delete phasePath;
                delete phaseText;
                delete worst;
                delete average;
                delete latest;
            }
        }

        /**
         * Draws the script error panel along the bottom of the screen: a dark band, a heading and the first few lines of the
         * message, cut to fit the width.
         */
        DrawScriptError~: (error: string) -> void {
            screen: Vec2 = state->screenSize;
            scale: f32 = state->uiScale;
            glyph: f32 = f32(lantern:::renderer:::GLYPH_SIZE) * scale;
            columns: usize = usize(Math:::max((screen.x - 16.0f * scale) / glyph, 8.0f));
            lines~ Array<string!>! = [];
            lines.push(OwnedText(SCRIPT_ERROR_HEADING));
            errorLines: Array<string>! = error.split("\n");
            for index~ usize = 0; index < errorLines.length() && index < SCRIPT_ERROR_LINES; index++ {
                line: string = errorLines[index].trimEnd();
                if line.codePointCount() > columns {
                    lines.push(`${line.substring(0, ByteLengthOfCodePoints(line, columns))}`);
                } else {
                    lines.push(`${line}`);
                }
            }
            delete errorLines;
            lineHeight: f32 = glyph * 1.3f;
            top: f32 = screen.y - lineHeight * f32(lines.length()) - 6.0f * scale;
            overlay: lantern:::renderer:::Overlay~* = state->renderWorld->overlay;
            overlay->Rect(Vec2 { x: 0.0f, y: top - 4.0f * scale }, screen, lantern:::core:::Color:::Rgba(0.0f, 0.0f, 0.0f, 0.7f));
            for index~ usize = 0; index < lines.length(); index++ {
                position := Vec2 { x: 8.0f * scale, y: top + lineHeight * f32(index) };
                overlay->Text(lines[index], position, scale, lantern:::core:::Color:::FromHex(SCRIPT_ERROR_COLOR));
            }
            lines.freeAll();
        }

        /**
         * Renders the frame to an image and saves it as a PNG. It is how `LANTERN_CAPTURE_PATH` makes a screenshot.
         */
        SaveCapture~: (path: string, frame: lantern:::engine:::FrameContext) -> void {
            engineState: raw EngineState~* = StatePointer();
            lastSlash~ usize? = null;
            for position~ usize = 0; position < path.length(); position++ {
                if path.byteAt(position) == u8(47) {
                    lastSlash = position;
                }
            }
            if slash := lastSlash {
                folder: string! = `${path.substring(0, slash)}`;
                when createDirectories(folder) {
                    Result:::Ok(created) -> { },
                    Result:::Err(error) -> { delete error; }
                }
                delete folder;
            }
            unsafe {
                captured := engineState->renderBackend->Capture(engineState->renderWorld, frame.window.pixelWidth, frame.window.pixelHeight);
                when captured! {
                    Result:::Ok(image) -> {
                        bytes: Array<u8>! = image->ToPngBytes();
                        if lantern:::core:::WriteBytes(path, bytes) {
                            message: string! = `saved capture to ${path}`;
                            lantern:::core:::LogInfo("renderer", message);
                            delete message;
                        } else {
                            message: string! = `saving capture to ${path} failed`;
                            lantern:::core:::LogError("renderer", message);
                            delete message;
                        }
                        delete bytes;
                        delete image;
                    },
                    Result:::Err(message) -> {
                        failure: string! = `capture failed: ${message}`;
                        lantern:::core:::LogError("renderer", failure);
                        delete failure;
                        delete message;
                    }
                }
            }
        }

        /**
         * Tracks the mouse for the game's UI: its position and left-button presses and releases; losing focus lets the
         * button go. Keys and gamepads reach the script through the input router's snapshots instead.
         */
        HandleEvent~: (event: lantern:::platform:::PlatformEvent, platformBackend: lantern:::platform:::PlatformBackend~*) -> void {
            when event <lantern:::platform:::PlatformEvent> {
                KeyDown(key, repeat) -> {
                    engineState: raw EngineState~* = StatePointer();
                    unsafe {
                        engineState->debugWindow->HandleKey(key, repeat, engineState->debugValues, engineState->debugPages);
                    }
                },
                KeyUp(key) -> {
                    state->debugWindow->HandleKeyUp(key);
                },
                MouseWheel(deltaY) -> {
                    if state->debugWindow->visible && state->debugWindow->focused {
                        state->debugWindow->ScrollWheel(deltaY);
                    }
                },
                MouseMoved(_, _, x, y) -> {
                    mouse.position = Vec2 { x: x, y: y };
                },
                MouseButtonDown(button, x, y) -> {
                    if button == lantern:::core:::MouseButton:::Left {
                        mouse.position = Vec2 { x: x, y: y };
                        pixelPoint: Vec2 = Vec2 { x: x * pixelsPerPoint, y: y * pixelsPerPoint };
                        engineState: raw EngineState~* = StatePointer();
                        consumed~ bool = false;
                        unsafe {
                            if !mouseCaptured || engineState->debugWindow->focused {
                                consumed = engineState->debugWindow->HandleClick(pixelPoint);
                            }
                        }
                        if consumed {
                            return;
                        }
                        mouse.leftWentDown = true;
                        mouse.leftHeld = true;
                    }
                },
                MouseButtonUp(button, x, y) -> {
                    if button == lantern:::core:::MouseButton:::Left {
                        mouse.position = Vec2 { x: x, y: y };
                        mouse.leftWentUp = true;
                        mouse.leftHeld = false;
                    }
                },
                FocusLost -> {
                    mouse.leftHeld = false;
                },
                default -> {},
            }
        }

        /**
         * One simulation step. Saves every entity's transform as its previous one (for interpolation), starts the
         * collision step, hands the step's input to the script, runs its `OnFixedUpdate`, then recomputes world
         * transforms from the entity hierarchy.
         */
        FixedUpdate~: (step: lantern:::engine:::FixedStepContext) -> void {
            if session == null {
                return;
            }
            beforeScript: u64 = state->debugWindow->budget->Start();
            state->entityWorld->StorePreviousTransforms();
            state->collision->BeginStep();
            if state->debugWindow->focused {
                state->input->SetSnapshot(new lantern:::core:::InputSnapshot());
            } else {
                state->input->SetSnapshot(step.input->Copy());
            }
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_UPDATE, beforeScript);
            stepArguments: Array<f32>! = [step.stepSeconds];
            Call(GameHook:::OnFixedUpdate, stepArguments);
            delete stepArguments;
            afterScript: u64 = state->debugWindow->budget->Start();
            state->entityWorld->UpdateWorldTransforms();
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_UPDATE, afterScript);
        }

        /**
         * Once per frame: updates the screen size and UI scale, handles the engine's own keys (reload, debug HUD), runs
         * the UI and the script's `OnUpdate`, publishes debug values and tops up the audio queue.
         */
        FrameUpdate~: (frame: lantern:::engine:::FrameContext, platformBackend: lantern:::platform:::PlatformBackend~*) -> void {
            state->debugWindow->budget->recording = state->debugWindow->visible;
            beforeScript: u64 = state->debugWindow->budget->Start();
            frames += 1;
            state->screenSize = Vec2 { x: f32(frame.window.pixelWidth), y: f32(frame.window.pixelHeight) };
            state->uiScale = lantern:::renderer:::ScaleForDensity(2, frame.window.pixelDensity);
            if frame.window.logicalWidth > 0 && frame.window.pixelWidth > 0 {
                pixelsPerPoint = f32(frame.window.pixelWidth) / f32(frame.window.logicalWidth);
            }
            if state->debugWindow->focused {
                state->input->SetSnapshot(new lantern:::core:::InputSnapshot());
            } else {
                state->input->SetSnapshot(frame.input->Copy());
            }
            reload~ bool = frame.input->Pressed(EngineReloadAction());
            toggleHud: bool = frame.input->Pressed(EngineToggleHudAction());
            if toggleHud {
                state->debugWindow->Toggle();
            }
            if watcher ~= contentWatcher {
                if watcher->Poll(frame.frameSeconds) {
                    reload = true;
                }
            }
            if reload {
                Reload();
            }
            if state->debugWindow->focused {
                mouse = MouseForUi { position: mouse.position, leftHeld: mouse.leftHeld };
            } else {
                NavigateUi();
            }
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_UPDATE, beforeScript);
            frameArguments: Array<f32>! = [frame.frameSeconds];
            Call(GameHook:::OnUpdate, frameArguments);
            delete frameArguments;
            afterScript: u64 = state->debugWindow->budget->Start();
            if captured := state->requests.mouseCaptured {
                mouseCaptured = captured;
                state->requests.mouseCaptured = null;
            }
            wantsCapture: bool = mouseCaptured && !state->debugWindow->focused;
            if wantsCapture != mouseCapturedNow {
                platformBackend->SetMouseCaptured(wantsCapture);
                mouseCapturedNow = wantsCapture;
            }
            if state->requests.quit {
                state->requests.quit = false;
                quit = true;
            }
            if maximum := maxFrames {
                if frames >= maximum {
                    quit = true;
                }
            }
            UpdateEngineDebugValues(frame);
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_UPDATE, afterScript);
            audioTimer: u64 = state->debugWindow->budget->Start();
            state->audioSystemInstance->Update();
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_AUDIO, audioTimer);
        }

        /**
         * Fills the `RenderWorld` for this frame and renders it, in this order:
         *
         * 1. Clear last frame's draws, lines and overlay.
         * 2. The script's `OnRender` sets the camera, light and fog and may add its own draws, lines and text.
         * 3. The game's UI is laid out and drawn into the overlay.
         * 4. The animators advance by `frame.frameSeconds`, then `ExtractDraws` adds a draw for every visible entity, interpolated by
         *    `frame.alpha`, and the animation system adds the skinned draws of the animated ones.
         * 5. A script error, if any, and the debug HUD go on the overlay last, so they're on top.
         * 6. `RenderBackend.Render`. On the last frame, the frame is also captured if a capture path was set.
         */
        Render~: (frame: lantern:::engine:::FrameContext) -> void {
            state->renderWorld->Clear();
            renderArguments: Array<f32>! = [frame.alpha, frame.frameSeconds];
            Call(GameHook:::OnRender, renderArguments);
            delete renderArguments;
            particleTimer: u64 = state->debugWindow->budget->Start();
            unsafe {
                state->renderWorld->StepParticles(frame.frameSeconds);
                state->renderWorld->AdvanceTime(frame.frameSeconds);
            }
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_ANIMATION, particleTimer);
            if running ~= session {
                running->UpdateUi();
            }
            ReportUiMessages();
            engineState: raw EngineState~* = StatePointer();
            windowTimer: u64 = state->debugWindow->budget->Start();
            unsafe {
                windowScale: f32 = Math:::max(Math:::round(engineState->uiScale * 0.5f), 1.0f);
                if engineState->pendingCapturePath == null {
                    engineState->debugWindow->Draw(engineState->debugValues, engineState->debugPages, engineState->renderWorld->overlay, engineState->screenSize, windowScale);
                }
            }
            hasPendingCapture~ bool = false;
            unsafe {
                hasPendingCapture = engineState->pendingCapturePath != null;
            }
            if !hasPendingCapture {
                if running ~= session {
                    unsafe {
                        running->DrawUi(engineState->renderWorld->overlay, engineState->screenSize, engineState->uiScale * 0.5f);
                    }
                }
            }
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_OVERLAY, windowTimer);
            animationTimer: u64 = state->debugWindow->budget->Start();
            unsafe {
                engineState->animationSystem->Update(engineState->entityWorld, frame.frameSeconds);
                PlaceAnimatedFeet(engineState->animationSystem, engineState->entityWorld, engineState->collision, frame.frameSeconds);
                lantern:::engine:::ExtractDraws(engineState->entityWorld, frame.alpha, engineState->renderWorld);
                engineState->animationSystem->Extract(engineState->entityWorld, frame.alpha, engineState->renderWorld);
            }
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_ANIMATION, animationTimer);
            if error := scriptError {
                if !state->debugWindow->visible {
                    shown: string! = `${error}`;
                    DrawScriptError(shown);
                    delete shown;
                }
            }
            scale: f32 = state->uiScale;
            reportFromRender~ lantern:::renderer:::RenderReport? = null;
            renderTimer: u64 = state->debugWindow->budget->Start();
            unsafe {
                rendered := engineState->renderBackend->Render(engineState->renderWorld);
                when rendered! {
                    Result:::Ok(report) -> {
                        reportFromRender = report;
                    },
                    Result:::Err(message) -> {
                        lantern:::core:::LogError("renderer", message);
                        delete message;
                    }
                }
            }
            state->debugWindow->budget->Stop(lantern:::core:::BUDGET_PHASE_RENDER, renderTimer);
            if report := reportFromRender {
                lastFrameReport = report;
            }
            unsafe {
                if hasPendingCapture {
                    if pending := engineState->pendingCapturePath {
                        target: string! = `${pending}`;
                        delete engineState->pendingCapturePath;
                        engineState->pendingCapturePath = null;
                        SaveCapture(target, frame);
                        delete target;
                    }
                }
            }
            if quit {
                if path := capturePath {
                    target: string! = `${path}`;
                    SaveCapture(target, frame);
                    delete target;
                }
            }
            state->debugWindow->budget->EndFrame(monotonicNanoseconds());
        }

        /**
         * True when the script has called `lantern:::engine:::Quit`.
         */
        WantsToQuit :: () -> bool {
            return quit;
        }

        /**
         * Rebuilds the input router when the game has defined or bound actions since the last frame.
         */
        UpdateInputConfiguration~: (input: lantern:::engine:::InputRouter~*) -> void {
            if !state->input->configurationChanged {
                return;
            }
            state->input->configurationChanged = false;
            input->Reconfigure(state->input->actions->Copy(), state->input->bindings->Copy());
        }
    }
}
