RoomStreamer :: import RoomStreamer;

lantern:::host :: namespace {
    /**
     * The scene id the game's entities are spawned into, so a level can be removed in one call without touching
     * anything else.
     */
    GAME_SCENE_VALUE: u32 : 1;
    /**
     * The name of the engine's own "reload scripts" action (F5).
     */
    ENGINE_RELOAD_ACTION_NAME: string : "engine_reload_scripts";
    /**
     * The name of the engine's own "toggle the debug HUD" action (F1, the backquote key, or the gamepad's back button).
     */
    ENGINE_TOGGLE_HUD_ACTION_NAME: string : "engine_toggle_debug_hud";

    /**
     * The scene id for game entities.
     */
    GameScene :: () -> lantern:::engine:::SceneId {
        return lantern:::engine:::SceneId { value: GAME_SCENE_VALUE };
    }

    /**
     * The action id of the reload action. The engine registers its two actions first, so they are always actions 0 and 1
     * and a game's own actions come after them.
     */
    EngineReloadAction :: () -> lantern:::core:::ActionId {
        return lantern:::core:::ActionId { value: 0 };
    }

    /**
     * The action id of the HUD toggle (action 1).
     */
    EngineToggleHudAction :: () -> lantern:::core:::ActionId {
        return lantern:::core:::ActionId { value: 1 };
    }

    /**
     * True for the engine's two actions, so the loop handles them itself and doesn't show them to the game.
     */
    IsEngineAction :: (action: lantern:::core:::ActionId) -> bool {
        return action == EngineReloadAction() || action == EngineToggleHudAction();
    }

    /**
     * The action set a game starts with: just the engine's two.
     */
    EngineActions :: () -> lantern:::core:::ActionSet*! {
        actions := new lantern:::core:::ActionSet();
        actions->Register(ENGINE_RELOAD_ACTION_NAME, lantern:::core:::ActionKind:::Button);
        actions->Register(ENGINE_TOGGLE_HUD_ACTION_NAME, lantern:::core:::ActionKind:::Button);
        return actions!;
    }

    /**
     * The bindings a game starts with: the engine's two actions on their keys.
     */
    EngineBindings :: () -> lantern:::core:::Bindings*! {
        bindings := new lantern:::core:::Bindings();
        bindings->Bind(EngineReloadAction(), lantern:::core:::Binding:::Key(lantern:::core:::KeyCode:::F5));
        bindings->Bind(EngineToggleHudAction(), lantern:::core:::Binding:::Key(lantern:::core:::KeyCode:::F1));
        bindings->Bind(EngineToggleHudAction(), lantern:::core:::Binding:::Key(lantern:::core:::KeyCode:::Backquote));
        bindings->Bind(EngineToggleHudAction(), lantern:::core:::Binding:::Gamepad(lantern:::core:::GamepadButton:::Back));
        return bindings!;
    }

    /**
     * The input the engine holds for the script: the actions the game defined, their bindings, whether either changed (so
     * the router is rebuilt), and the latest snapshot that `lantern:::input` reads from.
     */
    InputState :: class {
    public:
        actions~ lantern:::core:::ActionSet*!;
        bindings~ lantern:::core:::Bindings*!;
        configurationChanged~ bool = true;
        snapshot~ lantern:::core:::InputSnapshot*!;

        InputState~: () {
            actions = EngineActions();
            bindings = EngineBindings();
            snapshot = new lantern:::core:::InputSnapshot();
        }

        !InputState~: () {
            delete actions;
            delete bindings;
            delete snapshot;
        }

        /**
         * Back to just the engine's actions and bindings, for a new session.
         */
        Reset~: () -> void {
            delete actions;
            delete bindings;
            actions = EngineActions();
            bindings = EngineBindings();
            configurationChanged = true;
            SetSnapshot(new lantern:::core:::InputSnapshot());
        }

        /**
         * Replaces the snapshot with this frame's.
         */
        SetSnapshot~: (newSnapshot: lantern:::core:::InputSnapshot*!) -> void {
            delete snapshot;
            snapshot = newSnapshot!;
        }

        /**
         * Whether an action named `name` went down this frame, or null when the game has no action by that name.
         */
        Pressed :: (name: string) -> bool? {
            if action := actions->Find(name) {
                return snapshot->Pressed(action);
            }
            return null;
        }
    }

    /**
     * What the script knows about an entity that the engine's own entity world doesn't: its kind (`gem`, `block`) and its
     * properties from the world file. `lantern:::world` functions read it.
     */
    EntityTags :: class {
    public:
        entity~ lantern:::core:::Handle<lantern:::engine:::EntityTag> = lantern:::core:::Handle<lantern:::engine:::EntityTag> { };
        kind~ string!;
        propertyKeys~ Array<string!>! = [];
        propertyValues~ Array<lantern:::world:::PropertyValue>! = [];
        propertyTexts~ Array<string!>! = [];

        EntityTags~: (taggedEntity: lantern:::core:::Handle<lantern:::engine:::EntityTag>, entityKind: string) {
            entity = taggedEntity;
            kind = `${entityKind}`;
        }

        !EntityTags~: () {
            delete kind;
            propertyKeys.freeAll();
            delete propertyValues;
            propertyTexts.freeAll();
        }

        PropertyIndex :: (key: string) -> usize? {
            for index~ usize = 0; index < propertyKeys.length(); index++ {
                if propertyKeys[index] == key {
                    return index;
                }
            }
            return null;
        }

        AddProperty~: (key: string, value: lantern:::world:::PropertyValue, text: string) -> void {
            propertyKeys.push(`${key}`);
            propertyValues.push(value);
            propertyTexts.push(`${text}`);
        }
    }

    /**
     * Joins an entity to the physics body that moves with it, for entities such as moving platforms.
     */
    EntityBody :: struct {
        entity~ lantern:::core:::Handle<lantern:::engine:::EntityTag> = lantern:::core:::Handle<lantern:::engine:::EntityTag> { };
        body~ lantern:::core:::Handle<lantern:::physics:::KinematicBody> = lantern:::core:::Handle<lantern:::physics:::KinematicBody> { };
    }

    /**
     * What the script asked the platform layer for this frame: quit the game, or capture or release the mouse. The game
     * loop reads and clears them after the hooks run.
     */
    PlatformRequests :: struct {
        quit~ bool = false;
        mouseCaptured~ bool? = null;
    }

    /**
     * A boolean holder that nothing uses at present.
     */
    FlagOverride :: struct {
        value~ bool = false;
    }

    /**
     * Everything the host functions act on, in one place: the entity world, the collision world, the render backend and
     * render world, audio, the debug HUD and its values, input, the screen size and UI scale, the materials, meshes and
     * textures a script created (so they can be freed), and the entity tags and bodies. The API functions get a pointer
     * to it. A game restart calls ResetForNewSession, which clears it all without destroying the backend.
     */
    EngineState :: class {
    public:
        assetsDirectory~ string!? = null;
        pendingCapturePath~ string!? = null;
        entityWorld~ lantern:::engine:::World*!;
        collision~ lantern:::physics:::CollisionWorld*!;
        navigationMesh~ lantern:::navigation:::NavigationMesh*!;
        renderBackend~ lantern:::renderer:::RenderBackend*!;
        audioSystemInstance~ lantern:::engine:::AudioSystem*!;
        renderWorld~ lantern:::renderer:::RenderWorld*!;
        debugValues~ lantern:::core:::DebugValues*!;
        debugWindow~ lantern:::debug:::DebugWindow*!;
        debugPages~ lantern:::debug:::PageAssignments*!;
        input~ InputState*!;
        animationSystem~ lantern:::engine:::AnimationSystem*!;
        requests~ PlatformRequests = PlatformRequests { };
        screenSize~ Vec2 = Vec2 { x: 1280.0f, y: 720.0f };
        uiScale~ f32 = 2.0f;
        materialNames~ Array<string!>! = [];
        materialTextures~ Array<lantern:::core:::Handle<lantern:::renderer:::TextureTag>>! = [];
        lookNames~ Array<string!>! = [];
        looks~ Array<lantern:::renderer:::MaterialLook>! = [];
        scriptMeshes~ Array<lantern:::core:::Handle<lantern:::renderer:::MeshTag>>! = [];
        scriptTextures~ Array<lantern:::core:::Handle<lantern:::renderer:::TextureTag>>! = [];
        scriptMaterialShaders~ Array<lantern:::core:::Handle<lantern:::renderer:::MaterialShaderTag>>! = [];
        shaderParameterMaterials~ Array<string!>! = [];
        shaderParameterNames~ Array<string!>! = [];
        shaderParameterSlots~ Array<u32>! = [];
        worldMeshes~ Array<lantern:::core:::Handle<lantern:::renderer:::MeshTag>>! = [];
        worldLightIds~ Array<u32>! = [];
        streaming~ RoomStreamer*!;
        entityTags~ Array<EntityTags*!>! = [];
        entityBodies~ Array<EntityBody>! = [];
        fontAtlas~ lantern:::core:::Handle<lantern:::renderer:::TextureTag> = lantern:::core:::Handle<lantern:::renderer:::TextureTag> { };
        flagNames~ Array<string!>! = [];
        flagValues~ Array<bool>! = [];

        EngineState~: (backend: lantern:::renderer:::RenderBackend*!, audioSystem: lantern:::engine:::AudioSystem*!, assets: string?) {
            if directory := assets {
                assetsDirectory = `${directory}`;
            }
            entityWorld = new lantern:::engine:::World();
            collision = new lantern:::physics:::CollisionWorld();
            navigationMesh = new lantern:::navigation:::NavigationMesh();
            streaming = new RoomStreamer();
            renderBackend = backend!;
            audioSystemInstance = audioSystem!;
            renderWorld = new lantern:::renderer:::RenderWorld();
            debugValues = new lantern:::core:::DebugValues();
            debugWindow = new lantern:::debug:::DebugWindow();
            debugWindow->visible = false;
            debugPages = new lantern:::debug:::PageAssignments();
            input = new InputState();
            animationSystem = new lantern:::engine:::AnimationSystem();
        }

        !EngineState~: () {
            delete assetsDirectory;
            delete pendingCapturePath;
            delete entityWorld;
            delete collision;
            delete navigationMesh;
            delete streaming;
            delete renderWorld;
            delete renderBackend;
            delete audioSystemInstance;
            delete debugValues;
            delete debugWindow;
            delete debugPages;
            delete input;
            delete animationSystem;
            materialNames.freeAll();
            delete materialTextures;
            lookNames.freeAll();
            delete looks;
            delete scriptMeshes;
            delete scriptTextures;
            delete scriptMaterialShaders;
            shaderParameterMaterials.freeAll();
            shaderParameterNames.freeAll();
            delete shaderParameterSlots;
            delete worldMeshes;
            delete worldLightIds;
            entityTags.freeAll();
            delete entityBodies;
            flagNames.freeAll();
            delete flagValues;
        }

        /**
         * Builds the state around a backend and an audio system, and uploads the font atlas texture that overlay text uses.
         */
        static Create :: (backend: lantern:::renderer:::RenderBackend*!, audioSystem: lantern:::engine:::AudioSystem*!, assets: string?) -> Result<EngineState*!, string!> {
            state := new EngineState(backend!, audioSystem!, assets);
            atlas := lantern:::renderer:::FontAtlas();
            defer delete atlas;
            created := state->renderBackend->CreateTexture(atlas);
            when created! {
                Result:::Ok(texture) -> {
                    state->fontAtlas = texture;
                    state->renderWorld->overlayTexture = texture;
                    return Result<EngineState*!, string!>:::Ok(state!);
                },
                Result:::Err(message) -> {
                    delete state;
                    return Result<EngineState*!, string!>:::Err(message!);
                }
            }
        }

        /**
         * A path under the game's assets directory. An absolute path is left as it is.
         */
        AssetPath :: (relative: string) -> string! {
            if directory := assetsDirectory {
                if relative.length() > 0 && relative.byteAt(0) == u8(47) {
                    return `${relative}`;
                }
                return `${directory}/${relative}`;
            }
            return `${relative}`;
        }

        /**
         * Sets a named on or off value that the engine publishes for scripts to read with `lantern:::engine:::Flag` (for
         * example whether an audio device was found).
         */
        SetFlag~: (name: string, value: bool) -> void {
            for index~ usize = 0; index < flagNames.length(); index++ {
                if flagNames[index] == name {
                    flagValues[index] = value;
                    return;
                }
            }
            flagNames.push(`${name}`);
            flagValues.push(value);
        }

        /**
         * A flag's value, false when it was never set.
         */
        Flag :: (name: string) -> bool {
            for index~ usize = 0; index < flagNames.length(); index++ {
                if flagNames[index] == name {
                    return flagValues[index];
                }
            }
            return EnvironmentFlag(name);
        }

        /**
         * Names a texture, so levels can refer to a material by name.
         */
        SetMaterial~: (name: string, texture: lantern:::core:::Handle<lantern:::renderer:::TextureTag>) -> void {
            for index~ usize = 0; index < materialNames.length(); index++ {
                if materialNames[index] == name {
                    materialTextures[index] = texture;
                    return;
                }
            }
            materialNames.push(`${name}`);
            materialTextures.push(texture);
        }

        /**
         * Gives a material name a look (tint, metallic, roughness, emissive) besides its texture.
         */
        SetMaterialLook~: (name: string, look: lantern:::renderer:::MaterialLook) -> void {
            for index~ usize = 0; index < lookNames.length(); index++ {
                if lookNames[index] == name {
                    keptShader: lantern:::core:::Handle<lantern:::renderer:::MaterialShaderTag>? = looks[index].shader;
                    looks[index] = look;
                    if look.shader == null {
                        looks[index].shader = keptShader;
                    }
                    return;
                }
            }
            lookNames.push(`${name}`);
            looks.push(look);
        }

        /**
         * Gives a material name the shader its graph became. A material with no look yet gets the default one, so
         * `SetMaterialLook` before or after both keep the shader.
         */
        SetMaterialShader~: (name: string, shader: lantern:::core:::Handle<lantern:::renderer:::MaterialShaderTag>) -> void {
            for index~ usize = 0; index < lookNames.length(); index++ {
                if lookNames[index] == name {
                    looks[index].shader = shader;
                    return;
                }
            }
            lookNames.push(`${name}`);
            looks.push(lantern:::renderer:::MaterialLook { shader: shader });
        }

        /**
         * Names one of a material shader's parameter slots, so `SetMaterialParameter` can find it by the name its graph gave it.
         */
        AddShaderParameter~: (material: string, parameterName: string, slot: u32) -> void {
            for index~ usize = 0; index < shaderParameterMaterials.length(); index++ {
                if shaderParameterMaterials[index] == material && shaderParameterNames[index] == parameterName {
                    shaderParameterSlots[index] = slot;
                    return;
                }
            }
            shaderParameterMaterials.push(`${material}`);
            shaderParameterNames.push(`${parameterName}`);
            shaderParameterSlots.push(slot);
        }

        /**
         * The slot of a material's named parameter, or null when its shader has no parameter by that name.
         */
        ShaderParameterSlot :: (material: string, parameterName: string) -> u32? {
            for index~ usize = 0; index < shaderParameterMaterials.length(); index++ {
                if shaderParameterMaterials[index] == material && shaderParameterNames[index] == parameterName {
                    return shaderParameterSlots[index];
                }
            }
            return null;
        }

        /**
         * The look of a material name, or null.
         */
        ShaderParameterSlotOf :: (shader: lantern:::core:::Handle<lantern:::renderer:::MaterialShaderTag>, parameterName: string) -> u32? {
            for index~ usize = 0; index < shaderParameterMaterials.length(); index++ {
                if shaderParameterNames[index] == parameterName {
                    if look := LookOf(shaderParameterMaterials[index]) {
                        if lookShader := look.shader {
                            if lookShader == shader {
                                return shaderParameterSlots[index];
                            }
                        }
                    }
                }
            }
            return null;
        }

        LookOf :: (name: string) -> lantern:::renderer:::MaterialLook? {
            for index~ usize = 0; index < lookNames.length(); index++ {
                if lookNames[index] == name {
                    return looks[index];
                }
            }
            return null;
        }

        /**
         * The texture for a material name, or null.
         */
        Material :: (name: string) -> lantern:::core:::Handle<lantern:::renderer:::TextureTag>? {
            for index~ usize = 0; index < materialNames.length(); index++ {
                if materialNames[index] == name {
                    return materialTextures[index];
                }
            }
            return null;
        }

        /**
         * Where an entity's tags are in the list, or null.
         */
        TagsIndex :: (entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>) -> usize? {
            for index~ usize = 0; index < entityTags.length(); index++ {
                if entityTags[index]->entity == entity {
                    return index;
                }
            }
            return null;
        }

        /**
         * The tags of an entity, or null.
         */
        Tags :: (entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>) -> EntityTags*? {
            if index := TagsIndex(entity) {
                return entityTags[index];
            }
            return null;
        }

        /**
         * Stores an entity's tags, replacing any it had.
         */
        SetTags~: (tags: EntityTags*!) -> void {
            RemoveTags(tags->entity);
            entityTags.push(tags!);
        }

        /**
         * Forgets an entity's tags.
         */
        RemoveTags~: (entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>) -> void {
            if index := TagsIndex(entity) {
                removed := entityTags.remove(index);
                delete removed;
            }
        }

        /**
         * The physics body that moves with an entity, or null.
         */
        Body :: (entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>) -> lantern:::core:::Handle<lantern:::physics:::KinematicBody>? {
            for entry in entityBodies {
                if entry.entity == entity {
                    return entry.body;
                }
            }
            return null;
        }

        /**
         * Joins an entity to a body.
         */
        SetBody~: (entity: lantern:::core:::Handle<lantern:::engine:::EntityTag>, body: lantern:::core:::Handle<lantern:::physics:::KinematicBody>) -> void {
            for index~ usize = 0; index < entityBodies.length(); index++ {
                if entityBodies[index].entity == entity {
                    entityBodies[index] = EntityBody { entity: entity, body: body };
                    return;
                }
            }
            entityBodies.push(EntityBody { entity: entity, body: body });
        }

        /**
         * Removes the loaded level: the game scene's entities, the level's meshes and lights, the collision world and the tags
         * and bodies. Meshes and textures the script made itself stay.
         */
        ClearWorld~: () -> void {
            entityWorld->DespawnScene(GameScene());
            animationSystem->ClearAnimators();
            for mesh in worldMeshes {
                renderBackend->RemoveMesh(mesh);
            }
            worldMeshes.clear();
            for lightId in worldLightIds {
                renderWorld->RemoveLight(lightId);
            }
            worldLightIds.clear();
            delete collision;
            collision = new lantern:::physics:::CollisionWorld();
            navigationMesh->Clear();
            streaming->Reset();
            entityTags.freeAll();
            entityTags = [];
            entityBodies.clear();
        }

        /**
         * Returns the state to how it was at start, for a script reload: the level is cleared, the script's own meshes, textures
         * and materials are freed, music stops, the debug values and input are reset, and a fresh render world is made. The
         * font texture stays.
         */
        ResetForNewSession~: () -> void {
            delete pendingCapturePath;
            pendingCapturePath = null;
            ClearWorld();
            for mesh in scriptMeshes {
                renderBackend->RemoveMesh(mesh);
            }
            scriptMeshes.clear();
            animationSystem->ClearRigs();
            for texture in scriptTextures {
                renderBackend->RemoveTexture(texture);
            }
            scriptTextures.clear();
            for materialShader in scriptMaterialShaders {
                renderBackend->RemoveMaterialShader(materialShader);
            }
            scriptMaterialShaders.clear();
            shaderParameterMaterials.freeAll();
            shaderParameterMaterials = [];
            shaderParameterNames.freeAll();
            shaderParameterNames = [];
            shaderParameterSlots.clear();
            materialNames.freeAll();
            materialNames = [];
            materialTextures.clear();
            lookNames.freeAll();
            lookNames = [];
            looks.clear();
            audioSystemInstance->StopMusic();
            audioSystemInstance->StopAllLoops(0.0f);
            debugValues->Clear();
            input->Reset();
            requests.mouseCaptured = false;
            overlayTexture: lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = renderWorld->overlayTexture;
            delete renderWorld;
            renderWorld = new lantern:::renderer:::RenderWorld();
            renderWorld->overlayTexture = overlayTexture;
        }
    }

    /**
     * True when an environment variable is set to anything but empty or "0".
     */
    EnvironmentFlag :: (name: string) -> bool {
        value: string!? = environmentVariable(name);
        defer delete value;
        if text := value {
            return text.length() > 0 && text != "0";
        }
        return false;
    }

    /**
     * The value 0 to 15 of a hex digit byte, or null.
     */
    HexDigit :: (byte: u8) -> u32? {
        if byte >= u8(48) && byte <= u8(57) {
            return u32(byte) - 48;
        }
        if byte >= u8(97) && byte <= u8(102) {
            return u32(byte) - 87;
        }
        if byte >= u8(65) && byte <= u8(70) {
            return u32(byte) - 55;
        }
        return null;
    }

    /**
     * Reads `RRGGBB` or `RRGGBBAA` (a leading `#` is allowed) as a colour, or null.
     */
    ParseColor :: (text: string) -> lantern:::core:::Color? {
        start~ usize = 0;
        if text.length() > 0 && text.byteAt(0) == u8(35) {
            start = 1;
        }
        digits: usize = text.length() - start;
        if digits != 6 && digits != 8 {
            return null;
        }
        value~ u32 = 0;
        for index~ usize = start; index < text.length(); index++ {
            guard digit := HexDigit(text.byteAt(index)) return null;
            value = (value << 4) | digit;
        }
        if digits == 6 {
            return lantern:::core:::Color:::FromHex(value);
        }
        return lantern:::core:::Color:::FromHex(value >> 8).WithAlpha(f32(value & 255) / 255.0f);
    }
}
