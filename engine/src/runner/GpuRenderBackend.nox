lantern:::runner :: namespace {
    GpuRenderBackend :: class {
        implements:
            lantern:::host:::RenderBackend;
    public:
        renderer~ lantern:::gpu:::GpuRenderer*!;

        GpuRenderBackend~: (gpuRenderer: lantern:::gpu:::GpuRenderer*!) {
            renderer = gpuRenderer!;
        }

        !GpuRenderBackend~: () {
            delete renderer;
        }

        DriverName :: () -> string {
            return renderer->DriverName();
        }

        CreateMesh~: (mesh: lantern:::renderer:::MeshData*) -> Result<lantern:::core:::Handle<lantern:::renderer:::MeshTag>, string!> {
            return renderer->CreateMesh(mesh);
        }

        RemoveMesh~: (mesh: lantern:::core:::Handle<lantern:::renderer:::MeshTag>) -> void {
            renderer->RemoveMesh(mesh);
        }

        CreateTexture~: (texture: lantern:::renderer:::TextureData*) -> Result<lantern:::core:::Handle<lantern:::renderer:::TextureTag>, string!> {
            return renderer->CreateTexture(texture);
        }

        RemoveTexture~: (texture: lantern:::core:::Handle<lantern:::renderer:::TextureTag>) -> void {
            renderer->RemoveTexture(texture);
        }

        Render~: (world: lantern:::renderer:::RenderWorld*) -> Result<lantern:::host:::RenderReport, string!> {
            when renderer->Render(world) {
                Result:::Ok(report) -> {
                    return Result<lantern:::host:::RenderReport, string!>:::Ok(lantern:::host:::RenderReport {
                        presented: report.presented,
                        drawsSubmitted: report.drawsSubmitted,
                        drawsCulled: report.drawsCulled,
                        triangles: report.triangles,
                        lineCount: report.lineCount
                    });
                },
                Result:::Err(message) -> {
                    return Result<lantern:::host:::RenderReport, string!>:::Err(message!);
                }
            }
        }

        Capture~: (world: lantern:::renderer:::RenderWorld*, width: u32, height: u32) -> Result<lantern:::renderer:::TextureData*!, string!> {
            return renderer->Capture(world, width, height);
        }
    }
}
