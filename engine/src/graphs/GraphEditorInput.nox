// What the pointer and keys do on the canvas: select and drag a node, drag a wire from a pin to another, pan the background,
// zoom with the wheel, clear a link with a right click, and delete the selected node.
lantern:::graphs :: namespace {
    HIT_NOTHING: i32 : 0;
    HIT_NODE: i32 : 1;
    HIT_PIN: i32 : 2;

    BUTTON_LEFT: u32 : 0;
    BUTTON_RIGHT: u32 : 1;

    // What is under a screen point: a pin of a node, a node, or nothing.
    Hit :: class {
    public:
        kind~ i32 = 0;
        nodeId~ string!;
        port~ string!;
        isExecution~ bool = false;
        isOutput~ bool = false;

        Hit~: () {
            nodeId = "".copy();
            port = "".copy();
        }

        !Hit~: () {
            delete nodeId;
            delete port;
        }
    }

    HitAt :: (editor: GraphEditor*, screenX: i32, screenY: i32) -> Hit*! {
        hit := new Hit();
        if editor->graph->functions.length() == 0 {
            return hit!;
        }
        function: GraphFunction* = editor->Function();
        radius: i32 = PIN_HIT_RADIUS * editor->zoom;
        index~ usize = function->nodes.length();
        while index > 0 && hit->kind == HIT_NOTHING {
            index -= 1;
            node: GraphNode* = function->nodes[index];
            pins := PinsOf(function, node);
            for pinIndex~ usize = 0; pinIndex < pins->items.length(); pinIndex++ {
                pin: PinSlot* = pins->items[pinIndex];
                deltaX: i32 = screenX - PinScreenX(editor, node, pin);
                deltaY: i32 = screenY - PinScreenY(editor, node, pin);
                if deltaX >= -radius && deltaX <= radius && deltaY >= -radius && deltaY <= radius && hit->kind == HIT_NOTHING {
                    hit->kind = HIT_PIN;
                    delete hit->nodeId;
                    hit->nodeId = `${node->id}`;
                    delete hit->port;
                    hit->port = `${pin->port}`;
                    hit->isExecution = pin->isExecution;
                    hit->isOutput = pin->isOutput;
                }
            }
            if hit->kind == HIT_NOTHING {
                left: i32 = editor->ScreenX(i32(node->x));
                top: i32 = editor->ScreenY(i32(node->y));
                if screenX >= left && screenX < left + NODE_WIDTH * editor->zoom && screenY >= top && screenY < top + NodeHeight(pins) * editor->zoom {
                    hit->kind = HIT_NODE;
                    delete hit->nodeId;
                    hit->nodeId = `${node->id}`;
                }
            }
            delete pins;
        }
        return hit!;
    }

    // Snaps a coordinate to the grid.
    Snapped :: (value: i32) -> i32 {
        half: i32 = GRID_STEP / 2;
        if value >= 0 {
            return (value + half) / GRID_STEP * GRID_STEP;
        }
        return -((-value + half) / GRID_STEP * GRID_STEP);
    }

    // Joins the wire being dragged to what it was let go over.
    FinishWire :: (editor: GraphEditor~*, target: Hit*) -> void {
        if editor->graph->functions.length() == 0 {
            return;
        }
        function: GraphFunction~* = editor->graph->functions[editor->functionIndex];
        problem~ string!? = null;
        madeWire~ bool = false;
        if target->kind == HIT_PIN && target->nodeId != editor->wireNode {
            if editor->wireIsExecution && !target->isOutput && target->isExecution {
                problem = SetPort(function, editor->wireNode, editor->wirePort, target->nodeId);
                madeWire = true;
            } else if !editor->wireIsExecution && !target->isOutput && !target->isExecution {
                problem = SetPort(function, target->nodeId, target->port, editor->wireNode);
                madeWire = true;
            }
        } else if target->kind == HIT_NODE && target->nodeId != editor->wireNode && editor->wireIsExecution {
            problem = SetPort(function, editor->wireNode, editor->wirePort, target->nodeId);
            madeWire = true;
        }
        if message := problem {
            editor->SetStatus(message);
        } else if madeWire {
            editor->Touch();
            editor->SetStatus("Connected.");
        }
        delete problem;
    }

    PointerPressed :: (editor: GraphEditor~*, button: u32) -> void {
        hit := HitAt(editor, editor->pointerX, editor->pointerY);
        if editor->graph->functions.length() == 0 {
            delete hit;
            return;
        }
        function: GraphFunction~* = editor->graph->functions[editor->functionIndex];
        if button == BUTTON_RIGHT {
            if hit->kind == HIT_PIN {
                problem~ string!? = null;
                if !hit->isOutput && !hit->isExecution || hit->isOutput && hit->isExecution {
                    problem = SetPort(function, hit->nodeId, hit->port, "");
                    editor->Touch();
                    editor->SetStatus("Disconnected.");
                } else if !hit->isOutput && hit->isExecution {
                    for index~ usize = 0; index < function->nodes.length(); index++ {
                        if function->nodes[index]->next == hit->nodeId {
                            function->nodes[index]->ClearLinksTo(hit->nodeId);
                        }
                    }
                    editor->Touch();
                    editor->SetStatus("Disconnected.");
                }
                delete problem;
            }
            delete hit;
            return;
        }
        if button != BUTTON_LEFT {
            delete hit;
            return;
        }
        if hit->kind == HIT_PIN && hit->isOutput {
            editor->dragMode = DRAG_WIRE;
            delete editor->wireNode;
            editor->wireNode = `${hit->nodeId}`;
            delete editor->wirePort;
            editor->wirePort = `${hit->port}`;
            editor->wireIsExecution = hit->isExecution;
            delete editor->selected;
            editor->selected = `${hit->nodeId}`;
        } else if hit->kind == HIT_NODE || hit->kind == HIT_PIN {
            delete editor->selected;
            editor->selected = `${hit->nodeId}`;
            editor->dragMode = DRAG_NODE;
            delete editor->dragNode;
            editor->dragNode = `${hit->nodeId}`;
            grabbed: GraphFunction* = editor->Function();
            if index := grabbed->IndexOfNode(hit->nodeId) {
                editor->dragOffsetX = editor->WorldX(editor->pointerX) - i32(grabbed->nodes[index]->x);
                editor->dragOffsetY = editor->WorldY(editor->pointerY) - i32(grabbed->nodes[index]->y);
            }
        } else {
            delete editor->selected;
            editor->selected = "".copy();
            editor->dragMode = DRAG_PAN;
            editor->dragOffsetX = editor->pointerX;
            editor->dragOffsetY = editor->pointerY;
        }
        delete hit;
    }

    PointerReleased :: (editor: GraphEditor~*, button: u32) -> void {
        if button != BUTTON_LEFT {
            return;
        }
        if editor->dragMode == DRAG_WIRE {
            target := HitAt(editor, editor->pointerX, editor->pointerY);
            FinishWire(editor, target);
            delete target;
        } else if editor->dragMode == DRAG_NODE && editor->graph->functions.length() > 0 {
            function: GraphFunction~* = editor->graph->functions[editor->functionIndex];
            if index := function->IndexOfNode(editor->dragNode) {
                function->nodes[index]->x = f32(Snapped(i32(function->nodes[index]->x)));
                function->nodes[index]->y = f32(Snapped(i32(function->nodes[index]->y)));
                editor->Touch();
            }
        }
        editor->dragMode = DRAG_NONE;
    }

    PointerMoved :: (editor: GraphEditor~*, screenX: i32, screenY: i32) -> void {
        editor->pointerX = screenX;
        editor->pointerY = screenY;
        if editor->dragMode == DRAG_NODE && editor->graph->functions.length() > 0 {
            function: GraphFunction~* = editor->graph->functions[editor->functionIndex];
            if index := function->IndexOfNode(editor->dragNode) {
                function->nodes[index]->x = f32(editor->WorldX(screenX) - editor->dragOffsetX);
                function->nodes[index]->y = f32(editor->WorldY(screenY) - editor->dragOffsetY);
            }
        } else if editor->dragMode == DRAG_PAN {
            editor->panX += (screenX - editor->dragOffsetX) / editor->zoom;
            editor->panY += (screenY - editor->dragOffsetY) / editor->zoom;
            editor->dragOffsetX = screenX;
            editor->dragOffsetY = screenY;
        }
    }

    // The wheel changes the zoom by a whole step so text stays sharp.
    WheelTurned :: (editor: GraphEditor~*, notches: f32) -> void {
        if notches > 0.0f && editor->zoom < MAX_ZOOM {
            editor->zoom += 1;
        } else if notches < 0.0f && editor->zoom > 1 {
            editor->zoom -= 1;
        }
    }

    // Delete removes the selected node. Returns true when the key was used.
    KeyPressed :: (editor: GraphEditor~*, keyName: string) -> bool {
        if (keyName == "Delete" || keyName == "Backspace") && editor->selected.length() > 0 && editor->graph->functions.length() > 0 {
            function: GraphFunction~* = editor->graph->functions[editor->functionIndex];
            doomed: string! = `${editor->selected}`;
            if RemoveNode(function, doomed) {
                delete editor->selected;
                editor->selected = "".copy();
                editor->Touch();
                editor->SetStatus("Node deleted.");
            } else {
                editor->SetStatus("That node can't be deleted.");
            }
            delete doomed;
            return true;
        }
        return false;
    }

    SelectNode :: (editor: GraphEditor~*, nodeId: string) -> void {
        delete editor->selected;
        editor->selected = `${nodeId}`;
    }
}
