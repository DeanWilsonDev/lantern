// Turns a graph into Nyx source (docs/visual-scripting.md). Execution nodes become statements in order, data nodes become
// expressions written where they are used, and the first thing wrong with the graph stops the generator with a message that
// names the function and the node.
lantern:::graphs :: namespace {
    // How many data nodes deep an expression may go, and how many execution nodes a function may walk: a graph that goes
    // past either has a cycle.
    MAX_EXPRESSION_DEPTH: u32 : 64;
    MAX_STEPS: u32 : 10000;

    Emitter :: class {
    public:
        text~ string!;
        problem~ string!;
        declared~ Array<string!>! = [];
        steps~ u32 = 0;
        annotate~ bool = false;
        currentNodeId~ string!;
        currentEvent~ string!;

        Emitter~: () {
            text = "".copy();
            problem = "".copy();
            currentNodeId = "".copy();
            currentEvent = "".copy();
        }

        !Emitter~: () {
            delete text;
            delete problem;
            delete currentNodeId;
            delete currentEvent;
            declared.freeAll();
        }

        Fail~: (functionName: string, message: string!) -> void {
            if problem.length() == 0 {
                delete problem;
                problem = `function ${functionName}: ${message}`;
            }
            delete message;
        }

        IsDeclared :: (name: string) -> bool {
            for index~ usize = 0; index < declared.length(); index++ {
                if declared[index] == name {
                    return true;
                }
            }
            return false;
        }

        SetCurrent~: (nodeId: string) -> void {
            delete currentNodeId;
            currentNodeId = `${nodeId}`;
        }

        Line~: (depth: u32, line: string!) -> void {
            for step~ u32 = 0; step < depth; step++ {
                text += "    ";
            }
            text += line;
            if annotate && currentNodeId.length() > 0 {
                text += `  //@${currentNodeId}`;
            }
            text += "\n";
            delete line;
        }
    }

    // The Nyx operator a data node's kind stands for, or the empty string.
    OperatorFor :: (kind: string) -> string {
        if kind == "add" {
            return "+";
        }
        if kind == "sub" {
            return "-";
        }
        if kind == "mul" {
            return "*";
        }
        if kind == "div" {
            return "/";
        }
        if kind == "less" {
            return "<";
        }
        if kind == "greater" {
            return ">";
        }
        if kind == "equal" {
            return "==";
        }
        if kind == "and" {
            return "&&";
        }
        if kind == "or" {
            return "||";
        }
        return "";
    }

    // A whole expression without the parentheses a binary node puts around it.
    Bare :: (expression: string!) -> string! {
        if expression.startsWith("(") && expression.endsWith(")") {
            inner: string! = `${expression.substring(1, expression.length() - 2)}`;
            delete expression;
            return inner!;
        }
        return expression!;
    }

    // `Path(a, b)` for a call node.
    CallExpression :: (function: GraphFunction*, emitter: Emitter~*, node: GraphNode*, depth: u32) -> string! {
        if !IsPath(node->functionPath) {
            emitter->Fail(function->name, `node '${node->id}' needs the Nyx function it calls, such as lantern:::world:::Position`);
            return "".copy();
        }
        call~ string! = `${node->functionPath}(`;
        for index~ usize = 0; index < node->arguments.length(); index++ {
            if index > 0 {
                call += ", ";
            }
            argument: string! = Expression(function, emitter, node->arguments[index], depth + 1);
            call += argument;
            delete argument;
        }
        call += ")";
        return call!;
    }

    // The Nyx expression for a value reference: a literal, an input or local, or the data node it names.
    Expression :: (function: GraphFunction*, emitter: Emitter~*, reference: string, depth: u32) -> string! {
        if emitter->problem.length() > 0 {
            return "".copy();
        }
        if reference.length() == 0 {
            emitter->Fail(function->name, "a node is missing a value".copy());
            return "".copy();
        }
        if reference.startsWith(LITERAL_MARK) {
            return `${reference.substring(1, reference.length() - 1)}`;
        }
        if depth > MAX_EXPRESSION_DEPTH {
            emitter->Fail(function->name, `the values around '${reference}' loop back on themselves`);
            return "".copy();
        }
        if index := function->IndexOfNode(reference) {
            node: GraphNode* = function->nodes[index];
            port: string = ReferencePort(reference);
            if node->kind == EVENT_KIND {
                if EventOutputType(node->name, port).length() == 0 {
                    emitter->Fail(function->name, `'${reference}' is not a value the ${node->name} event gives`);
                    return "".copy();
                }
                if port != ENTITY_PORT && node->name != emitter->currentEvent {
                    emitter->Fail(function->name, `'${reference}' is the ${node->name} event's ${port}, used outside ${node->name}`);
                    return "".copy();
                }
                return `${port}`;
            }
            if port.length() > 0 {
                emitter->Fail(function->name, `node '${node->id}' (${node->kind}) has no value named '${port}'`);
                return "".copy();
            }
            operatorText: string = OperatorFor(node->kind);
            if operatorText.length() > 0 {
                left: string! = Expression(function, emitter, node->a, depth + 1);
                right: string! = Expression(function, emitter, node->b, depth + 1);
                joined: string! = `(${left} ${operatorText} ${right})`;
                delete left;
                delete right;
                return joined!;
            }
            if node->kind == "reroute" {
                return Expression(function, emitter, node->a, depth + 1);
            }
            if node->kind == "not" {
                inner: string! = Expression(function, emitter, node->a, depth + 1);
                negated: string! = `!${inner}`;
                delete inner;
                return negated!;
            }
            if node->kind == "call" {
                if node->name.length() > 0 {
                    return `${node->name}`;
                }
                return CallExpression(function, emitter, node, depth + 1);
            }
            if node->kind == "get" {
                if function->IndexOfVariable(node->name) == null && function->IndexOfInput(node->name) == null && !emitter->IsDeclared(node->name) {
                    emitter->Fail(function->name, `node '${node->id}' reads '${node->name}', which is not a variable, an input or a local`);
                    return "".copy();
                }
                return `${node->name}`;
            }
            if node->kind == "nyx_value" {
                if !IsBalanced(node->text) || node->text.length() == 0 {
                    emitter->Fail(function->name, `node '${node->id}' needs a Nyx expression with balanced brackets`);
                    return "".copy();
                }
                return `(${node->text})`;
            }
            emitter->Fail(function->name, `node '${reference}' (${node->kind}) does not give a value`);
            return "".copy();
        }
        if function->IndexOfInput(reference) != null || emitter->IsDeclared(reference) {
            return `${reference}`;
        }
        emitter->Fail(function->name, `'${reference}' is not an input, a local or a node`);
        return "".copy();
    }

    // Writes the statements of the chain that starts at a node, following `next` until it ends. A branch writes both of its
    // arms and then goes on with its own `next`.
    EmitChain :: (function: GraphFunction*, emitter: Emitter~*, startId: string, depth: u32) -> void {
        currentId~ string = startId;
        declaredBefore: usize = emitter->declared.length();
        while currentId.length() > 0 && emitter->problem.length() == 0 {
            emitter->steps += 1;
            if emitter->steps > MAX_STEPS {
                emitter->Fail(function->name, "the execution wires loop back on themselves".copy());
                break;
            }
            index: usize? = function->IndexOfNode(currentId);
            if index == null {
                emitter->Fail(function->name, `a wire goes to '${currentId}', which is not a node`);
                break;
            }
            nodeIndex~ usize = 0;
            if present := index {
                nodeIndex = present;
            }
            node: GraphNode* = function->nodes[nodeIndex];
            emitter->SetCurrent(node->id);
            nextId~ string = node->next;
            if node->kind == "entry" || node->kind == EVENT_KIND {
            } else if node->kind == "return" {
                if node->value.length() == 0 {
                    emitter->Line(depth, "return;".copy());
                } else {
                    valueText: string! = Bare(Expression(function, emitter, node->value, 0));
                    emitter->Line(depth, `return ${valueText};`);
                    delete valueText;
                }
                nextId = "";
            } else if node->kind == "set" {
                if !IsName(node->name) {
                    emitter->Fail(function->name, `node '${node->id}' needs a local name`);
                } else {
                    valueText: string! = Bare(Expression(function, emitter, node->value, 0));
                    if node->typeName.length() > 0 {
                        emitter->Line(depth, `${node->name}~ ${node->typeName} = ${valueText};`);
                        emitter->declared.push(`${node->name}`);
                    } else if emitter->IsDeclared(node->name) || function->IndexOfInput(node->name) != null {
                        emitter->Line(depth, `${node->name} = ${valueText};`);
                    } else {
                        emitter->Fail(function->name, `node '${node->id}' sets '${node->name}' before it has a type`);
                    }
                    delete valueText;
                }
            } else if node->kind == "call" {
                callText: string! = CallExpression(function, emitter, node, 0);
                if node->name.length() > 0 && node->typeName.length() > 0 && IsName(node->name) {
                    emitter->Line(depth, `${node->name}~ ${node->typeName} = ${callText};`);
                    emitter->declared.push(`${node->name}`);
                } else if node->name.length() > 0 {
                    emitter->Fail(function->name, `node '${node->id}' needs a type to keep its result as '${node->name}'`);
                } else {
                    emitter->Line(depth, `${callText};`);
                }
                delete callText;
            } else if node->kind == "nyx" {
                if !IsBalanced(node->text) {
                    emitter->Fail(function->name, `node '${node->id}' has Nyx whose brackets do not balance`);
                } else {
                    snippetLines := node->text.lines();
                    for lineIndex~ usize = 0; lineIndex < snippetLines.length(); lineIndex++ {
                        emitter->Line(depth, `${snippetLines[lineIndex]}`);
                    }
                    delete snippetLines;
                    for declaredIndex~ usize = 0; declaredIndex < node->declares.length(); declaredIndex++ {
                        emitter->declared.push(`${node->declares[declaredIndex]}`);
                    }
                }
            } else if node->kind == "while" {
                conditionText: string! = Bare(Expression(function, emitter, node->condition, 0));
                emitter->Line(depth, `while ${conditionText} {`);
                delete conditionText;
                EmitChain(function, emitter, node->thenId, depth + 1);
                emitter->SetCurrent(node->id);
                emitter->Line(depth, "}".copy());
            } else if node->kind == "when" {
                subjectText: string! = Bare(Expression(function, emitter, node->a, 0));
                emitter->Line(depth, `when ${subjectText} {`);
                delete subjectText;
                for caseIndex~ usize = 0; caseIndex < node->arguments.length(); caseIndex++ {
                    matchText: string! = Bare(Expression(function, emitter, node->arguments[caseIndex], 0));
                    emitter->Line(depth + 1, `${matchText} -> {`);
                    delete matchText;
                    if caseIndex < node->targets.length() {
                        EmitChain(function, emitter, node->targets[caseIndex], depth + 2);
                        emitter->SetCurrent(node->id);
                    }
                    emitter->Line(depth + 1, "},".copy());
                }
                if node->elseId.length() > 0 {
                    emitter->Line(depth + 1, "default -> {".copy());
                    EmitChain(function, emitter, node->elseId, depth + 2);
                    emitter->SetCurrent(node->id);
                    emitter->Line(depth + 1, "}".copy());
                } else {
                    emitter->Line(depth + 1, "_".copy());
                }
                emitter->Line(depth, "}".copy());
            } else if node->kind == "branch" {
                conditionText: string! = Bare(Expression(function, emitter, node->condition, 0));
                emitter->Line(depth, `if ${conditionText} {`);
                delete conditionText;
                EmitChain(function, emitter, node->thenId, depth + 1);
                emitter->SetCurrent(node->id);
                if node->elseId.length() > 0 {
                    emitter->Line(depth, "} else {".copy());
                    EmitChain(function, emitter, node->elseId, depth + 1);
                    emitter->SetCurrent(node->id);
                }
                emitter->Line(depth, "}".copy());
            } else {
                emitter->Fail(function->name, `node '${node->id}' has kind '${node->kind}', which is not a step`);
            }
            currentId = nextId;
        }
        while emitter->declared.length() > declaredBefore {
            popped: string!? = emitter->declared.pop();
            delete popped;
        }
    }

    // The Nyx name for a graph: `bounce_pad` is `BouncePad`.
    NamespaceName :: (graphName: string) -> string! {
        result~ string! = "".copy();
        startsWord~ bool = true;
        for position~ usize = 0; position < graphName.length(); position++ {
            piece: string = graphName.substring(position, 1);
            if piece == "_" {
                startsWord = true;
            } else if startsWord {
                result += piece.toUpper();
                startsWord = false;
            } else {
                result += piece;
            }
        }
        return result!;
    }

    EmitFunction :: (function: GraphFunction*, emitter: Emitter~*) -> void {
        if !IsName(function->name) {
            emitter->Fail(function->name, "a function needs a name of letters, digits and underscores".copy());
            return;
        }
        header~ string! = `${function->name} :: (`;
        for index~ usize = 0; index < function->inputNames.length(); index++ {
            if !IsName(function->inputNames[index]) || function->inputTypes[index].length() == 0 {
                emitter->Fail(function->name, "an input needs a name and a type".copy());
                delete header;
                return;
            }
            if index > 0 {
                header += ", ";
            }
            header += `${function->inputNames[index]}: ${function->inputTypes[index]}`;
        }
        header += ") -> ";
        header += function->returns.length() > 0 ? function->returns : "void";
        header += " {";
        emitter->Line(1, header!);
        entryIndex~ i32 = -1;
        entryCount~ u32 = 0;
        for index~ usize = 0; index < function->nodes.length(); index++ {
            if function->nodes[index]->kind == "entry" {
                entryCount += 1;
                entryIndex = i32(index);
            }
        }
        if entryCount != 1 {
            emitter->Fail(function->name, `it needs exactly one entry node and has ${entryCount}`);
            return;
        }
        for variableIndex~ usize = 0; variableIndex < function->variableNames.length(); variableIndex++ {
            variableName: string = function->variableNames[variableIndex];
            variableType: string = function->variableTypes[variableIndex];
            if !IsName(variableName) || variableType.length() == 0 {
                emitter->Fail(function->name, "a variable needs a name and a type".copy());
                return;
            }
            initial: string = function->variableDefaults[variableIndex];
            emitter->Line(2, `${variableName}~ ${variableType} = ${initial};`);
            emitter->declared.push(`${variableName}`);
        }
        EmitChain(function, emitter, function->nodes[usize(entryIndex)]->id, 2);
        emitter->SetCurrent("");
        emitter->Line(1, "}".copy());
    }

    // One event's method in a Silhouette's behaviour class: `Update~: (frameTime: f32) -> void override { ... }`, with the
    // statements of the chain that starts at the event node.
    EmitEventMethod :: (function: GraphFunction*, emitter: Emitter~*, node: GraphNode*) -> void {
        timeName: string = EventTimeName(node->name);
        parameters: string! = timeName.length() > 0 ? `${timeName}: f32` : "".copy();
        emitter->Line(1, `${node->name}~: (${parameters}) -> void override {`);
        delete parameters;
        delete emitter->currentEvent;
        emitter->currentEvent = `${node->name}`;
        EmitChain(function, emitter, node->id, 2);
        delete emitter->currentEvent;
        emitter->currentEvent = "".copy();
        emitter->SetCurrent("");
        emitter->Line(1, "}".copy());
    }

    // A graph with event nodes as a class deriving from the game's SilhouetteBehaviour: the event function's variables are
    // fields, so a placed copy keeps them from one frame to the next; each event is a method; any other function is a
    // method too.
    EmitBehaviourClass :: (graph: Graph*, emitter: Emitter~*) -> void {
        className: string! = BehaviourClassName(graph->name);
        emitter->text += `${className} :: class : SilhouetteBehaviour {`;
        emitter->text += "\npublic:\n";
        eventFunctionCount~ u32 = 0;
        for function in graph->functions {
            if HasEvents(function) {
                eventFunctionCount += 1;
            }
        }
        if eventFunctionCount != 1 {
            emitter->Fail(graph->name, `a Silhouette graph needs its events in one function and has them in ${eventFunctionCount}`);
        }
        for function in graph->functions {
            if !HasEvents(function) {
                continue;
            }
            for variableIndex~ usize = 0; variableIndex < function->variableNames.length(); variableIndex++ {
                variableName: string = function->variableNames[variableIndex];
                variableType: string = function->variableTypes[variableIndex];
                if !IsName(variableName) || variableType.length() == 0 || variableName == ENTITY_PORT {
                    emitter->Fail(function->name, "a variable needs a name other than entity, and a type".copy());
                    break;
                }
                emitter->Line(1, `${variableName}~ ${variableType} = ${function->variableDefaults[variableIndex]};`);
                emitter->declared.push(`${variableName}`);
            }
        }
        emitter->text += "\n";
        emitter->Line(1, `${className}~: (entity: i64) : SilhouetteBehaviour(entity) { }`);
        for function in graph->functions {
            if !HasEvents(function) {
                continue;
            }
            for node in function->nodes {
                if node->kind == EVENT_KIND && !IsEventName(node->name) {
                    emitter->Fail(function->name, `node '${node->id}' is an event named '${node->name}', which is not BeginPlay, Update or FixedUpdate`);
                }
            }
            eventNames: Array<string>! = EventNames();
            for eventName in eventNames {
                count~ u32 = 0;
                for node in function->nodes {
                    if node->kind == EVENT_KIND && node->name == eventName {
                        count += 1;
                    }
                }
                if count > 1 {
                    emitter->Fail(function->name, `it has ${count} ${eventName} events, and an event may appear once`);
                }
                if eventIndex := IndexOfEvent(function, eventName) {
                    emitter->text += "\n";
                    EmitEventMethod(function, emitter, function->nodes[eventIndex]);
                }
            }
            delete eventNames;
        }
        while emitter->declared.length() > 0 {
            popped: string!? = emitter->declared.pop();
            delete popped;
        }
        for function in graph->functions {
            if HasEvents(function) {
                continue;
            }
            emitter->text += "\n";
            EmitFunction(function, emitter);
        }
        emitter->text += "}\n";
        delete className;
    }

    // The import lines for the standard library namespaces a graph's call nodes name (`Math:::sin` needs
    // `Math :: import standard:::Math;`), one per namespace, in a fixed order.
    StandardImports :: (graph: Graph*) -> string! {
        names: Array<string>! = "Math,Json,Console,File,Directory,DateTime,Log,Debug".split(",");
        imports~ string! = "".copy();
        for nameIndex~ usize = 0; nameIndex < names.length(); nameIndex++ {
            prefix: string! = `${names[nameIndex]}:::`;
            isUsed~ bool = false;
            for functionIndex~ usize = 0; functionIndex < graph->functions.length(); functionIndex++ {
                function: GraphFunction* = graph->functions[functionIndex];
                for nodeIndex~ usize = 0; nodeIndex < function->nodes.length(); nodeIndex++ {
                    node: GraphNode* = function->nodes[nodeIndex];
                    if node->kind == "call" && node->functionPath.startsWith(prefix) {
                        isUsed = true;
                    }
                }
            }
            if isUsed {
                imports += `${names[nameIndex]} :: import standard:::${names[nameIndex]};`;
                imports += "\n";
            }
            delete prefix;
        }
        delete names;
        return imports!;
    }

    // The Nyx source of a graph, or the first problem found.
    GenerateNyx :: (graph: Graph*) -> Result<string!, string!> {
        return GenerateNyxWith(graph, false);
    }

    // The same Nyx with `  //@<node id>` after each line a node wrote, for finding the node behind a line.
    GenerateNyxWith :: (graph: Graph*, annotate: bool) -> Result<string!, string!> {
        emitter := new Emitter();
        emitter->annotate = annotate;
        if IsEventGraph(graph) {
            emitter->text += `// Generated from the graph of the ${graph->name} Silhouette by lantern:::graphs. Edit the graph, not this file.`;
            emitter->text += "\nSilhouetteBehaviour :: import SilhouetteBehaviour;\n";
            eventImports: string! = StandardImports(graph);
            emitter->text += eventImports;
            delete eventImports;
            EmitBehaviourClass(graph, emitter);
            if emitter->problem.length() > 0 {
                eventFailure: string! = `${emitter->problem}`;
                delete emitter;
                return Result<string!, string!>:::Err(eventFailure!);
            }
            eventSource: string! = `${emitter->text}`;
            delete emitter;
            return Result<string!, string!>:::Ok(eventSource!);
        }
        namespaceName: string! = NamespaceName(graph->name);
        emitter->text += `// Generated from ${graph->name}.graph.json by lantern:::graphs. Edit the graph, not this file.`;
        emitter->text += "\n";
        standardImports: string! = StandardImports(graph);
        emitter->text += standardImports;
        delete standardImports;
        emitter->text += `${namespaceName} :: namespace {`;
        emitter->text += "\n";
        delete namespaceName;
        for index~ usize = 0; index < graph->functions.length(); index++ {
            if index > 0 {
                emitter->text += "\n";
            }
            EmitFunction(graph->functions[index], emitter);
        }
        emitter->text += "}\n";
        if emitter->problem.length() > 0 {
            failure: string! = `${emitter->problem}`;
            delete emitter;
            return Result<string!, string!>:::Err(failure!);
        }
        source: string! = `${emitter->text}`;
        delete emitter;
        return Result<string!, string!>:::Ok(source!);
    }

    // The id of the node that wrote a line of the generated Nyx (1 is the first line), or "" for a line no node wrote.
    NodeAtLine :: (graph: Graph*, lineNumber: u32) -> string! {
        when GenerateNyxWith(graph, true) {
            Result:::Err(message) -> {
                delete message;
                return "".copy();
            },
            Result:::Ok(source) -> {
                defer delete source;
                rows := source.lines();
                defer delete rows;
                if lineNumber == 0 || usize(lineNumber) > rows.length() {
                    return "".copy();
                }
                row: string = rows[usize(lineNumber) - 1];
                marker: string = "  //@";
                position := row.indexOf(marker, 0);
                guard found := position return "".copy();
                return `${row.substring(found + marker.length(), row.length() - found - marker.length())}`;
            }
        }
    }

    // Reads a graph file and generates its Nyx in one step.
    GenerateNyxFromText :: (jsonText: string) -> Result<string!, string!> {
        when LoadGraph(jsonText) {
            Result:::Err(message) -> {
                return Result<string!, string!>:::Err(message!);
            },
            Result:::Ok(graph) -> {
                result := GenerateNyx(graph);
                delete graph;
                return result!;
            }
        }
    }
}
