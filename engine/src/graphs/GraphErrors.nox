lantern:::graphs :: namespace {
    GENERATED_FOLDER: string : "/generated/";
    GENERATED_HEADER: string : "// Generated from ";
    GRAPH_FILE_SUFFIX: string : ".graph.json";

    ERROR_FILE_VARIABLE: string : "LANTERN_ERROR_FILE";

    // When the editor started the game it names a file in LANTERN_ERROR_FILE; a script error is written there (replacing what was
    // there) so the editor can show which graph node failed.
    WriteErrorForEditor :: (message: string) -> void {
        target: string!? = environmentVariable(ERROR_FILE_VARIABLE);
        if path := target {
            when writeTextFile(path, message) {
                Result:::Ok(written) -> { },
                Result:::Err(error) -> {
                    delete error;
                }
            }
        }
        delete target;
    }

    // The graph and node a script error's text names ("graph crumble_phase, node isIdle"), as "crumble_phase\nisIdle", or "" when it names none.
    FailureFromText :: (message: string) -> string! {
        graphAt: usize? = message.indexOf("graph ", 0);
        if graphAt == null {
            return "".copy();
        }
        graphStart~ usize = 0;
        if present := graphAt {
            graphStart = present + 6;
        }
        separatorAt: usize? = message.indexOf(", node ", graphStart);
        if separatorAt == null {
            return "".copy();
        }
        separator~ usize = 0;
        if present := separatorAt {
            separator = present;
        }
        nodeStart: usize = separator + 7;
        nodeEnd~ usize = nodeStart;
        while nodeEnd < message.length() && message.byteAt(nodeEnd) != 10 && message.byteAt(nodeEnd) != 41 && message.byteAt(nodeEnd) != 92 && message.byteAt(nodeEnd) != 32 {
            nodeEnd += 1;
        }
        located~ string! = `${message.substring(graphStart, separator - graphStart)}`;
        located += "\n";
        located += message.substring(nodeStart, nodeEnd - nodeStart);
        return located!;
    }

    // "graph crumble_phase, node isIdle" for a line of a generated graph file (a `.nyx` under a `generated` folder whose
    // first line says which graph wrote it), or "" when the file is not one, can't be read, or the line was written by no node.
    DescribeGraphLine :: (generatedPath: string, lineNumber: i32) -> string! {
        folderAt: usize? = generatedPath.lastIndexOf(GENERATED_FOLDER);
        if folderAt == null || lineNumber < 1 {
            return "".copy();
        }
        folderEnd~ usize = 0;
        if present := folderAt {
            folderEnd = present;
        }
        when readTextFile(generatedPath) {
            Result:::Err(error) -> {
                delete error;
                return "".copy();
            },
            Result:::Ok(generatedText) -> {
                defer delete generatedText;
                headerLine: string = generatedText.lines()[0];
                if !headerLine.startsWith(GENERATED_HEADER) {
                    return "".copy();
                }
                rest: string = headerLine.substring(GENERATED_HEADER.length(), headerLine.length() - GENERATED_HEADER.length());
                suffixAt: usize? = rest.indexOf(GRAPH_FILE_SUFFIX, 0);
                if suffixAt == null {
                    return "".copy();
                }
                graphName~ string = "";
                if present := suffixAt {
                    graphName = rest.substring(0, present);
                }
                graphPath: string! = `${generatedPath.substring(0, folderEnd)}/${graphName}${GRAPH_FILE_SUFFIX}`;
                defer delete graphPath;
                when readTextFile(graphPath) {
                    Result:::Err(error) -> {
                        delete error;
                        return "".copy();
                    },
                    Result:::Ok(graphText) -> {
                        defer delete graphText;
                        when LoadGraph(graphText) {
                            Result:::Err(message) -> {
                                delete message;
                                return "".copy();
                            },
                            Result:::Ok(graph) -> {
                                defer delete graph;
                                nodeId: string! = NodeAtLine(graph, u32(lineNumber));
                                defer delete nodeId;
                                if nodeId.length() == 0 {
                                    return "".copy();
                                }
                                return `graph ${graphName}, node ${nodeId}`;
                            }
                        }
                    }
                }
            }
        }
    }
}
