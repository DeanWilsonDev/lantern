// Where a node's pins are. The canvas draws them and hits them, and the editor tab names them, so the layout lives in one place.
// A node is a header (its title, the execution-in pin on the left and the value-out pin on the right) over numbered rows, each
// with a value-in pin on the left and an execution-out or value pin on the right.
lantern:::graphs :: namespace {
    NODE_WIDTH: i32 : 168;
    HEADER_HEIGHT: i32 : 18;
    ROW_HEIGHT: i32 : 16;
    PIN_HIT_RADIUS: i32 : 7;
    REROUTE_WIDTH: i32 : 44;

    // A reroute is a small knot on a wire, so it is drawn narrow and with no rows.
    NodeWidth :: (kind: string) -> i32 {
        return kind == "reroute" ? REROUTE_WIDTH : NODE_WIDTH;
    }

    // One pin of a node. `port` is what SetPort takes (`next`, `a`, `arg0`) and `in` or `out` for the header's two pins.
    PinSlot :: class {
    public:
        port~ string!;
        label~ string!;
        isExecution~ bool;
        isOutput~ bool;
        row~ i32;
        width~ i32 = NODE_WIDTH;

        PinSlot~: (newPort: string, newLabel: string, newIsExecution: bool, newIsOutput: bool, newRow: i32) {
            port = `${newPort}`;
            label = `${newLabel}`;
            isExecution = newIsExecution;
            isOutput = newIsOutput;
            row = newRow;
        }

        !PinSlot~: () {
            delete port;
            delete label;
        }

        // The pin's centre, relative to the node's top left.
        OffsetX :: () -> i32 {
            if isOutput {
                return width;
            }
            return 0;
        }

        OffsetY :: () -> i32 {
            if row == 0 {
                return HEADER_HEIGHT / 2;
            }
            return HEADER_HEIGHT + (row - 1) * ROW_HEIGHT + ROW_HEIGHT / 2;
        }
    }

    PinList :: class {
    public:
        items~ Array<PinSlot*!>! = [];
        rowCount~ i32 = 0;
        width~ i32 = NODE_WIDTH;
        isCompact~ bool = false;

        PinList~: () { }

        !PinList~: () {
            items.freeAll();
        }

        Add~: (port: string, label: string, isExecution: bool, isOutput: bool, row: i32) -> void {
            slot~ PinSlot*! = new PinSlot(port, label, isExecution, isOutput, row);
            slot->width = width;
            items.push(slot!);
            if row > rowCount {
                rowCount = row;
            }
        }
    }

    IsExecutionKind :: (kind: string) -> bool {
        return kind == "entry" || kind == EVENT_KIND || kind == "return" || kind == "set" || kind == "branch" || kind == "while" || kind == "when" || kind == "call" || kind == "nyx";
    }

    GivesValue :: (kind: string) -> bool {
        return kind == "call" || kind == "nyx_value" || kind == "get" || kind == "not" || kind == "reroute" || OperatorFor(kind).length() > 0;
    }

    // The text beside a value pin: its port, and what feeds it when that isn't a wire.
    ValueLabel :: (function: GraphFunction*, port: string, reference: string) -> string! {
        if reference.length() == 0 {
            return `${port}`;
        }
        if function->IndexOfNode(reference) != null {
            return `${port}`;
        }
        if reference.startsWith(LITERAL_MARK) {
            return `${port} = ${reference.substring(1, reference.length() - 1)}`;
        }
        return `${port} = ${reference}`;
    }

    // The port that holds a node's link for a pin (what SetPort takes), for reading back its reference.
    PortReference :: (node: GraphNode*, port: string) -> string {
        if port == "next" {
            return node->next;
        }
        if port == "then" {
            return node->thenId;
        }
        if port == "else" {
            return node->elseId;
        }
        if port == "a" {
            return node->a;
        }
        if port == "b" {
            return node->b;
        }
        if port == "value" {
            return node->value;
        }
        if port == "condition" {
            return node->condition;
        }
        if port.startsWith("case") {
            caseNumber: usize = PortNumber(port, 4);
            if caseNumber < node->targets.length() {
                return node->targets[caseNumber];
            }
            return "";
        }
        if port.startsWith("arg") {
            argumentNumber~ usize = 0;
            digits: string = port.substring(3, port.length() - 3);
            for digit~ usize = 0; digit < digits.length(); digit++ {
                argumentNumber = argumentNumber * 10 + usize(digits.byteAt(digit) - 48);
            }
            if argumentNumber < node->arguments.length() {
                return node->arguments[argumentNumber];
            }
        }
        return "";
    }

    // Every pin of a node, in rows.
    PinsOf :: (function: GraphFunction*, node: GraphNode*) -> PinList*! {
        pins := new PinList();
        kind: string = node->kind;
        pins->width = NodeWidth(kind);
        if IsMaterialNodeKind(kind) {
            MaterialPins(function, node, pins);
            return pins!;
        }
        if kind == "reroute" {
            pins->isCompact = true;
            pins->Add("a", "", false, false, 0);
            pins->Add("out", "", false, true, 0);
            return pins!;
        }
        if IsExecutionKind(kind) && kind != "entry" && kind != EVENT_KIND {
            pins->Add("in", "", true, false, 0);
        }
        if GivesValue(kind) {
            pins->Add("out", "", false, true, 0);
        }
        if kind == "entry" {
            pins->Add("next", "next", true, true, 1);
        } else if kind == EVENT_KIND {
            pins->Add("next", "next", true, true, 1);
            pins->Add(ENTITY_PORT, ENTITY_PORT, false, true, 2);
            timeName: string = EventTimeName(node->name);
            if timeName.length() > 0 {
                pins->Add(timeName, timeName, false, true, 3);
            }
        } else if kind == "return" {
            label: string! = ValueLabel(function, "value", node->value);
            pins->Add("value", label, false, false, 1);
            delete label;
        } else if kind == "set" {
            label: string! = ValueLabel(function, "value", node->value);
            pins->Add("value", label, false, false, 1);
            delete label;
            pins->Add("next", "next", true, true, 1);
        } else if kind == "branch" {
            label: string! = ValueLabel(function, "condition", node->condition);
            pins->Add("condition", label, false, false, 1);
            delete label;
            pins->Add("then", "then", true, true, 1);
            pins->Add("else", "else", true, true, 2);
            pins->Add("next", "after", true, true, 3);
        } else if kind == "while" {
            label: string! = ValueLabel(function, "condition", node->condition);
            pins->Add("condition", label, false, false, 1);
            delete label;
            pins->Add("then", "body", true, true, 1);
            pins->Add("next", "after", true, true, 2);
        } else if kind == "when" {
            label: string! = ValueLabel(function, "a", node->a);
            pins->Add("a", label, false, false, 1);
            delete label;
            caseCount: i32 = i32(node->arguments.length()) + 1;
            for caseIndex~ i32 = 0; caseIndex < caseCount; caseIndex++ {
                port: string! = `case${caseIndex}`;
                caseLabel~ string! = `case ${caseIndex}`;
                if usize(caseIndex) < node->arguments.length() && node->arguments[usize(caseIndex)].length() > 0 {
                    delete caseLabel;
                    caseLabel = ValueLabel(function, port, node->arguments[usize(caseIndex)]);
                }
                pins->Add(port, caseLabel, true, true, caseIndex + 1);
                delete caseLabel;
                delete port;
            }
            pins->Add("else", "else", true, true, caseCount + 1);
            pins->Add("next", "after", true, true, caseCount + 2);
        } else if kind == "call" {
            count~ i32 = i32(node->arguments.length());
            if count < 1 {
                count = 1;
            }
            for argument~ i32 = 0; argument < count; argument++ {
                port: string! = `arg${argument}`;
                reference~ string = "";
                if usize(argument) < node->arguments.length() {
                    reference = node->arguments[usize(argument)];
                }
                label: string! = ValueLabel(function, port, reference);
                pins->Add(port, label, false, false, argument + 1);
                delete label;
                delete port;
            }
            pins->Add("next", "next", true, true, 1);
        } else if kind == "nyx" {
            pins->Add("next", "next", true, true, 1);
        } else if kind == "not" || kind == "reroute" {
            label: string! = ValueLabel(function, "a", node->a);
            pins->Add("a", label, false, false, 1);
            delete label;
        } else if OperatorFor(kind).length() > 0 {
            labelA: string! = ValueLabel(function, "a", node->a);
            pins->Add("a", labelA, false, false, 1);
            delete labelA;
            labelB: string! = ValueLabel(function, "b", node->b);
            pins->Add("b", labelB, false, false, 2);
            delete labelB;
        }
        return pins!;
    }

    // How tall a node is drawn.
    NodeHeight :: (pins: PinList*) -> i32 {
        rows~ i32 = pins->rowCount;
        if pins->isCompact {
            return HEADER_HEIGHT;
        }
        if rows < 1 {
            rows = 1;
        }
        return HEADER_HEIGHT + rows * ROW_HEIGHT + 4;
    }
}
