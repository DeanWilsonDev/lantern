lantern:::world :: namespace {
    /**
     * One entity of a world file made ready to use: its matrices, a mesh built from its shape (if it has one), its tint and
     * its collider kind. The level loader turns each piece into a renderable, a collider or both. The mesh is owned by
     * the piece.
     */
    WorldPiece :: class {
    public:
        entityIndex~ usize = 0;
        key~ u64 = 0;
        parent~ u64? = null;
        localMatrix~ Mat4 = Mat4 { };
        worldMatrix~ Mat4 = Mat4 { };
        mesh~ lantern:::renderer:::MeshData*!? = null;
        tint~ lantern:::core:::Color = lantern:::core:::Color { r: 1.0f, g: 1.0f, b: 1.0f, a: 1.0f };
        collider~ ColliderKind? = null;

        WorldPiece~: () { }

        !WorldPiece~: () {
            delete mesh;
        }

        /**
         * True when the entity has a shape.
         */
        HasMesh :: () -> bool {
            return mesh != null;
        }

        /**
         * The mesh's triangles moved to their place in the world, for building a static collider.
         */
        WorldTriangles :: () -> Array<lantern:::physics:::Triangle>! {
            return TrianglesWith(worldMatrix);
        }

        /**
         * The mesh's triangles in the entity's own space, for a moving body (which is moved by a matrix later).
         */
        LocalTriangles :: () -> Array<lantern:::physics:::Triangle>! {
            return TrianglesWith(Mat4 { });
        }

        /**
         * The mesh's triangles moved by a matrix. Empty when there is no mesh.
         */
        TrianglesWith :: (matrix: Mat4) -> Array<lantern:::physics:::Triangle>! {
            triangles~ Array<lantern:::physics:::Triangle>! = [];
            if shapeMesh := mesh {
                meshTriangles: Array<lantern:::renderer:::Triangle>! = shapeMesh->Triangles();
                for triangle in meshTriangles {
                    triangles.push(lantern:::physics:::Triangle:::Create(
                        lantern:::core:::TransformPoint3(matrix, triangle.first),
                        lantern:::core:::TransformPoint3(matrix, triangle.second),
                        lantern:::core:::TransformPoint3(matrix, triangle.third)));
                }
                delete meshTriangles;
            }
            return triangles!;
        }
    }

    /**
     * The mesh for a shape: a box, or a ramp.
     */
    ShapeMesh :: (shape: Shape) -> lantern:::renderer:::MeshData*! {
        if shape.kind == ShapeKind:::Box {
            return lantern:::renderer:::BoxMesh(shape.halfExtents, true);
        }
        return lantern:::renderer:::Ramp(shape.width, shape.height, shape.length);
    }

    /**
     * The entity's transform in the world: its own transform times its parent's, up the chain. A parent that can't be
     * found ends the chain, and the length limit stops a loop of parents from spinning forever.
     */
    WorldMatrix :: (worldFile: WorldFile*, entityIndex: usize) -> Mat4 {
        chain~ Array<usize>! = [];
        chain.push(entityIndex);
        current~ u64? = worldFile->entities[entityIndex]->parent;
        while current != null && chain.length() <= worldFile->entities.length() {
            key: u64 = current ?? 0;
            found: usize? = worldFile->IndexOf(key);
            guard parentIndex := found break;
            chain.push(parentIndex);
            current = worldFile->entities[parentIndex]->parent;
        }
        matrix~ Mat4 = worldFile->entities[chain[chain.length() - 1]]->transform.Matrix();
        for step~ usize = chain.length() - 1; step > 0; step-- {
            matrix = matrix * worldFile->entities[chain[step - 1]]->transform.Matrix();
        }
        delete chain;
        return matrix;
    }

    /**
     * The world matrix of every entity, in file order.
     */
    WorldMatrices :: (worldFile: WorldFile*) -> Array<Mat4>! {
        matrices~ Array<Mat4>! = [];
        for index~ usize = 0; index < worldFile->entities.length(); index++ {
            matrices.push(WorldMatrix(worldFile, index));
        }
        return matrices!;
    }

    /**
     * Builds the piece for one entity of the file.
     */
    BuildPiece :: (worldFile: WorldFile*, index: usize) -> WorldPiece*! {
        entity: WorldEntity* = worldFile->entities[index];
        piece := new WorldPiece();
        piece->entityIndex = index;
        piece->key = entity->id;
        piece->parent = entity->parent;
        piece->localMatrix = entity->transform.Matrix();
        piece->worldMatrix = WorldMatrix(worldFile, index);
        if shape := entity->shape {
            piece->mesh = ShapeMesh(shape);
        } else {
            piece->mesh = lantern:::terrain:::TerrainMeshForEntity(entity);
        }
        piece->tint = entity->TintColor();
        piece->collider = entity->collider;
        return piece!;
    }

    /**
     * Builds a piece for every entity in the file, in file order.
     */
    BuildPieces :: (worldFile: WorldFile*) -> Array<WorldPiece*!>! {
        pieces~ Array<WorldPiece*!>! = [];
        for index~ usize = 0; index < worldFile->entities.length(); index++ {
            pieces.push(BuildPiece(worldFile, index));
        }
        return pieces!;
    }
}
