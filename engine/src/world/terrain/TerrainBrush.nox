lantern:::terrain :: namespace {
    /**
     * What a sculpting brush does to the ground under it.
     */
    BrushKind :: enum {
        Raise,
        Lower,
        Smooth,
        Flatten,
        Noise,
        Terrace,
        Erode
    }

    /**
     * How a brush's weight falls from its centre to its edge: `Smooth` eases (the default), `Linear` falls in a straight
     * line, `Sharp` stays low until near the centre, and `Constant` is the same everywhere inside the radius.
     */
    BrushFalloff :: enum {
        Smooth,
        Linear,
        Sharp,
        Constant
    }

    /**
     * Everything one dab needs besides where it lands. `strength` is metres at the centre for raise, lower and noise and
     * between 0 and 1 for the others. `flattenHeight` is the level flatten pulls toward, `terraceStep` the height between
     * terrace levels, `noiseSeed` and `noiseScale` pick the bumps the noise brush makes.
     */
    BrushSettings :: struct {
        kind~ BrushKind = BrushKind:::Raise;
        falloff~ BrushFalloff = BrushFalloff:::Smooth;
        radius~ f32 = 4.0f;
        strength~ f32 = 0.5f;
        flattenHeight~ f32 = 0.0f;
        terraceStep~ f32 = 1.0f;
        noiseSeed~ u32 = 1;
        noiseScale~ f32 = 2.0f;
    }

    /**
     * A brush's weight at a distance from its centre: 1 in the middle, 0 at `radius` and beyond, easing between so the
     * edge of a stroke has no step.
     */
    BrushWeight :: (distance: f32, radius: f32) -> f32 {
        return ShapedWeight(distance, radius, BrushFalloff:::Smooth);
    }

    /**
     * The same with a chosen falloff shape. `Constant` is 1 everywhere inside the radius.
     */
    ShapedWeight :: (distance: f32, radius: f32, falloff: BrushFalloff) -> f32 {
        if radius <= 0.0f || distance >= radius {
            return 0.0f;
        }
        remaining: f32 = 1.0f - distance / radius;
        when falloff {
            BrushFalloff:::Smooth -> { return remaining * remaining * (3.0f - 2.0f * remaining); },
            BrushFalloff:::Linear -> { return remaining; },
            BrushFalloff:::Sharp -> { return remaining * remaining * remaining; },
            BrushFalloff:::Constant -> { return 1.0f; }
        }
    }

    /**
     * The text for a falloff shape, as the editor spells it.
     */
    FalloffName :: (falloff: BrushFalloff) -> string {
        when falloff {
            BrushFalloff:::Smooth -> { return "smooth"; },
            BrushFalloff:::Linear -> { return "linear"; },
            BrushFalloff:::Sharp -> { return "sharp"; },
            BrushFalloff:::Constant -> { return "constant"; }
        }
    }

    /**
     * The text for a brush, as the editor and files spell it.
     */
    BrushName :: (kind: BrushKind) -> string {
        when kind {
            BrushKind:::Raise -> { return "raise"; },
            BrushKind:::Lower -> { return "lower"; },
            BrushKind:::Smooth -> { return "smooth"; },
            BrushKind:::Flatten -> { return "flatten"; },
            BrushKind:::Noise -> { return "noise"; },
            BrushKind:::Terrace -> { return "terrace"; },
            BrushKind:::Erode -> { return "erode"; }
        }
    }

    /**
     * The brush a name stands for, or null.
     */
    BrushFromName :: (name: string) -> BrushKind? {
        if name == "raise" {
            return BrushKind:::Raise;
        }
        if name == "lower" {
            return BrushKind:::Lower;
        }
        if name == "smooth" {
            return BrushKind:::Smooth;
        }
        if name == "flatten" {
            return BrushKind:::Flatten;
        }
        if name == "noise" {
            return BrushKind:::Noise;
        }
        if name == "terrace" {
            return BrushKind:::Terrace;
        }
        if name == "erode" {
            return BrushKind:::Erode;
        }
        return null;
    }

    /**
     * Applies one dab of a brush with the default smooth falloff, centred at `centerX`, `centerZ` in the terrain's own
     * space, `radius` metres wide.
     *
     * `strength` is between 0 and 1 for smooth and flatten (how much of the way each vertex goes toward the result) and
     * is the metres moved at the centre for raise and lower. `flattenHeight` is the level flatten pulls toward. Returns
     * how many vertices changed.
     */
    ApplyBrush :: (
        field: Heightfield~*,
        kind: BrushKind,
        centerX: f32,
        centerZ: f32,
        radius: f32,
        strength: f32,
        flattenHeight: f32
    ) -> usize {
        settings~ BrushSettings = BrushSettings { };
        settings.kind = kind;
        settings.radius = radius;
        settings.strength = strength;
        settings.flattenHeight = flattenHeight;
        return ApplyShapedBrush(field, centerX, centerZ, settings);
    }

    /**
     * Applies one dab of a brush described by `settings`, centred at `centerX`, `centerZ` in the terrain's own space. Returns
     * how many vertices changed. Erode shaves any slope steeper than 0.8 (rise over run) a little; it does not carry the
     * material downhill, which the whole-terrain erosion does.
     */
    ApplyShapedBrush :: (
        field: Heightfield~*,
        centerX: f32,
        centerZ: f32,
        settings: BrushSettings
    ) -> usize {
        kind: BrushKind = settings.kind;
        radius: f32 = settings.radius;
        strength: f32 = settings.strength;
        half: f32 = field->HalfSpan();
        lastIndex: i32 = i32(field->columns) - 1;
        firstColumn: i32 = Math:::max(
            0,
            i32(Math:::floor((centerX - radius + half) / field->cellSize))
        );
        lastColumn: i32 = Math:::min(
            lastIndex,
            i32(Math:::ceil((centerX + radius + half) / field->cellSize))
        );
        firstRow: i32 = Math:::max(
            0,
            i32(Math:::floor((centerZ - radius + half) / field->cellSize))
        );
        lastRow: i32 = Math:::min(
            lastIndex,
            i32(Math:::ceil((centerZ + radius + half) / field->cellSize))
        );
        before: Heightfield*! = field->Copy();
        defer delete before;
        changed~ usize = 0;
        for row~ i32 = firstRow; row <= lastRow; row++ {
            for column~ i32 = firstColumn; column <= lastColumn; column++ {
                offsetX: f32 = field->LocalCoordinate(u32(column)) - centerX;
                offsetZ: f32 = field->LocalCoordinate(u32(row)) - centerZ;
                weight: f32 = ShapedWeight(
                    Math:::sqrt(offsetX * offsetX + offsetZ * offsetZ),
                    radius,
                    settings.falloff
                );
                if weight <= 0.0f {
                    continue;
                }
                current: f32 = before->HeightAtVertex(u32(column), u32(row));
                result~ f32 = current;
                when kind {
                    BrushKind:::Raise -> { result = current + strength * weight; },
                    BrushKind:::Lower -> { result = current - strength * weight; },
                    BrushKind:::Smooth -> {
                        left: u32 = column > 0 ? u32(column - 1) : u32(column);
                        right: u32 = column < lastIndex ? u32(column + 1) : u32(column);
                        back: u32 = row > 0 ? u32(row - 1) : u32(row);
                        front: u32 = row < lastIndex ? u32(row + 1) : u32(row);
                        average: f32 = (before->HeightAtVertex(
                            left,
                            u32(row)
                        ) + before->HeightAtVertex(
                            right,
                            u32(row)
                        ) + before->HeightAtVertex(
                            u32(column),
                            back
                        ) + before->HeightAtVertex(u32(column), front) + current * 4.0f) / 8.0f;
                        result = Math:::lerp(
                            current,
                            average,
                            Math:::clamp(strength * weight, 0.0f, 1.0f)
                        );
                    },
                    BrushKind:::Flatten -> {
                        result = Math:::lerp(
                            current,
                            settings.flattenHeight,
                            Math:::clamp(strength * weight, 0.0f, 1.0f)
                        );
                    },
                    BrushKind:::Noise -> {
                        bump: f32 = GradientNoise(
                            field->LocalCoordinate(u32(column)) / settings.noiseScale,
                            field->LocalCoordinate(u32(row)) / settings.noiseScale,
                            settings.noiseSeed
                        );
                        result = current + bump * strength * weight;
                    },
                    BrushKind:::Terrace -> {
                        step: f32 = Math:::max(settings.terraceStep, 0.01f);
                        level: f32 = Math:::round(current / step) * step;
                        result = Math:::lerp(
                            current,
                            level,
                            Math:::clamp(strength * weight, 0.0f, 1.0f)
                        );
                    },
                    BrushKind:::Erode -> {
                        lowest~ f32 = current;
                        for direction~ u32 = 0; direction < 4; direction++ {
                            neighbourColumn~ i32 = column;
                            neighbourRow~ i32 = row;
                            if direction == 0 {
                                neighbourColumn -= 1;
                            } else if direction == 1 {
                                neighbourColumn += 1;
                            } else if direction == 2 {
                                neighbourRow -= 1;
                            } else {
                                neighbourRow += 1;
                            }
                            if neighbourColumn < 0 || neighbourRow < 0 ||
                                neighbourColumn > lastIndex || neighbourRow > lastIndex {
                                continue;
                            }
                            lowest = Math:::min(
                                lowest,
                                before->HeightAtVertex(u32(neighbourColumn), u32(neighbourRow))
                            );
                        }
                        excess: f32 = current - lowest - 0.8f * field->cellSize;
                        if excess > 0.0f {
                            result = current - excess * 0.5f * Math:::clamp(
                                strength * weight,
                                0.0f,
                                1.0f
                            );
                        }
                    }
                }
                if result != current {
                    field->SetHeight(u32(column), u32(row), result);
                    changed += 1;
                }
            }
        }
        return changed;
    }
}
