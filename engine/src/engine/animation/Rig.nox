lantern:::animation :: namespace {
    /**
     * Everything an animated character shares between its instances: the skeleton and the clips that move it. A game
     * makes one rig per kind of character and an `Animator` for each character on screen, so the player and the
     * companion can share one set of clips.
     */
    Rig :: class {
    public:
        /** The joints. */
        skeleton~ Skeleton*!;
        /** The clips, in the order they were added; states refer to them by index. */
        clips~ Array<AnimationClip*!>! = [];

        /** An empty rig. */
        Rig~: () {
            skeleton = new Skeleton();
        }

        /** Frees the skeleton and the clips. */
        !Rig~: () {
            delete skeleton;
            clips.freeAll();
        }

        /** Adds a clip and returns its index. */
        AddClip~: (clip: AnimationClip*!) -> i32 {
            clips.push(clip!);
            return i32(clips.length()) - 1;
        }

        /** The clip's index, or -1 when no clip has that name. */
        FindClip :: (name: string) -> i32 {
            for index~ usize = 0; index < clips.length(); index++ {
                if clips[index]->name == name {
                    return i32(index);
                }
            }
            return -1;
        }
    }
}
