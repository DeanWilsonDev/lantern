lantern:::engine :: namespace {
    /**
     * The marker type for entity handles: a `Handle<EntityTag>` is an entity's id. A handle holds a slot and a generation, so
     * the id of a despawned entity stops matching and can't touch whatever reuses its slot.
     */
    EntityTag :: struct { }

    /**
     * A group an entity belongs to, so a whole group can be removed in one call (`DespawnScene`). The game's level is one
     * scene.
     */
    SceneId :: struct {
        value~ u32 = 0;

        operator == :: (other: SceneId) -> bool {
            return value == other.value;
        }
    }

    /**
     * The scene for entities that survive a level change.
     */
    PersistentScene :: () -> SceneId {
        return SceneId { value: 0 };
    }

    /**
     * A position, a rotation and a scale. It is what an entity stores; the matrix is made when needed.
     */
    Transform :: struct {
        translation~ Vec3 = Vec3 { };
        rotation~ Quaternion = Quaternion { };
        scale~ Vec3 = Vec3 { x: 1.0f, y: 1.0f, z: 1.0f };

        /**
         * No movement, no turn, scale 1.
         */
        static Identity :: () -> Transform {
            return Transform { };
        }

        /**
         * A transform that only moves.
         */
        static FromTranslation :: (translation: Vec3) -> Transform {
            return Transform { translation: translation };
        }

        /**
         * The transform a matrix stands for, found by taking the matrix apart (see DecomposeMatrix).
         */
        static FromMatrix :: (matrix: Mat4) -> Transform {
            parts: lantern:::core:::MatrixParts = lantern:::core:::DecomposeMatrix(matrix);
            return Transform { translation: parts.translation, rotation: parts.rotation, scale: parts.scale };
        }

        /**
         * The same transform with another rotation.
         */
        WithRotation :: (newRotation: Quaternion) -> Transform {
            return Transform { translation: translation, rotation: newRotation, scale: scale };
        }

        /**
         * The same transform with another scale.
         */
        WithScale :: (newScale: Vec3) -> Transform {
            return Transform { translation: translation, rotation: rotation, scale: newScale };
        }

        /**
         * The transform as a matrix: scale, then rotate, then move.
         */
        Matrix :: () -> Mat4 {
            return lantern:::core:::MatrixFromScaleRotationTranslation(scale, rotation, translation);
        }

        /**
         * The transform `amount` of the way to another: positions and scales blend straight, and rotations by slerp.
         */
        Lerp :: (other: Transform, amount: f32) -> Transform {
            return Transform {
                translation: lantern:::core:::Lerp3(translation, other.translation, amount),
                rotation: lantern:::core:::QuaternionSlerp(rotation, other.rotation, amount),
                scale: lantern:::core:::Lerp3(scale, other.scale, amount)
            };
        }
    }

    /**
     * How an entity is drawn: a mesh, an optional texture and normal map, a colour, whether it is visible, a material
     * (how shiny, metal or glowing it is) and whether it casts a shadow. An entity with no MeshRenderer is just a
     * position, like a spawn point.
     */
    MeshRenderer :: struct {
        mesh~ lantern:::core:::Handle<lantern:::renderer:::MeshTag> = lantern:::core:::Handle<lantern:::renderer:::MeshTag> { };
        texture~ lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = null;
        /** A normal map for fine surface bumps, or null; its strength is `material.normalStrength`. */
        normalTexture~ lantern:::core:::Handle<lantern:::renderer:::TextureTag>? = null;
        color~ lantern:::core:::Color = lantern:::core:::Color { r: 1.0f, g: 1.0f, b: 1.0f, a: 1.0f };
        visible~ bool = true;
        /** How light plays on the mesh: metal or not, shiny or rough, glowing or not. */
        material~ lantern:::renderer:::Material = lantern:::renderer:::Material { };
        /** A material graph's shader that decides the surface instead of `texture` and `material`, or null. */
        materialShader~ lantern:::core:::Handle<lantern:::renderer:::MaterialShaderTag>? = null;
        /** Draw with `parameters` instead of the material shader's own: this entity has values of its own. */
        overridesParameters~ bool = false;
        /** The entity's own material parameters, by slot, when `overridesParameters` is set. */
        parameters~ f32[8] = filled<f32, 8>(0.0f);
        /** Whether the mesh casts a shadow. Walls and floors do; a sky dome or a pickup's glow halo may not. */
        castsShadows~ bool = true;
        /**
         * Whether an animator draws this entity instead (see `AnimationSystem`). `ExtractDraws` skips such entities, because
         * the animation system adds their skinned draw.
         */
        isAnimated~ bool = false;

        /**
         * A renderer with a mesh, a texture, a colour and default look settings.
         */
        static Create :: (mesh: lantern:::core:::Handle<lantern:::renderer:::MeshTag>, texture: lantern:::core:::Handle<lantern:::renderer:::TextureTag>?, color: lantern:::core:::Color) -> MeshRenderer {
            return MeshRenderer { mesh: mesh, texture: texture, color: color, visible: true };
        }
    }

    /**
     * Everything the world stores about one entity: its scene, its local transform, its mesh renderer, and its place in the
     * parent and child tree (a parent, the first and last child, and the sibling on each side, so children form a linked
     * list). It also keeps its world transform for this step and for the step before.
     */
    EntityRecord :: struct {
        scene~ SceneId = SceneId { };
        local~ Transform = Transform { };
        meshRenderer~ MeshRenderer? = null;
        parent~ lantern:::core:::Handle<EntityTag>? = null;
        firstChild~ lantern:::core:::Handle<EntityTag>? = null;
        lastChild~ lantern:::core:::Handle<EntityTag>? = null;
        previousSibling~ lantern:::core:::Handle<EntityTag>? = null;
        nextSibling~ lantern:::core:::Handle<EntityTag>? = null;
        /** The entity's world transform after the latest fixed step. */
        worldTransform~ Mat4 = Mat4 { };
        /** Its world transform after the step before, kept so rendering can interpolate between the two. */
        previousWorld~ Mat4 = Mat4 { };

        /**
         * The entity's world transform.
         */
        WorldMatrix :: () -> Mat4 {
            return worldTransform;
        }

        /**
         * Where the entity is in the world: the last column of its world matrix.
         */
        WorldPosition :: () -> Vec3 {
            return lantern:::core:::MatrixColumn3(worldTransform, 3);
        }

        /**
         * The transform to draw the entity with: `alpha` of the way from the previous step's transform to the current
         * one. Position and scale are lerped and rotation is slerped (decomposing the matrices first), since lerping a
         * matrix's elements directly would shear and shrink a rotating object. Skipped when the entity hasn't moved.
         */
        InterpolatedWorld :: (alpha: f32) -> Mat4 {
            if alpha >= 1.0f || previousWorld == worldTransform {
                return worldTransform;
            }
            return Transform:::FromMatrix(previousWorld).Lerp(Transform:::FromMatrix(worldTransform), alpha).Matrix();
        }
    }

    /**
     * How a change of parent went: it worked, an entity doesn't exist, or it would make an entity its own ancestor.
     */
    ParentChange :: enum {
        Done,
        UnknownEntity,
        WouldCreateCycle,
    }

    /**
     * The entities of the game. They live in a pool (see Pool), so a handle that outlived its entity is detected; names are
     * kept beside the records. The tree of parents and children is kept as linked lists, and a flat update order (parents
     * before children) is rebuilt when the tree changes, so computing world transforms is one pass. Components other than
     * the mesh renderer are not stored here; use a ComponentStore.
     */
    World :: class {
    public:
        records~ lantern:::core:::Pool<EntityRecord>*!;
        names~ Array<string!>! = [];
        updateOrder~ Array<lantern:::core:::Handle<EntityTag>>! = [];
        hierarchyDirty~ bool = false;

        World~: () {
            records = new lantern:::core:::Pool<EntityRecord>();
        }

        !World~: () {
            delete records;
            names.freeAll();
            delete updateOrder;
        }

        /**
         * Creates an entity with a name, in a scene, at a local transform, and returns its id.
         */
        Spawn~: (name: string, scene: SceneId, local: Transform) -> lantern:::core:::Handle<EntityTag> {
            matrix: Mat4 = local.Matrix();
            handle: lantern:::core:::Handle<EntityRecord> = records->Insert(EntityRecord { scene: scene, local: local, worldTransform: matrix, previousWorld: matrix });
            slot: usize = usize(handle.index);
            owned: string! = `${name}`;
            if slot < names.length() {
                replaced: string! = names.remove(slot);
                delete replaced;
                names.insert(slot, owned!);
            } else {
                names.push(owned!);
            }
            hierarchyDirty = true;
            return EntityHandle(handle);
        }

        /**
         * Creates an entity that is drawn with a mesh renderer.
         */
        SpawnMesh~: (name: string, scene: SceneId, local: Transform, meshRenderer: MeshRenderer) -> lantern:::core:::Handle<EntityTag> {
            id: lantern:::core:::Handle<EntityTag> = Spawn(name, scene, local);
            if record ~= records->BorrowMutable(RecordHandle(id)) {
                record->meshRenderer = meshRenderer;
            }
            return id;
        }

        /**
         * True when the id is of an entity that still exists.
         */
        Contains :: (id: lantern:::core:::Handle<EntityTag>) -> bool {
            return records->Contains(RecordHandle(id));
        }

        /**
         * A copy of the entity's record, or null.
         */
        Get :: (id: lantern:::core:::Handle<EntityTag>) -> EntityRecord? {
            return records->Get(RecordHandle(id));
        }

        /**
         * A read-only reference to the entity's record, or null. It is valid until the world is changed.
         */
        Borrow :: (id: lantern:::core:::Handle<EntityTag>) -> EntityRecord*? {
            return records->Borrow(RecordHandle(id));
        }

        /**
         * A reference through which the record can be changed, or null.
         */
        BorrowMutable~: (id: lantern:::core:::Handle<EntityTag>) -> EntityRecord~*? {
            return records->BorrowMutable(RecordHandle(id));
        }

        /**
         * The entity's name, or null.
         */
        Name :: (id: lantern:::core:::Handle<EntityTag>) -> string? {
            if !Contains(id) {
                return null;
            }
            return names[usize(id.index)];
        }

        /**
         * How many entities exist.
         */
        Length :: () -> usize {
            return records->Length();
        }

        /**
         * True when there are none.
         */
        IsEmpty :: () -> bool {
            return records->IsEmpty();
        }

        /**
         * The ids of every entity.
         */
        Ids :: () -> Array<lantern:::core:::Handle<EntityTag>>! {
            ids~ Array<lantern:::core:::Handle<EntityTag>>! = [];
            handles: Array<lantern:::core:::Handle<EntityRecord>>! = records->LiveHandles();
            for handle in handles {
                ids.push(EntityHandle(handle));
            }
            delete handles;
            return ids!;
        }

        /**
         * The first entity with this name, or null.
         */
        FindByName :: (name: string) -> lantern:::core:::Handle<EntityTag>? {
            found~ lantern:::core:::Handle<EntityTag>? = null;
            ids: Array<lantern:::core:::Handle<EntityTag>>! = Ids();
            for id in ids {
                if found == null && names[usize(id.index)] == name {
                    found = id;
                }
            }
            delete ids;
            return found;
        }

        /**
         * The entity's parent, or null.
         */
        Parent :: (id: lantern:::core:::Handle<EntityTag>) -> lantern:::core:::Handle<EntityTag>? {
            guard record := Get(id) return null;
            return record.parent;
        }

        /**
         * The entity's children, in order.
         */
        Children :: (id: lantern:::core:::Handle<EntityTag>) -> Array<lantern:::core:::Handle<EntityTag>>! {
            children~ Array<lantern:::core:::Handle<EntityTag>>! = [];
            guard record := Get(id) return children!;
            current~ lantern:::core:::Handle<EntityTag>? = record.firstChild;
            while current != null {
                child: lantern:::core:::Handle<EntityTag> = current ?? id;
                children.push(child);
                current = null;
                if childRecord := Get(child) {
                    current = childRecord.nextSibling;
                }
            }
            return children!;
        }

        /**
         * Moves an entity to a position without the render interpolation seeing it travel: the entity and everything under it
         * have their previous transform set to the new one, so the frame doesn't smear between the old and new places.
         */
        Teleport~: (id: lantern:::core:::Handle<EntityTag>, translation: Vec3) -> void {
            if record ~= BorrowMutable(id) {
                record->local.translation = translation;
            }
            UpdateWorldTransforms();
            pending~ Array<lantern:::core:::Handle<EntityTag>>! = [];
            pending.push(id);
            while current := pending.pop() {
                if record ~= BorrowMutable(current) {
                    record->previousWorld = record->worldTransform;
                }
                children: Array<lantern:::core:::Handle<EntityTag>>! = Children(current);
                for child in children {
                    pending.push(child);
                }
                delete children;
            }
            delete pending;
        }

        /**
         * Gives an entity a new parent (or none). The change is refused if either entity is unknown or if it would put an entity
         * under its own descendant.
         */
        SetParent~: (child: lantern:::core:::Handle<EntityTag>, parent: lantern:::core:::Handle<EntityTag>?) -> ParentChange {
            if !Contains(child) {
                return ParentChange:::UnknownEntity;
            }
            if newParent := parent {
                if !Contains(newParent) {
                    return ParentChange:::UnknownEntity;
                }
                ancestor~ lantern:::core:::Handle<EntityTag>? = newParent;
                while ancestor != null {
                    current: lantern:::core:::Handle<EntityTag> = ancestor ?? newParent;
                    if current == child {
                        return ParentChange:::WouldCreateCycle;
                    }
                    ancestor = Parent(current);
                }
            }
            Unlink(child);
            if newParent := parent {
                Append(newParent, child);
            }
            hierarchyDirty = true;
            return ParentChange:::Done;
        }

        /**
         * Removes an entity and everything under it, and returns how many were removed.
         */
        Despawn~: (id: lantern:::core:::Handle<EntityTag>) -> usize {
            if !Contains(id) {
                return 0;
            }
            Unlink(id);
            removed~ usize = 0;
            pending~ Array<lantern:::core:::Handle<EntityTag>>! = [];
            pending.push(id);
            while current := pending.pop() {
                children: Array<lantern:::core:::Handle<EntityTag>>! = Children(current);
                if records->Remove(RecordHandle(current)) != null {
                    for child in children {
                        pending.push(child);
                    }
                    removed += 1;
                }
                delete children;
            }
            delete pending;
            hierarchyDirty = true;
            return removed;
        }

        /**
         * Removes every entity in a scene, and returns how many.
         */
        DespawnScene~: (scene: SceneId) -> usize {
            doomed~ Array<lantern:::core:::Handle<EntityTag>>! = [];
            ids: Array<lantern:::core:::Handle<EntityTag>>! = Ids();
            for id in ids {
                if record := Get(id) {
                    if record.scene == scene {
                        doomed.push(id);
                    }
                }
            }
            delete ids;
            removed~ usize = 0;
            for id in doomed {
                removed += Despawn(id);
            }
            delete doomed;
            return removed;
        }

        /**
         * Copies every entity's current world transform to its previous one. The loop calls it before each fixed step, so
         * rendering can blend from the step before to this one.
         */
        StorePreviousTransforms~: () -> void {
            handles: Array<lantern:::core:::Handle<EntityRecord>>! = records->LiveHandles();
            for handle in handles {
                if record ~= records->BorrowMutable(handle) {
                    record->previousWorld = record->worldTransform;
                }
            }
            delete handles;
        }

        /**
         * Computes every entity's world transform from its local one and its parent's, in one pass in update order.
         */
        UpdateWorldTransforms~: () -> void {
            if hierarchyDirty {
                RebuildUpdateOrder();
            }
            for index~ usize = 0; index < updateOrder.length(); index++ {
                id: lantern:::core:::Handle<EntityTag> = updateOrder[index];
                parentWorld~ Mat4 = Mat4 { };
                if parent := Parent(id) {
                    if parentRecord := Get(parent) {
                        parentWorld = parentRecord.worldTransform;
                    }
                }
                if record ~= BorrowMutable(id) {
                    record->worldTransform = parentWorld * record->local.Matrix();
                }
            }
        }

        /**
         * Makes the list of entities in an order where every parent comes before its children, by walking down from the
         * entities with no parent.
         */
        RebuildUpdateOrder~: () -> void {
            updateOrder.clear();
            ids: Array<lantern:::core:::Handle<EntityTag>>! = Ids();
            stack~ Array<lantern:::core:::Handle<EntityTag>>! = [];
            for index~ usize = ids.length(); index > 0; index-- {
                if Parent(ids[index - 1]) == null {
                    stack.push(ids[index - 1]);
                }
            }
            delete ids;
            while id := stack.pop() {
                updateOrder.push(id);
                children: Array<lantern:::core:::Handle<EntityTag>>! = Children(id);
                for index~ usize = children.length(); index > 0; index-- {
                    stack.push(children[index - 1]);
                }
                delete children;
            }
            delete stack;
            hierarchyDirty = false;
        }

        /**
         * Takes an entity out of its parent's list of children.
         */
        Unlink~: (child: lantern:::core:::Handle<EntityTag>) -> void {
            guard record := Get(child) return;
            guard parent := record.parent return;
            if previous := record.previousSibling {
                if previousRecord ~= BorrowMutable(previous) {
                    previousRecord->nextSibling = record.nextSibling;
                }
            } else if parentRecord ~= BorrowMutable(parent) {
                parentRecord->firstChild = record.nextSibling;
            }
            if next := record.nextSibling {
                if nextRecord ~= BorrowMutable(next) {
                    nextRecord->previousSibling = record.previousSibling;
                }
            } else if parentRecord ~= BorrowMutable(parent) {
                parentRecord->lastChild = record.previousSibling;
            }
            if childRecord ~= BorrowMutable(child) {
                childRecord->parent = null;
                childRecord->previousSibling = null;
                childRecord->nextSibling = null;
            }
        }

        /**
         * Adds an entity as the last child of a parent.
         */
        Append~: (parent: lantern:::core:::Handle<EntityTag>, child: lantern:::core:::Handle<EntityTag>) -> void {
            guard parentRecord := Get(parent) return;
            previousLast: lantern:::core:::Handle<EntityTag>? = parentRecord.lastChild;
            if last := previousLast {
                if lastRecord ~= BorrowMutable(last) {
                    lastRecord->nextSibling = child;
                }
            }
            if parentMutable ~= BorrowMutable(parent) {
                if previousLast == null {
                    parentMutable->firstChild = child;
                }
                parentMutable->lastChild = child;
            }
            if childRecord ~= BorrowMutable(child) {
                childRecord->parent = parent;
                childRecord->previousSibling = previousLast;
                childRecord->nextSibling = null;
            }
        }
    }

    /**
     * The pool handle of an entity's record. (An entity and its record share a slot and a generation.)
     */
    RecordHandle :: (id: lantern:::core:::Handle<EntityTag>) -> lantern:::core:::Handle<EntityRecord> {
        return lantern:::core:::CastHandle<EntityTag, EntityRecord>(id);
    }

    /**
     * The entity id for a record's pool handle.
     */
    EntityHandle :: (handle: lantern:::core:::Handle<EntityRecord>) -> lantern:::core:::Handle<EntityTag> {
        return lantern:::core:::CastHandle<EntityRecord, EntityTag>(handle);
    }

    /**
     * Extra data of one kind (health, say) attached to some entities, found by entity id. It is an array indexed by the
     * entity's slot, with the id stored beside each value so a stale id doesn't match. `RetainAlive` drops the values of
     * entities that have gone.
     */
    ComponentStore<T> :: class {
    public:
        ids~ Array<lantern:::core:::Handle<EntityTag>?>! = [];
        values~ Array<T?>! = [];

        ComponentStore~: () { }

        !ComponentStore~: () {
            delete ids;
            delete values;
        }

        /**
         * Stores a value for an entity, replacing any it had.
         */
        Insert~: (id: lantern:::core:::Handle<EntityTag>, value: T) -> void {
            slot: usize = usize(id.index);
            while ids.length() <= slot {
                ids.push(null);
                values.push(null);
            }
            ids[slot] = id;
            values[slot] = value;
        }

        /**
         * True when this exact entity (slot and generation) has a value.
         */
        Holds :: (id: lantern:::core:::Handle<EntityTag>) -> bool {
            slot: usize = usize(id.index);
            if slot >= ids.length() {
                return false;
            }
            if stored := ids[slot] {
                return stored == id;
            }
            return false;
        }

        /**
         * The entity's value, or null.
         */
        Get :: (id: lantern:::core:::Handle<EntityTag>) -> T? {
            if !Holds(id) {
                return null;
            }
            return values[usize(id.index)];
        }

        /**
         * Removes and returns the entity's value, or null.
         */
        Remove~: (id: lantern:::core:::Handle<EntityTag>) -> T? {
            if !Holds(id) {
                return null;
            }
            slot: usize = usize(id.index);
            removed: T? = values[slot];
            ids[slot] = null;
            values[slot] = null;
            return removed;
        }

        /**
         * The ids of the entities that have a value.
         */
        Ids :: () -> Array<lantern:::core:::Handle<EntityTag>>! {
            stored~ Array<lantern:::core:::Handle<EntityTag>>! = [];
            for slot~ usize = 0; slot < ids.length(); slot++ {
                if id := ids[slot] {
                    stored.push(id);
                }
            }
            return stored!;
        }

        /**
         * Drops the values of entities that no longer exist in the world.
         */
        RetainAlive~: (world: World*) -> void {
            for slot~ usize = 0; slot < ids.length(); slot++ {
                if id := ids[slot] {
                    if !world->Contains(id) {
                        ids[slot] = null;
                        values[slot] = null;
                    }
                }
            }
        }

        /**
         * Removes every value.
         */
        Clear~: () -> void {
            ids.clear();
            values.clear();
        }

        /**
         * How many entities have a value.
         */
        Length :: () -> usize {
            count~ usize = 0;
            for slot~ usize = 0; slot < ids.length(); slot++ {
                if ids[slot] != null {
                    count += 1;
                }
            }
            return count;
        }

        /**
         * True when none has.
         */
        IsEmpty :: () -> bool {
            return Length() == 0;
        }
    }

    /**
     * Adds a `DrawItem` to the render world for every entity with a visible mesh renderer, at its interpolated
     * transform. Called once per frame from the game's `Render`, after the game's own draws.
     */
    ExtractDraws :: (entityWorld: World*, alpha: f32, renderWorld: lantern:::renderer:::RenderWorld~*) -> void {
        ids: Array<lantern:::core:::Handle<EntityTag>>! = entityWorld->Ids();
        for id in ids {
            if record := entityWorld->Get(id) {
                if meshRenderer := record.meshRenderer {
                    if meshRenderer.visible && !meshRenderer.isAnimated {
                        renderWorld->draws.push(lantern:::renderer:::DrawItem {
                            mesh: meshRenderer.mesh,
                            texture: meshRenderer.texture,
                            normalTexture: meshRenderer.normalTexture,
                            transform: record.InterpolatedWorld(alpha),
                            color: meshRenderer.color,
                            material: meshRenderer.material,
                            materialShader: meshRenderer.materialShader,
                            overridesParameters: meshRenderer.overridesParameters,
                            parameters: meshRenderer.parameters,
                            castsShadows: meshRenderer.castsShadows
                        });
                    }
                }
            }
        }
        delete ids;
    }
}
