lantern:::engine :: namespace {
    /**
     * How much sound to keep queued on the device: 60 ms. Less risks a gap if a frame runs long; more makes a sound
     * start later than the action that caused it.
     */
    TARGET_QUEUED_SECONDS: f32 : 0.06f;
    /**
     * The sample rate the mixer uses when there is no audio device (a headless run or a machine without sound).
     */
    FALLBACK_SAMPLE_RATE: u32 : 48000;

    /**
     * What the debug HUD shows about audio: whether a device exists, how many sounds are playing, how much is queued, and
     * how many times the queue ran dry (an underrun is an audible gap).
     */
    AudioStats :: struct {
        hasDevice~ bool = false;
        activeVoices~ usize = 0;
        queuedMilliseconds~ f32 = 0.0f;
        underrunCount~ u32 = 0;
    }

    /**
     * The engine's audio: a Mixer, the device it sends to (a sink, or none), and the sounds by name. Each frame `Update` tops
     * up the device's queue from the mixer. Without a device everything still works but nothing is heard.
     */
    AudioSystem :: class {
    public:
        mixer~ lantern:::audio:::Mixer*!;
        sink~ lantern:::platform:::AudioSink*!?;
        sounds~ lantern:::audio:::SoundBank*!;
        loopNames~ Array<string!>! = [];
        loopIds~ Array<i64>! = [];
        underrunCount~ u32 = 0;
        hasPushedAudio~ bool = false;

        AudioSystem~: (deviceSink: lantern:::platform:::AudioSink*!?) {
            sampleRate~ u32 = FALLBACK_SAMPLE_RATE;
            if device := deviceSink {
                sampleRate = device->SampleRate();
            }
            mixer = new lantern:::audio:::Mixer(sampleRate);
            sink = deviceSink!;
            sounds = new lantern:::audio:::SoundBank();
        }

        !AudioSystem~: () {
            delete mixer;
            delete sink;
            delete sounds;
            loopNames.freeAll();
            delete loopIds;
        }

        /**
         * Loads a WAV file and stores it under a name. A file that can't be read falls back to the generated sound of the
         * same name when there is one (see `lantern:::synth:::RECIPE_NAMES`), so a checkout with no recorded audio still
         * has footsteps, ambience, music and menu sounds, and dropping a real file in at the path replaces them. A name
         * with no file and no recipe logs a warning and returns null; the game carries on without the sound.
         */
        LoadSound~: (name: string, path: string) -> lantern:::core:::Handle<lantern:::audio:::SoundTag>? {
            when lantern:::audio:::LoadWav(path) {
                Result:::Ok(sound) -> {
                    handle: lantern:::core:::Handle<lantern:::audio:::SoundTag> = mixer->AddSound(sound);
                    delete sound;
                    sounds->Insert(name, handle);
                    return handle;
                },
                Result:::Err(failure) -> {
                    delete failure;
                    if generated := GenerateSound(name) {
                        return generated;
                    }
                    message: string! = `sound '${name}' unavailable: no file at ${path} and no generated sound of that name`;
                    lantern:::core:::LogWarn("audio", message);
                    delete message;
                    return null;
                }
            }
        }

        /**
         * Builds the generated sound called `name` and stores it under that name, or returns null when there is no such
         * recipe.
         */
        GenerateSound~: (name: string) -> lantern:::core:::Handle<lantern:::audio:::SoundTag>? {
            made := lantern:::synth:::Make(name);
            if sound := made {
                handle: lantern:::core:::Handle<lantern:::audio:::SoundTag> = mixer->AddSound(sound);
                sounds->Insert(name, handle);
                delete made;
                return handle;
            }
            delete made;
            return null;
        }

        /**
         * True when a sound is loaded under this name.
         */
        HasSound :: (name: string) -> bool {
            return sounds->Get(name) != null;
        }

        /**
         * Plays a loaded sound effect at `volume`. An unknown name does nothing.
         */
        Play~: (name: string, volume: f32) -> void {
            if sound := sounds->Get(name) {
                mixer->Play(sound, volume);
            }
        }

        /**
         * Starts the music track with this name, looping.
         */
        PlayMusic~: (name: string) -> void {
            if sound := sounds->Get(name) {
                mixer->PlayMusic(sound);
            }
        }

        /**
         * Stops the music.
         */
        StopMusic~: () -> void {
            mixer->StopMusic();
        }

        /**
         * Sets a bus's volume, 0 to 1. `bus` is `master`, `music`, `ambience`, `sfx` or `ui`; another name does nothing.
         */
        SetBusVolume~: (bus: string, volume: f32) -> void {
            if number := lantern:::audio:::BusFromName(bus) {
                mixer->SetBusVolume(number, volume);
            }
        }

        /**
         * A bus's volume (0 for an unknown name).
         */
        BusVolume :: (bus: string) -> f32 {
            if number := lantern:::audio:::BusFromName(bus) {
                return mixer->BusVolume(number);
            }
            return 0.0f;
        }

        /**
         * Mutes or unmutes a bus, keeping its volume.
         */
        SetBusMuted~: (bus: string, muted: bool) -> void {
            if number := lantern:::audio:::BusFromName(bus) {
                mixer->SetBusMuted(number, muted);
            }
        }

        /**
         * Puts the listener where the camera is. Call it once a frame.
         */
        SetListener~: (position: Vec3, forward: Vec3, up: Vec3) -> void {
            mixer->SetListener(position, forward, up);
        }

        /**
         * Plays a loaded sound as a one-shot on a bus (`sfx`, `ui`, `ambience` or `music`; another name uses `sfx`), flat.
         * `pitch` is 1 for normal speed.
         */
        PlayOn~: (name: string, bus: string, volume: f32, pitch: f32) -> void {
            if sound := sounds->Get(name) {
                mixer->PlayOn(sound, BusOrEffects(bus), volume, pitch);
            }
        }

        /**
         * Plays a loaded sound as a one-shot at a point in the world. It is quieter with distance from the listener, full
         * volume inside `minDistance` and silent beyond `maxDistance` (metres), and panned toward the side it is on.
         */
        PlayAt~: (name: string, bus: string, position: Vec3, volume: f32, pitch: f32, minDistance: f32, maxDistance: f32) -> void {
            if sound := sounds->Get(name) {
                mixer->PlayAt(sound, BusOrEffects(bus), position, volume, pitch, minDistance, maxDistance);
            }
        }

        /**
         * The bus number for a name, or the effects bus for a name that isn't one of the four a sound can play on.
         */
        BusOrEffects :: (bus: string) -> usize {
            if number := lantern:::audio:::BusFromName(bus) {
                if number != lantern:::audio:::BUS_MASTER {
                    return number;
                }
            }
            return lantern:::audio:::BUS_SFX;
        }

        /**
         * Where a named loop is in the loop list, or null when it isn't playing. A loop that has ended since it was
         * named counts as not playing.
         */
        IndexOfLoop :: (loopName: string) -> usize? {
            for index~ usize = 0; index < loopNames.length(); index++ {
                if loopNames[index] == loopName && mixer->IsPlaying(loopIds[index]) {
                    return index;
                }
            }
            return null;
        }

        /**
         * Starts a named loop, silent (level 0) when `level` is 0 so it can be faded in. Starting a name that is already
         * playing does nothing, so a game can ask for its ambience every frame. `position` only matters when `positional`
         * is true. Returns false when the sound isn't loaded.
         */
        StartLoop~: (loopName: string, soundName: string, bus: string, volume: f32, level: f32, positional: bool, position: Vec3, minDistance: f32, maxDistance: f32) -> bool {
            if IndexOfLoop(loopName) != null {
                return true;
            }
            guard sound := sounds->Get(soundName) return false;
            id: i64 = mixer->StartLoop(sound, BusOrEffects(bus), volume, level, positional, position, minDistance, maxDistance);
            if id == 0 {
                return false;
            }
            for index~ usize = 0; index < loopNames.length(); index++ {
                if loopNames[index] == loopName {
                    loopIds[index] = id;
                    return true;
                }
            }
            loopNames.push(`${loopName}`);
            loopIds.push(id);
            return true;
        }

        /**
         * Fades a named loop to `level` (0 to 1) over `seconds`. A name that isn't playing does nothing.
         */
        FadeLoop~: (loopName: string, level: f32, seconds: f32) -> void {
            if index := IndexOfLoop(loopName) {
                mixer->FadeVoice(loopIds[index], level, seconds);
            }
        }

        /**
         * Moves a positional loop (an emitter).
         */
        MoveLoop~: (loopName: string, position: Vec3) -> void {
            if index := IndexOfLoop(loopName) {
                mixer->MoveVoice(loopIds[index], position);
            }
        }

        /**
         * Stops a named loop, fading out over `seconds` first (0 stops at once).
         */
        StopLoop~: (loopName: string, seconds: f32) -> void {
            if index := IndexOfLoop(loopName) {
                mixer->StopVoice(loopIds[index], seconds);
            }
        }

        /**
         * The level a named loop is at now (0 when it isn't playing).
         */
        LoopLevel :: (loopName: string) -> f32 {
            if index := IndexOfLoop(loopName) {
                return mixer->LevelOf(loopIds[index]);
            }
            return 0.0f;
        }

        /**
         * True while a named loop is playing.
         */
        IsLoopPlaying :: (loopName: string) -> bool {
            return IndexOfLoop(loopName) != null;
        }

        /**
         * Keeps about 60 ms of sound queued on the device: asks the mixer for just enough frames to fill it and pushes them. If
         * the queue was empty after audio had started, that counts as an underrun.
         */
        Update~: () -> void {
            if sink == null {
                return;
            }
            targetFrames: usize = usize(TARGET_QUEUED_SECONDS * f32(mixer->SampleRate()));
            queuedFrames: usize = QueuedFrames();
            if queuedFrames == 0 && hasPushedAudio {
                underrunCount += 1;
            }
            if queuedFrames >= targetFrames {
                return;
            }
            mixed: Array<f32>! = mixer->Mix(targetFrames - queuedFrames);
            if device ~= sink {
                device->PushFrames(mixed);
            }
            delete mixed;
            hasPushedAudio = true;
        }

        /**
         * How many frames are waiting on the device (0 with no device).
         */
        QueuedFrames :: () -> usize {
            guard device := sink return 0;
            return device->QueuedFrames();
        }

        /**
         * The AudioStats for this moment.
         */
        Stats :: () -> AudioStats {
            queuedFrames: usize = QueuedFrames();
            return AudioStats {
                hasDevice: sink != null,
                activeVoices: mixer->ActiveVoiceCount(),
                queuedMilliseconds: f32(queuedFrames) * 1000.0f / f32(mixer->SampleRate()),
                underrunCount: underrunCount
            };
        }
    }
}
