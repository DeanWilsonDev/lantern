lantern:::physics :: namespace {
    PARALLEL_EPSILON: f32 : 0.000000001f;

    Triangle :: struct {
        a~ Vec3 = Vec3 { };
        b~ Vec3 = Vec3 { };
        c~ Vec3 = Vec3 { };

        static Create :: (a: Vec3, b: Vec3, c: Vec3) -> Triangle {
            return Triangle { a: a, b: b, c: c };
        }

        Normal :: () -> Vec3 {
            return lantern:::core:::NormalizeOr3((b - a).cross(c - a), Vec3 { });
        }

        IsDegenerate :: () -> bool {
            return lantern:::core:::LengthSquared3((b - a).cross(c - a)) < 0.000000000001f;
        }

        Transformed :: (transform: Mat4) -> Triangle {
            return Triangle {
                a: lantern:::core:::TransformPoint3(transform, a),
                b: lantern:::core:::TransformPoint3(transform, b),
                c: lantern:::core:::TransformPoint3(transform, c)
            };
        }

        EdgeStart :: (edge: usize) -> Vec3 {
            if edge == 0 {
                return a;
            }
            if edge == 1 {
                return b;
            }
            return c;
        }

        EdgeEnd :: (edge: usize) -> Vec3 {
            if edge == 0 {
                return b;
            }
            if edge == 1 {
                return c;
            }
            return a;
        }
    }

    ClosestPair :: struct {
        first~ Vec3 = Vec3 { };
        second~ Vec3 = Vec3 { };

        DistanceSquared :: () -> f32 {
            return lantern:::core:::LengthSquared3(first - second);
        }
    }

    DistanceSquared3 :: (first: Vec3, second: Vec3) -> f32 {
        return lantern:::core:::LengthSquared3(first - second);
    }

    ClosestPointOnTriangle :: (point: Vec3, triangle: Triangle) -> Vec3 {
        a: Vec3 = triangle.a;
        b: Vec3 = triangle.b;
        c: Vec3 = triangle.c;
        ab: Vec3 = b - a;
        ac: Vec3 = c - a;
        ap: Vec3 = point - a;
        d1: f32 = ab.dot(ap);
        d2: f32 = ac.dot(ap);
        if d1 <= 0.0f && d2 <= 0.0f {
            return a;
        }
        bp: Vec3 = point - b;
        d3: f32 = ab.dot(bp);
        d4: f32 = ac.dot(bp);
        if d3 >= 0.0f && d4 <= d3 {
            return b;
        }
        vc: f32 = d1 * d4 - d3 * d2;
        if vc <= 0.0f && d1 >= 0.0f && d3 <= 0.0f {
            return a + ab * (d1 / (d1 - d3));
        }
        cp: Vec3 = point - c;
        d5: f32 = ab.dot(cp);
        d6: f32 = ac.dot(cp);
        if d6 >= 0.0f && d5 <= d6 {
            return c;
        }
        vb: f32 = d5 * d2 - d1 * d6;
        if vb <= 0.0f && d2 >= 0.0f && d6 <= 0.0f {
            return a + ac * (d2 / (d2 - d6));
        }
        va: f32 = d3 * d6 - d5 * d4;
        if va <= 0.0f && (d4 - d3) >= 0.0f && (d5 - d6) >= 0.0f {
            return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6)));
        }
        denominator: f32 = 1.0f / (va + vb + vc);
        return a + ab * (vb * denominator) + ac * (vc * denominator);
    }

    ClosestPointsBetweenSegments :: (p1: Vec3, q1: Vec3, p2: Vec3, q2: Vec3) -> ClosestPair {
        d1: Vec3 = q1 - p1;
        d2: Vec3 = q2 - p2;
        r: Vec3 = p1 - p2;
        a: f32 = lantern:::core:::LengthSquared3(d1);
        e: f32 = lantern:::core:::LengthSquared3(d2);
        f: f32 = d2.dot(r);
        if a <= PARALLEL_EPSILON && e <= PARALLEL_EPSILON {
            return ClosestPair { first: p1, second: p2 };
        }
        s~ f32 = 0.0f;
        t~ f32 = 0.0f;
        if a <= PARALLEL_EPSILON {
            t = Math:::clamp(f / e, 0.0f, 1.0f);
        } else {
            c: f32 = d1.dot(r);
            if e <= PARALLEL_EPSILON {
                s = Math:::clamp(-c / a, 0.0f, 1.0f);
            } else {
                b: f32 = d1.dot(d2);
                denominator: f32 = a * e - b * b;
                if denominator > PARALLEL_EPSILON {
                    s = Math:::clamp((b * f - c * e) / denominator, 0.0f, 1.0f);
                }
                t = (b * s + f) / e;
                if t < 0.0f {
                    t = 0.0f;
                    s = Math:::clamp(-c / a, 0.0f, 1.0f);
                } else if t > 1.0f {
                    t = 1.0f;
                    s = Math:::clamp((b - c) / a, 0.0f, 1.0f);
                }
            }
        }
        return ClosestPair { first: p1 + d1 * s, second: p2 + d2 * t };
    }

    SegmentTriangleIntersection :: (start: Vec3, end: Vec3, triangle: Triangle) -> Vec3? {
        direction: Vec3 = end - start;
        edge1: Vec3 = triangle.b - triangle.a;
        edge2: Vec3 = triangle.c - triangle.a;
        p: Vec3 = direction.cross(edge2);
        determinant: f32 = edge1.dot(p);
        if Math:::abs(determinant) < PARALLEL_EPSILON {
            return null;
        }
        inverse: f32 = 1.0f / determinant;
        offset: Vec3 = start - triangle.a;
        u: f32 = offset.dot(p) * inverse;
        if u < 0.0f || u > 1.0f {
            return null;
        }
        q: Vec3 = offset.cross(edge1);
        v: f32 = direction.dot(q) * inverse;
        if v < 0.0f || u + v > 1.0f {
            return null;
        }
        t: f32 = edge2.dot(q) * inverse;
        if t < 0.0f || t > 1.0f {
            return null;
        }
        return start + direction * t;
    }

    ClosestPointsSegmentTriangle :: (start: Vec3, end: Vec3, triangle: Triangle) -> ClosestPair {
        if crossing := SegmentTriangleIntersection(start, end, triangle) {
            return ClosestPair { first: crossing, second: crossing };
        }
        best~ ClosestPair = ClosestPair { first: start, second: ClosestPointOnTriangle(start, triangle) };
        fromEnd: ClosestPair = ClosestPair { first: end, second: ClosestPointOnTriangle(end, triangle) };
        if fromEnd.DistanceSquared() < best.DistanceSquared() {
            best = fromEnd;
        }
        for edge~ usize = 0; edge < 3; edge++ {
            candidate: ClosestPair = ClosestPointsBetweenSegments(start, end, triangle.EdgeStart(edge), triangle.EdgeEnd(edge));
            if candidate.DistanceSquared() < best.DistanceSquared() {
                best = candidate;
            }
        }
        return best;
    }
}
