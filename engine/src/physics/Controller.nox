lantern:::physics :: namespace {
    /**
     * How many times one step may bump into a surface and slide along it before the controller gives up on the rest of
     * the movement. Four covers a corner between two walls and a floor.
     */
    MAX_SLIDE_ITERATIONS: usize : 4;
    /**
     * How many times one step may push the body out of overlapping geometry.
     */
    MAX_DEPENETRATION_ITERATIONS: usize : 4;
    /**
     * How far (in metres) beside a contact point WalkableFaceNear starts its downward ray, to find the face under an
     * edge instead of the edge itself.
     */
    WALKABLE_FACE_SIDE_OFFSET: f32 : 0.02f;
    /**
     * How far above that point the ray starts, so it doesn't begin inside the surface.
     */
    WALKABLE_FACE_START_ABOVE: f32 : 0.05f;

    /**
     * Every number that decides how the character moves, in metres and seconds. A game changes the walk speed, jump height and gravity
     * through the controller's `Set...` functions (see game-api.md); these are the defaults. `jumpHeight` and `gravity` set the jump
     * speed (see JumpSpeed), so a game tunes the height it wants and not an arbitrary speed.
     */
    ControllerSettings :: struct {
        radius~ f32 = 0.35f;
        height~ f32 = 1.7f;
        skinWidth~ f32 = 0.01f;
        stepHeight~ f32 = 0.3f;
        maxWalkableSlopeDegrees~ f32 = 46.0f;
        groundSnapDistance~ f32 = 0.3f;
        walkSpeed~ f32 = 6.0f;
        groundAcceleration~ f32 = 50.0f;
        airAcceleration~ f32 = 20.0f;
        gravity~ f32 = 28.0f;
        jumpHeight~ f32 = 1.5f;
        jumpReleaseGravityMultiplier~ f32 = 2.5f;
        maxFallSpeed~ f32 = 30.0f;
        coyoteSeconds~ f32 = 0.1f;
        jumpBufferSeconds~ f32 = 0.12f;

        /**
         * The upward speed that reaches `jumpHeight` under `gravity`: v = sqrt(2 g h).
         */
        JumpSpeed :: () -> f32 {
            return Math:::sqrt(2.0f * gravity * jumpHeight);
        }

        /**
         * The body: an upright capsule `height` tall.
         */
        CapsuleShape :: () -> Capsule {
            return Capsule:::Upright(radius, height);
        }

        /**
         * The smallest upward component a surface normal may have to count as ground: the cosine of the steepest
         * walkable slope. A flat floor has 1, a wall 0.
         */
        MinGroundNormalY :: () -> f32 {
            return Math:::cos(maxWalkableSlopeDegrees * (Math:::PI / 180.0f));
        }

        /**
         * The body grown by the skin width. Movement is cast with this slightly fatter shape so the body stops a hair
         * before a surface and never ends up exactly touching it, where the next cast would be unreliable.
         */
        MovementCapsule :: () -> Capsule {
            return Capsule { radius: radius + skinWidth, halfSegment: CapsuleShape().halfSegment };
        }
    }

    /**
     * What the player asked for this step: a direction in the world's horizontal plane (the game works it out from
     * the stick and the camera), a jump that went down this step, and whether the jump is still held.
     */
    ControllerInput :: struct {
        moveDirection~ Vec3 = Vec3 { };
        jumpPressed~ bool = false;
        jumpHeld~ bool = false;
    }

    /**
     * What happened during a step, for the game to react to with a sound or a particle: it jumped, it landed (and how
     * fast it was falling), or it hit its head.
     */
    ControllerEvents :: struct {
        jumped~ bool = false;
        landedWithSpeed~ f32? = null;
        hitCeiling~ bool = false;
    }

    /**
     * A downward cast that found ground: the hit, and the walkable normal to use for it (which may differ from the
     * hit's own normal when the capsule touched an edge).
     */
    GroundProbe :: struct {
        hit~ ShapeHit = ShapeHit { };
        normal~ Vec3 = Vec3 { };
    }

    /**
     * A vector with its up-down part removed.
     */
    Horizontal :: (vector: Vec3) -> Vec3 {
        return Vec3 { x: vector.x, y: 0.0f, z: vector.z };
    }

    /**
     * The vector at length 1, or null when its length is zero, not a number or infinite.
     */
    TryNormalize3 :: (vector: Vec3) -> Vec3? {
        reciprocalLength: f32 = 1.0f / vector.length();
        if reciprocalLength > 0.0f && reciprocalLength < lantern:::core:::INFINITY {
            return vector * reciprocalLength;
        }
        return null;
    }

    /**
     * The vector at length 1, or zero for a vector that can't be normalised.
     */
    NormalizeOrZero3 :: (vector: Vec3) -> Vec3 {
        if normalized := TryNormalize3(vector) {
            return normalized;
        }
        return Vec3 { };
    }

    /**
     * The vector shortened to `maximumLength` if it is longer.
     */
    ClampLengthMax3 :: (vector: Vec3, maximumLength: f32) -> Vec3 {
        lengthSquared: f32 = lantern:::core:::LengthSquared3(vector);
        if lengthSquared > maximumLength * maximumLength {
            return (vector / Math:::sqrt(lengthSquared)) * maximumLength;
        }
        return vector;
    }

    /**
     * Moves `current` toward `target` by at most `maxDelta`, landing exactly on it when closer than that. It is how
     * the horizontal velocity accelerates toward the wanted velocity.
     */
    MoveTowardsVector :: (current: Vec3, target: Vec3, maxDelta: f32) -> Vec3 {
        difference: Vec3 = target - current;
        distance: f32 = difference.length();
        if distance <= maxDelta || distance < 0.000000001f {
            return target;
        }
        return current + (difference / distance) * maxDelta;
    }

    /**
     * A kinematic character: the game moves it by asking for a velocity, and it collides and slides, instead of being
     * pushed by forces. All the "game feel" lives in Step: acceleration, gravity, a shorter jump when the button is
     * released early, coyote time (a jump still works for a moment after walking off a ledge), a jump buffer (a
     * press just before landing still jumps), step-up over small ledges, and sticking to slopes.
     */
    CharacterController :: struct {
        settings~ ControllerSettings = ControllerSettings { };
        feetPosition~ Vec3 = Vec3 { };
        velocity~ Vec3 = Vec3 { };
        grounded~ bool = false;
        groundNormal~ Vec3 = Vec3 { x: 0.0f, y: 1.0f, z: 0.0f };
        groundCollider~ ColliderId? = null;
        secondsSinceGrounded~ f32 = lantern:::core:::INFINITY;
        jumpBufferRemaining~ f32 = 0.0f;
        risingFromJump~ bool = false;

        static Create :: (settings: ControllerSettings, feetPosition: Vec3) -> CharacterController {
            return CharacterController { settings: settings, feetPosition: feetPosition };
        }

        /**
         * Puts the feet at a position and clears all motion state, so the next step starts from rest in the air.
         */
        Teleport~: (newFeetPosition: Vec3) -> void {
            feetPosition = newFeetPosition;
            velocity = Vec3 { };
            grounded = false;
            groundNormal = lantern:::core:::WorldUp();
            groundCollider = null;
            secondsSinceGrounded = lantern:::core:::INFINITY;
            jumpBufferRemaining = 0.0f;
            risingFromJump = false;
        }

        /**
         * The middle of the body, half the height above the feet.
         */
        CapsuleCenter :: () -> Vec3 {
            return feetPosition + lantern:::core:::WorldUp() * (settings.height * 0.5f);
        }

        /**
         * Moves the body so its middle is at `center`.
         */
        SetCapsuleCenter~: (center: Vec3) -> void {
            feetPosition = center - lantern:::core:::WorldUp() * (settings.height * 0.5f);
        }

        /**
         * True when a surface with this normal is gentle enough to stand on.
         */
        IsWalkable :: (normal: Vec3) -> bool {
            return normal.y >= settings.MinGroundNormalY();
        }

        /**
         * One fixed step of movement. In order: ride a moving platform the body is standing on; update the jump buffer
         * and coyote timer; accelerate the horizontal velocity toward the wanted one; apply gravity (stronger when a
         * jump is released early); start a jump if one is buffered and allowed; move and slide; look for ground below;
         * push the body out of anything it overlaps. Returns the events.
         */
        Step~: (collisionWorld: CollisionWorld*, input: ControllerInput, deltaSeconds: f32) -> ControllerEvents {
            events~ ControllerEvents = ControllerEvents { };
            wasGrounded: bool = grounded;

            if grounded {
                if ground := groundCollider {
                    if !ground.isStatic {
                        motion: Mat4 = collisionWorld->BodyStepMotion(ground.body);
                        carried: Vec3 = lantern:::core:::TransformPoint3(motion, feetPosition) - feetPosition;
                        if lantern:::core:::LengthSquared3(carried) > 0.0f {
                            MoveWithoutSliding(collisionWorld, carried, ground);
                        }
                    }
                }
            }

            if input.jumpPressed {
                jumpBufferRemaining = settings.jumpBufferSeconds;
            } else {
                jumpBufferRemaining = Math:::max(jumpBufferRemaining - deltaSeconds, 0.0f);
            }
            if grounded {
                secondsSinceGrounded = 0.0f;
            } else {
                secondsSinceGrounded = secondsSinceGrounded + deltaSeconds;
            }

            desired: Vec3 = ClampLengthMax3(Horizontal(input.moveDirection), 1.0f) * settings.walkSpeed;
            acceleration~ f32 = settings.airAcceleration;
            if grounded {
                acceleration = settings.groundAcceleration;
            }
            planar: Vec3 = MoveTowardsVector(Horizontal(velocity), desired, acceleration * deltaSeconds);
            velocity.x = planar.x;
            velocity.z = planar.z;

            if grounded {
                velocity.y = 0.0f;
            } else {
                releasedEarly: bool = risingFromJump && !input.jumpHeld && velocity.y > 0.0f;
                multiplier~ f32 = 1.0f;
                if releasedEarly {
                    multiplier = settings.jumpReleaseGravityMultiplier;
                }
                velocity.y = Math:::max(velocity.y - settings.gravity * multiplier * deltaSeconds, -settings.maxFallSpeed);
            }

            canJump: bool = grounded || secondsSinceGrounded <= settings.coyoteSeconds;
            if jumpBufferRemaining > 0.0f && canJump {
                velocity.y = settings.JumpSpeed();
                jumpBufferRemaining = 0.0f;
                secondsSinceGrounded = lantern:::core:::INFINITY;
                grounded = false;
                groundCollider = null;
                risingFromJump = true;
                events.jumped = true;
            }

            displacement~ Vec3 = velocity * deltaSeconds;
            if grounded {
                normal: Vec3 = groundNormal;
                displacement.y = -(normal.x * displacement.x + normal.z * displacement.z) / Math:::max(normal.y, 0.001f);
            }
            fallingSpeed: f32 = -velocity.y;
            events = MoveAndSlide(collisionWorld, displacement, events);

            if velocity.y <= 0.0f {
                risingFromJump = false;
                reach~ f32 = settings.skinWidth;
                if wasGrounded {
                    reach = settings.groundSnapDistance;
                }
                ProbeGround(collisionWorld, reach);
            } else {
                grounded = false;
                groundCollider = null;
            }
            if grounded {
                velocity.y = 0.0f;
                if !wasGrounded {
                    events.landedWithSpeed = Math:::max(fallingSpeed, 0.0f);
                }
            }

            Depenetrate(collisionWorld);
            return events;
        }

        /**
         * Moves the body along `displacement`, stopping at the first thing it hits, ignoring `ignore`. It carries the
         * body with a moving platform without letting the platform's own collider stop it.
         */
        MoveWithoutSliding~: (collisionWorld: CollisionWorld*, displacement: Vec3, ignore: ColliderId?) -> void {
            capsule: Capsule = settings.CapsuleShape();
            center: Vec3 = CapsuleCenter();
            if hit := collisionWorld->CapsuleCast(capsule, center, displacement, ignore) {
                SetCapsuleCenter(center + displacement * hit.fraction + hit.normal * settings.skinWidth);
            } else {
                SetCapsuleCenter(center + displacement);
            }
        }

        /**
         * Moves by `displacement`. Each time the body hits something it keeps the part of the movement that runs along
         * the surface and loses the part that goes into it, for up to MAX_SLIDE_ITERATIONS hits. After two surfaces
         * it slides along their crease; after three it stops. A steep surface met on the ground first tries a step up,
         * and a ceiling stops an upward velocity. Returns the events, with `hitCeiling` set if that happened.
         */
        MoveAndSlide~: (collisionWorld: CollisionWorld*, displacement: Vec3, incomingEvents: ControllerEvents) -> ControllerEvents {
            events~ ControllerEvents = incomingEvents;
            capsule: Capsule = settings.MovementCapsule();
            center~ Vec3 = CapsuleCenter();
            remaining~ Vec3 = displacement;
            firstSlideNormal~ Vec3 = Vec3 { };
            slideNormalCount~ usize = 0;
            for iteration~ usize = 0; iteration < MAX_SLIDE_ITERATIONS; iteration++ {
                if lantern:::core:::LengthSquared3(remaining) < 0.000000000001f {
                    break;
                }
                found: ShapeHit? = collisionWorld->CapsuleCast(capsule, center, remaining, null);
                if found == null {
                    center = center + remaining;
                    break;
                }
                hit: ShapeHit = found ?? ShapeHit { };
                center = center + remaining * hit.fraction;
                remaining = remaining * (1.0f - hit.fraction);
                walkable: bool = IsWalkable(hit.normal);

                if grounded && !walkable {
                    SetCapsuleCenter(center);
                    if steppedCenter := TryStepUp(collisionWorld, Horizontal(remaining)) {
                        center = steppedCenter;
                        remaining.x = 0.0f;
                        remaining.z = 0.0f;
                        continue;
                    }
                }
                if hit.normal.y < -0.3f && velocity.y > 0.0f {
                    velocity.y = 0.0f;
                    events.hitCeiling = true;
                }

                slideNormal~ Vec3 = hit.normal;
                if grounded && !walkable {
                    if flattened := TryNormalize3(Horizontal(hit.normal)) {
                        slideNormal = flattened;
                    }
                }
                intoSurface: f32 = velocity.dot(slideNormal);
                if intoSurface < 0.0f && !(walkable && grounded) {
                    velocity = velocity - slideNormal * intoSurface;
                }
                slideNormalCount += 1;
                if slideNormalCount == 1 {
                    firstSlideNormal = slideNormal;
                    remaining = remaining - slideNormal * remaining.dot(slideNormal);
                } else if slideNormalCount == 2 {
                    if direction := TryNormalize3(firstSlideNormal.cross(slideNormal)) {
                        remaining = direction * remaining.dot(direction);
                    } else {
                        remaining = remaining - slideNormal * remaining.dot(slideNormal);
                    }
                } else {
                    remaining = Vec3 { };
                }
            }
            SetCapsuleCenter(center);
            return events;
        }

        /**
         * How much of `displacement` can be travelled before hitting something, from 0 to 1 (1 when nothing is hit).
         */
        CastFractionOr :: (collisionWorld: CollisionWorld*, capsule: Capsule, center: Vec3, displacement: Vec3) -> f32 {
            if hit := collisionWorld->CapsuleCast(capsule, center, displacement, null) {
                return hit.fraction;
            }
            return 1.0f;
        }

        /**
         * Tries to climb a ledge of up to `stepHeight`: raise the body, move forward, then lower it. The result is the
         * new body centre when it ends up on walkable ground higher than it started, else null.
         */
        TryStepUp :: (collisionWorld: CollisionWorld*, forwardMotion: Vec3) -> Vec3? {
            capsule: Capsule = settings.MovementCapsule();
            forwardLength: f32 = forwardMotion.length();
            if forwardLength < 0.00001f {
                return null;
            }
            forwardDirection: Vec3 = forwardMotion / forwardLength;
            forward: Vec3 = forwardDirection * Math:::max(forwardLength, settings.skinWidth * 4.0f);
            start: Vec3 = CapsuleCenter();

            up: Vec3 = lantern:::core:::WorldUp() * settings.stepHeight;
            raised: Vec3 = start + up * CastFractionOr(collisionWorld, capsule, start, up);
            advanced: Vec3 = raised + forward * CastFractionOr(collisionWorld, capsule, raised, forward);
            if Horizontal(advanced - start).length() < settings.skinWidth {
                return null;
            }
            down: Vec3 = lantern:::core:::WorldUp() * -(raised.y - start.y + settings.skinWidth);
            found: ShapeHit? = collisionWorld->CapsuleCast(capsule, advanced, down, null);
            guard found return null;
            hit: ShapeHit = found!;
            landsOnWalkable~ bool = IsWalkable(hit.normal);
            if !landsOnWalkable {
                landsOnWalkable = WalkableFaceNear(collisionWorld, hit.point, forwardDirection) != null;
            }
            if !landsOnWalkable {
                return null;
            }
            landed: Vec3 = advanced + down * hit.fraction;
            if landed.y > start.y + settings.skinWidth {
                return landed;
            }
            return null;
        }

        /**
         * A ray straight down just beside `contact`, in `direction`. Returns the normal of the walkable face it hits, or
         * null. It tells a capsule resting on the rounded edge of a ledge from one touching a wall.
         */
        WalkableFaceNear :: (collisionWorld: CollisionWorld*, contact: Vec3, direction: Vec3) -> Vec3? {
            origin: Vec3 = contact + NormalizeOrZero3(Horizontal(direction)) * WALKABLE_FACE_SIDE_OFFSET + lantern:::core:::WorldUp() * WALKABLE_FACE_START_ABOVE;
            found: RayHit? = collisionWorld->Raycast(origin, Vec3 { x: 0.0f, y: -1.0f, z: 0.0f }, WALKABLE_FACE_START_ABOVE + settings.stepHeight);
            guard found return null;
            hit: RayHit = found!;
            if IsWalkable(hit.normal) {
                return hit.normal;
            }
            return null;
        }

        /**
         * Casts the body down by `down`. The ground it finds may be a face that isn't walkable by its own normal (the
         * body touched an edge), so it also looks for a walkable face ahead of the movement and toward the body's axis.
         */
        FindGround :: (collisionWorld: CollisionWorld*, center: Vec3, down: Vec3) -> GroundProbe? {
            found: ShapeHit? = collisionWorld->CapsuleCast(settings.MovementCapsule(), center, down, null);
            guard found return null;
            hit: ShapeHit = found!;
            if IsWalkable(hit.normal) {
                return GroundProbe { hit: hit, normal: hit.normal };
            }
            alongVelocity: Vec3 = Horizontal(velocity);
            if lantern:::core:::LengthSquared3(alongVelocity) > 0.00000001f {
                if faceNormal := WalkableFaceNear(collisionWorld, hit.point, alongVelocity) {
                    return GroundProbe { hit: hit, normal: faceNormal };
                }
            }
            towardAxis: Vec3 = Horizontal(center - hit.point);
            if lantern:::core:::LengthSquared3(towardAxis) > 0.00000001f {
                if faceNormal := WalkableFaceNear(collisionWorld, hit.point, towardAxis) {
                    return GroundProbe { hit: hit, normal: faceNormal };
                }
            }
            return null;
        }

        /**
         * Looks `reach` below the body. On ground it snaps the body to it and records the normal and the collider (so a
         * moving platform can carry the body); otherwise it marks the body as airborne.
         */
        ProbeGround~: (collisionWorld: CollisionWorld*, reach: f32) -> void {
            center: Vec3 = CapsuleCenter();
            down: Vec3 = lantern:::core:::WorldUp() * -reach;
            if ground := FindGround(collisionWorld, center, down) {
                SetCapsuleCenter(center + down * ground.hit.fraction);
                grounded = true;
                groundNormal = ground.normal;
                groundCollider = ground.hit.collider;
            } else {
                grounded = false;
                groundCollider = null;
                groundNormal = lantern:::core:::WorldUp();
            }
        }

        /**
         * If the body overlaps geometry (a platform moved into it, say), pushes it out along the deepest contact's
         * normal, up to MAX_DEPENETRATION_ITERATIONS times.
         */
        Depenetrate~: (collisionWorld: CollisionWorld*) -> void {
            capsule: Capsule = settings.CapsuleShape();
            for iteration~ usize = 0; iteration < MAX_DEPENETRATION_ITERATIONS; iteration++ {
                contacts: Array<Contact>! = collisionWorld->CapsuleContacts(capsule, CapsuleCenter(), null);
                if contacts.length() == 0 {
                    delete contacts;
                    break;
                }
                deepest: Contact = contacts[0];
                delete contacts;
                if deepest.depth <= 0.0001f {
                    break;
                }
                SetCapsuleCenter(CapsuleCenter() + deepest.normal * (deepest.depth + settings.skinWidth * 0.5f));
                intoSurface: f32 = velocity.dot(deepest.normal);
                if intoSurface < 0.0f {
                    velocity = velocity - deepest.normal * intoSurface;
                }
            }
        }
    }
}
