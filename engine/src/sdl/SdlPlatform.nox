Sdl :: import Sdl;

lantern:::sdl :: namespace {
    SdlPlatform :: class {
        implements:
            lantern:::platform:::PlatformBackend;
    public:
        window~ SdlWindow*!;
        gamepad~ raw Sdl:::SDL_Gamepad~* = null;
        gamepadId~ u32 = 0;
        mouseCaptured~ bool = false;

        SdlPlatform~: (ownedWindow: SdlWindow*!) {
            window = ownedWindow!;
        }

        !SdlPlatform~: () {
            if gamepad != null {
                unsafe {
                    Sdl:::SDL_CloseGamepad(gamepad);
                }
            }
            delete window;
        }

        Window :: () -> SdlWindow* {
            return window;
        }

        HasGamepad :: () -> bool {
            return gamepad != null;
        }

        OpenGamepad~: (id: u32) -> void {
            if gamepad != null {
                return;
            }
            opened~ raw Sdl:::SDL_Gamepad~* = null;
            unsafe {
                opened = Sdl:::SDL_OpenGamepad(id);
            }
            if opened == null {
                LogSdlError("input", "SDL_OpenGamepad");
                return;
            }
            lantern:::core:::LogInfo("input", "gamepad connected");
            gamepad = opened;
            gamepadId = id;
        }

        CloseGamepad~: (id: u32) -> bool {
            if gamepad == null || gamepadId != id {
                return false;
            }
            unsafe {
                Sdl:::SDL_CloseGamepad(gamepad);
            }
            gamepad = null;
            lantern:::core:::LogInfo("input", "gamepad disconnected");
            return true;
        }

        PumpEvents~: () -> Array<lantern:::platform:::PlatformEvent>! {
            events~ Array<lantern:::platform:::PlatformEvent>! = [];
            event~ Sdl:::SDL_Event = Sdl:::SDL_Event { };
            polled~ bool = true;
            while polled {
                unsafe {
                    polled = Sdl:::SDL_PollEvent(event);
                }
                if !polled {
                    break;
                }
                translated := Translate(event);
                when translated <TranslatedEvent> {
                    Event(platformEvent) -> {
                        events.push(platformEvent);
                    },
                    GamepadAdded(id) -> {
                        OpenGamepad(id);
                        events.push(lantern:::platform:::PlatformEvent:::GamepadConnected);
                    },
                    GamepadRemoved(id) -> {
                        if CloseGamepad(id) {
                            events.push(lantern:::platform:::PlatformEvent:::GamepadDisconnected);
                        }
                    },
                    Ignored -> {},
                }
            }
            return events!;
        }

        RequestQuit :: () -> bool {
            quitEvent~ Sdl:::SDL_Event = Sdl:::SDL_Event { };
            pushed~ bool = false;
            unsafe {
                reinterpret<Sdl:::SDL_CommonEvent>(quitEvent)->type = Sdl:::SDL_EVENT_QUIT;
                pushed = Sdl:::SDL_PushEvent(quitEvent);
            }
            return pushed;
        }

        SecondsSinceStart :: () -> f64 {
            ticks~ u64 = 0;
            unsafe {
                ticks = Sdl:::SDL_GetTicksNS();
            }
            return f64(ticks) / 1000000000.0f;
        }

        CurrentWindowMetrics :: () -> lantern:::platform:::WindowMetrics {
            return window->Metrics();
        }

        SetMouseCaptured~: (captured: bool) -> void {
            if captured == mouseCaptured {
                return;
            }
            changed~ bool = false;
            unsafe {
                changed = Sdl:::SDL_SetWindowRelativeMouseMode(window->Raw(), captured);
            }
            if changed {
                mouseCaptured = captured;
            } else {
                LogSdlError("input", "SDL_SetWindowRelativeMouseMode");
            }
        }
    }
}
