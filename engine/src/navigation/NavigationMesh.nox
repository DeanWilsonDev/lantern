lantern:::navigation :: namespace {
    /**
     * The kinds of link between two nodes. A walk link is ordinary walking (steps and slopes included), a drop link walks
     * off an edge and falls to the ground below, and a jump link needs the jump button: a gap, or a ledge too high to step
     * up. A ride link is a trip on a moving platform between its two landings. There is no climb link: the partner can't
     * climb, so a way that needs climbing has no path.
     */
    LINK_WALK: i32 : 0;
    LINK_DROP: i32 : 1;
    LINK_JUMP: i32 : 2;
    LINK_RIDE: i32 : 3;

    /**
     * The parts of the level that change after the graph is built. A gate is a volume of the static floor that a door
     * shuts. A surface is a patch of floor that exists only while a slab or a bridge is there. A ride is a platform that
     * carries a body between two landings.
     */
    FEATURE_GATE: i32 : 0;
    FEATURE_SURFACE: i32 : 1;
    FEATURE_RIDE: i32 : 2;
    NO_FEATURE: i32 : -1;
    ANY_FEATURE: i32 : -2;
    /**
     * Added to the cost of each time a route steps onto fragile ground or into a shut door or bridge to wait for it, and of
     * waiting for a platform, so a route that needs none of them wins. It is charged once per crossing, not per node, or
     * jumping over the fragile ground would look cheaper than walking it.
     */
    FRAGILE_COST_PENALTY: f32 : 6.0f;
    WAIT_COST_PENALTY: f32 : 12.0f;
    /**
     * How far a surface's nodes may stand outside its box, so two slabs that meet share a column of nodes at the seam.
     */
    SURFACE_OVERLAP: f32 : 0.1f;
    RIDE_COST_PENALTY: f32 : 8.0f;
    /**
     * How far from a gate's box a node still counts as in the way, in metres: the body's radius, so she stops short of a
     * door instead of touching it.
     */
    GATE_HEIGHT_MARGIN: f32 : 0.5f;

    /**
     * The "no node" index, and the cost of an unreached node.
     */
    NO_NODE: i32 : -1;
    UNREACHED_COST: f32 : 1000000000.0f;

    /**
     * How many floors one column of the grid may hold (a street, a bridge over it, a roof over that).
     */
    MAX_FLOORS_PER_COLUMN: i32 : 6;
    /**
     * Surfaces closer than this in height count as one floor.
     */
    SAME_FLOOR_TOLERANCE: f32 : 0.04f;
    TIGHT_COST_FACTOR: f32 : 3.0f;
    /**
     * A wall closer to a node than this fraction of the agent's radius rules the node out. The agent's real body is wider,
     * so a slot just wider than it still has nodes inside it; the controller slides the rest. A node closer to a wall than
     * the real radius is "tight": a path may use it but pays TIGHT_COST_FACTOR times as much, and the smoother never cuts a
     * corner through one.
     */
    CLEARANCE_FRACTION: f32 : 0.25f;
    /**
     * A contact shallower than this is a touch, not a wall.
     */
    CLEARANCE_TOLERANCE: f32 : 0.03f;
    /**
     * A contact whose normal points up at least this much is ground, not a wall.
     */
    GROUND_CONTACT_NORMAL_Y: f32 : 0.65f;
    /**
     * How far a drop link may reach sideways, in metres. A longer fall away from the edge is a jump.
     */
    DROP_REACH: f32 : 1.5f;
    /**
     * How far sideways a jump up onto a ledge may reach, in metres.
     */
    LEDGE_JUMP_REACH: f32 : 1.5f;
    /**
     * Added to the cost of a drop and of a jump so a path prefers walking, and to a jump so it prefers a drop.
     */
    DROP_COST_PENALTY: f32 : 1.0f;
    JUMP_COST_PENALTY: f32 : 4.0f;
    /**
     * How far apart the samples are when a straight line is checked, and the longest straight line the smoother tries.
     */
    STRAIGHT_SAMPLE_SPACING: f32 : 0.25f;
    SMOOTH_LOOKAHEAD_POINTS: i32 : 24;
    /**
     * How many cells around a point the nearest node is looked for, and how far above or below the point it may be.
     */
    SNAP_CELL_RADIUS: i32 : 4;
    SNAP_HEIGHT: f32 : 1.6f;

    /**
     * What kind of body walks the mesh, in metres and degrees. The defaults are the partner's.
     */
    NavigationAgent :: struct {
        radius~ f32 = 0.24f;
        height~ f32 = 1.5f;
        stepHeight~ f32 = 0.3f;
        maxSlopeDegrees~ f32 = 46.0f;
        maxDrop~ f32 = 3.0f;
        maxJumpUp~ f32 = 1.0f;
        maxJumpAcross~ f32 = 2.5f;
        cellSize~ f32 = 0.4f;

        /**
         * The radius used to keep nodes off walls.
         */
        ClearanceRadius :: () -> f32 {
            return radius * CLEARANCE_FRACTION;
        }

        /**
         * The steepest slope as a rise over a run.
         */
        MaxSlopeRise :: () -> f32 {
            return Math:::tan(maxSlopeDegrees * (Math:::PI / 180.0f));
        }

        /**
         * The smallest upward component of a surface normal that is still floor.
         */
        MinGroundNormalY :: () -> f32 {
            return Math:::cos(maxSlopeDegrees * (Math:::PI / 180.0f));
        }

        /**
         * The body with its feet at `feet`, from the top of a step up: low obstacles are stepped over, so they don't
         * count. The same shape the character controller moves with.
         */
        ClearanceCapsule :: () -> lantern:::physics:::Capsule {
            return lantern:::physics:::Capsule:::Upright(ClearanceRadius(), height - stepHeight);
        }

        /**
         * The same shape with the agent's whole radius.
         */
        BodyCapsule :: () -> lantern:::physics:::Capsule {
            return lantern:::physics:::Capsule:::Upright(radius, height - stepHeight);
        }

        /**
         * Where the clearance capsule's centre is when the feet are at `feet`.
         */
        ClearanceCenter :: (feet: Vec3) -> Vec3 {
            return feet + Vec3 {
                x: 0.0f,
                y: stepHeight + (height - stepHeight) * 0.5f + 0.02f,
                z: 0.0f
            };
        }
    }

    /**
     * A route: the places to walk to in order, how each is reached (a link kind), which feature each depends on (the ride
     * a ride point is on, or the shut gate or bridge a point is in, else NO_FEATURE) and whether the route gets all the
     * way to where it was asked to go. An incomplete route ends at the reachable place nearest the goal.
     */
    NavigationPath :: class {
    public:
        points~ Array<Vec3>! = [];
        kinds~ Array<i32>! = [];
        features~ Array<i32>! = [];
        isComplete~ bool = false;

        NavigationPath~: () { }

        !NavigationPath~: () {
            delete points;
            delete kinds;
            delete features;
        }

        Length :: () -> i32 {
            return i32(points.length());
        }
    }

    /**
     * The open list of the search: a binary heap of (node, estimated total cost), smallest first. A node can be in it more
     * than once, and the search skips the stale entries.
     */
    OpenList :: class {
    public:
        nodes~ Array<i32>! = [];
        costs~ Array<f32>! = [];

        OpenList~: () { }

        !OpenList~: () {
            delete nodes;
            delete costs;
        }

        IsEmpty :: () -> bool {
            return nodes.length() == 0;
        }

        Push~: (node: i32, cost: f32) -> void {
            nodes.push(node);
            costs.push(cost);
            child~ usize = nodes.length() - 1;
            while child > 0 {
                parent: usize = (child - 1) / 2;
                if costs[parent] <= costs[child] {
                    break;
                }
                Swap(parent, child);
                child = parent;
            }
        }

        PopNode~: () -> i32 {
            top: i32 = nodes[0];
            lastIndex: usize = nodes.length() - 1;
            nodes[0] = nodes[lastIndex];
            costs[0] = costs[lastIndex];
            nodes.pop();
            costs.pop();
            count: usize = nodes.length();
            parent~ usize = 0;
            while true {
                left: usize = parent * 2 + 1;
                right: usize = left + 1;
                smallest~ usize = parent;
                if left < count && costs[left] < costs[smallest] {
                    smallest = left;
                }
                if right < count && costs[right] < costs[smallest] {
                    smallest = right;
                }
                if smallest == parent {
                    break;
                }
                Swap(parent, smallest);
                parent = smallest;
            }
            return top;
        }

        Swap~: (first: usize, second: usize) -> void {
            node: i32 = nodes[first];
            cost: f32 = costs[first];
            nodes[first] = nodes[second];
            costs[first] = costs[second];
            nodes[second] = node;
            costs[second] = cost;
        }
    }

    /**
     * The floor of the level as a graph the partner can find routes over. The static collision world is sampled on a grid
     * of columns; every standable floor in a column is a node; neighbouring nodes are joined by walk links, and nodes at an
     * edge by drop and jump links. Moving bodies are not in it, so a route ignores a door, a lift or a crumbling slab.
     */
    NavigationMesh :: class {
    public:
        agent~ NavigationAgent = NavigationAgent { };
        originX~ f32 = 0.0f;
        originZ~ f32 = 0.0f;
        columnsX~ i32 = 0;
        columnsZ~ i32 = 0;
        lowestY~ f32 = 0.0f;
        highestY~ f32 = 0.0f;
        columnHeads~ Array<i32>! = [];
        nodePositions~ Array<Vec3>! = [];
        nodeNextInColumn~ Array<i32>! = [];
        nodeFirstLink~ Array<i32>! = [];
        nodeWalkLinks~ Array<i32>! = [];
        nodeIsTight~ Array<bool>! = [];
        linkTarget~ Array<i32>! = [];
        linkKind~ Array<i32>! = [];
        linkCost~ Array<f32>! = [];
        linkNext~ Array<i32>! = [];
        linkFeature~ Array<i32>! = [];
        nodeFeature~ Array<i32>! = [];
        featureKind~ Array<i32>! = [];
        featureIsOpen~ Array<bool>! = [];
        featureIsFragile~ Array<bool>! = [];
        featureCanBeWaitedFor~ Array<bool>! = [];
        revision~ i32 = 0;
        edgeTargetFeature~ i32 = ANY_FEATURE;

        NavigationMesh~: () { }

        !NavigationMesh~: () {
            delete columnHeads;
            delete nodePositions;
            delete nodeNextInColumn;
            delete nodeFirstLink;
            delete nodeWalkLinks;
            delete nodeIsTight;
            delete linkTarget;
            delete linkKind;
            delete linkCost;
            delete linkNext;
            delete linkFeature;
            delete nodeFeature;
            delete featureKind;
            delete featureIsOpen;
            delete featureIsFragile;
            delete featureCanBeWaitedFor;
        }

        NodeCount :: () -> i32 {
            return i32(nodePositions.length());
        }

        LinkCount :: () -> i32 {
            return i32(linkTarget.length());
        }

        /**
         * Samples the static level and builds the graph for `settings`, replacing any earlier one. Returns the node count; an
         * empty world gives 0.
         */
        Build~: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            settings: NavigationAgent
        ) -> i32 {
            Clear();
            agent = settings;
            bounds: lantern:::core:::Aabb = collisionWorld->StaticBounds();
            if bounds.IsEmpty() {
                return 0;
            }
            originX = bounds.min.x;
            originZ = bounds.min.z;
            lowestY = bounds.min.y - 0.5f;
            highestY = bounds.max.y + 0.5f;
            columnsX = i32(Math:::ceil((bounds.max.x - bounds.min.x) / agent.cellSize)) + 1;
            columnsZ = i32(Math:::ceil((bounds.max.z - bounds.min.z) / agent.cellSize)) + 1;
            columnCount: i32 = columnsX * columnsZ;
            for column~ i32 = 0; column < columnCount; column++ {
                columnHeads.push(NO_NODE);
            }
            for columnZ~ i32 = 0; columnZ < columnsZ; columnZ++ {
                for columnX~ i32 = 0; columnX < columnsX; columnX++ {
                    SampleColumn(collisionWorld, columnX, columnZ);
                }
            }
            nodeTotal: i32 = NodeCount();
            for node~ i32 = 0; node < nodeTotal; node++ {
                LinkWalkNeighbours(collisionWorld, node);
            }
            for node~ i32 = 0; node < nodeTotal; node++ {
                if nodeWalkLinks[usize(node)] < 4 {
                    LinkEdgeNode(collisionWorld, node);
                }
            }
            return nodeTotal;
        }

        /**
         * Removes every node and link.
         */
        Clear~: () -> void {
            columnHeads.clear();
            nodePositions.clear();
            nodeNextInColumn.clear();
            nodeFirstLink.clear();
            nodeWalkLinks.clear();
            nodeIsTight.clear();
            linkTarget.clear();
            linkKind.clear();
            linkCost.clear();
            linkNext.clear();
            linkFeature.clear();
            nodeFeature.clear();
            featureKind.clear();
            featureIsOpen.clear();
            featureIsFragile.clear();
            featureCanBeWaitedFor.clear();
            revision = 0;
            edgeTargetFeature = ANY_FEATURE;
            columnsX = 0;
            columnsZ = 0;
        }

        /**
         * The node nearest `point` (flat distance, with height counting double), or NO_NODE when none is within a few cells
         * and a body's height of it.
         */
        NearestNode :: (point: Vec3) -> i32 {
            if columnsX == 0 {
                return NO_NODE;
            }
            centerX: i32 = i32(Math:::floor((point.x - originX) / agent.cellSize));
            centerZ: i32 = i32(Math:::floor((point.z - originZ) / agent.cellSize));
            best~ i32 = NO_NODE;
            bestScore~ f32 = UNREACHED_COST;
            for columnZ~ i32 = centerZ - SNAP_CELL_RADIUS; columnZ <= centerZ +
                SNAP_CELL_RADIUS; columnZ++ {
                for columnX~ i32 = centerX - SNAP_CELL_RADIUS; columnX <= centerX +
                    SNAP_CELL_RADIUS; columnX++ {
                    if !InColumns(columnX, columnZ) {
                        continue;
                    }
                    node~ i32 = columnHeads[ColumnIndex(columnX, columnZ)];
                    while node != NO_NODE {
                        position: Vec3 = nodePositions[usize(node)];
                        rise: f32 = Math:::abs(position.y - point.y);
                        if rise <= SNAP_HEIGHT {
                            flatX: f32 = position.x - point.x;
                            flatZ: f32 = position.z - point.z;
                            score: f32 = Math:::sqrt(flatX * flatX + flatZ * flatZ) + rise * 2.0f;
                            if score < bestScore {
                                bestScore = score;
                                best = node;
                            }
                        }
                        node = nodeNextInColumn[usize(node)];
                    }
                }
            }
            return best;
        }

        /**
         * A route from `from` to `to` over the graph as it is now, with fragile ground allowed. See `FindRoute`.
         */
        FindPath :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3
        ) -> NavigationPath*! {
            return FindRoute(collisionWorld, from, to, true);
        }

        /**
         * A route from `from` to `to`. Both are snapped to the nearest node. Gates that are shut and surfaces that are not
         * there are left out, so the route goes round them when it can. When it can't, the route goes through the shut
         * gates or the bridges that are down, and the points inside them carry the feature, so the walker can wait for it
         * to open. Fragile ground is used only when `allowFragile`, and then it costs extra. When `to` can't be reached
         * the route goes to the reachable node nearest it and says so (`isComplete` false); when `from` is not near any
         * node the route is empty.
         */
        FindRoute :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3,
            allowFragile: bool
        ) -> NavigationPath*! {
            direct := Plan(collisionWorld, from, to, allowFragile, false);
            if direct->isComplete || featureKind.length() == 0 {
                return direct!;
            }
            waiting := Plan(collisionWorld, from, to, allowFragile, true);
            if waiting->isComplete {
                delete direct;
                return waiting!;
            }
            delete waiting;
            return direct!;
        }

        /**
         * Whether the walker may stand on `node`: it holds no feature, or its feature is open, or the search is allowed to
         * wait for it. Fragile ground is out unless `allowFragile`.
         */
        IsNodeUsable :: (node: i32, allowFragile: bool, waitForShut: bool) -> bool {
            feature: i32 = nodeFeature[usize(node)];
            if feature == NO_FEATURE {
                return true;
            }
            if featureIsFragile[usize(feature)] && !allowFragile {
                return false;
            }
            if featureIsOpen[usize(feature)] {
                return true;
            }
            return waitForShut && featureCanBeWaitedFor[usize(feature)];
        }

        /**
         * One search over the graph: A* with a straight line estimate.
         */
        Plan :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3,
            allowFragile: bool,
            waitForShut: bool
        ) -> NavigationPath*! {
            path := new NavigationPath();
            startNode: i32 = NearestNode(from);
            goalNode: i32 = NearestNode(to);
            if startNode == NO_NODE {
                return path!;
            }
            nodeTotal: usize = nodePositions.length();
            cost~ Array<f32>! = [];
            cameFrom~ Array<i32>! = [];
            cameByLink~ Array<i32>! = [];
            cameByFeature~ Array<i32>! = [];
            settled~ Array<bool>! = [];
            for index~ usize = 0; index < nodeTotal; index++ {
                cost.push(UNREACHED_COST);
                cameFrom.push(NO_NODE);
                cameByLink.push(LINK_WALK);
                cameByFeature.push(NO_FEATURE);
                settled.push(false);
            }
            defer delete cost;
            defer delete cameFrom;
            defer delete cameByLink;
            defer delete cameByFeature;
            defer delete settled;
            open := new OpenList();
            defer delete open;
            cost[usize(startNode)] = 0.0f;
            open->Push(startNode, 0.0f);
            closest~ i32 = startNode;
            closestDistance~ f32 = UNREACHED_COST;
            reached~ bool = false;
            while !open->IsEmpty() {
                current: i32 = open->PopNode();
                if settled[usize(current)] {
                    continue;
                }
                settled[usize(current)] = true;
                currentPosition: Vec3 = nodePositions[usize(current)];
                toGoal: f32 = (currentPosition - to).length();
                if toGoal < closestDistance {
                    closestDistance = toGoal;
                    closest = current;
                }
                if current == goalNode {
                    reached = true;
                    break;
                }
                link~ i32 = nodeFirstLink[usize(current)];
                while link != NO_NODE {
                    target: i32 = linkTarget[usize(link)];
                    linkOwner: i32 = linkFeature[usize(link)];
                    isLinkOpen: bool = linkOwner == NO_FEATURE || featureIsOpen[usize(linkOwner)];
                    if !settled[usize(target)] && isLinkOpen && IsNodeUsable(target, allowFragile, waitForShut) {
                        total~ f32 = cost[usize(current)] + linkCost[usize(link)];
                        targetFeature: i32 = nodeFeature[usize(target)];
                        currentFeature: i32 = nodeFeature[usize(current)];
                        if targetFeature != NO_FEATURE && targetFeature != currentFeature {
                            isOnFragileGround: bool = currentFeature != NO_FEATURE && featureIsFragile[usize(currentFeature)];
                            if featureIsFragile[usize(targetFeature)] && !isOnFragileGround {
                                total += FRAGILE_COST_PENALTY;
                            }
                            if !featureIsOpen[usize(targetFeature)] {
                                total += WAIT_COST_PENALTY;
                            }
                        }
                        if total < cost[usize(target)] {
                            cost[usize(target)] = total;
                            cameFrom[usize(target)] = current;
                            cameByLink[usize(target)] = linkKind[usize(link)];
                            cameByFeature[usize(target)] = linkOwner;
                            open->Push(target, total + (nodePositions[usize(target)] - to).length());
                        }
                    }
                    link = linkNext[usize(link)];
                }
            }
            endNode: i32 = reached ? goalNode : closest;
            chainPoints~ Array<Vec3>! = [];
            chainKinds~ Array<i32>! = [];
            chainFeatures~ Array<i32>! = [];
            defer delete chainPoints;
            defer delete chainKinds;
            defer delete chainFeatures;
            walking~ i32 = endNode;
            while walking != NO_NODE {
                chainPoints.push(nodePositions[usize(walking)]);
                chainKinds.push(cameByLink[usize(walking)]);
                pointFeature~ i32 = cameByFeature[usize(walking)];
                nodeOwner: i32 = nodeFeature[usize(walking)];
                if pointFeature == NO_FEATURE && nodeOwner != NO_FEATURE && !featureIsOpen[usize(nodeOwner)] {
                    pointFeature = nodeOwner;
                }
                chainFeatures.push(pointFeature);
                walking = cameFrom[usize(walking)];
            }
            orderedPoints~ Array<Vec3>! = [];
            orderedKinds~ Array<i32>! = [];
            orderedFeatures~ Array<i32>! = [];
            defer delete orderedPoints;
            defer delete orderedKinds;
            defer delete orderedFeatures;
            for index~ usize = chainPoints.length(); index > 0; index-- {
                orderedPoints.push(chainPoints[index - 1]);
                orderedKinds.push(chainKinds[index - 1]);
                orderedFeatures.push(chainFeatures[index - 1]);
            }
            first~ usize = 0;
            if orderedPoints.length() > 1 {
                lead: Vec3 = orderedPoints[0] - from;
                if Math:::sqrt(lead.x * lead.x + lead.z * lead.z) < agent.cellSize * 1.5f &&
                    orderedFeatures[1] == NO_FEATURE && orderedKinds[1] == LINK_WALK {
                    first = 1;
                }
            }
            Smooth(collisionWorld, orderedPoints, orderedKinds, orderedFeatures, first, path);
            path->isComplete = reached;
            if reached && path->points.length() > 0 {
                lastPoint: Vec3 = path->points[path->points.length() - 1];
                gap: Vec3 = Vec3 { x: to.x - lastPoint.x, y: 0.0f, z: to.z - lastPoint.z };
                if gap.length() > 0.05f && gap.length() < agent.cellSize * 3.0f &&
                    Math:::abs(to.y - lastPoint.y) < SNAP_HEIGHT {
                    path->points.push(Vec3 { x: to.x, y: lastPoint.y, z: to.z });
                    path->kinds.push(LINK_WALK);
                    path->features.push(NO_FEATURE);
                }
            }
            return path!;
        }

        /**
         * Whether a route exists from `from` to `to`.
         */
        IsReachable :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3
        ) -> bool {
            path := FindPath(collisionWorld, from, to);
            defer delete path;
            return path->isComplete;
        }

        /**
         * How many features have been added.
         */
        FeatureCount :: () -> i32 {
            return i32(featureKind.length());
        }

        /**
         * How often a feature has changed between open and shut since the graph was built. A walker with a route plans again
         * when this has moved.
         */
        Revision :: () -> i32 {
            return revision;
        }

        /**
         * Whether a feature is open now: a gate that is open, a surface that is there, a ride that runs. A feature that
         * doesn't exist is shut.
         */
        IsFeatureAvailable :: (feature: i32) -> bool {
            if feature < 0 || feature >= FeatureCount() {
                return false;
            }
            return featureIsOpen[usize(feature)];
        }

        /**
         * Opens or shuts a feature. A change counts as a new revision.
         */
        SetFeatureAvailable~: (feature: i32, isAvailable: bool) -> void {
            if feature < 0 || feature >= FeatureCount() {
                return;
            }
            if featureIsOpen[usize(feature)] != isAvailable {
                featureIsOpen[usize(feature)] = isAvailable;
                revision += 1;
            }
        }

        NewFeature~: (kind: i32, isOpen: bool, isFragile: bool, canBeWaitedFor: bool) -> i32 {
            feature: i32 = FeatureCount();
            featureKind.push(kind);
            featureIsOpen.push(isOpen);
            featureIsFragile.push(isFragile);
            featureCanBeWaitedFor.push(canBeWaitedFor);
            return feature;
        }

        /**
         * Adds a gate: a box of the level (a door) that blocks the floor inside it while it is shut. The graph was built
         * from the static world, which has no door in it, so the nodes the door stands on are there already; this marks them
         * with the feature, so a route avoids them while the door is shut. Nodes within the agent's radius of the box count,
         * so a walker stops short of it. Returns the feature, to open and shut with `SetFeatureAvailable`.
         */
        AddGate~: (center: Vec3, halfExtents: Vec3, isOpen: bool) -> i32 {
            feature: i32 = NewFeature(FEATURE_GATE, isOpen, false, true);
            margin: f32 = agent.radius;
            nodeTotal: i32 = NodeCount();
            for node~ i32 = 0; node < nodeTotal; node++ {
                if nodeFeature[usize(node)] != NO_FEATURE {
                    continue;
                }
                position: Vec3 = nodePositions[usize(node)];
                if Math:::abs(position.x - center.x) <= halfExtents.x + margin &&
                    Math:::abs(position.z - center.z) <= halfExtents.z + margin &&
                    position.y >= center.y - halfExtents.y - GATE_HEIGHT_MARGIN &&
                    position.y <= center.y + halfExtents.y + 0.2f {
                    nodeFeature[usize(node)] = feature;
                }
            }
            return feature;
        }

        /**
         * Adds a surface: floor on top of a box that isn't in the static world (a slab that crumbles, a bridge that is raised
         * by a switch). Nodes go on the grid across the top of the box; they join each other and the neighbouring floor by
         * walking, and the edges join the ground nearby by drops and jumps. The nodes are in the graph while the feature is
         * open. A fragile surface is used only by a walker that allows it, and costs extra. `canBeWaitedFor` says a closed
         * surface is worth waiting for (a bridge that comes up) and not one that has gone for good. Returns the feature.
         */
        AddSurface~: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            center: Vec3,
            halfExtents: Vec3,
            isOpen: bool,
            isFragile: bool,
            canBeWaitedFor: bool
        ) -> i32 {
            feature: i32 = NewFeature(FEATURE_SURFACE, isOpen, isFragile, canBeWaitedFor);
            if columnsX == 0 {
                return feature;
            }
            top: f32 = center.y + halfExtents.y;
            inset: f32 = -SURFACE_OVERLAP;
            firstNode: i32 = NodeCount();
            minColumnX: i32 = i32(Math:::floor((center.x - halfExtents.x - originX) / agent.cellSize));
            maxColumnX: i32 = i32(Math:::floor((center.x + halfExtents.x - originX) / agent.cellSize));
            minColumnZ: i32 = i32(Math:::floor((center.z - halfExtents.z - originZ) / agent.cellSize));
            maxColumnZ: i32 = i32(Math:::floor((center.z + halfExtents.z - originZ) / agent.cellSize));
            for columnZ~ i32 = minColumnZ; columnZ <= maxColumnZ; columnZ++ {
                for columnX~ i32 = minColumnX; columnX <= maxColumnX; columnX++ {
                    if !InColumns(columnX, columnZ) {
                        continue;
                    }
                    columnCenter: Vec3 = ColumnCenter(columnX, columnZ);
                    if Math:::abs(columnCenter.x - center.x) > halfExtents.x - inset ||
                        Math:::abs(columnCenter.z - center.z) > halfExtents.z - inset {
                        continue;
                    }
                    node: i32 = NodeCount();
                    nodePositions.push(Vec3 { x: columnCenter.x, y: top, z: columnCenter.z });
                    nodeFirstLink.push(NO_NODE);
                    nodeWalkLinks.push(0);
                    nodeIsTight.push(false);
                    nodeFeature.push(feature);
                    columnIndex: usize = ColumnIndex(columnX, columnZ);
                    nodeNextInColumn.push(columnHeads[columnIndex]);
                    columnHeads[columnIndex] = node;
                }
            }
            nodeTotal: i32 = NodeCount();
            for node~ i32 = firstNode; node < nodeTotal; node++ {
                LinkSurfaceNode(collisionWorld, node, feature);
            }
            for node~ i32 = firstNode; node < nodeTotal; node++ {
                if nodeWalkLinks[usize(node)] < 4 {
                    LinkEdgeNode(collisionWorld, node);
                }
            }
            reach: f32 = agent.maxJumpAcross + agent.cellSize;
            edgeTargetFeature = feature;
            for node~ i32 = 0; node < firstNode; node++ {
                if nodeWalkLinks[usize(node)] >= 4 {
                    continue;
                }
                position: Vec3 = nodePositions[usize(node)];
                if position.x < center.x - halfExtents.x - reach || position.x > center.x + halfExtents.x + reach ||
                    position.z < center.z - halfExtents.z - reach || position.z > center.z + halfExtents.z + reach {
                    continue;
                }
                LinkEdgeNode(collisionWorld, node);
            }
            edgeTargetFeature = ANY_FEATURE;
            return feature;
        }

        /**
         * Joins a surface node to the nodes in the eight columns around it that were there first: nodes of the same surface
         * walk to each other, and other floor is walked to when the height change is a step and the body fits.
         */
        LinkSurfaceNode~: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            node: i32,
            feature: i32
        ) -> void {
            position: Vec3 = nodePositions[usize(node)];
            columnX: i32 = i32(Math:::floor((position.x - originX) / agent.cellSize));
            columnZ: i32 = i32(Math:::floor((position.z - originZ) / agent.cellSize));
            for offsetZ~ i32 = -1; offsetZ <= 1; offsetZ++ {
                for offsetX~ i32 = -1; offsetX <= 1; offsetX++ {
                    if offsetX == 0 && offsetZ == 0 {
                        continue;
                    }
                    if !InColumns(columnX + offsetX, columnZ + offsetZ) {
                        continue;
                    }
                    isDiagonal: bool = offsetX != 0 && offsetZ != 0;
                    neighbour~ i32 = columnHeads[ColumnIndex(columnX + offsetX, columnZ + offsetZ)];
                    while neighbour != NO_NODE {
                        isEarlier: bool = neighbour < node;
                        if isEarlier {
                            neighbourPosition: Vec3 = nodePositions[usize(neighbour)];
                            isSame: bool = nodeFeature[usize(neighbour)] == feature;
                            rise: f32 = Math:::abs(neighbourPosition.y - position.y);
                            if isSame || rise <= agent.stepHeight + 0.02f &&
                                CanWalkBetween(collisionWorld, position, neighbourPosition) {
                                distance: f32 = (neighbourPosition - position).length();
                                AddLink(node, neighbour, LINK_WALK, distance);
                                AddLink(neighbour, node, LINK_WALK, distance);
                                if !isDiagonal {
                                    nodeWalkLinks[usize(node)] += 1;
                                    nodeWalkLinks[usize(neighbour)] += 1;
                                }
                            }
                        }
                        neighbour = nodeNextInColumn[usize(neighbour)];
                    }
                }
            }
        }

        /**
         * Adds a ride: a platform that carries a body between two landings. `from` and `to` are the two ends of its trip,
         * a point on the platform at each. The nearest floor within `reach` of each (the landing beside the platform at
         * that end) is joined to the other by a ride link, both ways. Returns the feature, or -1 when an end has no landing.
         */
        AddRide~: (from: Vec3, to: Vec3, reach: f32) -> i32 {
            fromNode: i32 = NearestStaticNode(from, reach);
            toNode: i32 = NearestStaticNode(to, reach);
            if fromNode == NO_NODE || toNode == NO_NODE || fromNode == toNode {
                return -1;
            }
            feature: i32 = NewFeature(FEATURE_RIDE, true, false, false);
            cost: f32 = (nodePositions[usize(toNode)] - nodePositions[usize(fromNode)]).length() + RIDE_COST_PENALTY;
            AddLink(fromNode, toNode, LINK_RIDE, cost);
            linkFeature[linkFeature.length() - 1] = feature;
            AddLink(toNode, fromNode, LINK_RIDE, cost);
            linkFeature[linkFeature.length() - 1] = feature;
            return feature;
        }

        /**
         * The node of the static floor nearest `point` within `reach` along the ground and a body's step of height
         * either way, or NO_NODE.
         */
        NearestStaticNode :: (point: Vec3, reach: f32) -> i32 {
            if columnsX == 0 {
                return NO_NODE;
            }
            cells: i32 = i32(Math:::ceil(reach / agent.cellSize));
            centerX: i32 = i32(Math:::floor((point.x - originX) / agent.cellSize));
            centerZ: i32 = i32(Math:::floor((point.z - originZ) / agent.cellSize));
            best~ i32 = NO_NODE;
            bestDistance~ f32 = reach;
            for columnZ~ i32 = centerZ - cells; columnZ <= centerZ + cells; columnZ++ {
                for columnX~ i32 = centerX - cells; columnX <= centerX + cells; columnX++ {
                    if !InColumns(columnX, columnZ) {
                        continue;
                    }
                    node~ i32 = columnHeads[ColumnIndex(columnX, columnZ)];
                    while node != NO_NODE {
                        position: Vec3 = nodePositions[usize(node)];
                        flatX: f32 = position.x - point.x;
                        flatZ: f32 = position.z - point.z;
                        distance: f32 = Math:::sqrt(flatX * flatX + flatZ * flatZ);
                        if nodeFeature[usize(node)] == NO_FEATURE && distance < bestDistance &&
                            Math:::abs(position.y - point.y) <= agent.stepHeight + 0.3f {
                            bestDistance = distance;
                            best = node;
                        }
                        node = nodeNextInColumn[usize(node)];
                    }
                }
            }
            return best;
        }

        ColumnIndex :: (columnX: i32, columnZ: i32) -> usize {
            return usize(columnZ * columnsX + columnX);
        }

        InColumns :: (columnX: i32, columnZ: i32) -> bool {
            return columnX >= 0 && columnZ >= 0 && columnX < columnsX && columnZ < columnsZ;
        }

        ColumnCenter :: (columnX: i32, columnZ: i32) -> Vec3 {
            return Vec3 {
                x: originX + (f32(columnX) + 0.5f) * agent.cellSize,
                y: 0.0f,
                z: originZ + (f32(columnZ) + 0.5f) * agent.cellSize
            };
        }

        /**
         * Finds the standable floors in one column. Every triangle the vertical line through the column's centre crosses is
         * collected; a crossing of an upward-facing triangle is a floor candidate, and any crossing within a body's height
         * above it takes the headroom away.
         */
        SampleColumn~: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            columnX: i32,
            columnZ: i32
        ) -> void {
            center: Vec3 = ColumnCenter(columnX, columnZ);
            bottom: Vec3 = Vec3 { x: center.x, y: lowestY, z: center.z };
            top: Vec3 = Vec3 { x: center.x, y: highestY, z: center.z };
            lineBounds: lantern:::core:::Aabb = lantern:::core:::Aabb:::Create(
                bottom - Vec3 { x: 0.01f, y: 0.0f, z: 0.01f },
                top + Vec3 { x: 0.01f, y: 0.0f, z: 0.01f }
            );
            near: Array<lantern:::physics:::NearTriangle>! = collisionWorld->NearTriangles(
                lineBounds,
                null,
                false
            );
            defer delete near;
            floors~ Array<f32>! = [];
            crossings~ Array<f32>! = [];
            defer delete floors;
            defer delete crossings;
            minimumNormalY: f32 = agent.MinGroundNormalY();
            for candidate in near {
                if hit := lantern:::physics:::SegmentTriangleIntersection(
                    top,
                    bottom,
                    candidate.triangle
                ) {
                    crossings.push(hit.y);
                    if candidate.triangle.Normal().y >= minimumNormalY {
                        floors.push(hit.y);
                    }
                }
            }
            SortDescending(floors);
            head~ i32 = NO_NODE;
            tail~ i32 = NO_NODE;
            floorCount~ i32 = 0;
            lastFloor~ f32 = highestY + 10.0f;
            for floorHeight in floors {
                if lastFloor - floorHeight < SAME_FLOOR_TOLERANCE {
                    continue;
                }
                lastFloor = floorHeight;
                if floorCount >= MAX_FLOORS_PER_COLUMN {
                    break;
                }
                if !HasHeadroom(crossings, floorHeight) {
                    continue;
                }
                feet: Vec3 = Vec3 { x: center.x, y: floorHeight, z: center.z };
                if !HasClearance(collisionWorld, feet, agent.ClearanceCapsule()) {
                    continue;
                }
                node: i32 = NodeCount();
                nodePositions.push(feet);
                nodeNextInColumn.push(NO_NODE);
                nodeFirstLink.push(NO_NODE);
                nodeWalkLinks.push(0);
                nodeIsTight.push(!HasClearance(collisionWorld, feet, agent.BodyCapsule()));
                nodeFeature.push(NO_FEATURE);
                if tail == NO_NODE {
                    head = node;
                } else {
                    nodeNextInColumn[usize(tail)] = node;
                }
                tail = node;
                floorCount += 1;
            }
            columnHeads[ColumnIndex(columnX, columnZ)] = head;
        }

        /**
         * No surface crosses the column between a little above the floor and a body's height above it.
         */
        HasHeadroom :: (crossings: Array<f32>, floorHeight: f32) -> bool {
            for crossing in crossings {
                if crossing > floorHeight + SAME_FLOOR_TOLERANCE * 2.0f && crossing < floorHeight +
                    agent.height {
                    return false;
                }
            }
            return true;
        }

        /**
         * The body with its feet at `feet` touches no wall or ceiling (ground contacts are ignored).
         */
        HasClearance :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            feet: Vec3,
            capsule: lantern:::physics:::Capsule
        ) -> bool {
            contacts: Array<lantern:::physics:::Contact>! = collisionWorld->StaticCapsuleContacts(
                capsule,
                agent.ClearanceCenter(feet)
            );
            defer delete contacts;
            for contact in contacts {
                if contact.depth > CLEARANCE_TOLERANCE &&
                    contact.normal.y < GROUND_CONTACT_NORMAL_Y {
                    return false;
                }
            }
            return true;
        }

        /**
         * Whether the clearance body can move from standing at `from` to standing at `to` along the straight line between
         * them without touching the static level.
         */
        IsSweepClear :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3,
            capsule: lantern:::physics:::Capsule
        ) -> bool {
            displacement: Vec3 = to - from;
            if displacement.length() < 0.0001f {
                return true;
            }
            hit: lantern:::physics:::ShapeHit? = collisionWorld->StaticCapsuleCast(
                capsule,
                agent.ClearanceCenter(from),
                displacement
            );
            return hit == null;
        }

        /**
         * Joins `node` to the nodes in the four neighbouring columns ahead of it (east, south, and the two diagonals), both
         * ways, wherever walking between them works.
         */
        LinkWalkNeighbours~: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            node: i32
        ) -> void {
            position: Vec3 = nodePositions[usize(node)];
            columnX: i32 = i32(Math:::floor((position.x - originX) / agent.cellSize));
            columnZ: i32 = i32(Math:::floor((position.z - originZ) / agent.cellSize));
            offsetsX: i32[4] = [1, 0, 1, -1];
            offsetsZ: i32[4] = [0, 1, 1, 1];
            for offset~ usize = 0; offset < 4; offset++ {
                neighbourX: i32 = columnX + offsetsX[offset];
                neighbourZ: i32 = columnZ + offsetsZ[offset];
                if !InColumns(neighbourX, neighbourZ) {
                    continue;
                }
                isDiagonal: bool = offsetsX[offset] != 0 && offsetsZ[offset] != 0;
                neighbour~ i32 = columnHeads[ColumnIndex(neighbourX, neighbourZ)];
                while neighbour != NO_NODE {
                    if CanWalkBetween(collisionWorld, position, nodePositions[usize(neighbour)]) {
                        distance~ f32 = (nodePositions[usize(neighbour)] - position).length();
                        if nodeIsTight[usize(node)] || nodeIsTight[usize(neighbour)] {
                            distance = distance * TIGHT_COST_FACTOR;
                        }
                        AddLink(node, neighbour, LINK_WALK, distance);
                        AddLink(neighbour, node, LINK_WALK, distance);
                        if !isDiagonal {
                            nodeWalkLinks[usize(node)] += 1;
                            nodeWalkLinks[usize(neighbour)] += 1;
                        }
                    }
                    neighbour = nodeNextInColumn[usize(neighbour)];
                }
            }
        }

        /**
         * Walking from `from` to the neighbouring `to` works when the height change is a step, or is a slope the ground
         * really follows, and the body fits along the way.
         */
        CanWalkBetween :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3
        ) -> bool {
            rise: f32 = Math:::abs(to.y - from.y);
            flat: Vec3 = Vec3 { x: to.x - from.x, y: 0.0f, z: to.z - from.z };
            run: f32 = flat.length();
            if rise > agent.stepHeight + 0.02f {
                if rise > run * agent.MaxSlopeRise() * 1.05f + 0.02f {
                    return false;
                }
                if !GroundFollows(collisionWorld, from, to) {
                    return false;
                }
            }
            return IsSweepClear(collisionWorld, from, to, agent.ClearanceCapsule());
        }

        /**
         * The ground half way between two points is about as high as the line between them.
         */
        GroundFollows :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3
        ) -> bool {
            middle: Vec3 = (from + to) * 0.5f;
            origin: Vec3 = Vec3 { x: middle.x, y: Math:::max(from.y, to.y) + 0.4f, z: middle.z };
            hit: lantern:::physics:::RayHit? = collisionWorld->StaticRaycast(
                origin,
                Vec3 { x: 0.0f, y: -1.0f, z: 0.0f },
                Math:::abs(to.y - from.y) + 1.0f
            );
            if found := hit {
                return Math:::abs(found.point.y - middle.y) < 0.15f;
            }
            return false;
        }

        /**
         * From a node at an edge, looks in each of eight directions for the first ground that can't be walked to and can be
         * reached by dropping or jumping, and links it one way.
         */
        LinkEdgeNode~: (collisionWorld: lantern:::physics:::CollisionWorld*, node: i32) -> void {
            position: Vec3 = nodePositions[usize(node)];
            columnX: i32 = i32(Math:::floor((position.x - originX) / agent.cellSize));
            columnZ: i32 = i32(Math:::floor((position.z - originZ) / agent.cellSize));
            directionsX: i32[8] = [1, -1, 0, 0, 1, 1, -1, -1];
            directionsZ: i32[8] = [0, 0, 1, -1, 1, -1, 1, -1];
            reachCells: i32 = i32(Math:::ceil(agent.maxJumpAcross / agent.cellSize));
            for direction~ usize = 0; direction < 8; direction++ {
                stepLength: f32 = Math:::sqrt(f32(directionsX[direction] * directionsX[direction] +
                    directionsZ[direction] * directionsZ[direction])) * agent.cellSize;
                linked~ bool = false;
                walkable~ bool = false;
                for cells~ i32 = 1; cells <= reachCells && !linked && !walkable; cells++ {
                    targetX: i32 = columnX + directionsX[direction] * cells;
                    targetZ: i32 = columnZ + directionsZ[direction] * cells;
                    if !InColumns(targetX, targetZ) {
                        break;
                    }
                    run: f32 = stepLength * f32(cells);
                    candidate~ i32 = columnHeads[ColumnIndex(targetX, targetZ)];
                    while candidate != NO_NODE && !linked {
                        if edgeTargetFeature != ANY_FEATURE && nodeFeature[usize(candidate)] != edgeTargetFeature {
                            candidate = nodeNextInColumn[usize(candidate)];
                            continue;
                        }
                        target: Vec3 = nodePositions[usize(candidate)];
                        rise: f32 = target.y - position.y;
                        if cells == 1 && Math:::abs(rise) <= agent.stepHeight + 0.02f {
                            walkable = true;
                        } else if TryEdgeLink(
                            collisionWorld,
                            node,
                            candidate,
                            position,
                            target,
                            rise,
                            run
                        ) {
                            linked = true;
                        }
                        candidate = nodeNextInColumn[usize(candidate)];
                    }
                }
            }
        }

        /**
         * Adds a drop or jump link from `node` to `candidate` if the move fits the agent and the way is clear.
         */
        TryEdgeLink~: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            node: i32,
            candidate: i32,
            position: Vec3,
            target: Vec3,
            rise: f32,
            run: f32
        ) -> bool {
            if rise < -agent.stepHeight && rise >= -agent.maxDrop && run <= DROP_REACH {
                if IsDropClear(collisionWorld, position, target) {
                    AddLink(
                        node,
                        candidate,
                        LINK_DROP,
                        run + DROP_COST_PENALTY + Math:::abs(rise) * 0.5f
                    );
                    return true;
                }
                return false;
            }
            if rise > agent.maxJumpUp || rise < -agent.maxDrop {
                return false;
            }
            if rise > agent.stepHeight && run > LEDGE_JUMP_REACH {
                return false;
            }
            if IsJumpClear(collisionWorld, position, target) {
                AddLink(node, candidate, LINK_JUMP, run + JUMP_COST_PENALTY + Math:::abs(rise));
                return true;
            }
            return false;
        }

        /**
         * A drop: sideways off the edge at the starting height, then straight down.
         */
        IsDropClear :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3
        ) -> bool {
            above: Vec3 = Vec3 { x: to.x, y: from.y, z: to.z };
            return IsSweepClear(
                collisionWorld,
                from,
                above,
                agent.ClearanceCapsule()
            ) && IsSweepClear(collisionWorld, above, to, agent.ClearanceCapsule());
        }

        /**
         * A jump: up to the higher of the two heights, across, then down to the landing.
         */
        IsJumpClear :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3
        ) -> bool {
            topHeight: f32 = Math:::max(from.y, to.y);
            leaving: Vec3 = Vec3 { x: from.x, y: topHeight, z: from.z };
            arriving: Vec3 = Vec3 { x: to.x, y: topHeight, z: to.z };
            capsule: lantern:::physics:::Capsule = agent.ClearanceCapsule();
            return IsSweepClear(
                collisionWorld,
                from,
                leaving,
                capsule
            ) && IsSweepClear(
                collisionWorld,
                leaving,
                arriving,
                capsule
            ) && IsSweepClear(collisionWorld, arriving, to, capsule);
        }

        AddLink~: (from: i32, to: i32, kind: i32, cost: f32) -> void {
            link: i32 = i32(linkTarget.length());
            linkTarget.push(to);
            linkKind.push(kind);
            linkCost.push(cost);
            linkNext.push(nodeFirstLink[usize(from)]);
            linkFeature.push(NO_FEATURE);
            nodeFirstLink[usize(from)] = link;
        }

        /**
         * Replaces runs of walk points by the longest straight lines the body can walk, starting from point `first`, and puts
         * the result in `path`. A drop or jump point stays, with the point before it, so the game knows where to leave
         * from.
         */
        Smooth :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            points: Array<Vec3>,
            kinds: Array<i32>,
            features: Array<i32>,
            first: usize,
            path: NavigationPath~*
        ) -> void {
            count: usize = points.length();
            if first >= count {
                return;
            }
            index~ usize = first;
            path->points.push(points[index]);
            path->kinds.push(LINK_WALK);
            path->features.push(features[index]);
            while index + 1 < count {
                best~ usize = index + 1;
                limit~ usize = index + usize(SMOOTH_LOOKAHEAD_POINTS);
                if limit > count - 1 {
                    limit = count - 1;
                }
                for candidate~ usize = index + 2; candidate <= limit; candidate++ {
                    if features[best] != NO_FEATURE || features[candidate] != NO_FEATURE {
                        break;
                    }
                    if kinds[candidate] != LINK_WALK || kinds[candidate - 1] != LINK_WALK &&
                        candidate - 1 > index {
                        break;
                    }
                    if kinds[index + 1] != LINK_WALK {
                        break;
                    }
                    if !IsStraightWalkable(collisionWorld, points[index], points[candidate]) {
                        break;
                    }
                    best = candidate;
                }
                path->points.push(points[best]);
                path->kinds.push(kinds[best]);
                path->features.push(features[best]);
                index = best;
            }
        }

        /**
         * A straight walk from `from` to `to`: the body fits all the way and the ground never changes by more than a step
         * between samples.
         */
        IsStraightWalkable :: (
            collisionWorld: lantern:::physics:::CollisionWorld*,
            from: Vec3,
            to: Vec3
        ) -> bool {
            if !IsSweepClear(collisionWorld, from, to, agent.BodyCapsule()) {
                return false;
            }
            span: Vec3 = to - from;
            flat: f32 = Math:::sqrt(span.x * span.x + span.z * span.z);
            samples: i32 = i32(Math:::ceil(flat / STRAIGHT_SAMPLE_SPACING));
            previousHeight~ f32 = from.y;
            for sample~ i32 = 1; sample <= samples; sample++ {
                fraction: f32 = f32(sample) / f32(samples);
                point: Vec3 = from + span * fraction;
                origin: Vec3 = Vec3 {
                    x: point.x,
                    y: Math:::max(previousHeight, point.y) + agent.stepHeight + 0.2f,
                    z: point.z
                };
                hit: lantern:::physics:::RayHit? = collisionWorld->StaticRaycast(
                    origin,
                    Vec3 { x: 0.0f, y: -1.0f, z: 0.0f },
                    agent.stepHeight * 2.0f + 0.6f
                );
                found := hit;
                if found == null {
                    return false;
                }
                if hitPoint := found {
                    if Math:::abs(hitPoint.point.y - previousHeight) > agent.stepHeight + 0.03f {
                        return false;
                    }
                    previousHeight = hitPoint.point.y;
                }
            }
            return true;
        }

        /**
         * Sorts the heights from highest to lowest.
         */
        SortDescending :: (values: Array<f32~>) -> void {
            for index~ usize = 1; index < values.length(); index++ {
                held: f32 = values[index];
                slot~ usize = index;
                while slot > 0 && values[slot - 1] < held {
                    values[slot] = values[slot - 1];
                    slot -= 1;
                }
                values[slot] = held;
            }
        }
    }
}
