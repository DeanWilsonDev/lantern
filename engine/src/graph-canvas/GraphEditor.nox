// The graph tab's canvas: one graph open for editing, drawn as pixels (the interface shows them in a viewport) and moved by the
// pointer. It owns the graph, which function is open, the pan and zoom, what is selected and what is being dragged.
lantern:::graphs :: namespace {
    DRAG_NONE: i32 : 0;
    DRAG_NODE: i32 : 1;
    DRAG_PAN: i32 : 2;
    DRAG_WIRE: i32 : 3;
    GRID_STEP: i32 : 20;
    ZOOM_ONE: i32 : 100;
    MIN_ZOOM: i32 : 35;
    MAX_ZOOM: i32 : 400;
    MIN_TEXT_ZOOM: i32 : 70;

    COLOR_BACKGROUND: u32 : 1710878;
    COLOR_GRID: u32 : 2237223;
    COLOR_NODE: u32 : 2566188;
    COLOR_NODE_EDGE: u32 : 1118740;
    COLOR_GRID_MAJOR: u32 : 2763825;
    COLOR_SHADOW: u32 : 723725;
    COLOR_FAILED: u32 : 15026253;
    COLOR_SELECTED: u32 : 16765514;
    COLOR_TEXT: u32 : 15527666;
    COLOR_DIM_TEXT: u32 : 10725555;
    COLOR_EXECUTION: u32 : 15921906;
    COLOR_VALUE: u32 : 7327999;

    HeaderColor :: (kind: string) -> u32 {
        if kind == "entry" {
            return 9058874;
        }
        if kind == "return" || kind == "set" {
            return 3104138;
        }
        if kind == "branch" || kind == "while" || kind == "when" || kind == "call" {
            return 9067055;
        }
        if kind == "nyx" || kind == "nyx_value" {
            return 6965898;
        }
        return 3963474;
    }

    // The picture the canvas is drawn into: RGBA bytes, with the zoom the drawing is done at.
    PixelCanvas :: class {
    public:
        width~ u32 = 0;
        height~ u32 = 0;
        zoom~ i32 = 200;
        pixels~ Array<u8>! = [];
        fontMetrics~ Array<i32>! = [];
        fontSizeIndex~ i32 = -1;

        PixelCanvas~: () { }

        !PixelCanvas~: () {
            delete pixels;
            delete fontMetrics;
        }

        // Scales a length in graph units to pixels at the current zoom.
        Scaled :: (value: i32) -> i32 {
            return value * zoom / ZOOM_ONE;
        }

        // Which baked Actor size draws text at this zoom: seven pixels per graph unit of zoom, between the smallest and largest baked.
        FontSizeIndex :: () -> i32 {
            wanted~ i32 = (7 * zoom + 50) / ZOOM_ONE;
            if wanted < GRAPH_FONT_FIRST_SIZE {
                wanted = GRAPH_FONT_FIRST_SIZE;
            }
            if wanted > GRAPH_FONT_FIRST_SIZE + GRAPH_FONT_SIZES - 1 {
                wanted = GRAPH_FONT_FIRST_SIZE + GRAPH_FONT_SIZES - 1;
            }
            return wanted - GRAPH_FONT_FIRST_SIZE;
        }

        // Reads the glyph table for the current zoom, once per zoom change.
        LoadFont~: () -> void {
            wanted: i32 = this->FontSizeIndex();
            if wanted == fontSizeIndex {
                return;
            }
            delete fontMetrics;
            fontMetrics = GraphFontMetrics(wanted);
            fontSizeIndex = wanted;
        }

        Clear~: (color: u32) -> void {
            byteCount: usize = usize(width) * usize(height) * 4;
            while pixels.length() > byteCount {
                pixels.pop();
            }
            while pixels.length() < byteCount {
                pixels.push(0);
            }
            red: u8 = u8((color >> 16) & 255);
            green: u8 = u8((color >> 8) & 255);
            blue: u8 = u8(color & 255);
            for index~ usize = 0; index < byteCount; index += 4 {
                pixels[index] = red;
                pixels[index + 1] = green;
                pixels[index + 2] = blue;
                pixels[index + 3] = 255;
            }
        }

        Dot~: (x: i32, y: i32, color: u32) -> void {
            if x < 0 || y < 0 || x >= i32(width) || y >= i32(height) {
                return;
            }
            index: usize = (usize(y) * usize(width) + usize(x)) * 4;
            pixels[index] = u8((color >> 16) & 255);
            pixels[index + 1] = u8((color >> 8) & 255);
            pixels[index + 2] = u8(color & 255);
        }

        Rectangle~: (x: i32, y: i32, rectangleWidth: i32, rectangleHeight: i32, color: u32) -> void {
            left: i32 = x < 0 ? 0 : x;
            top: i32 = y < 0 ? 0 : y;
            right: i32 = x + rectangleWidth > i32(width) ? i32(width) : x + rectangleWidth;
            bottom: i32 = y + rectangleHeight > i32(height) ? i32(height) : y + rectangleHeight;
            for row~ i32 = top; row < bottom; row++ {
                for column~ i32 = left; column < right; column++ {
                    this->Dot(column, row, color);
                }
            }
        }

        Outline~: (x: i32, y: i32, rectangleWidth: i32, rectangleHeight: i32, thickness: i32, color: u32) -> void {
            this->Rectangle(x, y, rectangleWidth, thickness, color);
            this->Rectangle(x, y + rectangleHeight - thickness, rectangleWidth, thickness, color);
            this->Rectangle(x, y, thickness, rectangleHeight, color);
            this->Rectangle(x + rectangleWidth - thickness, y, thickness, rectangleHeight, color);
        }

        Line~: (fromX: i32, fromY: i32, toX: i32, toY: i32, thickness: i32, color: u32) -> void {
            deltaX: i32 = toX > fromX ? toX - fromX : fromX - toX;
            deltaY: i32 = toY > fromY ? toY - fromY : fromY - toY;
            steps~ i32 = deltaX > deltaY ? deltaX : deltaY;
            if steps == 0 {
                steps = 1;
            }
            for step~ i32 = 0; step <= steps; step++ {
                pointX: i32 = fromX + (toX - fromX) * step / steps;
                pointY: i32 = fromY + (toY - fromY) * step / steps;
                this->Rectangle(pointX - thickness / 2, pointY - thickness / 2, thickness, thickness, color);
            }
        }

        // Mixes a colour into a pixel; coverage is 0 (nothing) to 255 (all of it).
        Blend~: (x: i32, y: i32, color: u32, coverage: i32) -> void {
            if coverage <= 0 || x < 0 || y < 0 || x >= i32(width) || y >= i32(height) {
                return;
            }
            if coverage >= 255 {
                this->Dot(x, y, color);
                return;
            }
            index: usize = (usize(y) * usize(width) + usize(x)) * 4;
            red: i32 = i32((color >> 16) & 255);
            green: i32 = i32((color >> 8) & 255);
            blue: i32 = i32(color & 255);
            oldRed: i32 = i32(pixels[index]);
            oldGreen: i32 = i32(pixels[index + 1]);
            oldBlue: i32 = i32(pixels[index + 2]);
            pixels[index] = u8(oldRed + (red - oldRed) * coverage / 255);
            pixels[index + 1] = u8(oldGreen + (green - oldGreen) * coverage / 255);
            pixels[index + 2] = u8(oldBlue + (blue - oldBlue) * coverage / 255);
        }

        // A colour between two others, `step` of `steps` of the way from the first.
        Mixed :: (first: u32, second: u32, step: i32, steps: i32) -> u32 {
            if steps <= 0 {
                return first;
            }
            red: i32 = i32((first >> 16) & 255) + (i32((second >> 16) & 255) - i32((first >> 16) & 255)) * step / steps;
            green: i32 = i32((first >> 8) & 255) + (i32((second >> 8) & 255) - i32((first >> 8) & 255)) * step / steps;
            blue: i32 = i32(first & 255) + (i32(second & 255) - i32(first & 255)) * step / steps;
            return u32(red) * 65536 + u32(green) * 256 + u32(blue);
        }

        // How much of a pixel a corner of the given radius covers: 1 inside, 0 outside, between on the edge.
        CornerCoverage :: (pixelX: i32, pixelY: i32, centreX: f32, centreY: f32, radius: f32) -> i32 {
            deltaX: f32 = f32(pixelX) + 0.5f - centreX;
            deltaY: f32 = f32(pixelY) + 0.5f - centreY;
            distance: f32 = Math:::sqrt(deltaX * deltaX + deltaY * deltaY);
            amount: f32 = radius - distance + 0.5f;
            if amount <= 0.0f {
                return 0;
            }
            if amount >= 1.0f {
                return 255;
            }
            return i32(amount * 255.0f);
        }

        // A rectangle with rounded top corners (and bottom ones when `roundBottom`), shaded from `topColor` to `bottomColor`.
        FillRounded~: (x: i32, y: i32, rectangleWidth: i32, rectangleHeight: i32, radius: i32, roundBottom: bool, topColor: u32, bottomColor: u32) -> void {
            for row~ i32 = 0; row < rectangleHeight; row++ {
                screenY: i32 = y + row;
                if screenY < 0 || screenY >= i32(height) {
                    continue;
                }
                color: u32 = this->Mixed(topColor, bottomColor, row, rectangleHeight - 1);
                inTop: bool = row < radius;
                inBottom: bool = roundBottom && row >= rectangleHeight - radius;
                for column~ i32 = 0; column < rectangleWidth; column++ {
                    screenX: i32 = x + column;
                    if screenX < 0 || screenX >= i32(width) {
                        continue;
                    }
                    inLeft: bool = column < radius;
                    inRight: bool = column >= rectangleWidth - radius;
                    if (inTop || inBottom) && (inLeft || inRight) {
                        centreX: f32 = inLeft ? f32(x + radius) : f32(x + rectangleWidth - radius);
                        centreY: f32 = inTop ? f32(y + radius) : f32(y + rectangleHeight - radius);
                        this->Blend(screenX, screenY, color, this->CornerCoverage(screenX, screenY, centreX, centreY, f32(radius)));
                    } else {
                        this->Dot(screenX, screenY, color);
                    }
                }
            }
        }

        // A filled circle with a soft edge.
        Disc~: (centreX: f32, centreY: f32, radius: f32, color: u32) -> void {
            left: i32 = i32(centreX - radius) - 1;
            top: i32 = i32(centreY - radius) - 1;
            size: i32 = i32(radius * 2.0f) + 3;
            for row~ i32 = top; row <= top + size; row++ {
                for column~ i32 = left; column <= left + size; column++ {
                    this->Blend(column, row, color, this->CornerCoverage(column, row, centreX, centreY, radius));
                }
            }
        }

        // A circle's outline: `thickness` wide, soft on both edges.
        Ring~: (centreX: f32, centreY: f32, radius: f32, thickness: f32, color: u32) -> void {
            left: i32 = i32(centreX - radius) - 2;
            top: i32 = i32(centreY - radius) - 2;
            size: i32 = i32(radius * 2.0f) + 5;
            for row~ i32 = top; row <= top + size; row++ {
                for column~ i32 = left; column <= left + size; column++ {
                    outer: i32 = this->CornerCoverage(column, row, centreX, centreY, radius);
                    inner: i32 = this->CornerCoverage(column, row, centreX, centreY, radius - thickness);
                    this->Blend(column, row, color, outer - inner);
                }
            }
        }

        // A right-pointing triangle (the execution pin), softened by sampling each pixel three times across.
        Arrow~: (centreX: f32, centreY: f32, halfHeight: f32, color: u32) -> void {
            left: i32 = i32(centreX - halfHeight) - 1;
            top: i32 = i32(centreY - halfHeight) - 1;
            size: i32 = i32(halfHeight * 2.0f) + 3;
            for row~ i32 = top; row <= top + size; row++ {
                for column~ i32 = left; column <= left + size; column++ {
                    inside~ i32 = 0;
                    for sampleY~ i32 = 0; sampleY < 3; sampleY++ {
                        for sampleX~ i32 = 0; sampleX < 3; sampleX++ {
                            pointX: f32 = f32(column) + (f32(sampleX) + 0.5f) / 3.0f - (centreX - halfHeight * 0.7f);
                            pointY: f32 = f32(row) + (f32(sampleY) + 0.5f) / 3.0f - centreY;
                            absolute: f32 = pointY < 0.0f ? -pointY : pointY;
                            if pointX >= 0.0f && pointX <= halfHeight * 1.5f && absolute <= halfHeight - pointX * halfHeight / (halfHeight * 1.5f) {
                                inside += 1;
                            }
                        }
                    }
                    this->Blend(column, row, color, inside * 255 / 9);
                }
            }
        }

        // Adds a soft-edged line to the coverage a wire is collecting, keeping the larger coverage where lines overlap so joints
        // between segments show no seams. The buffer's top left is (bufferLeft, bufferTop) and it is `bufferWidth` pixels wide.
        StrokeSegment~: (coverage: Array<u8~>, bufferLeft: i32, bufferTop: i32, bufferWidth: i32, bufferHeight: i32, fromX: f32, fromY: f32, toX: f32, toY: f32, thickness: f32) -> void {
            half: f32 = thickness / 2.0f;
            left: i32 = i32((fromX < toX ? fromX : toX) - half) - 1;
            right: i32 = i32((fromX > toX ? fromX : toX) + half) + 2;
            top: i32 = i32((fromY < toY ? fromY : toY) - half) - 1;
            bottom: i32 = i32((fromY > toY ? fromY : toY) + half) + 2;
            deltaX: f32 = toX - fromX;
            deltaY: f32 = toY - fromY;
            lengthSquared: f32 = deltaX * deltaX + deltaY * deltaY;
            for row~ i32 = top; row <= bottom; row++ {
                for column~ i32 = left; column <= right; column++ {
                    localX: i32 = column - bufferLeft;
                    localY: i32 = row - bufferTop;
                    if localX < 0 || localY < 0 || localX >= bufferWidth || localY >= bufferHeight {
                        continue;
                    }
                    offsetX: f32 = f32(column) + 0.5f - fromX;
                    offsetY: f32 = f32(row) + 0.5f - fromY;
                    along~ f32 = 0.0f;
                    if lengthSquared > 0.0f {
                        along = (offsetX * deltaX + offsetY * deltaY) / lengthSquared;
                    }
                    if along < 0.0f {
                        along = 0.0f;
                    }
                    if along > 1.0f {
                        along = 1.0f;
                    }
                    nearX: f32 = offsetX - along * deltaX;
                    nearY: f32 = offsetY - along * deltaY;
                    distance: f32 = Math:::sqrt(nearX * nearX + nearY * nearY);
                    amount: f32 = half - distance + 0.5f;
                    if amount > 0.0f {
                        level: u8 = amount >= 1.0f ? 255 : u8(amount * 255.0f);
                        slot: usize = usize(localY * bufferWidth + localX);
                        if level > coverage[slot] {
                            coverage[slot] = level;
                        }
                    }
                }
            }
        }

        // A wire: an S curve that leaves the start to the right and enters the end from the left.
        Wire~: (fromX: i32, fromY: i32, toX: i32, toY: i32, color: u32) -> void {
            reach~ i32 = (toX - fromX) / 2;
            if reach < this->Scaled(40) {
                reach = this->Scaled(40);
            }
            thickness: f32 = 0.5f + f32(zoom) * 0.9f / 100.0f;
            margin: i32 = i32(thickness) + 3;
            curveLeft: i32 = (fromX < toX ? fromX : toX) - reach - margin;
            curveRight: i32 = (fromX > toX ? fromX : toX) + reach + margin;
            curveTop: i32 = (fromY < toY ? fromY : toY) - margin;
            curveBottom: i32 = (fromY > toY ? fromY : toY) + margin;
            left: i32 = curveLeft < 0 ? 0 : curveLeft;
            top: i32 = curveTop < 0 ? 0 : curveTop;
            right: i32 = curveRight > i32(width) ? i32(width) : curveRight;
            bottom: i32 = curveBottom > i32(height) ? i32(height) : curveBottom;
            if right <= left || bottom <= top {
                return;
            }
            bufferWidth: i32 = right - left;
            bufferHeight: i32 = bottom - top;
            coverage~ Array<u8>! = [];
            for slot~ i32 = 0; slot < bufferWidth * bufferHeight; slot++ {
                coverage.push(0);
            }
            spanX: i32 = toX > fromX ? toX - fromX : fromX - toX;
            spanY: i32 = toY > fromY ? toY - fromY : fromY - toY;
            segments: i32 = (spanX + spanY) / (this->Scaled(4) + 1) + 12;
            previousX~ f32 = f32(fromX);
            previousY~ f32 = f32(fromY);
            for step~ i32 = 1; step <= segments; step++ {
                t: f32 = f32(step) / f32(segments);
                u: f32 = 1.0f - t;
                controlOneX: f32 = f32(fromX + reach);
                controlTwoX: f32 = f32(toX - reach);
                curveX: f32 = u * u * u * f32(fromX) + 3.0f * u * u * t * controlOneX + 3.0f * u * t * t * controlTwoX + t * t * t * f32(toX);
                curveY: f32 = u * u * u * f32(fromY) + 3.0f * u * u * t * f32(fromY) + 3.0f * u * t * t * f32(toY) + t * t * t * f32(toY);
                this->StrokeSegment(coverage, left, top, bufferWidth, bufferHeight, previousX, previousY, curveX, curveY, thickness);
                previousX = curveX;
                previousY = curveY;
            }
            for row~ i32 = 0; row < bufferHeight; row++ {
                for column~ i32 = 0; column < bufferWidth; column++ {
                    level: i32 = i32(coverage[usize(row * bufferWidth + column)]);
                    if level > 0 {
                        this->Blend(left + column, top + row, color, level);
                    }
                }
            }
            delete coverage;
        }

        // The font's ascent at this zoom, used to centre text on a line.
        fontAscent :: () -> i32 {
            return GraphFontAscent(this->FontSizeIndex());
        }

        // The width of a line of text, in pixels.
        TextWidth :: (text: string) -> i32 {
            metrics: Array<i32> = fontMetrics;
            total~ i32 = 0;
            for position~ usize = 0; position < text.length(); position++ {
                byte: u8 = text.byteAt(position);
                cell: usize = (byte >= 32 && byte <= 126) ? usize(byte - 32) : 31;
                total += metrics[cell * GRAPH_FONT_FIELDS];
            }
            return total / 16;
        }

        // Text in Actor, drawn with its baseline at `baselineY`, left edge at `x`, cut off at `maxWidth`.
        Text~: (x: i32, baselineY: i32, text: string, color: u32, maxWidth: i32) -> void {
            this->LoadFont();
            metrics: Array<i32> = fontMetrics;
            coverage: string = GraphFontCoverage(this->FontSizeIndex());
            cursor~ i32 = x * 16;
            for position~ usize = 0; position < text.length(); position++ {
                byte: u8 = text.byteAt(position);
                cell: usize = (byte >= 32 && byte <= 126) ? usize(byte - 32) : 31;
                base: usize = cell * GRAPH_FONT_FIELDS;
                advance: i32 = metrics[base];
                glyphWidth: i32 = metrics[base + 1];
                glyphHeight: i32 = metrics[base + 2];
                glyphLeft: i32 = metrics[base + 3];
                glyphTop: i32 = metrics[base + 4];
                start: usize = usize(metrics[base + 5]);
                if (cursor + advance) / 16 > x + maxWidth {
                    break;
                }
                for row~ i32 = 0; row < glyphHeight; row++ {
                    for column~ i32 = 0; column < glyphWidth; column++ {
                        digit: u8 = coverage.byteAt(start + usize(row * glyphWidth + column));
                        level: i32 = digit >= 97 ? i32(digit) - 87 : i32(digit) - 48;
                        if level > 0 {
                            this->Blend(cursor / 16 + glyphLeft + column, baselineY + glyphTop + row, color, level * 17);
                        }
                    }
                }
                cursor += advance;
            }
        }
    }

    GraphEditor :: class {
    public:
        name~ string!;
        graph~ Graph*!;
        functionIndex~ usize = 0;
        selected~ string!;
        panX~ i32 = 20;
        panY~ i32 = 20;
        zoom~ i32 = 200;
        pointerX~ i32 = 0;
        pointerY~ i32 = 0;
        dragMode~ i32 = 0;
        dragNode~ string!;
        dragOffsetX~ i32 = 0;
        dragOffsetY~ i32 = 0;
        nodeMoved~ bool = false;
        wireNode~ string!;
        wirePort~ string!;
        wireIsExecution~ bool = false;
        isDirty~ bool = false;
        status~ string!;
        generation~ u32 = 0;
        fitPending~ bool = true;
        menuRequest~ u32 = 0;
        menuWorldX~ i32 = 0;
        menuWorldY~ i32 = 0;
        menuSourceNode~ string!;
        menuSourcePort~ string!;
        menuSourceIsExecution~ bool = false;
        failedNode~ string!;

        GraphEditor~: (newName: string, newGraph: Graph*!) {
            name = `${newName}`;
            graph = newGraph!;
            selected = "".copy();
            dragNode = "".copy();
            wireNode = "".copy();
            wirePort = "".copy();
            status = "".copy();
            menuSourceNode = "".copy();
            menuSourcePort = "".copy();
            failedNode = "".copy();
        }

        !GraphEditor~: () {
            delete name;
            delete graph;
            delete selected;
            delete dragNode;
            delete wireNode;
            delete wirePort;
            delete status;
            delete menuSourceNode;
            delete menuSourcePort;
            delete failedNode;
        }

        Function :: () -> GraphFunction* {
            return graph->functions[functionIndex];
        }

        SetStatus~: (text: string) -> void {
            delete status;
            status = `${text}`;
        }

        Touch~: () -> void {
            isDirty = true;
            generation += 1;
        }

        // A length in graph units, in pixels at the current zoom.
        Scaled :: (value: i32) -> i32 {
            return value * zoom / ZOOM_ONE;
        }

        // World coordinates to screen, and back.
        ScreenX :: (worldX: i32) -> i32 {
            return (worldX + panX) * zoom / ZOOM_ONE;
        }

        ScreenY :: (worldY: i32) -> i32 {
            return (worldY + panY) * zoom / ZOOM_ONE;
        }

        WorldX :: (screenX: i32) -> i32 {
            return screenX * ZOOM_ONE / zoom - panX;
        }

        WorldY :: (screenY: i32) -> i32 {
            return screenY * ZOOM_ONE / zoom - panY;
        }
    }
}
