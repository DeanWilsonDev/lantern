// What the pointer and keys do on the canvas: select and drag a node, drag a wire from a pin to another, pan the background,
// zoom with the wheel, clear a link with a right click, and delete the selected node.
lantern:::graphs :: namespace {
    HIT_NOTHING: i32 : 0;
    HIT_NODE: i32 : 1;
    HIT_PIN: i32 : 2;

    BUTTON_LEFT: u32 : 0;
    BUTTON_RIGHT: u32 : 2;

    // What is under a screen point: a pin of a node, a node, or nothing.
    Hit :: class {
    public:
        kind~ i32 = 0;
        nodeId~ string!;
        port~ string!;
        isExecution~ bool = false;
        isOutput~ bool = false;

        Hit~: () {
            nodeId = "".copy();
            port = "".copy();
        }

        !Hit~: () {
            delete nodeId;
            delete port;
        }
    }

    HitAt :: (graphEditor: GraphEditor*, screenX: i32, screenY: i32) -> Hit*! {
        hit := new Hit();
        if graphEditor->graph->functions.length() == 0 {
            return hit!;
        }
        function: GraphFunction* = graphEditor->Function();
        radius: i32 = graphEditor->Scaled(PIN_HIT_RADIUS);
        index~ usize = function->nodes.length();
        while index > 0 && hit->kind == HIT_NOTHING {
            index -= 1;
            node: GraphNode* = function->nodes[index];
            pins := PinsOf(function, node);
            for pinIndex~ usize = 0; pinIndex < pins->items.length(); pinIndex++ {
                pin: PinSlot* = pins->items[pinIndex];
                deltaX: i32 = screenX - PinScreenX(graphEditor, node, pin);
                deltaY: i32 = screenY - PinScreenY(graphEditor, node, pin);
                if deltaX >= -radius && deltaX <= radius && deltaY >= -radius && deltaY <= radius && hit->kind == HIT_NOTHING {
                    hit->kind = HIT_PIN;
                    delete hit->nodeId;
                    hit->nodeId = `${node->id}`;
                    delete hit->port;
                    hit->port = `${pin->port}`;
                    hit->isExecution = pin->isExecution;
                    hit->isOutput = pin->isOutput;
                }
            }
            if hit->kind == HIT_NOTHING {
                left: i32 = graphEditor->ScreenX(i32(node->x));
                top: i32 = graphEditor->ScreenY(i32(node->y));
                if screenX >= left && screenX < left + graphEditor->Scaled(NODE_WIDTH) && screenY >= top && screenY < top + graphEditor->Scaled(NodeHeight(pins)) {
                    hit->kind = HIT_NODE;
                    delete hit->nodeId;
                    hit->nodeId = `${node->id}`;
                }
            }
            delete pins;
        }
        return hit!;
    }

    // Snaps a coordinate to the grid.
    Snapped :: (value: i32) -> i32 {
        half: i32 = GRID_STEP / 2;
        if value >= 0 {
            return (value + half) / GRID_STEP * GRID_STEP;
        }
        return -((-value + half) / GRID_STEP * GRID_STEP);
    }

    // Asks the interface to open its add-node menu where the pointer is. With a source node the menu offers what can take
    // that pin, and a node added from it is wired to it.
    RequestMenu :: (graphEditor: GraphEditor~*, sourceNode: string, sourcePort: string, sourceIsExecution: bool) -> void {
        graphEditor->menuWorldX = graphEditor->WorldX(graphEditor->pointerX);
        graphEditor->menuWorldY = graphEditor->WorldY(graphEditor->pointerY);
        delete graphEditor->menuSourceNode;
        graphEditor->menuSourceNode = `${sourceNode}`;
        delete graphEditor->menuSourcePort;
        graphEditor->menuSourcePort = `${sourcePort}`;
        graphEditor->menuSourceIsExecution = sourceIsExecution;
        graphEditor->menuRequest += 1;
    }

    // Joins the wire being dragged to what it was let go over.
    FinishWire :: (graphEditor: GraphEditor~*, target: Hit*) -> void {
        if graphEditor->graph->functions.length() == 0 {
            return;
        }
        function: GraphFunction~* = graphEditor->graph->functions[graphEditor->functionIndex];
        problem~ string!? = null;
        madeWire~ bool = false;
        if target->kind == HIT_PIN && target->nodeId != graphEditor->wireNode {
            if graphEditor->wireIsExecution && !target->isOutput && target->isExecution {
                problem = SetPort(function, graphEditor->wireNode, graphEditor->wirePort, target->nodeId);
                madeWire = true;
            } else if !graphEditor->wireIsExecution && !target->isOutput && !target->isExecution {
                problem = SetPort(function, target->nodeId, target->port, graphEditor->wireNode);
                madeWire = true;
            }
        } else if target->kind == HIT_NODE && target->nodeId != graphEditor->wireNode && graphEditor->wireIsExecution {
            problem = SetPort(function, graphEditor->wireNode, graphEditor->wirePort, target->nodeId);
            madeWire = true;
        }
        if message := problem {
            graphEditor->SetStatus(message);
        } else if madeWire {
            graphEditor->Touch();
            graphEditor->SetStatus("Connected.");
        }
        delete problem;
    }

    PointerPressed :: (graphEditor: GraphEditor~*, button: u32) -> void {
        hit := HitAt(graphEditor, graphEditor->pointerX, graphEditor->pointerY);
        if graphEditor->graph->functions.length() == 0 {
            delete hit;
            return;
        }
        function: GraphFunction~* = graphEditor->graph->functions[graphEditor->functionIndex];
        if button == BUTTON_RIGHT {
            if hit->kind == HIT_PIN {
                problem~ string!? = null;
                if !hit->isOutput && !hit->isExecution || hit->isOutput && hit->isExecution {
                    problem = SetPort(function, hit->nodeId, hit->port, "");
                    graphEditor->Touch();
                    graphEditor->SetStatus("Disconnected.");
                } else if !hit->isOutput && hit->isExecution {
                    for index~ usize = 0; index < function->nodes.length(); index++ {
                        if function->nodes[index]->next == hit->nodeId {
                            function->nodes[index]->ClearLinksTo(hit->nodeId);
                        }
                    }
                    graphEditor->Touch();
                    graphEditor->SetStatus("Disconnected.");
                }
                delete problem;
            } else if hit->kind == HIT_NOTHING {
                RequestMenu(graphEditor, "", "", false);
            }
            delete hit;
            return;
        }
        if button != BUTTON_LEFT {
            delete hit;
            return;
        }
        if hit->kind == HIT_PIN && hit->isOutput {
            graphEditor->dragMode = DRAG_WIRE;
            delete graphEditor->wireNode;
            graphEditor->wireNode = `${hit->nodeId}`;
            delete graphEditor->wirePort;
            graphEditor->wirePort = `${hit->port}`;
            graphEditor->wireIsExecution = hit->isExecution;
            delete graphEditor->selected;
            graphEditor->selected = `${hit->nodeId}`;
            graphEditor->generation += 1;
        } else if hit->kind == HIT_NODE || hit->kind == HIT_PIN {
            delete graphEditor->selected;
            graphEditor->selected = `${hit->nodeId}`;
            graphEditor->generation += 1;
            graphEditor->dragMode = DRAG_NODE;
            graphEditor->nodeMoved = false;
            delete graphEditor->dragNode;
            graphEditor->dragNode = `${hit->nodeId}`;
            grabbed: GraphFunction* = graphEditor->Function();
            if index := grabbed->IndexOfNode(hit->nodeId) {
                graphEditor->dragOffsetX = graphEditor->WorldX(graphEditor->pointerX) - i32(grabbed->nodes[index]->x);
                graphEditor->dragOffsetY = graphEditor->WorldY(graphEditor->pointerY) - i32(grabbed->nodes[index]->y);
            }
        } else {
            delete graphEditor->selected;
            graphEditor->selected = "".copy();
            graphEditor->generation += 1;
            graphEditor->dragMode = DRAG_PAN;
            graphEditor->dragOffsetX = graphEditor->pointerX;
            graphEditor->dragOffsetY = graphEditor->pointerY;
        }
        delete hit;
    }

    PointerReleased :: (graphEditor: GraphEditor~*, button: u32) -> void {
        if button != BUTTON_LEFT {
            return;
        }
        if graphEditor->dragMode == DRAG_WIRE {
            target := HitAt(graphEditor, graphEditor->pointerX, graphEditor->pointerY);
            sourceNode: string! = `${graphEditor->wireNode}`;
            sourcePort: string! = `${graphEditor->wirePort}`;
            sourceIsExecution: bool = graphEditor->wireIsExecution;
            FinishWire(graphEditor, target);
            if target->kind == HIT_NOTHING {
                RequestMenu(graphEditor, sourceNode, sourcePort, sourceIsExecution);
            }
            delete sourceNode;
            delete sourcePort;
            delete target;
        } else if graphEditor->dragMode == DRAG_NODE && graphEditor->nodeMoved && graphEditor->graph->functions.length() > 0 {
            function: GraphFunction~* = graphEditor->graph->functions[graphEditor->functionIndex];
            if index := function->IndexOfNode(graphEditor->dragNode) {
                function->nodes[index]->x = f32(Snapped(i32(function->nodes[index]->x)));
                function->nodes[index]->y = f32(Snapped(i32(function->nodes[index]->y)));
                graphEditor->Touch();
            }
        }
        graphEditor->dragMode = DRAG_NONE;
    }

    PointerMoved :: (graphEditor: GraphEditor~*, screenX: i32, screenY: i32) -> void {
        graphEditor->pointerX = screenX;
        graphEditor->pointerY = screenY;
        if graphEditor->dragMode == DRAG_NODE && graphEditor->graph->functions.length() > 0 {
            function: GraphFunction~* = graphEditor->graph->functions[graphEditor->functionIndex];
            if index := function->IndexOfNode(graphEditor->dragNode) {
                graphEditor->nodeMoved = true;
                function->nodes[index]->x = f32(graphEditor->WorldX(screenX) - graphEditor->dragOffsetX);
                function->nodes[index]->y = f32(graphEditor->WorldY(screenY) - graphEditor->dragOffsetY);
            }
        } else if graphEditor->dragMode == DRAG_PAN {
            graphEditor->panX += (screenX - graphEditor->dragOffsetX) * ZOOM_ONE / graphEditor->zoom;
            graphEditor->panY += (screenY - graphEditor->dragOffsetY) * ZOOM_ONE / graphEditor->zoom;
            graphEditor->dragOffsetX = screenX;
            graphEditor->dragOffsetY = screenY;
        }
    }

    // The wheel zooms by a few percent per notch about the pointer, so a trackpad's small steps give fine control; sideways
    // scrolling pans. The graph point under the pointer stays under it.
    WheelTurned :: (graphEditor: GraphEditor~*, notches: f32, notchesX: f32) -> void {
        if notchesX != 0.0f {
            graphEditor->panX -= i32(notchesX * 30.0f * f32(ZOOM_ONE) / f32(graphEditor->zoom));
            graphEditor->generation += 1;
        }
        if notches == 0.0f {
            return;
        }
        anchorX: i32 = graphEditor->WorldX(graphEditor->pointerX);
        anchorY: i32 = graphEditor->WorldY(graphEditor->pointerY);
        wanted~ i32 = i32(f32(graphEditor->zoom) * (1.0f + 0.12f * notches));
        if wanted == graphEditor->zoom {
            wanted = notches > 0.0f ? graphEditor->zoom + 1 : graphEditor->zoom - 1;
        }
        if wanted < MIN_ZOOM {
            wanted = MIN_ZOOM;
        }
        if wanted > MAX_ZOOM {
            wanted = MAX_ZOOM;
        }
        graphEditor->zoom = wanted;
        graphEditor->panX = graphEditor->pointerX * ZOOM_ONE / wanted - anchorX;
        graphEditor->panY = graphEditor->pointerY * ZOOM_ONE / wanted - anchorY;
        graphEditor->generation += 1;
    }

    // Delete removes the selected node. Returns true when the key was used.
    KeyPressed :: (graphEditor: GraphEditor~*, keyName: string) -> bool {
        if (keyName == "Delete" || keyName == "Backspace") && graphEditor->selected.length() > 0 && graphEditor->graph->functions.length() > 0 {
            function: GraphFunction~* = graphEditor->graph->functions[graphEditor->functionIndex];
            doomed: string! = `${graphEditor->selected}`;
            if RemoveNode(function, doomed) {
                delete graphEditor->selected;
                graphEditor->selected = "".copy();
                graphEditor->Touch();
                graphEditor->SetStatus("Node deleted.");
            } else {
                graphEditor->SetStatus("That node can't be deleted.");
            }
            delete doomed;
            return true;
        }
        return false;
    }

    SelectNode :: (graphEditor: GraphEditor~*, nodeId: string) -> void {
        delete graphEditor->selected;
        graphEditor->selected = `${nodeId}`;
        graphEditor->generation += 1;
    }

    // Picks the zoom and pan that show every node of the open function, as large as fits, up to twice normal size.
    FitToView :: (graphEditor: GraphEditor~*, canvasWidth: i32, canvasHeight: i32) -> void {
        function: GraphFunction* = graphEditor->graph->functions[graphEditor->functionIndex];
        if function->nodes.length() == 0 {
            return;
        }
        left~ i32 = 1000000;
        top~ i32 = 1000000;
        right~ i32 = -1000000;
        bottom~ i32 = -1000000;
        for node in function->nodes {
            pins := PinsOf(function, node);
            nodeHeight: i32 = NodeHeight(pins);
            delete pins;
            nodeLeft: i32 = i32(node->x);
            nodeTop: i32 = i32(node->y);
            if nodeLeft < left {
                left = nodeLeft;
            }
            if nodeTop < top {
                top = nodeTop;
            }
            if nodeLeft + NODE_WIDTH > right {
                right = nodeLeft + NODE_WIDTH;
            }
            if nodeTop + nodeHeight > bottom {
                bottom = nodeTop + nodeHeight;
            }
        }
        margin: i32 = 24;
        contentWidth: i32 = right - left + margin * 2;
        contentHeight: i32 = bottom - top + margin * 2;
        fitWidth: i32 = canvasWidth * ZOOM_ONE / contentWidth;
        fitHeight: i32 = canvasHeight * ZOOM_ONE / contentHeight;
        fitted~ i32 = fitWidth < fitHeight ? fitWidth : fitHeight;
        if fitted > 200 {
            fitted = 200;
        }
        if fitted < MIN_TEXT_ZOOM {
            fitted = MIN_TEXT_ZOOM;
        }
        graphEditor->zoom = fitted;
        graphEditor->panX = margin - left;
        graphEditor->panY = margin - top;
    }
}
