// Draws the open graph into the graphEditor's pixels: a grid, the wires, then the nodes with their pins.
lantern:::graphs :: namespace {
    // The centre of a pin in screen pixels.
    PinScreenX :: (graphEditor: GraphEditor*, node: GraphNode*, pin: PinSlot*) -> i32 {
        return graphEditor->ScreenX(i32(node->x) + pin->OffsetX());
    }

    PinScreenY :: (graphEditor: GraphEditor*, node: GraphNode*, pin: PinSlot*) -> i32 {
        return graphEditor->ScreenY(i32(node->y) + pin->OffsetY());
    }

    DrawGrid :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*) -> void {
        step: i32 = graphEditor->Scaled(GRID_STEP);
        if step < 4 {
            return;
        }
        startX: i32 = graphEditor->ScreenX(0) % step;
        startY: i32 = graphEditor->ScreenY(0) % step;
        for x~ i32 = startX; x < i32(canvas->width); x += step {
            column: i32 = (x - graphEditor->ScreenX(0)) / step;
            isMajor: bool = column % 5 == 0;
            canvas->Rectangle(x, 0, 1, i32(canvas->height), isMajor ? COLOR_GRID_MAJOR : COLOR_GRID);
        }
        for y~ i32 = startY; y < i32(canvas->height); y += step {
            row: i32 = (y - graphEditor->ScreenY(0)) / step;
            isMajor: bool = row % 5 == 0;
            canvas->Rectangle(0, y, i32(canvas->width), 1, isMajor ? COLOR_GRID_MAJOR : COLOR_GRID);
        }
    }

    // The comment boxes, drawn behind the wires and nodes: a titled panel with the comment's text, and a handle to resize it.
    DrawComments :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*) -> void {
        function: GraphFunction* = graphEditor->Function();
        showText: bool = graphEditor->zoom >= MIN_TEXT_ZOOM;
        for index~ usize = 0; index < function->commentTexts.length(); index++ {
            left: i32 = graphEditor->ScreenX(function->commentXs[index]);
            top: i32 = graphEditor->ScreenY(function->commentYs[index]);
            boxWidth: i32 = graphEditor->Scaled(function->commentWidths[index]);
            boxHeight: i32 = graphEditor->Scaled(function->commentHeights[index]);
            titleHeight: i32 = graphEditor->Scaled(COMMENT_TITLE_HEIGHT);
            isSelected: bool = graphEditor->selectedComment == i32(index);
            canvas->Rectangle(left, top, boxWidth, boxHeight, COLOR_COMMENT);
            canvas->Rectangle(left, top, boxWidth, titleHeight, COLOR_COMMENT_TITLE);
            canvas->Outline(left, top, boxWidth, boxHeight, 1, isSelected ? COLOR_SELECTED : COLOR_NODE_EDGE);
            handle: i32 = graphEditor->Scaled(COMMENT_HANDLE);
            canvas->Rectangle(left + boxWidth - handle, top + boxHeight - 2, handle, 2, isSelected ? COLOR_SELECTED : COLOR_DIM_TEXT);
            canvas->Rectangle(left + boxWidth - 2, top + boxHeight - handle, 2, handle, isSelected ? COLOR_SELECTED : COLOR_DIM_TEXT);
            if showText {
                canvas->Text(left + graphEditor->Scaled(8), top + titleHeight / 2 + canvas->fontAscent() * 35 / 100, function->commentTexts[index], COLOR_TEXT, boxWidth - graphEditor->Scaled(16));
            }
        }
    }

    // A wire from every link a node holds.
    DrawWires :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*) -> void {
        function: GraphFunction* = graphEditor->Function();
        for index~ usize = 0; index < function->nodes.length(); index++ {
            node: GraphNode* = function->nodes[index];
            pins := PinsOf(function, node);
            for pinIndex~ usize = 0; pinIndex < pins->items.length(); pinIndex++ {
                pin: PinSlot* = pins->items[pinIndex];
                if pin->isOutput && pin->isExecution {
                    reference: string = PortReference(node, pin->port);
                    if targetIndex := function->IndexOfNode(reference) {
                        target: GraphNode* = function->nodes[targetIndex];
                        canvas->Wire(PinScreenX(graphEditor, node, pin), PinScreenY(graphEditor, node, pin), graphEditor->ScreenX(i32(target->x)), graphEditor->ScreenY(i32(target->y)) + graphEditor->Scaled(HEADER_HEIGHT / 2), COLOR_EXECUTION);
                    }
                } else if !pin->isOutput && !pin->isExecution {
                    reference: string = PortReference(node, pin->port);
                    if sourceIndex := function->IndexOfNode(reference) {
                        source: GraphNode* = function->nodes[sourceIndex];
                        sourceType: string! = ValueTypeOf(function, reference, 0);
                        defer delete sourceType;
                        fromX~ i32 = graphEditor->ScreenX(i32(source->x) + NodeWidth(source->kind));
                        fromY~ i32 = graphEditor->ScreenY(i32(source->y)) + graphEditor->Scaled(HEADER_HEIGHT / 2);
                        wantedPort: string = ReferencePort(reference);
                        if wantedPort.length() > 0 {
                            sourcePins := PinsOf(function, source);
                            for sourcePin in sourcePins->items {
                                if sourcePin->isOutput && sourcePin->port == wantedPort {
                                    fromX = PinScreenX(graphEditor, source, sourcePin);
                                    fromY = PinScreenY(graphEditor, source, sourcePin);
                                }
                            }
                            delete sourcePins;
                        }
                        canvas->Wire(fromX, fromY, PinScreenX(graphEditor, node, pin), PinScreenY(graphEditor, node, pin), TypeColor(sourceType));
                    }
                }
            }
            delete pins;
        }
    }

    DrawPin :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*, x: i32, y: i32, isExecution: bool, isLinked: bool, valueColor: u32) -> void {
        color: u32 = isExecution ? COLOR_EXECUTION : valueColor;
        zoom: f32 = f32(graphEditor->zoom) / 100.0f;
        if isExecution {
            canvas->Arrow(f32(x), f32(y), 3.0f * zoom + 0.5f, color);
            return;
        }
        radius: f32 = 2.4f * zoom + 0.5f;
        if isLinked {
            canvas->Disc(f32(x), f32(y), radius, color);
        } else {
            canvas->Ring(f32(x), f32(y), radius, 0.5f * zoom + 0.5f, color);
        }
    }

    // The words in a node's header.
    NodeTitle :: (node: GraphNode*) -> string! {
        if IsMaterialNodeKind(node->kind) {
            return MaterialNodeTitle(node);
        }
        if node->kind == "call" && node->functionPath.length() > 0 {
            return `${node->functionPath}`;
        }
        if node->kind == EVENT_KIND {
            return `Event ${node->name}`;
        }
        if (node->kind == "set" || node->kind == "get") && node->name.length() > 0 {
            return `${node->kind} ${node->name}`;
        }
        return `${node->kind}`;
    }

    DrawNode :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*, node: GraphNode*) -> void {
        function: GraphFunction* = graphEditor->Function();
        pins := PinsOf(function, node);
        zoom: i32 = graphEditor->zoom;
        showText: bool = zoom >= MIN_TEXT_ZOOM;
        left: i32 = graphEditor->ScreenX(i32(node->x));
        top: i32 = graphEditor->ScreenY(i32(node->y));
        nodeWidth: i32 = graphEditor->Scaled(pins->width);
        nodeHeight: i32 = graphEditor->Scaled(NodeHeight(pins));
        radius: i32 = graphEditor->Scaled(3);
        frame: i32 = zoom > 150 ? graphEditor->Scaled(1) + 1 : 1;
        isSelected: bool = node->id == graphEditor->selected;
        hasFailed: bool = graphEditor->failedNode.length() > 0 && node->id == graphEditor->failedNode;
        headerColor: u32 = HeaderColor(node->kind);
        canvas->FillRounded(left + graphEditor->Scaled(2), top + graphEditor->Scaled(3), nodeWidth, nodeHeight, radius, true, COLOR_SHADOW, COLOR_SHADOW);
        edgeColor: u32 = isSelected ? COLOR_SELECTED : (hasFailed ? COLOR_FAILED : COLOR_NODE_EDGE);
        outer: i32 = hasFailed ? frame + graphEditor->Scaled(1) + 1 : frame;
        canvas->FillRounded(left - outer, top - outer, nodeWidth + 2 * outer, nodeHeight + 2 * outer, radius + outer, true, edgeColor, edgeColor);
        canvas->FillRounded(left, top, nodeWidth, nodeHeight, radius, true, COLOR_NODE, COLOR_NODE);
        canvas->FillRounded(left, top, nodeWidth, graphEditor->Scaled(HEADER_HEIGHT), radius, false, canvas->Mixed(headerColor, COLOR_TEXT, 1, 9), canvas->Mixed(headerColor, COLOR_SHADOW, 2, 5));
        if hasFailed {
            badge: f32 = 4.0f * f32(zoom) / 100.0f;
            canvas->Disc(f32(left + nodeWidth), f32(top), badge, COLOR_FAILED);
            canvas->Text(left + nodeWidth - canvas->TextWidth("!") / 2, top + canvas->fontAscent() * 35 / 100, "!", COLOR_TEXT, nodeWidth);
        }
        title: string! = NodeTitle(node);
        if showText && !pins->isCompact {
            canvas->Text(left + graphEditor->Scaled(9), top + graphEditor->Scaled(HEADER_HEIGHT) / 2 + canvas->fontAscent() * 35 / 100, title, COLOR_TEXT, nodeWidth - graphEditor->Scaled(18));
        }
        delete title;
        for pinIndex~ usize = 0; pinIndex < pins->items.length(); pinIndex++ {
            pin: PinSlot* = pins->items[pinIndex];
            pinX: i32 = PinScreenX(graphEditor, node, pin);
            pinY: i32 = PinScreenY(graphEditor, node, pin);
            isLinked~ bool = false;
            if pin->isOutput && pin->isExecution {
                isLinked = function->IndexOfNode(PortReference(node, pin->port)) != null;
            } else if !pin->isOutput && !pin->isExecution {
                isLinked = PortReference(node, pin->port).length() > 0;
            } else {
                isLinked = true;
            }
            pinColor~ u32 = COLOR_TYPE_NONE;
            if !pin->isExecution {
                reference: string! = pin->isOutput ? OutputReference(node->id, pin->port) : `${PortReference(node, pin->port)}`;
                pinType: string! = ValueTypeOf(function, reference, 0);
                delete reference;
                pinColor = TypeColor(pinType);
                delete pinType;
            }
            DrawPin(graphEditor, canvas, pinX, pinY, pin->isExecution, isLinked, pinColor);
            if showText && pin->label.length() > 0 {
                labelBaseline: i32 = pinY + canvas->fontAscent() * 35 / 100;
                if pin->isOutput {
                    labelX: i32 = pinX - graphEditor->Scaled(8) - canvas->TextWidth(pin->label);
                    canvas->Text(labelX, labelBaseline, pin->label, COLOR_DIM_TEXT, nodeWidth);
                } else {
                    canvas->Text(pinX + graphEditor->Scaled(8), labelBaseline, pin->label, COLOR_DIM_TEXT, nodeWidth - graphEditor->Scaled(12));
                }
            }
        }
        delete pins;
    }

    // The whole canvas at a size.
    DrawGraph :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*, newWidth: u32, newHeight: u32) -> void {
        canvas->width = newWidth;
        canvas->height = newHeight;
        canvas->zoom = graphEditor->zoom;
        canvas->LoadFont();
        canvas->Clear(COLOR_BACKGROUND);
        if graphEditor->graph->functions.length() == 0 {
            return;
        }
        DrawGrid(graphEditor, canvas);
        DrawComments(graphEditor, canvas);
        DrawWires(graphEditor, canvas);
        function: GraphFunction* = graphEditor->Function();
        for index~ usize = 0; index < function->nodes.length(); index++ {
            DrawNode(graphEditor, canvas, function->nodes[index]);
        }
        if graphEditor->dragMode == DRAG_WIRE {
            fromIndex: usize? = function->IndexOfNode(graphEditor->wireNode);
            if fromIndex != null {
                at~ usize = 0;
                if present := fromIndex {
                    at = present;
                }
                from: GraphNode* = function->nodes[at];
                pins := PinsOf(function, from);
                for pinIndex~ usize = 0; pinIndex < pins->items.length(); pinIndex++ {
                    pin: PinSlot* = pins->items[pinIndex];
                    if pin->port == graphEditor->wirePort {
                        dragReference: string! = OutputReference(from->id, graphEditor->wirePort);
                        dragType: string! = ValueTypeOf(function, dragReference, 0);
                        delete dragReference;
                        canvas->Wire(PinScreenX(graphEditor, from, pin), PinScreenY(graphEditor, from, pin), graphEditor->pointerX, graphEditor->pointerY, pin->isExecution ? COLOR_EXECUTION : TypeColor(dragType));
                        delete dragType;
                    }
                }
                delete pins;
            }
        }
    }
}
