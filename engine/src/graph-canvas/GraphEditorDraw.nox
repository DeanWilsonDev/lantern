// Draws the open graph into the graphEditor's pixels: a grid, the wires, then the nodes with their pins.
lantern:::graphs :: namespace {
    // The centre of a pin in screen pixels.
    PinScreenX :: (graphEditor: GraphEditor*, node: GraphNode*, pin: PinSlot*) -> i32 {
        return graphEditor->ScreenX(i32(node->x) + pin->OffsetX());
    }

    PinScreenY :: (graphEditor: GraphEditor*, node: GraphNode*, pin: PinSlot*) -> i32 {
        return graphEditor->ScreenY(i32(node->y) + pin->OffsetY());
    }

    // The port that holds a node's link for a pin (what SetPort takes), for reading back its reference.
    PortReference :: (node: GraphNode*, port: string) -> string {
        if port == "next" {
            return node->next;
        }
        if port == "then" {
            return node->thenId;
        }
        if port == "else" {
            return node->elseId;
        }
        if port == "a" {
            return node->a;
        }
        if port == "b" {
            return node->b;
        }
        if port == "value" {
            return node->value;
        }
        if port == "condition" {
            return node->condition;
        }
        if port.startsWith("case") {
            caseNumber: usize = PortNumber(port, 4);
            if caseNumber < node->targets.length() {
                return node->targets[caseNumber];
            }
            return "";
        }
        if port.startsWith("arg") {
            argumentNumber~ usize = 0;
            digits: string = port.substring(3, port.length() - 3);
            for digit~ usize = 0; digit < digits.length(); digit++ {
                argumentNumber = argumentNumber * 10 + usize(digits.byteAt(digit) - 48);
            }
            if argumentNumber < node->arguments.length() {
                return node->arguments[argumentNumber];
            }
        }
        return "";
    }

    DrawGrid :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*) -> void {
        step: i32 = GRID_STEP * graphEditor->zoom;
        startX: i32 = graphEditor->ScreenX(0) % step;
        startY: i32 = graphEditor->ScreenY(0) % step;
        for x~ i32 = startX; x < i32(canvas->width); x += step {
            column: i32 = (x - graphEditor->ScreenX(0)) / step;
            isMajor: bool = column % 5 == 0;
            canvas->Rectangle(x, 0, 1, i32(canvas->height), isMajor ? COLOR_GRID_MAJOR : COLOR_GRID);
        }
        for y~ i32 = startY; y < i32(canvas->height); y += step {
            row: i32 = (y - graphEditor->ScreenY(0)) / step;
            isMajor: bool = row % 5 == 0;
            canvas->Rectangle(0, y, i32(canvas->width), 1, isMajor ? COLOR_GRID_MAJOR : COLOR_GRID);
        }
    }

    // A wire from every link a node holds.
    DrawWires :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*) -> void {
        function: GraphFunction* = graphEditor->Function();
        for index~ usize = 0; index < function->nodes.length(); index++ {
            node: GraphNode* = function->nodes[index];
            pins := PinsOf(function, node);
            for pinIndex~ usize = 0; pinIndex < pins->items.length(); pinIndex++ {
                pin: PinSlot* = pins->items[pinIndex];
                if pin->isOutput && pin->isExecution {
                    reference: string = PortReference(node, pin->port);
                    if targetIndex := function->IndexOfNode(reference) {
                        target: GraphNode* = function->nodes[targetIndex];
                        canvas->Wire(PinScreenX(graphEditor, node, pin), PinScreenY(graphEditor, node, pin), graphEditor->ScreenX(i32(target->x)), graphEditor->ScreenY(i32(target->y)) + (HEADER_HEIGHT / 2) * graphEditor->zoom, COLOR_EXECUTION);
                    }
                } else if !pin->isOutput && !pin->isExecution {
                    reference: string = PortReference(node, pin->port);
                    if sourceIndex := function->IndexOfNode(reference) {
                        source: GraphNode* = function->nodes[sourceIndex];
                        canvas->Wire(graphEditor->ScreenX(i32(source->x) + NODE_WIDTH), graphEditor->ScreenY(i32(source->y)) + (HEADER_HEIGHT / 2) * graphEditor->zoom, PinScreenX(graphEditor, node, pin), PinScreenY(graphEditor, node, pin), COLOR_VALUE);
                    }
                }
            }
            delete pins;
        }
    }

    DrawPin :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*, x: i32, y: i32, isExecution: bool, isLinked: bool) -> void {
        color: u32 = isExecution ? COLOR_EXECUTION : COLOR_VALUE;
        zoom: f32 = f32(graphEditor->zoom);
        if isExecution {
            canvas->Arrow(f32(x), f32(y), 3.0f * zoom + 0.5f, color);
            return;
        }
        radius: f32 = 2.4f * zoom + 0.5f;
        if isLinked {
            canvas->Disc(f32(x), f32(y), radius, color);
        } else {
            canvas->Ring(f32(x), f32(y), radius, 0.5f * zoom + 0.5f, color);
        }
    }

    // The words in a node's header.
    NodeTitle :: (node: GraphNode*) -> string! {
        if node->kind == "call" && node->functionPath.length() > 0 {
            return `${node->functionPath}`;
        }
        if node->kind == "set" && node->name.length() > 0 {
            return `set ${node->name}`;
        }
        return `${node->kind}`;
    }

    DrawNode :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*, node: GraphNode*) -> void {
        function: GraphFunction* = graphEditor->Function();
        pins := PinsOf(function, node);
        zoom: i32 = graphEditor->zoom;
        left: i32 = graphEditor->ScreenX(i32(node->x));
        top: i32 = graphEditor->ScreenY(i32(node->y));
        nodeWidth: i32 = NODE_WIDTH * zoom;
        nodeHeight: i32 = NodeHeight(pins) * zoom;
        radius: i32 = 3 * zoom;
        frame: i32 = zoom > 1 ? zoom / 2 + 1 : 1;
        isSelected: bool = node->id == graphEditor->selected;
        headerColor: u32 = HeaderColor(node->kind);
        canvas->FillRounded(left + 2 * zoom, top + 3 * zoom, nodeWidth, nodeHeight, radius, true, COLOR_SHADOW, COLOR_SHADOW);
        canvas->FillRounded(left - frame, top - frame, nodeWidth + 2 * frame, nodeHeight + 2 * frame, radius + frame, true, isSelected ? COLOR_SELECTED : COLOR_NODE_EDGE, isSelected ? COLOR_SELECTED : COLOR_NODE_EDGE);
        canvas->FillRounded(left, top, nodeWidth, nodeHeight, radius, true, COLOR_NODE, COLOR_NODE);
        canvas->FillRounded(left, top, nodeWidth, HEADER_HEIGHT * zoom, radius, false, canvas->Mixed(headerColor, COLOR_TEXT, 1, 9), canvas->Mixed(headerColor, COLOR_SHADOW, 2, 5));
        title: string! = NodeTitle(node);
        canvas->Text(left + 9 * zoom, top + HEADER_HEIGHT * zoom / 2 + canvas->fontAscent() * 35 / 100, title, COLOR_TEXT, nodeWidth - 18 * zoom);
        delete title;
        for pinIndex~ usize = 0; pinIndex < pins->items.length(); pinIndex++ {
            pin: PinSlot* = pins->items[pinIndex];
            pinX: i32 = PinScreenX(graphEditor, node, pin);
            pinY: i32 = PinScreenY(graphEditor, node, pin);
            isLinked~ bool = false;
            if pin->isOutput && pin->isExecution {
                isLinked = function->IndexOfNode(PortReference(node, pin->port)) != null;
            } else if !pin->isOutput && !pin->isExecution {
                isLinked = PortReference(node, pin->port).length() > 0;
            } else {
                isLinked = true;
            }
            DrawPin(graphEditor, canvas, pinX, pinY, pin->isExecution, isLinked);
            if pin->label.length() > 0 {
                labelBaseline: i32 = pinY + canvas->fontAscent() * 35 / 100;
                if pin->isOutput {
                    labelX: i32 = pinX - 8 * zoom - canvas->TextWidth(pin->label);
                    canvas->Text(labelX, labelBaseline, pin->label, COLOR_DIM_TEXT, nodeWidth);
                } else {
                    canvas->Text(pinX + 8 * zoom, labelBaseline, pin->label, COLOR_DIM_TEXT, nodeWidth - 12 * zoom);
                }
            }
        }
        delete pins;
    }

    // The whole canvas at a size.
    DrawGraph :: (graphEditor: GraphEditor*, canvas: PixelCanvas~*, newWidth: u32, newHeight: u32) -> void {
        canvas->width = newWidth;
        canvas->height = newHeight;
        canvas->zoom = graphEditor->zoom;
        canvas->LoadFont();
        canvas->Clear(COLOR_BACKGROUND);
        if graphEditor->graph->functions.length() == 0 {
            return;
        }
        DrawGrid(graphEditor, canvas);
        DrawWires(graphEditor, canvas);
        function: GraphFunction* = graphEditor->Function();
        for index~ usize = 0; index < function->nodes.length(); index++ {
            DrawNode(graphEditor, canvas, function->nodes[index]);
        }
        if graphEditor->dragMode == DRAG_WIRE {
            fromIndex: usize? = function->IndexOfNode(graphEditor->wireNode);
            if fromIndex != null {
                at~ usize = 0;
                if present := fromIndex {
                    at = present;
                }
                from: GraphNode* = function->nodes[at];
                pins := PinsOf(function, from);
                for pinIndex~ usize = 0; pinIndex < pins->items.length(); pinIndex++ {
                    pin: PinSlot* = pins->items[pinIndex];
                    if pin->port == graphEditor->wirePort {
                        canvas->Wire(PinScreenX(graphEditor, from, pin), PinScreenY(graphEditor, from, pin), graphEditor->pointerX, graphEditor->pointerY, pin->isExecution ? COLOR_EXECUTION : COLOR_VALUE);
                    }
                }
                delete pins;
            }
        }
    }
}
