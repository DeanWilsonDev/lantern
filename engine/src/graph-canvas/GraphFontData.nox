    GraphFontCoverage3 :: () -> string {
        return "";
    }

    GraphFontPixelSize :: (sizeIndex: i32) -> i32 {
        if sizeIndex == 0 {
            return 10;
        }
        if sizeIndex == 1 {
            return 14;
        }
        if sizeIndex == 2 {
            return 20;
        }
        if sizeIndex == 3 {
            return 26;
        }
        return 26;
    }

    GraphFontAscent :: (sizeIndex: i32) -> i32 {
        if sizeIndex == 0 {
            return 10;
        }
        if sizeIndex == 1 {
            return 14;
        }
        if sizeIndex == 2 {
            return 19;
        }
        if sizeIndex == 3 {
            return 25;
        }
        return 25;
    }

    GraphFontMetrics :: (sizeIndex: i32) -> Array<i32>! {
        if sizeIndex == 0 {
            return GraphFontMetrics0();
        }
        if sizeIndex == 1 {
            return GraphFontMetrics1();
        }
        if sizeIndex == 2 {
            return GraphFontMetrics2();
        }
        return GraphFontMetrics3();
    }

    GraphFontCoverage :: (sizeIndex: i32) -> string {
        if sizeIndex == 0 {
            return GraphFontCoverage0();
        }
        if sizeIndex == 1 {
            return GraphFontCoverage1();
        }
        if sizeIndex == 2 {
            return GraphFontCoverage2();
        }
        return GraphFontCoverage3();
    }
