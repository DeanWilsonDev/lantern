    GraphFontPixelSize :: (sizeIndex: i32) -> i32 {
        if sizeIndex == 0 {
            return 9;
        }
        if sizeIndex == 1 {
            return 10;
        }
        if sizeIndex == 2 {
            return 11;
        }
        if sizeIndex == 3 {
            return 12;
        }
        if sizeIndex == 4 {
            return 13;
        }
        if sizeIndex == 5 {
            return 14;
        }
        if sizeIndex == 6 {
            return 15;
        }
        if sizeIndex == 7 {
            return 16;
        }
        if sizeIndex == 8 {
            return 17;
        }
        if sizeIndex == 9 {
            return 18;
        }
        if sizeIndex == 10 {
            return 19;
        }
        if sizeIndex == 11 {
            return 20;
        }
        if sizeIndex == 12 {
            return 21;
        }
        if sizeIndex == 13 {
            return 22;
        }
        if sizeIndex == 14 {
            return 23;
        }
        if sizeIndex == 15 {
            return 24;
        }
        if sizeIndex == 16 {
            return 25;
        }
        if sizeIndex == 17 {
            return 26;
        }
        if sizeIndex == 18 {
            return 27;
        }
        if sizeIndex == 19 {
            return 28;
        }
        return 28;
    }

    GraphFontAscent :: (sizeIndex: i32) -> i32 {
        if sizeIndex == 0 {
            return 9;
        }
        if sizeIndex == 1 {
            return 10;
        }
        if sizeIndex == 2 {
            return 11;
        }
        if sizeIndex == 3 {
