Sdl :: import Sdl;

lantern:::stub :: namespace {
    Sdl :: import Sdl;

    LitScene :: class {
    public:
        gpuRenderer~ lantern:::gpu:::GpuRenderer*!;
        renderWorld~ lantern:::renderer:::RenderWorld*!? = null;
        ground~ lantern:::core:::Handle<lantern:::renderer:::MeshTag> = lantern:::core:::Handle<lantern:::renderer:::MeshTag> { };
        gem~ lantern:::core:::Handle<lantern:::renderer:::MeshTag> = lantern:::core:::Handle<lantern:::renderer:::MeshTag> { };
        cube~ lantern:::core:::Handle<lantern:::renderer:::MeshTag> = lantern:::core:::Handle<lantern:::renderer:::MeshTag> { };
        groundTexture~ lantern:::core:::Handle<lantern:::renderer:::TextureTag> = lantern:::core:::Handle<lantern:::renderer:::TextureTag> { };
        atlas~ lantern:::core:::Handle<lantern:::renderer:::TextureTag> = lantern:::core:::Handle<lantern:::renderer:::TextureTag> { };
        frames~ u64 = 0;
        lastReport~ lantern:::renderer:::RenderReport = lantern:::renderer:::RenderReport { };

        LitScene~: (newRenderer: lantern:::gpu:::GpuRenderer*!) {
            gpuRenderer = newRenderer!;
            renderWorld = new lantern:::renderer:::RenderWorld();
        }

        !LitScene~: () {
            delete renderWorld;
            delete gpuRenderer;
        }

        static Create :: (gpuRenderer: lantern:::gpu:::GpuRenderer*!) -> Result<LitScene*!, string!> {
            scene := new LitScene(gpuRenderer!);
            problem: string!? = scene->Load();
            if text := problem {
                failure: string! = `${text}`;
                delete problem;
                delete scene;
                return Result<LitScene*!, string!>:::Err(failure!);
            }
            return Result<LitScene*!, string!>:::Ok(scene!);
        }

        Load~: () -> string!? {
            groundMesh := lantern:::renderer:::Plane(24.0f, 24.0f);
            defer delete groundMesh;
            cubeMesh := lantern:::renderer:::Cube(1.0f);
            defer delete cubeMesh;
            atlasData := lantern:::renderer:::FontAtlas();
            defer delete atlasData;
            when gpuRenderer->CreateMesh(groundMesh) {
                Result:::Ok(handle) -> {
                    ground = handle;
                },
                Result:::Err(message) -> {
                    return message!;
                }
            }
            when gpuRenderer->CreateMesh(cubeMesh) {
                Result:::Ok(handle) -> {
                    cube = handle;
                },
                Result:::Err(message) -> {
                    return message!;
                }
            }
            when lantern:::renderer:::LoadGltfMesh("../assets/models/gem.glb") {
                Result:::Ok(gemMesh) -> {
                    when gpuRenderer->CreateMesh(gemMesh) {
                        Result:::Ok(handle) -> {
                            gem = handle;
                        },
                        Result:::Err(message) -> {
                            delete gemMesh;
                            return message!;
                        }
                    }
                    delete gemMesh;
                },
                Result:::Err(message) -> {
                    return message!;
                }
            }
            when lantern:::renderer:::TextureData:::LoadPng("../assets/textures/ground.png") {
                Result:::Ok(texture) -> {
                    when gpuRenderer->CreateTexture(texture) {
                        Result:::Ok(handle) -> {
                            groundTexture = handle;
                        },
                        Result:::Err(message) -> {
                            delete texture;
                            return message!;
                        }
                    }
                    delete texture;
                },
                Result:::Err(message) -> {
                    return message!;
                }
            }
            when gpuRenderer->CreateTexture(atlasData) {
                Result:::Ok(handle) -> {
                    atlas = handle;
                },
                Result:::Err(message) -> {
                    return message!;
                }
            }
            return null;
        }

        BuildWorld~: (renderWorld: lantern:::renderer:::RenderWorld~*, window: lantern:::platform:::WindowMetrics) -> void {
            renderWorld->Clear();
            seconds: f32 = f32(frames) / 60.0f;
            renderWorld->camera = lantern:::renderer:::Camera:::LookAt(Vec3 { x: 0.0f, y: 3.0f, z: 7.0f }, Vec3 { x: 0.0f, y: 0.6f, z: 0.0f });
            renderWorld->overlayTexture = atlas;
            renderWorld->Draw(ground, groundTexture, Mat4 { }, lantern:::core:::Color:::White());
            gemTransform: Mat4 = Mat4:::translation(Vec3 { x: 0.0f, y: 1.0f, z: 0.0f }) * Mat4:::rotationY(seconds);
            renderWorld->Draw(gem, null, gemTransform, lantern:::core:::Color:::White());
            cubeTransform: Mat4 = Mat4:::translation(Vec3 { x: 2.5f, y: 0.5f, z: -0.5f });
            renderWorld->Draw(cube, null, cubeTransform, lantern:::core:::Color:::Rgb(1.0f, 0.55f, 0.2f));
            cubeBounds := lantern:::core:::Aabb:::FromCenterHalfExtents(Vec3 { x: 2.5f, y: 0.5f, z: -0.5f }, lantern:::core:::Splat3(0.55f));
            renderWorld->AabbLines(cubeBounds, lantern:::core:::Color:::Yellow());
            renderWorld->CircleLines(Vec3 { x: 0.0f, y: 0.02f, z: 0.0f }, lantern:::core:::WorldUp(), 1.5f, 32, lantern:::core:::Color:::Cyan());
            density: f32 = window.pixelDensity;
            titleScale: f32 = lantern:::renderer:::ScaleForDensity(2, density);
            statusScale: f32 = lantern:::renderer:::ScaleForDensity(1, density);
            renderWorld->overlay->Text("Lantern on Nox", Vec2 { x: 12.0f * density, y: 12.0f * density }, titleScale, lantern:::core:::Color:::White());
            status: string! = `${gpuRenderer->DriverName()}: ${lastReport.drawsSubmitted} draws, ${lastReport.drawsCulled} culled, ${lastReport.triangles} triangles`;
            renderWorld->overlay->Text(status, Vec2 { x: 12.0f * density, y: 34.0f * density }, statusScale, lantern:::core:::Color:::White());
            delete status;
        }

        Draw~: (frame: lantern:::engine:::FrameContext) -> void {
            frames += 1;
            drawnWorld := renderWorld!;
            renderWorld = null;
            guard drawnWorld return;
            BuildWorld(drawnWorld, frame.window);
            when gpuRenderer->Render(drawnWorld) {
                Result:::Ok(report) -> {
                    lastReport = report;
                },
                Result:::Err(message) -> {
                    lantern:::core:::LogError("renderer", message);
                    delete message;
                }
            }
            renderWorld = drawnWorld!;
        }

        Capture~: (path: string, width: u32, height: u32) -> bool {
            capturedWorld := renderWorld!;
            renderWorld = null;
            guard capturedWorld return false;
            written~ bool = false;
            when gpuRenderer->Capture(capturedWorld, width, height) {
                Result:::Ok(image) -> {
                    bytes: Array<u8>! = image->ToPngBytes();
                    written = lantern:::core:::WriteBytes(path, bytes);
                    delete bytes;
                    delete image;
                },
                Result:::Err(message) -> {
                    lantern:::core:::LogError("renderer", message);
                    delete message;
                }
            }
            renderWorld = capturedWorld!;
            return written;
        }
    }
}
