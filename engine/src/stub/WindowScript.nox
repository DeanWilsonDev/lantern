lantern:::stub :: namespace {
    /**
     * A scripted sequence of window changes, used to check that resize, minimise, restore and quit events reach the
     * game. At frame 5 it resizes the window to 800x450, at 15 minimises it, at 30 restores it and at 45 asks to quit. It
     * only runs when `LANTERN_WINDOW_SCRIPT=1`, because it would be alarming in a game.
     */
    WindowScript :: class {
        implements:
            lantern:::application:::FrameObserver;
    public:
        enabled~ bool = false;

        WindowScript~: (scriptEnabled: bool) {
            enabled = scriptEnabled;
        }

        /**
         * Called after each frame with the frame number; does one step of the sequence when the frame matches.
         */
        AfterFrame~: (frame: u64, sdlPlatform: lantern:::sdl:::SdlPlatform*) -> void {
            if !enabled {
                return;
            }
            window := sdlPlatform->Window();
            if frame == 5 {
                lantern:::core:::LogInfo("script", "resizing to 800x450");
                window->Resize(800, 450);
            }
            if frame == 15 {
                lantern:::core:::LogInfo("script", "minimising");
                window->Minimize();
            }
            if frame == 30 {
                lantern:::core:::LogInfo("script", "restoring");
                window->Restore();
            }
            if frame == 45 {
                lantern:::core:::LogInfo("script", "asking to quit");
                sdlPlatform->RequestQuit();
            }
        }
    }
}
