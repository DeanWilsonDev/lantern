lantern:::stub :: namespace {
    WindowScript :: class {
        implements:
            lantern:::application:::FrameObserver;
    public:
        enabled~ bool = false;

        WindowScript~: (scriptEnabled: bool) {
            enabled = scriptEnabled;
        }

        AfterFrame~: (frame: u64, platform: lantern:::sdl:::SdlPlatform*) -> void {
            if !enabled {
                return;
            }
            window := platform->Window();
            if frame == 5 {
                lantern:::core:::LogInfo("script", "resizing to 800x450");
                window->Resize(800, 450);
            }
            if frame == 15 {
                lantern:::core:::LogInfo("script", "minimising");
                window->Minimize();
            }
            if frame == 30 {
                lantern:::core:::LogInfo("script", "restoring");
                window->Restore();
            }
            if frame == 45 {
                lantern:::core:::LogInfo("script", "asking to quit");
                platform->RequestQuit();
            }
        }
    }
}
