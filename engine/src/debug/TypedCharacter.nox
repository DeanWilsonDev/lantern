lantern:::debug :: namespace {
    /**
     * The text a key types into the filter box: a lower-case letter, a digit or a space, or null for any other key.
     * The filter ignores case, so there is no shifted form.
     */
    TypedCharacter :: (key: lantern:::core:::KeyCode) -> string? {
        return when key {
                lantern:::core:::KeyCode:::A -> "a",
                lantern:::core:::KeyCode:::B -> "b",
                lantern:::core:::KeyCode:::C -> "c",
                lantern:::core:::KeyCode:::D -> "d",
                lantern:::core:::KeyCode:::E -> "e",
                lantern:::core:::KeyCode:::F -> "f",
                lantern:::core:::KeyCode:::G -> "g",
                lantern:::core:::KeyCode:::H -> "h",
                lantern:::core:::KeyCode:::I -> "i",
                lantern:::core:::KeyCode:::J -> "j",
                lantern:::core:::KeyCode:::K -> "k",
                lantern:::core:::KeyCode:::L -> "l",
                lantern:::core:::KeyCode:::M -> "m",
                lantern:::core:::KeyCode:::N -> "n",
                lantern:::core:::KeyCode:::O -> "o",
                lantern:::core:::KeyCode:::P -> "p",
                lantern:::core:::KeyCode:::Q -> "q",
                lantern:::core:::KeyCode:::R -> "r",
                lantern:::core:::KeyCode:::S -> "s",
                lantern:::core:::KeyCode:::T -> "t",
                lantern:::core:::KeyCode:::U -> "u",
                lantern:::core:::KeyCode:::V -> "v",
                lantern:::core:::KeyCode:::W -> "w",
                lantern:::core:::KeyCode:::X -> "x",
                lantern:::core:::KeyCode:::Y -> "y",
                lantern:::core:::KeyCode:::Z -> "z",
                lantern:::core:::KeyCode:::Digit0 -> "0",
                lantern:::core:::KeyCode:::Digit1 -> "1",
                lantern:::core:::KeyCode:::Digit2 -> "2",
                lantern:::core:::KeyCode:::Digit3 -> "3",
                lantern:::core:::KeyCode:::Digit4 -> "4",
                lantern:::core:::KeyCode:::Digit5 -> "5",
                lantern:::core:::KeyCode:::Digit6 -> "6",
                lantern:::core:::KeyCode:::Digit7 -> "7",
                lantern:::core:::KeyCode:::Digit8 -> "8",
                lantern:::core:::KeyCode:::Digit9 -> "9",
                lantern:::core:::KeyCode:::Space -> " ",
                default -> null,
        };
    }
}
