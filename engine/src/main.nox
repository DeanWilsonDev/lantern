// The entry point. `lantern <game-directory>` runs a Nyx game, `lantern` alone runs the platformer, and `lantern --stub` runs the stub game. Everything else
// starts in application/: Application.nox for the engine's life cycle, Programs.nox for the two programs.
lantern :: import lantern;

main :: (arguments: Array<string>) -> i32 {
    lantern:::core:::InitLogging(lantern:::core:::LogLevelFilter:::Info);
    if arguments.length() > 1 && arguments[1] == "--stub" {
        return RunStub();
    }
    if arguments.length() > 1 {
        return lantern:::application:::RunGame(arguments[1]);
    }
    return lantern:::application:::RunGame("../games/platformer");
}

RunStub :: () -> i32 {
    lantern:::scaffold:::ReportSdlVersion();
    imageRead: bool = lantern:::scaffold:::ReportImageSize("../games/platformer/assets/textures/ground.png");
    modelRead: bool = lantern:::scaffold:::ReportModelMeshes("../games/platformer/assets/models/gem.glb");
    if !imageRead || !modelRead {
        return 1;
    }
    return lantern:::application:::RunStubGame();
}
