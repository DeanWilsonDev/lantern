// The entry point. `lantern <game-directory>` runs a Nyx game; `lantern` alone runs the stub game. Everything else
// starts in application/: Application.nox for the engine's life cycle, Programs.nox for the two programs.
lantern :: import lantern;

main :: (arguments: Array<string>) -> i32 {
    lantern:::core:::InitLogging(lantern:::core:::LogLevelFilter:::Info);
    if arguments.length() > 1 {
        return lantern:::application:::RunGame(arguments[1]);
    }
    lantern:::scaffold:::ReportSdlVersion();
    imageRead: bool = lantern:::scaffold:::ReportImageSize("../assets/textures/ground.png");
    modelRead: bool = lantern:::scaffold:::ReportModelMeshes("../assets/models/gem.glb");
    if !imageRead || !modelRead {
        return 1;
    }
    return lantern:::application:::RunStubGame();
}
