lantern:::platform :: namespace {
    WindowConfig :: struct {
        title~ string = "Lantern";
        width~ u32 = 1280;
        height~ u32 = 720;
        resizable~ bool = true;
        vsync~ bool = true;
    }

    WindowMetrics :: struct {
        logicalWidth~ u32 = 0;
        logicalHeight~ u32 = 0;
        pixelWidth~ u32 = 0;
        pixelHeight~ u32 = 0;
        pixelDensity~ f32 = 1.0f;
        minimized~ bool = false;

        IsDrawableEmpty :: () -> bool {
            return minimized || pixelWidth == 0 || pixelHeight == 0;
        }

        AspectRatio :: () -> f32 {
            if pixelHeight == 0 {
                return 1.0f;
            }
            return f32(pixelWidth) / f32(pixelHeight);
        }

        operator == :: (other: WindowMetrics) -> bool {
            return logicalWidth == other.logicalWidth && logicalHeight == other.logicalHeight
                && pixelWidth == other.pixelWidth && pixelHeight == other.pixelHeight
                && pixelDensity == other.pixelDensity && minimized == other.minimized;
        }
    }

    PlatformEvent :: enum {
        QuitRequested,
        WindowResized,
        WindowMinimized,
        WindowRestored,
        FocusGained,
        FocusLost,
        KeyDown(key: lantern:::core:::KeyCode, repeat: bool),
        KeyUp(key: lantern:::core:::KeyCode),
        MouseMoved(deltaX: f32, deltaY: f32, x: f32, y: f32),
        MouseButtonDown(button: lantern:::core:::MouseButton, x: f32, y: f32),
        MouseButtonUp(button: lantern:::core:::MouseButton, x: f32, y: f32),
        MouseWheel(deltaY: f32),
        GamepadConnected,
        GamepadDisconnected,
        GamepadButtonDown(button: lantern:::core:::GamepadButton),
        GamepadButtonUp(button: lantern:::core:::GamepadButton),
        GamepadAxisMoved(axis: lantern:::core:::GamepadAxis, value: f32)
    }

    PlatformBackend :: interface {
        PumpEvents~ () -> Array<PlatformEvent>! : 0;
        SecondsSinceStart : () -> f64 : 0;
        CurrentWindowMetrics : () -> WindowMetrics : 0;
        SetMouseCaptured~ (captured: bool) -> void : 0;
    }

    AudioSink :: interface {
        SampleRate : () -> u32 : 0;
        QueuedFrames : () -> usize : 0;
        PushFrames~ (interleavedStereo: Array<f32>) -> void : 0;
    }
}
