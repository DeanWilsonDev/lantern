{
  "name": "lantern-native",
  "version": "0.1.0",
  "dependencies": {
    "nyx-scripting-language": { "git": "https://github.com/fearlessgamelabs/nyx-scripting-language", "branch": "proto", "submodules": true },
    "chaos-ui-framework": { "git": "https://github.com/fearlessgamelabs/chaos-ui-framework", "branch": "proto", "submodules": true },
    "cosmos-styling-language": { "git": "https://github.com/fearlessgamelabs/cosmos-styling-language", "branch": "proto", "submodules": true },
    "penumbra-bridge": { "git": "https://github.com/fearlessgamelabs/penumbra-bridge", "branch": "main", "submodules": false }
  },
  "recipe": {
    "library": "lantern-native",
    "cmake": {
      "options": {
        "LANTERN_NYX_SOURCE_DIR": "{nyx-scripting-language}",
        "LANTERN_CHAOS_SOURCE_DIR": "{chaos-ui-framework}",
        "LANTERN_COSMOS_SOURCE_DIR": "{cosmos-styling-language}",
        "LANTERN_PENUMBRA_BRIDGE_SOURCE_DIR": "{penumbra-bridge}"
      },
      "targets": ["lantern-native"]
    },
    "bindings": [
      {
        "headers": ["{nyx-scripting-language}/include/nyx/nyx.h"],
        "includeDirectories": ["{nyx-scripting-language}/include"],
        "from": "{nyx-scripting-language}/include/nyx",
        "namespace": "NyxC"
      },
      {
        "headers": ["include/lantern_chaos_ui.h"],
        "includeDirectories": ["include", "{nyx-scripting-language}/include"],
        "from": "include",
        "namespace": "ChaosUiC"
      }
    ]
  }
}
