@version 1
@type    moving_platform

  name : "Moving platform"
  transform:
    position : [0.0, 0.0, 0.0]
  shape:
    type : "Box"
    half_extents : [1.25, 0.2, 1.25]
  material : "platform"
  tint : "#FFE0A0"
  collider : "kinematic"
  properties:
    period_seconds : 6.0
    travel : [0.0, 0.0, -6.0]
  editor:
    label : "Moving platform"
    lift : 0.0
