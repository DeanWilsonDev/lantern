        lantern:::world:::SetMaterialLook("vent_grille", 0, "FFFFFF", 0.85f, 0.4f, "000000");
        lantern:::world:::SetMaterialLook("warm_plaster", Texture("textures/wall.png"), "E8D5B8", 0.0f, 0.9f, "000000");
        lantern:::world:::SetMaterialLook("wet_asphalt", Texture("textures/ground.png"), "6B7078", 0.0f, 0.25f, "000000");
