        lantern:::world:::SetMaterialShader("gold", "../game-assets/materials", "gold", 0, 0, 0, 0, "roughness=0.22");
        lantern:::world:::SetMaterialShader("lava_flow", "../game-assets/materials", "lava_flow", Texture("textures/brick.png"), Texture("textures/brick_normal.png"), 0, 0, "roughness=0.7");
        lantern:::world:::SetMaterialShader("neon_pulse", "../game-assets/materials", "neon_pulse", 0, 0, 0, 0, "roughness=0.3");
        lantern:::world:::SetMaterialShader("painted_metal", "../game-assets/materials", "painted_metal", Texture("textures/wall.png"), 0, 0, 0, "metallic=0.6;wear=0.3");
        lantern:::world:::SetMaterialShader("vent_grille", "../game-assets/materials", "vent_grille", 0, 0, 0, 0, "metallic=0.85;roughness=0.4");
