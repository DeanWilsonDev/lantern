/* Photo mode's screen furniture (photo-hud.chaos). */

.photo-hud {
    position: absolute;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
}

.photo-nothing {
    width: 0px;
    height: 0px;
}

.viewfinder {
    position: absolute;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
}

/* A sight counts when it is inside this rectangle: 8% in from every edge. */
.viewfinder-frame {
    position: absolute;
    top: 8vh;
    bottom: 8vh;
    left: 8vw;
    right: 8vw;
    border-width: 2px;
    border-color: #FFFFFFB3;
}

.viewfinder-centre {
    position: absolute;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
    display: stack;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.viewfinder-ring {
    width: 34px;
    height: 34px;
    border-width: 2px;
    border-radius: 17px;
    border-color: #FFFFFFCC;
}

.viewfinder-ring-ready {
    width: 34px;
    height: 34px;
    border-width: 3px;
    border-radius: 17px;
    border-color: #7CFFA0;
}

.photo-flash {
    position: absolute;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
    background-color: #FFFFFFE6;
}

/* Under the "Level complete" message, which sits 30% of the way down the screen. */
.photo-album {
    position: absolute;
    top: 46vh;
    left: 0px;
    right: 0px;
    display: stack;
    flex-direction: column;
    align-items: center;
}

.photo-album-text {
    font-size: 16px;
    color: var(--accent-light);
    padding: 6px 16px;
    border-radius: 12px;
    background-color: #0A0F1E99;
}
