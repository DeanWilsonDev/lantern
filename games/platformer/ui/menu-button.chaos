GameUiModel :: import GameUiModel;
MenuChoice :: import MenuChoice;

// One menu button. Any element with onRelease is a button to the engine: the up/down actions
// (GameUi:::SetNavigation in main.nyx) move focus between buttons in the order they appear, the
// engine calls onFocus on the button that gets focus, and onRelease on the focused one when
// confirm is pressed. The focused button is drawn with its `:hover` style (menus.cosmos).
MenuButton :: (label: string, ui~ GameUiModel, choice: MenuChoice) -> Ui:::Element {
    return (
        <frame class="menu-button"
               onFocus={() -> void { Audio:::Play("menu_move", 1.0f); }}
               onRelease={() -> void { ui.Choose(choice); }}>
            <text class="menu-button-label">{label}</text>
        </frame>
    );
}
