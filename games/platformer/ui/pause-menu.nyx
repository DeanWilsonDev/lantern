InputSettings :: import InputSettings;

PauseMenuChoice :: enum {
    Nothing,
    Resume,
    Restart,
    ToggleDebugHud,
    MainMenu,
    Quit
}

// The pause menu (Umbra GameplayUI): one frame of it per call.
// Immediate mode, like MainMenu. The game behind it is frozen, as OnFixedUpdate only simulates
// while Playing, but still drawn, so the backdrop is translucent.
PauseMenu :: namespace {
    BACKDROP :: "00000D73";

    Show :: () -> PauseMenuChoice {
        Overlay:::Rect(0.0f, 0.0f, Screen:::Width(), Screen:::Height(), BACKDROP);
        // Remembered so a change of focus this frame can play the "move" sound below.
        previousFocus := Ui:::Focused();
        // The column starts a fixed fraction of the way down, so it sits in the same place at
        // any window size.
        Ui:::Begin(Screen:::Height() * 0.25f,
            Input:::IsPressed(InputSettings:::MENU_UP),
            Input:::IsPressed(InputSettings:::MENU_DOWN),
            Input:::IsPressed(InputSettings:::MENU_CONFIRM));
        Ui:::Title("PAUSED");
        Ui:::Spacing(1.0f);
        choice~ PauseMenuChoice = PauseMenuChoice:::Nothing;
        if Ui:::Button("Resume") {
            choice = PauseMenuChoice:::Resume;
        }
        Ui:::Spacing(0.5f);
        if Ui:::Button("Restart level") {
            choice = PauseMenuChoice:::Restart;
        }
        Ui:::Spacing(0.5f);
        hudLabel := EngineDebug:::IsHudVisible() ? "Debug HUD: on" : "Debug HUD: off";
        if Ui:::Button(hudLabel) {
            choice = PauseMenuChoice:::ToggleDebugHud;
        }
        Ui:::Spacing(0.5f);
        if Ui:::Button("Main menu") {
            choice = PauseMenuChoice:::MainMenu;
        }
        Ui:::Spacing(0.5f);
        if Ui:::Button("Quit") {
            choice = PauseMenuChoice:::Quit;
        }
        Ui:::End();
        when choice <PauseMenuChoice> {
            Nothing -> {
                if Ui:::Focused() != previousFocus {
                    Audio:::Play("menu_move", 1.0f);
                }
            },
            default -> { Audio:::Play("menu_select", 1.0f); }
        }
        return choice;
    }
}
