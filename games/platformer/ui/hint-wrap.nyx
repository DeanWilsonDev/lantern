HintWrap :: namespace {
    Lines :: (text: string, maximumCharacters: i32) -> Array<string> {
        lines~ Array<string> = [];
        currentLine~ string = "";
        for word in text.split(" ") {
            if word == "" {
                continue;
            }
            if currentLine == "" {
                currentLine = word;
            } else if currentLine.length() + 1 + word.length() <= maximumCharacters {
                currentLine = `${currentLine} ${word}`;
            } else {
                lines.add(currentLine);
                currentLine = word;
            }
        }
        if currentLine != "" {
            lines.add(currentLine);
        }
        return lines;
    }
}
