GameUiModel :: import GameUiModel;

// The in-game text: the status line at the top and a large message in the middle. Both are
// <slot>s, so each re-renders only when its own signal changes (ui.status, ui.message). An
// empty message renders nothing at all.
Hud :: (ui~ GameUiModel) -> Lantern:::Component {
    return (
        <frame class="hud">
            <frame class="hud-top">
                <slot>
                    !{ui.status == ""
                        ? <frame class="hud-nothing" />
                        : <frame class="hud-pill"><text class="hud-status">{ui.status}</text></frame>}
                </slot>
            </frame>
            <frame class="hud-middle">
                <slot>
                    !{ui.message == ""
                        ? <frame class="hud-nothing" />
                        : <text class="hud-message">{ui.message}</text>}
                </slot>
            </frame>
        </frame>
    );
}
