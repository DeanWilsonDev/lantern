GameUiModel :: import GameUiModel;

// The in-game text: the status line at the top, the hint box in the bottom right corner (every
// hint, prompt and note) and a large card in the middle (level complete). Each is a <slot>, so it
// re-renders only when its own signal changes (ui.status, ui.hintRows, ui.card). An empty card
// renders nothing at all.
Hud :: (ui~ GameUiModel) -> lantern:::ui:::Element {
    return (
        <frame class="hud">
            <frame class="hud-top">
                <slot>
                    !{ui.status == ""
                        ? <frame class="hud-nothing" />
                        : <frame class="hud-pill"><text class="hud-status">{ui.status}</text></frame>}
                </slot>
            </frame>
            <frame class="hud-hint">
                <slot>
                    !{ui.hintRows.length() == 0
                        ? <frame class="hud-nothing" />
                        : <frame class="hud-hint-box">
                              <slot>
                                  !{ui.hintRows.map((row: string) -> <text class="hud-hint-text">{row}</text>)}
                              </slot>
                          </frame>}
                </slot>
            </frame>
            <frame class="hud-middle">
                <slot>
                    !{ui.card == ""
                        ? <frame class="hud-nothing" />
                        : <text class="hud-card">{ui.card}</text>}
                </slot>
            </frame>
        </frame>
    );
}
