/* The in-game HUD (hud.chaos): the status line and the centre message. Both sit on translucent
   pills, which keep the text readable over a bright sky (Cosmos has no text shadow yet). */

.hud {
    position: absolute;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
}

/* A full-width strip near the top that centres what is in it. */
.hud-top {
    position: absolute;
    top: 14px;
    left: 0px;
    right: 0px;
    display: stack;
    flex-direction: column;
    align-items: center;
}

.hud-pill {
    padding: 6px 18px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    background-color: #0A0F1E99;
}

.hud-status {
    font-size: 24px;
    color: #FFFFFF;
}

/* 30% of the way down: above the player, not on them. */
.hud-middle {
    position: absolute;
    top: 30vh;
    left: 0px;
    right: 0px;
    display: stack;
    flex-direction: column;
    align-items: center;
}

.hud-message {
    font-size: 32px;
    color: var(--accent);
    padding: 8px 22px;
    border-radius: 14px;
    background-color: #0A0F1E99;
}

.hud-nothing {
    width: 0px;
    height: 0px;
}
