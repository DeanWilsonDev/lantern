/* The in-game HUD (hud.chaos): the status line, the hint box and the centre card. Both sit on translucent
   pills, which keep the text readable over a bright sky (Cosmos has no text shadow yet). */

.hud {
    position: absolute;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
}

/* A strip along the top right, away from the debug window, which takes the top left. */
.hud-top {
    position: absolute;
    top: 14px;
    left: 0px;
    right: 14px;
    display: stack;
    flex-direction: column;
    align-items: end;
}

.hud-pill {
    padding: 6px 18px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    background-color: #0A0F1E99;
}

.hud-status {
    font-size: 16px;
    color: #FFFFFF;
}

/* 30% of the way down: above the player, not on them. */
.hud-middle {
    position: absolute;
    top: 30vh;
    left: 0px;
    right: 0px;
    display: stack;
    flex-direction: column;
    align-items: center;
}

.hud-card {
    font-size: 32px;
    color: var(--accent);
    padding: 8px 22px;
    border-radius: 14px;
    background-color: #0A0F1E99;
}

/* The help line: a small box in the bottom right corner, one <text> per wrapped row. */
.hud-hint {
    position: absolute;
    bottom: 14px;
    left: 0px;
    right: 14px;
    display: stack;
    flex-direction: column;
    align-items: end;
}

.hud-hint-box {
    display: stack;
    flex-direction: column;
    gap: 4px;
    padding: 8px 12px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--line);
    background-color: #0A0F1ECC;
}

.hud-hint-text {
    font-size: 16px;
    color: var(--accent);
}

.hud-nothing {
    width: 0px;
    height: 0px;
}
