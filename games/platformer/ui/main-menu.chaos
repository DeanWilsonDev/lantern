GameUiModel :: import GameUiModel;
MenuButton :: import MenuButton;
MenuChoice :: import MenuChoice;

// The title screen: a panel over the slowly orbiting level. The layout and
// every colour are in menus.cosmos; this file only says what is on the screen, in order.
// Text written straight into an element has its runs of spaces collapsed, as in JSX, so the
// help lines that line up with extra spaces are string expressions.
MainMenu :: (ui~ GameUiModel) -> lantern:::ui:::Element {
    return (
        <frame class="menu-backdrop">
            <frame class="menu-panel">
                <text class="menu-title">LANTERN</text>
                <text class="menu-subtitle">a small 3D platformer</text>
                <frame class="menu-buttons">
                    <MenuButton label="Play" ui={ui} choice={MenuChoice:::Play} />
                    <MenuButton label="Quit" ui={ui} choice={MenuChoice:::Quit} />
                </frame>
                <frame class="menu-help">
                    <text class="menu-help-line">{"Move: WASD / arrows / left stick"}</text>
                    <text class="menu-help-line">{"Look: mouse / right stick    Jump: Space / A"}</text>
                    <text class="menu-help-line">{"Reset: R / Y    Pause: Esc / Start"}</text>
                    <text class="menu-help-line">{"Debug HUD: F1 / Back    Collision view: F2 / R3"}</text>
                    <text class="menu-help-line">{"Reload the game: F5    Click to capture the mouse"}</text>
                </frame>
            </frame>
        </frame>
    );
}
