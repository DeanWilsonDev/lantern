// The in-game text: the status line at the top and a large message in the middle.
//
// Overlay coordinates are screen pixels, with (0, 0) at the top-left and y growing downward.
// Sizes are multiplied by Screen:::UiScale() (1 on a normal display, 2 on a Retina or other
// high-density one), so text is the same physical size everywhere.
Hud :: namespace {
    SHADOW :: "00000099";
    STATUS_COLOR :: "FFFFFF";
    MESSAGE_COLOR :: "FFD24D";

    DrawStatus :: (text: string) -> void {
        guard text.length() > 0;
        scale := Screen:::UiScale() * 1.5f;
        // Centring: text is drawn from its left edge, so start half its width left of the
        // screen's middle. Then its middle sits on the screen's middle.
        x := Screen:::Width() * 0.5f - Overlay:::TextWidth(text, scale) * 0.5f;
        y := 12.0f * Screen:::UiScale();
        DrawShadowed(text, x, y, scale, Screen:::UiScale(), STATUS_COLOR);
    }

    DrawMessage :: (text: string) -> void {
        scale := Screen:::UiScale() * 2.0f;
        x := Screen:::Width() * 0.5f - Overlay:::TextWidth(text, scale) * 0.5f;
        y := Screen:::Height() * 0.3f;     // 30% of the way down: above the player, not on them
        DrawShadowed(text, x, y, scale, Screen:::UiScale() * 1.5f, MESSAGE_COLOR);
    }

    // A drop shadow: the same text in translucent black, nudged right and down by `offset`,
    // drawn first so the real text lands on top. It keeps text readable over bright sky.
    DrawShadowed :: (text: string, x: f32, y: f32, scale: f32, offset: f32, color: string) -> void {
        Overlay:::Text(text, x + offset, y + offset, scale, SHADOW);
        Overlay:::Text(text, x, y, scale, color);
    }
}
