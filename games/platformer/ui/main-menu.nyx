InputSettings :: import InputSettings;

MainMenuChoice :: enum {
    Nothing,
    Play,
    Quit
}

// The title screen (Umbra MainMenuUI): one frame of it per call.
//
// The menus are immediate mode: nothing is kept between frames. Each frame, from OnRender, the
// menu is described again from the top (Begin, then a Title, Labels and Buttons, then End), and
// each Button() returns true on the frame it is chosen. The engine keeps only which button has
// focus, and moves it with the up/down edges passed to Begin.
MainMenu :: namespace {
    BACKDROP :: "00050F8C";            // RRGGBBAA: near-black, 8C/FF ≈ 55% opaque
    CONTROLS :: [
        "Move: WASD / arrows / left stick",
        "Look: mouse / right stick      Jump: Space / A",
        "Reset: R / Y      Pause: Esc / Start",
        "Debug HUD: F1 / Back      Collision view: F2 / R3",
        "Reload the game: F5",
        "Click to capture the mouse"
    ];

    Show :: () -> MainMenuChoice {
        Overlay:::Rect(0.0f, 0.0f, Screen:::Width(), Screen:::Height(), BACKDROP);
        // Remembered so a change of focus this frame can play the "move" sound below.
        previousFocus := Ui:::Focused();
        // The column starts a fixed fraction of the way down, so it sits in the same place at
        // any window size.
        Ui:::Begin(Screen:::Height() * 0.22f,
            Input:::IsPressed(InputSettings:::MENU_UP),
            Input:::IsPressed(InputSettings:::MENU_DOWN),
            Input:::IsPressed(InputSettings:::MENU_CONFIRM));
        Ui:::Title("LANTERN");
        Ui:::Label("a small 3D platformer");
        Ui:::Spacing(2.0f);
        choice~ MainMenuChoice = MainMenuChoice:::Nothing;
        if Ui:::Button("Play") {
            choice = MainMenuChoice:::Play;
        }
        Ui:::Spacing(1.0f);
        if Ui:::Button("Quit") {
            choice = MainMenuChoice:::Quit;
        }
        Ui:::Spacing(3.0f);
        for line: string in CONTROLS {
            Ui:::Label(line);
        }
        Ui:::End();
        when choice <MainMenuChoice> {
            Nothing -> {
                if Ui:::Focused() != previousFocus {
                    Audio:::Play("menu_move", 1.0f);
                }
            },
            (Play || Quit) -> { Audio:::Play("menu_select", 1.0f); }
        }
        return choice;
    }
}
