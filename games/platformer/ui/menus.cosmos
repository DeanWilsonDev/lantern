/* The main menu and the pause menu (main-menu.chaos, pause-menu.chaos, menu-button.chaos). */

/* Covers the window and centres the panel in it, over the 3D scene. */
.menu-backdrop {
    position: absolute;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
    display: stack;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #00050F8C;
}

/* The game behind the pause menu stays visible. */
.pause-backdrop {
    background-color: #00000D73;
}

.menu-panel {
    display: stack;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 28px 44px;
    background-gradient-start: var(--panel-top);
    background-gradient-end: var(--panel-bottom);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 18px;
    box-shadow: #00000099 28px;
}

.menu-title {
    font-size: 40px;
    color: var(--accent);
}

.menu-subtitle {
    color: var(--muted);
}

.menu-buttons {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    margin: 18px 0px;
    min-width: 260px;
}

.menu-button {
    display: stack;
    flex-direction: column;
    align-items: center;
    padding: 8px 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #FFFFFF1F;
    background-color: #FFFFFF12;
}

/* The focused button: games are driven by keys and pads, so Lantern draws focus as hover, for
   the button and everything inside it. (The label's colour is its own `:hover` rule: a rule
   nested inside `.menu-button:hover` would apply whether or not the button has focus, a Cosmos
   bug on its board.) */
.menu-button:hover {
    background-color: var(--accent);
    border-color: var(--accent-light);
}

.menu-button-label:hover {
    color: var(--ink);
}

/* Held while confirm is down. */
.menu-button:active {
    background-color: var(--accent-light);
}

.menu-button-label {
    font-size: 24px;
}

.menu-help {
    display: stack;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin: 6px 0px 0px 0px;
}

.menu-help-line {
    color: var(--muted);
}
