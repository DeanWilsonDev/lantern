GameState :: import GameState;
Hud :: import Hud;
MainMenu :: import MainMenu;
PauseMenu :: import PauseMenu;
Platformer :: import Platformer;

// The root of the game's UI, mounted once from OnStart with GameUi:::Mount. The engine passes
// the game's Application object (Platformer) as the argument; everything here reads the game's
// UI model, `game.ui`.
//
// Which screen shows follows ui.screen, a signal: when the game changes state, these slots
// re-render and the old screen's elements are replaced by the new one's. The pause menu is a
// second slot so it draws over the HUD.
GameScreen :: (game~ Platformer) -> Lantern:::Component {
    ui := game.ui;
    return (
        <frame class="game-screen">
            <slot>
                !{ui.screen == GameState:::MainMenu ? <MainMenu ui={ui} /> : <Hud ui={ui} />}
            </slot>
            <slot>
                !{ui.screen == GameState:::Paused ? <PauseMenu ui={ui} /> : <frame class="hud-nothing" />}
            </slot>
        </frame>
    );
}
