GameUiModel :: import GameUiModel;
MenuButton :: import MenuButton;
MenuChoice :: import MenuChoice;

// The pause menu (Umbra GameplayUI), over the frozen game: OnFixedUpdate only simulates while
// Playing, but the world is still drawn, so the backdrop is translucent.
//
// The debug HUD button's label depends on game state, so it sits in a <slot>: only a slot's
// contents re-render when a signal it read (ui.debugHudOn) changes; the rest of the menu is
// built once.
PauseMenu :: (ui~ GameUiModel) -> lantern:::ui:::Element {
    return (
        <frame class="menu-backdrop pause-backdrop">
            <frame class="menu-panel">
                <text class="menu-title">PAUSED</text>
                <frame class="menu-buttons">
                    <MenuButton label="Resume" ui={ui} choice={MenuChoice:::Resume} />
                    <MenuButton label="Restart level" ui={ui} choice={MenuChoice:::Restart} />
                    <slot>
                        !{(() -> lantern:::ui:::Element {
                            label := ui.debugHudOn ? "Debug HUD: on" : "Debug HUD: off";
                            return (<MenuButton label={label} ui={ui} choice={MenuChoice:::ToggleDebugHud} />);
                        })()}
                    </slot>
                    <MenuButton label="Main menu" ui={ui} choice={MenuChoice:::MainMenu} />
                    <MenuButton label="Quit" ui={ui} choice={MenuChoice:::Quit} />
                </frame>
            </frame>
        </frame>
    );
}
