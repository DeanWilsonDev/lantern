GameUiModel :: import GameUiModel;
MenuButton :: import MenuButton;
MenuChoice :: import MenuChoice;

// The prototype rooms (docs/gameplay-prototypes.md): one small room per gameplay idea, each with a
// route that needs the partner and a route that doesn't. The title screen shows this list in
// place of its usual buttons after "Prototypes" is chosen.
PrototypeMenuButtons :: (ui~ GameUiModel) -> lantern:::ui:::Element {
    return (
        <frame class="menu-buttons">
            <MenuButton label="1  Hold the door" ui={ui} choice={MenuChoice:::PlayHoldTheDoor} />
            <MenuButton label="2  The narrow way" ui={ui} choice={MenuChoice:::PlayTheNarrowWay} />
            <MenuButton label="3  Light gate" ui={ui} choice={MenuChoice:::PlayLightGate} />
            <MenuButton label="4  Hand-off" ui={ui} choice={MenuChoice:::PlayHandOff} />
            <MenuButton label="5  The watcher" ui={ui} choice={MenuChoice:::PlayTheWatcher} />
            <MenuButton label="6  Flow and fragile" ui={ui} choice={MenuChoice:::PlayFlowAndFragile} />
            <MenuButton label="7  The crossing (a full level)" ui={ui} choice={MenuChoice:::PlayTheCrossing} />
            <MenuButton label="8  The climb (grounded)" ui={ui} choice={MenuChoice:::PlayTheClimb} />
            <MenuButton label="9  The word market" ui={ui} choice={MenuChoice:::PlayWordMarket} />
            <MenuButton label="10  The station (a full level)" ui={ui} choice={MenuChoice:::PlayTheStation} />
            <MenuButton label="11  The camera room" ui={ui} choice={MenuChoice:::PlayTheCameraRoom} />
            <MenuButton label="12  The lift" ui={ui} choice={MenuChoice:::PlayTheLift} />
            <MenuButton label="Back" ui={ui} choice={MenuChoice:::ClosePrototypes} />
        </frame>
    );
}
