GameUiModel :: import GameUiModel;
MenuButton :: import MenuButton;
MenuChoice :: import MenuChoice;

// The Finding her rooms (docs/finding-her.md): the festival in chapter 2 and chapter 5, and the three small vignettes. They have
// a list of their own, inside the prototype list, so neither list runs off the screen.
FindingHerMenuButtons :: (ui~ GameUiModel) -> lantern:::ui:::Element {
    return (
        <frame class="menu-buttons">
            <MenuButton label="1  The festival, chapter 2" ui={ui} choice={MenuChoice:::PlayFestivalChapterTwo} />
            <MenuButton label="2  The festival, chapter 5" ui={ui} choice={MenuChoice:::PlayFestivalChapterFive} />
            <MenuButton label="3  The rose garden" ui={ui} choice={MenuChoice:::PlayRoseGarden} />
            <MenuButton label="4  The cable car" ui={ui} choice={MenuChoice:::PlayCableCar} />
            <MenuButton label="5  The lantern walk" ui={ui} choice={MenuChoice:::PlayLanternWalk} />
            <MenuButton label="Back" ui={ui} choice={MenuChoice:::CloseFindingHer} />
        </frame>
    );
}
