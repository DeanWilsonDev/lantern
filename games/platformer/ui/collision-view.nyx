Gem :: import Gem;
GemSystem :: import GemSystem;

// F2 / R3: draws what the physics sees around the player.
//
// The rendered meshes and the collision shapes are separate things; this view draws the
// collision ones, so you can check they line up with what you see.
CollisionView :: namespace {
    GROUNDED_COLOR :: "00FF00";
    AIRBORNE_COLOR :: "FF8030";
    TRIANGLE_COLOR :: "33FFFF";
    VELOCITY_COLOR :: "FFE040";
    GEM_COLOR :: "FF60FF";
    NEARBY_HALF_EXTENT :: 4.0f;

    Draw :: (controller: lantern:::physics:::CharacterController, gems: Array<Gem>) -> void {
        center := controller.CapsuleCenter();
        isGrounded := controller.IsGrounded();
        lantern:::debug:::Capsule(center, controller.Radius(), controller.HalfSegment(), isGrounded ? GROUNDED_COLOR : AIRBORNE_COLOR);
        // Every collision triangle inside an 8 m box (4 m each way) round the player.
        lantern:::debug:::CollisionNear(center, NEARBY_HALF_EXTENT, TRIANGLE_COLOR);
        // The ground normal points straight out of the surface stood on: straight up on flat
        // ground, tilted on a slope. The controller uses it to decide what is walkable.
        if isGrounded {
            lantern:::debug:::Arrow(controller.FeetPosition(), controller.GroundNormal(), GROUNDED_COLOR);
        }
        // The arrow is the distance the player would cover in a quarter of a second at this
        // velocity: long enough to see, short enough to stay near the player.
        lantern:::debug:::Arrow(center, controller.Velocity() * 0.25f, VELOCITY_COLOR);
        // Each gem's trigger sphere. GemSystem counts a touch when this sphere meets the capsule.
        for gem: Gem in gems {
            lantern:::debug:::Sphere(lantern:::world:::Position(gem.entity), GemSystem:::TRIGGER_RADIUS, GEM_COLOR);
        }
    }
}
