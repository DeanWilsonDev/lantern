Gem :: import Gem;
GemSystem :: import GemSystem;

// F2 / R3: draws what the physics sees around the player (Umbra's debug views).
CollisionView :: namespace {
    GROUNDED_COLOR :: "00FF00";
    AIRBORNE_COLOR :: "FF8030";
    TRIANGLE_COLOR :: "33FFFF";
    VELOCITY_COLOR :: "FFE040";
    GEM_COLOR :: "FF60FF";
    NEARBY_HALF_EXTENT :: 4.0f;

    Draw :: (controller: CharacterController, gems: Array<Gem>) -> void {
        center := controller.CapsuleCenter();
        isGrounded := controller.IsGrounded();
        EngineDebug:::Capsule(center, controller.Radius(), controller.HalfSegment(), isGrounded ? GROUNDED_COLOR : AIRBORNE_COLOR);
        EngineDebug:::CollisionNear(center, NEARBY_HALF_EXTENT, TRIANGLE_COLOR);
        if isGrounded {
            EngineDebug:::Arrow(controller.FeetPosition(), controller.GroundNormal(), GROUNDED_COLOR);
        }
        EngineDebug:::Arrow(center, controller.Velocity() * 0.25f, VELOCITY_COLOR);
        for gem: Gem in gems {
            EngineDebug:::Sphere(World:::Position(gem.entity), GemSystem:::TRIGGER_RADIUS, GEM_COLOR);
        }
    }
}
