GameState :: import GameState;
HintWrap :: import HintWrap;
MenuChoice :: import MenuChoice;

// Everything the UI shows, and the one thing it sends back: the bridge between the game and its
// Chaos components (game-screen.chaos and the screens it shows).
//
// The UI is retained, not redrawn by the game each frame. The engine mounts the components once
// (lantern:::ui:::Mount in main.nyx) and draws them every frame. A field marked `@signal` is watched:
// a component that read it during its last render re-renders when the field is written, and
// nothing else does. So the game only writes here when something changed (the setters below
// check), and the HUD isn't rebuilt sixty times a second.
GameUiModel :: class {
public:
    static HINT_ROW_CHARACTERS :: 30;
    // Which screen is up. GameScreen shows the main menu, the HUD, or the HUD under the pause
    // menu from this.
    @signal screen~ GameState = GameState:::MainMenu;
    // The status line at the top ("Gems 2 / 6") and the big message in the middle ("Level
    // complete!"); an empty message hides it.
    @signal status~ string = "";
    @signal message~ string = "";
    // The help line (a sign, "F: climb"): shown in a small box in the bottom right corner, wrapped
    // into rows of at most HINT_ROW_CHARACTERS because Chaos UI text doesn't wrap by itself.
    @signal hintRows~ Array<string> = [];
    // For the pause menu's "Debug HUD: on/off" button. F1 toggles the HUD too, so the game
    // copies the engine's state here every frame.
    @signal debugHudOn~ bool = false;
    // The title screen shows the prototype rooms instead of its usual buttons.
    @signal isPrototypesOpen~ bool = false;
    // Inside the prototype list, the Finding her rooms have a list of their own.
    @signal isFindingHerOpen~ bool = false;

    // Photo mode (game-systems/photo-mode.nyx, ui/photo-hud.chaos): whether the viewfinder is up, whether
    // a photo taken now would count, the line under the viewfinder, the white flash of the shutter,
    // and the album line on the level complete screen.
    @signal isPhotoMode~ bool = false;
    @signal isPhotoReady~ bool = false;
    @signal photoHint~ string = "";
    @signal isPhotoFlash~ bool = false;
    @signal album~ string = "";

    // What a menu button chose. Not a signal: nothing draws it. main.nyx reads it with
    // TakeChoice once per frame.
    choice~ MenuChoice = MenuChoice:::Nothing;

    Show~: (next: GameState) -> void {
        if screen != next {
            screen = next;
        }
    }

    SetStatus~: (text: string) -> void {
        if status != text {
            status = text;
        }
    }

    SetMessage~: (text: string) -> void {
        if message != text {
            message = text;
        }
    }

    SetHint~: (text: string) -> void {
        rows := HintWrap:::Lines(text, HINT_ROW_CHARACTERS);
        if hintRows != rows {
            hintRows = rows;
        }
    }

    SetPrototypesOpen~: (open: bool) -> void {
        if isPrototypesOpen != open {
            isPrototypesOpen = open;
        }
    }

    SetFindingHerOpen~: (open: bool) -> void {
        if isFindingHerOpen != open {
            isFindingHerOpen = open;
        }
    }

    SetDebugHudOn~: (on: bool) -> void {
        if debugHudOn != on {
            debugHudOn = on;
        }
    }

    SetPhotoMode~: (on: bool) -> void {
        if isPhotoMode != on {
            isPhotoMode = on;
        }
    }

    SetPhotoReady~: (ready: bool) -> void {
        if isPhotoReady != ready {
            isPhotoReady = ready;
        }
    }

    SetPhotoHint~: (text: string) -> void {
        if photoHint != text {
            photoHint = text;
        }
    }

    SetPhotoFlash~: (on: bool) -> void {
        if isPhotoFlash != on {
            isPhotoFlash = on;
        }
    }

    SetAlbum~: (text: string) -> void {
        if album != text {
            album = text;
        }
    }

    // Called by a menu button's onRelease. The click sound plays here, so every button sounds
    // the same.
    Choose~: (picked: MenuChoice) -> void {
        choice = picked;
        lantern:::audio:::PlayOn("ui_select", "ui", 1.0f, 1.0f);
    }

    // The choice made since the last call, and forget it.
    TakeChoice~: () -> MenuChoice {
        picked := choice;
        choice = MenuChoice:::Nothing;
        return picked;
    }
}
