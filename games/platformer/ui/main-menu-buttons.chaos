GameUiModel :: import GameUiModel;
MenuButton :: import MenuButton;
MenuChoice :: import MenuChoice;

// The title screen's usual buttons. They are a component of their own so main-menu.chaos can swap
// them for the prototype list (prototype-menu-buttons.chaos) in a <slot>: a component can't
// render another one declared in its own file, and a slot re-renders only its own part.
MainMenuButtons :: (ui~ GameUiModel) -> lantern:::ui:::Element {
    return (
        <frame class="menu-buttons">
            <MenuButton label="Play" ui={ui} choice={MenuChoice:::Play} />
            <MenuButton label="The streets" ui={ui} choice={MenuChoice:::PlayStreets} />
            <MenuButton label="The rooftops" ui={ui} choice={MenuChoice:::PlayRooftops} />
            <MenuButton label="The streets, later" ui={ui} choice={MenuChoice:::PlayStreetsLater} />
            <MenuButton label="Prototypes" ui={ui} choice={MenuChoice:::OpenPrototypes} />
            <MenuButton label="Quit" ui={ui} choice={MenuChoice:::Quit} />
        </frame>
    );
}
