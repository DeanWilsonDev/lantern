GameUiModel :: import GameUiModel;

// Everything photo mode puts on screen (game-systems/photo-mode.nyx writes it into the UI model):
// - the viewfinder: a bordered frame with a ring at its centre. The ring turns green when a photo
//   taken now would count, and the line under the frame says what the camera sees or what is
//   missing;
// - the flash: a white sheet that shows for a moment when the shutter is pressed;
// - the album: on the level complete screen, how many photos were taken and of what.
//
// Each part is a <slot>, so it re-renders only when the signal it reads changes. The frame's
// margins (8% of the width and the height) are the same numbers as PhotoMode's FRAME_MARGIN:
// a sight counts when it is inside this rectangle.
PhotoHud :: (ui~ GameUiModel) -> lantern:::ui:::Element {
    return (
        <frame class="photo-hud">
            <slot>
                !{ui.isPhotoMode
                    ? <frame class="viewfinder">
                          <frame class="viewfinder-frame" />
                          <frame class="viewfinder-centre">
                              <slot>
                                  !{ui.isPhotoReady ? <frame class="viewfinder-ring-ready" /> : <frame class="viewfinder-ring" />}
                              </slot>
                          </frame>
                          <frame class="viewfinder-hint">
                              <slot>
                                  !{<text class="viewfinder-hint-text">{ui.photoHint}</text>}
                              </slot>
                          </frame>
                      </frame>
                    : <frame class="photo-nothing" />}
            </slot>
            <slot>
                !{ui.isPhotoFlash ? <frame class="photo-flash" /> : <frame class="photo-nothing" />}
            </slot>
            <slot>
                !{ui.album == ""
                    ? <frame class="photo-nothing" />
                    : <frame class="photo-album"><text class="photo-album-text">{ui.album}</text></frame>}
            </slot>
        </frame>
    );
}
