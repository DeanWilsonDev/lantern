// The course's light: a low afternoon sun, a sky-and-ground ambient pair and two warm lamps.
//
// The engine lights everything with the same few ingredients, and this file chooses their values:
// - The sun is one light that shines everywhere in one direction. `direction` is the way the light
//   TRAVELS, so { x: -0.4, y: -1.0, z: -0.5 } shines down and toward -x and -z. It casts the
//   shadows you see on the ground, in three cascades: a sharp one near the camera and softer ones
//   farther out.
// - Ambient light stands in for the sky bouncing light everywhere. Surfaces facing up get
//   `skyAmbient` and surfaces facing down get `groundAmbient`, so shaded sides stay readable and
//   look a little blue on top and earthy underneath instead of flat grey.
// - A point light is a lamp: it shines in every direction from one position and fades to nothing
//   at `range` metres. `strength` is 1 for "a white matte surface facing the lamp, close by,
//   looks white"; raise it for brighter lamps.
// See docs/lighting-and-shadows.md for the whole model.
LightingSettings :: namespace {
    SUN_COLOR :: "FFF1D6";
    SKY_AMBIENT :: "5F7FA8";
    GROUND_AMBIENT :: "3A3328";
    LAMP_COLOR :: "FFB866";
    LAMP_STRENGTH :: 6.0f;
    LAMP_RANGE :: 12.0f;
    GEM_GLOW :: "3FD0FF";

    COURSE_PATH :: "worlds/course.world.json";

    // The sun and ambient light, the same in every level. Setting the sun again just replaces the
    // old one, so it is safe to call on every level load.
    // The way the sun's light travels: down, toward -x and -z.
    SunDirection :: () -> lantern:::math:::Vec3 {
        return { x: -0.4f, y: -1.0f, z: -0.5f };
    }

    // The way the moon's light travels at night: down and toward +z, so the moon hangs low in the
    // sky ahead of the player (who faces -z) and a little to the left. A low moon throws long
    // shadows and lights the tops of platforms softly.
    MoonDirection :: () -> lantern:::math:::Vec3 {
        return { x: 0.35f, y: -0.55f, z: 0.75f };
    }

    ConfigureSun :: () -> void {
        lantern:::lights:::SetSun(SunDirection(), SUN_COLOR, SKY_AMBIENT, GROUND_AMBIENT);
        lantern:::lights:::SetSunShadows(true);
    }

    // Where this level's lamps stand. A level with no entry here is lit by the sun alone, so a new
    // level gets lamps by adding a case, not by touching the code that places them. The course has
    // one lamp above the stairs and one by the goal. Each is a point light, so it casts shadows in
    // all six directions; that costs six extra shadow renders, which is why there are only two.
    LampPositions :: (levelPath: string) -> Array<lantern:::math:::Vec3> {
        lamps~ Array<lantern:::math:::Vec3> = [];
        if levelPath == COURSE_PATH {
            stairLamp: lantern:::math:::Vec3 = { x: -5.5f, y: 3.5f, z: 0.5f };
            goalLamp: lantern:::math:::Vec3 = { x: 0.0f, y: 4.0f, z: -27.0f };
            lamps.add(stairLamp);
            lamps.add(goalLamp);
        }
        return lamps;
    }
}
