// The game's actions and their default bindings. F5
// (reload scripts) and F1 (debug HUD) belong to the engine and are not defined here.
//
// Game code never asks "is the W key down?". It names actions ("move", "jump"), binds keys,
// sticks and buttons to them here, and everywhere else asks about the action. Changing a
// binding, or adding a gamepad, then touches only this file.
// - A button action is on or off (IsPressed is true only in the step, or frame,
//   where it went down; IsHeld while it stays down).
// - A vector action is a lantern:::math:::Vec2. For MOVE, x is right and y is forward; W/S/A/D give -1, 0 or 1 on
//   each axis and a stick gives anything in between.
InputSettings :: namespace {
    MOVE :: "move";
    LOOK_MOUSE :: "look_mouse";
    LOOK_STICK :: "look_stick";
    JUMP :: "jump";
    RESET :: "reset";
    TOGGLE_COLLISION_VIEW :: "toggle_collision_view";
    PAUSE :: "pause";
    MENU_UP :: "menu_up";
    MENU_DOWN :: "menu_down";
    MENU_CONFIRM :: "menu_confirm";
    MENU_BACK :: "menu_back";
    CAPTURE_MOUSE :: "capture_mouse";

    // Mouse motion arrives in screen points; this turns it into radians of camera turn. 0.0035
    // rad per point means about 900 points of motion for a half turn (π rad).
    MOUSE_LOOK_SCALE :: 0.0035f;     // radians of turn per point of mouse motion
    STICK_LOOK_SCALE :: 1.0f;

    Configure :: () -> void {
        lantern:::input:::DefineVector(MOVE);
        lantern:::input:::BindKeys(MOVE, "W", "S", "A", "D");
        lantern:::input:::BindKeys(MOVE, "Up", "Down", "Left", "Right");
        lantern:::input:::BindStick(MOVE, "Left", 1.0f);

        lantern:::input:::DefineVector(LOOK_MOUSE);
        lantern:::input:::BindMouseMotion(LOOK_MOUSE, MOUSE_LOOK_SCALE);
        lantern:::input:::DefineVector(LOOK_STICK);
        lantern:::input:::BindStick(LOOK_STICK, "Right", STICK_LOOK_SCALE);

        lantern:::input:::DefineButton(JUMP);
        lantern:::input:::BindKey(JUMP, "Space");
        lantern:::input:::BindGamepadButton(JUMP, "South");

        lantern:::input:::DefineButton(RESET);
        lantern:::input:::BindKey(RESET, "R");
        lantern:::input:::BindGamepadButton(RESET, "North");

        lantern:::input:::DefineButton(TOGGLE_COLLISION_VIEW);
        lantern:::input:::BindKey(TOGGLE_COLLISION_VIEW, "F2");
        lantern:::input:::BindGamepadButton(TOGGLE_COLLISION_VIEW, "RightStick");

        lantern:::input:::DefineButton(PAUSE);
        lantern:::input:::BindKey(PAUSE, "Escape");
        lantern:::input:::BindGamepadButton(PAUSE, "Start");

        // A stick can also drive the menu: pushing it more than 60% of the way counts as a
        // press. The threshold leaves room for a stick resting slightly off centre, and its sign
        // picks the direction (+ is up on LeftY).
        lantern:::input:::DefineButton(MENU_UP);
        lantern:::input:::BindKey(MENU_UP, "Up");
        lantern:::input:::BindKey(MENU_UP, "W");
        lantern:::input:::BindGamepadButton(MENU_UP, "DPadUp");
        lantern:::input:::BindGamepadAxisButton(MENU_UP, "LeftY", 0.6f);

        lantern:::input:::DefineButton(MENU_DOWN);
        lantern:::input:::BindKey(MENU_DOWN, "Down");
        lantern:::input:::BindKey(MENU_DOWN, "S");
        lantern:::input:::BindGamepadButton(MENU_DOWN, "DPadDown");
        lantern:::input:::BindGamepadAxisButton(MENU_DOWN, "LeftY", -0.6f);

        lantern:::input:::DefineButton(MENU_CONFIRM);
        lantern:::input:::BindKey(MENU_CONFIRM, "Enter");
        lantern:::input:::BindKey(MENU_CONFIRM, "Space");
        lantern:::input:::BindGamepadButton(MENU_CONFIRM, "South");

        lantern:::input:::DefineButton(MENU_BACK);
        lantern:::input:::BindKey(MENU_BACK, "Escape");
        lantern:::input:::BindGamepadButton(MENU_BACK, "East");

        lantern:::input:::DefineButton(CAPTURE_MOUSE);
        lantern:::input:::BindMouseButton(CAPTURE_MOUSE, "Left");
    }
}
