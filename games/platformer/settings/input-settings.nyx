// The game's actions and their default bindings (Umbra SnakeApplication::Configure). F5
// (reload scripts) and F1 (debug HUD) belong to the engine and are not defined here.
InputSettings :: namespace {
    MOVE :: "move";
    LOOK_MOUSE :: "look_mouse";
    LOOK_STICK :: "look_stick";
    JUMP :: "jump";
    RESET :: "reset";
    TOGGLE_COLLISION_VIEW :: "toggle_collision_view";
    PAUSE :: "pause";
    MENU_UP :: "menu_up";
    MENU_DOWN :: "menu_down";
    MENU_CONFIRM :: "menu_confirm";
    MENU_BACK :: "menu_back";
    CAPTURE_MOUSE :: "capture_mouse";

    MOUSE_LOOK_SCALE :: 0.0035f;     // radians of turn per point of mouse motion
    STICK_LOOK_SCALE :: 1.0f;

    Configure :: () -> void {
        Input:::DefineVector(MOVE);
        Input:::BindKeys(MOVE, "W", "S", "A", "D");
        Input:::BindKeys(MOVE, "Up", "Down", "Left", "Right");
        Input:::BindStick(MOVE, "Left", 1.0f);

        Input:::DefineVector(LOOK_MOUSE);
        Input:::BindMouseMotion(LOOK_MOUSE, MOUSE_LOOK_SCALE);
        Input:::DefineVector(LOOK_STICK);
        Input:::BindStick(LOOK_STICK, "Right", STICK_LOOK_SCALE);

        Input:::DefineButton(JUMP);
        Input:::BindKey(JUMP, "Space");
        Input:::BindGamepadButton(JUMP, "South");

        Input:::DefineButton(RESET);
        Input:::BindKey(RESET, "R");
        Input:::BindGamepadButton(RESET, "North");

        Input:::DefineButton(TOGGLE_COLLISION_VIEW);
        Input:::BindKey(TOGGLE_COLLISION_VIEW, "F2");
        Input:::BindGamepadButton(TOGGLE_COLLISION_VIEW, "RightStick");

        Input:::DefineButton(PAUSE);
        Input:::BindKey(PAUSE, "Escape");
        Input:::BindGamepadButton(PAUSE, "Start");

        Input:::DefineButton(MENU_UP);
        Input:::BindKey(MENU_UP, "Up");
        Input:::BindKey(MENU_UP, "W");
        Input:::BindGamepadButton(MENU_UP, "DPadUp");
        Input:::BindGamepadAxisButton(MENU_UP, "LeftY", 0.6f);

        Input:::DefineButton(MENU_DOWN);
        Input:::BindKey(MENU_DOWN, "Down");
        Input:::BindKey(MENU_DOWN, "S");
        Input:::BindGamepadButton(MENU_DOWN, "DPadDown");
        Input:::BindGamepadAxisButton(MENU_DOWN, "LeftY", -0.6f);

        Input:::DefineButton(MENU_CONFIRM);
        Input:::BindKey(MENU_CONFIRM, "Enter");
        Input:::BindKey(MENU_CONFIRM, "Space");
        Input:::BindGamepadButton(MENU_CONFIRM, "South");

        Input:::DefineButton(MENU_BACK);
        Input:::BindKey(MENU_BACK, "Escape");
        Input:::BindGamepadButton(MENU_BACK, "East");

        Input:::DefineButton(CAPTURE_MOUSE);
        Input:::BindMouseButton(CAPTURE_MOUSE, "Left");
    }
}
