// How the player feels. The engine's character controller does the moving; these numbers are
// the game's choice (docs/decisions.md D-015 has the reasons for each).
PlayerTuning :: namespace {
    RADIUS :: 0.35f;             // capsule radius, metres
    HEIGHT :: 1.7f;              // capsule height, metres
    WALK_SPEED :: 6.0f;          // metres per second
    JUMP_HEIGHT :: 1.5f;         // apex of a held jump, metres
    GRAVITY :: 28.0f;            // metres per second squared
    TURN_SPEED :: 12.0f;         // radians per second the body turns toward its travel
    LOOK_STICK_SPEED :: 2.5f;    // radians per second at full right-stick deflection
}
