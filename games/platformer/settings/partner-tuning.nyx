// How the partner (the companion you command) feels, and how the puzzle pieces around her behave.
// Every number the prototype rooms need to be tuned by feel is here, so one file answers "how far",
// "how long" and "how fast" (docs/gameplay-prototypes.md lists them with their reasons).
//
// A `namespace` full of constants is the way this game keeps numbers: a name tells you what the
// number is for, and a change happens in one place.
PartnerTuning :: namespace {
    // Her body. She is smaller than the player (radius 0.35, height 1.7) so she fits through a
    // slot the player can't: a 0.66 m slot is wider than her 0.48 m body and narrower than the
    // player's 0.70 m.
    RADIUS :: 0.24f;
    HEIGHT :: 1.5f;
    WALK_SPEED :: 5.0f;                // metres per second; a little slower than the player's 6

    // Following: she walks until she is this close to you, then stands.
    FOLLOW_DISTANCE :: 3.0f;
    // Far behind (on another level of the room, or left behind by a fall) she arrives beside you.
    CATCH_UP_DISTANCE :: 28.0f;

    // The trail she follows: a breadcrumb every metre of ground the player walks, up to this many,
    // and she counts one as reached within this distance.
    TRAIL_SPACING :: 1.0f;
    TRAIL_MAX_POINTS :: 240;
    TRAIL_DROP_POINTS :: 80;
    TRAIL_REACHED_DISTANCE :: 0.6f;

    // Walking to a command point: close enough counts as arrived.
    ARRIVE_DISTANCE :: 0.35f;
    // A command point must be this near you, and in front of the camera, to be the one chosen.
    SEND_RANGE :: 24.0f;
    SEND_FACING_DOT :: 0.2f;           // 1 is dead ahead, 0 is square to the side
    // She gives up a walk that makes no progress for this long (a wall in the way).
    STUCK_SECONDS :: 2.5f;
    STUCK_SPEED :: 0.4f;               // metres per second below which she counts as not moving
    CROUCH_SCALE :: 0.6f;              // how much shorter she is while offering the boost

    // The player's use key pulls a lever within this distance of their feet.
    LEVER_REACH :: 2.2f;
    // She pulls a lever within this distance of herself.
    PARTNER_LEVER_REACH :: 1.6f;

    // Plates, doors and crystals.
    PLATE_HEIGHT_BELOW :: 0.3f;        // a carrier's feet may be this far under a plate's top and still press it
    PLATE_HEIGHT_ABOVE :: 0.7f;        // ... and this far above
    GATE_SPEED :: 7.0f;                // metres per second a door slides open or shut
    GATE_BLOCK_MARGIN :: 0.5f;         // a door won't shut with someone this close to it
    CRYSTAL_DEFAULT_RANGE :: 10.0f;    // metres a light reaches a crystal when the world file doesn't say
    CRYSTAL_DEFAULT_HOLD_SECONDS :: 4.0f;
    LIGHT_RAY_MARGIN :: 0.4f;          // a ray this much short of the crystal counts as reaching it
    SIGN_DEFAULT_RADIUS :: 6.0f;

    // The watcher: how long it stays locked on a lure, and how long after catching you before it can again.
    WATCHER_LURE_SECONDS :: 6.0f;
    WATCHER_FORGIVE_SECONDS :: 1.5f;

    // Flow: a bounce pad's launch and a crumbling plate's timing.
    BOUNCE_DEFAULT_HEIGHT :: 5.0f;
    CRUMBLE_DELAY_SECONDS :: 0.6f;
    CRUMBLE_RETURN_SECONDS :: 3.0f;
}
