// How the partner (the companion who works beside you) feels, and how the puzzle pieces around her behave.
// Every number the prototype rooms need to be tuned by feel is here, so one file answers "how far",
// "how long" and "how fast" (docs/gameplay-prototypes.md lists them with their reasons).
//
// A `namespace` full of constants is the way this game keeps numbers: a name tells you what the
// number is for, and a change happens in one place.
PartnerTuning :: namespace {
    // Her body. She is smaller than the player (radius 0.35, height 1.7) so she fits through a
    // slot the player can't: a 0.66 m slot is wider than her 0.48 m body and narrower than the
    // player's 0.70 m.
    RADIUS :: 0.24f;
    HEIGHT :: 1.5f;
    WALK_SPEED :: 5.0f;                // metres per second; a little slower than the player's 6

    // Leading. She sets off for the next beat when you are within LEAD_RANGE of her, or when you are already
    // nearer that beat than she is (then she hurries, HURRY_SPEED_SCALE times as fast, to get back in front). A
    // player further than HURRY_LIMIT is somewhere else, not ahead. Mid-walk she stops when you fall PAUSE_DISTANCE
    // behind and goes on at RESUME_DISTANCE, so she can't flicker at the edge, and while she waits she faces you and
    // hops every NUDGE_INTERVAL_SECONDS.
    LEAD_RANGE :: 10.0f;
    AHEAD_MARGIN :: 3.0f;
    HURRY_LIMIT :: 30.0f;
    HURRY_SPEED_SCALE :: 1.6f;
    PAUSE_DISTANCE :: 24.0f;
    RESUME_DISTANCE :: 18.0f;
    NUDGE_INTERVAL_SECONDS :: 3.0f;
    HOP_SECONDS :: 0.5f;
    HOP_HEIGHT :: 0.5f;

    // After her last beat she follows you instead: she walks until she is this close to you, then stands. Far
    // behind (left by a fall) she arrives beside you.
    FOLLOW_DISTANCE :: 3.0f;
    CATCH_UP_DISTANCE :: 28.0f;

    // The trail she follows once her beats are done: a breadcrumb every metre of ground the player walks, up to
    // this many, and she counts one as reached within this distance.
    TRAIL_SPACING :: 1.0f;
    TRAIL_MAX_POINTS :: 240;
    TRAIL_DROP_POINTS :: 80;
    TRAIL_REACHED_DISTANCE :: 0.6f;

    // Walking to a beat: close enough counts as arrived.
    ARRIVE_DISTANCE :: 0.35f;
    // Boost: you have landed on a ledge at least this far above her, which an unboosted jump (1.5 m) can't reach.
    LEDGE_MIN_HEIGHT :: 2.0f;
    MIN_JUMP_SECONDS :: 0.1f;

    // Staying safe. Before each step she looks for ground EDGE_PROBE_DISTANCE ahead, up to EDGE_DROP_LIMIT below her
    // feet, and stops at an edge instead of walking off it.
    EDGE_PROBE_DISTANCE :: 0.8f;
    EDGE_DROP_LIMIT :: 1.2f;
    // She counts as stuck after making no progress for STUCK_SECONDS. The first two times she goes back to the beat
    // she last stood at and tries the walk again; the third time she goes straight to the beat she was heading for, so
    // a level can never lock.
    STUCK_SECONDS :: 2.0f;
    STUCK_SPEED :: 0.4f;               // metres per second below which she counts as not moving
    RETRIES_BEFORE_SKIP :: 2;
    // Falling this far below the last beat she stood at puts her back on it.
    FALL_RESET_DEPTH :: 5.0f;
    CROUCH_SCALE :: 0.6f;              // how much shorter she is while offering the boost

    // Finishing together: the goal counts only while she is this far (along the ground) and this far (up or down)
    // from the player.
    TOGETHER_DISTANCE :: 6.0f;
    TOGETHER_HEIGHT :: 3.0f;

    // The player's use key pulls a lever within this distance of their feet.
    LEVER_REACH :: 2.2f;
    // She pulls a lever within this distance of herself.
    PARTNER_LEVER_REACH :: 1.6f;

    // Plates, doors and crystals.
    PLATE_HEIGHT_BELOW :: 0.3f;        // a carrier's feet may be this far under a plate's top and still press it
    PLATE_HEIGHT_ABOVE :: 0.7f;        // ... and this far above
    GATE_SPEED :: 7.0f;                // metres per second a door slides open or shut
    GATE_BLOCK_MARGIN :: 0.5f;         // a door won't shut with someone this close to it
    CRYSTAL_DEFAULT_RANGE :: 10.0f;    // metres a light reaches a crystal when the world file doesn't say
    CRYSTAL_DEFAULT_HOLD_SECONDS :: 4.0f;
    LIGHT_RAY_MARGIN :: 0.4f;          // a ray this much short of the crystal counts as reaching it
    SIGN_DEFAULT_RADIUS :: 6.0f;

    // The watcher: how long it stays locked on a lure, and how long after catching you before it can again.
    WATCHER_LURE_SECONDS :: 6.0f;
    WATCHER_FORGIVE_SECONDS :: 1.5f;

    // Flow: a bounce pad's launch and a crumbling plate's timing.
    BOUNCE_DEFAULT_HEIGHT :: 5.0f;
    CRUMBLE_DELAY_SECONDS :: 0.6f;
    CRUMBLE_RETURN_SECONDS :: 3.0f;
}
