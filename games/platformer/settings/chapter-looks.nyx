LightingSettings :: import LightingSettings;

// How each chapter of the story looks: the sky, the fog and the light's colours. The same level
// reads differently as the relationship changes, so a level file only says which chapter it is
// (a `chapter` number on its spawn entity) and this file turns the number into colours:
// - Chapter 1 is neutral: quiet, a little grey.
// - Chapter 2 is saturated: warm light, a bright sky.
// - Chapter 3 desaturates and the fog comes in closer.
// - Chapter 5 is dark and cold, with the fog nearly on top of you.
// Chapter 4 has no look of its own yet and uses Chapter 3's. Chapter 0, a level that names no
// chapter (the course), keeps the colours the lighting settings give it.
ChapterLooks :: namespace {
    // Sets the sky colour, the fog and the sun and ambient light for `chapter`. Call it after
    // the level's lighting has been applied, because it replaces the sun's colours.
    Apply :: (chapter: i32) -> void {
        when chapter <i32> {
            0 -> { Set("5B93D6", "87B5E0", "5C5A56", 30.0f, 90.0f, LightingSettings:::SUN_COLOR, LightingSettings:::SKY_AMBIENT, LightingSettings:::GROUND_AMBIENT); },
            1 -> { Set("8E9BA8", "B4BFCA", "55524E", 40.0f, 110.0f, "F0EBE0", "8794A3", "4C4842"); },
            2 -> { Set("4D9BEA", "8EC9F5", "6A5A44", 50.0f, 120.0f, "FFE9C2", "79A8E0", "5A4630"); },
            5 -> { Set("07080C", "14161C", "0C0D10", 8.0f, 45.0f, "6A7388", "2A3140", "15161A"); },
            default -> { Set("6D737C", "9AA0A8", "47433F", 25.0f, 80.0f, "E2D3C4", "7A8494", "3E3A38"); }
        }
    }

    // The sky's three colours come from the top of the sky, the horizon and the ground below it
    // (lantern::sky). The horizon colour also clears the screen and colours the fog, so the far
    // distance fades into the sky exactly where the sky is at the horizon and no seam shows.
    Set :: (zenith: string, horizon: string, ground: string, fogStart: f32, fogEnd: f32, sun: string, skyAmbient: string, groundAmbient: string) -> void {
        lantern:::sky:::SetColors(zenith, horizon, ground);
        lantern:::renderer:::SetClearColor(horizon);
        lantern:::atmosphere:::SetFogColor(horizon, 0.5f);
        lantern:::renderer:::SetFog(fogStart, fogEnd);
        lantern:::lights:::SetSun(LightingSettings:::SunDirection(), sun, skyAmbient, groundAmbient);
    }
}
