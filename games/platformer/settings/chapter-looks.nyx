LightingSettings :: import LightingSettings;

// How each chapter of the story looks. The game is played at night: the moon is dim, the sky is
// dark and the fog is a dark blue, so the lights in the level (the companion's glow, the lantern,
// the street lamps, the checkpoint posts and the goal, see game-systems/night-lights.nyx) are
// what you see by. That is what makes the Guide Light readable: a platform appears where the light
// reaches, and you can see the light reach it.
//
// A level file only says which chapter it is (a `chapter` number on its spawn entity) and this
// file turns the number into colours. The same night changes as the relationship does:
// - Chapter 1 is neutral: a quiet blue night.
// - Chapter 2 is saturated: a warmer, violet night with a clearer sky.
// - Chapter 3 desaturates and the fog comes in closer.
// - Chapter 5 is the darkest and coldest, with the fog nearly on top of you.
// Chapter 4 has no look of its own yet and uses Chapter 3's. Chapter 0, a level that names no
// chapter (the course), gets the neutral night.
//
// The daytime look is still here: run the game with LANTERN_LOOK=day to see the old bright
// version of every chapter, which is a quick way to check that a level's geometry reads without
// the lights.
ChapterLooks :: namespace {
    DAY_LOOK :: "day";

    // Sets the sky, the fog, the moon (or sun), the ambient light and the picture's look for
    // `chapter`. Call it after the level's lighting has been applied, because it replaces the
    // sun's colours.
    Apply :: (chapter: i32) -> void {
        if lantern:::engine:::Setting("LANTERN_LOOK") == DAY_LOOK {
            ApplyDay(chapter);
        } else {
            ApplyNight(chapter);
        }
    }

    // The night. The numbers are, in order: the sky's top, its horizon and the ground below it;
    // where the fog starts and ends; the moon's colour (the one light that shines everywhere, so
    // its colour is how bright the night is) and the ambient light from the sky above and the
    // ground below; then how bright the picture is (exposure) and the grade: saturation, contrast,
    // tint and vignette (the dark corners).
    ApplyNight :: (chapter: i32) -> void {
        when chapter <i32> {
            1 -> { SetNight("070B1A", "141C34", "05070E", 30.0f, 120.0f, "8CA4D8", "34456E", "161B2C", 1.1f, 0.95f, 1.05f, "F2F6FF", 0.25f); },
            2 -> { SetNight("05040E", "0F0B1C", "05040A", 28.0f, 120.0f, "B4A4F0", "4A3F78", "1E1832", 1.1f, 1.0f, 1.05f, "FFFFFF", 0.2f); },
            5 -> { SetNight("020308", "070810", "020307", 8.0f, 45.0f, "46506E", "1A2036", "0A0C14", 1.2f, 0.5f, 1.1f, "E8EEFF", 0.5f); },
            3 -> { SetNight("060810", "10151F", "04050A", 20.0f, 85.0f, "7084AE", "2A3450", "12161F", 1.15f, 0.6f, 1.1f, "E8EEFA", 0.4f); },
            4 -> { SetNight("060810", "10151F", "04050A", 20.0f, 85.0f, "7084AE", "2A3450", "12161F", 1.15f, 0.6f, 1.1f, "E8EEFA", 0.4f); },
            default -> { SetNight("070B1A", "141C34", "05070E", 30.0f, 120.0f, "8CA4D8", "34456E", "161B2C", 1.1f, 0.95f, 1.05f, "F2F6FF", 0.25f); }
        }
    }

    ApplyDay :: (chapter: i32) -> void {
        when chapter <i32> {
            0 -> { SetDay("5B93D6", "87B5E0", "5C5A56", 30.0f, 90.0f, LightingSettings:::SUN_COLOR, LightingSettings:::SKY_AMBIENT, LightingSettings:::GROUND_AMBIENT); },
            1 -> { SetDay("8E9BA8", "B4BFCA", "55524E", 40.0f, 110.0f, "F0EBE0", "8794A3", "4C4842"); },
            2 -> { SetDay("4D9BEA", "8EC9F5", "6A5A44", 50.0f, 120.0f, "FFE9C2", "79A8E0", "5A4630"); },
            5 -> { SetDay("07080C", "14161C", "0C0D10", 8.0f, 45.0f, "6A7388", "2A3140", "15161A"); },
            default -> { SetDay("6D737C", "9AA0A8", "47433F", 25.0f, 80.0f, "E2D3C4", "7A8494", "3E3A38"); }
        }
    }

    // The sky's three colours come from the top of the sky, the horizon and the ground below it
    // (lantern::sky). The horizon colour also clears the screen and colours the fog, so the far
    // distance fades into the sky exactly where the sky is at the horizon and no seam shows.
    SetSky :: (zenith: string, horizon: string, ground: string, fogStart: f32, fogEnd: f32) -> void {
        lantern:::sky:::SetColors(zenith, horizon, ground);
        lantern:::renderer:::SetClearColor(horizon);
        lantern:::atmosphere:::SetFogColor(horizon, 0.5f);
        lantern:::renderer:::SetFog(fogStart, fogEnd);
    }

    SetNight :: (zenith: string, horizon: string, ground: string, fogStart: f32, fogEnd: f32, moon: string, skyAmbient: string, groundAmbient: string, exposure: f32, saturation: f32, contrast: f32, tint: string, vignette: f32) -> void {
        SetSky(zenith, horizon, ground, fogStart, fogEnd);
        lantern:::lights:::SetSun(LightingSettings:::MoonDirection(), moon, skyAmbient, groundAmbient);
        // The sun's disc in the sky becomes a pale moon: a little bigger and a lot dimmer than a
        // sun, but still above 1 so it blooms into a glow.
        lantern:::sky:::SetSunDisc(2.2f, 4.0f);
        // Bloom starts lower and is stronger, because lamps are the brightest things on screen.
        lantern:::graphics:::SetBloom(true, 0.35f, 1.0f);
        lantern:::graphics:::SetExposure(exposure);
        lantern:::graphics:::SetColorGrade(saturation, contrast, tint, vignette);
    }

    SetDay :: (zenith: string, horizon: string, ground: string, fogStart: f32, fogEnd: f32, sun: string, skyAmbient: string, groundAmbient: string) -> void {
        SetSky(zenith, horizon, ground, fogStart, fogEnd);
        lantern:::lights:::SetSun(LightingSettings:::SunDirection(), sun, skyAmbient, groundAmbient);
        lantern:::sky:::SetSunDisc(1.15f, 12.0f);
        lantern:::graphics:::SetBloom(true, 0.1f, 1.5f);
        lantern:::graphics:::SetExposure(1.0f);
        lantern:::graphics:::SetColorGrade(1.0f, 1.0f, "FFFFFF", 0.0f);
    }
}
