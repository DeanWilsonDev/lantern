// How a level's rooms stream in and out (docs/level-streaming.md). A room is every block, ramp or light in the world file that
// shares a `room` property. Rooms near the player, the partner or the companion are alive; the rest are not in the engine at all.
//
// All distances are flat metres from the nearest of those three to the room's bounding box, so a room is "near" when any one of
// them is, and the partner's floor is there before she steps onto it.
StreamingSettings :: namespace {
    // A room within this distance starts loading, nearest first.
    LOAD_DISTANCE :: 70.0f;
    // A room past this distance is removed. It is larger than LOAD_DISTANCE, so a room on the edge doesn't flicker.
    UNLOAD_DISTANCE :: 95.0f;
    // A room within this distance loads completely in the step it is noticed, whatever the budget: nobody may stand on half a floor.
    // That is what makes a respawn, a restart or a checkpoint safe.
    URGENT_DISTANCE :: 24.0f;
    // The most entities (a mesh, a collider, a light) the load queue makes in one fixed step outside the urgent ring.
    ENTITIES_PER_STEP :: 12;
}
