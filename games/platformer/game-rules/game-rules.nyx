GameEvent :: import GameEvent;
Gem :: import Gem;
LevelScene :: import LevelScene;
Player :: import Player;
ThirdPersonCamera :: import ThirdPersonCamera;
Math :: import standard:::Math;

// What happens in the game: collecting gems, what falling or pressing reset does, which sounds
// play. The rules react to the step's events and keep the text the HUD shows.
//
// Keeping the rules apart from the systems that detect things means "what counts as touching a
// gem" (GemSystem, maths) and "what touching a gem does" (here, game design) can change
// independently.
GameRules :: class {
public:
    collected~ i32 = 0;
    statusText~ string = "";
    message~ string = "";
    messageSecondsLeft~ f32 = 0.0f;

    Start~: (level: LevelScene) -> void {
        RestartGems(level);
        ShowMessage("Collect every gem!", 3.0f);
    }

    // Called from the fixed step (Platformer.Simulate), once per event, in the order they were
    // queued.
    Handle~: (event: GameEvent, level: LevelScene, player~ Player, camera~ ThirdPersonCamera) -> void {
        when event <GameEvent> {
            GemTouched(entity) -> { Collect(entity, level); },
            PlayerFell -> {
                lantern:::audio:::Play("reset", 1.0f);
                ResetPlayer(player, camera);
            },
            PlayerJumped -> { lantern:::audio:::Play("jump", 0.8f); },
            PlayerLanded(speed) -> { Land(speed); },
            ResetPressed -> {
                lantern:::audio:::Play("reset", 1.0f);
                ResetPlayer(player, camera);
                RestartGems(level);
            }
        }
    }

    // Per display frame: counts the message down.
    // A countdown timer: start at the duration, take away the real time each frame takes, and
    // it's done at 0. It runs per display frame (not per fixed step) because it only controls
    // what's on screen.
    Tick~: (frameSeconds: f32) -> void {
        guard messageSecondsLeft > 0.0f;
        messageSecondsLeft -= frameSeconds;
    }

    IsShowingMessage :: () -> bool {
        return messageSecondsLeft > 0.0f;
    }

private:
    static HARD_LANDING_SPEED :: 4.0f;      // m/s; softer landings are silent
    static LOUDEST_LANDING_SPEED :: 15.0f;

    Collect~: (entity: i64, level: LevelScene) -> void {
        for gem: Gem in level.gems {
            guard gem.entity == entity continue;
            guard !gem.IsCollected() continue;
            gem.Collect();
            collected++;
            lantern:::audio:::Play("pickup", 1.0f);
            ShowGemCount(level);
            if collected == level.gems.length() {
                ShowMessage("All gems collected!", 4.0f);
            }
        }
    }

    // The landing sound gets louder the harder you land. `speed` is how fast the player was
    // falling (m/s) at touchdown. Below HARD_LANDING_SPEED there is no sound, so hopping down a
    // small drop stays quiet. Above it, volume = speed / LOUDEST_LANDING_SPEED: a linear map from
    // speed to 0..1, so a 7.5 m/s landing is half volume, and Min() holds it at full volume
    // for anything faster than 15 m/s.
    Land :: (speed: f32) -> void {
        guard speed > HARD_LANDING_SPEED;
        lantern:::audio:::Play("land", Math:::min(speed / LOUDEST_LANDING_SPEED, 1.0f));
    }

    // Falling off or pressing reset puts the player back at the spawn, with the camera behind
    // them facing the level's forward.
    ResetPlayer :: (player~ Player, camera~ ThirdPersonCamera) -> void {
        player.Reset();
        camera.ResetBehind(0.0f);
    }

    RestartGems~: (level: LevelScene) -> void {
        collected = 0;
        for gem: Gem in level.gems {
            gem.Restore();
        }
        ShowGemCount(level);
    }

    ShowGemCount~: (level: LevelScene) -> void {
        statusText = `Gems ${collected:d} / ${level.gems.length():d}`;
    }

    ShowMessage~: (text: string, seconds: f32) -> void {
        message = text;
        messageSecondsLeft = seconds;
    }
}
