Checkpoint :: import Checkpoint;
CrumblePlatform :: import CrumblePlatform;
Companion :: import Companion;
GameEvent :: import GameEvent;
Gem :: import Gem;
Goal :: import Goal;
LevelScene :: import LevelScene;
Player :: import Player;
Switch :: import Switch;
ThirdPersonCamera :: import ThirdPersonCamera;
Math :: import standard:::Math;

// What happens in the game: collecting gems, what falling or pressing reset does, which sounds
// play. The rules react to the step's events and keep the text the HUD shows.
//
// Keeping the rules apart from the systems that detect things means "what counts as touching a
// gem" (GemSystem, maths) and "what touching a gem does" (here, game design) can change
// independently.
GameRules :: class {
public:
    collected~ i32 = 0;
    statusText~ string = "";
    message~ string = "";
    messageSecondsLeft~ f32 = 0.0f;
    // A card is a full-screen line that stays centred (level complete); every other message goes in the corner box.
    isMessageCard~ bool = false;
    // Where the player comes back to after a fall: the level's spawn point until a checkpoint is
    // reached. `respawnCompanionStop` is the stop of her route she goes back to with them.
    respawnPosition~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    respawnCompanionStop~ i32 = 0;
    // Slice 2. Set when the lantern is picked up; main turns its light on and keeps it on.
    isCarryingLantern~ bool = false;
    // Slice 4. Set when a goal is reached; main waits a few seconds, then loads `nextLevel`.
    isLevelComplete~ bool = false;
    nextLevel~ string = "";
    // How many times the level has been restarted (R or the pause menu), so the partner can follow suit.
    restartCount~ i32 = 0;
    // The last place the player stood on the ground away from any thorn. A thorn sends them
    // back here, which is a nudge, not a death: nothing is lost.
    safeSpot~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();

    Start~: (level: LevelScene) -> void {
        respawnPosition = level.spawnPosition;
        respawnCompanionStop = level.playStartCompanionStop;
        isCarryingLantern = false;
        isLevelComplete = false;
        safeSpot = level.spawnPosition;
        RestartGems(level);
        ShowMessage("Collect every gem!", 3.0f);
    }

    // Called from the fixed step (Platformer.Simulate), once per event, in the order they were
    // queued.
    Handle~: (event: GameEvent, level~ LevelScene, player~ Player, camera~ ThirdPersonCamera, companion~ Companion) -> void {
        when event <GameEvent> {
            CheckpointReached(entity) -> { Reach(entity, level); },
            GemTouched(entity) -> { Collect(entity, level); },
            GoalReached(entity) -> { Finish(entity, level); },
            // A fall costs a walk back and nothing else: the gems stay collected, and the
            // companion is waiting where she was when the checkpoint was reached.
            PlayerFell -> {
                lantern:::audio:::Play("reset", 1.0f);
                ResetPlayer(player, camera);
                companion.SendToStop(respawnCompanionStop);
            },
            LanternTaken(entity) -> { TakeLantern(entity, level); },
            ThornsTouched -> {
                lantern:::audio:::Play("reset", 0.6f);
                player.RespawnAt(safeSpot);
            },
            // A watcher's beam caught the player: back to the last checkpoint, nothing lost. Rooms
            // with a watcher put a checkpoint behind each pillar.
            PlayerSeen -> {
                lantern:::audio:::Play("reset", 0.6f);
                ShowMessage("Seen! Back to the last cover", 2.0f);
                ResetPlayer(player, camera);
            },
            PlayerBoosted -> {
                lantern:::audio:::Play("jump", 1.0f);
                companion.BoostJumpStarted();
            },
            PlayerJumped -> { lantern:::audio:::Play("jump", 0.8f); },
            PlayerLanded(speed) -> { Land(speed); },
            PlayerSwingStarted -> { lantern:::audio:::Play("jump", 0.6f); },
            PlayerSwingLanded -> { lantern:::audio:::Play("land", 0.4f); },
            ResetPressed -> {
                lantern:::audio:::Play("reset", 1.0f);
                RestartLevel(level, player, camera, companion);
            }
        }
    }

    // Per display frame: counts the message down.
    // A countdown timer: start at the duration, take away the real time each frame takes, and
    // it's done at 0. It runs per display frame (not per fixed step) because it only controls
    // what's on screen.
    NoteSafeSpot~: (feet: lantern:::math:::Vec3) -> void {
        safeSpot = feet;
    }

    Tick~: (frameSeconds: f32) -> void {
        guard messageSecondsLeft > 0.0f;
        messageSecondsLeft -= frameSeconds;
    }

    // Shows a line from outside the rules, such as a hint or a note from the partner.
    Announce~: (text: string, seconds: f32) -> void {
        ShowMessage(text, seconds);
    }

    // Shows a line from outside the rules as a centred card, such as an ending.
    AnnounceCard~: (text: string, seconds: f32) -> void {
        ShowCard(text, seconds);
    }

    IsShowingMessage :: () -> bool {
        return messageSecondsLeft > 0.0f;
    }

private:
    static HARD_LANDING_SPEED :: 4.0f;      // m/s; softer landings are silent
    static LOUDEST_LANDING_SPEED :: 15.0f;

    Collect~: (entity: i64, level: LevelScene) -> void {
        for gem: Gem in level.gems {
            guard gem.entity == entity continue;
            guard !gem.IsCollected() continue;
            gem.Collect();
            collected++;
            lantern:::audio:::Play("pickup", 1.0f);
            ShowGemCount(level);
            if collected == level.gems.length() {
                ShowMessage("All gems collected!", 4.0f);
            }
        }
    }

    // The level is complete. Nothing is lost by finishing and nothing ends abruptly: a message with
    // the gem count shows, and main moves on after a few seconds.
    Finish~: (entity: i64, level~ LevelScene) -> void {
        guard !isLevelComplete;
        for goal~ Goal in level.goals {
            guard goal.entity == entity continue;
            goal.Reach();
            isLevelComplete = true;
            nextLevel = goal.nextLevel;
            lantern:::audio:::Play("pickup", 1.0f);
            ShowCard(`Level complete! Gems ${collected:d} / ${level.gems.length():d}`, 6.0f);
        }
    }

    TakeLantern~: (entity: i64, level: LevelScene) -> void {
        for pickup in level.lanterns {
            guard pickup.entity == entity continue;
            pickup.Take();
            isCarryingLantern = true;
            lantern:::audio:::Play("pickup", 0.6f);
            ShowMessage("A lantern: its light shows hidden ground", 3.0f);
        }
    }

    Reach~: (entity: i64, level~ LevelScene) -> void {
        for checkpoint~ Checkpoint in level.checkpoints {
            guard checkpoint.entity == entity continue;
            guard !checkpoint.isReached continue;
            checkpoint.Reach();
            // A hair above the post's base (5 cm): a checkpoint sits exactly on the floor, and a
            // capsule that starts touching it can be pushed out sideways instead of just standing.
            lift: lantern:::math:::Vec3 = { y: 0.05f };
            respawnPosition = checkpoint.respawnPosition + lift;
            respawnCompanionStop = checkpoint.companionStop;
            lantern:::audio:::Play("pickup", 0.6f);
            ShowMessage("Checkpoint", 2.0f);
        }
    }

    // Start over: back at the level's spawn point with every gem and checkpoint as new.
    RestartLevel~: (level~ LevelScene, player~ Player, camera~ ThirdPersonCamera, companion~ Companion) -> void {
        respawnPosition = level.spawnPosition;
        respawnCompanionStop = level.playStartCompanionStop;
        safeSpot = level.spawnPosition;
        isLevelComplete = false;
        restartCount++;
        for each~ Switch in level.switches {
            each.Reset();
        }
        for platform~ CrumblePlatform in level.crumbles {
            platform.Restore();
        }
        for goal~ Goal in level.goals {
            goal.Restore();
        }
        for checkpoint~ Checkpoint in level.checkpoints {
            checkpoint.Restore();
        }
        ResetPlayer(player, camera);
        companion.SendToStop(level.playStartCompanionStop);
        RestartGems(level);
    }

    // The landing sound gets louder the harder you land. `speed` is how fast the player was
    // falling (m/s) at touchdown. Below HARD_LANDING_SPEED there is no sound, so hopping down a
    // small drop stays quiet. Above it, volume = speed / LOUDEST_LANDING_SPEED: a linear map from
    // speed to 0..1, so a 7.5 m/s landing is half volume, and Min() holds it at full volume
    // for anything faster than 15 m/s.
    Land :: (speed: f32) -> void {
        guard speed > HARD_LANDING_SPEED;
        lantern:::audio:::Play("land", Math:::min(speed / LOUDEST_LANDING_SPEED, 1.0f));
    }

    // Falling off or pressing reset puts the player back at the respawn point, with the camera
    // behind them facing the level's forward.
    ResetPlayer :: (player~ Player, camera~ ThirdPersonCamera) -> void {
        player.RespawnAt(respawnPosition);
        camera.ResetBehind(0.0f);
    }

    RestartGems~: (level: LevelScene) -> void {
        collected = 0;
        for gem: Gem in level.gems {
            gem.Restore();
        }
        ShowGemCount(level);
    }

    ShowGemCount~: (level: LevelScene) -> void {
        statusText = `Gems ${collected:d} / ${level.gems.length():d}`;
    }

    ShowMessage~: (text: string, seconds: f32) -> void {
        message = text;
        messageSecondsLeft = seconds;
        isMessageCard = false;
    }

    ShowCard~: (text: string, seconds: f32) -> void {
        message = text;
        messageSecondsLeft = seconds;
        isMessageCard = true;
    }
}
