Checkpoint :: import Checkpoint;
ClimbSurface :: import ClimbSurface;
FoodStall :: import FoodStall;
WordToken :: import WordToken;
Anchor :: import Anchor;
BouncePad :: import BouncePad;
CrumblePlatform :: import CrumblePlatform;
CompanionStop :: import CompanionStop;
Gate :: import Gate;
ScriptedEntity :: import ScriptedEntity;
Sign :: import Sign;
Switch :: import Switch;
Watcher :: import Watcher;
Gem :: import Gem;
Goal :: import Goal;
GlowPlatform :: import GlowPlatform;
LanternPickup :: import LanternPickup;
LightingSettings :: import LightingSettings;
MovingPlatform :: import MovingPlatform;
TeamBeat :: import TeamBeat;
Thorns :: import Thorns;

// The level: a world file made in the editor, plus what the game reads from it. Entities are
// found by kind, so the file decides how many gems and platforms there are.
//
// The split of work: lantern:::world:::Load (engine) builds everything in the file, meshes and collision
// included. The game then asks for the kinds it gives meaning to ("spawn", "kill_plane", "gem",
// "moving_platform", "checkpoint", "companion_stop") and wraps them in its own classes.
LevelScene :: class {
public:
    spawnPosition~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    killHeight~ f32 = -10.0f;
    gems~ Array<Gem> = [];
    platforms~ Array<MovingPlatform> = [];
    checkpoints~ Array<Checkpoint> = [];
    // The companion's route, sorted by each stop's `order`. Empty when the level has none.
    companionStops~ Array<CompanionStop> = [];
    // Slice 2: pieces that only exist while a light reaches them, lanterns to pick up, and thorns.
    glowPlatforms~ Array<GlowPlatform> = [];
    // Slice 3: swing arcs between two posts.
    anchors~ Array<Anchor> = [];
    // Slice 4: where the level ends, and what comes next.
    goals~ Array<Goal> = [];
    lanterns~ Array<LanternPickup> = [];
    thorns~ Array<Thorns> = [];
    // The prototype rooms' pieces (docs/gameplay-prototypes.md): the partner who works beside you and her
    // beats, plates, levers and crystals, the gates they open, and signs.
    hasPartner~ bool = false;
    partnerStart~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    // The partner's route, sorted by each beat's `order`. Empty when the level has none.
    teamBeats~ Array<TeamBeat> = [];
    switches~ Array<Switch> = [];
    gates~ Array<Gate> = [];
    signs~ Array<Sign> = [];
    watchers~ Array<Watcher> = [];
    bouncePads~ Array<BouncePad> = [];
    crumbles~ Array<CrumblePlatform> = [];
    scripted~ Array<ScriptedEntity> = [];
    // The grounded adventure prototypes (docs/gameplay-prototypes.md): the surfaces only the player can climb, the words
    // and phrases to collect, the stalls to eat at, and which platforms are trains. `isGroundedFeel` is the spawn's
    // `movement` property being "grounded".
    climbSurfaces~ Array<ClimbSurface> = [];
    wordTokens~ Array<WordToken> = [];
    foodStalls~ Array<FoodStall> = [];
    trains~ Array<MovingPlatform> = [];
    isGroundedFeel~ bool = false;
    // Which chapter's look the level wears (ChapterLooks): the spawn's `chapter` property, 0 if none.
    chapter~ i32 = 0;
    // The spawn's `ambience` property (which sounds the level lives in, see game-systems/audio-director.nyx) and `surface`
    // property (what the ground is, see game-systems/footstep-system.nyx); "" for none.
    ambience~ string = "";
    surface~ string = "";

    // Returns the number of entities the file made.
    Load~: (path: string, gemMesh: i64, cubeMesh: i64) -> i32 {
        Unload();
        loaded := lantern:::world:::Load(path);
        guard loaded throw;
        // One of each is expected; if the file has more, the last one wins.
        for spawn: i64 in lantern:::world:::FindByKind("spawn") {
            spawnPosition = lantern:::world:::Position(spawn);
            chapter = lantern:::world:::HasProperty(spawn, "chapter") ? i32(lantern:::world:::NumberProperty(spawn, "chapter")) : 0;
            ambience = lantern:::world:::HasProperty(spawn, "ambience") ? lantern:::world:::TextProperty(spawn, "ambience") : "";
            surface = lantern:::world:::HasProperty(spawn, "surface") ? lantern:::world:::TextProperty(spawn, "surface") : "";
            isGroundedFeel = lantern:::world:::HasProperty(spawn, "movement") && lantern:::world:::TextProperty(spawn, "movement") == "grounded";
        }
        // Only the kill plane's height matters: falling below it anywhere counts.
        for killPlane: i64 in lantern:::world:::FindByKind("kill_plane") {
            killHeight = lantern:::world:::Position(killPlane).y;
        }
        // Each gem gets a number in file order, which Gem uses to offset its bob.
        index~ i32 = 0;
        for entity: i64 in lantern:::world:::FindByKind("gem") {
            lantern:::world:::SetMesh(entity, gemMesh, "FFFFFF");
            gem~ Gem = new Gem(entity, index);
            gem.Glow(LightingSettings:::GEM_GLOW);
            gems.add(gem);
            index++;
        }
        for entity: i64 in lantern:::world:::FindByKind("moving_platform") {
            platform~ MovingPlatform = new MovingPlatform(entity);
            platforms.add(platform);
            if lantern:::world:::HasProperty(entity, "train") {
                trains.add(platform);
            }
        }
        for entity: i64 in lantern:::world:::FindByKind("checkpoint") {
            checkpoint~ Checkpoint = new Checkpoint(entity);
            checkpoint.Place(cubeMesh);
            checkpoints.add(checkpoint);
        }
        for entity: i64 in lantern:::world:::FindByKind("companion_stop") {
            companionStops.add(new CompanionStop(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("goal") {
            goal~ Goal = new Goal(entity);
            goal.Place(cubeMesh);
            goals.add(goal);
        }
        for entity: i64 in lantern:::world:::FindByKind("swing_arc") {
            anchor~ Anchor = new Anchor(entity);
            if !anchor.isValid {
                lantern:::engine:::Log(`swing_arc (entity ${entity:d}) needs an "end" property at least half a metre from its start along the ground: skipped`);
                continue;
            }
            anchor.Place(cubeMesh);
            anchors.add(anchor);
        }
        for entity: i64 in lantern:::world:::FindByKind("glow_platform") {
            glowPlatform~ GlowPlatform = new GlowPlatform(entity);
            glowPlatform.Hide();
            glowPlatforms.add(glowPlatform);
        }
        for entity: i64 in lantern:::world:::FindByKind("lantern") {
            lantern:::world:::SetTint(entity, LANTERN_TINT);
            lanterns.add(new LanternPickup(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("thorns") {
            patch~ Thorns = new Thorns(entity);
            patch.Grow(chapter);
            thorns.add(patch);
        }
        for entity: i64 in lantern:::world:::FindByKind("partner_start") {
            hasPartner = true;
            partnerStart = lantern:::world:::Position(entity);
        }
        for entity: i64 in lantern:::world:::FindByKind("team_beat") {
            beat~ TeamBeat = new TeamBeat(entity);
            beat.Place(cubeMesh);
            teamBeats.add(beat);
        }
        for kind: string in ["plate", "lever", "crystal"] {
            for entity: i64 in lantern:::world:::FindByKind(kind) {
                piece~ Switch = new Switch(entity);
                piece.Place(cubeMesh, gemMesh);
                switches.add(piece);
            }
        }
        for entity: i64 in lantern:::world:::FindByKind("gate") {
            gate~ Gate = new Gate(entity);
            gate.Start();
            gates.add(gate);
        }
        for entity: i64 in lantern:::world:::FindByKind("sign") {
            signs.add(new Sign(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("climb_surface") {
            surface~ ClimbSurface = new ClimbSurface(entity);
            surface.Place();
            climbSurfaces.add(surface);
        }
        wordIndex~ i32 = 0;
        for entity: i64 in lantern:::world:::FindByKind("word_token") {
            token~ WordToken = new WordToken(entity, wordIndex);
            lantern:::world:::SetMesh(entity, gemMesh, "FFFFFF");
            token.Glow();
            wordTokens.add(token);
            wordIndex++;
        }
        for entity: i64 in lantern:::world:::FindByKind("food_stall") {
            stall~ FoodStall = new FoodStall(entity);
            stall.Place(cubeMesh);
            foodStalls.add(stall);
        }
        for entity: i64 in lantern:::world:::FindByKind("watcher") {
            watchers.add(new Watcher(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("bounce_pad") {
            pad~ BouncePad = new BouncePad(entity);
            pad.Place();
            bouncePads.add(pad);
        }
        for entity: i64 in lantern:::world:::FindByKind("crumble") {
            crumbles.add(new CrumblePlatform(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("scripted") {
            behaviour~ ScriptedEntity = new ScriptedEntity(entity);
            if !behaviour.Run(0.0f) {
                lantern:::engine:::Log(`scripted entity ${entity:d} names graph '${behaviour.graph}' function '${behaviour.function}', which the game doesn't have: skipped`);
            } else {
                scripted.add(behaviour);
            }
        }
        // The file lists the stops in any order; the route follows their `order` property.
        companionStops = companionStops.sort((first, second) -> first.order < second.order);
        teamBeats = teamBeats.sort((first, second) -> first.order < second.order);
        lantern:::engine:::Log(`level ${path}: ${gems.length():d} gems, ${platforms.length():d} moving platforms`);
        return loaded;
    }

    Unload~: () -> void {
        lantern:::world:::Clear();
        gems = [];
        platforms = [];
        checkpoints = [];
        companionStops = [];
        glowPlatforms = [];
        anchors = [];
        goals = [];
        lanterns = [];
        thorns = [];
        hasPartner = false;
        teamBeats = [];
        switches = [];
        gates = [];
        signs = [];
        for watcher~ Watcher in watchers {
            watcher.TurnOff();
        }
        watchers = [];
        bouncePads = [];
        crumbles = [];
        climbSurfaces = [];
        wordTokens = [];
        foodStalls = [];
        trains = [];
        isGroundedFeel = false;
        chapter = 0;
        ambience = "";
        surface = "";
    }

private:
    static LANTERN_TINT :: "FFD27A";
}
