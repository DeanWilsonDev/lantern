Checkpoint :: import Checkpoint;
ClimbSurface :: import ClimbSurface;
FoodStall :: import FoodStall;
WordToken :: import WordToken;
Anchor :: import Anchor;
BouncePad :: import BouncePad;
CrumblePlatform :: import CrumblePlatform;
CompanionStop :: import CompanionStop;
Gate :: import Gate;
GraphBehaviours :: import GraphBehaviours;
SilhouetteBehaviour :: import SilhouetteBehaviour;
Sign :: import Sign;
Switch :: import Switch;
Watcher :: import Watcher;
Gem :: import Gem;
Goal :: import Goal;
GlowPlatform :: import GlowPlatform;
LanternPickup :: import LanternPickup;
LightingSettings :: import LightingSettings;
MovingPlatform :: import MovingPlatform;
TeamBeat :: import TeamBeat;
Thorns :: import Thorns;
SearchSite :: import SearchSite;

// The level: a world file made in the editor, plus what the game reads from it. Entities are
// found by kind, so the file decides how many gems and platforms there are.
//
// The split of work: lantern:::world:::Load (engine) builds everything in the file, meshes and collision
// included. The game then asks for the kinds it gives meaning to ("spawn", "kill_plane", "gem",
// "moving_platform", "checkpoint", "companion_stop") and wraps them in its own classes.
LevelScene :: class {
public:
    spawnPosition~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    killHeight~ f32 = -10.0f;
    gems~ Array<Gem> = [];
    platforms~ Array<MovingPlatform> = [];
    checkpoints~ Array<Checkpoint> = [];
    // The companion's route, sorted by each stop's `order`. Empty when the level has none.
    companionStops~ Array<CompanionStop> = [];
    // Slice 2: pieces that only exist while a light reaches them, lanterns to pick up, and thorns.
    glowPlatforms~ Array<GlowPlatform> = [];
    // Slice 3: swing arcs between two posts.
    anchors~ Array<Anchor> = [];
    // Slice 4: where the level ends, and what comes next.
    goals~ Array<Goal> = [];
    lanterns~ Array<LanternPickup> = [];
    thorns~ Array<Thorns> = [];
    // The prototype rooms' pieces (docs/gameplay-prototypes.md): the partner who works beside you and her
    // beats, plates, levers and crystals, the gates they open, and signs.
    hasPartner~ bool = false;
    partnerStart~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    // The partner's route, sorted by each beat's `order`. Empty when the level has none.
    teamBeats~ Array<TeamBeat> = [];
    switches~ Array<Switch> = [];
    gates~ Array<Gate> = [];
    signs~ Array<Sign> = [];
    watchers~ Array<Watcher> = [];
    bouncePads~ Array<BouncePad> = [];
    crumbles~ Array<CrumblePlatform> = [];
    // What placed Silhouettes do: one behaviour for each placed copy of a Silhouette that has a graph
    // (silhouette-behaviour.nyx).
    behaviours~ Array<SilhouetteBehaviour> = [];
    // The grounded adventure prototypes (docs/gameplay-prototypes.md): the surfaces only the player can climb, the words
    // and phrases to collect, the stalls to eat at, and which platforms are trains. `isGroundedFeel` is the spawn's
    // `movement` property being "grounded".
    climbSurfaces~ Array<ClimbSurface> = [];
    wordTokens~ Array<WordToken> = [];
    foodStalls~ Array<FoodStall> = [];
    trains~ Array<MovingPlatform> = [];
    isGroundedFeel~ bool = false;
    // The Finding Her search's crowd, vantage spots, hiding places and memories (docs/finding-her.md). The game fills it with
    // `site.Load` once the level is loaded; a level with none of those kinds leaves it empty.
    site~ SearchSite = new SearchSite();
    // Which chapter's look the level wears (ChapterLooks): the spawn's `chapter` property, 0 if none.
    chapter~ i32 = 0;
    // The spawn's `ambience` property (which sounds the level lives in, see game-systems/audio-director.nyx) and `surface`
    // property (what the ground is, see game-systems/footstep-system.nyx); "" for none.
    ambience~ string = "";
    surface~ string = "";
    // Play in editor from the editor's viewpoint: the editor adds a `play_start` marker to the level it hands the game
    // (see PlaceAtPlayStart). `hasPlayStart` is true when the level had one, whether or not the ground was found under it;
    // `playStartYaw` is the heading to face and `playStartCompanionStop` the stop on the companion's route nearest to it,
    // both left at 0 when there was no ground.
    hasPlayStart~ bool = false;
    playStartYaw~ f32 = 0.0f;
    playStartCompanionStop~ i32 = 0;
    playStartBeat~ i32 = 0;
    // From the `player_start` the level began at (ApplyPlayerStart): whether the player starts carrying the lantern, and which
    // start it was ("" when the level used its `spawn`).
    startsWithLantern~ bool = false;
    hasPlayerStart~ bool = false;
    startLabel~ string = "";

    // Returns the number of entities the file made.
    Load~: (path: string, gemMesh: i64, cubeMesh: i64) -> i32 {
        Unload();
        loaded := lantern:::world:::Load(path);
        guard loaded throw;
        // The partner's graph (companion.Spawn, partner.Spawn) is built from every floor of the level, so a level with rooms
        // has them all made here. The game starts streaming, and takes the far ones away again, once the graph exists.
        if lantern:::world:::RoomCount() > 0 {
            lantern:::world:::LoadAllRooms();
        }
        // One of each is expected; if the file has more, the last one wins.
        for spawn: i64 in lantern:::world:::FindByKind("spawn") {
            spawnPosition = lantern:::world:::Position(spawn);
            chapter = lantern:::world:::HasProperty(spawn, "chapter") ? i32(lantern:::world:::NumberProperty(spawn, "chapter")) : 0;
            ambience = lantern:::world:::HasProperty(spawn, "ambience") ? lantern:::world:::TextProperty(spawn, "ambience") : "";
            surface = lantern:::world:::HasProperty(spawn, "surface") ? lantern:::world:::TextProperty(spawn, "surface") : "";
            isGroundedFeel = lantern:::world:::HasProperty(spawn, "movement") && lantern:::world:::TextProperty(spawn, "movement") == "grounded";
        }
        // Only the kill plane's height matters: falling below it anywhere counts.
        for killPlane: i64 in lantern:::world:::FindByKind("kill_plane") {
            killHeight = lantern:::world:::Position(killPlane).y;
        }
        // Each gem gets a number in file order, which Gem uses to offset its bob.
        index~ i32 = 0;
        for entity: i64 in lantern:::world:::FindByKind("gem") {
            lantern:::world:::SetMesh(entity, gemMesh, "FFFFFF");
            gem~ Gem = new Gem(entity, index);
            gem.Glow(LightingSettings:::GEM_GLOW);
            gems.add(gem);
            index++;
        }
        for entity: i64 in lantern:::world:::FindByKind("moving_platform") {
            platform~ MovingPlatform = new MovingPlatform(entity);
            platforms.add(platform);
            if lantern:::world:::HasProperty(entity, "train") {
                trains.add(platform);
            }
        }
        for entity: i64 in lantern:::world:::FindByKind("checkpoint") {
            checkpoint~ Checkpoint = new Checkpoint(entity);
            checkpoint.Place(cubeMesh);
            checkpoints.add(checkpoint);
        }
        for entity: i64 in lantern:::world:::FindByKind("companion_stop") {
            companionStops.add(new CompanionStop(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("goal") {
            goal~ Goal = new Goal(entity);
            goal.Place(cubeMesh);
            goals.add(goal);
        }
        for entity: i64 in lantern:::world:::FindByKind("swing_arc") {
            anchor~ Anchor = new Anchor(entity);
            if !anchor.isValid {
                lantern:::engine:::Log(`swing_arc (entity ${entity:d}) needs an "end" property at least half a metre from its start along the ground: skipped`);
                continue;
            }
            anchor.Place(cubeMesh);
            anchors.add(anchor);
        }
        for entity: i64 in lantern:::world:::FindByKind("glow_platform") {
            glowPlatform~ GlowPlatform = new GlowPlatform(entity);
            glowPlatform.Hide();
            glowPlatforms.add(glowPlatform);
        }
        for entity: i64 in lantern:::world:::FindByKind("lantern") {
            lantern:::world:::SetTint(entity, LANTERN_TINT);
            lanterns.add(new LanternPickup(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("thorns") {
            patch~ Thorns = new Thorns(entity);
            patch.Grow(chapter);
            thorns.add(patch);
        }
        for entity: i64 in lantern:::world:::FindByKind("partner_start") {
            hasPartner = true;
            partnerStart = lantern:::world:::Position(entity);
        }
        for entity: i64 in lantern:::world:::FindByKind("team_beat") {
            beat~ TeamBeat = new TeamBeat(entity);
            beat.Place(cubeMesh);
            teamBeats.add(beat);
        }
        for kind: string in ["plate", "lever", "crystal"] {
            for entity: i64 in lantern:::world:::FindByKind(kind) {
                piece~ Switch = new Switch(entity);
                piece.Place(cubeMesh, gemMesh);
                switches.add(piece);
            }
        }
        for entity: i64 in lantern:::world:::FindByKind("gate") {
            gate~ Gate = new Gate(entity);
            gate.Start();
            gates.add(gate);
        }
        for entity: i64 in lantern:::world:::FindByKind("sign") {
            signs.add(new Sign(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("climb_surface") {
            surface~ ClimbSurface = new ClimbSurface(entity);
            surface.Place();
            climbSurfaces.add(surface);
        }
        wordIndex~ i32 = 0;
        for entity: i64 in lantern:::world:::FindByKind("word_token") {
            token~ WordToken = new WordToken(entity, wordIndex);
            lantern:::world:::SetMesh(entity, gemMesh, "FFFFFF");
            token.Glow();
            wordTokens.add(token);
            wordIndex++;
        }
        for entity: i64 in lantern:::world:::FindByKind("food_stall") {
            stall~ FoodStall = new FoodStall(entity);
            stall.Place(cubeMesh);
            foodStalls.add(stall);
        }
        for entity: i64 in lantern:::world:::FindByKind("watcher") {
            watchers.add(new Watcher(entity));
        }
        for entity: i64 in lantern:::world:::FindByKind("bounce_pad") {
            pad~ BouncePad = new BouncePad(entity);
            pad.Place();
            bouncePads.add(pad);
        }
        for entity: i64 in lantern:::world:::FindByKind("crumble") {
            crumbles.add(new CrumblePlatform(entity));
        }
        // A placed Silhouette remembers which Silhouette it came from in its `silhouette` property. When that Silhouette
        // has a graph, the placed copy gets a behaviour of its own, and its BeginPlay runs once the whole level is in.
        for entity: i64 in lantern:::world:::FindByProperty("silhouette") {
            if behaviour ~= GraphBehaviours:::Create(lantern:::world:::TextProperty(entity, "silhouette"), entity) {
                behaviours.add(behaviour);
            }
        }
        // The file lists the stops in any order; the route follows their `order` property.
        companionStops = companionStops.sort((first, second) -> first.order < second.order);
        teamBeats = teamBeats.sort((first, second) -> first.order < second.order);
        requestedStart := lantern:::engine:::Setting("LANTERN_START");
        ApplyPlayerStart(requestedStart);
        if requestedStart != "" {
            hasPlayStart = true;
        }
        for entity: i64 in lantern:::world:::FindByKind("play_start") {
            PlaceAtPlayStart(entity);
        }
        for behaviour~ SilhouetteBehaviour in behaviours {
            behaviour.BeginPlay();
        }
        lantern:::engine:::Log(`level ${path}: ${gems.length():d} gems, ${platforms.length():d} moving platforms`);
        return loaded;
    }

    // The world editor's Play button saves the open level with one extra `play_start` entity where the editor is looking
    // from (the camera's position, or the selected entity) and a `yaw` property, so the person lands in the part of the
    // level they are working on instead of at the start. This moves everything that begins at the level's spawn to that
    // point: the player (and so a restart and a respawn, which return to `spawnPosition`), the partner beside them and
    // the route companion at her nearest stop. The point is dropped to the ground below it first. When there is no ground
    // below (the camera is outside the level), the level starts where it normally does.
    PlaceAtPlayStart~: (entity: i64) -> void {
        hasPlayStart = true;
        if lantern:::world:::HasProperty(entity, "start") {
            ApplyPlayerStart(lantern:::world:::TextProperty(entity, "start"));
            return;
        }
        wanted: lantern:::math:::Vec3 = lantern:::world:::Position(entity);
        standing := GroundBelow(wanted);
        if standing == null {
            lantern:::engine:::Log("play in editor: no ground under the editor's viewpoint, starting at the level's spawn");
            return;
        }
        feet: lantern:::math:::Vec3 = standing ?? wanted;
        playStartYaw = lantern:::world:::HasProperty(entity, "yaw") ? f32(lantern:::world:::NumberProperty(entity, "yaw")) : 0.0f;
        spawnPosition = feet;
        if hasPartner {
            beside: lantern:::math:::Vec3 = lantern:::math:::Vec3:::FromYaw(playStartYaw - PLAY_START_QUARTER_TURN);
            partnerSpot: lantern:::math:::Vec3 = { x: feet.x + beside.x * PLAY_START_PARTNER_DISTANCE, y: feet.y, z: feet.z + beside.z * PLAY_START_PARTNER_DISTANCE };
            partnerGround := GroundBelow(partnerSpot);
            partnerStart = partnerGround ?? feet;
        }
        playStartCompanionStop = NearestCompanionStop(feet);
        playStartBeat = NearestTeamBeat(feet);
    }

    // Authored starts. A level can hold any number of `player_start` entities. Each says where the player begins (its
    // position, and the way it faces: the entity's rotation about Y) and, in properties, what spawns there:
    // - `label` (text): the name to pick it by, such as "gate" or "rooftop".
    // - `order` (number): of the ordinary starts the lowest `order` is the level's start, 0 when missing.
    // - `debug` (number, 1 for yes): a debug start is never the level's start; it is used only when asked for by label with
    //   LANTERN_START=<label>, or by pressing Play in the editor with it selected.
    // - `spawns` (text, comma separated, default "player,partner,companion"): who is made. Leaving "partner" or "companion" out
    //   removes her from the level, which is how to test a section solo.
    // - `give_lantern` (number, 1 for yes): the player starts carrying the lantern.
    // - `beat` (number, default the beat nearest the start): the team beat the partner starts at.
    // `requestedLabel` picks one by label; "" picks the level's ordinary start. A level with no matching start keeps its
    // `spawn`. Nothing is dropped to the ground: an authored start is where the author put it.
    ApplyPlayerStart~: (requestedLabel: string) -> void {
        chosen~ i64 = 0;
        isChosen~ bool = false;
        chosenOrder~ f32 = 0.0f;
        for entity: i64 in lantern:::world:::FindByKind("player_start") {
            label := lantern:::world:::HasProperty(entity, "label") ? lantern:::world:::TextProperty(entity, "label") : "";
            if requestedLabel != "" {
                if label == requestedLabel && !isChosen {
                    chosen = entity;
                    isChosen = true;
                }
            } else if !(lantern:::world:::HasProperty(entity, "debug") && lantern:::world:::NumberProperty(entity, "debug") > 0.5f) {
                order := lantern:::world:::HasProperty(entity, "order") ? lantern:::world:::NumberProperty(entity, "order") : 0.0f;
                if !isChosen || order < chosenOrder {
                    chosen = entity;
                    isChosen = true;
                    chosenOrder = order;
                }
            }
        }
        if !isChosen {
            if requestedLabel != "" {
                lantern:::engine:::Log(`no player_start labelled '${requestedLabel}': starting at the level's spawn`);
            }
            return;
        }
        feet: lantern:::math:::Vec3 = lantern:::world:::Position(chosen);
        hasPlayerStart = true;
        spawnPosition = feet;
        playStartYaw = lantern:::world:::Yaw(chosen);
        startLabel = lantern:::world:::HasProperty(chosen, "label") ? lantern:::world:::TextProperty(chosen, "label") : "";
        spawns := lantern:::world:::HasProperty(chosen, "spawns") ? lantern:::world:::TextProperty(chosen, "spawns") : "player,partner,companion";
        if !SpawnsInclude(spawns, "partner") {
            hasPartner = false;
        }
        if !SpawnsInclude(spawns, "companion") {
            companionStops = [];
        }
        startsWithLantern = lantern:::world:::HasProperty(chosen, "give_lantern") && lantern:::world:::NumberProperty(chosen, "give_lantern") > 0.5f;
        if hasPartner {
            beside: lantern:::math:::Vec3 = lantern:::math:::Vec3:::FromYaw(playStartYaw - PLAY_START_QUARTER_TURN);
            partnerSpot: lantern:::math:::Vec3 = { x: feet.x + beside.x * PLAY_START_PARTNER_DISTANCE, y: feet.y, z: feet.z + beside.z * PLAY_START_PARTNER_DISTANCE };
            partnerGround := GroundBelow(partnerSpot);
            partnerStart = partnerGround ?? feet;
        }
        playStartCompanionStop = NearestCompanionStop(feet);
        playStartBeat = lantern:::world:::HasProperty(chosen, "beat") ? i32(lantern:::world:::NumberProperty(chosen, "beat")) : NearestTeamBeat(feet);
    }

    // True when the comma separated list `spawns` names `who`.
    SpawnsInclude :: (spawns: string, who: string) -> bool {
        for part in spawns.split(",") {
            if part.trim() == who {
                return true;
            }
        }
        return false;
    }

    // The point on the ground straight below `above` (found by a ray from a little higher up, so a point resting on
    // a surface still finds it), lifted a hair so a capsule does not start touching the floor. Null when nothing
    // is below it.
    GroundBelow :: (above: lantern:::math:::Vec3) -> lantern:::math:::Vec3? {
        origin: lantern:::math:::Vec3 = { x: above.x, y: above.y + PLAY_START_RAY_LIFT, z: above.z };
        down: lantern:::math:::Vec3 = { y: -1.0f };
        return when lantern:::physics:::Raycast(origin, down, PLAY_START_SEARCH_DISTANCE) {
            hit: lantern:::physics:::RayHit -> StandingOn(hit.Point()),
            null -> null
        };
    }

    StandingOn :: (floorPoint: lantern:::math:::Vec3) -> lantern:::math:::Vec3 {
        landing: lantern:::math:::Vec3 = { x: floorPoint.x, y: floorPoint.y + PLAY_START_FLOOR_LIFT, z: floorPoint.z };
        return landing;
    }

    // Which team beat (after sorting by order) is closest to `position`, the one the partner works toward first when the
    // level starts partway through; 0 when there are none.
    NearestTeamBeat :: (position: lantern:::math:::Vec3) -> i32 {
        nearest~ i32 = 0;
        nearestDistance~ f32 = 1000000.0f;
        index~ i32 = 0;
        for beat: TeamBeat in teamBeats {
            offsetX := beat.position.x - position.x;
            offsetY := beat.position.y - position.y;
            offsetZ := beat.position.z - position.z;
            distance := offsetX * offsetX + offsetY * offsetY + offsetZ * offsetZ;
            if distance < nearestDistance {
                nearestDistance = distance;
                nearest = index;
            }
            index++;
        }
        return nearest;
    }

    // Which stop on the companion's route (after sorting by order) is closest to `position`; 0 when she has none.
    NearestCompanionStop :: (position: lantern:::math:::Vec3) -> i32 {
        nearest~ i32 = 0;
        nearestDistance~ f32 = 1000000.0f;
        index~ i32 = 0;
        for stop: CompanionStop in companionStops {
            offsetX := stop.position.x - position.x;
            offsetY := stop.position.y - position.y;
            offsetZ := stop.position.z - position.z;
            distance := offsetX * offsetX + offsetY * offsetY + offsetZ * offsetZ;
            if distance < nearestDistance {
                nearestDistance = distance;
                nearest = index;
            }
            index++;
        }
        return nearest;
    }

    Unload~: () -> void {
        lantern:::world:::Clear();
        hasPlayStart = false;
        playStartYaw = 0.0f;
        playStartCompanionStop = 0;
        playStartBeat = 0;
        startsWithLantern = false;
        hasPlayerStart = false;
        startLabel = "";
        gems = [];
        platforms = [];
        checkpoints = [];
        companionStops = [];
        glowPlatforms = [];
        anchors = [];
        goals = [];
        lanterns = [];
        thorns = [];
        hasPartner = false;
        teamBeats = [];
        switches = [];
        gates = [];
        signs = [];
        for watcher~ Watcher in watchers {
            watcher.TurnOff();
        }
        watchers = [];
        bouncePads = [];
        crumbles = [];
        behaviours = [];
        climbSurfaces = [];
        wordTokens = [];
        foodStalls = [];
        trains = [];
        isGroundedFeel = false;
        site = new SearchSite();
        chapter = 0;
        ambience = "";
        surface = "";
    }

private:
    static LANTERN_TINT :: "FFD27A";
    static PLAY_START_RAY_LIFT :: 0.5f;            // metres above the point the ray starts
    static PLAY_START_SEARCH_DISTANCE :: 200.0f;   // metres the ray looks down
    static PLAY_START_FLOOR_LIFT :: 0.05f;         // metres above the floor the player starts
    static PLAY_START_PARTNER_DISTANCE :: 1.5f;    // metres to the player's right the partner starts
    static PLAY_START_QUARTER_TURN :: 1.5707964f;  // radians
}
