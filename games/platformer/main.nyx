AdventureTuning :: import AdventureTuning;
AudioDirector :: import AudioDirector;
FootstepSystem :: import FootstepSystem;
AnchorSystem :: import AnchorSystem;
ClimbOutcome :: import ClimbOutcome;
ClimbSystem :: import ClimbSystem;
MantleSystem :: import MantleSystem;
MinigameSystem :: import MinigameSystem;
TrainSystem :: import TrainSystem;
Autopilot :: import Autopilot;
BoostSystem :: import BoostSystem;
BouncePad :: import BouncePad;
CrumblePlatform :: import CrumblePlatform;
CheckpointSystem :: import CheckpointSystem;
CollisionView :: import CollisionView;
ChapterLooks :: import ChapterLooks;
Dust :: import Dust;
Math :: import standard:::Math;
Companion :: import Companion;
GameAssets :: import GameAssets;
GameEvent :: import GameEvent;
GameEvents :: import GameEvents;
GameRules :: import GameRules;
GameState :: import GameState;
GameUiModel :: import GameUiModel;
GemSystem :: import GemSystem;
GlowSystem :: import GlowSystem;
GoalSystem :: import GoalSystem;
GuideLight :: import GuideLight;
InputSettings :: import InputSettings;
LanternSystem :: import LanternSystem;
LevelLighting :: import LevelLighting;
LevelScene :: import LevelScene;
MenuChoice :: import MenuChoice;
MovingPlatform :: import MovingPlatform;
NightLights :: import NightLights;
PhotoMode :: import PhotoMode;
Player :: import Player;
Partner :: import Partner;
NavigationDynamics :: import NavigationDynamics;
PartnerTuning :: import PartnerTuning;
StreamingSettings :: import StreamingSettings;
PlayerTuning :: import PlayerTuning;
StreetsAutopilot :: import StreetsAutopilot;
SwitchSystem :: import SwitchSystem;
ThornSystem :: import ThornSystem;
Watcher :: import Watcher;
CameraDirector :: import CameraDirector;
ThirdPersonCamera :: import ThirdPersonCamera;

// The Lantern platformer. The engine calls the hooks below; everything
// the game does starts here. Per fixed step: platforms move, the player moves through the
// collision world, then the step's events go to the rules in the order they happened.
//
// How this file meets the engine (docs/game-api.md is the whole seam):
// - game.json names this file as `entry` and `Platformer` as `application_class`. The engine
//   makes one Platformer and calls its hooks; the game never calls the engine's loop itself.
// - Every name with `:::` that isn't imported above (World, Input, Physics, Camera, Audio, ...)
//   is a host type the engine registers in engine/src/host/ (see docs/game-api.md).
//
// The two clocks. A game has to answer two different questions every frame:
// - "What happens next in the world?" That is the simulation, and it must not depend on how fast
//   the computer draws. If it advanced by however long the last frame took, a 30 fps machine
//   would take bigger physics steps than a 144 fps one, jumps would reach different heights and
//   fast objects could pass through walls. So the engine runs OnFixedUpdate with a constant
//   dt = 1/60 s, as many times per display frame as real time needs (0, 1, 2, ... up to 8, after
//   which it drops the backlog rather than freezing). Same inputs + same dt = same result.
// - "What does the player see now?" That is OnUpdate and OnRender, once per display frame, with
//   `frameSeconds` = the real time since the previous frame. Menus, camera look and on-screen
//   timers live here because they should respond at the display's rate.
//
// A display frame therefore looks like: OnFixedUpdate x N, OnUpdate, OnRender.
Platformer :: class : Application {
public:
    // What the UI shows and what its buttons chose (ui/game-ui-model.nyx). Public because the UI
    // reads it: the engine passes this Platformer to ui/game-screen.chaos, which reads `game.ui`.
    ui~ GameUiModel = new GameUiModel();

    // Required by `Application`; the engine drives the game through the hooks instead.
    Run :: () -> void { }

    // Once, after the engine has loaded the scripts. Order matters: input actions and assets
    // must exist before the level is loaded, because the level assigns meshes and materials.
    OnStart~: () -> void {
        InputSettings:::Configure();
        assets.Load();
        lantern:::renderer:::SetClearColor("87B5E0");
        // Linear fog toward the clear (sky) colour: none up to 30 m from the camera, all sky by
        // 90 m, and fog = (distance - 30) / (90 - 30) in between. It hides where the world
        // ends and makes far things read as far.
        lantern:::renderer:::SetFog(30.0f, 90.0f);
        isAutoplay = lantern:::engine:::Flag("LANTERN_AUTOPLAY");
        showCollisionView = lantern:::engine:::Flag("LANTERN_COLLISION_VIEW");
        StartLevel();
        // The UI is Chaos components styled by Cosmos, in ui/. The engine draws it every frame
        // after OnRender and moves focus between its buttons with these three actions.
        lantern:::ui:::SetNavigation(InputSettings:::MENU_UP, InputSettings:::MENU_DOWN, InputSettings:::MENU_CONFIRM);
        uiMount = lantern:::ui:::Mount("ui/game-screen.chaos", "GameScreen");
        if level.hasPlayStart {
            SetState(GameState:::Playing);
        }
    }

    // Every fixed step, with `dt` always 1/60 s. Only the Playing state simulates, so pausing
    // and the title screen freeze the world exactly where it is.
    OnFixedUpdate~: (dt: f32) -> void {
        when state <GameState> {
            Playing -> { Simulate(dt); },
            (MainMenu || Paused)
        }
    }

    // Once per display frame, before rendering. `frameSeconds` is real elapsed time, so
    // anything here that changes over time multiplies a per-second rate by it (see Orbit).
    OnUpdate~: (frameSeconds: f32) -> void {
        if lantern:::input:::IsPressed(InputSettings:::TOGGLE_COLLISION_VIEW) {
            showCollisionView = !showCollisionView;
        }
        // A button the player chose this frame: the engine runs the UI's handlers just before
        // OnUpdate, and they only record the choice.
        HandleMenuChoice(ui.TakeChoice());
        when state <GameState> {
            MainMenu -> {
                // radians per second x seconds this frame = radians to turn this frame. The
                // title-screen orbit turns at the same speed whatever the frame rate.
                camera.Orbit(MAIN_MENU_ORBIT_SPEED * frameSeconds);
                if isAutoplay {
                    SetState(GameState:::Playing);
                }
            },
            Playing -> { UpdatePlaying(frameSeconds); },
            Paused -> {
                if lantern:::input:::IsPressed(InputSettings:::PAUSE) {
                    SetState(GameState:::Playing);
                }
            }
        }
        // What the HUD shows. The model only passes on real changes, so this doesn't re-render
        // the HUD every frame.
        ui.SetStatus(state == GameState:::MainMenu ? "" : `${rules.statusText}${minigames.StatusSuffix(level.wordTokens.length(), level.foodStalls.length())}${photoMode.StatusSuffix()}`);
        ui.SetAlbum(rules.isLevelComplete ? photoMode.AlbumText() : "");
        photoMode.Publish(ui);
        ui.SetMessage(rules.IsShowingMessage() ? rules.message : "");
        ui.SetHint(rules.IsShowingMessage() ? "" : HintText());
        ui.SetDebugHudOn(lantern:::debug:::IsHudVisible());
        PublishDebugValues();
    }

    // Once per drawn frame. `alpha` (0..1) says how far real time has got between the last two
    // fixed steps. The simulation only knows positions at step boundaries (60 per second), but
    // the screen may draw 144 times a second; drawing the last step's position would make
    // motion stutter. The engine draws entities blended `alpha` of the way from the previous
    // step's position to the current one, and the camera has to follow that same blended
    // position, or the player would jitter against the background.
    OnRender~: (alpha: f32, frameSeconds: f32) -> void {
        // With the camera raised for a photo, the lens is at the player's eyes instead of behind them.
        if photoMode.isActive {
            photoMode.PlaceCamera(lantern:::world:::InterpolatedPosition(player.root, alpha), companion.position, companion.stops.length() > 0, director, frameSeconds);
        } else {
            // The director places the follow camera, or the authored shot a camera volume asks for, and blends between them.
            // Behind the title screen there are no volumes: the camera only orbits.
            director.Frame(lantern:::world:::InterpolatedPosition(player.root, alpha), frameSeconds, camera, state != GameState:::MainMenu);
        }
        UpdateAudio(frameSeconds);
        // The drawn lights follow their carriers' blended positions, like the camera does. The
        // reveal rule keeps reading the fixed-step positions (UpdateGlows).
        if companionGlow.isOn {
            glowCarrier := partner.isPresent ? partner.root : companion.root;
            companionGlow.ShowAt(lantern:::world:::InterpolatedPosition(glowCarrier, alpha) + GlowHeight());
        }
        lanternGlow.ShowAt(lantern:::world:::InterpolatedPosition(player.root, alpha) + GlowHeight());
        player.DrawBlobShadow();
        if showCollisionView {
            CollisionView:::Draw(player.controller, level.gems);
        }
        // The menus and the HUD aren't drawn here: they are Chaos components the engine draws
        // after this hook (see OnStart and ui/).
    }

    // Before the engine unloads the game, on quit or on F5. The engine releases everything the
    // game made anyway; this stops the music cleanly and empties the level.
    OnExit~: () -> void {
        lantern:::audio:::StopAllLayers(0.0f);
        level.Unload();
    }

private:
    static LEVEL_PATH :: "worlds/course.world.json";

    // The level the menu picked, else the world editor's Play button's level, else the course.
    // The editor's Play button sets LANTERN_LEVEL to the level being edited.
    LevelPath:: () -> string {
        guard pickedLevelPath == "" return pickedLevelPath;
        levelFromSetting := lantern:::engine:::Setting("LANTERN_LEVEL");
        return levelFromSetting == "" ? LEVEL_PATH : levelFromSetting;
    }
    static STREETS_PATH :: "worlds/streets.world.json";
    static COMPLETE_SECONDS :: 4.0f;     // how long the completion message shows before the next level loads
    static PROTOTYPE_HOLD_THE_DOOR_PATH :: "worlds/prototypes/hold-the-door.world.json";
    static PROTOTYPE_NARROW_WAY_PATH :: "worlds/prototypes/the-narrow-way.world.json";
    static GOAL_HINT_DISTANCE :: 4.0f;      // metres: how near a goal the player must be to be told what is missing
    static PROTOTYPE_LIGHT_GATE_PATH :: "worlds/prototypes/light-gate.world.json";
    static PROTOTYPE_HAND_OFF_PATH :: "worlds/prototypes/hand-off.world.json";
    static PROTOTYPE_WATCHER_PATH :: "worlds/prototypes/the-watcher.world.json";
    static CROSSING_PATH :: "worlds/the-crossing.world.json";
    static PROTOTYPE_CLIMB_PATH :: "worlds/prototypes/the-climb.world.json";
    static PROTOTYPE_WORD_MARKET_PATH :: "worlds/prototypes/word-market.world.json";
    static STATION_PATH :: "worlds/the-station.world.json";
    static PROTOTYPE_CAMERA_ROOM_PATH :: "worlds/prototypes/the-camera-room.world.json";
    static PROTOTYPE_LIFT_PATH :: "worlds/prototypes/the-lift.world.json";
    static PROTOTYPE_FLOW_PATH :: "worlds/prototypes/flow-and-fragile.world.json";
    static ROOFTOPS_PATH :: "worlds/rooftops.world.json";
    static STREETS_LATER_PATH :: "worlds/streets-later.world.json";
    // The Guide Light: warm and wide from the companion, cooler and smaller from the lantern the
    // player carries. `range` is how far the light is drawn, `reveal` how far it makes hidden
    // platforms solid (the two differ so a platform appears just before the glow reaches it).
    static COMPANION_GLOW_COLOR :: "FFC27A";
    static COMPANION_GLOW_REVEAL :: 8.0f;
    static LANTERN_GLOW_COLOR :: "9CC4FF";
    static LANTERN_GLOW_REVEAL :: 5.0f;
    static GLOW_RANGE :: 11.0f;
    static GLOW_HEIGHT :: 2.4f;           // metres above the carrier's feet
    // A fall or a thorn sends the player back to the last place they stood safely.
    static SAFE_SPOT_MARGIN :: 1.6f;      // metres from any thorn that still counts as safe
    static MAIN_MENU_ORBIT_SPEED :: 0.15f;    // radians per second behind the title screen

    // The game's modules, one object each, one per folder (assets, scenes, entities, systems,
    // rules, events). Platformer owns them and passes them to each other, so no module reaches
    // for another on its own.
    assets~ GameAssets = new GameAssets();
    level~ LevelScene = new LevelScene();
    levelLighting~ LevelLighting = new LevelLighting();
    player~ Player = new Player();
    camera~ ThirdPersonCamera = new ThirdPersonCamera();
    director~ CameraDirector = new CameraDirector();
    gemSystem~ GemSystem = new GemSystem();
    anchorSystem~ AnchorSystem = new AnchorSystem();
    goalSystem~ GoalSystem = new GoalSystem();
    // How long the level has been complete, in simulation seconds (see Simulate).
    completeSeconds~ f32 = 0.0f;
    glowSystem~ GlowSystem = new GlowSystem();
    lanternSystem~ LanternSystem = new LanternSystem();
    thornSystem~ ThornSystem = new ThornSystem();
    // What the game sounds like: the ambience, the music layers and the listener (game-systems/audio-director.nyx), and
    // every walker's footsteps (game-systems/footstep-system.nyx). docs/audio.md explains both.
    audioDirector~ AudioDirector = new AudioDirector();
    footsteps~ FootstepSystem = new FootstepSystem();
    // Night: the small lights on lamps, posts and the goal. Photo mode: the second collectable.
    nightLights~ NightLights = new NightLights();
    photoMode~ PhotoMode = new PhotoMode();
    companionGlow~ GuideLight = new GuideLight();
    lanternGlow~ GuideLight = new GuideLight();
    checkpointSystem~ CheckpointSystem = new CheckpointSystem();
    companion~ Companion = new Companion();
    // The companion who works beside you (game-entities/partner.nyx), in the prototype rooms. A level has
    // either her or the route-following companion above, depending on its markers.
    partner~ Partner = new Partner();
    // What moves in the level, as the partner's navigation graph sees it (game-systems/navigation-dynamics.nyx).
    navigationDynamics~ NavigationDynamics = new NavigationDynamics();
    switchSystem~ SwitchSystem = new SwitchSystem();
    // The grounded adventure prototypes (docs/gameplay-prototypes.md): the player's climbing, the word and food
    // minigames, and the danger on a train's track. `seenClimbRestartCount` is the rules' restart count when the
    // minigames were last put back, so a restart (R) resets them too.
    climbSystem~ ClimbSystem = new ClimbSystem();
    mantleSystem~ MantleSystem = new MantleSystem();
    minigames~ MinigameSystem = new MinigameSystem();
    trainSystem~ TrainSystem = new TrainSystem();
    seenClimbRestartCount~ i32 = 0;
    // The rules' restart count the last time the partner was put back, so a restart (R) can bring her too.
    seenRestartCount~ i32 = 0;
    // True from a bounce pad launch until the next landing, so the jump is held through the whole rise.
    isLaunchAirborne~ bool = false;
    rules~ GameRules = new GameRules();
    events~ GameEvents = new GameEvents();
    state~ GameState = GameState:::MainMenu;
    // The simulation's own clock: the sum of every fixed step's dt. Anything animated from time
    // (platforms, gems, the autopilot) reads this rather than wall-clock time, so it pauses with
    // the game and plays out identically on every run.
    simulationSeconds~ f32 = 0.0f;
    // "" until the main menu's "The streets" button picks a level.
    pickedLevelPath~ string = "";
    // The mounted UI, kept so the title screen can start it afresh when it swaps its button lists:
    // a fresh mount puts focus back on the first button.
    uiMount~ i32 = 0;
    isAutoplay~ bool = false;
    showCollisionView~ bool = false;

    // Loads the level and puts every module back to its starting state. Used on start, on
    // "Restart level" and on going back to the main menu.
    StartLevel~: () -> void {
        // The sun, the ambient light and this level's lamps, replacing the last level's:
        // see settings/lighting-settings.nyx and game-systems/level-lighting.nyx.
        levelLighting.Apply(LevelPath());
        loaded := level.Load(LevelPath(), assets.gemMesh, assets.unitCubeMesh);
        guard loaded throw;
        // The level says which chapter it is, and the chapter sets the sky, fog and sun.
        ChapterLooks:::Apply(level.chapter);
        footsteps.Start(level.surface, level.chapter);
        audioDirector.Start(level.ambience, level.chapter, level.foodStalls);
        nightLights.Apply(level, assets.unitCubeMesh);
        photoMode.Start(assets.unitCubeMesh);
        director.Start();
        player.Spawn(assets, level.spawnPosition);
        // A level can ask for the grounded feel with its spawn's `movement` property (settings/adventure-tuning.nyx).
        player.UseGroundedFeel(level.isGroundedFeel);
        climbSystem.Release();
        mantleSystem.Release();
        minigames.Start(level.wordTokens, level.foodStalls);
        companion.Spawn(level.companionStops, level.anchors, assets.mannequinRig, assets.playerTexture);
        if level.hasPartner {
            partner.Spawn(level.partnerStart, assets.mannequinRig, assets.playerTexture, level.teamBeats);
            partner.BeginAtBeat(level.playStartBeat);
            navigationDynamics.Register(level.gates, level.crumbles, level.platforms);
            partner.UseNavigationDynamics(navigationDynamics);
        } else {
            partner.isPresent = false;
        }
        for watcher~ Watcher in level.watchers {
            watcher.TurnOn(assets.unitCubeMesh);
        }
        UpdateStreaming();
        gemSystem.Clear();
        events.Drain();                       // throw away anything queued by the old level
        simulationSeconds = 0.0f;
        completeSeconds = 0.0f;
        camera.ResetBehind(level.playStartYaw);
        rules.Start(level);
        if level.hasPlayStart || level.hasPlayerStart {
            rules.respawnCompanionStop = level.playStartCompanionStop;
            companion.SendToStop(level.playStartCompanionStop);
            player.FaceYaw(level.playStartYaw);
        }
        if level.startsWithLantern {
            rules.isCarryingLantern = true;
        }
        seenRestartCount = rules.restartCount;
        seenClimbRestartCount = rules.restartCount;
        // Lights live in the engine until removed, so the last level's glows are turned off
        // here and this level's companion glow starts at her first stop.
        anchorSystem.Cancel();
        companionGlow.TurnOff();
        lanternGlow.TurnOff();
        if level.glowPlatforms.length() > 0 {
            companionGlow.TurnOn(companion.position + GlowHeight(), COMPANION_GLOW_COLOR, GLOW_RANGE, COMPANION_GLOW_REVEAL);
        } else if level.hasPartner {
            companionGlow.TurnOn(partner.position + GlowHeight(), COMPANION_GLOW_COLOR, GLOW_RANGE, COMPANION_GLOW_REVEAL);
            companionGlow.EnableShadows();
        }
    }

    // Once per drawn frame, after the camera is placed: the listener is where the camera is, and the music and ambience follow
    // what is happening (game-systems/audio-director.nyx). The title screen has no danger and no company.
    UpdateAudio~: (frameSeconds: f32) -> void {
        shown := director.Shown();
        isMenu := state == GameState:::MainMenu;
        hasCompanion := !isMenu && (partner.isPresent || level.companionStops.length() > 0);
        companionAt := partner.isPresent ? partner.position : companion.position;
        isOnDanger := !isMenu && trainSystem.IsOnTrack(level.trains, player.FeetPosition());
        audioDirector.Frame(frameSeconds, isMenu, state == GameState:::Paused, shown.eye, shown.Forward(), player.controller.CapsuleCenter(), level.watchers, isOnDanger, hasCompanion, companionAt);
    }

    // One fixed step of footsteps for everyone who walks. Anyone climbing, swinging, mantling or in the air isn't stepping.
    UpdateFootsteps~: (dt: f32) -> void {
        isWalking := player.controller.IsGrounded() && !anchorSystem.isSwinging && !climbSystem.isClimbing && !mantleSystem.isMantling;
        footsteps.StepPlayer(player.FeetPosition(), isWalking, dt);
        if partner.isPresent {
            footsteps.StepPartner(partner.position, partner.controller.IsGrounded(), dt);
        }
        if level.companionStops.length() > 0 {
            footsteps.StepCompanion(companion.position, dt);
        }
    }

    GlowHeight :: () -> lantern:::math:::Vec3 {
        lift: lantern:::math:::Vec3 = { y: GLOW_HEIGHT };
        return lift;
    }

    SetState~: (next: GameState) -> void {
        if next == GameState:::Paused {
            lantern:::audio:::PlayOn("ui_select", "ui", 0.8f, 0.9f);
        } else if state == GameState:::Paused && next == GameState:::Playing {
            lantern:::audio:::PlayOn("ui_back", "ui", 0.8f, 1.0f);
        }
        state = next;
        ui.Show(next);
        // The mouse is captured (hidden, and its motion turned into camera look) only while
        // playing; menus need a free cursor. The autopilot never captures it.
        isPlaying := when next <GameState> { Playing -> true, default -> false };
        lantern:::screen:::SetMouseCaptured(isPlaying && !isAutoplay);
    }

    // One fixed step of the game. The order is what makes it correct:
    // 1. Platforms move first, so the character controller can carry a player standing on one
    //    by exactly this step's platform motion.
    // 2. The player moves through the collision world, now that the world is where it will be.
    // 3. Systems look at the result and queue events (touched a gem, fell off).
    // 4. The rules handle the events in the order they happened.
    // 5. Gems animate. Touch tests this step used the previous step's gem positions, a 1/60 s
    //    difference nobody can see.
    Simulate~: (dt: f32) -> void {
        simulationSeconds += dt;
        // A restart (R, or the pause menu) lets go of anything held and puts the words and meals back.
        if rules.restartCount != seenClimbRestartCount {
            seenClimbRestartCount = rules.restartCount;
            climbSystem.Release();
        mantleSystem.Release();
            minigames.Start(level.wordTokens, level.foodStalls);
        }
        for platform: MovingPlatform in level.platforms {
            platform.Move(simulationSeconds);
        }

        // Input is read per fixed step, not per frame: the engine latches presses so each one is
        // seen by exactly one fixed step, even on a frame that runs none.
        // The autopilot has one script per level: the course's runs forward and jumps, the
        // streets' plays the level through (StreetsAutopilot).
        isStreets := LevelPath() == STREETS_PATH || LevelPath() == STREETS_LATER_PATH;
        stick~ lantern:::math:::Vec2 = lantern:::input:::Vector(InputSettings:::MOVE);
        jumpPressed~ bool = lantern:::input:::IsPressed(InputSettings:::JUMP);
        jumpHeld~ bool = lantern:::input:::IsHeld(InputSettings:::JUMP);
        if isAutoplay && isStreets {
            stick = StreetsAutopilot:::Stick(simulationSeconds);
            jumpPressed = StreetsAutopilot:::JumpPressed(simulationSeconds);
            jumpHeld = StreetsAutopilot:::JumpHeld(simulationSeconds);
        } else if isAutoplay {
            stick = Autopilot:::Stick();
            jumpPressed = Autopilot:::JumpPressed(simulationSeconds);
            jumpHeld = Autopilot:::JumpHeld(simulationSeconds);
        }
        // With the camera raised the player stands still: photo mode leaves the world running, but the
        // keys that move and jump mean nothing until it is lowered.
        if photoMode.isActive {
            stick = lantern:::math:::Vec2:::Zero();
            jumpPressed = false;
            jumpHeld = false;
        }
        // The Anchor (game-systems/anchor-system.nyx): a jump beside a start post swings the player
        // along its arc, and while it does the controller isn't asked to move them at all.
        // The caps on the start posts glow when a jump here would swing.
        feetBefore := player.FeetPosition();
        isGroundedBefore := player.controller.IsGrounded();
        anchorSystem.ShowReady(level.anchors, feetBefore, isGroundedBefore, companion.position);
        // Climbing (game-systems/climb-system.nyx): F beside a ladder, pipe or ledge grabs it, unless a lever is
        // what F means here. While holding on the controller isn't asked to move the player at all.
        if !isAutoplay && !photoMode.isActive && !anchorSystem.isSwinging && !climbSystem.isClimbing && !switchSystem.IsLeverNear(level.switches, feetBefore, PartnerTuning:::LEVER_REACH) {
            if climbSystem.TryGrab(level.climbSurfaces, feetBefore, lantern:::input:::IsPressed(InputSettings:::USE), PlayerTuning:::RADIUS) {
                lantern:::audio:::Play("land", 0.3f);
            }
        }
        if anchorSystem.TryStart(level.anchors, feetBefore, isGroundedBefore, companion.position, jumpPressed) {
            events.Push(GameEvent:::PlayerSwingStarted);
        }
        if anchorSystem.isSwinging {
            swingYaw := anchorSystem.Yaw(level.anchors);
            player.SwingTo(anchorSystem.Advance(level.anchors, dt), swingYaw);
            companion.Update(player.FeetPosition(), false, dt);
            if !anchorSystem.isSwinging {
                Dust:::Puff(player.FeetPosition(), 8, 1.0f, 0.2f);
                events.Push(GameEvent:::PlayerSwingLanded);
            }
        } else if climbSystem.isClimbing {
            StepClimb(stick, jumpPressed, dt);
        } else if mantleSystem.isMantling || TryStartMantle(stick) {
            StepMantle(dt);
        } else {
            MovePlayer(stick, jumpPressed, jumpHeld, dt);
        }
        controller := player.controller;
        UpdatePuzzle(dt);
        UpdateStreaming();
        UpdateCrumbles(dt);
        UpdateScripted();
        UpdateAdventure(stick, dt);
        UpdateFootsteps(dt);
        gemSystem.DetectTouches(level.gems, controller.CapsuleCenter(), controller.HalfSegment(), controller.Radius(), events);
        checkpointSystem.DetectReached(level.checkpoints, controller.CapsuleCenter(), controller.HalfSegment(), controller.Radius(), events);
        goalSystem.DetectReached(level.goals, controller.CapsuleCenter(), controller.HalfSegment(), controller.Radius(), IsTeamTogether(), events);
        lanternSystem.DetectTaken(level.lanterns, controller.CapsuleCenter(), controller.HalfSegment(), controller.Radius(), events);
        thornSystem.DetectTouches(level.thorns, controller.CapsuleCenter(), controller.HalfSegment(), controller.Radius(), events);
        if controller.IsGrounded() && !anchorSystem.isSwinging && !glowSystem.IsStandingOnAny(level.glowPlatforms, player.FeetPosition()) && !thornSystem.IsNearAny(level.thorns, controller.CapsuleCenter(), controller.HalfSegment(), controller.Radius(), SAFE_SPOT_MARGIN) && !trainSystem.IsOnTrack(level.trains, player.FeetPosition()) && !climbSystem.isClimbing {
            rules.NoteSafeSpot(player.FeetPosition());
        }
        // The kill plane is just a height: once the feet drop below it, the player has fallen
        // off the course.
        if player.FeetPosition().y < level.killHeight {
            events.Push(GameEvent:::PlayerFell);
        }
        if !isAutoplay && lantern:::input:::IsPressed(InputSettings:::RESET) {
            events.Push(GameEvent:::ResetPressed);
        }
        for event: GameEvent in events.Drain() {
            rules.Handle(event, level, player, camera, companion);
        }
        UpdateGlows(dt);
        nightLights.Update(level);
        for goal in level.goals {
            goal.Animate(simulationSeconds);
        }
        // A completed level waits a few seconds so the message can be read, then moves on.
        if rules.isLevelComplete {
            completeSeconds += dt;
            if completeSeconds >= COMPLETE_SECONDS {
                AdvanceLevel();
            }
        }
        gemSystem.Animate(level.gems, simulationSeconds);
        for word in level.wordTokens {
            word.Animate(simulationSeconds);
        }
    }

    // A jump that ends against a ledge hauls the player up onto it (game-systems/mantle-system.nyx). The way they push
    // is the stick turned to the world by the camera, as Player.Move does; the engine says whether a ledge is there.
    TryStartMantle~: (stick: lantern:::math:::Vec2) -> bool {
        guard !isAutoplay && !photoMode.isActive && !isLaunchAirborne return false;
        pushed := director.Forward() * stick.y + director.Right() * stick.x;
        guard player.CanMantleToward(pushed) return false;
        mantleSystem.Start(player.FeetPosition(), player.LedgeStandPoint(), pushed.Yaw());
        lantern:::audio:::Play("jump", 0.3f);
        return true;
    }

    // One step of a haul: the system says where the feet are and the player is put there, as for a climb.
    StepMantle~: (dt: f32) -> void {
        finished := mantleSystem.Advance(dt);
        player.SwingTo(mantleSystem.feet, mantleSystem.yaw);
        companion.Update(player.FeetPosition(), false, dt);
        if finished {
            Dust:::Puff(player.FeetPosition(), 8, 1.0f, 0.2f);
            lantern:::audio:::Play("land", 0.4f);
        }
    }

    // One step of holding a surface: the climb system says where the feet are, and the player is put there. The
    // companion's update still runs, because she goes on following (on the ground) while the player climbs.
    StepClimb~: (stick: lantern:::math:::Vec2, jumpPressed: bool, dt: f32) -> void {
        outcome := climbSystem.Advance(level.climbSurfaces, stick, jumpPressed, PlayerTuning:::RADIUS, dt);
        player.SwingTo(climbSystem.feet, climbSystem.yaw);
        companion.Update(player.FeetPosition(), false, dt);
        if outcome == ClimbOutcome:::MountedTop {
            Dust:::Puff(player.FeetPosition(), 8, 1.0f, 0.2f);
            lantern:::audio:::Play("land", 0.5f);
        } else if outcome == ClimbOutcome:::LetGo {
            lantern:::audio:::Play("jump", 0.3f);
        }
    }

    // The words, the meals and the trains of a grounded adventure level, after the player has moved. Eating asks for
    // the use key held while the stick rests, and the line each one produces goes up as a message.
    UpdateAdventure~: (stick: lantern:::math:::Vec2, dt: f32) -> void {
        controller := player.controller;
        isUseHeld := !isAutoplay && !photoMode.isActive && lantern:::input:::IsHeld(InputSettings:::USE);
        minigames.Update(level.wordTokens, level.foodStalls, controller.CapsuleCenter(), controller.HalfSegment(), controller.Radius(), player.FeetPosition(), isUseHeld, stick.Length() < 0.1f && !climbSystem.isClimbing, dt);
        noted := minigames.TakeNote();
        if noted != "" {
            rules.Announce(noted, AdventureTuning:::WORD_SHOW_SECONDS);
        }
        trainSystem.DetectHits(level.trains, player.FeetPosition(), simulationSeconds, events);
    }

    // Each light follows whoever carries it, then the glow system shows or hides the
    // platforms the lights reach.
    // The ordinary step of the player: the controller moves them, and a jump becomes an event. The
    // companion's crouch makes the next jump a boost (BoostSystem), when the player is standing on
    // her spot and presses jump this step. The camera's forward and right let "push up" mean "away
    // from the camera", wherever it is looking (Player.Move does the conversion).
    MovePlayer~: (stick: lantern:::math:::Vec2, jumpPressed: bool, jumpHeld: bool, dt: f32) -> void {
        isGrounded := player.controller.IsGrounded();
        partnerBoost := BoostSystem:::IsReady(partner.IsOfferingBoost(), partner.position, player.FeetPosition(), isGrounded);
        boostReady := partnerBoost || BoostSystem:::IsReady(companion.IsOfferingBoost(), companion.position, player.FeetPosition(), isGrounded);
        // A bounce pad launches by itself: standing on one while grounded is a jump, held to its full height.
        bounceHeight := BounceHeightUnderPlayer();
        launchHeight := boostReady ? PlayerTuning:::BOOST_JUMP_HEIGHT : bounceHeight;
        isLaunching := bounceHeight > 0.0f && !boostReady;
        director.UpdateMovementBasis(stick.Length(), camera);
        step := player.Move(stick, director.Forward(), director.Right(), jumpPressed || isLaunching, jumpHeld || isLaunching || isLaunchAirborne, launchHeight, dt);
        if isLaunching {
            isLaunchAirborne = true;
        } else if step.Landed() {
            isLaunchAirborne = false;
        }
        companion.Update(player.FeetPosition(), player.controller.IsGrounded(), dt);
        // A boosted jump is its own event with its own sound, so it isn't also a plain jump.
        if step.Jumped() {
            Dust:::Puff(player.FeetPosition(), 6, 1.2f, 0.0f);
            events.Push(boostReady ? GameEvent:::PlayerBoosted : GameEvent:::PlayerJumped);
        }
        if step.Landed() {
            Dust:::Puff(player.FeetPosition(), 10, Math:::min(step.LandingSpeed() * 0.2f, 3.0f) + 0.8f, 0.3f);
            events.Push(GameEvent:::PlayerLanded(step.LandingSpeed()));
        }
    }

    // Streams the level's rooms: the player, the partner and the companion are the points rooms are kept alive around
    // (settings/streaming-settings.nyx). Does nothing in a level with no rooms.
    UpdateStreaming~: () -> void {
        if lantern:::world:::RoomCount() == 0 {
            return;
        }
        lantern:::world:::AddStreamFocus(player.FeetPosition());
        lantern:::world:::AddStreamFocus(companion.position);
        if partner.isPresent {
            lantern:::world:::AddStreamFocus(partner.position);
        }
        lantern:::world:::StreamRooms(StreamingSettings:::LOAD_DISTANCE, StreamingSettings:::UNLOAD_DISTANCE, StreamingSettings:::URGENT_DISTANCE, StreamingSettings:::ENTITIES_PER_STEP);
    }

    // The prototype rooms' step: the player's own use key, the partner's beats and walking, then plates, levers,
    // crystals and gates, then the watchers. Everything here needs the player to have moved already.
    UpdatePuzzle~: (dt: f32) -> void {
        if !isAutoplay {
            HandleUse();
        }
        activeChannels := ActiveChannels();
        if partner.isPresent {
            navigationDynamics.Update();
            partner.RememberTrail(player.FeetPosition(), player.controller.IsGrounded());
            partner.Update(player.FeetPosition(), player.controller.IsGrounded(), activeChannels, dt);
            if partner.TakePullRequest() {
                switchSystem.TryPull(level.switches, partner.position, PartnerTuning:::PARTNER_LEVER_REACH);
            }
            said := partner.TakeNote();
            if said != "" {
                rules.Announce(said, 2.0f);
            }
            if rules.restartCount != seenRestartCount {
                seenRestartCount = rules.restartCount;
                partner.Reset(level.partnerStart);
                companionGlow.MoveTo(partner.position + GlowHeight());
            }
        }
        carriers~ Array<lantern:::math:::Vec3> = [player.FeetPosition()];
        if partner.isPresent {
            carriers.add(partner.position);
        }
        if level.companionStops.length() > 0 {
            carriers.add(companion.position);
        }
        lights: Array<GuideLight> = [companionGlow, lanternGlow];
        switchSystem.Update(level.switches, level.gates, carriers, lights, dt);
        lureLift: lantern:::math:::Vec3 = { y: 0.9f };
        for watcher~ Watcher in level.watchers {
            if watcher.Update(simulationSeconds, player.controller.CapsuleCenter(), partner.position + lureLift, partner.IsLuring(), dt) {
                events.Push(GameEvent:::PlayerSeen);
            }
        }
    }

    // The switch channels that are on right now: some of her beats wait for one, as when you pull a lever for her.
    ActiveChannels :: () -> Array<i32> {
        channels~ Array<i32> = [];
        for each in level.switches {
            if each.isOn {
                channels.add(each.channel);
            }
        }
        return channels;
    }

    // F is the player's own use key: it pulls a lever you stand beside. She has no key, because she is not told what to do.
    HandleUse~: () -> void {
        guard lantern:::input:::IsPressed(InputSettings:::USE);
        if switchSystem.TryPull(level.switches, player.FeetPosition(), PartnerTuning:::LEVER_REACH) {
            lantern:::audio:::Play("pickup", 0.6f);
        }
    }

    // A level only completes with her beside the player, so the goal asks this. A level with no companion at all has no one to wait for.
    IsTeamTogether :: () -> bool {
        feet := player.FeetPosition();
        if partner.isPresent {
            return IsBeside(partner.position, feet);
        }
        if level.companionStops.length() > 0 {
            return IsBeside(companion.position, feet);
        }
        return true;
    }

    // Close along the ground, and on much the same level.
    IsBeside :: (teammate: lantern:::math:::Vec3, feet: lantern:::math:::Vec3) -> bool {
        along := (teammate - feet).Horizontal().Length();
        return along < PartnerTuning:::TOGETHER_DISTANCE && teammate.y - feet.y < PartnerTuning:::TOGETHER_HEIGHT && feet.y - teammate.y < PartnerTuning:::TOGETHER_HEIGHT;
    }

    // The player is at a goal, close enough that it would count if she were here.
    IsPlayerAtAGoal :: () -> bool {
        for goal in level.goals {
            if !goal.isReached && (lantern:::world:::Position(goal.entity) - player.FeetPosition()).Horizontal().Length() < GOAL_HINT_DISTANCE {
                return true;
            }
        }
        return false;
    }

    // The line under the status: the nearest sign, else what F would do right now, else what is missing at the goal.
    HintText :: () -> string {
        guard state == GameState:::Playing return "";
        feet := player.FeetPosition();
        sign := switchSystem.SignText(level.signs, feet);
        if sign != "" {
            return sign;
        }
        if switchSystem.IsLeverNear(level.switches, feet, PartnerTuning:::LEVER_REACH) {
            return "F: pull the lever";
        }
        if climbSystem.isClimbing {
            return "W / S: climb   A / D: shimmy on pipes   Space: let go";
        }
        if climbSystem.NearestGrabbable(level.climbSurfaces, feet) >= 0 {
            return "F: climb";
        }
        if IsPlayerAtAGoal() && !IsTeamTogether() {
            if partner.isPresent && partner.IsWorkingOnABeat() {
                return "The way is not finished: she is waiting for you";
            }
            return "Wait for her. The level counts when you finish it together";
        }
        return minigames.HintFor(level.foodStalls, feet);
    }

    // The apex of the pad the player is standing on, or 0.
    BounceHeightUnderPlayer :: () -> f32 {
        guard player.controller.IsGrounded() return 0.0f;
        for pad: BouncePad in level.bouncePads {
            if pad.IsOn(player.FeetPosition()) {
                return pad.height;
            }
        }
        return 0.0f;
    }

    // Entities whose behaviour is a graph (game-graphs/) run it each step.
    UpdateScripted~: () -> void {
        for behaviour in level.scripted {
            behaviour.Run(simulationSeconds);
        }
    }

    // Crumbling platforms shiver under whoever stands on them.
    UpdateCrumbles~: (dt: f32) -> void {
        for platform~ CrumblePlatform in level.crumbles {
            isStoodOn := platform.IsStoodOnBy(player.FeetPosition()) || (partner.isPresent && platform.IsStoodOnBy(partner.position));
            platform.Update(isStoodOn, simulationSeconds, dt);
        }
    }

    UpdateGlows~: (dt: f32) -> void {
        // The rules mark the lantern taken; its light starts the step after, in the player's hand.
        if rules.isCarryingLantern && !lanternGlow.isOn {
            lanternGlow.TurnOn(player.FeetPosition() + GlowHeight(), LANTERN_GLOW_COLOR, GLOW_RANGE * 0.6f, LANTERN_GLOW_REVEAL);
        }
        carrierPosition := partner.isPresent ? partner.position : companion.position;
        companionGlow.MoveTo(carrierPosition + GlowHeight());
        lanternGlow.MoveTo(player.FeetPosition() + GlowHeight());
        lights: Array<GuideLight> = [companionGlow, lanternGlow];
        glowSystem.Update(level.glowPlatforms, lights, dt);
        for pickup in level.lanterns {
            pickup.Animate(simulationSeconds);
        }
    }

    UpdatePlaying~: (frameSeconds: f32) -> void {
        rules.Tick(frameSeconds);
        photoMode.HandleInput(frameSeconds, camera, player);
        if lantern:::input:::IsPressed(InputSettings:::PAUSE) {
            photoMode.Leave(camera, player);
            SetState(GameState:::Paused);
            return;
        }
        if lantern:::input:::IsPressed(InputSettings:::CAPTURE_MOUSE) {
            lantern:::screen:::SetMouseCaptured(true);
        }
        // Mouse and stick need different maths because they report different things:
        // - The mouse reports how far it moved this frame, which is already an amount of turn
        //   (InputSettings scales it to radians). Multiplying it by frameSeconds would make the
        //   camera turn slower at higher frame rates.
        // - The stick reports how far it is pushed (-1..1), which is a speed. Turning a speed
        //   into this frame's turn needs `x frameSeconds`, and LOOK_STICK_SPEED says how many
        //   radians per second a full push is.
        // Once both are "radians this frame" they can simply be added.
        stickLook := lantern:::input:::Vector(InputSettings:::LOOK_STICK) * (frameSeconds * PlayerTuning:::LOOK_STICK_SPEED);
        if !photoMode.isActive && !director.IsShotShowing() {
            camera.Look(lantern:::input:::Vector(InputSettings:::LOOK_MOUSE) + stickLook);
        }
    }

    // The goal's level is done: play the level it names, or go back to the main menu when it names
    // none. Playing the same level again starts it over.
    AdvanceLevel~: () -> void {
        next := rules.nextLevel;
        if next == "" {
            StartLevel();
            SetState(GameState:::MainMenu);
        } else {
            pickedLevelPath = next;
            StartLevel();
            SetState(GameState:::Playing);
        }
    }

    // Starts the level at `path` ("" is the course, or the editor's level) from the main menu.
    // The title screen's level is loaded already, so choosing the same one again just resumes.
    PlayLevel~: (path: string) -> void {
        if path != pickedLevelPath {
            pickedLevelPath = path;
            StartLevel();
        }
        SetState(GameState:::Playing);
    }

    RemountUi~: () -> void {
        lantern:::ui:::Unmount(uiMount);
        uiMount = lantern:::ui:::Mount("ui/game-screen.chaos", "GameScreen");
    }

    // Acts on a menu button (ui/main-menu.chaos, ui/pause-menu.chaos). The menus only record
    // what was chosen; the state machine stays here.
    HandleMenuChoice~: (choice: MenuChoice) -> void {
        when choice <MenuChoice> {
            Play -> { PlayLevel(""); },
            PlayStreets -> { PlayLevel(STREETS_PATH); },
            PlayRooftops -> { PlayLevel(ROOFTOPS_PATH); },
            OpenPrototypes -> {
                ui.SetPrototypesOpen(true);
                RemountUi();
            },
            ClosePrototypes -> {
                ui.SetPrototypesOpen(false);
                RemountUi();
            },
            PlayHoldTheDoor -> { PlayLevel(PROTOTYPE_HOLD_THE_DOOR_PATH); },
            PlayTheNarrowWay -> { PlayLevel(PROTOTYPE_NARROW_WAY_PATH); },
            PlayLightGate -> { PlayLevel(PROTOTYPE_LIGHT_GATE_PATH); },
            PlayHandOff -> { PlayLevel(PROTOTYPE_HAND_OFF_PATH); },
            PlayTheWatcher -> { PlayLevel(PROTOTYPE_WATCHER_PATH); },
            PlayFlowAndFragile -> { PlayLevel(PROTOTYPE_FLOW_PATH); },
            PlayTheCrossing -> { PlayLevel(CROSSING_PATH); },
            PlayTheClimb -> { PlayLevel(PROTOTYPE_CLIMB_PATH); },
            PlayWordMarket -> { PlayLevel(PROTOTYPE_WORD_MARKET_PATH); },
            PlayTheStation -> { PlayLevel(STATION_PATH); },
            PlayTheCameraRoom -> { PlayLevel(PROTOTYPE_CAMERA_ROOM_PATH); },
            PlayTheLift -> { PlayLevel(PROTOTYPE_LIFT_PATH); },
            PlayStreetsLater -> { PlayLevel(STREETS_LATER_PATH); },
            Resume -> { SetState(GameState:::Playing); },
            Restart -> {
                StartLevel();
                SetState(GameState:::Playing);
            },
            ToggleDebugHud -> { lantern:::debug:::SetHudVisible(!lantern:::debug:::IsHudVisible()); },
            MainMenu -> {
                ui.SetPrototypesOpen(false);
                StartLevel();
                SetState(GameState:::MainMenu);
            },
            Quit -> { lantern:::engine:::Quit(); },
            Nothing
        }
    }

    // Lines for the engine's debug HUD (F1). The path before `/` is the group it's shown under.
    PublishDebugValues :: () -> void {
        controller := player.controller;
        feet := controller.FeetPosition();
        velocity := controller.Velocity();
        lantern:::debug:::SetValue("Player/Position", `${feet.x:.2f}, ${feet.y:.2f}, ${feet.z:.2f}`);
        // Horizontal() drops the y part, so this is running speed; falling doesn't count.
        lantern:::debug:::SetValue("Player/Speed", `${velocity.Horizontal().Length():.2f}`);
        lantern:::debug:::SetValue("Player/Grounded", controller.IsGrounded() ? "yes" : "no");
        lantern:::debug:::SetValue("Camera/Yaw", `${lantern:::angle:::ToDegrees(camera.yaw):.1f}`);
        lantern:::debug:::SetValue("Camera/Pitch", `${lantern:::angle:::ToDegrees(camera.pitch):.1f}`);
        lantern:::debug:::SetValue("Camera/Mode", director.ModeName());
        lantern:::debug:::SetValue("Camera/Volume", `${director.ActiveVolumeIndex():d}`);
        lantern:::debug:::SetValue("Camera/Blending", director.IsBlending() ? "yes" : "no");
        lantern:::debug:::SetValue("Camera/Shoulder", `${director.Settings().shoulder * camera.ShoulderSide():.2f}`);
        lantern:::debug:::SetValue("Camera/Distance", `${director.Settings().distance:.2f}`);
        lantern:::debug:::SetValue("Camera/FieldOfView", `${director.Shown().fieldOfViewDegrees:.1f}`);
        shownEye := director.Shown().eye;
        lantern:::debug:::SetValue("Camera/Eye", `${shownEye.x:.2f}, ${shownEye.y:.2f}, ${shownEye.z:.2f}`);
        lantern:::debug:::SetValue("Audio/Ambience", audioDirector.AmbienceText());
        lantern:::debug:::SetValue("Audio/Theme", `${audioDirector.MusicLevel(0):.2f}`);
        lantern:::debug:::SetValue("Audio/Calm", `${audioDirector.MusicLevel(1):.2f}`);
        lantern:::debug:::SetValue("Audio/Tension", `${audioDirector.MusicLevel(2):.2f}`);
        lantern:::debug:::SetValue("Audio/Companion", `${audioDirector.MusicLevel(3):.2f}`);
        lantern:::debug:::SetValue("Audio/Surface", footsteps.lastSurface);
        lantern:::debug:::SetValue("Audio/Footsteps", `${footsteps.stepCount:d}`);
        lantern:::debug:::SetValue("Game/Gems", `${rules.collected:d} / ${level.gems.length():d}`);
        respawn := rules.respawnPosition;
        lantern:::debug:::SetValue("Game/Respawn", `${respawn.x:.2f}, ${respawn.y:.2f}, ${respawn.z:.2f}`);
        companionAt := companion.position;
        lantern:::debug:::SetValue("Companion/Position", `${companionAt.x:.2f}, ${companionAt.y:.2f}, ${companionAt.z:.2f}`);
        lantern:::debug:::SetValue("Anchor/Ready", anchorSystem.IsAnyReady(level.anchors, feet, controller.IsGrounded(), companion.position) ? "yes" : "no");
        lantern:::debug:::SetValue("Anchor/Swinging", anchorSystem.isSwinging ? "yes" : "no");
        lantern:::debug:::SetValue("Game/Complete", rules.isLevelComplete ? "yes" : "no");
        lantern:::debug:::SetValue("Game/Level", LevelPath());
        platformNumber~ i32 = 0;
        for platform: MovingPlatform in level.platforms {
            lantern:::debug:::SetValue(`Platform/${platformNumber:d}`, `${platform.PositionAt(simulationSeconds).z:.2f}`);
            platformNumber++;
        }
        lantern:::debug:::SetValue("Companion/Stop", `${companion.stopIndex:d}`);
        lantern:::debug:::SetValue("Companion/Mode", companion.ModeName());
        lantern:::debug:::SetValue("Companion/Offering boost", companion.IsOfferingBoost() ? "yes" : "no");
        shownPlatforms~ i32 = 0;
        for platform in level.glowPlatforms {
            if platform.isShown {
                shownPlatforms++;
            }
        }
        lantern:::debug:::SetValue("Glow/Platforms shown", `${shownPlatforms:d}`);
        lantern:::debug:::SetValue("Glow/Carrying lantern", rules.isCarryingLantern ? "yes" : "no");
        lantern:::debug:::SetValue("Game/Time", `${simulationSeconds:.1f}`);
        lantern:::debug:::SetValue("Game/Start", level.startLabel);
        if lantern:::world:::RoomCount() > 0 {
            lantern:::debug:::SetValue("Streaming/Rooms", `${lantern:::world:::LoadedRoomCount():d} of ${lantern:::world:::RoomCount():d} loaded`);
            lantern:::debug:::SetValue("Streaming/Entities", `${lantern:::world:::LiveEntityCount():d}`);
            lantern:::debug:::SetValue("Streaming/Collision triangles", `${lantern:::world:::CollisionTriangleCount():d}`);
        }
        if partner.isPresent {
            lantern:::debug:::SetValue("Partner/Mode", partner.ModeName());
            lantern:::debug:::SetValue("Partner/Navigation", partner.NavigationSummary());
            lantern:::debug:::SetValue("Partner/Beat", `${partner.beatIndex:d}`);
            lantern:::debug:::SetValue("Team/Together", IsTeamTogether() ? "yes" : "no");
            lantern:::debug:::SetValue("Partner/Position", `${partner.position.x:.2f}, ${partner.position.y:.2f}, ${partner.position.z:.2f}`);
        }
        lantern:::debug:::SetValue("Glow/Companion light", companionGlow.isOn ? `${companionGlow.position.x:.1f}, ${companionGlow.position.y:.1f}, ${companionGlow.position.z:.1f}` : "off");
        lantern:::debug:::SetValue("Game/Message", rules.IsShowingMessage() ? rules.message : "");
        watcherNumber~ i32 = 0;
        for watcher in level.watchers {
            lantern:::debug:::SetValue(`Watcher/${watcherNumber:d}`, watcher.isLured ? "lured" : "sweeping");
            watcherNumber++;
        }
        // Gates by channel and kind (a stair's pieces all report one value), channels by number.
        for gate in level.gates {
            lantern:::debug:::SetValue(`Gate/${gate.channel:d}/${gate.isDoor ? "door" : "bridge"}`, gate.offset < 0.05f ? "solid" : "away");
        }
        switchNumber~ i32 = 0;
        for piece in level.switches {
            lantern:::debug:::SetValue(`Switch/${switchNumber:d}`, `${piece.kind} ${piece.isOn ? "on" : "off"} ${piece.remainingSeconds:.1f}`);
            switchNumber++;
        }
        crumbleNumber~ i32 = 0;
        for slab in level.crumbles {
            lantern:::debug:::SetValue(`Crumble/${crumbleNumber:d}`, slab.phase == 0 ? "solid" : (slab.phase == 1 ? "shivering" : "gone"));
            crumbleNumber++;
        }
        lantern:::debug:::SetValue("Scripted/Count", `${level.scripted.length():d}`);
        for channel~ i32 = 1; channel <= 4; channel++ {
            lantern:::debug:::SetValue(`Channel/${channel:d}`, switchSystem.IsChannelOn(level.switches, channel) ? "on" : "off");
        }
        lantern:::debug:::SetValue("Climb/Holding", climbSystem.isClimbing ? "yes" : "no");
        lantern:::debug:::SetValue("Climb/Height", `${climbSystem.height:.2f}`);
        lantern:::debug:::SetValue("Mantle/Active", mantleSystem.isMantling ? "yes" : "no");
        lantern:::debug:::SetValue("Minigames/Words", `${minigames.wordsFound:d} / ${level.wordTokens.length():d}`);
        lantern:::debug:::SetValue("Minigames/Meals", `${minigames.mealsFinished:d} / ${level.foodStalls.length():d}`);
        lantern:::debug:::SetValue("Player/Feel", level.isGroundedFeel ? "grounded" : "platformer");
        lantern:::debug:::SetValue("Photo/Camera raised", photoMode.isActive ? "yes" : "no");
        lantern:::debug:::SetValue("Photo/Verdict", photoMode.VerdictName());
        lantern:::debug:::SetValue("Photo/Photos", `${photoMode.takenCount:d} / ${photoMode.sights.length():d}`);
    }
}
