Math :: import standard:::Math;

// The test every pickup-like thing shares: does a vertical capsule (the player) overlap a sphere
// round a point? (GemSystem does the same thing inline; new triggers use this.)
//
// A capsule is every point within `capsuleRadius` of its axis, a vertical line segment running
// from `capsuleCenter - halfSegment` to `capsuleCenter + halfSegment` in y. So the two overlap
// when the point is closer to that segment than the two radii added together. The closest point
// on a vertical segment has the capsule's own x and z, and the point's height squeezed (clamped)
// into the segment's range.
TriggerTest :: namespace {
    Overlaps :: (point: lantern:::math:::Vec3, pointRadius: f32, capsuleCenter: lantern:::math:::Vec3, halfSegment: f32, capsuleRadius: f32) -> bool {
        axisY := Math:::clamp(point.y, capsuleCenter.y - halfSegment, capsuleCenter.y + halfSegment);
        closestOnAxis := capsuleCenter.WithY(axisY);
        return closestOnAxis.DistanceTo(point) < pointRadius + capsuleRadius;
    }
}
