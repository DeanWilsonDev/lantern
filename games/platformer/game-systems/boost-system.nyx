PlayerTuning :: import PlayerTuning;

// The Boost, the first of the three abilities: the companion crouches and the player jumps off
// her back to reach a ledge no normal jump can. The same ledge height is reachable alone by
// stacking crates in the level; teaching that first and this second is the point of the streets
// level (docs/crimson-and-thorn-slice.md).
//
// This file only answers "may the player boost right now?". The boost itself is a taller jump
// (Player.Move) and what it means (the companion walks on) is a rule (GameRules).
BoostSystem :: namespace {
    // The player may boost when all three hold:
    // - she is crouched and offering it (a boost stop she has arrived at, boost still unused);
    // - the player is close to her along the ground, within BOOST_REACH;
    // - the player is standing on the ground at her height. Measuring the height difference
    //   stops a player on a high ledge above her from being boosted through the floor.
    IsReady :: (isOffering: bool, companionPosition: lantern:::math:::Vec3, playerFeet: lantern:::math:::Vec3, isPlayerGrounded: bool) -> bool {
        guard isOffering return false;
        guard isPlayerGrounded return false;
        alongGround := (playerFeet - companionPosition).Horizontal().Length();
        height := playerFeet.y - companionPosition.y;
        return alongGround < PlayerTuning:::BOOST_REACH && height > -0.3f && height < 0.6f;
    }
}
