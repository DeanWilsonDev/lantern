GameEvent :: import GameEvent;
GameEvents :: import GameEvents;
LanternPickup :: import LanternPickup;
TriggerTest :: import TriggerTest;

// Finds the lantern the player has just reached. A reported fact, like every system's: GameRules
// decides that taking it lights the lantern.
LanternSystem :: class {
public:
    static TRIGGER_RADIUS :: 0.7f;    // metres from the lantern's centre to the capsule's surface

    DetectTaken~: (lanterns: Array<LanternPickup>, capsuleCenter: lantern:::math:::Vec3, halfSegment: f32, capsuleRadius: f32, events~ GameEvents) -> void {
        for pickup: LanternPickup in lanterns {
            guard !pickup.IsTaken() continue;
            center := lantern:::world:::Position(pickup.entity);
            if TriggerTest:::Overlaps(center, TRIGGER_RADIUS, capsuleCenter, halfSegment, capsuleRadius) {
                events.Push(GameEvent:::LanternTaken(pickup.entity));
            }
        }
    }
}
