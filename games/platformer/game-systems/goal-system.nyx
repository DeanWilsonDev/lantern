Goal :: import Goal;
GameEvent :: import GameEvent;
GameEvents :: import GameEvents;
TriggerTest :: import TriggerTest;

// Notices the player touching a goal and queues `GoalReached`. Like the checkpoint system it only
// reports; GameRules decides that the level is complete.
GoalSystem :: class {
public:
    static TRIGGER_RADIUS :: 1.3f;    // metres from the goal's centre to the capsule's surface

    DetectReached~: (goals: Array<Goal>, capsuleCenter: lantern:::math:::Vec3, halfSegment: f32, capsuleRadius: f32, events~ GameEvents) -> void {
        for goal: Goal in goals {
            guard !goal.isReached continue;
            lift: lantern:::math:::Vec3 = { y: 1.0f };
            center := lantern:::world:::Position(goal.entity) + lift;
            if TriggerTest:::Overlaps(center, TRIGGER_RADIUS, capsuleCenter, halfSegment, capsuleRadius) {
                events.Push(GameEvent:::GoalReached(goal.entity));
            }
        }
    }
}
