Gem :: import Gem;
GameEvent :: import GameEvent;
GameEvents :: import GameEvents;

// Finds gems the player has just touched. A gem counts once per touch: it must be left before
// it can be touched again.
GemSystem :: class {
public:
    static TRIGGER_RADIUS :: 0.45f;   // metres from the gem's centre to the capsule's surface

    // The capsule's axis runs from `capsuleCenter - halfSegment` to `+ halfSegment` in y.
    DetectTouches~: (gems: Array<Gem>, capsuleCenter: Vec3, halfSegment: f32, capsuleRadius: f32, events~ GameEvents) -> void {
        for gem: Gem in gems {
            center := World:::Position(gem.entity);
            axisY := Math:::clamp(center.Y(), capsuleCenter.Y() - halfSegment, capsuleCenter.Y() + halfSegment);
            closestOnAxis := capsuleCenter.WithY(axisY);
            isInside := closestOnAxis.DistanceTo(center) < TRIGGER_RADIUS + capsuleRadius;
            wasInside := inside.contains(gem.entity);
            if isInside && !wasInside {
                inside.add(gem.entity);
                events.Push(GameEvent:::GemTouched(gem.entity));
            }
            if !isInside && wasInside {
                inside.remove(gem.entity);
            }
        }
    }

    Clear~: () -> void {
        inside = [];
    }

    Animate :: (gems: Array<Gem>, time: f32) -> void {
        for gem: Gem in gems {
            gem.Animate(time);
        }
    }

private:
    inside~ Array<i64> = [];
}
