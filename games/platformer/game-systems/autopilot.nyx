// A scripted pilot for headless smoke runs (`LANTERN_AUTOPLAY=1`): it runs forward, drifting
// right, and jumps every 1.5 s, so the controller, platforms and gems all get exercised.
Autopilot :: namespace {
    JUMP_PERIOD :: 1.5f;
    JUMP_HOLD :: 0.4f;
    STEP :: 0.0167666f;               // one fixed step (1/60 s) plus a little slack

    Stick :: () -> Vec2 {
        return Vec2:::New(0.15f, 1.0f);
    }

    JumpPressed :: (time: f32) -> bool {
        return time > 1.0f && time % JUMP_PERIOD < STEP;
    }

    JumpHeld :: (time: f32) -> bool {
        return time % JUMP_PERIOD < JUMP_HOLD;
    }
}
