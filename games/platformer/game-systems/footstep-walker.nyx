// Where one character's feet are, as the FootstepSystem sees them: where they were last step, how far they have gone
// since the last footfall (`stride`), whether they were on the ground, and which foot comes next. A plain value, so
// the system can hand one in and get the next one back without anybody else holding a half-updated copy.
FootstepWalker :: data {
    hasLast~ bool = false;
    last~ lantern:::math:::Vec3 = { };
    stride~ f32 = 0.0f;
    wasGrounded~ bool = false;
    isRightFoot~ bool = false;
}
