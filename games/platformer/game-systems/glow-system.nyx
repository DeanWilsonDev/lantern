GlowPlatform :: import GlowPlatform;
GuideLight :: import GuideLight;

// Decides which hidden platforms are lit this step. A platform is lit when it is within any
// active guide light's reveal radius. The system tells each platform; the platform decides when
// to appear and vanish (it keeps a short hold so crossings are forgiving).
GlowSystem :: class {
public:
    Update~: (platforms~ Array<GlowPlatform>, lights: Array<GuideLight>, dt: f32) -> void {
        for platform~ GlowPlatform in platforms {
            isLit~ bool = false;
            for light: GuideLight in lights {
                guard light.isOn continue;
                if platform.home.DistanceTo(light.position) < light.revealRadius {
                    isLit = true;
                }
            }
            platform.Update(isLit, dt);
        }
    }

    // True when `feet` are on a glow platform. A safe spot there could be dark by the time the
    // player is sent back to it, so the game doesn't remember one. The plates are 3 m wide, so a
    // spot within PLATE_REACH of a plate's centre, level with its top, is on it.
    IsStandingOnAny :: (platforms: Array<GlowPlatform>, feet: lantern:::math:::Vec3) -> bool {
        for platform: GlowPlatform in platforms {
            offset := feet - platform.home;
            if offset.Horizontal().Length() < PLATE_REACH && offset.y > -0.5f && offset.y < 0.8f {
                return true;
            }
        }
        return false;
    }

private:
    static PLATE_REACH :: 1.7f;       // metres from a plate's centre that still counts as on it
}
