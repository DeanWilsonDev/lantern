GlowPlatform :: import GlowPlatform;
GuideLight :: import GuideLight;

// Decides which hidden platforms are lit this step. A platform is lit when it is within any
// active guide light's reveal radius. The system tells each platform; the platform decides when
// to appear and vanish (it keeps a short hold so crossings are forgiving).
GlowSystem :: class {
public:
    Update~: (platforms~ Array<GlowPlatform>, lights: Array<GuideLight>, dt: f32) -> void {
        for platform~ GlowPlatform in platforms {
            isLit~ bool = false;
            for light: GuideLight in lights {
                guard light.isOn continue;
                if platform.home.DistanceTo(light.position) < light.revealRadius {
                    isLit = true;
                }
            }
            platform.Update(isLit, dt);
        }
    }
}
