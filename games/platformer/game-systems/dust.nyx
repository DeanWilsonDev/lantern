Math :: import standard:::Math;

// The little puffs of dust a landing and a jump kick up. The engine moves and draws the particles
// (lantern::particles, docs/particles.md); this file only decides where they start and which way
// they go. Dust is a ring of grey-brown streaks thrown outward along the ground and a little up,
// pulled back down by gravity as they fade.
Dust :: namespace {
    // `count` streaks spread evenly round `feet`, thrown out at `speed` metres per second. A heavier
    // landing passes a larger `speed` and `count`. The ring turns by `turn` so two puffs don't line
    // up. Each lives about 0.4 s.
    Puff :: (feet: lantern:::math:::Vec3, count: i32, speed: f32, turn: f32) -> void {
        for index~ i32 = 0; index < count; index += 1 {
            angle := turn + Math:::TAU * f32(index) / f32(count);
            at: lantern:::math:::Vec3 = { x: feet.x, y: feet.y + 0.05f, z: feet.z };
            velocity: lantern:::math:::Vec3 = { x: Math:::cos(angle) * speed, y: speed * 0.5f, z: Math:::sin(angle) * speed };
            lantern:::particles:::Emit(at, velocity, "C8B89A", 0.4f, 0.05f, 6.0f);
        }
    }
}
