LightingSettings :: import LightingSettings;

// The lights the current level switched on. Lights stay in the engine until removed, so a game
// that loads more than one level has to take the old level's lamps down before the new level's
// go up, or the lamps from the course would still shine in the streets.
//
// StartLevel calls Apply every time it loads a level: on start, on "Restart level" and on going
// back to the main menu.
LevelLighting :: class {
public:
    // Replaces every lamp with the ones `levelPath` asks for, and sets the sun.
    Apply~: (levelPath: string) -> void {
        Clear();
        LightingSettings:::ConfigureSun();
        for lampPosition in LightingSettings:::LampPositions(levelPath) {
            lampId := lantern:::lights:::AddPoint(lampPosition, LightingSettings:::LAMP_COLOR, LightingSettings:::LAMP_STRENGTH, LightingSettings:::LAMP_RANGE);
            lantern:::lights:::SetShadows(lampId, true);
            lampIds.add(lampId);
        }
    }

    // Removes the lamps this object added. The sun belongs to every level and stays.
    Clear~: () -> void {
        for lampId: i64 in lampIds {
            lantern:::lights:::Remove(lampId);
        }
        lampIds = [];
    }

private:
    lampIds~ Array<i64> = [];
}
