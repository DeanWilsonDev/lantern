Anchor :: import Anchor;
CompanionStop :: import CompanionStop;
Math :: import standard:::Math;
CharacterAnimator :: import CharacterAnimator;

// The companion: a second character who leads the player along the level's route of stops. She
// walks ahead to the next stop, waits there for the player, swings the Anchor first so the player
// can watch how it is done, and crouches so the player can jump off her back (the Boost).
//
// She guides rather than follows:
// - She moves on when the player is near, or already ahead of her (then she hurries to get back in
//   front), so running past her never leaves her behind.
// - If the player drops far behind she stops where she is, turns to face them and hops every few
//   seconds, a wave that says "this way".
// - A stop can hold her until the player has used the boost, and a swing stop sends her across the
//   Anchor before the player.
//
// Her movement is scripted rather than steered: she reads a list of stops, the level's Anchors and the
// player's position, nothing else. That keeps her predictable, which matters when a puzzle depends on
// where she is, and it costs almost no code. She is made of the same pieces as the player: a root at
// her feet and the animated mannequin on it (CharacterAnimator).
Companion :: class {
public:
    root~ i64 = 0;
    stops~ Array<CompanionStop> = [];
    // Index of the stop she is at, or heading to while `isWalking`.
    stopIndex~ i32 = 0;
    isWalking~ bool = false;
    // Set when she arrives at a boost stop and cleared when the player has used the boost; she
    // won't walk on while it's set.
    isHoldingForBoost~ bool = false;
    position~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();

    // Makes her entities. `stopsInOrder` is sorted by the level, and `anchorsInLevel` are the
    // level's swing arcs, which her swing stops use. With no stops there is no companion at all and
    // nothing is drawn.
    Spawn~: (stopsInOrder~ Array<CompanionStop>, anchorsInLevel~ Array<Anchor>, mannequinRig: i64, bodyTexture: i64) -> void {
        stops = stopsInOrder;
        anchors = anchorsInLevel;
        swingAnchorIndexByStop = [];
        for routeStop: CompanionStop in stops {
            swingAnchorIndexByStop.add(routeStop.isSwing ? FindAnchorBeside(routeStop.position) : -1);
        }
        guard stops.length() > 0;
        root = lantern:::world:::Spawn("companion", stops[0].position);
        animation = new CharacterAnimator();
        animation.Create(root, "companion_body", mannequinRig, bodyTexture, "E8506A");
        SendToStop(0);
    }

    // Puts her at stop `index`, waiting there. Used at the start of the level and when the
    // player respawns at a checkpoint.
    SendToStop~: (index: i32) -> void {
        guard stops.length() > 0;
        stopIndex = Math:::clamp(index, 0, stops.length() - 1);
        position = stops[stopIndex].position;
        isWalking = false;
        waitedSeconds = 0.0f;
        isHoldingForBoost = stops[stopIndex].isBoost;
        isBoostJumpInFlight = false;
        isSwinging = false;
        isHoldingAtLanding = false;
        isPausedForPlayer = false;
        nudgeSeconds = 0.0f;
        lantern:::world:::Teleport(root, position);
        animation.Forget();
        animation.LookAt(position, 0.0f);
        ReportToAnimator(0.0f);
    }

    // Called by the rules when the player has jumped off her back. She doesn't stand up and walk on
    // yet: the jump may have failed (the player let go of jump early), and then she has to stay
    // crouched for the next try. Update decides once it can tell.
    BoostJumpStarted~: () -> void {
        isBoostJumpInFlight = true;
        secondsSinceBoostJump = 0.0f;
    }

    // What she is doing, for the debug HUD and the tests: swinging, walking, paused (waiting for a player who is far
    // behind), waiting at the landing of a cooperative arc, or waiting at a stop.
    ModeName :: () -> string {
        if isSwinging {
            return "swinging";
        }
        if isHoldingAtLanding {
            return "waiting at the landing";
        }
        if isWalking {
            return isPausedForPlayer ? "paused" : "walking";
        }
        return "waiting";
    }

    // True while she is crouched at a boost stop with the player's boost still unused.
    IsOfferingBoost :: () -> bool {
        return !isWalking && isHoldingForBoost;
    }

    // One fixed step. `playerFeet` is where the player stands. She decides where to go from it, and
    // only the distance along the ground counts, so a player on a ledge above her still counts as near.
    Update~: (playerFeet: lantern:::math:::Vec3, isPlayerGrounded: bool, dt: f32) -> void {
        guard stops.length() > 0;
        Advance(playerFeet, isPlayerGrounded, dt);
        LookAtPlayer(playerFeet);
        ReportToAnimator(dt);
    }

private:
    static LEAD_RANGE :: 10.0f;          // metres: how close the player must be for her to walk on, unless the stop says `near`
    static AHEAD_MARGIN :: 3.0f;         // metres nearer the next stop than her that makes the player "ahead"
    static HURRY_LIMIT :: 30.0f;         // metres: a player further than this is somewhere else, not ahead of her
    static HURRY_SPEED_SCALE :: 1.8f;    // how much faster she walks to get back in front of a player who ran past
    static PAUSE_DISTANCE :: 16.0f;      // metres behind her at which she stops walking and waits
    static RESUME_DISTANCE :: 11.0f;     // ... and the distance the player must close to before she walks again
    static NUDGE_INTERVAL_SECONDS :: 3.0f;
    static LOOK_RANGE :: 12.0f;          // metres: she looks at the player when they are this near
    static LANDING_RELEASE_DISTANCE :: 4.0f;  // metres: how near the player must come to her at a landing for her to walk on
    static ANCHOR_BESIDE_DISTANCE :: 2.5f;    // metres along the ground from a swing stop to the start post it uses
    static LEDGE_MIN_HEIGHT :: 2.0f;     // metres above her that counts as having landed on the ledge: above an unboosted jump's 1.5 m
    static MIN_JUMP_SECONDS :: 0.1f;     // the player is still on the ground for the step the jump starts in
    animation~ CharacterAnimator = new CharacterAnimator();
    waitedSeconds~ f32 = 0.0f;
    isBoostJumpInFlight~ bool = false;
    secondsSinceBoostJump~ f32 = 0.0f;
    anchors~ Array<Anchor> = [];
    // For each stop, the index in `anchors` of the arc she swings from there, or -1.
    swingAnchorIndexByStop~ Array<i32> = [];
    isSwinging~ bool = false;
    activeSwingIndex~ i32 = 0;
    swingSeconds~ f32 = 0.0f;
    // After swinging a cooperative arc she stays by its far post until the player has come over, because the arc only works
    // with her beside a post.
    isHoldingAtLanding~ bool = false;
    isPausedForPlayer~ bool = false;
    nudgeSeconds~ f32 = 0.0f;

    // Her decision for this step: swing, walk, or wait at a stop and decide whether to set off.
    Advance~: (playerFeet: lantern:::math:::Vec3, isPlayerGrounded: bool, dt: f32) -> void {
        if isSwinging {
            Swing(dt);
            return;
        }
        if isWalking {
            Lead(playerFeet, dt);
            return;
        }
        if isBoostJumpInFlight {
            JudgeBoostJump(playerFeet, isPlayerGrounded, dt);
        }
        waitedSeconds += dt;
        guard stopIndex + 1 < stops.length();
        guard !isHoldingForBoost;
        if isHoldingAtLanding {
            if (playerFeet - position).Horizontal().Length() < LANDING_RELEASE_DISTANCE {
                isHoldingAtLanding = false;
                isWalking = true;
            }
            return;
        }
        currentStop := stops[stopIndex];
        gap := (playerFeet - position).Horizontal().Length();
        isHurried := !currentStop.hasMeetDistance && gap < HURRY_LIMIT && IsPlayerAhead(playerFeet);
        if isHurried {
            SetOff();
            return;
        }
        guard waitedSeconds >= currentStop.waitSeconds;
        meetDistance := currentStop.hasMeetDistance ? currentStop.meetDistance : LEAD_RANGE;
        if gap < meetDistance {
            SetOff();
        } else {
            Nudge(playerFeet, dt);
        }
    }

    // Starts the leg to the next stop: a swing across the stop's Anchor if it has one, else a walk.
    SetOff~: () -> void {
        nudgeSeconds = 0.0f;
        isPausedForPlayer = false;
        swingIndex := swingAnchorIndexByStop[stopIndex];
        if swingIndex >= 0 {
            activeSwingIndex = swingIndex;
            swingSeconds = 0.0f;
            isSwinging = true;
        } else {
            isWalking = true;
        }
    }

    // True when the player is clearly nearer the next stop than she is: they ran past her.
    IsPlayerAhead :: (playerFeet: lantern:::math:::Vec3) -> bool {
        nextPosition := stops[stopIndex + 1].position;
        herDistance := (nextPosition - position).Horizontal().Length();
        playerDistance := (nextPosition - playerFeet).Horizontal().Length();
        return playerDistance + AHEAD_MARGIN < herDistance;
    }

    // The index of the arc whose start post is within ANCHOR_BESIDE_DISTANCE of `at` along the ground, or -1.
    FindAnchorBeside :: (at: lantern:::math:::Vec3) -> i32 {
        bestIndex~ i32 = -1;
        bestDistance~ f32 = ANCHOR_BESIDE_DISTANCE;
        for index~ i32 = 0; index < anchors.length(); index++ {
            distance := (anchors[index].start - at).Horizontal().Length();
            if distance < bestDistance {
                bestIndex = index;
                bestDistance = distance;
            }
        }
        return bestIndex;
    }

    // The player is far behind: she turns to face them and, every NUDGE_INTERVAL_SECONDS, hops.
    Nudge~: (playerFeet: lantern:::math:::Vec3, dt: f32) -> void {
        FacePlayer(playerFeet);
        nudgeSeconds += dt;
        if nudgeSeconds >= NUDGE_INTERVAL_SECONDS {
            nudgeSeconds = 0.0f;
            animation.Wave();
        }
    }

    FacePlayer~: (playerFeet: lantern:::math:::Vec3) -> void {
        toPlayer := (playerFeet - position).Horizontal();
        if toPlayer.LengthSquared() > 0.01f {
            lantern:::world:::SetYaw(root, toPlayer.Yaw());
        }
    }

    // Walking along a leg. She hurries when the player has run past her and stops to wait, nudging, when they fall
    // too far behind. Stopping starts at PAUSE_DISTANCE and walking resumes at RESUME_DISTANCE, so she doesn't
    // flicker between the two at the edge.
    Lead~: (playerFeet: lantern:::math:::Vec3, dt: f32) -> void {
        gap := (playerFeet - position).Horizontal().Length();
        isAhead := IsPlayerAhead(playerFeet);
        if isPausedForPlayer {
            if gap < RESUME_DISTANCE || isAhead {
                isPausedForPlayer = false;
            }
        } else if gap > PAUSE_DISTANCE && !isAhead {
            isPausedForPlayer = true;
            nudgeSeconds = NUDGE_INTERVAL_SECONDS;
        }
        if isPausedForPlayer {
            Nudge(playerFeet, dt);
            return;
        }
        Walk(isAhead && gap < HURRY_LIMIT ? HURRY_SPEED_SCALE : 1.0f, dt);
    }

    // Swings along the arc at the arc's own pace, the way the player will. At the far post a cooperative arc
    // holds her there, and any other lets her walk on to the next stop.
    Swing~: (dt: f32) -> void {
        swungAnchor := anchors[activeSwingIndex];
        swingSeconds += dt;
        progress := Math:::min(swingSeconds / swungAnchor.seconds, 1.0f);
        position = swungAnchor.PointAt(progress);
        lantern:::world:::SetPosition(root, position);
        lantern:::world:::SetYaw(root, (swungAnchor.end - swungAnchor.start).Yaw());
        if progress >= 1.0f {
            isSwinging = false;
            isHoldingAtLanding = swungAnchor.needsCompanion;
            isWalking = !swungAnchor.needsCompanion;
        }
    }

    // The jump is judged when the player lands, never on the way up: a boosted jump passes a
    // metre above her within a few steps, so a height check in the air would call a jump the
    // player cut short a success. While airborne, keep waiting. Once grounded again:
    // - on a ledge at least LEDGE_MIN_HEIGHT above her (more than an unboosted jump reaches), the
    //   boost worked: she stands up and is free to follow;
    // - anywhere lower, it failed: she stays crouched and the offer stands for another try.
    JudgeBoostJump~: (playerFeet: lantern:::math:::Vec3, isPlayerGrounded: bool, dt: f32) -> void {
        secondsSinceBoostJump += dt;
        guard isPlayerGrounded && secondsSinceBoostJump > MIN_JUMP_SECONDS;
        isBoostJumpInFlight = false;
        if playerFeet.y > position.y + LEDGE_MIN_HEIGHT {
            isHoldingForBoost = false;
        }
    }

    // Moves toward the next stop at that leg's speed. Moving in `speed x dt` steps and snapping
    // to the target when closer than one step means she can't overshoot or jitter around it.
    Walk~: (speedScale: f32, dt: f32) -> void {
        target := stops[stopIndex + 1];
        toTarget := target.position - position;
        stepLength := stops[stopIndex].speedToNext * speedScale * dt;
        if toTarget.Length() <= stepLength {
            position = target.position;
            stopIndex++;
            isWalking = false;
            waitedSeconds = 0.0f;
            isHoldingForBoost = target.isBoost;
        } else {
            position = position + toTarget.Normalized() * stepLength;
            if toTarget.Horizontal().LengthSquared() > 0.01f {
                lantern:::world:::SetYaw(root, toTarget.Yaw());
            }
        }
        lantern:::world:::SetPosition(root, position);
    }

    // Tells her animator what she is doing, once per step: crouching while she offers the boost, and her
    // speed from how far she moved. The animator turns that into clips and fades. She is always on the ground
    // in the animator's eyes: her movement is scripted along the route.
    ReportToAnimator~: (dt: f32) -> void {
        isCrouched := !isWalking && isHoldingForBoost;
        animation.SetCrouching(isCrouched);
        animation.Observe(position, true, dt);
    }

    // Her head and chest turn toward the player's head while they are near, and relax when they are not: a small thing that
    // makes her feel like a person walking with you rather than a guide on rails.
    LookAtPlayer~: (playerFeet: lantern:::math:::Vec3) -> void {
        isNear := (playerFeet - position).Length() < LOOK_RANGE;
        animation.LookAt(playerFeet + lantern:::math:::Vec3 { x: 0.0f, y: 1.6f, z: 0.0f }, isNear ? 1.0f : 0.0f);
    }
}
