TeamBeat :: import TeamBeat;
PartnerTuning :: import PartnerTuning;
CharacterAnimator :: import CharacterAnimator;
NavigationDynamics :: import NavigationDynamics;
Math :: import standard:::Math;

// What she is doing right now.
// - Waiting: standing where she last finished, deciding whether to set off for the next beat.
// - Leading: walking to the next beat, through its `via` places first.
// - Acting: at a beat, doing what it says until its release rule is met.
// - Following: every beat is done; she tags along behind the player.
PartnerMode :: enum {
    Waiting,
    Leading,
    Acting,
    Following
}

// The partner: the companion who works beside you. The player and she are equals, so nobody gives
// orders. The level lists her beats (game-entities/team-beat.nyx) in order, and she works through
// them on her own: she goes first, waits for you at each one, does her part (holds a plate, kneels
// for a boost, pulls a lever, draws a light) and goes on when you have done yours. She is a
// character with her own physics body, the same pieces as the player.
//
// She finds her way over the level's navigation graph (lantern:::navigation): a path to the next beat while she
// leads, a path to the player while she follows. The path walks stairs and corners, drops off ledges and jumps short
// gaps; it never climbs. A beat's `via` places are the older, hand-made route, used when the graph has no path to the
// beat (it knows only the static level, so a door or a lift that moves is not in it) and after the path has failed her.
// What keeps her from being lost is a set of safety nets:
// - the graph also holds what moves (game-systems/navigation-dynamics.nyx): she goes round a shut door when she can and
//   otherwise waits in front of it, waits for a bridge or a stair that a switch raises, rides a moving platform across a
//   gap when it is level with her landing, and crosses a crumbling slab only when she is leading;
// - when she makes no progress on a path she plans it again, then falls back to the `via` route;
// - she looks for ground ahead of every step and stops at an edge instead of walking off it;
// - when she makes no progress she goes back to the beat she last stood at and tries again, and on
//   the third try goes straight to the beat she was heading for, so a level can never lock;
// - when she falls she is put back on the beat she last stood at;
// - when you run ahead she hurries, and when you fall behind she waits, faces you and hops.
Partner :: class {
public:
    root~ i64 = 0;
    isPresent~ bool = false;
    position~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    mode~ PartnerMode = PartnerMode:::Waiting;
    action~ string = "";
    // The beat she is walking to, or working at. Equal to the number of beats once she has finished them all.
    beatIndex~ i32 = 0;
    // The beat she begins at when the level starts or restarts: 0, unless play in editor dropped the player partway through.
    firstBeat~ i32 = 0;
    // Set when she can't do what she meant to; the game shows it once and clears it.
    note~ string = "";
    controller~ lantern:::physics:::CharacterController = new lantern:::physics:::CharacterController(PartnerTuning:::RADIUS, PartnerTuning:::HEIGHT, lantern:::math:::Vec3:::Zero());

    // Makes her at `start`, with the level's beats in order. `rig` is the animated humanoid the player and the
    // companion wear too (docs/animation.md). A level with no partner marker has no partner at all.
    Spawn~: (start: lantern:::math:::Vec3, rig: i64, bodyTexture: i64, beatsInOrder~ Array<TeamBeat>) -> void {
        isPresent = true;
        firstBeat = 0;
        beats = beatsInOrder;
        controller = new lantern:::physics:::CharacterController(PartnerTuning:::RADIUS, PartnerTuning:::HEIGHT, start);
        controller.SetWalkSpeed(PartnerTuning:::WALK_SPEED);
        controller.SetJumpHeight(PartnerTuning:::JUMP_HEIGHT);
        navigationNodes = lantern:::navigation:::Build(PartnerTuning:::RADIUS, PartnerTuning:::HEIGHT, PartnerTuning:::NAV_STEP_HEIGHT, PartnerTuning:::NAV_MAX_DROP, PartnerTuning:::NAV_MAX_JUMP_UP, PartnerTuning:::NAV_MAX_JUMP_ACROSS);
        root = lantern:::world:::Spawn("partner", start);
        animation = new CharacterAnimator();
        animation.Create(root, "partner_body", rig, bodyTexture, "E8506A");
        BeginAgain(start);
    }

    // Makes `index` the beat she begins at, now and after a restart, so a level started partway through does not
    // send her back to its first beat.
    BeginAtBeat~: (index: i32) -> void {
        firstBeat = Math:::clamp(index, 0, beats.length());
        beatIndex = firstBeat;
    }

    // Back at `start`, starting her beats again: the level was restarted.
    Reset~: (start: lantern:::math:::Vec3) -> void {
        guard isPresent;
        controller.Teleport(start);
        BeginAgain(start);
        lantern:::world:::Teleport(root, start);
        animation.Forget();
    }

    // For the debug HUD and the tests.
    ModeName :: () -> string {
        return when mode <PartnerMode> {
            Waiting -> "waiting",
            Leading -> isRiding ? "leading (riding)" : (isPaused ? "paused" : (isOnPath ? PathModeName() : "leading")),
            Acting -> "acting " + action,
            Following -> "following"
        };
    }

    // For the debug HUD: how many nodes the level's navigation graph has, and where she is on her path.
    NavigationSummary :: () -> string {
        if !isOnPath {
            return `${navigationNodes:d} nodes, no path`;
        }
        return `${navigationNodes:d} nodes, point ${pathIndex + 1:d} of ${pathPoints.length():d}`;
    }

    // What she is doing on her path, for the debug HUD and the tests.
    PathModeName :: () -> string {
        if isRiding {
            return "leading (riding)";
        }
        if isWaitingAtDoor {
            return "leading (waiting)";
        }
        return "leading (path)";
    }

    // Hands her what moves in the level: the doors, bridges, slabs and platforms the graph was told about. Without it she
    // only knows the static floor.
    UseNavigationDynamics~: (levelDynamics~ NavigationDynamics) -> void {
        dynamics = levelDynamics;
    }

    IsOfferingBoost :: () -> bool {
        return isPresent && mode == PartnerMode:::Acting && action == "crouch";
    }

    IsLuring :: () -> bool {
        return isPresent && mode == PartnerMode:::Acting && action == "lure";
    }

    // True while she is at a beat doing her part, or waiting for the player to come near enough to set off: the
    // player has something still to do for her, or with her.
    IsWorkingOnABeat :: () -> bool {
        return isPresent && beatIndex < beats.length() && mode != PartnerMode:::Leading;
    }

    // True once, on the step she arrives at a "pull" beat.
    TakePullRequest~: () -> bool {
        guard hasPending return false;
        hasPending = false;
        return true;
    }

    // The note she wants shown, and forget it.
    TakeNote~: () -> string {
        said := note;
        note = "";
        return said;
    }

    // The player's route, remembered as breadcrumbs: a point every TRAIL_SPACING metres of ground
    // walked. Once her beats are done she follows the breadcrumbs in order, so she goes through the doorway,
    // slot or stair the player went through instead of straight at them through a wall.
    RememberTrail~: (playerFeet: lantern:::math:::Vec3, isPlayerGrounded: bool) -> void {
        guard isPlayerGrounded;
        if trail.length() > 0 && trail[trail.length() - 1].DistanceTo(playerFeet) < PartnerTuning:::TRAIL_SPACING {
            return;
        }
        trail.add(playerFeet);
        if trail.length() > PartnerTuning:::TRAIL_MAX_POINTS {
            for dropped~ i32 = 0; dropped < PartnerTuning:::TRAIL_DROP_POINTS; dropped++ {
                trail.removeAt(0);
            }
            trailIndex = Math:::max(trailIndex - PartnerTuning:::TRAIL_DROP_POINTS, 0);
        }
    }

    // One fixed step. `activeChannels` are the switch channels that are on now, which some beats wait for.
    Update~: (playerFeet: lantern:::math:::Vec3, isPlayerGrounded: bool, activeChannels: Array<i32>, dt: f32) -> void {
        guard isPresent;
        wantsToMove = false;
        speedScale = 1.0f;
        moveTarget = position;
        when mode <PartnerMode> {
            Waiting -> { DecideWaiting(playerFeet, dt); },
            Leading -> { DecideLeading(playerFeet, dt); },
            Acting -> { DecideActing(playerFeet, isPlayerGrounded, activeChannels, dt); },
            Following -> { DecideFollowing(playerFeet, isPlayerGrounded, dt); }
        }
        MoveAndWatch(playerFeet, dt);
        DrawPath();
        lantern:::world:::SetPosition(root, position);
        lantern:::world:::SetYaw(root, facingYaw);
        ShowBody(playerFeet, dt);
    }

private:
    beats~ Array<TeamBeat> = [];
    animation~ CharacterAnimator = new CharacterAnimator();
    // The walk to the current beat: the places to pass first, and which of them is next.
    route~ Array<lantern:::math:::Vec3> = [];
    routeIndex~ i32 = 0;
    facingYaw~ f32 = 0.0f;
    trail~ Array<lantern:::math:::Vec3> = [];
    trailIndex~ i32 = 0;
    // The last place she stood at a beat, where she comes back to after falling or getting stuck.
    lastSafe~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    stuckSeconds~ f32 = 0.0f;
    retries~ i32 = 0;
    navigationNodes~ i32 = 0;
    pathPoints~ Array<lantern:::math:::Vec3> = [];
    pathKinds~ Array<i32> = [];
    pathIndex~ i32 = 0;
    isOnPath~ bool = false;
    pathFailures~ i32 = 0;
    replanSeconds~ f32 = 0.0f;
    isJumpHeld~ bool = false;
    dynamics~ NavigationDynamics = new NavigationDynamics();
    pathFeatures~ Array<i32> = [];
    pathGoal~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    isPathForLeading~ bool = true;
    seenRevision~ i32 = 0;
    isWaitingAtDoor~ bool = false;
    isRiding~ bool = false;
    actingSeconds~ f32 = 0.0f;
    isPaused~ bool = false;
    nudgeSeconds~ f32 = 0.0f;
    hasPending~ bool = false;
    // What this step decided: whether she walks, to where, and how fast.
    wantsToMove~ bool = false;
    moveTarget~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    speedScale~ f32 = 1.0f;

    BeginAgain~: (start: lantern:::math:::Vec3) -> void {
        position = start;
        lastSafe = start;
        mode = PartnerMode:::Waiting;
        action = "";
        note = "";
        beatIndex = firstBeat;
        route = [];
        routeIndex = 0;
        trail = [];
        trailIndex = 0;
        stuckSeconds = 0.0f;
        retries = 0;
        actingSeconds = 0.0f;
        isPaused = false;
        nudgeSeconds = 0.0f;
        hasPending = false;
        isOnPath = false;
        pathPoints = [];
        pathKinds = [];
        pathFeatures = [];
        pathIndex = 0;
        pathFailures = 0;
        isJumpHeld = false;
        isWaitingAtDoor = false;
        isRiding = false;
        seenRevision = lantern:::navigation:::Revision();
    }

    // Waiting between beats: she sets off when the player is near, or has run past her toward the beat. A player who
    // is far behind gets her face and a hop every few seconds instead.
    DecideWaiting~: (playerFeet: lantern:::math:::Vec3, dt: f32) -> void {
        if beatIndex >= beats.length() {
            mode = PartnerMode:::Following;
            isOnPath = false;
            replanSeconds = PartnerTuning:::FOLLOW_REPLAN_SECONDS;
            trailIndex = NearestTrailIndex();
            return;
        }
        FacePlayer(playerFeet);
        nextBeat := beats[beatIndex];
        leadRange := nextBeat.hasLeadRange ? nextBeat.leadRange : PartnerTuning:::LEAD_RANGE;
        gap := (playerFeet - position).Horizontal().Length();
        isAhead := IsPlayerAhead(playerFeet, nextBeat.position);
        if gap < leadRange || (isAhead && gap < PartnerTuning:::HURRY_LIMIT) {
            StartLeg();
        } else {
            Nudge(dt);
        }
    }

    StartLeg~: () -> void {
        route = beats[beatIndex].route;
        routeIndex = 0;
        pathFailures = 0;
        isOnPath = PlanPath(beats[beatIndex].position, true);
        stuckSeconds = 0.0f;
        isPaused = false;
        nudgeSeconds = 0.0f;
        mode = PartnerMode:::Leading;
    }

    // Walking to the beat. She hurries when the player has run past her, and stops to wait, hopping, when they fall
    // too far behind. Stopping starts at PAUSE_DISTANCE and walking resumes at RESUME_DISTANCE, so she doesn't flicker
    // between the two at the edge.
    DecideLeading~: (playerFeet: lantern:::math:::Vec3, dt: f32) -> void {
        beat := beats[beatIndex];
        gap := (playerFeet - position).Horizontal().Length();
        isAhead := IsPlayerAhead(playerFeet, beat.position);
        if isPaused {
            if gap < PartnerTuning:::RESUME_DISTANCE || isAhead {
                isPaused = false;
            }
        } else if gap > PartnerTuning:::PAUSE_DISTANCE && !isAhead {
            isPaused = true;
            nudgeSeconds = PartnerTuning:::NUDGE_INTERVAL_SECONDS;
        }
        if isPaused {
            FacePlayer(playerFeet);
            Nudge(dt);
            return;
        }
        PlanWhenTheLevelChanges(beat.position, true);
        if isOnPath {
            AimAlongPath();
        }
        if !isOnPath {
            moveTarget = routeIndex < route.length() ? route[routeIndex] : beat.position;
            wantsToMove = true;
        }
        speedScale = isAhead && gap < PartnerTuning:::HURRY_LIMIT ? PartnerTuning:::HURRY_SPEED_SCALE : 1.0f;
    }

    // At a beat. A crouch ends when the player is standing on a ledge she could not have boosted them onto by
    // jumping alone, which is also how a player who took the long way ends it. Every other beat ends by its release rule.
    DecideActing~: (playerFeet: lantern:::math:::Vec3, isPlayerGrounded: bool, activeChannels: Array<i32>, dt: f32) -> void {
        beat := beats[beatIndex];
        actingSeconds += dt;
        if beat.action != "lure" {
            FacePlayer(playerFeet);
        }
        if beat.action == "crouch" {
            if isPlayerGrounded && playerFeet.y > position.y + PartnerTuning:::LEDGE_MIN_HEIGHT {
                FinishBeat();
            }
            return;
        }
        if IsReleased(beat, playerFeet, activeChannels) {
            FinishBeat();
        }
    }

    // After her last beat: walk a path to the player, or their trail when there is no path, or arrive beside them when far
    // behind.
    DecideFollowing~: (playerFeet: lantern:::math:::Vec3, isPlayerGrounded: bool, dt: f32) -> void {
        gap := (playerFeet - position).Horizontal().Length();
        if gap > PartnerTuning:::CATCH_UP_DISTANCE {
            controller.Teleport(playerFeet + lantern:::math:::Vec3:::FromYaw(facingYaw) * 1.5f);
            isOnPath = false;
        } else if gap > PartnerTuning:::FOLLOW_DISTANCE {
            replanSeconds += dt;
            if isPlayerGrounded && (!isOnPath || (!isRiding && replanSeconds >= PartnerTuning:::FOLLOW_REPLAN_SECONDS)) {
                replanSeconds = 0.0f;
                isOnPath = PlanPath(playerFeet, false);
            }
            if isOnPath {
                AimAlongPath();
            }
            if !isOnPath {
                moveTarget = NextTrailPoint(playerFeet);
                wantsToMove = true;
            }
        } else {
            isOnPath = false;
        }
    }

    // Plans a path from where she stands to `goal`. True, and she follows it, when the graph has a way all the way there.
    // While she leads she may cross fragile slabs, because they break behind her and the player finds another way; while
    // she follows she never does. A way through a shut door or a bridge that is down counts: she waits for it.
    PlanPath~: (goal: lantern:::math:::Vec3, isLeading: bool) -> bool {
        pathPoints = [];
        pathKinds = [];
        pathFeatures = [];
        pathIndex = 0;
        pathGoal = goal;
        isPathForLeading = isLeading;
        seenRevision = lantern:::navigation:::Revision();
        guard navigationNodes > 0 return false;
        found~ lantern:::navigation:::Path = lantern:::navigation:::FindRoute(position, goal, isLeading);
        guard found.IsComplete() && found.Count() > 0 return false;
        for index~ i32 = 0; index < found.Count(); index++ {
            pathPoints.add(found.Point(index));
            pathKinds.add(found.Link(index));
            pathFeatures.add(found.Feature(index));
        }
        return true;
    }

    // With no path, because a door was shut or a bridge was down when she looked, she looks again once something in the
    // level has opened or shut.
    PlanWhenTheLevelChanges~: (goal: lantern:::math:::Vec3, isLeading: bool) -> void {
        guard !isOnPath && lantern:::navigation:::Revision() != seenRevision && controller.IsGrounded();
        isOnPath = PlanPath(goal, isLeading);
    }

    // Decides where this step's walk is aimed along her path, and whether she walks at all. She stands still in front of a
    // shut door or a bridge that is down, and at a landing until the platform is level with it. Sets `isOnPath` false when
    // the path can't be walked any more. A path stays good while things open and shut: a door she waits for opens, and a
    // slab breaks behind her, so she plans again only when she has no path (see `PlanWhenTheLevelChanges`) or gets stuck.
    AimAlongPath~: () -> void {
        isWaitingAtDoor = false;
        isRiding = false;
        moveTarget = pathPoints[pathIndex];
        wantsToMove = true;
        if pathKinds[pathIndex] == PartnerTuning:::LINK_RIDE {
            AimAtRide();
            return;
        }
        feature := pathFeatures[pathIndex];
        if feature >= 0 && !lantern:::navigation:::IsFeatureAvailable(feature) {
            wantsToMove = false;
            isWaitingAtDoor = true;
        }
    }

    // The point she is walking to is the far landing of a ride, and the one before it is where she boards. She waits at
    // the landing until the platform's edge is beside it, steps on, stands still while it carries her and steps off at the
    // far landing once the platform is beside that.
    AimAtRide~: () -> void {
        rideIndex := dynamics.RideIndex(pathFeatures[pathIndex]);
        if rideIndex < 0 || pathIndex == 0 {
            isOnPath = false;
            return;
        }
        landing := pathPoints[pathIndex - 1];
        farLanding := pathPoints[pathIndex];
        window := PartnerTuning:::RIDE_BOARD_WINDOW;
        if dynamics.IsOnPlatform(rideIndex, position) {
            isRiding = true;
            if dynamics.IsPlatformAtLanding(rideIndex, farLanding, window) {
                moveTarget = farLanding;
            } else {
                wantsToMove = false;
            }
            return;
        }
        if (farLanding - position).Horizontal().Length() < (landing - position).Horizontal().Length() {
            moveTarget = farLanding;
            return;
        }
        if dynamics.IsPlatformAtLanding(rideIndex, landing, window) {
            moveTarget = dynamics.RideTop(rideIndex);
        } else {
            wantsToMove = false;
        }
    }

    // Has she reached `target`, the next place she is walking to? On a path, a point on the way is reached more loosely
    // than the end, and the point before a jump more tightly, so she takes off from the edge.
    HasReached :: (target: lantern:::math:::Vec3) -> bool {
        flat := (target - position).Horizontal().Length();
        if !isOnPath {
            return flat < PartnerTuning:::ARRIVE_DISTANCE;
        }
        if (target.y - position.y) > PartnerTuning:::PATH_HEIGHT_REACHED || (position.y - target.y) > PartnerTuning:::PATH_HEIGHT_REACHED {
            return false;
        }
        if pathKinds[pathIndex] == PartnerTuning:::LINK_RIDE && (target - pathPoints[pathIndex]).Length() > 0.01f {
            return false;
        }
        if pathIndex >= pathPoints.length() - 1 {
            return flat < PartnerTuning:::ARRIVE_DISTANCE;
        }
        if pathKinds[pathIndex + 1] == PartnerTuning:::LINK_JUMP {
            return flat < PartnerTuning:::JUMP_TAKEOFF_REACHED;
        }
        return flat < PartnerTuning:::PATH_POINT_REACHED;
    }

    // The step itself: face where she is going, stop at an edge, let the controller move her, notice arriving, and
    // notice being stuck or fallen.
    MoveAndWatch~: (playerFeet: lantern:::math:::Vec3, dt: f32) -> void {
        direction~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
        isLeavingTheGround := wantsToMove && isOnPath && pathKinds[pathIndex] != PartnerTuning:::LINK_WALK;
        if wantsToMove {
            toTarget := (moveTarget - position).Horizontal();
            if toTarget.Length() > 0.05f {
                direction = toTarget.Normalized();
                facingYaw = direction.Yaw();
                if !isLeavingTheGround && !HasGroundAhead(direction) {
                    direction = lantern:::math:::Vec3:::Zero();
                }
            }
        }
        isJumping := isLeavingTheGround && pathKinds[pathIndex] == PartnerTuning:::LINK_JUMP && controller.IsGrounded();
        if isJumping {
            isJumpHeld = true;
        } else if controller.Velocity().y <= 0.0f {
            isJumpHeld = false;
        }
        controller.SetWalkSpeed(PartnerTuning:::WALK_SPEED * speedScale);
        controller.Step(direction, isJumping, isJumpHeld, dt);
        if isJumping {
            animation.Jump();
        }
        before := position;
        position = controller.FeetPosition();
        if wantsToMove && HasReached(moveTarget) {
            if mode == PartnerMode:::Leading {
                Arrive();
            } else if mode == PartnerMode:::Following && isOnPath {
                pathIndex++;
                if pathIndex >= pathPoints.length() {
                    isOnPath = false;
                }
            }
        }
        WatchForTrouble(playerFeet, before, dt);
    }

    // Reaching a place on the route moves her on to the next; reaching the beat starts its action.
    Arrive~: () -> void {
        stuckSeconds = 0.0f;
        if isOnPath {
            pathIndex++;
            if pathIndex < pathPoints.length() {
                return;
            }
            isOnPath = false;
        } else if routeIndex < route.length() {
            routeIndex++;
            return;
        }
        beat := beats[beatIndex];
        lastSafe = position;
        action = beat.action;
        actingSeconds = 0.0f;
        hasPending = beat.action == "pull";
        mode = PartnerMode:::Acting;
    }

    FinishBeat~: () -> void {
        hasPending = false;
        action = "";
        beatIndex++;
        retries = 0;
        lastSafe = position;
        nudgeSeconds = 0.0f;
        mode = PartnerMode:::Waiting;
    }

    // Has the rule that lets her go on from `beat` been met?
    IsReleased :: (beat: TeamBeat, playerFeet: lantern:::math:::Vec3, activeChannels: Array<i32>) -> bool {
        if beat.release == "none" {
            return true;
        } else if beat.release == "seconds" {
            return actingSeconds >= beat.seconds;
        } else if beat.release == "channel" {
            for channel: i32 in activeChannels {
                if channel == beat.channel {
                    return true;
                }
            }
            return false;
        } else if beat.release == "at" {
            return IsWithin(playerFeet, beat.releasePoint, beat.meetDistance);
        }
        return IsWithin(playerFeet, position, beat.meetDistance);
    }

    // Within `meet` metres along the ground of `spot`, and on much the same level.
    IsWithin :: (feet: lantern:::math:::Vec3, spot: lantern:::math:::Vec3, meet: f32) -> bool {
        along := (feet - spot).Horizontal().Length();
        return along < meet && feet.y - spot.y < 2.5f && spot.y - feet.y < 2.5f;
    }

    // True when the player is clearly nearer `target` than she is: they ran past her.
    IsPlayerAhead :: (playerFeet: lantern:::math:::Vec3, target: lantern:::math:::Vec3) -> bool {
        herDistance := (target - position).Horizontal().Length();
        playerDistance := (target - playerFeet).Horizontal().Length();
        return playerDistance + PartnerTuning:::AHEAD_MARGIN < herDistance;
    }

    // Is there ground a step ahead of her, no further down than EDGE_DROP_LIMIT? The ray starts a metre up, so a stair
    // riser or a ledge she can step onto doesn't start it inside the ground.
    HasGroundAhead :: (direction: lantern:::math:::Vec3) -> bool {
        lift: lantern:::math:::Vec3 = { y: 1.0f };
        down: lantern:::math:::Vec3 = { y: -1.0f };
        probe := position + direction * PartnerTuning:::EDGE_PROBE_DISTANCE + lift;
        return when lantern:::physics:::Raycast(probe, down, 1.0f + PartnerTuning:::EDGE_DROP_LIMIT) {
            hit: lantern:::physics:::RayHit -> hit.Distance() > 0.0f,
            null -> false
        };
    }

    // Falling a long way, or walking without getting anywhere, sends her back to try again.
    WatchForTrouble~: (playerFeet: lantern:::math:::Vec3, before: lantern:::math:::Vec3, dt: f32) -> void {
        if position.y < lastSafe.y - PartnerTuning:::FALL_RESET_DEPTH {
            Recover(playerFeet, true);
            return;
        }
        guard wantsToMove && (mode == PartnerMode:::Leading || mode == PartnerMode:::Following);
        speed := (position - before).Horizontal().Length() / dt;
        if speed < PartnerTuning:::STUCK_SPEED {
            stuckSeconds += dt;
        } else {
            stuckSeconds = 0.0f;
        }
        guard stuckSeconds > PartnerTuning:::STUCK_SECONDS;
        stuckSeconds = 0.0f;
        Recover(playerFeet, false);
    }

    // Putting her right. Following, she arrives behind the player. Leading, a fall or the first two times she is stuck
    // put her back on the beat she last stood at to walk the leg again, and the third time she goes straight to the
    // beat she was heading for, so a level can never lock.
    Recover~: (playerFeet: lantern:::math:::Vec3, hasFallen: bool) -> void {
        if mode == PartnerMode:::Following {
            controller.Teleport(playerFeet + lantern:::math:::Vec3:::FromYaw(facingYaw) * -1.5f);
            position = controller.FeetPosition();
            isOnPath = false;
            return;
        }
        if mode == PartnerMode:::Leading && !hasFallen && isOnPath {
            pathFailures++;
            if pathFailures == 1 {
                isOnPath = PlanPath(beats[beatIndex].position, true);
            } else {
                isOnPath = false;
                routeIndex = 0;
            }
            return;
        }
        retries++;
        if hasFallen || retries <= PartnerTuning:::RETRIES_BEFORE_SKIP || mode != PartnerMode:::Leading {
            controller.Teleport(lastSafe);
            position = lastSafe;
            routeIndex = 0;
            if mode == PartnerMode:::Leading {
                isOnPath = PlanPath(beats[beatIndex].position, true);
            }
            if mode == PartnerMode:::Acting {
                action = "";
                hasPending = false;
                mode = PartnerMode:::Waiting;
            }
            return;
        }
        arrival := beats[beatIndex].position;
        controller.Teleport(arrival);
        position = arrival;
        routeIndex = route.length();
        isOnPath = false;
    }

    // The breadcrumb she is walking to: she skips the ones she is already at, and when she has
    // used them all she walks straight at the player.
    NextTrailPoint~: (playerFeet: lantern:::math:::Vec3) -> lantern:::math:::Vec3 {
        while trailIndex < trail.length() - 1 && (trail[trailIndex] - position).Horizontal().Length() < PartnerTuning:::TRAIL_REACHED_DISTANCE {
            trailIndex++;
        }
        return trailIndex < trail.length() ? trail[trailIndex] : playerFeet;
    }

    // Where she joins the trail when her beats are done: the breadcrumb closest to her.
    NearestTrailIndex :: () -> i32 {
        best~ i32 = 0;
        bestDistance~ f32 = 1000000.0f;
        for index~ i32 = 0; index < trail.length(); index++ {
            distance := trail[index].DistanceTo(position);
            if distance < bestDistance {
                best = index;
                bestDistance = distance;
            }
        }
        return best;
    }

    // With the debug HUD on, the path she is walking: a line from her through each point still ahead, drops in orange,
    // jumps in red and rides in blue.
    DrawPath :: () -> void {
        guard isOnPath && lantern:::debug:::IsHudVisible();
        lift: lantern:::math:::Vec3 = { y: 0.15f };
        previous~ lantern:::math:::Vec3 = position + lift;
        for index~ i32 = pathIndex; index < pathPoints.length(); index++ {
            point := pathPoints[index] + lift;
            kind := pathKinds[index];
            color := kind == PartnerTuning:::LINK_JUMP ? "FF4040" : (kind == PartnerTuning:::LINK_DROP ? "FFA030" : (kind == PartnerTuning:::LINK_RIDE ? "40A0FF" : "40FF80"));
            lantern:::debug:::Line(previous, point, color);
            lantern:::debug:::Sphere(point, 0.12f, color);
            previous = point;
        }
    }

    FacePlayer~: (playerFeet: lantern:::math:::Vec3) -> void {
        toPlayer := (playerFeet - position).Horizontal();
        if toPlayer.LengthSquared() > 0.01f {
            facingYaw = toPlayer.Yaw();
        }
    }

    // The player is far off: every NUDGE_INTERVAL_SECONDS she waves, a gesture that says "this way".
    Nudge~: (dt: f32) -> void {
        nudgeSeconds += dt;
        if nudgeSeconds >= PartnerTuning:::NUDGE_INTERVAL_SECONDS {
            nudgeSeconds = 0.0f;
            animation.Wave();
        }
    }

    // She crouches to offer the boost, looks at the player while they are near, and the animator turns her speed and
    // whether she is on the ground into walking, running, jumping and falling.
    ShowBody~: (playerFeet: lantern:::math:::Vec3, dt: f32) -> void {
        animation.SetCrouching(mode == PartnerMode:::Acting && action == "crouch");
        isNear := (playerFeet - position).Length() < PartnerTuning:::LOOK_RANGE;
        animation.LookAt(playerFeet + lantern:::math:::Vec3 { x: 0.0f, y: 1.6f, z: 0.0f }, isNear ? 1.0f : 0.0f);
        animation.Observe(position, controller.IsGrounded(), dt);
    }
}
