// A memory spot: a place she liked, which the player learned in the Together beat (docs/finding-her.md, "Know her").
// A world-file entity of kind "memory_spot". Properties: `label` (text), `note_together` (text, said once when the
// player first passes it while she is with them), `note_alone` (text, said once when the player comes to it after she
// is gone) and `is_exit` (number, 1 for the chapter 5 exit marker when the level ends by reaching it).
MemorySpot :: class {
public:
    position: lantern:::math:::Vec3;
    label: string;
    noteTogether: string;
    noteAlone: string;
    isExit: bool;
    wasVisited~ bool = false;

    MemorySpot~: (entity: i64) : position(lantern:::world:::WorldPosition(entity)),
        label(lantern:::world:::HasProperty(entity, "label") ? lantern:::world:::TextProperty(entity, "label") : ""),
        noteTogether(lantern:::world:::HasProperty(entity, "note_together") ? lantern:::world:::TextProperty(entity, "note_together") : ""),
        noteAlone(lantern:::world:::HasProperty(entity, "note_alone") ? lantern:::world:::TextProperty(entity, "note_alone") : ""),
        isExit(lantern:::world:::HasProperty(entity, "is_exit") && lantern:::world:::NumberProperty(entity, "is_exit") > 0.5f) { }
}
