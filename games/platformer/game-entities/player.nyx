AdventureTuning :: import AdventureTuning;
PlayerTuning :: import PlayerTuning;
GameAssets :: import GameAssets;
CharacterAnimator :: import CharacterAnimator;
Math :: import standard:::Math;

// The player: an engine character controller, the entities that show it (a capsule body with
// a visor, parented to a root at the feet) and a blob shadow on the ground below, which the engine
// draws as soft darkness on whatever surface is under the player (see OnRender in main.nyx).
//
// Two halves that the game keeps in step:
// - The lantern:::physics:::CharacterController (engine/src/physics/Controller.nox) is the physics. It is not
//   an entity and draws nothing: it is a capsule shape that it moves through the collision world
//   each fixed step, deciding velocity from input, gravity and jumping and sliding along walls.
// - The entities are what you see. After each step Move() copies the controller's feet position
//   onto `root`, and the engine draws root and its children from that.
Player :: class {
public:
    root~ i64 = 0;
    // The animated body. Photo mode hides it while the camera is at the player's eyes (otherwise
    // the lens would sit inside the head).
    animation~ CharacterAnimator = new CharacterAnimator();
    isAnimationReady~ bool = false;
    blobCenter~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    blobRadius~ f32 = 0.0f;       // 0 when there is no floor below to put a shadow on
    spawn~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    facingYaw~ f32 = 0.0f;           // radians about +Y; 0 faces -Z
    controller~ lantern:::physics:::CharacterController = new lantern:::physics:::CharacterController(PlayerTuning:::RADIUS, PlayerTuning:::HEIGHT, lantern:::math:::Vec3:::Zero());
    // The grounded feel (docs/gameplay-prototypes.md): a level whose spawn says `movement` is
    // "grounded" asks for it with UseGroundedFeel after Spawn. `normalJumpHeight` is the apex of an
    // ordinary jump in the feel the level uses, which Move puts back after a boosted jump.
    isGroundedFeel~ bool = false;
    normalJumpHeight~ f32 = PlayerTuning:::JUMP_HEIGHT;
    easedDirection~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    recoverySecondsLeft~ f32 = 0.0f;

    Spawn~: (assets: GameAssets, spawnPosition: lantern:::math:::Vec3) -> void {
        spawn = spawnPosition;
        controller = new lantern:::physics:::CharacterController(PlayerTuning:::RADIUS, PlayerTuning:::HEIGHT, spawnPosition);
        // The game picks the feel; the controller does the physics with these numbers. From
        // JUMP_HEIGHT and GRAVITY it works out the take-off speed (see PlayerTuning).
        controller.SetWalkSpeed(PlayerTuning:::WALK_SPEED);
        controller.SetJumpHeight(PlayerTuning:::JUMP_HEIGHT);
        controller.SetGravity(PlayerTuning:::GRAVITY);
        facingYaw = 0.0f;
        isGroundedFeel = false;
        normalJumpHeight = PlayerTuning:::JUMP_HEIGHT;
        easedDirection = lantern:::math:::Vec3:::Zero();
        recoverySecondsLeft = 0.0f;

        // The root sits at the feet, and so does the mannequin, whose origin is at its feet.
        // Parenting means a child's position is relative to its parent: moving and turning the
        // root carries the body with it, so Move() only has to place one entity.
        root = lantern:::world:::Spawn("player", spawnPosition);
        animation = new CharacterAnimator();
        animation.Create(root, "player_body", assets.mannequinRig, assets.playerTexture, "E8A33D");
        isAnimationReady = true;
    }

    // Switches the player between the platformer feel Spawn gives (false) and the grounded feel
    // (true): a lower jump and heavier gravity, a slower walk, and Move easing the direction so
    // speed builds and fades over a few tenths of a second (AdventureTuning has the numbers and the
    // reasons). Called by the game after Spawn, from the level's spawn property.
    UseGroundedFeel~: (enabled: bool) -> void {
        isGroundedFeel = enabled;
        controller.SetKeepsPlatformSpeedInAir(enabled);
        easedDirection = lantern:::math:::Vec3:::Zero();
        recoverySecondsLeft = 0.0f;
        if enabled {
            normalJumpHeight = AdventureTuning:::GROUNDED_JUMP_HEIGHT;
            controller.SetWalkSpeed(AdventureTuning:::GROUNDED_WALK_SPEED);
            controller.SetJumpHeight(AdventureTuning:::GROUNDED_JUMP_HEIGHT);
            controller.SetGravity(AdventureTuning:::GROUNDED_GRAVITY);
        } else {
            normalJumpHeight = PlayerTuning:::JUMP_HEIGHT;
            controller.SetWalkSpeed(PlayerTuning:::WALK_SPEED);
            controller.SetJumpHeight(PlayerTuning:::JUMP_HEIGHT);
            controller.SetGravity(PlayerTuning:::GRAVITY);
        }
    }

    // A chapter's mood (settings/finding-her-tuning.nyx): `walkScale` multiplies the walking pace and `slump` (0 upright, 1
    // shoulders down) lowers the body a little. Call it after UseGroundedFeel, which sets the pace it scales.
    SetMood~: (walkScale: f32, slump: f32) -> void {
        base := isGroundedFeel ? AdventureTuning:::GROUNDED_WALK_SPEED : PlayerTuning:::WALK_SPEED;
        controller.SetWalkSpeed(base * walkScale);
        guard isAnimationReady;
        animation.SetBodyScale(1.0f - SLUMP_HEIGHT_LOSS * slump);
    }

    // Shows or hides the player's body. Visibility belongs to a mesh, not to a branch of the tree.
    SetBodyVisible~: (isVisible: bool) -> void {
        guard isAnimationReady;
        animation.SetVisible(isVisible);
    }

    // Back at `position` (a checkpoint, or the level's spawn point), at rest, facing forward.
    // Teleport rather than SetPosition: SetPosition would make the renderer blend from the old
    // place to the new one over a step (see OnRender's alpha), and the player would visibly
    // streak across the level.
    RespawnAt~: (position: lantern:::math:::Vec3) -> void {
        controller.Teleport(position);
        facingYaw = 0.0f;
        lantern:::world:::Teleport(root, position);
        lantern:::world:::SetYaw(root, facingYaw);
        animation.Forget();
    }

    // Turns the player to face `yaw` (radians about +Y) where they stand, as when play in editor starts them looking the way
    // the editor camera looked.
    FaceYaw~: (yaw: f32) -> void {
        facingYaw = yaw;
        lantern:::world:::SetYaw(root, facingYaw);
    }

    // Puts the player's feet where a swing says they are. The Anchor moves the player along its arc
    // instead of the character controller, which is told where they are so it carries on from there.
    SwingTo~: (feet: lantern:::math:::Vec3, yaw: f32) -> void {
        controller.Teleport(feet);
        facingYaw = yaw;
        lantern:::world:::SetPosition(root, feet);
        lantern:::world:::SetYaw(root, facingYaw);
        animation.Observe(feet, false, 0.0f);
        PlaceShadow();
    }

    // One fixed step. `stick` is the movement input (x right, y forward), turned into a world
    // direction with the camera's horizontal `forward` and `right`. `launchHeight` is 0 for an
    // ordinary jump; above 0 it is the apex of a taller jump started on this step: the companion's
    // boost (BoostSystem) or a bounce pad.
    Move~: (stick: lantern:::math:::Vec2, forward: lantern:::math:::Vec3, right: lantern:::math:::Vec3, jumpPressed: bool, jumpHeld: bool, launchHeight: f32, dt: f32) -> :lantern:::physics:::ControllerStep {
        // From stick space to world space. The stick says "this much forward, this much
        // right"; forward and right are those two directions in the world, so the world
        // direction is the sum of each axis scaled by its amount (a change of basis).
        // ClampLength(1): pressing W and D together gives a stick of (1, 1), whose length is
        // √2 ≈ 1.41, which would make diagonal running 41% faster. Clamping the length to 1
        // fixes that, and still lets a half-pushed analogue stick (length 0.5) walk slowly.
        wantedDirection := (forward * stick.y + right * stick.x).ClampLength(1.0f);
        // In the grounded feel the controller is handed a direction that eases toward the wanted
        // one, and a hard landing scales it down for a moment. The body still turns toward the
        // wanted direction, so it responds at once even while the speed builds.
        moveDirection := isGroundedFeel ? GroundedDirection(wantedDirection, dt) : wantedDirection;
        // The controller turns the direction into velocity: it accelerates toward
        // direction x walk speed (quickly on the ground, more slowly in the air), applies
        // gravity, jumps if asked, then moves and slides the capsule.
        // The boost is only the take-off speed: the controller works the speed out from the jump
        // height at the moment the jump starts, so raising the height for this one step and
        // putting it back gives a taller jump now and a normal one next time. It is set whenever the
        // player may boost, not only on the press, because the controller can start a jump from a
        // press it remembered a moment earlier (the jump buffer). Gravity and the
        // variable-height rule are unchanged, so letting go of jump early still cuts the boost short.
        if launchHeight > 0.0f {
            controller.SetJumpHeight(launchHeight);
        }
        step := controller.Step(moveDirection, jumpPressed, jumpHeld, dt);
        controller.SetJumpHeight(normalJumpHeight);
        if isGroundedFeel && step.Landed() && step.LandingSpeed() > AdventureTuning:::LANDING_RECOVERY_SPEED {
            recoverySecondsLeft = AdventureTuning:::LANDING_RECOVERY_SECONDS;
        }
        // Turn the body to face where it is going, at a limited speed so it swings round
        // instead of snapping. LengthSquared() > 0.01 means length > 0.1 (squared to skip a
        // square root): below that the stick is near its centre, its direction is mostly noise,
        // and the body should keep facing the way it was.
        if wantedDirection.LengthSquared() > 0.01f {
            // The most it may turn this step: radians per second x seconds per step.
            maximumTurn := PlayerTuning:::TURN_SPEED * dt;
            // How far it still has to turn. Wrap() takes the short way round: from facing
            // 170 degrees to -170 degrees is 20 degrees, not 340 the other way.
            difference := lantern:::angle:::Wrap(wantedDirection.Yaw() - facingYaw);
            // Take all of the remaining turn if it is small enough, otherwise the step's maximum
            // in the right direction. The clamp gives a constant turning speed that ends exactly
            // on the target without overshooting.
            facingYaw += Math:::clamp(difference, -maximumTurn, maximumTurn);
        }
        lantern:::world:::SetPosition(root, controller.FeetPosition());
        lantern:::world:::SetYaw(root, facingYaw);
        // Tell the animator what happened; it picks the clips. The controller says on the step a jump starts.
        if step.Jumped() {
            animation.Jump();
        }
        animation.Observe(controller.FeetPosition(), controller.IsGrounded(), dt);
        PlaceShadow();
        return step;
    }

    FeetPosition :: () -> lantern:::math:::Vec3 {
        return controller.FeetPosition();
    }

    // Whether a ledge the player can mantle is ahead in `direction` (a horizontal vector, the way they push). The
    // answer is only yes in the grounded feel, in the air, and when the jump has reached its top: a player still
    // rising fast would be hauled up before the jump had finished. `LedgeStandPoint` says where they end up.
    CanMantleToward~: (direction: lantern:::math:::Vec3) -> bool {
        guard isGroundedFeel return false;
        guard !controller.IsGrounded() return false;
        guard controller.Velocity().y <= AdventureTuning:::MANTLE_MAX_RISING_SPEED return false;
        guard direction.LengthSquared() > 0.25f return false;
        return controller.FindLedge(direction);
    }

    LedgeStandPoint :: () -> lantern:::math:::Vec3 {
        return controller.LedgeStandPoint();
    }

    // Asks the engine to darken the floor under the player this frame. Blob shadows last one
    // frame, like draws, so this is called from OnRender every frame.
    DrawBlobShadow :: () -> void {
        if blobRadius > 0.0f {
            lantern:::graphics:::AddBlobShadow(blobCenter, blobRadius, 0.55f);
        }
    }

private:
    static SLUMP_HEIGHT_LOSS :: 0.05f;   // the fraction of height a full slump takes off

    // The grounded feel's momentum. The eased direction moves toward the wanted one by at most
    // dt / rampSeconds per step, measured as a change in the vector's length (a vector of length
    // 1 is a full push), so a full push takes `rampSeconds` to reach full speed and lets go over
    // the same time. In the air the ramp is longer, so a jump keeps its direction.
    // The vector between them is `difference`; when it is shorter than the step's allowance the
    // eased direction simply arrives, otherwise it moves the allowance along `difference`.
    GroundedDirection~: (wantedDirection: lantern:::math:::Vec3, dt: f32) -> lantern:::math:::Vec3 {
        rampSeconds := controller.IsGrounded() ? AdventureTuning:::GROUNDED_GROUND_RAMP_SECONDS : AdventureTuning:::GROUNDED_AIR_RAMP_SECONDS;
        allowance := dt / rampSeconds;
        difference := wantedDirection - easedDirection;
        distance := difference.Length();
        if distance <= allowance {
            easedDirection = wantedDirection;
        } else {
            easedDirection = easedDirection + difference * (allowance / distance);
        }
        if recoverySecondsLeft > 0.0f {
            recoverySecondsLeft -= dt;
            return easedDirection * AdventureTuning:::LANDING_RECOVERY_SCALE;
        }
        return easedDirection;
    }

    // Finds the surface below the player and remembers where the shadow goes and how big it is;
    // DrawBlobShadow hands that to the engine every drawn frame.
    // A blob shadow is a cheap stand-in for real shadows, and in a platformer its main job is
    // gameplay: it shows exactly where you will land.
    PlaceShadow~: () -> void {
        feet := controller.FeetPosition();
        // Cast down from the capsule's centre rather than the feet. When standing, the feet are
        // on (or a skin's width above) the floor, and a ray starting there could start at or
        // below the surface and miss it. 30 m is far enough to find any floor the course has.
        when lantern:::physics:::Raycast(controller.CapsuleCenter(), lantern:::math:::Vec3:::Down(), 30.0f) {
            hit: lantern:::physics:::RayHit -> PlaceShadowOn(hit, feet),
            null -> ClearShadow()
        }
    }

    // No floor within 30 m below: there is nothing to put the shadow on.
    ClearShadow~: () -> void {
        blobRadius = 0.0f;
    }

    PlaceShadowOn~: (hit: lantern:::physics:::RayHit, feet: lantern:::math:::Vec3) -> void {
        // Height of the feet above the floor. Max(…, 0) guards against a tiny negative from
        // float rounding when standing.
        height := Math:::max(feet.y - hit.Point().y, 0.0f);
        // On the ground the shadow is 1.1 x the radius across each way, a little wider than the
        // body. As the player rises it shrinks linearly, 1 - height / 10: 10% smaller per metre,
        // down to 40% of its size (reached at 6 m, where 1 - 6/10 = 0.4) so it never vanishes.
        // A smaller shadow reads as "higher up", which helps judge a jump.
        blobCenter = hit.Point();
        blobRadius = PlayerTuning:::RADIUS * 1.1f * Math:::clamp(1.0f - height / 10.0f, 0.4f, 1.0f);
    }
}
