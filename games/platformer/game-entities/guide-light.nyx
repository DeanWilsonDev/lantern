// A light the player can navigate by, the second of the three abilities (the Guide Light): a
// point light in the world that also has a reveal radius. Hidden platforms near an active guide
// light become visible and solid (GlowSystem), so the light does real work in the game and is
// not only decoration.
//
// There are two of them in a level: the companion's glow (big, warm, always with her) and the
// lantern the player picks up later (smaller, cooler, carried deliberately).
GuideLight :: class {
public:
    position~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    // Metres from the light within which hidden platforms are revealed. The lamp's own `range`
    // (how far it shines) is separate: what you see and what the game reveals are tuned apart.
    revealRadius~ f32 = 0.0f;
    isOn~ bool = false;

    // Switches the light on at `at`. `lampRange` is how far it shines; `revealRadius` how far it
    // reveals. Strength 4 is a bright lamp (1 is a white surface lit close by looks white).
    TurnOn~: (at: lantern:::math:::Vec3, color: string, lampRange: f32, reveal: f32) -> void {
        TurnOff();
        position = at;
        revealRadius = reveal;
        lampId = lantern:::lights:::AddPoint(at, color, 2.0f, lampRange);
        isOn = true;
    }

    MoveTo~: (at: lantern:::math:::Vec3) -> void {
        guard isOn;
        position = at;
        lantern:::lights:::Move(lampId, at);
    }

    TurnOff~: () -> void {
        guard isOn;
        lantern:::lights:::Remove(lampId);
        isOn = false;
    }

private:
    lampId~ i64 = 0;
}
