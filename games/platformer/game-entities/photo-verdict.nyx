// What the camera finds when it is aimed. PhotoMode asks this every frame while the camera is
// raised, so the viewfinder can say why a photo would or wouldn't count, and the shutter takes
// the photo only when the answer is Ready.
PhotoVerdict :: enum {
    // No sight is inside the viewfinder's frame.
    NothingInFrame,
    // A sight is in frame, close enough, in the clear, and the companion is in the shot if it
    // needs her. Pressing the shutter counts it.
    Ready,
    // A sight is in frame but the camera is farther from it than its `max_distance`.
    TooFar,
    // A sight is in frame but something solid is between the lens and it.
    Blocked,
    // A sight meant for the two of you is in frame, and she isn't in the shot (or isn't near it).
    NeedsCompanion
}
