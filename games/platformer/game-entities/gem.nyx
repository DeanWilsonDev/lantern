// A collectable gem: a world-file entity of kind "gem" that spins and bobs above its home.
Gem :: class {
public:
    entity: i64;
    home: Vec3;
    index: i32;

    Gem~: (entity: i64, index: i32) : entity(entity), home(World:::Position(entity)), index(index) { }

    IsCollected :: () -> bool {
        return !World:::IsVisible(entity);
    }

    Collect :: () -> void {
        World:::SetVisible(entity, false);
    }

    Restore :: () -> void {
        World:::SetVisible(entity, true);
    }

    Animate :: (time: f32) -> void {
        bob := Math:::sin(time * BOB_SPEED + f32(index)) * BOB_HEIGHT;
        World:::SetPosition(entity, home.Add(Vec3 { y: bob }));
        World:::SetYaw(entity, time * SPIN_SPEED);
    }

private:
    static SPIN_SPEED :: 1.5f;        // radians per second
    static BOB_SPEED :: 2.0f;
    static BOB_HEIGHT :: 0.1f;        // metres
}
