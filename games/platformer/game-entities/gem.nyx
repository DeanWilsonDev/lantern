Math :: import standard:::Math;

// A collectable gem: a world-file entity of kind "gem" that spins and bobs above its home.
//
// A collected gem is only hidden, not despawned, so restarting the level can show it again
// without reloading the world file.
Gem :: class {
public:
    entity: i64;
    home: lantern:::math:::Vec3;
    index: i32;

    Gem~: (entity: i64, index: i32) : entity(entity), home(lantern:::world:::Position(entity)), index(index) { }

    IsCollected :: () -> bool {
        return !lantern:::world:::IsVisible(entity);
    }

    Collect :: () -> void {
        lantern:::world:::SetVisible(entity, false);
    }

    Restore :: () -> void {
        lantern:::world:::SetVisible(entity, true);
    }

    // `time` is the simulation clock, so gems freeze while paused.
    Animate :: (time: f32) -> void {
        // sin() swings smoothly between -1 and 1, so multiplying by BOB_HEIGHT gives an offset
        // of up to 10 cm above and below home. time x BOB_SPEED is the angle in radians: at
        // 2 rad/s one full bob (2π) takes π ≈ 3.1 s. Adding the gem's index shifts each gem's
        // wave by 1 radian, so neighbouring gems are at different heights instead of bobbing
        // in lockstep.
        bob := Math:::sin(time * BOB_SPEED + f32(index)) * BOB_HEIGHT;
        // Always home + offset, not "move up a bit": nothing accumulates, so it can't drift.
        bobOffset: lantern:::math:::Vec3 = { y: bob };
        lantern:::world:::SetPosition(entity, home + bobOffset);
        // Spin: the angle is simply speed x time.
        lantern:::world:::SetYaw(entity, time * SPIN_SPEED);
    }

private:
    static SPIN_SPEED :: 1.5f;        // radians per second
    static BOB_SPEED :: 2.0f;         // radians per second of the bob's sine wave
    static BOB_HEIGHT :: 0.1f;        // metres
}
