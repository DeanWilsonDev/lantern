// A world-file entity of kind "moving_platform": it eases from where the file put it to
// `start + travel` and back every `period` seconds. Moving the entity moves its collision body,
// so the player rides it.
MovingPlatform :: class {
public:
    entity: i64;
    start: Vec3;
    travel: Vec3;
    period: f32;

    MovingPlatform~: (entity: i64) : entity(entity), start(World:::Position(entity)),
        travel(World:::VectorProperty(entity, "travel")), period(World:::NumberProperty(entity, "period_seconds")) { }

    // 0 at the start, 1 at the far end, 0 again after a period.
    PositionAt :: (time: f32) -> Vec3 {
        phase := time / period * Math:::TAU;
        return start + travel * (0.5f - 0.5f * Math:::cos(phase));
    }

    Move :: (time: f32) -> void {
        World:::SetPosition(entity, PositionAt(time));
    }
}
