// A pad that throws the player upward: a world-file entity of kind "bounce_pad", a flat piece the
// player lands on. Stepping on it makes the next jump a tall one without pressing anything, so a
// run of pads is a rhythm of landing and flying rather than of timing a button.
//
// How the launch works: the controller turns "how high" into a take-off speed at the moment a jump
// starts, so the game asks for a taller jump for one step (the same way the Boost does, see
// Player.Move) and the usual gravity does the rest.
//
// Properties set on the entity in the world editor:
// - `half_extents` (vector): half the pad's width and depth.
// - `height` (number, optional): the apex of the launch in metres above the pad; 5 when missing.
BouncePad :: class {
public:
    entity: i64;
    home: lantern:::math:::Vec3;
    halfExtents: lantern:::math:::Vec3;
    height: f32;

    BouncePad~: (entity: i64) : entity(entity), home(lantern:::world:::Position(entity)),
        halfExtents(lantern:::world:::VectorProperty(entity, "half_extents")),
        height(lantern:::world:::HasProperty(entity, "height") ? lantern:::world:::NumberProperty(entity, "height") : 5.0f) { }

    // The pad glows so it reads as springy against plain ground.
    Place~: () -> void {
        lantern:::world:::SetTint(entity, "FF8A5A");
        lantern:::world:::SetGlow(entity, "FF8A5A", 1.2f);
    }

    // Whether `feet` stand on the pad: inside its footprint and at its top.
    IsOn :: (feet: lantern:::math:::Vec3) -> bool {
        offset := feet - home;
        return offset.x > -halfExtents.x && offset.x < halfExtents.x && offset.z > -halfExtents.z && offset.z < halfExtents.z && offset.y > -halfExtents.y - 0.2f && offset.y < halfExtents.y + 0.3f;
    }
}
