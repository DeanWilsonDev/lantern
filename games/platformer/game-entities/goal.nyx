Math :: import standard:::Math;

// A world-file entity of kind "goal": where a level ends. Touching it completes the level
// (GameRules), and the game then loads the level named by `next_level`, or goes back to the
// main menu when there isn't one.
//
// Properties:
// - `next_level` (text, optional): the world file to play next, such as "worlds/streets-later.world.json".
//
// The goal is a tall gold post on a flat gold plate, so it reads as "the end" from far down a
// street. It turns slowly while it waits, and lights up when it is reached.
Goal :: class {
public:
    entity: i64;
    nextLevel: string;
    isReached~ bool = false;
    post~ i64 = 0;

    Goal~: (entity: i64) : entity(entity),
        nextLevel(lantern:::world:::HasProperty(entity, "next_level") ? lantern:::world:::TextProperty(entity, "next_level") : "") { }

    Place~: (cubeMesh: i64) -> void {
        plate := lantern:::world:::Spawn("goal_plate", { y: 0.03f });
        lantern:::world:::SetMesh(plate, cubeMesh, WAITING_TINT);
        lantern:::world:::SetScale(plate, { x: 2.4f, y: 0.06f, z: 2.4f });
        lantern:::world:::SetParent(plate, entity);
        post = lantern:::world:::Spawn("goal_post", { y: 1.6f });
        lantern:::world:::SetMesh(post, cubeMesh, WAITING_TINT);
        lantern:::world:::SetScale(post, { x: 0.3f, y: 3.2f, z: 0.3f });
        lantern:::world:::SetParent(post, entity);
    }

    Reach~: () -> void {
        isReached = true;
        lantern:::world:::SetTint(post, REACHED_TINT);
    }

    Restore~: () -> void {
        isReached = false;
        lantern:::world:::SetTint(post, WAITING_TINT);
    }

    Animate :: (time: f32) -> void {
        lantern:::world:::SetYaw(post, time * 0.7f);
    }

private:
    static WAITING_TINT :: "E8C872";
    static REACHED_TINT :: "FFF2B0";
}
