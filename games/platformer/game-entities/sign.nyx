// A line of help shown while the player is near: a world-file entity of kind "sign". The prototype
// rooms use them to say what to try ("F sends her to the glowing spot") because there are no
// tutorial screens to put it on.
//
// Properties:
// - `text` (text): what to show.
// - `radius` (number, optional): how near the player must be, in metres; 6 when missing.
Sign :: class {
public:
    position: lantern:::math:::Vec3;
    text: string;
    radius: f32;

    Sign~: (entity: i64) : position(lantern:::world:::Position(entity)),
        text(lantern:::world:::TextProperty(entity, "text")),
        radius(lantern:::world:::HasProperty(entity, "radius") ? lantern:::world:::NumberProperty(entity, "radius") : 6.0f) { }
}
