Math :: import standard:::Math;

// The lantern: a world-file entity of kind "lantern" that the player picks up and carries from
// then on. It is the solo form of the Guide Light: smaller and cooler than the companion's glow,
// and carried on purpose instead of simply being near her.
//
// Like a gem, a taken lantern is only hidden, so restarting the level can show it again.
LanternPickup :: class {
public:
    entity: i64;
    home: lantern:::math:::Vec3;

    LanternPickup~: (entity: i64) : entity(entity), home(lantern:::world:::Position(entity)) { }

    IsTaken :: () -> bool {
        return !lantern:::world:::IsVisible(entity);
    }

    Take :: () -> void {
        lantern:::world:::SetVisible(entity, false);
    }

    Restore :: () -> void {
        lantern:::world:::SetVisible(entity, true);
    }

    // Floats and turns, a slower bob than a gem's so the two don't look alike. `time` is the
    // simulation clock.
    Animate :: (time: f32) -> void {
        bob: lantern:::math:::Vec3 = { y: Math:::sin(time * 1.5f) * 0.08f };
        lantern:::world:::SetPosition(entity, home + bob);
        lantern:::world:::SetYaw(entity, time * 0.8f);
    }
}
