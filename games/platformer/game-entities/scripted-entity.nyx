GraphBehaviours :: import GraphBehaviours;

// An entity of kind "scripted": its behaviour is a graph function (game-graphs/*.graph.json), named by the entity's
// properties and run every step with the entity and the time. Anything a graph can reach is the host API, the same as
// game code, so a scripted entity can do what a hand-written one can.
//
// Properties:
// - `graph` (text): the graph's name, such as "lamp_pulse".
// - `function` (text): the behaviour function in it, `Update` when missing.
ScriptedEntity :: class {
public:
    entity: i64;
    graph: string;
    function: string;

    ScriptedEntity~: (entity: i64) : entity(entity),
        graph(lantern:::world:::HasProperty(entity, "graph") ? lantern:::world:::TextProperty(entity, "graph") : ""),
        function(lantern:::world:::HasProperty(entity, "function") ? lantern:::world:::TextProperty(entity, "function") : "Update") { }

    // Runs the behaviour. False when the graph or function named isn't one the game was built with.
    Run :: (time: f32) -> bool {
        return GraphBehaviours:::Run(graph, function, entity, time);
    }
}
