Math :: import standard:::Math;
PartnerTuning :: import PartnerTuning;

// A sweeping light that sends the player back when it catches them: a world-file entity of kind
// "watcher". The lamp is a real spot light that swings across the room, and "caught" is a real
// test too: the player is inside the beam's cone and a ray from the lamp reaches them without
// meeting a wall or pillar. So a pillar's shadow is genuine cover, and the picture on screen is
// the rule.
//
// She can be a lure: a partner standing at a "lure" beat in the lamp's sight draws the beam to
// herself for WATCHER_LURE_SECONDS, which leaves the player free to cross.
//
// Properties:
// - `facing_degrees` (number): the middle of the sweep, 0 is toward -Z, 180 toward +Z.
// - `sweep_degrees` (number, optional): how far either side of the middle the beam swings; 30.
// - `period_seconds` (number, optional): one full swing out and back; 8.
// - `pitch_degrees` (number, optional): how far the beam points down; 10.
// - `range` (number, optional): metres the beam reaches; 40.
// - `cone_degrees` (number, optional): half the beam's width, for the catching test; 9.
Watcher :: class {
public:
    entity: i64;
    lamp: lantern:::math:::Vec3;
    facingDegrees: f32;
    sweepDegrees: f32;
    periodSeconds: f32;
    pitchDegrees: f32;
    range: f32;
    coneDegrees: f32;
    beamDirection~ lantern:::math:::Vec3 = lantern:::math:::Vec3:::Zero();
    isLured~ bool = false;
    lureSecondsLeft~ f32 = 0.0f;
    forgiveSecondsLeft~ f32 = 0.0f;

    Watcher~: (entity: i64) : entity(entity), lamp(lantern:::world:::Position(entity)),
        facingDegrees(lantern:::world:::NumberProperty(entity, "facing_degrees")),
        sweepDegrees(Number(entity, "sweep_degrees", 30.0f)),
        periodSeconds(Number(entity, "period_seconds", 8.0f)),
        pitchDegrees(Number(entity, "pitch_degrees", 10.0f)),
        range(Number(entity, "range", 40.0f)),
        coneDegrees(Number(entity, "cone_degrees", 9.0f)) { }

    // Turns the lamp on. The target is only where it starts aiming; Update moves it every step.
    // Three things make the light easy to read at night. The beam is a strong amber, a colour
    // nothing else in the purple night uses. The lamp has a glowing housing, so you can see where
    // it hangs. And a glowing patch on the floor marks where the beam lands, as wide as the
    // catching cone is at that distance, so the patch is the danger zone.
    TurnOn~: (cubeMesh: i64) -> void {
        beamDirection = SweepDirection(0.0f);
        light = lantern:::lights:::AddSpot(lamp, lamp + beamDirection * 10.0f, BEAM_COLOR, BEAM_STRENGTH, range, 8.0f, 14.0f);
        lantern:::lights:::SetShadows(light, true);
        housing = lantern:::world:::Spawn("watcher_housing", lamp);
        lantern:::world:::SetMesh(housing, cubeMesh, BEAM_COLOR);
        lantern:::world:::SetScale(housing, { x: 0.7f, y: 0.5f, z: 0.7f });
        lantern:::world:::SetGlow(housing, BEAM_COLOR, HOUSING_GLOW);
        lantern:::world:::SetCastsShadows(housing, false);
        patch = lantern:::world:::Spawn("watcher_patch", lamp);
        lantern:::world:::SetMesh(patch, cubeMesh, BEAM_COLOR);
        lantern:::world:::SetGlow(patch, BEAM_COLOR, PATCH_GLOW);
        lantern:::world:::SetCastsShadows(patch, false);
        lantern:::world:::SetVisible(patch, false);
        isOn = true;
    }

    // Whether the lamp is on.
    IsOn :: () -> bool {
        return isOn;
    }

    TurnOff~: () -> void {
        guard isOn;
        lantern:::lights:::Remove(light);
        housing = 0;
        patch = 0;
        isOn = false;
    }

    // One step. `time` is the simulation clock, so the sweep is the same every run. `lureAt` is
    // where a luring partner stands, `isLuring` whether she is. Returns true when the beam has the
    // player: inside the cone, in sight, and not forgiven just now.
    Update~: (time: f32, playerCenter: lantern:::math:::Vec3, lureAt: lantern:::math:::Vec3, isLuring: bool, dt: f32) -> bool {
        guard isOn return false;
        if forgiveSecondsLeft > 0.0f {
            forgiveSecondsLeft -= dt;
        }
        if isLuring && CanSee(lureAt) {
            lureSecondsLeft = PartnerTuning:::WATCHER_LURE_SECONDS;
        } else if lureSecondsLeft > 0.0f {
            lureSecondsLeft -= dt;
        }
        isLured = lureSecondsLeft > 0.0f;
        if isLured {
            beamDirection = (lureAt - lamp).Normalized();
        } else {
            beamDirection = SweepDirection(time);
        }
        lantern:::lights:::Aim(light, lamp + beamDirection * 10.0f);
        MovePatch();
        guard forgiveSecondsLeft <= 0.0f return false;
        if IsInBeam(playerCenter) && CanSee(playerCenter) {
            forgiveSecondsLeft = PartnerTuning:::WATCHER_FORGIVE_SECONDS;
            return true;
        }
        return false;
    }

private:
    static BEAM_COLOR :: "FFA23C";    // amber: the one warm hue in a purple night
    static BEAM_STRENGTH :: 140.0f;   // was 40 in a pale yellow, which the night look swallowed
    static HOUSING_GLOW :: 6.0f;      // above 1, so the lamp blooms
    static PATCH_GLOW :: 1.6f;        // a lit floor, not a lamp: bright enough to read, below the bloom
    static PATCH_LIFT :: 0.04f;       // metres above the floor, so the patch doesn't fight the floor's own surface
    static FLOOR_NORMAL_Y :: 0.7f;    // a surface this level or flatter takes the patch; a wall doesn't

    isOn~ bool = false;
    light~ i64 = 0;
    housing~ i64 = 0;
    patch~ i64 = 0;

    // Puts the patch where the beam's middle meets the floor, as wide as the cone is there. A beam
    // that hits a wall, a pillar or nothing hides it. The ray looks only at what the physics world
    // holds, which is the same thing CanSee tests, so the patch never shows light the rule ignores.
    MovePatch~: () -> void {
        hit := lantern:::physics:::Raycast(lamp, beamDirection, range);
        when hit {
            ray: lantern:::physics:::RayHit -> {
                if ray.Normal().y > FLOOR_NORMAL_Y {
                    PlacePatch(ray);
                } else {
                    lantern:::world:::SetVisible(patch, false);
                }
            },
            null -> {
                lantern:::world:::SetVisible(patch, false);
            }
        }
    }

    PlacePatch~: (ray: lantern:::physics:::RayHit) -> void {
        coneRadians := coneDegrees * Math:::TAU / 360.0f;
        halfWidth := Math:::max(ray.Distance() * Math:::sin(coneRadians) / Math:::cos(coneRadians), 0.5f);
        lantern:::world:::SetPosition(patch, ray.Point() + lantern:::math:::Vec3 { y: PATCH_LIFT });
        lantern:::world:::SetScale(patch, { x: halfWidth * 2.0f, y: 0.03f, z: halfWidth * 2.0f });
        lantern:::world:::SetVisible(patch, true);
    }

    Number :: (entity: i64, key: string, fallback: f32) -> f32 {
        return lantern:::world:::HasProperty(entity, key) ? lantern:::world:::NumberProperty(entity, key) : fallback;
    }

    // The beam's direction at `time`: the middle yaw plus a swing, tipped down by the pitch. The
    // swing is a sine, so the beam lingers at each end and moves fastest across the middle.
    SweepDirection :: (time: f32) -> lantern:::math:::Vec3 {
        swing := sweepDegrees * Math:::sin(time / periodSeconds * Math:::TAU);
        yaw := (facingDegrees + swing) * Math:::TAU / 360.0f;
        pitch := pitchDegrees * Math:::TAU / 360.0f;
        flat := lantern:::math:::Vec3:::FromYaw(yaw);
        down: lantern:::math:::Vec3 = { y: -Math:::sin(pitch) };
        return flat * Math:::cos(pitch) + down;
    }

    // Inside the cone: the angle between the beam and the direction to the target is under
    // `coneDegrees`, tested as a cosine so no inverse trig is needed.
    IsInBeam :: (target: lantern:::math:::Vec3) -> bool {
        toTarget := target - lamp;
        guard toTarget.Length() < range return false;
        guard toTarget.Length() > 0.01f return false;
        cosine := toTarget.Normalized().Dot(beamDirection);
        return cosine > Math:::cos(coneDegrees * Math:::TAU / 360.0f);
    }

    // A ray from the lamp to the target meets nothing first.
    CanSee :: (target: lantern:::math:::Vec3) -> bool {
        toTarget := target - lamp;
        distance := toTarget.Length();
        guard distance > 0.01f return false;
        return when lantern:::physics:::Raycast(lamp, toTarget.Normalized(), distance) {
            hit: lantern:::physics:::RayHit -> hit.Distance() > distance - 0.5f,
            null -> true
        };
    }
}
