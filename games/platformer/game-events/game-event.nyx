// Things that happened in a fixed step, collected after physics and handled by the rules in
// the order they happened (Umbra snake-game/game-events).
GameEvent :: enum {
    GemTouched(gem: i64),
    PlayerFell,
    PlayerJumped,
    PlayerLanded(speed: f32),
    ResetPressed
}

// This step's events. A class, so systems can add to the same queue.
GameEvents :: class {
private:
    pending~ Array<GameEvent> = [];

public:
    Push~: (event: GameEvent) -> void {
        pending.add(event);
    }

    // Hands over everything queued so far and starts empty.
    Drain~: () -> Array<GameEvent> {
        drained := pending;
        pending = [];
        return drained;
    }
}
