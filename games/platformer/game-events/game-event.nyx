// Things that happened in a fixed step, collected after physics and handled by the rules in
// the order they happened (Umbra snake-game/game-events).
//
// Why events instead of systems calling the rules directly: the systems stay small and only
// report facts, the order things are handled in is the order they happened, and nothing reacts
// halfway through the physics while the world is still being updated.
GameEvent :: enum {
    GemTouched(gem: i64),
    PlayerFell,
    PlayerJumped,
    PlayerLanded(speed: f32),
    ResetPressed
}

// This step's events. A class, so systems can add to the same queue.
// (An Array is a value in Nyx: passing one to a function gives that function its own copy, so
// pushes would be lost. A class instance is shared, so every system pushes into the same list.)
GameEvents :: class {
private:
    pending~ Array<GameEvent> = [];

public:
    Push~: (event: GameEvent) -> void {
        pending.add(event);
    }

    // Hands over everything queued so far and starts empty.
    Drain~: () -> Array<GameEvent> {
        drained := pending;
        pending = [];
        return drained;
    }
}
