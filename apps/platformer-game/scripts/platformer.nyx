// Game rules for the Lantern platformer demo.
//
// Rust owns movement: the character controller, collision and transforms. This script owns
// what happens: the moving platform's path, collecting gems, and what falling or pressing reset
// does. The engine calls the hooks below from its fixed step (see docs/architecture.md); every
// write (Entity:::SetPosition, Sound:::Play, ...) is queued and applied by the game right after
// the hook returns. src/rules.rs has the same rules in Rust (NativeRules) for comparison and as
// the fallback when scripting is disabled.

PLATFORM_TRAVEL :: 6.0f;         // metres along -Z
PLATFORM_PERIOD :: 6.0f;         // seconds for a full there-and-back
HARD_LANDING_SPEED :: 4.0f;      // m/s; softer landings are silent
LOUDEST_LANDING_SPEED :: 15.0f;
MAX_GEMS :: 64;

Platformer :: class : Application {
private:
    gems~ Array<i64> = [];
    collected~ i32 = 0;
    platform~ i64 = 0;
    hasPlatform~ bool = false;
    platformStartX~ f32 = 0.0f;
    platformStartY~ f32 = 0.0f;
    platformStartZ~ f32 = 0.0f;

    ShowGemCount :: () -> void {
        Game:::SetStatus(`Gems ${collected:d} / ${gems.length():d}`);
    }

    // Shows every gem again and zeroes the count.
    RestartGems~: () -> void {
        collected = 0;
        for gem: i64 in gems {
            Entity:::SetVisible(gem, true);
        }
        ShowGemCount();
    }

public:
    Run :: () -> void { }

    OnStart~: () -> void {
        // Gems are the entities named gem_0, gem_1, ... up to the first missing number.
        gems = [];
        for (index~ i32 = 0; index < MAX_GEMS; index++) {
            when Entity:::Find(`gem_${index:d}`) {
                (gem) -> { gems.add(gem); },
                override -> { break; }
            }
        }
        when Entity:::Find("moving_platform") {
            (found) -> {
                platform = found;
                hasPlatform = true;
                start := Entity:::Position(found);
                platformStartX = start.X();
                platformStartY = start.Y();
                platformStartZ = start.Z();
            },
            override -> { Game:::Log("this level has no moving platform"); }
        }
        RestartGems();
        Game:::ShowMessage("Collect every gem!", 3.0f);
        Game:::Log(`rules started: ${gems.length():d} gems`);
    }

    OnFixedUpdate~: (dt: f32) -> void {
        guard hasPlatform;
        // A smooth back-and-forth: 0 at the start, 1 at the far end, 0 again after a period.
        phase := Game:::Time() / PLATFORM_PERIOD * Math:::TAU;
        offset := (0.5f - 0.5f * Math:::cos(phase)) * PLATFORM_TRAVEL;
        Entity:::SetPosition(platform, Vector:::New(platformStartX, platformStartY, platformStartZ - offset));
    }

    OnTriggerEnter~: (entity: i64) -> void {
        guard gems.contains(entity);
        guard Entity:::IsVisible(entity);
        collected += 1;
        Entity:::SetVisible(entity, false);
        Sound:::Play("pickup", 1.0f);
        ShowGemCount();
        if collected == gems.length() {
            Game:::ShowMessage("All gems collected!", 4.0f);
        }
    }

    OnPlayerFell~: () -> void {
        Sound:::Play("reset", 1.0f);
        Game:::ResetPlayer();
    }

    OnResetPressed~: () -> void {
        Sound:::Play("reset", 1.0f);
        Game:::ResetPlayer();
        RestartGems();
    }

    OnJump~: () -> void {
        Sound:::Play("jump", 0.8f);
    }

    OnLand~: (speed: f32) -> void {
        guard speed > HARD_LANDING_SPEED;
        Sound:::Play("land", Math:::min(speed / LOUDEST_LANDING_SPEED, 1.0f));
    }
}
