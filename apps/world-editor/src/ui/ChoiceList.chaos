ChoiceListProps :: data {
    choices: Array<string>;
    current: string;
    onPick: (choice: string) -> void;
}

ChoiceList :: (props: ChoiceListProps) -> Penumbra:::Component {
    return (
        <frame class="choice-list">
            <slot>
                !{props.choices.map((choice: string) ->
                    <frame key={choice} class={choice == props.current ? "choice-option-current" : "choice-option"}
                           onRelease={() -> props.onPick(choice)}>
                        <text class="choice-option-label">{choice}</text>
                    </frame>)}
            </slot>
        </frame>
    );
}
