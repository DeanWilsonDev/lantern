.inspector {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    flex-grow: 1;
}

.inspector-title {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
}

.inspector-scroll {
    flex-grow: 1;
}

.inspector-fields {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
}

.inspector-group {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    margin: 0px 0px 6px 0px;
}

.inspector-group-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 22px;
    padding: 0px 4px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-hover);
}

.inspector-group-chevron {
    color: var(--color-accent);
}

.inspector-group-title {
    color: var(--color-accent);
}

.inspector-group-fields {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    padding: 4px 0px 0px 0px;
}

.inspector-add-property {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    margin: 8px 0px 0px 0px;
    padding: 6px 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
}
