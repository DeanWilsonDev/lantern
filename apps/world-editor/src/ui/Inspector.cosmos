.inspector {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    flex-grow: 1;
}

.inspector-title {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
}

.inspector-scroll {
    flex-grow: 1;
}

.inspector-fields {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 3px;
}

.inspector-group {
    color: var(--color-accent);
    margin: var(--spacing-medium) 0px 2px 0px;
}
