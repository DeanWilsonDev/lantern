ConsoleFilters :: import ConsoleFilters;
ConsoleToggle :: import ConsoleToggle;
Editor :: import Editor;
EditorModel :: import EditorModel;
LogItem :: import LogItem;

ConsolePanel :: () -> Penumbra:::Component {
    @context editor~ Editor = new Editor();
    @context filters~ ConsoleFilters = new ConsoleFilters();
    return (
        <frame class="console">
            <frame class="console-header">
                <slot>
                    !{<frame class="console-toggles">
                        <ConsoleToggle label="Info" shown={filters.info} onToggle={(shown: bool) -> filters.SetLevel("info", shown)} />
                        <ConsoleToggle label="Warnings" shown={filters.warnings} onToggle={(shown: bool) -> filters.SetLevel("warning", shown)} />
                        <ConsoleToggle label="Errors" shown={filters.errors} onToggle={(shown: bool) -> filters.SetLevel("error", shown)} />
                    </frame>}
                </slot>
                <frame class="toolbar-spacer" />
                <frame class="small-button" onRelease={() -> editorClearLog()}>
                    <icon class="small-button-icon" icon="trash" size={12.0f} />
                    <text class="small-button-label">Clear</text>
                </frame>
            </frame>
            <scroll ref="console-scroll" class="console-scroll" wheelStep={60.0f}>
                <frame class="console-rows">
                    <slot>
                        !{filters.Shown(editor.document.log).map((item: LogItem) ->
                            <frame key={item.key} class="console-row">
                                <icon class={"console-icon-" + item.level} icon={EditorModel:::LogIcon(item.level)} size={12.0f} />
                                <text class={"console-text-" + item.level}>{item.text}</text>
                            </frame>)}
                    </slot>
                </frame>
            </scroll>
        </frame>
    );
}
