AddMenuItems :: import AddMenuItems;
AssetCard :: import AssetCard;
Editor :: import Editor;
EditorModel :: import EditorModel;
TemplateItem :: import TemplateItem;

// The Silhouettes whose name or label holds the search text (all of them when it is empty), in rows of a few cards each,
// since a row of frames is the way to lay cards out in a grid.
SilhouettePickerUi :: namespace {
    CARDS_PER_ROW: i32 : 3;

    Matching :: (query: string) -> Array<TemplateItem> {
        needle := query.trim().toLower();
        found~ Array<TemplateItem> = [];
        for template in EditorModel:::Templates() {
            guard template.fromSilhouette continue;
            if needle == "" || template.label.toLower().contains(needle) || template.id.toLower().contains(needle) {
                found.add(template);
            }
        }
        return found;
    }

    Rows :: (items: Array<TemplateItem>) -> Array<Array<TemplateItem>> {
        rows~ Array<Array<TemplateItem>> = [];
        row~ Array<TemplateItem> = [];
        for item in items {
            row.add(item);
            if row.length() == CARDS_PER_ROW {
                rows.add(row);
                row = [];
            }
        }
        if row.length() > 0 {
            rows.add(row);
        }
        return rows;
    }

    // The first card's key in a row, which names the row.
    RowKey :: (row: Array<TemplateItem>) -> string {
        return row.length() > 0 ? `silhouette-row-${row[0].id}` : "silhouette-row-empty";
    }
}

// The Add menu's Silhouettes page: a search box over a scrolling grid of the project's Silhouettes, each a card with a
// live thumbnail, like a small file browser, so a project with hundreds of them stays easy to search. Pressing a card
// places that Silhouette in front of the camera; dragging it drops it where the mouse lets go in the viewport, as the
// drawer's cards do. `query` is the picker's own state.
SilhouettePicker :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal query~ string = "";
    return (
        <frame ref="silhouette-picker" class="silhouette-picker">
            <frame class="search-row">
                <icon class="search-icon" icon="search" size={12.0f} />
                <input ref="silhouette-picker-search" class="search-input" text={query} preferredWidth={300.0f}
                       onTextChange={(text: string) -> { query = text; }} />
            </frame>
            <scroll ref="silhouette-picker-scroll" class="silhouette-picker-scroll" direction="vertical">
                <frame class="silhouette-picker-rows">
                    <slot>
                        !{(() -> Penumbra:::Component {
                            matches := SilhouettePickerUi:::Matching(query);
                            return matches.length() == 0
                                ? <text class="menu-entry-label-disabled">No Silhouette matches</text>
                                : <frame class="silhouette-picker-rows">
                                      <slot>
                                          !{SilhouettePickerUi:::Rows(matches).map((row: Array<TemplateItem>) ->
                                              <frame key={SilhouettePickerUi:::RowKey(row)} class="asset-cards">
                                                  <slot>
                                                      !{row.map((item: TemplateItem) ->
                                                          <AssetCard key={`pick-${item.id}`} item={item} selected={false}
                                                                     onSelect={() -> editor.commands.RunCommand(AddMenuItems:::PlaceCommand(item.id))} />)}
                                                  </slot>
                                              </frame>)}
                                      </slot>
                                  </frame>;
                        })()}
                    </slot>
                </frame>
            </scroll>
        </frame>
    );
}
