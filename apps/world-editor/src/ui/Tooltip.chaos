EditorUi :: import EditorUi;

Tooltip :: () -> Penumbra:::Component {
    return (
        <portal ref="tooltip" x={EditorUi:::App().TooltipX()} y={EditorUi:::App().TooltipY()} width={EditorUi:::App().TooltipWidth()} height={EditorUi:::App().TooltipHeight()}
                dismissOnOutsideClick={false}>
            <frame class="tooltip">
                <text class="tooltip-text">{EditorUi:::App().TooltipText()}</text>
            </frame>
        </portal>
    );
}
