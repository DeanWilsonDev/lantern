Editor :: import Editor;

ViewportPaneUi :: namespace {
    ControlsHint :: () -> string {
        return "Right-drag orbit · Shift+right-drag or middle-drag pan · wheel zoom · hold right + WASDQE fly · left-drag box select";
    }
}

ViewportPane :: () -> Penumbra:::Component {
    @context editor~ Editor = new Editor();
    return (
        <frame ref="viewport-pane" class="viewport-pane">
            <frame class="viewport-header">
                <slot>
                    !{<text class="viewport-camera">{editor.document.status.camera}</text>}
                </slot>
                <frame class="toolbar-spacer" />
                <slot>
                    !{<text class="viewport-hint">{editor.document.status.handle == ""
                        ? ViewportPaneUi:::ControlsHint()
                        : "Drag " + editor.document.status.handle}</text>}
                </slot>
            </frame>
            <viewport ref="viewport" class="viewport" renderer="level"
                      onDrop={(payload: string) -> editor.selection.DropOnViewport(payload)} />
        </frame>
    );
}
