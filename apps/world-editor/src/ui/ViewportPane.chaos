EditorUi :: import EditorUi;

ViewportPane :: () -> Penumbra:::Component {
    return (
        <frame ref="viewport-pane" class="viewport-pane">
            <frame class="viewport-header">
                <slot>
                    !{<text class="viewport-camera">{EditorUi:::App().Status().camera}</text>}
                </slot>
                <frame class="toolbar-spacer" />
                <slot>
                    !{<text class="viewport-hint">{EditorUi:::App().Status().handle == ""
                        ? EditorUi:::App().ControlsHint()
                        : "Drag " + EditorUi:::App().Status().handle}</text>}
                </slot>
            </frame>
            <viewport ref="viewport" class="viewport" renderer="level"
                      onDrop={(payload: string) -> EditorUi:::App().DropOnViewport(payload)} />
        </frame>
    );
}
