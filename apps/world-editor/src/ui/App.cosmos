.app-root {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--color-window-background);
}

.app-content {
    flex-grow: 1;
}

.nothing {
    width: 0px;
    height: 0px;
}

.panel {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    padding: var(--spacing-medium) var(--spacing-medium);
    margin: 0px var(--panel-gap) var(--panel-gap) var(--panel-gap);
}

.panel-bottom {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    padding: var(--spacing-small) var(--spacing-medium);
    margin: var(--panel-gap) 0px var(--panel-gap) 0px;
}

.panel-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 22px;
}

.panel-header-icon {
    color: var(--color-text-disabled);
}

.panel-title {
    color: var(--color-text-disabled);
}

.panel-count {
    color: var(--color-text-disabled);
    font-size: 11px;
}

.toolbar-spacer {
    flex-grow: 1;
    height: 1px;
}

.search-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    padding: 2px var(--spacing-small);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.search-icon {
    color: var(--color-text-disabled);
}

.search-input {
    color: var(--color-text-primary);
    background-color: #00000000;
    border-width: 0px;
    flex-grow: 1;
    padding: 2px 0px;
}

.small-button {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.small-button:hover {
    background-color: var(--color-row-hover);
}

.small-button-icon {
    color: var(--color-text-primary);
}

.small-button-label {
    color: var(--color-text-primary);
}

.small-button-accent {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 3px 12px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-accent);
    background-color: var(--color-accent);
}

.small-button-accent:hover {
    background-color: var(--color-accent-hovered);
}

.small-button-icon-accent {
    color: var(--color-accent-label);
}

.small-button-label-accent {
    color: var(--color-accent-label);
}

.tab-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.tab {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 5px;
    padding: 4px 12px;
    border-radius: var(--border-radius-small);
}

.tab:hover {
    background-color: var(--color-row-hover);
}

.tab-active {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 5px;
    padding: 4px 12px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.tab-label {
    color: var(--color-text-disabled);
}

.tab-label-active {
    color: var(--color-text-primary);
}

.status-bar {
    display: stack;
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0px var(--panel-padding-horizontal);
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
}

.status-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-large);
    flex-grow: 1;
}

.status-text {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    flex-grow: 1;
}

.status-chip {
    color: var(--color-text-disabled);
    font-size: 11px;
}

.status-chip-live {
    color: var(--color-text-good);
    font-size: 11px;
}

.status-chip-hidden {
    width: 0px;
    height: 0px;
}
