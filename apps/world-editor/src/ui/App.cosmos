/* The frame of the whole editor and the pieces every panel shares. `display: stack` is Cosmos's flexible layout:
   `flex-direction` runs it as a row or a column and `flex-grow: 1` takes whatever room is left. This file holds the
   window and panel frames, the small buttons and tabs several components use, the status bar, the document tabs and
   the entity page's layout. The other .cosmos files in this folder style one component each, and all of them are
   merged into one sheet, so a class name may be used only once. */
.app-root {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--color-window-background);
}

.app-content {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
}

.workspace-fill {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
}

/* The stand-in a slot shows when it has nothing to show: a frame with no size. */
.nothing {
    width: 0px;
    height: 0px;
}

/* The framed boxes that hold the outliner and the details; .panel-bottom is the one under the viewport. */
.panel {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    padding: var(--spacing-medium) var(--spacing-medium);
    margin: 0px var(--panel-gap) var(--panel-gap) var(--panel-gap);
}

.panel-bottom {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    padding: var(--spacing-small) var(--spacing-medium);
    margin: var(--panel-gap) 0px var(--panel-gap) 0px;
}

/* The header row of a panel: an icon, a title and a count. */
.panel-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 22px;
}

.panel-header-icon {
    color: var(--color-text-disabled);
}

.panel-title {
    color: var(--color-text-disabled);
}

.panel-count {
    color: var(--color-text-disabled);
    font-size: 11px;
}

.toolbar-spacer {
    flex-grow: 1;
    height: 1px;
}

/* A search box with its magnifying glass, used by the outliner, the asset browser and the menus that filter. */
.search-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    padding: 2px var(--spacing-small);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.search-icon {
    color: var(--color-text-disabled);
}

.search-input {
    color: var(--color-text-primary);
    background-color: #00000000;
    border-width: 0px;
    flex-grow: 1;
    padding: 2px 0px;
}

/* The two kinds of small button: a plain one and an accent (blue) one for the main action of a dialog or panel. */
.small-button {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.small-button:hover {
    background-color: var(--color-row-hover);
}

.small-button-icon {
    color: var(--color-text-primary);
}

.small-button-label {
    color: var(--color-text-primary);
}

.small-button-accent {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 3px 12px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-accent);
    background-color: var(--color-accent);
}

.small-button-accent:hover {
    background-color: var(--color-accent-hovered);
}

.small-button-icon-accent {
    color: var(--color-accent-label);
}

.small-button-label-accent {
    color: var(--color-accent-label);
}

/* The row of tabs under a panel header, with the plain and the active tab. */
.tab-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.tab {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 5px;
    padding: 4px 12px;
    border-radius: var(--border-radius-small);
}

.tab:hover {
    background-color: var(--color-row-hover);
}

.tab-active {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 5px;
    padding: 4px 12px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.tab-label {
    color: var(--color-text-disabled);
}

.tab-label-active {
    color: var(--color-text-primary);
}

/*
 * The bar along the bottom. A chip is one piece of status text; the live chip is green and the hidden one takes no
 * room.
 */
.status-bar {
    display: stack;
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0px var(--panel-padding-horizontal);
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
}

.status-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-large);
    flex-grow: 1;
}

.status-text {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    flex-grow: 1;
}

.status-chip {
    color: var(--color-text-disabled);
    font-size: 11px;
}

.status-chip-live {
    color: var(--color-text-good);
    font-size: 11px;
}

.status-chip-hidden {
    width: 0px;
    height: 0px;
}

/* The tab row above the viewport, with its close crosses. */
.document-tabs {
    display: stack;
    flex-direction: row;
    align-items: stretch;
    padding: 4px var(--spacing-small) 0px var(--spacing-small);
    background-color: var(--color-panel-background);
}

.document-tab-row {
    display: stack;
    flex-direction: row;
    align-items: end;
    gap: 2px;
}

.document-tab {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--border-radius-small);
}

.document-tab:hover {
    background-color: var(--color-row-hover);
}

.document-tab-active {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.document-tab-close {
    display: stack;
    align-items: center;
    padding: 2px;
    border-radius: var(--border-radius-small);
}

.document-tab-close:hover {
    background-color: var(--color-row-hover);
}

.document-tab-close-glyph {
    color: var(--color-text-disabled);
}

/* The entity, Silhouette and graph pages: a header, then columns (a list on the left and fields on the right). */
.entity-page {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    margin: var(--panel-gap) 0px 0px 0px;
    padding: var(--spacing-large);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    background-color: var(--color-window-background);
}

.entity-page-body {
    display: stack;
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-medium);
}

.entity-page-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-medium);
}

.entity-page-title {
    color: var(--color-text-primary);
    font-size: 16px;
}

.entity-page-kind {
    color: var(--color-text-disabled);
}

.entity-page-heading {
    color: var(--color-text-primary);
    margin: var(--spacing-medium) 0px 0px 0px;
}

.entity-page-columns {
    display: stack;
    flex-direction: row;
    align-items: stretch;
    gap: var(--spacing-large);
    flex-grow: 1;
}

.entity-page-list {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    width: 220px;
}

.entity-page-picture {
    height: 200px;
    border-radius: var(--border-radius-small);
}

.entity-page-fields-scroll {
    flex-grow: 1;
}

.entity-page-fields {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    max-width: 640px;
}

.entity-page-component-selected {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-medium);
    padding: 6px 10px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.entity-page-component {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-medium);
    padding: 6px 10px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-panel-background);
}

.entity-page-component-name {
    color: var(--color-text-primary);
}

.entity-page-component:hover {
    background-color: var(--color-row-hover);
}

.entity-page-component-count {
    color: var(--color-text-disabled);
}

.chip-column {
    display: stack;
    flex-direction: column;
    align-items: start;
    gap: 4px;
}

.silhouette-side {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    width: 330px;
}

/* The Terrain page of the drawer: its three columns of settings side by side. */
.terrain-panel {
    display: stack;
    flex-direction: row;
    align-items: start;
    gap: 24px;
    flex-grow: 1;
}

.terrain-column {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
}
