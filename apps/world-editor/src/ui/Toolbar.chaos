EditorUi :: import EditorUi;
TemplateItem :: import TemplateItem;
ToolbarButton :: import ToolbarButton;
ToolbarState :: import ToolbarState;

Toolbar :: () -> Penumbra:::Component {
    return (
        <frame ref="toolbar" class="toolbar">
            <frame class="toolbar-row">
                <ToolbarButton label="New" onPress={() -> EditorUi:::App().NewWorld()} />
                <ToolbarButton label="Save" onPress={() -> EditorUi:::App().Save()} />
                <input ref="path-input" class="path-field" text={EditorUi:::App().PathDraft()} preferredWidth={360.0f}
                       onTextChange={(text: string) -> EditorUi:::App().SetPathDraft(text)} />
                <ToolbarButton label="Open" onPress={() -> EditorUi:::App().OpenPathDraft()} />
                <ToolbarButton label="Save As" onPress={() -> EditorUi:::App().SaveAsPathDraft()} />
                <frame class="toolbar-separator" />
                <slot>
                    !{(() -> Penumbra:::Component {
                        state := EditorUi:::App().CurrentToolbar();
                        return (
                            <frame class="toolbar-group">
                                <ToolbarButton label="Undo" enabled={state.canUndo} onPress={() -> EditorUi:::App().Undo()} />
                                <ToolbarButton label="Redo" enabled={state.canRedo} onPress={() -> EditorUi:::App().Redo()} />
                                <frame class="toolbar-separator" />
                                <ToolbarButton label="Move" active={state.tool == "move"}
                                               onPress={() -> EditorUi:::App().SetTool("move")} />
                                <ToolbarButton label="Rotate" active={state.tool == "rotate"}
                                               onPress={() -> EditorUi:::App().SetTool("rotate")} />
                                <ToolbarButton label="Scale" active={state.tool == "scale"}
                                               onPress={() -> EditorUi:::App().SetTool("scale")} />
                                <ToolbarButton label="Snap" active={state.snap} onPress={() -> EditorUi:::App().ToggleSnap()} />
                                <frame class="toolbar-separator" />
                                <ToolbarButton label="Frame" onPress={() -> EditorUi:::App().FrameSelection()} />
                                <ToolbarButton label="Duplicate" enabled={state.hasSelection}
                                               onPress={() -> EditorUi:::App().DuplicateSelection()} />
                                <ToolbarButton label="Delete" enabled={state.hasSelection}
                                               onPress={() -> EditorUi:::App().DeleteSelection()} />
                            </frame>
                        );
                    })()}
                </slot>
            </frame>
            <frame class="toolbar-row">
                <text class="toolbar-label">Add</text>
                <slot>
                    !{EditorUi:::App().Templates().map((item: TemplateItem) ->
                        <ToolbarButton key={item.id} label={item.label}
                                       onPress={() -> EditorUi:::App().AddEntity(item.id)} />)}
                </slot>
            </frame>
        </frame>
    );
}
