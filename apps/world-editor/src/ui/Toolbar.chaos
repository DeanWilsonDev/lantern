Editor :: import Editor;
IconButton :: import IconButton;
ToolbarState :: import ToolbarState;
TooltipArea :: import TooltipArea;

// What the toolbar shows for Play and Pause, worked out from the toolbar state.
ToolbarUi :: namespace {
    // Play is white while nothing runs and green while the game is running; pressing it then stops the game.
    PlayClass :: (state: ToolbarState) -> string {
        return state.playing ? "play-button-playing" : "play-button";
    }

    PlayLabel :: (state: ToolbarState) -> string {
        return state.playing ? "Stop" : "Play";
    }

    PlayTooltip :: (state: ToolbarState) -> string {
        return state.playing ? "Stop playing (Ctrl+P)" : "Play the level (Ctrl+P)";
    }

    // Pause sits beside Play only while the game runs, and turns orange while the game is paused.
    PauseClass :: (state: ToolbarState) -> string {
        return state.paused ? "pause-button-active" : "pause-button";
    }
}

// The row under the menu bar, kept to what is used all the time: Play (and Pause while the game runs) in the middle,
// and the command palette and settings on the right. There is no mode switcher: the terrain tools turn up in the tool
// palette when a terrain is selected, and picking one enters Terrain mode. Everything else the toolbar used to
// hold is in the menus (New, Open and Save under File; Undo, Redo, Duplicate and Delete under Edit), the tools are in
// the tool palette, and snap, space and pivot are toggles in the viewport's header. The left and right groups are the
// same width so Play sits in the middle of the window. The row is rebuilt inside one <slot> from editor.document.toolbar,
// so a change to it redraws just this row.
Toolbar :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="toolbar" class="toolbar">
            <slot>
                !{(() -> Penumbra:::Component {
                    state := editor.document.toolbar;
                    return (
                        <frame class="toolbar-row">
                            <frame class="toolbar-side" />
                            <frame class="toolbar-spacer" />
                            <frame class="play-controls">
                                <TooltipArea text={ToolbarUi:::PlayTooltip(state)}>
                                    <frame ref="play-button" class={ToolbarUi:::PlayClass(state)}
                                           onRelease={() -> editor.commands.RunCommand(state.playing ? "stop" : "play")}>
                                        <icon class="play-button-icon" icon={state.playing ? "stop" : "play"} size={13.0f} />
                                        <text class="play-button-label">{ToolbarUi:::PlayLabel(state)}</text>
                                    </frame>
                                </TooltipArea>
                                <slot>
                                    !{state.playing
                                        ? <TooltipArea text={state.paused ? "Resume the game" : "Pause the game"}>
                                              <frame ref="pause-button" class={ToolbarUi:::PauseClass(state)}
                                                     onRelease={() -> editor.commands.RunCommand(state.paused ? "resume" : "pause")}>
                                                  <icon class={state.paused ? "pause-button-icon-active" : "pause-button-icon"} icon="pause" size={13.0f} />
                                              </frame>
                                          </TooltipArea>
                                        : <frame class="nothing" />}
                                </slot>
                            </frame>
                            <frame class="toolbar-spacer" />
                            <frame class="toolbar-side-end">
                                <IconButton tooltipPlacement="end" icon="command" tooltip="Command palette (Ctrl+Shift+P)"
                                            onPress={() -> editor.commands.RunCommand("commandPalette")} />
                                <IconButton tooltipPlacement="end" icon="gear" tooltip="Settings (Ctrl+,)"
                                            onPress={() -> editor.commands.RunCommand("settings")} />
                            </frame>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
