Editor :: import Editor;
IconButton :: import IconButton;
ToolbarState :: import ToolbarState;

ToolbarUi :: namespace {
    CameraPresets :: () -> Array<string> {
        return ["perspective", "top", "bottom", "front", "back", "left", "right"];
    }

    CurrentPreset :: (state: ToolbarState) -> string {
        return state.orthographic ? "orthographic" : "perspective";
    }
}

Toolbar :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="toolbar" class="toolbar">
            <slot>
                !{(() -> Penumbra:::Component {
                    state := editor.document.toolbar;
                    return (
                        <frame class="toolbar-row">
                            <IconButton icon="document" tooltip="New world (Ctrl+N)"
                                        onPress={() -> editor.commands.RunCommand("new")} />
                            <IconButton icon="folder-open" tooltip="Open… (Ctrl+O)"
                                        onPress={() -> editor.commands.RunCommand("open")} />
                            <IconButton icon="save" tooltip="Save (Ctrl+S)"
                                        onPress={() -> editor.commands.RunCommand("save")} />
                            <frame class="toolbar-separator" />
                            <IconButton icon="undo" tooltip="Undo (Ctrl+Z)" enabled={state.canUndo}
                                        onPress={() -> editor.commands.RunCommand("undo")} />
                            <IconButton icon="redo" tooltip="Redo (Ctrl+Shift+Z)" enabled={state.canRedo}
                                        onPress={() -> editor.commands.RunCommand("redo")} />
                            <frame class="toolbar-separator" />
                            <IconButton icon="move" tooltip="Move (W)" active={state.tool == "move"}
                                        onPress={() -> editorSetTool("move")} />
                            <IconButton icon="rotate" tooltip="Rotate (E)" active={state.tool == "rotate"}
                                        onPress={() -> editorSetTool("rotate")} />
                            <IconButton icon="scale" tooltip="Scale (R)" active={state.tool == "scale"}
                                        onPress={() -> editorSetTool("scale")} />
                            <frame class="toolbar-separator" />
                            <IconButton icon="magnet" tooltip="Snap to grid" active={state.snap}
                                        onPress={() -> editor.commands.RunCommand("toggleSnap")} />
                            <IconButton icon={state.space == "local" ? "local-space" : "world-space"}
                                        tooltip={state.space == "local" ? "Local space (X)" : "World space (X)"}
                                        active={state.space == "local"}
                                        onPress={() -> editor.commands.RunCommand("toggleSpace")} />
                            <IconButton icon="pivot" tooltip={state.pivot == "center" ? "Pivot at center (Z)" : "Pivot at primary (Z)"}
                                        active={state.pivot == "center"}
                                        onPress={() -> editor.commands.RunCommand("togglePivot")} />
                            <frame class="toolbar-separator" />
                            <IconButton icon="crosshair" tooltip="Frame selection (F)" enabled={state.hasSelection}
                                        onPress={() -> editor.commands.RunCommand("frameSelection")} />
                            <IconButton icon="copy" tooltip="Duplicate (Ctrl+D)" enabled={state.hasSelection}
                                        onPress={() -> editor.commands.RunCommand("duplicate")} />
                            <IconButton icon="layers" tooltip="Group (Ctrl+G)" enabled={state.hasSelection}
                                        onPress={() -> editor.commands.RunCommand("group")} />
                            <IconButton icon="trash" tooltip="Delete (Delete)" enabled={state.hasSelection}
                                        onPress={() -> editor.commands.RunCommand("delete")} />
                            <frame class="toolbar-separator" />
                            <IconButton icon={state.playing ? "stop" : "play"}
                                        tooltip={state.playing ? "Stop playing (Ctrl+P)" : "Play level (Ctrl+P)"}
                                        active={state.playing}
                                        onPress={() -> editor.commands.RunCommand(state.playing ? "stop" : "play")} />
                            <frame class="toolbar-spacer" />
                            <text class="toolbar-label">Camera</text>
                            <select ref="camera-preset" class="toolbar-select" options={ToolbarUi:::CameraPresets()}
                                    selected={ToolbarUi:::CurrentPreset(state)}
                                    onSelect={(preset: string) -> { editorCameraPreset(preset); }} />
                            <frame class="toolbar-separator" />
                            <IconButton tooltipPlacement="end" icon="grid" tooltip="Grid (G)" active={state.showGrid}
                                        onPress={() -> editor.commands.RunCommand("toggleGrid")} />
                            <IconButton tooltipPlacement="end" icon="wireframe" tooltip="Wireframe" active={state.wireframe}
                                        onPress={() -> editor.commands.RunCommand("toggleWireframe")} />
                            <IconButton tooltipPlacement="end" icon="collider" tooltip="Colliders" active={state.showColliders}
                                        onPress={() -> editor.commands.RunCommand("toggleColliders")} />
                            <IconButton tooltipPlacement="end" icon="flag" tooltip="Markers" active={state.showMarkers}
                                        onPress={() -> editor.commands.RunCommand("toggleMarkers")} />
                            <IconButton tooltipPlacement="end" icon={state.showHidden ? "eye" : "eye-off"} tooltip="Show hidden entities"
                                        active={state.showHidden}
                                        onPress={() -> editor.commands.RunCommand("toggleShowHidden")} />
                            <IconButton tooltipPlacement="end" icon="chart-bar" tooltip="Statistics" active={state.showStats}
                                        onPress={() -> editor.commands.RunCommand("toggleStats")} />
                            <frame class="toolbar-separator" />
                            <IconButton tooltipPlacement="end" icon="command" tooltip="Command palette (Ctrl+Shift+P)"
                                        onPress={() -> editor.commands.RunCommand("commandPalette")} />
                            <IconButton tooltipPlacement="end" icon="gear" tooltip="Settings (Ctrl+,)"
                                        onPress={() -> editor.commands.RunCommand("settings")} />
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
