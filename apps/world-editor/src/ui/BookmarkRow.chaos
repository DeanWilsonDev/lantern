Editor :: import Editor;

BookmarkRowProps :: data {
    slot: string;
}

BookmarkRow :: (props: BookmarkRowProps) -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame class="setting-row">
            <text class="setting-label-wide">{"Bookmark " + props.slot}</text>
            <frame class="small-button" onRelease={() -> editor.commands.RunCommand("bookmarkSet:" + props.slot)}>
                <text class="small-button-label">Set to this view</text>
            </frame>
            <frame class="small-button" onRelease={() -> editor.commands.RunCommand("bookmarkGo:" + props.slot)}>
                <text class="small-button-label">Go</text>
            </frame>
        </frame>
    );
}
