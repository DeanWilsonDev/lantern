EditorOverlays :: import EditorOverlays;

EditorSelection :: class {
public:
    overlays~ EditorOverlays;
    hoveredEntity~ i64 = 0;
    additive~ bool = false;

    EditorSelection~: (overlays~ EditorOverlays) {
        this.overlays = overlays;
    }

    Select~: (id: i64) -> void {
        editorSelect(id, this.additive);
    }

    Hover~: (id: i64) -> void { this.hoveredEntity = id; }

    Unhover~: (id: i64) -> void {
        if this.hoveredEntity == id {
            this.hoveredEntity = 0;
        }
    }

    PollContextMenu~: () -> void {
        guard penumbra:::wasSecondaryMouseButtonPressed() && this.hoveredEntity != 0 return;
        if !editorIsSelected(this.hoveredEntity) {
            editorSelect(this.hoveredEntity, false);
        }
        this.overlays.OpenContextMenu(this.hoveredEntity);
    }

    DropOnViewport:: (payload: string) -> void {
        guard payload.startsWith("template:") return;
        editorAddEntityAtCursor(payload.substring(9, payload.length() - 9));
    }
}
