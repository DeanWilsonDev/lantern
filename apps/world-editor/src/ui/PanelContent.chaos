AssetPreview :: import AssetPreview;
BottomPanel :: import BottomPanel;
DockablePanel :: import DockablePanel;
Inspector :: import Inspector;
Outliner :: import Outliner;
SilhouettesPanel :: import SilhouettesPanel;

// Which panel to show.
PanelContentProps :: data {
    panel: string;
}

// One of the movable panels by name, in its movable frame: the outliner, the details panel, the Silhouettes panel, the
// asset preview or the content drawer. The drawer keeps its own, roomier style.
PanelContent :: (props: PanelContentProps) -> Penumbra:::Component {
    return when props.panel {
        "outliner" -> <DockablePanel key="panel-outliner" panel="outliner"><Outliner /></DockablePanel>,
        "details" -> <DockablePanel key="panel-details" panel="details"><Inspector /></DockablePanel>,
        "silhouettes" -> <DockablePanel key="panel-silhouettes" panel="silhouettes"><SilhouettesPanel /></DockablePanel>,
        "preview" -> <DockablePanel key="panel-preview" panel="preview"><AssetPreview /></DockablePanel>,
        default -> <DockablePanel key="panel-drawer" panel="drawer" panelClass="panel-bottom"><BottomPanel /></DockablePanel>
    };
}
