BottomPanel :: import BottomPanel;
DockablePanel :: import DockablePanel;
Inspector :: import Inspector;
Outliner :: import Outliner;

// Which panel to show.
PanelContentProps :: data {
    panel: string;
}

// One of the three movable panels by name, in its movable frame: the outliner, the details panel or the content drawer.
// The drawer keeps its own, roomier style.
PanelContent :: (props: PanelContentProps) -> Penumbra:::Component {
    return props.panel == "outliner"
        ? <DockablePanel key="panel-outliner" panel="outliner"><Outliner /></DockablePanel>
        : props.panel == "details"
        ? <DockablePanel key="panel-details" panel="details"><Inspector /></DockablePanel>
        : <DockablePanel key="panel-drawer" panel="drawer" panelClass="panel-bottom"><BottomPanel /></DockablePanel>;
}
