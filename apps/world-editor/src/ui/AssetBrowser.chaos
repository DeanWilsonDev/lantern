AssetCard :: import AssetCard;
EditorUi :: import EditorUi;
TemplateItem :: import TemplateItem;

AssetBrowser :: () -> Penumbra:::Component {
    return (
        <frame class="asset-browser">
            <scroll ref="asset-scroll" class="asset-scroll" direction="horizontal" horizontalWheelStep={80.0f}>
                <frame class="asset-cards">
                    <slot>
                        !{EditorUi:::App().Templates().map((item: TemplateItem) ->
                            <AssetCard key={item.id} item={item} />)}
                    </slot>
                </frame>
            </scroll>
            <frame class="asset-preview">
                <viewport ref="asset-preview-viewport" class="asset-preview-viewport" renderer="preview" />
                <frame class="asset-preview-actions">
                    <slot>
                        !{<text class="asset-preview-title">{EditorUi:::App().PreviewTemplate()}</text>}
                    </slot>
                    <frame class="small-button-accent"
                           onRelease={() -> EditorUi:::App().AddEntity(EditorUi:::App().PreviewTemplate())}>
                        <icon class="small-button-icon-accent" icon="plus" size={12.0f} />
                        <text class="small-button-label-accent">Add to world</text>
                    </frame>
                </frame>
            </frame>
        </frame>
    );
}
