AssetCard :: import AssetCard;
AssetFileCard :: import AssetFileCard;
Editor :: import Editor;
TemplateItem :: import TemplateItem;

// One thing in a folder listing: its kind (`folder`, `silhouette`, `script`, `texture` and so on), the name to show,
// and its
// path. The engine returns the listing as lines of three tab-separated fields, which Entries turns into these.
AssetEntry :: data {
    kind: string;
    label: string;
    path: string;
}

// Entries asks the engine for a folder's contents (or, with a query, every match). ParentOf, RootOf and Title work on
// folder paths written `A/B/C`: the folder above, the top-level folder, and the heading with `>` between the levels.
// TreeClass highlights the root the current folder is inside.
AssetBrowserUi :: namespace {
    Entries :: (folder: string, query: string) -> Array<AssetEntry> {
        rows~ Array<AssetEntry> = [];
        for line in editorAssetEntries(folder, query).split("\n") {
            parts := line.split("\t");
            if parts.length() == 3 {
                rows.add(AssetEntry { kind: parts[0], label: parts[1], path: parts[2] });
            }
        }
        return rows;
    }

    ParentOf :: (folder: string) -> string {
        guard folder.contains("/") return "";
        pieces := folder.split("/");
        rest~ string = "";
        for position~ i32 = 0; position < pieces.length() - 1; position++ {
            rest = position == 0 ? pieces[0] : `${rest}/${pieces[position]}`;
        }
        return rest;
    }

    Title :: (folder: string, query: string) -> string {
        if query != "" {
            return `Search: ${query}`;
        }
        return folder == "" ? "Content" : folder.replace("/", "  >  ");
    }

    RootOf :: (folder: string) -> string {
        guard folder.contains("/") return folder;
        return folder.split("/")[0];
    }

    TreeClass :: (root: string, folder: string) -> string {
        return RootOf(folder) == root ? "tree-row-selected" : "tree-row";
    }
}

// The Assets tab, in two columns: a tree of top-level folders on the left, and the cards of the current folder on the
// right (with an up button, the path, a search box and Add scene, which places a chosen world file as a scene
// instance). The cards wrap into a grid as wide as the tab and scroll up and down. The @signals are the page's own
// state: the folder, the search text and the chosen card. Clicking a folder card opens it, clicking a graph card opens
// it in the graph tab, clicking a Silhouette shows it in the asset preview panel, and dragging a Silhouette into the
// viewport places it where it is dropped.
AssetBrowser :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal folder~ string = "Silhouettes";
    @signal query~ string = "";
    @signal chosen~ string = "";
    return (
        <frame class="asset-browser">
            <frame class="asset-tree">
                <text class="entity-page-heading">Folders</text>
                <scroll ref="asset-tree-scroll" class="asset-scroll" wheelStep={40.0f}>
                <slot>
                    !{AssetBrowserUi:::Entries("", "").map((root: AssetEntry) ->
                        <frame key={`tree-${root.path}`} ref={`tree-${root.path}`} class={AssetBrowserUi:::TreeClass(root.path, folder)}
                               onPress={() -> { folder = root.path; query = ""; }}>
                            <icon class="asset-kind-icon" icon="folder" size={12.0f} />
                            <text class="asset-label">{root.label}</text>
                        </frame>)}
                </slot>
                </scroll>
            </frame>
            <frame class="asset-main">
                <frame class="asset-bar">
                    <frame ref="asset-up" class="small-button"
                           onRelease={() -> { folder = AssetBrowserUi:::ParentOf(folder); query = ""; }}>
                        <icon class="small-button-icon" icon="chevron-left" size={12.0f} />
                    </frame>
                    <slot>
                        !{<text class="asset-path">{AssetBrowserUi:::Title(folder, query)}</text>}
                    </slot>
                    <icon class="search-icon" icon="search" size={12.0f} />
                    <input ref="asset-search" class="search-input" text={query}
                           preferredWidth={150.0f}
                           onTextChange={(text: string) -> { query = text; }} />
                    <frame ref="asset-add-scene" class="small-button"
                           onRelease={() -> {
                               if chosen.endsWith(".world.json") {
                                   editorAddSceneInstance(chosen);
                               }
                           }}>
                        <icon class="small-button-icon" icon="grid" size={12.0f} />
                        <text class="small-button-label">Add scene</text>
                    </frame>
                </frame>
                <scroll ref="asset-scroll" class="asset-scroll" wheelStep={80.0f}>
                    <inline class="asset-cards">
                        <slot>
                            !{AssetBrowserUi:::Entries(query == "" ? folder : "", query).map((entry: AssetEntry) ->
                                entry.kind == "silhouette"
                                    ? <AssetCard key={entry.path} item={TemplateItem { id: entry.label, label: entry.label, kind: "block" }}
                                                 selected={editor.selection.previewTemplate == entry.label}
                                                 onSelect={() -> editor.selection.Preview(entry.label)} />
                                    : <AssetFileCard key={entry.path} kind={entry.kind} label={entry.label} selected={chosen == entry.path}
                                                     onSelect={() -> {
                                                         chosen = entry.path;
                                                         if entry.kind == "folder" {
                                                             folder = entry.path;
                                                             query = "";
                                                         } else if entry.kind == "graph" {
                                                             editorGraphOpen(entry.label, false);
                                                             editor.tabs.OpenGraphTab();
                                                         }
                                                     }} />)}
                        </slot>
                    </inline>
                </scroll>
            </frame>
        </frame>
    );
}
