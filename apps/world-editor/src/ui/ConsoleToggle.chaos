ConsoleToggleProps :: data {
    label: string;
    shown: bool;
    onToggle: (shown: bool) -> void;
}

ConsoleToggle :: (props: ConsoleToggleProps) -> Penumbra:::Component {
    return (
        <frame class="console-toggle">
            <checkbox class="console-checkbox" checked={props.shown}
                      onToggle={(checked: bool) -> props.onToggle(checked)} />
            <text class="console-toggle-label">{props.label}</text>
        </frame>
    );
}
