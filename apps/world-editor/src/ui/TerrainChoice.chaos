ChoiceRow :: import ChoiceRow;
Editor :: import Editor;
TerrainUi :: import TerrainUi;

// Which terrain option a row sets (by the name the editor's terrain tools know it by) and the label shown beside it.
TerrainChoiceProps :: data {
    label: string;
    name: string;
}

// One drop-down on the Terrain page. The choice shown is read from the terrain tools each time the toolbar state changes,
// so a menu command or a key that changes the option changes the drop-down too. Picking a choice remembers it.
TerrainChoice :: (props: TerrainChoiceProps) -> Penumbra:::Component {
    @context editor~ Editor;
    state := editor.document.toolbar;
    return (
        <ChoiceRow label={props.label} options={TerrainUi:::Labels(props.name)} selected={TerrainUi:::Selected(props.name)}
                   onSelect={(choice: string) -> { TerrainUi:::Choose(props.name, choice); editor.document.Refresh(false); }} />
    );
}
