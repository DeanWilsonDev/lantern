ChoiceRow :: import ChoiceRow;
TerrainUi :: import TerrainUi;

// Which terrain option a row sets (by the name the editor's terrain tools know it by) and the label shown beside it.
TerrainChoiceProps :: data {
    label: string;
    name: string;
}

// One drop-down on the Terrain tab. It keeps the choice shown itself, so picking a different one redraws it.
TerrainChoice :: (props: TerrainChoiceProps) -> Penumbra:::Component {
    @signal shown~ string = TerrainUi:::Selected(props.name);
    return (
        <ChoiceRow label={props.label} options={TerrainUi:::Labels(props.name)} selected={shown}
                   onSelect={(choice: string) -> { shown = choice; TerrainUi:::Pick(props.name, choice); }} />
    );
}
