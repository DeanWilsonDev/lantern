.dialog {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-medium);
    padding: var(--panel-padding-vertical) var(--panel-padding-horizontal);
    border-radius: var(--border-radius-panel);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.dialog-title-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
}

.dialog-icon {
    color: var(--color-accent);
}

.dialog-warning-icon {
    color: #FFC86EFF;
}

.dialog-title {
    color: var(--color-text-primary);
    font-size: 14px;
}

.dialog-body {
    color: var(--color-text-primary);
}

.dialog-hint {
    color: var(--color-text-disabled);
    font-size: 11px;
}

.dialog-actions {
    display: stack;
    flex-direction: row;
    align-items: center;
    justify-content: end;
    gap: var(--spacing-small);
}

.help-lines {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
}

.settings-page {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    flex-grow: 1;
}

.settings-scroll {
    height: 150px;
}

.settings-heading {
    color: var(--color-accent);
    margin: 4px 0px 2px 0px;
}

.setting-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 26px;
}

.setting-label {
    color: var(--color-text-primary);
}

.setting-label-wide {
    color: var(--color-text-primary);
    width: 200px;
}
