ComponentItem :: import ComponentItem;
Editor :: import Editor;
EditorModel :: import EditorModel;
SilhouetteValueField :: import SilhouetteValueField;

// Helpers for the Silhouette tab. The engine gives each value as one line of text: `* key: value` when the Silhouette
// sets it itself and `  key: value` when it comes from its base. RowText, RowKey and RowValue take such a line apart.
// Indented draws the component tree with a corner mark and four spaces per level. Chosen returns the component at a
// position, or an empty one when the position is out of range.
SilhouettePageUi :: namespace {
    ComponentClass :: (selected: bool) -> string {
        return selected ? "entity-page-component-selected" : "entity-page-component";
    }

    Indented :: (name: string, depth: i32) -> string {
        prefix~ string = "";
        for level~ i32 = 0; level < depth; level++ {
            prefix = prefix + "    ";
        }
        return depth > 0 ? prefix + "└ " + name : name;
    }

    ValueRows :: (templateId: string, position: i32) -> Array<string> {
        rows~ Array<string> = [];
        count := editorSilhouetteValueCount(templateId, position);
        for line~ i32 = 0; line < count; line++ {
            rows.add(editorSilhouetteValue(templateId, position, line));
        }
        return rows;
    }

    GraphNames :: () -> Array<string> {
        names~ Array<string> = [];
        for piece in editorGraphList().split("\n") {
            if piece != "" {
                names.add(piece);
            }
        }
        return names;
    }

    RowText :: (row: string) -> string {
        return (row.startsWith("* ") || row.startsWith("  ")) ? row.substring(2, row.length() - 2) : row;
    }

    RowKey :: (row: string) -> string {
        text := RowText(row);
        colon := text.indexOf(": ", 0);
        return colon > 0 ? text.substring(0, colon) : text;
    }

    RowValue :: (row: string) -> string {
        text := RowText(row);
        colon := text.indexOf(": ", 0);
        return colon > 0 ? text.substring(colon + 2, text.length() - colon - 2) : "";
    }

    Chosen :: (components: Array<ComponentItem>, position: i32) -> ComponentItem {
        if position >= 0 && position < components.length() {
            return components[position];
        }
        return ComponentItem { position: 0, name: "", kind: "", depth: 0 };
    }
}

// The Silhouette tab: where a Silhouette (a reusable model made of components such as blocks, lights and gems) is
// edited.
// The left column lists its components as a tree and has buttons to add a child or move a component under another.
// The middle shows a live preview and the chosen component's values, which commit when Enter is pressed. The right
// column renames or deletes the component, sets or reverts a value, picks the behaviour graph, and manages the
// Silhouette itself (new variant, rename, set base, delete). Every change goes to the engine, and the preview and
// this page are then refreshed. The @signals are the page's own state: the chosen component, the text in each box,
// the component being moved and a counter, `revision`, that is added to after each change so the page redraws.
SilhouettePage :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal chosenPosition~ i32 = 0;
    @signal revision~ i32 = 0;
    @signal editStatus~ string = "";
    @signal renameText~ string = "";
    @signal newSilhouetteName~ string = "";
    @signal movingPosition~ i32 = -1;
    @signal valueKey~ string = "";
    @signal valueText~ string = "";
    return (
        <frame ref="silhouette-page" class="entity-page">
            <slot>
                !{(() -> Penumbra:::Component {
                    templateId := editor.tabs.silhouette;
                    revisionNow := revision;
                    components := EditorModel:::Components(templateId);
                    chosen := SilhouettePageUi:::Chosen(components, chosenPosition);
                    return (
                        <frame class="entity-page-body">
                            <frame class="entity-page-header">
                                <icon class="panel-header-icon" icon="cube" size={14.0f} />
                                <text class="entity-page-title">{templateId}</text>
                                <text class="entity-page-kind">{`${components.length()} components`}</text>
                            </frame>
                            <frame class="entity-page-columns">
                                <frame class="entity-page-list">
                                    <text class="entity-page-heading">Components</text>
                                    <slot>
                                        !{components.map((item: ComponentItem) ->
                                            <frame key={`silhouette-component-${item.position}`}
                                                   ref={`silhouette-component-${item.position}`}
                                                   class={SilhouettePageUi:::ComponentClass(item.position == chosenPosition)}
                                                   onRelease={() -> {
                                                       if movingPosition >= 0 {
                                                           editStatus = editorSilhouetteMoveComponent(templateId, movingPosition, item.position);
                                                           movingPosition = -1;
                                                           editorSetPreviewTemplate(templateId);
                                                           revision = revision + 1;
                                                       } else {
                                                           chosenPosition = item.position;
                                                       }
                                                   }}>
                                                <text class="entity-page-component-name">{SilhouettePageUi:::Indented(item.name, item.depth)}</text>
                                                <text class="entity-page-component-count">{item.kind}</text>
                                            </frame>)}
                                    </slot>
                                    <text class="entity-page-heading">Add a child</text>
                                    <frame class="chip-column">
                                        <slot>
                                            !{["block", "point_light", "spot_light", "gem", "spawn"].map((kind: string) ->
                                                <frame key={`silhouette-add-${kind}`} ref={`silhouette-add-${kind}`} class="small-button"
                                                       onRelease={() -> {
                                                           editStatus = editorSilhouetteAddChild(templateId, chosenPosition, kind);
                                                           editorSetPreviewTemplate(templateId);
                                                           revision = revision + 1;
                                                       }}>
                                                    <icon class="small-button-icon" icon="plus" size={12.0f} />
                                                    <text class="small-button-label">{kind}</text>
                                                </frame>)}
                                        </slot>
                                    </frame>
                                    <text class="entity-page-heading">Arrange</text>
                                    <frame class="chip-column">
                                        <frame ref="silhouette-move-button" class="small-button"
                                               onRelease={() -> {
                                                   movingPosition = movingPosition >= 0 ? -1 : chosenPosition;
                                                   editStatus = movingPosition >= 0 ? "Click the component it should hang from." : "";
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">{movingPosition >= 0 ? "Cancel move" : "Move under..."}</text>
                                        </frame>
                                        <frame ref="silhouette-move-root-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteMoveComponent(templateId, chosenPosition, 0);
                                                   movingPosition = -1;
                                                   editorSetPreviewTemplate(templateId);
                                                   revision = revision + 1;
                                               }}>
                                            <text class="small-button-label">Move to root</text>
                                        </frame>
                                    </frame>
                                </frame>
                                <frame class="graph-centre">
                                    <viewport ref="silhouette-preview" class="asset-preview-viewport" renderer="preview" />
                                    <text ref="silhouette-status" class="entity-page-kind">{editStatus}</text>
                                    <text class="entity-page-kind">A variant marks the values it sets itself with *; the rest come from its base.</text>
                                    <text class="entity-page-heading">Values</text>
                                    <scroll ref="silhouette-values-scroll" class="entity-page-fields-scroll" wheelStep={60.0f}>
                                        <frame class="entity-page-fields">
                                            <slot>
                                                !{SilhouettePageUi:::ValueRows(templateId, chosenPosition).map((row: string) ->
                                                    <SilhouetteValueField key={row} valueKey={SilhouettePageUi:::RowKey(row)}
                                                                          valueText={SilhouettePageUi:::RowValue(row)}
                                                                          isOwn={row.startsWith("* ")}
                                                                          onPick={(pickedKey: string, pickedText: string) -> {
                                                                              valueKey = pickedKey;
                                                                              valueText = pickedText;
                                                                          }}
                                                                          onCommit={(committedKey: string, committedText: string) -> {
                                                                              editStatus = editorSilhouetteEditValue(templateId, chosenPosition, committedKey, committedText, false);
                                                                              editorSetPreviewTemplate(templateId);
                                                                              revision = revision + 1;
                                                                          }} />)}
                                            </slot>
                                        </frame>
                                    </scroll>
                                </frame>
                                <frame class="silhouette-side">
                                    <text class="entity-page-heading">{chosen.name}</text>
                                    <text class="entity-page-kind">{`kind: ${chosen.kind}`}</text>
                                    <text class="entity-page-kind">{chosen.depth == 0 ? "the root of this Silhouette" : "a child of this Silhouette"}</text>
                                    <text class="entity-page-heading">Component (type a new name to rename)</text>
                                    <frame class="field-row">
                                        <input ref="silhouette-rename" class="field-input" text={renameText}
                                               preferredWidth={110.0f}
                                               onTextChange={(text: string) -> { renameText = text; }} />
                                        <frame ref="silhouette-rename-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteRenameComponent(templateId, chosenPosition, renameText);
                                                   editorSetPreviewTemplate(templateId);
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="pencil" size={12.0f} />
                                            <text class="small-button-label">Rename</text>
                                        </frame>
                                        <frame ref="silhouette-delete-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteDeleteComponent(templateId, chosenPosition);
                                                   chosenPosition = 0;
                                                   editorSetPreviewTemplate(templateId);
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="trash" size={12.0f} />
                                            <text class="small-button-label">Delete</text>
                                        </frame>
                                    </frame>
                                    <text class="entity-page-heading">Edit a value (key, then value)</text>
                                    <frame class="field-row">
                                        <input ref="silhouette-value-key" class="field-input" text={valueKey}
                                               preferredWidth={110.0f}
                                               onTextChange={(text: string) -> { valueKey = text; }} />
                                        <input ref="silhouette-value-text" class="field-input" text={valueText}
                                               preferredWidth={110.0f}
                                               onTextChange={(text: string) -> { valueText = text; }} />
                                    </frame>
                                    <frame class="field-row">
                                        <frame ref="silhouette-set-value-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteEditValue(templateId, chosenPosition, valueKey, valueText, false);
                                                   editorSetPreviewTemplate(templateId);
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="pencil" size={12.0f} />
                                            <text class="small-button-label">Set value</text>
                                        </frame>
                                        <frame ref="silhouette-revert-value-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteEditValue(templateId, chosenPosition, valueKey, "", true);
                                                   editorSetPreviewTemplate(templateId);
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="undo" size={12.0f} />
                                            <text class="small-button-label">Revert to base</text>
                                        </frame>
                                    </frame>
                                    <text class="entity-page-heading">Behaviour graph</text>
                                    <frame class="chip-column">
                                        <text class="entity-page-kind">Behaviour graph (a scripted Silhouette runs it):</text>
                                        <slot>
                                            !{SilhouettePageUi:::GraphNames().map((graphName: string) ->
                                                <frame key={`silhouette-graph-${graphName}`} ref={`silhouette-graph-${graphName}`} class="small-button"
                                                       onRelease={() -> {
                                                           editStatus = editorSilhouetteEditValue(templateId, chosenPosition, "properties.graph", `"${graphName}"`, false);
                                                           editorSetPreviewTemplate(templateId);
                                                           revision = revision + 1;
                                                       }}>
                                                    <icon class="small-button-icon" icon="cube" size={12.0f} />
                                                    <text class="small-button-label">{graphName}</text>
                                                </frame>)}
                                        </slot>
                                    </frame>
                                    <text class="entity-page-heading">This Silhouette (type a name for New, Rename or Set base)</text>
                                    <frame class="field-row">
                                        <input ref="silhouette-new-name" class="field-input" text={newSilhouetteName}
                                               preferredWidth={110.0f}
                                               onTextChange={(text: string) -> { newSilhouetteName = text; }} />
                                    </frame>
                                    <frame class="field-row">
                                        <frame ref="silhouette-derive-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteCreate(newSilhouetteName, "", templateId);
                                                   if editStatus == "" {
                                                       editor.tabs.OpenSilhouette(newSilhouetteName);
                                                       editorSetPreviewTemplate(newSilhouetteName);
                                                       chosenPosition = 0;
                                                   }
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">New variant</text>
                                        </frame>
                                        <frame ref="silhouette-create-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteCreate(newSilhouetteName, "block", "");
                                                   if editStatus == "" {
                                                       editor.tabs.OpenSilhouette(newSilhouetteName);
                                                       editorSetPreviewTemplate(newSilhouetteName);
                                                       chosenPosition = 0;
                                                   }
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">New Silhouette</text>
                                        </frame>
                                    </frame>
                                    <frame class="field-row">
                                        <frame ref="silhouette-rename-silhouette-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteRename(templateId, newSilhouetteName);
                                                   if editStatus == "" {
                                                       editor.tabs.RenameSilhouette(templateId, newSilhouetteName);
                                                   }
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="pencil" size={12.0f} />
                                            <text class="small-button-label">Rename Silhouette</text>
                                        </frame>
                                    </frame>
                                    <frame class="field-row">
                                        <frame ref="silhouette-refresh-instances-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteRefreshInstances();
                                                   revision = revision + 1;
                                               }}>
                                            <text class="small-button-label">Refresh placed instances</text>
                                        </frame>
                                    </frame>
                                    <frame class="field-row">
                                        <frame ref="silhouette-set-base-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteSetBase(templateId, newSilhouetteName);
                                                   editorSetPreviewTemplate(templateId);
                                                   revision = revision + 1;
                                               }}>
                                            <text class="small-button-label">Set base</text>
                                        </frame>
                                    
                                    </frame>
                                    <frame class="field-row">
                                        <frame ref="silhouette-delete-silhouette-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteDelete(templateId);
                                                   if editStatus == "" {
                                                       editor.tabs.CloseSilhouette();
                                                   }
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="trash" size={12.0f} />
                                            <text class="small-button-label">Delete Silhouette</text>
                                        </frame>
                                    </frame>
                                </frame>
                            </frame>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
