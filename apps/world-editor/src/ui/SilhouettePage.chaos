ComponentItem :: import ComponentItem;
Editor :: import Editor;
EditorModel :: import EditorModel;
GraphPage :: import GraphPage;
SilhouetteValueField :: import SilhouetteValueField;

// Helpers for the Silhouette document. The engine gives each value as one line of text: `* key: value` when the
// Silhouette sets it itself and `  key: value` when it comes from its base. RowText, RowKey and RowValue take such a
// line apart. Groups and RowsIn sort the lines into the inspector's groups by the first part of their key
// (`transform.position` is in `transform`), with keys that have no dot in `general`. Chosen returns the component at a
// position, or an empty one when the position is out of range. The origin helpers read where a component comes from,
// as the engine says it (ComponentItem.origin).
SilhouettePageUi :: namespace {
    AddableKinds :: () -> Array<string> {
        return ["block", "ramp", "point_light", "spot_light", "gem", "spawn", "kill_plane", "camera_volume"];
    }

    GraphName :: (templateId: string) -> string {
        return `silhouette:${templateId}`;
    }

    TabClass :: (active: bool) -> string {
        return active ? "document-tab-active" : "document-tab";
    }

    TabLabelClass :: (active: bool) -> string {
        return active ? "tab-label-active" : "tab-label";
    }

    RowClass :: (selected: bool, inherited: bool) -> string {
        return selected ? "silhouette-row-selected" : (inherited ? "silhouette-row-inherited" : "silhouette-row");
    }

    Indent :: (depth: i32) -> string {
        prefix~ string = "";
        for level~ i32 = 0; level < depth; level++ {
            prefix = prefix + "    ";
        }
        return prefix;
    }

    KindIcon :: (item: ComponentItem) -> string {
        if item.origin.startsWith("silhouette:") {
            return "layers";
        }
        return when item.kind {
            "point_light" -> "light",
            "spot_light" -> "light",
            "sun" -> "light",
            "camera_volume" -> "camera",
            "camera_shot" -> "camera",
            "photo_sight" -> "camera",
            default -> EditorModel:::KindIcon(item.kind)
        };
    }

    IsInherited :: (item: ComponentItem) -> bool {
        return item.origin == "inherited";
    }

    NestedName :: (item: ComponentItem) -> string {
        return item.origin.startsWith("silhouette:") ? item.origin.substring(11, item.origin.length() - 11) : "";
    }

    BaseName :: (item: ComponentItem) -> string {
        return item.origin.startsWith("variant:") ? item.origin.substring(8, item.origin.length() - 8) : "";
    }

    RowNote :: (item: ComponentItem) -> string {
        nested := NestedName(item);
        if nested != "" {
            return nested;
        }
        return IsInherited(item) ? "inherited" : "";
    }

    Role :: (item: ComponentItem) -> string {
        if item.depth == 0 {
            base := BaseName(item);
            return base == "" ? "The root of this Silhouette." : `The root, a variant of ${base}.`;
        }
        nested := NestedName(item);
        if nested != "" {
            return `A child that is the Silhouette ${nested}, with its children.`;
        }
        if IsInherited(item) {
            return "Comes from a base or a nested Silhouette; change it there.";
        }
        return "A game component of this Silhouette.";
    }

    ValueRows :: (templateId: string, position: i32) -> Array<string> {
        rows~ Array<string> = [];
        count := editorSilhouetteValueCount(templateId, position);
        for line~ i32 = 0; line < count; line++ {
            rows.add(editorSilhouetteValue(templateId, position, line));
        }
        return rows;
    }

    GraphNames :: () -> Array<string> {
        names~ Array<string> = [];
        for piece in editorGraphList().split("\n") {
            if piece != "" {
                names.add(piece);
            }
        }
        return names;
    }

    RowText :: (row: string) -> string {
        return (row.startsWith("* ") || row.startsWith("  ")) ? row.substring(2, row.length() - 2) : row;
    }

    RowKey :: (row: string) -> string {
        text := RowText(row);
        colon := text.indexOf(": ", 0);
        return colon > 0 ? text.substring(0, colon) : text;
    }

    RowValue :: (row: string) -> string {
        text := RowText(row);
        colon := text.indexOf(": ", 0);
        return colon > 0 ? text.substring(colon + 2, text.length() - colon - 2) : "";
    }

    GroupOf :: (key: string) -> string {
        dot := key.indexOf(".", 0);
        return dot > 0 ? key.substring(0, dot) : "general";
    }

    LabelIn :: (key: string) -> string {
        dot := key.indexOf(".", 0);
        return dot > 0 ? key.substring(dot + 1, key.length() - dot - 1) : key;
    }

    Groups :: (rows: Array<string>) -> Array<string> {
        groups~ Array<string> = [];
        for row in rows {
            group := GroupOf(RowKey(row));
            seen~ bool = false;
            for known in groups {
                if known == group {
                    seen = true;
                }
            }
            if !seen {
                groups.add(group);
            }
        }
        return groups;
    }

    RowsIn :: (rows: Array<string>, group: string) -> Array<string> {
        chosen~ Array<string> = [];
        for row in rows {
            if GroupOf(RowKey(row)) == group {
                chosen.add(row);
            }
        }
        return chosen;
    }

    Chosen :: (components: Array<ComponentItem>, position: i32) -> ComponentItem {
        if position >= 0 && position < components.length() {
            return components[position];
        }
        return ComponentItem { position: 0, name: "", kind: "", depth: 0, origin: "" };
    }
}

// The Silhouette document: where one Silhouette (a reusable thing made of game components and other Silhouettes) is
// edited, laid out like a Blueprint editor. The header names it and holds what is done to the whole Silhouette (new
// variant, new Silhouette, rename, set base, refresh placed instances, delete). Below it, the Hierarchy on the left
// lists what it is made of, the root first and its children indented, with nested Silhouettes marked and what comes
// from a base greyed; Add puts a game component under the selected row, a double-click renames a row, and Move
// under hangs it from another. The viewport in the middle turns the Silhouette, and the Inspector on the right shows
// every value of the selected row, grouped by the first part of its key. Every change goes to the engine and then
// `revision` is added to so the page redraws. The @signals are the page's own state: the chosen row, the row being
// renamed or moved, whether the Add menu is open, the status line, the text in each box and which of the document's own
// tabs is up: "viewport" for the three areas, or "graph" for the Silhouette's event graph, which fills the document
// with the graph editor (its functions and variables on the left, the canvas, and the selected node on the right). The
// graph is the Silhouette's own (`graph.json` in its folder), opened as `silhouette:<name>`; a Silhouette without one
// offers to make it.
SilhouettePage :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal chosenPosition~ i32 = 0;
    @signal revision~ i32 = 0;
    @signal editStatus~ string = "";
    @signal newSilhouetteName~ string = "";
    @signal movingPosition~ i32 = -1;
    @signal renamingPosition~ i32 = -1;
    @signal addMenuOpen~ bool = false;
    @signal valueKey~ string = "";
    @signal valueText~ string = "";
    @signal centreTab~ string = "viewport";
    return (
        <frame ref="silhouette-page" class="entity-page">
            <slot>
                !{(() -> Penumbra:::Component {
                    templateId := editor.tabs.silhouette;
                    revisionNow := revision;
                    components := EditorModel:::Components(templateId);
                    chosen := SilhouettePageUi:::Chosen(components, chosenPosition);
                    root := SilhouettePageUi:::Chosen(components, 0);
                    isVariant := SilhouettePageUi:::BaseName(root) != "";
                    rows := SilhouettePageUi:::ValueRows(templateId, chosenPosition);
                    afterEdit := (status: string) -> void {
                        editStatus = status;
                        editorSetPreviewTemplate(templateId);
                        revision = revision + 1;
                    };
                    return (
                        <frame class="entity-page-body">
                            <frame class="silhouette-header">
                                <icon class="panel-header-icon" icon="layers" size={14.0f} />
                                <text class="entity-page-title">{templateId}</text>
                                <text class="entity-page-kind">{isVariant ? `variant of ${SilhouettePageUi:::BaseName(root)}` : root.kind}</text>
                                <frame class="silhouette-header-gap" />
                                <text class="entity-page-kind">Name for new, rename or base:</text>
                                <input ref="silhouette-new-name" class="field-input" text={newSilhouetteName}
                                       preferredWidth={130.0f}
                                       onTextChange={(text: string) -> { newSilhouetteName = text; }} />
                                <frame ref="silhouette-derive-button" class="small-button"
                                       onRelease={() -> {
                                           editStatus = editorSilhouetteCreate(newSilhouetteName, "", templateId);
                                           if editStatus == "" {
                                               editor.tabs.OpenSilhouette(newSilhouetteName);
                                           }
                                           revision = revision + 1;
                                       }}>
                                    <icon class="small-button-icon" icon="plus" size={12.0f} />
                                    <text class="small-button-label">New variant</text>
                                </frame>
                                <frame ref="silhouette-create-button" class="small-button"
                                       onRelease={() -> {
                                           editStatus = editorSilhouetteCreate(newSilhouetteName, "block", "");
                                           if editStatus == "" {
                                               editor.tabs.OpenSilhouette(newSilhouetteName);
                                           }
                                           revision = revision + 1;
                                       }}>
                                    <icon class="small-button-icon" icon="plus" size={12.0f} />
                                    <text class="small-button-label">New Silhouette</text>
                                </frame>
                                <frame ref="silhouette-rename-silhouette-button" class="small-button"
                                       onRelease={() -> {
                                           editStatus = editorSilhouetteRename(templateId, newSilhouetteName);
                                           if editStatus == "" {
                                               editor.tabs.RenameSilhouette(templateId, newSilhouetteName);
                                           }
                                           revision = revision + 1;
                                       }}>
                                    <icon class="small-button-icon" icon="pencil" size={12.0f} />
                                    <text class="small-button-label">Rename</text>
                                </frame>
                                <frame ref="silhouette-set-base-button" class="small-button"
                                       onRelease={() -> afterEdit(editorSilhouetteSetBase(templateId, newSilhouetteName))}>
                                    <text class="small-button-label">Set base</text>
                                </frame>
                                <frame ref="silhouette-refresh-instances-button" class="small-button"
                                       onRelease={() -> {
                                           editStatus = editorSilhouetteRefreshInstances();
                                           revision = revision + 1;
                                       }}>
                                    <text class="small-button-label">Refresh placed</text>
                                </frame>
                                <frame ref="silhouette-delete-silhouette-button" class="small-button"
                                       onRelease={() -> {
                                           editStatus = editorSilhouetteDelete(templateId);
                                           if editStatus == "" {
                                               editor.tabs.CloseSilhouette();
                                           }
                                           revision = revision + 1;
                                       }}>
                                    <icon class="small-button-icon" icon="trash" size={12.0f} />
                                    <text class="small-button-label">Delete</text>
                                </frame>
                            </frame>
                            <text ref="silhouette-status" class="silhouette-status">{editStatus}</text>
                            <frame class="silhouette-tab-row">
                                <frame ref="silhouette-tab-viewport" class={SilhouettePageUi:::TabClass(centreTab == "viewport")}
                                       onRelease={() -> { centreTab = "viewport"; }}>
                                    <icon class={SilhouettePageUi:::TabLabelClass(centreTab == "viewport")} icon="cube" size={12.0f} />
                                    <text class={SilhouettePageUi:::TabLabelClass(centreTab == "viewport")}>Viewport</text>
                                </frame>
                                <frame ref="silhouette-tab-graph" class={SilhouettePageUi:::TabClass(centreTab == "graph")}
                                       onRelease={() -> {
                                           if editorGraphName() != SilhouettePageUi:::GraphName(templateId) {
                                               editorGraphOpen(SilhouettePageUi:::GraphName(templateId), false);
                                           }
                                           centreTab = "graph";
                                           revision = revision + 1;
                                       }}>
                                    <icon class={SilhouettePageUi:::TabLabelClass(centreTab == "graph")} icon="kanban" size={12.0f} />
                                    <text class={SilhouettePageUi:::TabLabelClass(centreTab == "graph")}>Event Graph</text>
                                </frame>
                            </frame>
                            <slot>
                                !{centreTab == "graph"
                                    ? (editorGraphName() == SilhouettePageUi:::GraphName(templateId)
                                        ? <GraphPage key={`silhouette-graph-${templateId}`} ownerSilhouette={templateId} />
                                        : <frame key="silhouette-graph-missing" class="silhouette-graph-missing">
                                              <text class="silhouette-panel-title">{`${templateId} has no graph yet.`}</text>
                                              <text class="entity-page-kind">The graph of a Silhouette is saved beside it, in graph.json.</text>
                                              <frame ref="silhouette-create-graph-button" class="small-button-accent"
                                                     onRelease={() -> {
                                                         editStatus = editorGraphOpen(SilhouettePageUi:::GraphName(templateId), true);
                                                         revision = revision + 1;
                                                     }}>
                                                  <icon class="small-button-icon-accent" icon="plus" size={12.0f} />
                                                  <text class="small-button-label-accent">Create graph</text>
                                              </frame>
                                          </frame>)
                                    : <frame key="silhouette-document" class="silhouette-document">
                                <frame ref="silhouette-hierarchy" class="silhouette-hierarchy">
                                    <frame class="silhouette-panel-header">
                                        <icon class="panel-header-icon" icon="layers" size={12.0f} />
                                        <text class="silhouette-panel-title">Hierarchy</text>
                                        <frame class="silhouette-header-gap" />
                                        <frame ref="silhouette-add-button" class="small-button-accent"
                                               onRelease={() -> { addMenuOpen = !addMenuOpen; }}>
                                            <icon class="small-button-icon-accent" icon="plus" size={12.0f} />
                                            <text class="small-button-label-accent">Add</text>
                                        </frame>
                                        <frame ref="silhouette-delete-button" class="small-button"
                                               onRelease={() -> {
                                                   afterEdit(editorSilhouetteDeleteComponent(templateId, chosenPosition));
                                                   chosenPosition = 0;
                                               }}>
                                            <icon class="small-button-icon" icon="trash" size={12.0f} />
                                        </frame>
                                    </frame>
                                    <slot>
                                        !{addMenuOpen
                                            ? <frame ref="silhouette-add-menu" class="silhouette-add-menu">
                                                  <text class="entity-page-kind">{`Add a game component under ${chosen.name}:`}</text>
                                                  <slot>
                                                      !{SilhouettePageUi:::AddableKinds().map((kind: string) ->
                                                          <frame key={`silhouette-add-${kind}`} ref={`silhouette-add-${kind}`} class="silhouette-add-item"
                                                                 onRelease={() -> {
                                                                     addMenuOpen = false;
                                                                     afterEdit(editorSilhouetteAddChild(templateId, chosenPosition, kind));
                                                                 }}>
                                                              <icon class="small-button-icon" icon={SilhouettePageUi:::KindIcon(ComponentItem { position: 0, name: kind, kind: kind, depth: 0, origin: "" })} size={12.0f} />
                                                              <text class="small-button-label">{kind}</text>
                                                          </frame>)}
                                                  </slot>
                                              </frame>
                                            : <frame class="nothing" />}
                                    </slot>
                                    <scroll ref="silhouette-hierarchy-scroll" class="silhouette-hierarchy-scroll" wheelStep={60.0f}>
                                        <frame class="silhouette-rows">
                                            <slot>
                                                !{components.map((item: ComponentItem) ->
                                                    renamingPosition == item.position
                                                        ? <frame key={`silhouette-renaming-${item.position}`} class="silhouette-row-selected">
                                                              <text class="silhouette-row-indent">{SilhouettePageUi:::Indent(item.depth)}</text>
                                                              <input ref="silhouette-rename" class="field-input" text={item.name}
                                                                     preferredWidth={150.0f}
                                                                     onSubmit={(typed: string) -> {
                                                                         renamingPosition = -1;
                                                                         afterEdit(editorSilhouetteRenameComponent(templateId, item.position, typed));
                                                                     }} />
                                                          </frame>
                                                        : <frame key={`silhouette-component-${item.position}`}
                                                                 ref={`silhouette-component-${item.position}`}
                                                                 class={SilhouettePageUi:::RowClass(item.position == chosenPosition, SilhouettePageUi:::IsInherited(item))}
                                                                 onRelease={() -> {
                                                                     if movingPosition >= 0 {
                                                                         afterEdit(editorSilhouetteMoveComponent(templateId, movingPosition, item.position));
                                                                         movingPosition = -1;
                                                                     } else {
                                                                         chosenPosition = item.position;
                                                                     }
                                                                 }}
                                                                 onDoubleClick={() -> {
                                                                     if !SilhouettePageUi:::IsInherited(item) {
                                                                         renamingPosition = item.position;
                                                                     }
                                                                 }}>
                                                              <text class="silhouette-row-indent">{SilhouettePageUi:::Indent(item.depth)}</text>
                                                              <icon class="silhouette-row-icon" icon={SilhouettePageUi:::KindIcon(item)} size={12.0f} />
                                                              <text class="silhouette-row-name">{item.name}</text>
                                                              <text class="silhouette-row-note">{SilhouettePageUi:::RowNote(item)}</text>
                                                          </frame>)}
                                            </slot>
                                        </frame>
                                    </scroll>
                                    <frame class="field-row">
                                        <frame ref="silhouette-move-button" class="small-button"
                                               onRelease={() -> {
                                                   movingPosition = movingPosition >= 0 ? -1 : chosenPosition;
                                                   editStatus = movingPosition >= 0 ? "Click the row it should hang from." : "";
                                               }}>
                                            <text class="small-button-label">{movingPosition >= 0 ? "Cancel move" : "Move under..."}</text>
                                        </frame>
                                        <frame ref="silhouette-move-root-button" class="small-button"
                                               onRelease={() -> {
                                                   movingPosition = -1;
                                                   afterEdit(editorSilhouetteMoveComponent(templateId, chosenPosition, 0));
                                               }}>
                                            <text class="small-button-label">Move to root</text>
                                        </frame>
                                    </frame>
                                </frame>
                                <frame class="silhouette-centre">
                                    <viewport ref="silhouette-preview" class="silhouette-viewport" renderer="preview" />
                                </frame>
                                <frame ref="silhouette-inspector" class="silhouette-inspector">
                                    <frame class="silhouette-panel-header">
                                        <icon class="panel-header-icon" icon={SilhouettePageUi:::KindIcon(chosen)} size={12.0f} />
                                        <text class="silhouette-panel-title">{chosen.name}</text>
                                        <text class="entity-page-kind">{chosen.kind}</text>
                                    </frame>
                                    <text class="entity-page-kind">{SilhouettePageUi:::Role(chosen)}</text>
                                    <scroll ref="silhouette-values-scroll" class="silhouette-inspector-scroll" wheelStep={60.0f}>
                                        <frame class="entity-page-fields">
                                            <slot>
                                                !{SilhouettePageUi:::Groups(rows).map((group: string) ->
                                                    <frame key={`silhouette-group-${group}`} class="silhouette-group">
                                                        <text class="silhouette-group-title">{group}</text>
                                                        <slot>
                                                            !{SilhouettePageUi:::RowsIn(rows, group).map((row: string) ->
                                                                <SilhouetteValueField key={row} valueKey={SilhouettePageUi:::RowKey(row)}
                                                                                      label={SilhouettePageUi:::LabelIn(SilhouettePageUi:::RowKey(row))}
                                                                                      valueText={SilhouettePageUi:::RowValue(row)}
                                                                                      isOwn={row.startsWith("* ")}
                                                                                      canRevert={isVariant && row.startsWith("* ")}
                                                                                      onPick={(pickedKey: string, pickedText: string) -> {
                                                                                          valueKey = pickedKey;
                                                                                          valueText = pickedText;
                                                                                      }}
                                                                                      onCommit={(committedKey: string, committedText: string) ->
                                                                                          afterEdit(editorSilhouetteEditValue(templateId, chosenPosition, committedKey, committedText, false))}
                                                                                      onRevert={(revertedKey: string) ->
                                                                                          afterEdit(editorSilhouetteEditValue(templateId, chosenPosition, revertedKey, "", true))} />)}
                                                        </slot>
                                                    </frame>)}
                                            </slot>
                                            <text class="silhouette-group-title">Add or set a property (key, then JSON value)</text>
                                            <frame class="field-row">
                                                <input ref="silhouette-value-key" class="field-input" text={valueKey}
                                                       preferredWidth={120.0f}
                                                       onTextChange={(text: string) -> { valueKey = text; }} />
                                                <input ref="silhouette-value-text" class="field-input" text={valueText}
                                                       preferredWidth={110.0f}
                                                       onTextChange={(text: string) -> { valueText = text; }} />
                                                <frame ref="silhouette-set-value-button" class="small-button"
                                                       onRelease={() -> afterEdit(editorSilhouetteEditValue(templateId, chosenPosition, valueKey, valueText, false))}>
                                                    <text class="small-button-label">Set</text>
                                                </frame>
                                            </frame>
                                            <text class="silhouette-group-title">Behaviour graph (a scripted Silhouette runs it)</text>
                                            <frame class="silhouette-chips">
                                                <slot>
                                                    !{SilhouettePageUi:::GraphNames().map((graphName: string) ->
                                                        <frame key={`silhouette-graph-${graphName}`} ref={`silhouette-graph-${graphName}`} class="small-button"
                                                               onRelease={() -> afterEdit(editorSilhouetteEditValue(templateId, chosenPosition, "properties.graph", `"${graphName}"`, false))}>
                                                            <icon class="small-button-icon" icon="kanban" size={12.0f} />
                                                            <text class="small-button-label">{graphName}</text>
                                                        </frame>)}
                                                </slot>
                                            </frame>
                                        </frame>
                                    </scroll>
                                </frame>
                            </frame>}
                            </slot>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
