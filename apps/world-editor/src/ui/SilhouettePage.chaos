ComponentItem :: import ComponentItem;
Editor :: import Editor;
EditorModel :: import EditorModel;

SilhouettePageUi :: namespace {
    ComponentClass :: (selected: bool) -> string {
        return selected ? "entity-page-component-selected" : "entity-page-component";
    }

    Indented :: (name: string, depth: i32) -> string {
        prefix~ string = "";
        for level~ i32 = 0; level < depth; level++ {
            prefix = prefix + "    ";
        }
        return depth > 0 ? prefix + "└ " + name : name;
    }

    ValueRows :: (templateId: string, position: i32) -> Array<string> {
        rows~ Array<string> = [];
        count := editorSilhouetteValueCount(templateId, position);
        for line~ i32 = 0; line < count; line++ {
            rows.add(editorSilhouetteValue(templateId, position, line));
        }
        return rows;
    }

    Chosen :: (components: Array<ComponentItem>, position: i32) -> ComponentItem {
        if position >= 0 && position < components.length() {
            return components[position];
        }
        return ComponentItem { position: 0, name: "", kind: "", depth: 0 };
    }
}

SilhouettePage :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal chosenPosition~ i32 = 0;
    @signal revision~ i32 = 0;
    @signal editStatus~ string = "";
    @signal renameText~ string = "";
    @signal newSilhouetteName~ string = "";
    return (
        <frame ref="silhouette-page" class="entity-page">
            <slot>
                !{(() -> Penumbra:::Component {
                    templateId := editor.tabs.silhouette;
                    revisionNow := revision;
                    components := EditorModel:::Components(templateId);
                    chosen := SilhouettePageUi:::Chosen(components, chosenPosition);
                    return (
                        <frame class="entity-page-body">
                            <frame class="entity-page-header">
                                <icon class="panel-header-icon" icon="cube" size={14.0f} />
                                <text class="entity-page-title">{templateId}</text>
                                <text class="entity-page-kind">{`${components.length()} components`}</text>
                            </frame>
                            <frame class="entity-page-columns">
                                <frame class="entity-page-list">
                                    <text class="entity-page-heading">Components</text>
                                    <slot>
                                        !{components.map((item: ComponentItem) ->
                                            <frame key={`silhouette-component-${item.position}`}
                                                   ref={`silhouette-component-${item.position}`}
                                                   class={SilhouettePageUi:::ComponentClass(item.position == chosenPosition)}
                                                   onRelease={() -> { chosenPosition = item.position; }}>
                                                <text class="entity-page-component-name">{SilhouettePageUi:::Indented(item.name, item.depth)}</text>
                                                <text class="entity-page-component-count">{item.kind}</text>
                                            </frame>)}
                                    </slot>
                                </frame>
                                <frame class="entity-page-fields">
                                    <text class="entity-page-heading">{chosen.name}</text>
                                    <text class="entity-page-kind">{`kind: ${chosen.kind}`}</text>
                                    <text class="entity-page-kind">{chosen.depth == 0 ? "the root of this Silhouette" : "a child of this Silhouette"}</text>
                                    <frame class="field-row">
                                        <input ref="silhouette-rename" class="field-input" text={renameText}
                                               preferredWidth={140.0f}
                                               onTextChange={(text: string) -> { renameText = text; }} />
                                        <frame ref="silhouette-rename-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteRenameComponent(templateId, chosenPosition, renameText);
                                                   editorSetPreviewTemplate(templateId);
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="pencil" size={12.0f} />
                                            <text class="small-button-label">Rename</text>
                                        </frame>
                                        <frame ref="silhouette-delete-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteDeleteComponent(templateId, chosenPosition);
                                                   chosenPosition = 0;
                                                   editorSetPreviewTemplate(templateId);
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="trash" size={12.0f} />
                                            <text class="small-button-label">Delete</text>
                                        </frame>
                                    </frame>
                                    <frame class="field-row">
                                        <slot>
                                            !{["block", "point_light", "spot_light", "gem", "spawn"].map((kind: string) ->
                                                <frame key={`silhouette-add-${kind}`} ref={`silhouette-add-${kind}`} class="small-button"
                                                       onRelease={() -> {
                                                           editStatus = editorSilhouetteAddChild(templateId, chosenPosition, kind);
                                                           editorSetPreviewTemplate(templateId);
                                                           revision = revision + 1;
                                                       }}>
                                                    <icon class="small-button-icon" icon="plus" size={12.0f} />
                                                    <text class="small-button-label">{kind}</text>
                                                </frame>)}
                                        </slot>
                                    </frame>
                                    <frame class="field-row">
                                        <input ref="silhouette-new-name" class="field-input" text={newSilhouetteName}
                                               preferredWidth={140.0f}
                                               onTextChange={(text: string) -> { newSilhouetteName = text; }} />
                                        <frame ref="silhouette-derive-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteCreate(newSilhouetteName, "", templateId);
                                                   if editStatus == "" {
                                                       editor.tabs.OpenSilhouette(newSilhouetteName);
                                                       editorSetPreviewTemplate(newSilhouetteName);
                                                       chosenPosition = 0;
                                                   }
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">New variant</text>
                                        </frame>
                                        <frame ref="silhouette-create-button" class="small-button"
                                               onRelease={() -> {
                                                   editStatus = editorSilhouetteCreate(newSilhouetteName, "block", "");
                                                   if editStatus == "" {
                                                       editor.tabs.OpenSilhouette(newSilhouetteName);
                                                       editorSetPreviewTemplate(newSilhouetteName);
                                                       chosenPosition = 0;
                                                   }
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">New Silhouette</text>
                                        </frame>
                                    </frame>
                                    <text ref="silhouette-status" class="entity-page-kind">{editStatus}</text>
                                    <text class="entity-page-kind">A variant marks the values it sets itself with *; the rest come from its base.</text>
                                    <viewport ref="silhouette-preview" class="asset-preview-viewport" renderer="preview" />
                                    <scroll ref="silhouette-values-scroll" class="entity-page-fields-scroll" wheelStep={60.0f}>
                                        <frame class="entity-page-fields">
                                            <slot>
                                                !{SilhouettePageUi:::ValueRows(templateId, chosenPosition).map((row: string) ->
                                                    <text key={row} class="entity-page-kind">{row}</text>)}
                                            </slot>
                                        </frame>
                                    </scroll>
                                </frame>
                            </frame>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
