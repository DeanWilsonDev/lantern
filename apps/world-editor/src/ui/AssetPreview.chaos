Editor :: import Editor;

// The asset preview panel: the template picked last in the asset browser or the Silhouettes panel, turning in a live
// view that fills the panel, with its name and an Edit button under it. It is one of the movable panels, so it can sit
// beside the drawer (where it starts), in a side column, or float. Things are placed by dragging a card into the
// viewport, so the panel only shows and opens them.
AssetPreview :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="asset-preview" class="asset-preview">
            <viewport ref="asset-preview-viewport" class="asset-preview-viewport" renderer="preview" />
            <frame class="asset-preview-actions">
                <slot>
                    !{<text class="asset-preview-title">{editor.selection.previewTemplate}</text>}
                </slot>
                <frame ref="asset-edit-silhouette" class="small-button"
                       onRelease={() -> editor.tabs.OpenSilhouette(editor.selection.previewTemplate)}>
                    <icon class="small-button-icon" icon="pencil" size={12.0f} />
                    <text class="small-button-label">Edit</text>
                </frame>
            </frame>
            <text class="asset-preview-hint">Drag a card into the viewport to place it.</text>
        </frame>
    );
}
