Editor :: import Editor;
InspectorFieldItem :: import InspectorFieldItem;

VectorFieldProps :: data {
    item: InspectorFieldItem;
}

VectorField :: (props: VectorFieldProps) -> Penumbra:::Component {
    @context editor~ Editor = new Editor();
    return (
        <frame class="vector-row">
            <text class="vector-axis-x">X</text>
            <input ref={`input-${props.item.axisKeys[0]}`} class="vector-input" text={props.item.axisValues[0]}
                   preferredWidth={54.0f}
                   onTextChange={(text: string) -> editor.document.EditField(props.item.axisKeys[0], text)} />
            <text class="vector-axis-y">Y</text>
            <input ref={`input-${props.item.axisKeys[1]}`} class="vector-input" text={props.item.axisValues[1]}
                   preferredWidth={54.0f}
                   onTextChange={(text: string) -> editor.document.EditField(props.item.axisKeys[1], text)} />
            <text class="vector-axis-z">Z</text>
            <input ref={`input-${props.item.axisKeys[2]}`} class="vector-input" text={props.item.axisValues[2]}
                   preferredWidth={54.0f}
                   onTextChange={(text: string) -> editor.document.EditField(props.item.axisKeys[2], text)} />
        </frame>
    );
}
