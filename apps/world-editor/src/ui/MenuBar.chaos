EditorMenus :: import EditorMenus;
EditorUi :: import EditorUi;

MenuBar :: () -> Penumbra:::Component {
    return (
        <frame ref="menu-bar" class="menu-bar">
            <icon class="menu-bar-logo" icon="light" size={14.0f} />
            <text class="menu-bar-brand">Lantern</text>
            <slot>
                !{EditorMenus:::Names().map((name: string) ->
                    <frame key={name} class={EditorUi:::App().OpenMenu() == name ? "menu-title-open" : "menu-title"}
                           onPress={() -> EditorUi:::App().ToggleMenu(name)}
                           onHover={() -> EditorUi:::App().HoverMenu(name)}>
                        <text class="menu-title-label">{name}</text>
                    </frame>)}
            </slot>
            <frame class="menu-bar-spacer" />
            <slot>
                !{<text class="menu-bar-title">{EditorUi:::App().Status().playing ? "▶ Playing" : ""}</text>}
            </slot>
        </frame>
    );
}
