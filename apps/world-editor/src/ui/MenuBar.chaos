Editor :: import Editor;
EditorMenus :: import EditorMenus;

MenuBar :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="menu-bar" class="menu-bar">
            <icon class="menu-bar-logo" icon="light" size={14.0f} />
            <text class="menu-bar-brand">Lantern</text>
            <slot>
                !{EditorMenus:::Names().map((name: string) ->
                    <frame key={name} class={editor.overlays.openMenu == name ? "menu-title-open" : "menu-title"}
                           onPress={() -> editor.overlays.ToggleMenu(name)}
                           onHover={() -> editor.overlays.HoverMenu(name)}>
                        <text class="menu-title-label">{name}</text>
                    </frame>)}
            </slot>
            <frame class="menu-bar-spacer" />
            <slot>
                !{<text class="menu-bar-title">{editor.document.status.playing ? "▶ Playing" : ""}</text>}
            </slot>
        </frame>
    );
}
