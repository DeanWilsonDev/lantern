Editor :: import Editor;

DocumentTabsUi :: namespace {
    TabClass :: (active: bool) -> string {
        return active ? "document-tab-active" : "document-tab";
    }

    LabelClass :: (active: bool) -> string {
        return active ? "tab-label-active" : "tab-label";
    }
}

DocumentTabs :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="document-tabs" class="document-tabs">
            <slot>
                !{(() -> Penumbra:::Component {
                    revision := editor.document.revision;
                    levelActive := editor.tabs.active == 0;
                    return (
                        <frame class="document-tab-row">
                            <frame ref="tab-level" class={DocumentTabsUi:::TabClass(levelActive)}
                                   onRelease={() -> editor.tabs.Show(0)}>
                                <icon class={DocumentTabsUi:::LabelClass(levelActive)} icon="cube" size={12.0f} />
                                <text class={DocumentTabsUi:::LabelClass(levelActive)}>Level</text>
                            </frame>
                            <slot>
                                !{editor.tabs.silhouette != ""
                                    ? <frame ref="tab-silhouette" class={DocumentTabsUi:::TabClass(editor.tabs.active == -1)}
                                             onRelease={() -> { editor.tabs.active = -1; }}>
                                          <icon class={DocumentTabsUi:::LabelClass(editor.tabs.active == -1)} icon="cube" size={12.0f} />
                                          <text class={DocumentTabsUi:::LabelClass(editor.tabs.active == -1)}>{editor.tabs.silhouette}</text>
                                          <frame ref="tab-silhouette-close" class="document-tab-close" onRelease={() -> editor.tabs.CloseSilhouette()}>
                                              <icon class="document-tab-close-glyph" icon="close" size={10.0f} />
                                          </frame>
                                      </frame>
                                    : <frame class="nothing" />}
                            </slot>
                            <slot>
                                !{editor.tabs.graphTab
                                    ? <frame ref="tab-graph" class={DocumentTabsUi:::TabClass(editor.tabs.active == -2)}
                                             onRelease={() -> { editor.tabs.active = -2; }}>
                                          <icon class={DocumentTabsUi:::LabelClass(editor.tabs.active == -2)} icon="cube" size={12.0f} />
                                          <text class={DocumentTabsUi:::LabelClass(editor.tabs.active == -2)}>Graph</text>
                                          <frame ref="tab-graph-close" class="document-tab-close" onRelease={() -> editor.tabs.CloseGraphTab()}>
                                              <icon class="document-tab-close-glyph" icon="close" size={10.0f} />
                                          </frame>
                                      </frame>
                                    : <frame class="nothing" />}
                            </slot>
                            <slot>
                                !{editor.tabs.entities.map((id: i64) ->
                                    <frame key={`tab-${id}`} ref={`tab-entity-${id}`}
                                           class={DocumentTabsUi:::TabClass(editor.tabs.active == id)}
                                           onRelease={() -> editor.tabs.Show(id)}>
                                        <icon class={DocumentTabsUi:::LabelClass(editor.tabs.active == id)} icon="pencil" size={12.0f} />
                                        <text class={DocumentTabsUi:::LabelClass(editor.tabs.active == id)}>{editorEntityName(id)}</text>
                                        <frame ref={`tab-close-${id}`} class="document-tab-close" onRelease={() -> editor.tabs.Close(id)}>
                                            <icon class="document-tab-close-glyph" icon="close" size={10.0f} />
                                        </frame>
                                    </frame>)}
                            </slot>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
