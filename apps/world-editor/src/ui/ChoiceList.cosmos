.choice-list {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 1px;
    padding: 3px;
    margin: 2px 0px 4px 0px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.choice-option {
    display: stack;
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0px var(--spacing-medium);
    border-radius: var(--border-radius-small);
}

.choice-option:hover {
    background-color: var(--color-row-hover);
}

.choice-option-current {
    display: stack;
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0px var(--spacing-medium);
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.choice-option-label {
    color: var(--color-text-primary);
}
