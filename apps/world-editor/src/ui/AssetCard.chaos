EditorModel :: import EditorModel;
EditorUi :: import EditorUi;
TemplateItem :: import TemplateItem;
TooltipArea :: import TooltipArea;

AssetCardProps :: data {
    item: TemplateItem;
}

AssetCard :: (props: AssetCardProps) -> Penumbra:::Component {
    return (
        <TooltipArea text="Drag into the viewport, or press Add" placement="inside">
            <frame ref={`asset-${props.item.id}`}
                   class={EditorUi:::App().PreviewTemplate() == props.item.id ? "asset-card-selected" : "asset-card"}
                   dragPayload={"template:" + props.item.id}
                   onPress={() -> EditorUi:::App().SetPreviewTemplate(props.item.id)}>
                <viewport class="asset-thumbnail" renderer={"thumbnail:" + props.item.id} />
                <frame class="asset-caption">
                    <icon class="asset-kind-icon" icon={EditorModel:::KindIcon(props.item.kind)} size={11.0f} />
                    <text class="asset-label">{props.item.label}</text>
                </frame>
            </frame>
        </TooltipArea>
    );
}
