EditorModel :: import EditorModel;
TemplateItem :: import TemplateItem;
TooltipArea :: import TooltipArea;

// The template to show, whether it is the selected card, what to do when it is pressed and what to do when it is
// double-clicked.
AssetCardProps :: data {
    item: TemplateItem;
    selected: bool;
    onSelect: () -> void;
    onOpen: () -> void;
}

// A card for a template (a Silhouette): a live thumbnail of the model above its name. Pressing it picks it (the asset
// preview shows it), double-clicking it opens it (as a Silhouette document, for a Silhouette); dragging it carries the payload `template:NAME`, which the viewport reads as a request to place
// that template where it is dropped. The tooltip says so.
AssetCard :: (props: AssetCardProps) -> Penumbra:::Component {
    return (
        <TooltipArea text="Drag into the viewport to place it there, double-click to edit it" placement="inside">
            <frame ref={`asset-${props.item.id}`}
                   class={props.selected ? "asset-card-selected" : "asset-card"}
                   dragPayload={"template:" + props.item.id}
                   onPress={() -> props.onSelect()}
                   onDoubleClick={() -> props.onOpen()}>
                <viewport class="asset-thumbnail" renderer={"thumbnail:" + props.item.id} />
                <frame class="asset-caption">
                    <icon class="asset-kind-icon" icon={EditorModel:::KindIcon(props.item.kind)} size={11.0f} />
                    <text class="asset-label">{props.item.label}</text>
                </frame>
            </frame>
        </TooltipArea>
    );
}
