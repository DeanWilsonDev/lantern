AssetCard :: import AssetCard;
Editor :: import Editor;
EditorModel :: import EditorModel;
IconButton :: import IconButton;
SilhouetteCategories :: import SilhouetteCategories;
TemplateItem :: import TemplateItem;

// What the panel shows for a category and a search: the templates in it, and how many each category holds.
SilhouettesPanelUi :: namespace {
    // The category of a template, counting a Silhouette's components, since one made of parts is a prop.
    Category :: (template: TemplateItem) -> string {
        components := template.fromSilhouette ? editorSilhouetteComponentCount(template.id) : 1;
        return SilhouetteCategories:::CategoryOf(template.kind, components);
    }

    // The templates in a category whose label or id holds the search text.
    Matching :: (category: string, query: string) -> Array<TemplateItem> {
        found~ Array<TemplateItem> = [];
        for template in EditorModel:::Templates() {
            guard SilhouetteCategories:::InCategory(category, Category(template)) continue;
            if SilhouetteCategories:::Matches(query, template.label, template.id) {
                found.add(template);
            }
        }
        return found;
    }

    // How many templates a category holds, for the number beside its name.
    Count :: (category: string) -> i32 {
        return Matching(category, "").length();
    }

    // The categories worth a row: All, Terrain (which always offers New Terrain), and any other with something in it.
    Shown :: () -> Array<string> {
        shown~ Array<string> = [];
        for category in SilhouetteCategories:::Categories() {
            if category == SilhouetteCategories:::ALL || category == "Terrain" || Count(category) > 0 {
                shown.add(category);
            }
        }
        return shown;
    }

    // True when the New Terrain button belongs above the grid: in All or Terrain, unless the search rules it out.
    OffersNewTerrain :: (category: string, query: string) -> bool {
        guard category == SilhouetteCategories:::ALL || category == "Terrain" return false;
        return SilhouetteCategories:::Matches(query, "New Terrain", "terrain");
    }

    CategoryClass :: (active: bool) -> string {
        return active ? "silhouettes-category-active" : "silhouettes-category";
    }
}

// The Silhouettes panel: everything that can be placed, from shapes, lights, cameras and gameplay markers to terrain
// and the project's own Silhouettes. It is one of the movable panels (PanelDocking), so its grip docks it on a side or
// under the viewport or floats it; it starts docked on the left and hidden, and the side rail's button, Shift+A and
// Alt+5 show or hide it. The column on the left picks a category with a click (editor.overlays.silhouettesCategory
// remembers it), the search box narrows the cards, and the cards on the right wrap into a grid as wide as the panel
// that scrolls up and down, each a live thumbnail. Pressing a card shows it in the asset preview; dragging a card into
// the viewport places it where the mouse lets go. `query` is the panel's own state.
SilhouettesPanel :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal query~ string = "";
    return (
        <frame ref="silhouettes-panel" class="silhouettes-panel">
            <frame class="silhouettes-panel-header">
                <icon class="silhouettes-category-icon" icon="layers" size={13.0f} />
                <text class="silhouettes-panel-title">Silhouettes</text>
                <frame class="toolbar-spacer" />
                <IconButton icon="close" tooltip="Hide (Shift+A)" tooltipPlacement="inside"
                            onPress={() -> editor.layout.SetShown("silhouettes", false)} />
            </frame>
            <frame class="search-row">
                <icon class="search-icon" icon="search" size={12.0f} />
                <input ref="silhouettes-search" class="search-input" text={query} preferredWidth={200.0f}
                       onTextChange={(text: string) -> { query = text; }} />
            </frame>
            <frame class="silhouettes-panel-body">
                <frame class="silhouettes-panel-categories">
                    <slot>
                        !{SilhouettesPanelUi:::Shown().map((category: string) ->
                            <frame key={`silhouettes-category-${category}`} ref={`silhouettes-category-${category}`}
                                   class={SilhouettesPanelUi:::CategoryClass(editor.overlays.silhouettesCategory == category)}
                                   onRelease={() -> { editor.overlays.silhouettesCategory = category; }}>
                                <icon class="silhouettes-category-icon" icon={SilhouetteCategories:::Icon(category)} size={12.0f} />
                                <text class="silhouettes-category-label">{category}</text>
                                <frame class="toolbar-spacer" />
                                <text class="silhouettes-category-count">{`${SilhouettesPanelUi:::Count(category)}`}</text>
                            </frame>)}
                    </slot>
                </frame>
                <frame class="silhouettes-panel-divider" />
                <frame class="silhouettes-panel-content">
                    <slot>
                        !{SilhouettesPanelUi:::OffersNewTerrain(editor.overlays.silhouettesCategory, query)
                            ? <frame ref="silhouettes-new-terrain" class="small-button-accent"
                                     onRelease={() -> editor.commands.RunCommand("terrain:generate")}>
                                  <icon class="small-button-icon-accent" icon="plus" size={12.0f} />
                                  <text class="small-button-label-accent">New Terrain</text>
                              </frame>
                            : <frame class="nothing" />}
                    </slot>
                    <scroll ref="silhouettes-scroll" class="silhouettes-panel-scroll" wheelStep={80.0f}>
                        <slot>
                            !{(() -> Penumbra:::Component {
                                matches := SilhouettesPanelUi:::Matching(editor.overlays.silhouettesCategory, query);
                                return matches.length() == 0
                                    ? <text class="silhouettes-panel-empty">Nothing matches</text>
                                    : <inline class="asset-cards">
                                          <slot>
                                              !{matches.map((item: TemplateItem) ->
                                                  <AssetCard key={`place-${item.id}`} item={item}
                                                             selected={editor.selection.previewTemplate == item.id}
                                                             onSelect={() -> editor.selection.Preview(item.id)} />)}
                                          </slot>
                                      </inline>;
                            })()}
                        </slot>
                    </scroll>
                </frame>
            </frame>
        </frame>
    );
}
