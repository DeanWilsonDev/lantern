Editor :: import Editor;
EditorModes :: import EditorModes;
CentreArea :: import CentreArea;
RightDock :: import RightDock;

// The area under the toolbar: the viewport and drawer in the centre, and the outliner and details docked on
// the right. Each panel can be shown or hidden (EditorLayout); with both right panels hidden, or in a mode without them
// (only Select mode has them), the centre takes the whole width.
Workspace :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="workspace" class="app-content">
            <slot>
                !{EditorModes:::ShowsRightDock(editor.Mode()) && (editor.layout.outlinerVisible || editor.layout.detailsVisible)
                    ? <split ref="root-split" class="workspace-fill" axis="horizontal" ratio={0.78f} minPaneSize={220.0f} handleThickness={4.0f}>
                          <CentreArea />
                          <RightDock />
                      </split>
                    : <CentreArea />}
            </slot>
        </frame>
    );
}
