ChoiceList :: import ChoiceList;
EditorUi :: import EditorUi;
InspectorFieldItem :: import InspectorFieldItem;

InspectorFieldProps :: data {
    item: InspectorFieldItem;
}

InspectorField :: (props: InspectorFieldProps) -> Penumbra:::Component {
    @signal choicesOpen~ bool = false;

    return (
        <frame ref={`field-${props.item.key}`} class="field">
            <frame class="field-row">
                <text class="field-label">{props.item.label}</text>
                <slot>
                    !{props.item.kind == "choice"
                        ? <frame ref={`choice-${props.item.key}`} class={choicesOpen ? "choice-button-open" : "choice-button"}
                                 onRelease={() -> { choicesOpen = !choicesOpen; }}>
                              <text class="choice-value">{props.item.value}</text>
                          </frame>
                        : props.item.kind == "readonly"
                            ? <text class="field-readonly">{props.item.value}</text>
                            : <input ref={`input-${props.item.key}`} class="field-input" text={props.item.value}
                                     preferredWidth={130.0f}
                                     onTextChange={(text: string) -> EditorUi:::App().EditField(props.item.key, text)} />}
                </slot>
            </frame>
            <slot>
                !{choicesOpen
                    ? <ChoiceList choices={props.item.choices} current={props.item.value}
                                  onPick={(choice: string) -> {
                                      choicesOpen = false;
                                      EditorUi:::App().PickChoice(props.item.key, choice);
                                  }} />
                    : <frame class="choice-list-closed" />}
            </slot>
        </frame>
    );
}
