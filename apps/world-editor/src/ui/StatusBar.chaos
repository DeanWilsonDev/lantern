Editor :: import Editor;
StatusInfo :: import StatusInfo;

StatusBar :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame class="status-bar">
            <slot>
                !{(() -> Penumbra:::Component {
                    info := editor.document.status;
                    state := editor.document.toolbar;
                    return (
                        <frame class="status-row">
                            <text ref="status" class="status-text">{info.status}</text>
                            <text class="status-chip">{info.entities}</text>
                            <text class="status-chip">{info.selected}</text>
                            <text class="status-chip">{state.tool + " · " + state.space + " · " + (state.snap ? "snap on" : "snap off")}</text>
                            <text class="status-chip">{info.camera}</text>
                            <text class="status-chip">{info.frames}</text>
                            <text class={info.playing ? "status-chip-live" : "status-chip-hidden"}>{info.playing ? "playing" : ""}</text>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
