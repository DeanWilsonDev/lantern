EditorUi :: import EditorUi;

SettingsUi :: namespace {
    WIDTH: f32 : 600.0f;
    HEIGHT: f32 : 440.0f;

    X :: () -> f32 {
        return (EditorUi:::App().WindowWidth() - WIDTH) * 0.5f;
    }

    Y :: () -> f32 {
        return (EditorUi:::App().WindowHeight() - HEIGHT) * 0.4f;
    }

    Tabs :: () -> Array<string> {
        return ["Viewport", "Snapping", "Camera", "Editor"];
    }

    TranslateSteps :: () -> Array<string> { return ["0.1", "0.25", "0.5", "1", "2"]; }
    RotateSteps :: () -> Array<string> { return ["5", "15", "45", "90"]; }
    ScaleSteps :: () -> Array<string> { return ["0.1", "0.25", "0.5", "1"]; }
    GridSpacings :: () -> Array<string> { return ["0.5", "1", "2", "5"]; }
    Presets :: () -> Array<string> { return ["perspective", "top", "bottom", "front", "back", "left", "right"]; }
    Bookmarks :: () -> Array<string> { return ["1", "2", "3", "4", "5", "6", "7", "8", "9"]; }
}
