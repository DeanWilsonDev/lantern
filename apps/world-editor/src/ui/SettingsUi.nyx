SettingsUi :: namespace {
    WIDTH: f32 : 600.0f;
    HEIGHT: f32 : 440.0f;

    X :: () -> f32 {
        return (penumbra:::windowWidth() - WIDTH) * 0.5f;
    }

    Y :: () -> f32 {
        return (penumbra:::windowHeight() - HEIGHT) * 0.4f;
    }

    Tabs :: () -> Array<string> {
        return ["Viewport", "Snapping", "Camera", "Editor"];
    }

    TranslateSteps :: () -> Array<string> { return ["0.1", "0.25", "0.5", "1", "2"]; }
    RotateSteps :: () -> Array<string> { return ["5", "15", "45", "90"]; }
    ScaleSteps :: () -> Array<string> { return ["0.1", "0.25", "0.5", "1"]; }
    GridSpacings :: () -> Array<string> { return ["0.5", "1", "2", "5"]; }
    Presets :: () -> Array<string> { return ["perspective", "top", "bottom", "front", "back", "left", "right"]; }
    Bookmarks :: () -> Array<string> { return ["1", "2", "3", "4", "5", "6", "7", "8", "9"]; }

    SnapStepChoice :: (name: string) -> string {
        step := editorSnapStep(name);
        if step < 0.175f { return "0.1"; }
        if step < 0.375f { return "0.25"; }
        if step < 0.75f { return "0.5"; }
        if step < 1.5f { return "1"; }
        if step < 3.5f { return "2"; }
        if step < 10.0f { return "5"; }
        if step < 30.0f { return "15"; }
        if step < 67.0f { return "45"; }
        return "90";
    }

    SetSnapStepChoice :: (name: string, choice: string) -> void {
        value := when choice {
            "0.1" -> 0.1f,
            "0.25" -> 0.25f,
            "0.5" -> 0.5f,
            "1" -> 1.0f,
            "2" -> 2.0f,
            "5" -> 5.0f,
            "15" -> 15.0f,
            "45" -> 45.0f,
            "90" -> 90.0f,
            default -> 1.0f
        };
        editorSetSnapStep(name, value);
    }
}
