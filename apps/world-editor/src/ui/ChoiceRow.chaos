

ChoiceRowProps :: data {
    label: string;
    options: Array<string>;
    selected: string;
    onSelect: (choice: string) -> void;
}

ChoiceRow :: (props: ChoiceRowProps) -> Penumbra:::Component {
    return (
        <frame class="setting-row">
            <text class="setting-label-wide">{props.label}</text>
            <select class="field-select" options={props.options} selected={props.selected} onSelect={props.onSelect} />
        </frame>
    );
}
