EditorUi :: import EditorUi;

SettingsTabProps :: data {
    tab: string;
}

SettingsTab :: (props: SettingsTabProps) -> Penumbra:::Component {
    return (
        <frame class={EditorUi:::App().SettingsTab() == props.tab ? "tab-active" : "tab"}
               onRelease={() -> EditorUi:::App().SetSettingsTab(props.tab)}>
            <text class={EditorUi:::App().SettingsTab() == props.tab ? "tab-label-active" : "tab-label"}>{props.tab}</text>
        </frame>
    );
}
