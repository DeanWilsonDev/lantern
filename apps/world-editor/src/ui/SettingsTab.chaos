SettingsTabProps :: data {
    tab: string;
    active: bool;
    onSelect: () -> void;
}

SettingsTab :: (props: SettingsTabProps) -> Penumbra:::Component {
    return (
        <frame class={props.active ? "tab-active" : "tab"} onRelease={() -> props.onSelect()}>
            <text class={props.active ? "tab-label-active" : "tab-label"}>{props.tab}</text>
        </frame>
    );
}
