EditorUi :: import EditorUi;

IconButtonProps :: data {
    icon: string;
    tooltip: string;
    active: bool = false;
    enabled: bool = true;
    onPress: () -> void;
}

IconButtonUi :: namespace {
    FrameClass :: (props: IconButtonProps) -> string {
        guard props.enabled return "icon-button-disabled";
        return props.active ? "icon-button-active" : "icon-button";
    }

    IconClass :: (props: IconButtonProps) -> string {
        guard props.enabled return "icon-button-glyph-disabled";
        return props.active ? "icon-button-glyph-active" : "icon-button-glyph";
    }
}

IconButton :: (props: IconButtonProps) -> Penumbra:::Component {
    // NOTE: This breaks the tooltip but this is an example of how choas SHOULD be written instead of it all being inside Editor:::App().
    // Chaos needs fixing so that this works.
    @signal pendingTooltip~ string = "";
    @signal tooltipText~ string = "";
    @signal tooltipTimer~ f32 = 0.0f;

    ShowTooltip ~= (text: string) -> void {
        guard pendingTooltip != text return;
        pendingTooltip = text;
        tooltipTimer = 0.0f;
        tooltipText = "";
    };

    return (
        <frame
            class={IconButtonUi:::FrameClass(props)}
            onRelease={() -> { if props.enabled { props.onPress(); } }}
            onHover={() -> ShowTooltip(props.tooltip)}
            onHoverEnd={() -> EditorUi:::App().HideTooltip()}
        >
            <icon class={IconButtonUi:::IconClass(props)} icon={props.icon} size={16.0f} />
        </frame>
    );
}
