TooltipArea :: import TooltipArea;

IconButtonProps :: data {
    icon: string;
    tooltip: string;
    tooltipPlacement: string = "below";
    active: bool = false;
    enabled: bool = true;
    onPress: () -> void;
}

IconButtonUi :: namespace {
    FrameClass :: (props: IconButtonProps) -> string {
        guard props.enabled return "icon-button-disabled";
        return props.active ? "icon-button-active" : "icon-button";
    }

    IconClass :: (props: IconButtonProps) -> string {
        guard props.enabled return "icon-button-glyph-disabled";
        return props.active ? "icon-button-glyph-active" : "icon-button-glyph";
    }
}

IconButton :: (props: IconButtonProps) -> Penumbra:::Component {
    return (
        <TooltipArea text={props.tooltip} placement={props.tooltipPlacement}>
            <frame
                class={IconButtonUi:::FrameClass(props)}
                onRelease={() -> { if props.enabled { props.onPress(); } }}
            >
                <icon class={IconButtonUi:::IconClass(props)} icon={props.icon} size={16.0f} />
            </frame>
        </TooltipArea>
    );
}
