EditorDocument :: import EditorDocument;
EditorLayout :: import EditorLayout;
EditorModel :: import EditorModel;
EditorOverlays :: import EditorOverlays;
OutlinerState :: import OutlinerState;
SettingsUi :: import SettingsUi;

// Every command the person can run, by a short name: from the menus, the right click menu, the command
// palette and the keyboard shortcuts, which all end up in RunCommand. It also handles the questions that
// come with them: "save first?" before something that would lose changes, and the open and save file
// dialogs, which finish later (PollFileDialog).
EditorCommands :: class {
public:
    // A dialog answer that carries a command to run after saving: "saveAsThen:open" means save as, then open.
    static SAVE_AS_THEN :: "saveAsThen:";

    document~ EditorDocument;
    overlays~ EditorOverlays;
    layout~ EditorLayout;
    outliner~ OutlinerState;
    pendingDialog~ string = "";

    EditorCommands~: (document~ EditorDocument, overlays~ EditorOverlays, layout~ EditorLayout,
                      outliner~ OutlinerState) {
        this.outliner = outliner;
        this.document = document;
        this.overlays = overlays;
        this.layout = layout;
    }

    // Runs a command by name and then refreshes the interface. It first closes any popup. Commands that
    // would lose unsaved changes (new, open, quit) go through WhenSaved. Commands with an argument
    // are written "name:argument" and handled by RunPrefixedCommand.
    RunCommand~: (command: string) -> void {
        this.overlays.CloseAll();
        when command {
            "new" -> this.WhenSaved(command, () -> { editorNewWorld("untitled"); }),
            "open" -> this.WhenSaved(command, () -> { this.ShowDialog("open"); }),
            "save" -> this.Save(),
            "saveAs" -> this.ShowDialog("saveAs"),
            "quit" -> this.WhenSaved(command, () -> { this.Quit(); }),
            "play" -> { editorPlay(); },
            "stop" -> { editorStopPlay(); },
            "settings" -> this.overlays.OpenSettings(),
            "commandPalette" -> this.overlays.OpenPalette(),
            "undo" -> { editorUndo(); },
            "redo" -> { editorRedo(); },
            "duplicate" -> { editorDuplicateSelection(); },
            "delete" -> { editorDeleteSelection(); },
            "focusViewport" -> this.layout.ToggleFocus(),
            "rename" -> this.outliner.BeginRename(editorPrimarySelection()),
            "toggleSnap" -> { editorSetSnap(!editorSnap()); },
            "toggleSpace" -> { editorSetSpace(editorSpace() == "world" ? "local" : "world"); },
            "togglePivot" -> { editorSetPivotMode(editorPivotMode() == "primary" ? "center" : "primary"); },
            "selectAll" -> { editorSelectAll(); },
            "invertSelection" -> { editorInvertSelection(); },
            "selectChildren" -> { editorSelectChildren(); },
            "selectSimilar" -> { editorSelectKind(editorEntityKind(editorPrimarySelection())); },
            "deselect" -> { editorClearSelection(); },
            "hide" -> { editorHideSelection(); },
            "showEntity" -> { editorSetHidden(this.overlays.contextEntity, false); },
            "unhideAll" -> { editorUnhideAll(); },
            "lock" -> { editorLockSelection(true); },
            "unlock" -> { editorLockSelection(false); },
            "unparent" -> { editorSetParent(this.overlays.contextEntity, EditorModel:::ROOT_ENTITY); },
            "frameSelection" -> { editorFrameSelection(); },
            "frameAll" -> { editorFrameAll(); },
            "toggleGrid" -> ToggleViewOption("grid"),
            "gridLarger" -> StepGridSpacing(1),
            "gridSmaller" -> StepGridSpacing(-1),
            "isolate" -> IsolateSelection(),
            "toggleWireframe" -> ToggleViewOption("wireframe"),
            "toggleColliders" -> ToggleViewOption("colliders"),
            "toggleMarkers" -> ToggleViewOption("markers"),
            "toggleLevelBounds" -> ToggleViewOption("level_bounds"),
            "toggleShowHidden" -> ToggleViewOption("hidden"),
            "toggleStats" -> ToggleViewOption("stats"),
            "toggleOrtho" -> { editorSetOrthographic(!editorIsOrthographic()); },
            "alignCameraToSelection" -> { editorAlignCameraToSelection(); },
            "alignSelectionToCamera" -> { editorAlignSelectionToCamera(); },
            "group" -> { editorGroupSelection(); },
            "snapToGround" -> { editorSnapSelectionToGround(); },
            "revertToTemplate" -> { editorRevertToTemplate(); },
            "applyToTemplate" -> { editorApplyToTemplate(); },
            default -> this.RunPrefixedCommand(command)
        }
        this.document.Refresh(false);
    }

    // Runs a command of the form "prefix:argument": camera preset, duplicate along an axis, mirror, align,
    // distribute, show a bottom panel, show a help page, choose a tool, open a recent file, and the
    // camera bookmarks (the argument is a single digit). Unknown prefixes do nothing.
    RunPrefixedCommand~: (command: string) -> void {
        colon := command.indexOf(":", 0);
        guard colon > 0 return;
        prefix := command.substring(0, colon);
        argument := command.substring(colon + 1, command.length() - colon - 1);
        when prefix {
            "camera" -> { editorCameraPreset(argument); },
            "duplicateAlong" -> { editorDuplicateAlong(argument); },
            "mirror" -> { editorMirrorSelection(argument); },
            "align" -> { editorAlignSelection(argument); },
            "distribute" -> { editorDistributeSelection(argument); },
            "viewportMenu" -> this.overlays.ToggleViewportMenu(argument),
            "panel" -> this.layout.ShowBottomPanel(argument),
            "togglePanel" -> this.layout.TogglePanel(argument),
            "help" -> this.overlays.ShowHelp(argument),
            "tool" -> { editorSetTool(argument); },
            "openRecent" -> this.OpenRecent(EditorModel:::HexDigit(argument, 0)),
            "bookmarkSet" -> { editorSetBookmark(EditorModel:::HexDigit(argument, 0)); },
            "bookmarkGo" -> { editorGoToBookmark(EditorModel:::HexDigit(argument, 0)); },
            (other) -> {}
        }
    }

    // The answer "save" to the save question: saves, asking for a file name first if the level has none, and
    // then runs the command that was waiting.
    ConfirmSave~: () -> void {
        command := this.overlays.confirmCommand;
        this.overlays.ClearConfirmCommand();
        if editorDocumentPath() == "" {
            this.pendingDialog = SAVE_AS_THEN + command;
            penumbra:::showSaveFileDialog("World files", "json", WorldsDirectory());
            return;
        }
        guard editorSave() return;
        this.RunCommand(command);
    }

    // The answer "don't save": runs the waiting command without saving.
    ConfirmDiscard~: () -> void {
        command := this.overlays.confirmCommand;
        this.overlays.ClearConfirmCommand();
        when command {
            "new" -> { editorNewWorld("untitled"); },
            "open" -> this.ShowDialog("open"),
            "quit" -> this.Quit(),
            default -> this.RunPrefixedCommand(command)
        }
        this.document.Refresh(false);
    }

    // The answer "cancel": forgets the waiting command.
    ConfirmCancel~: () -> void {
        this.overlays.ClearConfirmCommand();
    }

    // Called every frame. When the file dialog the app asked for has closed, carries out what it was for:
    // open the file, save to it, or save to it and then run the command that was waiting. A cancel does
    // nothing.
    PollFileDialog~: () -> void {
        guard this.pendingDialog != "" return;
        guard penumbra:::fileDialogFinished() return;
        kind := this.pendingDialog;
        this.pendingDialog = "";
        path := penumbra:::takeFileDialogResult();
        guard path != "" return;
        when kind {
            "open" -> { editorOpen(path); },
            "saveAs" -> { editorSaveAs(path); },
            default -> {
                if kind.startsWith(SAVE_AS_THEN) && editorSaveAs(path) {
                    this.RunCommand(kind.substring(SAVE_AS_THEN.length(), kind.length() - SAVE_AS_THEN.length()));
                }
            }
        }
    }

    // Runs an action now if there are no unsaved changes, otherwise asks the person whether to save first.
    WhenSaved~: (command: string, action: () -> void) -> void {
        if editorIsDirty() {
            this.overlays.AskToSave(command);
            return;
        }
        action();
    }

    // Saves, or opens Save As if the level has no file yet.
    Save~: () -> void {
        if editorDocumentPath() == "" {
            this.ShowDialog("saveAs");
            return;
        }
        editorSave();
    }

    // Opens the open or save dialog, starting at the level's file or the worlds folder. Only one dialog
    // at a time.
    ShowDialog~: (kind: string) -> void {
        guard this.pendingDialog == "" return;
        this.pendingDialog = kind;
        start := editorDocumentPath() == "" ? WorldsDirectory() : editorDocumentPath();
        if kind == "open" {
            penumbra:::showOpenFileDialog("World files", "json", start);
        } else {
            penumbra:::showSaveFileDialog("World files", "json", start);
        }
    }

    // Opens the numbered entry of the recent files list, after the save question if needed.
    OpenRecent~: (index: i32) -> void {
        recentFiles := this.document.recentFiles;
        guard index < recentFiles.length() return;
        path := recentFiles[index];
        this.WhenSaved(`openRecent:${index}`, () -> { editorOpen(path); });
    }

    // Saves the preferences and asks the application to quit.
    Quit~: () -> void {
        editorSavePreferences();
        penumbra:::requestQuit();
    }

    // Flips a View menu option between true and false.
    ToggleViewOption :: (name: string) -> void {
        editorSetViewOption(name, editorViewOption(name) == "true" ? "false" : "true");
    }

    IsolateSelection :: () -> void {
        kept~ Array<i64> = [];
        for row~ i32 = 0; row < editorOutlineCount(); row++ {
            id := editorOutlineId(row);
            if editorIsSelected(id) {
                kept.add(id);
            }
        }
        editorInvertSelection();
        editorHideSelection();
        editorClearSelection();
        for id in kept {
            editorSelect(id, true);
        }
    }

    StepGridSpacing :: (direction: i32) -> void {
        spacings := SettingsUi:::GridSpacings();
        current := editorViewOption("grid_spacing");
        position~ i32 = 0;
        for index~ i32 = 0; index < spacings.length(); index++ {
            if spacings[index] == current {
                position = index;
            }
        }
        next := position + direction;
        guard next >= 0 && next < spacings.length() return;
        editorSetViewOption("grid_spacing", spacings[next]);
    }

    // The folder of level files in the assets folder.
    WorldsDirectory :: () -> string {
        return editorAssetsDirectory() + "/worlds";
    }
}
