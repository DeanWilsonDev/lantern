
Editor :: import Editor;

BottomTabUi :: namespace {
    TabClass :: (active: bool) -> string {
        return active ? "tab-active" : "tab";
    }

    TabLabelClass :: (active: bool) -> string {
        return active ? "tab-label-active" : "tab-label";
    }
}

BottomTabProps :: data {
    tab: string;
    icon: string;
    label: string;
}

BottomTab :: (props: BottomTabProps) -> Penumbra:::Component {
    @context editor~ Editor;
    active := editor.layout.bottomPanel == props.tab;
    return (
        <frame class={BottomTabUi:::TabClass(active)} onRelease={() -> editor.layout.ShowBottomPanel(props.tab)}>
            <icon class={BottomTabUi:::TabLabelClass(active)} icon={props.icon} size={12.0f} />
            <text class={BottomTabUi:::TabLabelClass(active)}>{props.label}</text>
        </frame>
    );
}
