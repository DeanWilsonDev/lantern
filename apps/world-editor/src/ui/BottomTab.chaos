EditorUi :: import EditorUi;

BottomPanelUi :: namespace {
    TabClass :: (tab: string) -> string {
        return EditorUi:::App().BottomPanel() == tab ? "tab-active" : "tab";
    }

    TabLabelClass :: (tab: string) -> string {
        return EditorUi:::App().BottomPanel() == tab ? "tab-label-active" : "tab-label";
    }
}

BottomTabProps :: data {
    tab: string;
    icon: string;
    label: string;
}

BottomTab :: (props: BottomTabProps) -> Penumbra:::Component {
    return (
        <frame class={BottomPanelUi:::TabClass(props.tab)} onRelease={() -> EditorUi:::App().SetBottomPanel(props.tab)}>
            <icon class={BottomPanelUi:::TabLabelClass(props.tab)} icon={props.icon} size={12.0f} />
            <text class={BottomPanelUi:::TabLabelClass(props.tab)}>{props.label}</text>
        </frame>
    );
}
