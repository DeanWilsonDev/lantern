// The tooltip's text, where its bubble goes (`below` the area, `inside` it, or at its `end`), and the component the
// tooltip belongs to, passed in as the area's children.
TooltipAreaProps :: data {
    text: string;
    placement: string = "below";
    children: Array<Penumbra:::Component> = [];
}

// DelaySeconds is how long the pointer must rest on the area before the bubble appears. BubbleClass picks the bubble's
// style for the placement.
TooltipAreaUi :: namespace {
    DelaySeconds :: () -> f32 { return 0.45f; }

    BubbleClass :: (props: TooltipAreaProps) -> string {
        return when props.placement {
            "inside" -> "tooltip-inside",
            "end" -> "tooltip-end",
            default -> "tooltip"
        };
    }
}

// Wraps other components and shows a bubble of text when the pointer rests on them. OnTick runs every frame: while
// hovering, it adds the frame's time to hoverSeconds and shows the bubble once the delay has passed. Leaving the area
// hides it and starts the count again. An area with no text never shows a bubble.
TooltipArea :: (props: TooltipAreaProps) -> Penumbra:::Component {
    @signal hovering~ bool = false;
    @signal hoverSeconds~ f32 = 0.0f;
    @signal shown~ bool = false;

    StartHover := () -> void {
        guard !hovering return;
        hovering = true;
        hoverSeconds = 0.0f;
    };

    EndHover := () -> void {
        hovering = false;
        shown = false;
    };

    OnTick := (deltaSeconds: f32) -> {
        guard hovering && !shown && props.text != "" return;
        hoverSeconds = hoverSeconds + deltaSeconds;
        guard hoverSeconds >= TooltipAreaUi:::DelaySeconds() return;
        shown = true;
    };

    return (
        <frame class="tooltip-area" onHover={() -> StartHover()} onHoverEnd={() -> EndHover()}>
            <slot>!{props.children}</slot>
            <slot>
                !{shown
                    ? <frame class={TooltipAreaUi:::BubbleClass(props)}>
                          <text class="tooltip-text">{props.text}</text>
                      </frame>
                    : <frame class="nothing" />}
            </slot>
        </frame>
    );
}
