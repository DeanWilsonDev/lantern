ChoiceRow :: import ChoiceRow;
EditorUi :: import EditorUi;
SettingsUi :: import SettingsUi;
ViewOptionRow :: import ViewOptionRow;

ViewportSettings :: () -> Penumbra:::Component {
    state := EditorUi:::App().Toolbar();
    return (
        <frame class="settings-page">
            <text class="settings-heading">What the viewport draws</text>
            <ViewOptionRow label="Grid" option="grid" checked={state.showGrid} />
            <ViewOptionRow label="Wireframe" option="wireframe" checked={state.wireframe} />
            <ViewOptionRow label="Colliders" option="colliders" checked={state.showColliders} />
            <ViewOptionRow label="Spawn, checkpoint and trigger markers" option="markers" checked={state.showMarkers} />
            <ViewOptionRow label="Level bounds" option="level_bounds" checked={state.showLevelBounds} />
            <ViewOptionRow label="Hidden entities, as outlines" option="hidden" checked={state.showHidden} />
            <ViewOptionRow label="Statistics in the status bar" option="stats" checked={state.showStats} />
            <ChoiceRow label="Grid spacing" options={SettingsUi:::GridSpacings()} selected={EditorUi:::App().GridSpacingChoice()}
                       onSelect={(choice: string) -> EditorUi:::App().SetGridSpacingChoice(choice)} />
        </frame>
    );
}
