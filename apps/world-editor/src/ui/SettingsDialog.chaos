CameraSettings :: import CameraSettings;
EditorSettings :: import EditorSettings;
EditorUi :: import EditorUi;
SettingsTab :: import SettingsTab;
SettingsUi :: import SettingsUi;
SnappingSettings :: import SnappingSettings;
ViewportSettings :: import ViewportSettings;

SettingsDialog :: () -> Penumbra:::Component {
    return (
        <portal ref="settings-dialog" x={SettingsUi:::X()} y={SettingsUi:::Y()} width={SettingsUi:::WIDTH}
                height={SettingsUi:::HEIGHT} dismissOnOutsideClick={false}>
            <frame class="dialog">
                <frame class="dialog-title-row">
                    <icon class="dialog-icon" icon="gear" size={16.0f} />
                    <text class="dialog-title">Settings</text>
                    <frame class="toolbar-spacer" />
                    <frame class="icon-button" onRelease={() -> EditorUi:::App().CloseSettings()}>
                        <icon class="icon-button-glyph" icon="close" size={14.0f} />
                    </frame>
                </frame>
                <slot>
                    !{<frame class="tab-row">
                        <slot>
                            !{SettingsUi:::Tabs().map((tab: string) -> <SettingsTab key={tab} tab={tab} />)}
                        </slot>
                    </frame>}
                </slot>
                <slot>
                    !{EditorUi:::App().SettingsTab() == "Snapping"
                        ? <SnappingSettings />
                        : EditorUi:::App().SettingsTab() == "Camera"
                            ? <CameraSettings />
                            : EditorUi:::App().SettingsTab() == "Editor"
                                ? <EditorSettings />
                                : <ViewportSettings />}
                </slot>
                <frame class="dialog-actions">
                    <frame class="small-button-accent" onRelease={() -> EditorUi:::App().CloseSettings()}>
                        <text class="small-button-label-accent">Done</text>
                    </frame>
                </frame>
            </frame>
        </portal>
    );
}
