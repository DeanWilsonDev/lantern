EditorUi :: import EditorUi;
HistoryItem :: import HistoryItem;

HistoryUi :: namespace {
    RowClass :: (item: HistoryItem) -> string {
        guard !item.current return "history-row-current";
        return item.done ? "history-row" : "history-row-undone";
    }

    LabelClass :: (item: HistoryItem) -> string {
        return item.done ? "history-label" : "history-label-undone";
    }
}

HistoryPanel :: () -> Penumbra:::Component {
    return (
        <frame class="history">
            <frame class="console-header">
                <text class="panel-title">Undo history. Click a step to jump to it.</text>
            </frame>
            <scroll ref="history-scroll" class="console-scroll" wheelStep={60.0f}>
                <frame class="console-rows">
                    <slot>
                        !{EditorUi:::App().History().map((item: HistoryItem) ->
                            <frame key={item.key} class={HistoryUi:::RowClass(item)}
                                   onRelease={() -> EditorUi:::App().JumpHistory(item.position)}>
                                <icon class={HistoryUi:::LabelClass(item)} icon={item.current ? "chevron-right" : "dot-grid"} size={10.0f} />
                                <text class={HistoryUi:::LabelClass(item)}>{item.label}</text>
                            </frame>)}
                    </slot>
                </frame>
            </scroll>
        </frame>
    );
}
