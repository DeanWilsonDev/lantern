AssetBrowserUi :: import AssetBrowserUi;
AssetCard :: import AssetCard;
AssetEntry :: import AssetEntry;
Editor :: import Editor;
TemplateItem :: import TemplateItem;

// The Silhouettes that match a search, or all of them when it is empty, leaving out everything else the asset browser
// lists.
SilhouetteBrowserUi :: namespace {
    Silhouettes :: (query: string) -> Array<AssetEntry> {
        rows~ Array<AssetEntry> = [];
        for entry in AssetBrowserUi:::Entries(query == "" ? "Silhouettes" : "", query) {
            if entry.kind == "silhouette" {
                rows.add(entry);
            }
        }
        return rows;
    }
}

// The Silhouettes tab: a search box and the matching Silhouettes as a grid of cards that fills downwards and scrolls,
// as in the Assets tab but for Silhouettes only. It shares the asset browser's helpers. Pressing a card shows it in the
// asset preview panel, and dragging one into the viewport places it there.
SilhouetteBrowser :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal query~ string = "";
    return (
        <frame class="asset-browser">
            <frame class="asset-main">
                <frame class="asset-bar">
                    <icon class="search-icon" icon="search" size={12.0f} />
                    <input ref="silhouette-search" class="search-input" text={query}
                           preferredWidth={220.0f}
                           onTextChange={(text: string) -> { query = text; }} />
                    <text class="asset-path">Search every Silhouette, then drag one into the level.</text>
                </frame>
                <scroll ref="silhouette-scroll" class="asset-scroll" wheelStep={80.0f}>
                    <inline class="asset-cards">
                        <slot>
                            !{SilhouetteBrowserUi:::Silhouettes(query).map((entry: AssetEntry) ->
                                <AssetCard key={entry.path} item={TemplateItem { id: entry.label, label: entry.label, kind: "block" }}
                                           selected={editor.selection.previewTemplate == entry.label}
                                           onSelect={() -> editor.selection.Preview(entry.label)} />)}
                        </slot>
                    </inline>
                </scroll>
            </frame>
        </frame>
    );
}
