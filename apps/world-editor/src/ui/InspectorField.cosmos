.field {
    display: stack;
    flex-direction: column;
    align-items: stretch;
}

.field-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 26px;
}

.field-label {
    color: var(--color-text-disabled);
    text-overflow: ellipsis;
    flex-grow: 1;
}

.field-readonly {
    color: var(--color-text-primary);
    padding: 0px var(--spacing-small);
}

.field-input {
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
    color: var(--color-text-primary);
    padding: 3px var(--spacing-small);
}

.field-select {
    min-width: 150px;
    color: var(--color-text-primary);
    background-color: var(--color-window-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    padding: 2px 8px;
}

.field-checkbox {
    accent-color: var(--color-accent);
    color: var(--color-text-primary);
    font-size: 14px;
    border-width: var(--border-width-default);
    border-color: var(--color-text-disabled);
    border-radius: 3px;
    background-color: var(--color-window-background);
}

.field-remove {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 4px;
}

.field-remove:hover {
    background-color: var(--color-row-selected);
}

.field-remove-icon {
    color: var(--color-text-disabled);
}

.vector-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 3px;
}

.vector-axis-x {
    color: #FF6E6EFF;
    font-size: 11px;
}

.vector-axis-y {
    color: #68E098FF;
    font-size: 11px;
}

.vector-axis-z {
    color: #68A8FFFF;
    font-size: 11px;
}

.vector-input {
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
    color: var(--color-text-primary);
    padding: 3px 4px;
}

.color-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.color-swatch {
    width: 22px;
    height: 18px;
    border-radius: 4px;
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: rgb(attr(red), attr(green), attr(blue));
}

.color-swatch-empty {
    width: 22px;
    height: 18px;
    border-radius: 4px;
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
}
