.field {
    display: stack;
    flex-direction: column;
    align-items: stretch;
}

.field-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 26px;
}

.field-label {
    color: var(--color-text-disabled);
    text-overflow: ellipsis;
    flex-grow: 1;
}

.field-readonly {
    color: var(--color-text-primary);
    padding: 0px var(--spacing-small);
}

.field-input {
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
    color: var(--color-text-primary);
    padding: 3px var(--spacing-small);
}

.choice-button {
    display: stack;
    align-items: center;
    width: 130px;
    padding: 3px var(--spacing-small);
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.choice-button:hover {
    background-color: var(--color-row-hover);
}

.choice-button-open {
    display: stack;
    align-items: center;
    width: 130px;
    padding: 3px var(--spacing-small);
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-accent);
    background-color: var(--color-row-selected);
}

.choice-value {
    color: var(--color-text-primary);
}

.choice-list-closed {
    height: 0px;
}
