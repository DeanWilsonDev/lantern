Editor :: import Editor;

GraphPageUi :: namespace {
    FunctionNumber :: (name: string) -> i32 {
        names := Lines(editorGraphFunctions());
        for position~ i32 = 0; position < names.length(); position++ {
            if names[position] == name {
                return position;
            }
        }
        return 0;
    }

    Lines :: (text: string) -> Array<string> {
        rows~ Array<string> = [];
        for piece in text.split("\n") {
            if piece != "" {
                rows.add(piece);
            }
        }
        return rows;
    }

    LineNumbers :: (text: string) -> Array<i32> {
        numbers~ Array<i32> = [];
        count := text.split("\n").length();
        for number~ i32 = 1; number <= count; number++ {
            numbers.add(number);
        }
        return numbers;
    }

    LineLabel :: (text: string, number: i32) -> string {
        return `${number}  ${text.split("\n")[number - 1]}`;
    }

    FieldsOf :: (kind: string) -> Array<string> {
        return when kind {
            "branch" -> ["condition"],
            "while" -> ["condition"],
            "when" -> ["a", "match0", "match1", "match2", "match3"],
            "set" -> ["name", "type", "value"],
            "return" -> ["value"],
            "call" -> ["function", "name", "type", "arg0", "arg1", "arg2"],
            "nyx" -> ["text"],
            "nyx_value" -> ["text"],
            "not" -> ["a"],
            "entry" -> [],
            default -> ["a", "b"]
        };
    }

    IsNumber :: (text: string) -> bool {
        if text == "" {
            return false;
        }
        dots~ i32 = 0;
        for position~ i32 = 0; position < text.length(); position++ {
            piece := text.substring(position, 1);
            if piece == "." {
                dots = dots + 1;
            } else if !"0123456789".contains(piece) {
                return false;
            }
        }
        return dots <= 1;
    }

    Reference :: (text: string) -> string {
        if text == "true" || text == "false" {
            return `#${text}`;
        }
        if text.startsWith("\"") {
            return `#${text}`;
        }
        if IsNumber(text) {
            return text.contains(".") ? `#${text}f` : `#${text}`;
        }
        return text;
    }

    Shown :: (stored: string) -> string {
        return stored.startsWith("#") ? stored.substring(1, stored.length() - 1) : stored;
    }

    FieldClass :: (selected: bool) -> string {
        return selected ? "entity-page-component-selected" : "entity-page-component";
    }

    DirtyMark :: () -> string {
        return editorGraphIsDirty() ? " (unsaved)" : "";
    }
}

GraphPage :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal revision~ i32 = 0;
    @signal pageStatus~ string = "";
    @signal newGraphName~ string = "";
    @signal newFunctionName~ string = "";
    @signal chosenField~ string = "";
    @signal chosenNode~ string = "";
    @signal fieldText~ string = "";
    return (
        <frame ref="graph-page" class="entity-page">
            <slot>
                !{(() -> Penumbra:::Component {
                    revisionNow := revision + editor.document.graphRevision;
                    isOpen := editorGraphIsOpen();
                    selectedId := editorGraphSelected();
                    kind := selectedId == "" ? "" : editorGraphField("kind");
                    return (
                        <frame class="entity-page-body">
                            <frame class="entity-page-header">
                                <icon class="panel-header-icon" icon="cube" size={14.0f} />
                                <text class="entity-page-title">Graph</text>
                                <text class="entity-page-kind">{isOpen ? `${editorGraphStatus()}${GraphPageUi:::DirtyMark()}` : "Open a graph, or make a new one."}</text>
                                <frame class="toolbar-spacer" />
                                <frame ref="graph-format-button" class="small-button"
                                       onRelease={() -> {
                                           editorGraphFormat();
                                           revision = revision + 1;
                                       }}>
                                    <text class="small-button-label">Format graph</text>
                                </frame>
                                <frame ref="graph-save-button" class="small-button-accent"
                                       onRelease={() -> {
                                           pageStatus = editorGraphSave();
                                           revision = revision + 1;
                                       }}>
                                    <text class="small-button-label-accent">Save</text>
                                </frame>
                            </frame>
                            <frame class="entity-page-columns">
                                <frame class="entity-page-list">
                                    <text class="entity-page-heading">Graphs</text>
                                    <slot>
                                        !{GraphPageUi:::Lines(editorGraphList()).map((name: string) ->
                                            <frame key={`graph-${name}`} ref={`graph-open-${name}`} class="entity-page-component"
                                                   onRelease={() -> {
                                                       pageStatus = editorGraphOpen(name, false);
                                                       chosenField = "";
                                                       revision = revision + 1;
                                                   }}>
                                                <text class="entity-page-component-name">{name}</text>
                                            </frame>)}
                                    </slot>
                                    <frame class="field-row">
                                        <input ref="graph-new-name" class="field-input" text={newGraphName}
                                               preferredWidth={110.0f}
                                               onTextChange={(text: string) -> { newGraphName = text; }} />
                                        <frame ref="graph-new-button" class="small-button"
                                               onRelease={() -> {
                                                   pageStatus = editorGraphOpen(newGraphName, true);
                                                   chosenField = "";
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">New</text>
                                        </frame>
                                    </frame>
                                    <text class="entity-page-heading">Functions</text>
                                    <slot>
                                        !{GraphPageUi:::Lines(editorGraphFunctions()).map((name: string) ->
                                            <frame key={`graph-function-${name}`} ref={`graph-function-${name}`}
                                                   class={GraphPageUi:::FieldClass(editorGraphSelectedFunction() == GraphPageUi:::FunctionNumber(name))}
                                                   onRelease={() -> {
                                                       editorGraphSelectFunction(GraphPageUi:::FunctionNumber(name));
                                                       revision = revision + 1;
                                                   }}>
                                                <text class="entity-page-component-name">{name}</text>
                                            </frame>)}
                                    </slot>
                                    <frame class="field-row">
                                        <input ref="graph-new-function" class="field-input" text={newFunctionName}
                                               preferredWidth={110.0f}
                                               onTextChange={(text: string) -> { newFunctionName = text; }} />
                                        <frame ref="graph-add-function-button" class="small-button"
                                               onRelease={() -> {
                                                   pageStatus = editorGraphAddFunction(newFunctionName, "");
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">Add</text>
                                        </frame>
                                    </frame>
                                </frame>
                                <frame class="graph-centre">
                                    <viewport ref="graph-canvas" class="graph-canvas" renderer="graph" />
                                    <text ref="graph-page-status" class="entity-page-kind">{pageStatus}</text>
                                    <scroll ref="graph-nyx-scroll" class="graph-nyx" wheelStep={40.0f}>
                                        <frame class="entity-page-fields">
                                            <slot>
                                                !{GraphPageUi:::LineNumbers(isOpen ? editorGraphNyx() : "").map((lineNumber: i32) ->
                                                    <frame key={`graph-nyx-line-${lineNumber}`} class="graph-nyx-line" ref={`graph-nyx-line-${lineNumber}`}
                                                           onRelease={() -> {
                                                               guard editorGraphIsOpen() return;
                                                               editorGraphSelectLine(lineNumber);
                                                               revision = revision + 1;
                                                           }}>
                                                        <text class="entity-page-kind">{GraphPageUi:::LineLabel(editorGraphNyx(), lineNumber)}</text>
                                                    </frame>)}
                                            </slot>
                                        </frame>
                                    </scroll>
                                </frame>
                                <frame class="graph-side">
                                    <text class="entity-page-heading">{selectedId == "" ? "No node selected" : `${kind}: ${selectedId}`}</text>
                                    <slot>
                                        !{GraphPageUi:::FieldsOf(kind).map((field: string) ->
                                            <frame key={`graph-field-${field}`} ref={`graph-field-${field}`}
                                                   class={GraphPageUi:::FieldClass(chosenNode == selectedId && chosenField == field)}
                                                   onRelease={() -> {
                                                       chosenField = field;
                                                       chosenNode = selectedId;
                                                       fieldText = GraphPageUi:::Shown(editorGraphField(field));
                                                   }}>
                                                <text class="entity-page-component-name">{field}</text>
                                                <text class="entity-page-component-count">{GraphPageUi:::Shown(editorGraphField(field))}</text>
                                            </frame>)}
                                    </slot>
                                    <frame class="field-row">
                                        <input ref="graph-field-text" class="field-input" text={fieldText}
                                               preferredWidth={150.0f}
                                               onTextChange={(text: string) -> { fieldText = text; }} />
                                        <frame ref="graph-field-set-button" class="small-button"
                                               onRelease={() -> {
                                                   guard chosenField != "" && chosenNode == selectedId return;
                                                   pageStatus = editorGraphSetField(chosenField, GraphPageUi:::Reference(fieldText));
                                                   revision = revision + 1;
                                               }}>
                                            <text class="small-button-label">Set</text>
                                        </frame>
                                    </frame>
                                    <text class="entity-page-kind">Right-click empty canvas to add a node, drag a pin onto empty canvas for likely nodes, drag a node to move it, right-click a pin to disconnect, Delete removes the selected node, the wheel zooms.</text>
                                </frame>
                            </frame>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
