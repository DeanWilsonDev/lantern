Editor :: import Editor;

// Helpers for the graph tab. The engine hands this page its lists as text (one item per line, or tab-separated
// fields), and Lines and the Variable helpers split them. FieldsOf names the fields each kind of node can edit.
// A value typed into a field is stored as Nyx text: Reference turns `true`, a quoted string or a number into the form
// the graph stores (a number with a point becomes an f32), and Shown undoes that for display. VariableDefaultText does
// the same for a new variable's start value. SwatchClass picks the colour chip for a type, and LineNumbers and
// LineLabel number the lines of the Nyx the graph generates.
GraphPageUi :: namespace {
    FunctionNumber :: (name: string) -> i32 {
        names := Lines(editorGraphFunctions());
        for position~ i32 = 0; position < names.length(); position++ {
            if names[position] == name {
                return position;
            }
        }
        return 0;
    }

    Lines :: (text: string) -> Array<string> {
        rows~ Array<string> = [];
        for piece in text.split("\n") {
            if piece != "" {
                rows.add(piece);
            }
        }
        return rows;
    }

    CommentRows :: (commentIndex: i32) -> Array<string> {
        rows~ Array<string> = [];
        if commentIndex >= 0 {
            rows.add("comment");
        }
        return rows;
    }

    LineNumbers :: (text: string) -> Array<i32> {
        numbers~ Array<i32> = [];
        count := text.split("\n").length();
        for number~ i32 = 1; number <= count; number++ {
            numbers.add(number);
        }
        return numbers;
    }

    LineLabel :: (text: string, number: i32) -> string {
        return `${number}  ${text.split("\n")[number - 1]}`;
    }

    FieldsOf :: (kind: string) -> Array<string> {
        return when kind {
            "branch" -> ["condition"],
            "while" -> ["condition"],
            "when" -> ["a", "match0", "match1", "match2", "match3"],
            "set" -> ["name", "type", "value"],
            "get" -> ["name"],
            "return" -> ["value"],
            "call" -> ["function", "name", "type", "arg0", "arg1", "arg2"],
            "nyx" -> ["text"],
            "nyx_value" -> ["text"],
            "not" -> ["a"],
            "reroute" -> ["a"],
            "entry" -> [],
            default -> ["a", "b"]
        };
    }

    IsNumber :: (text: string) -> bool {
        if text == "" {
            return false;
        }
        dots~ i32 = 0;
        for position~ i32 = 0; position < text.length(); position++ {
            piece := text.substring(position, 1);
            if piece == "." {
                dots = dots + 1;
            } else if !"0123456789".contains(piece) {
                return false;
            }
        }
        return dots <= 1;
    }

    Reference :: (text: string) -> string {
        if text == "true" || text == "false" {
            return `#${text}`;
        }
        if text.startsWith("\"") {
            return `#${text}`;
        }
        if IsNumber(text) {
            return text.contains(".") ? `#${text}f` : `#${text}`;
        }
        return text;
    }

    Shown :: (stored: string) -> string {
        return stored.startsWith("#") ? stored.substring(1, stored.length() - 1) : stored;
    }

    FieldClass :: (selected: bool) -> string {
        return selected ? "entity-page-component-selected" : "entity-page-component";
    }

    VariableTypes :: () -> Array<string> {
        return ["bool", "i32", "i64", "f32", "f64", "string"];
    }

    SwatchClass :: (typeName: string) -> string {
        if typeName == "bool" {
            return "type-swatch-bool";
        }
        if typeName == "string" {
            return "type-swatch-string";
        }
        if typeName.startsWith("f") {
            return "type-swatch-float";
        }
        if typeName.startsWith("i") || typeName.startsWith("u") {
            return "type-swatch-integer";
        }
        return "type-swatch-other";
    }

    VariableRows :: (text: string) -> Array<string> {
        return Lines(text);
    }

    VariableName :: (row: string) -> string {
        return row.split("\t")[0];
    }

    VariableType :: (row: string) -> string {
        return row.split("\t")[1];
    }

    VariableLabel :: (row: string) -> string {
        parts := row.split("\t");
        return `${parts[0]}: ${parts[1]}`;
    }

    VariableDefaultText :: (typeName: string, text: string) -> string {
        if typeName == "string" && !text.startsWith("\"") {
            return `"${text}"`;
        }
        if typeName == "f32" && IsNumber(text) && !text.contains(".") {
            return `${text}.0f`;
        }
        if typeName == "f32" && IsNumber(text) {
            return `${text}f`;
        }
        return text;
    }

    DirtyMark :: () -> string {
        return editorGraphIsDirty() ? " (unsaved)" : "";
    }
}

// The graph tab, in three columns. On the left, the graphs that can be opened (and a box to make one), the functions of
// the open graph and its variables. In the middle, the canvas the graph is drawn on, the status line and the Nyx the
// graph generates, where clicking a line selects the node that made it. On the right, the selected node's fields,
// with a box to change the chosen one. Everything is read from and written to the engine through the editorGraph...
// functions. The page's @signals are its own: the text in each box, the chosen field and a counter, `revision`, that is
// added to once after every change so the page redraws.
GraphPage :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal revision~ i32 = 0;
    @signal pageStatus~ string = "";
    @signal newGraphName~ string = "";
    @signal newFunctionName~ string = "";
    @signal newVariableName~ string = "";
    @signal newVariableType~ string = "i32";
    @signal newVariableDefault~ string = "";
    @signal typePickerOpen~ bool = false;
    @signal chosenField~ string = "";
    @signal chosenNode~ string = "";
    @signal fieldText~ string = "";
    return (
        <frame ref="graph-page" class="entity-page">
            <slot>
                !{(() -> Penumbra:::Component {
                    revisionNow := revision + editor.document.graphRevision;
                    isOpen := editorGraphIsOpen();
                    selectedId := editorGraphSelected();
                    kind := selectedId == "" ? "" : editorGraphField("kind");
                    return (
                        <frame class="entity-page-body">
                            <frame class="entity-page-header">
                                <icon class="panel-header-icon" icon="cube" size={14.0f} />
                                <text class="entity-page-title">Graph</text>
                                <text class="entity-page-kind">{isOpen ? `${editorGraphStatus()}${GraphPageUi:::DirtyMark()}` : "Open a graph, or make a new one."}</text>
                                <frame class="toolbar-spacer" />
                                <frame ref="graph-format-button" class="small-button"
                                       onRelease={() -> {
                                           editorGraphFormat();
                                           revision = revision + 1;
                                       }}>
                                    <text class="small-button-label">Format graph</text>
                                </frame>
                                <frame ref="graph-save-button" class="small-button-accent"
                                       onRelease={() -> {
                                           pageStatus = editorGraphSave();
                                           revision = revision + 1;
                                       }}>
                                    <text class="small-button-label-accent">Save</text>
                                </frame>
                            </frame>
                            <frame class="entity-page-columns">
                                <frame class="entity-page-list">
                                    <text class="entity-page-heading">Graphs</text>
                                    <slot>
                                        !{GraphPageUi:::Lines(editorGraphList()).map((name: string) ->
                                            <frame key={`graph-${name}`} ref={`graph-open-${name}`} class="entity-page-component"
                                                   onRelease={() -> {
                                                       pageStatus = editorGraphOpen(name, false);
                                                       chosenField = "";
                                                       revision = revision + 1;
                                                   }}>
                                                <text class="entity-page-component-name">{name}</text>
                                            </frame>)}
                                    </slot>
                                    <frame class="field-row">
                                        <input ref="graph-new-name" class="field-input" text={newGraphName}
                                               preferredWidth={110.0f}
                                               onTextChange={(text: string) -> { newGraphName = text; }} />
                                        <frame ref="graph-new-button" class="small-button"
                                               onRelease={() -> {
                                                   pageStatus = editorGraphOpen(newGraphName, true);
                                                   chosenField = "";
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">New</text>
                                        </frame>
                                    </frame>
                                    <text class="entity-page-heading">Functions</text>
                                    <slot>
                                        !{GraphPageUi:::Lines(editorGraphFunctions()).map((name: string) ->
                                            <frame key={`graph-function-${name}`} ref={`graph-function-${name}`}
                                                   class={GraphPageUi:::FieldClass(editorGraphSelectedFunction() == GraphPageUi:::FunctionNumber(name))}
                                                   onRelease={() -> {
                                                       editorGraphSelectFunction(GraphPageUi:::FunctionNumber(name));
                                                       revision = revision + 1;
                                                   }}>
                                                <text class="entity-page-component-name">{name}</text>
                                            </frame>)}
                                    </slot>
                                    <frame class="field-row">
                                        <input ref="graph-new-function" class="field-input" text={newFunctionName}
                                               preferredWidth={110.0f}
                                               onTextChange={(text: string) -> { newFunctionName = text; }} />
                                        <frame ref="graph-add-function-button" class="small-button"
                                               onRelease={() -> {
                                                   pageStatus = editorGraphAddFunction(newFunctionName, "");
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">Add</text>
                                        </frame>
                                    </frame>
                                    <text class="entity-page-heading">Variables</text>
                                    <slot>
                                        !{GraphPageUi:::VariableRows(editorGraphVariables()).map((row: string) ->
                                            <frame key={`graph-variable-${GraphPageUi:::VariableName(row)}`} class="field-row">
                                                <frame class={GraphPageUi:::SwatchClass(GraphPageUi:::VariableType(row))} />
                                                <text class="entity-page-component-name">{GraphPageUi:::VariableLabel(row)}</text>
                                                <frame ref={`graph-variable-get-${GraphPageUi:::VariableName(row)}`} class="small-button"
                                                       onRelease={() -> {
                                                           editorGraphAddVariableNode("get", GraphPageUi:::VariableName(row));
                                                           revision = revision + 1;
                                                       }}>
                                                    <text class="small-button-label">Get</text>
                                                </frame>
                                                <frame ref={`graph-variable-set-${GraphPageUi:::VariableName(row)}`} class="small-button"
                                                       onRelease={() -> {
                                                           editorGraphAddVariableNode("set", GraphPageUi:::VariableName(row));
                                                           revision = revision + 1;
                                                       }}>
                                                    <text class="small-button-label">Set</text>
                                                </frame>
                                                <frame ref={`graph-variable-remove-${GraphPageUi:::VariableName(row)}`} class="small-button"
                                                       onRelease={() -> {
                                                           editorGraphRemoveVariable(GraphPageUi:::VariableName(row));
                                                           revision = revision + 1;
                                                       }}>
                                                    <icon class="small-button-icon" icon="trash" size={12.0f} />
                                                </frame>
                                            </frame>)}
                                    </slot>
                                    <frame class="field-row">
                                        <input ref="graph-variable-name" class="field-input" text={newVariableName}
                                               preferredWidth={70.0f}
                                               onTextChange={(text: string) -> { newVariableName = text; }} />
                                        <frame ref="graph-variable-type" class="type-picker"
                                               onRelease={() -> { typePickerOpen = !typePickerOpen; }}>
                                            <frame class={GraphPageUi:::SwatchClass(newVariableType)} />
                                            <text class="small-button-label">{newVariableType}</text>
                                            <icon class="small-button-icon" icon="chevron-down" size={10.0f} />
                                        </frame>
                                        <input ref="graph-variable-default" class="field-input" text={newVariableDefault}
                                               preferredWidth={44.0f}
                                               onTextChange={(text: string) -> { newVariableDefault = text; }} />
                                    </frame>
                                    <slot>
                                        !{typePickerOpen
                                            ? <frame key="type-list" class="type-list">
                                                  <slot>
                                                  !{GraphPageUi:::VariableTypes().map((typeName: string) ->
                                                      <frame key={`type-${typeName}`} ref={`graph-type-${typeName}`} class="type-option"
                                                             onRelease={() -> {
                                                                 newVariableType = typeName;
                                                                 typePickerOpen = false;
                                                             }}>
                                                          <frame class={GraphPageUi:::SwatchClass(typeName)} />
                                                          <text class="entity-page-component-name">{typeName}</text>
                                                      </frame>)}
                                                  </slot>
                                              </frame>
                                            : <frame key="type-list-closed" />}
                                    </slot>
                                    <frame class="field-row">
                                        <frame ref="graph-add-variable-button" class="small-button"
                                               onRelease={() -> {
                                                   pageStatus = editorGraphAddVariable(newVariableName, newVariableType, newVariableDefault == "" ? "" : GraphPageUi:::VariableDefaultText(newVariableType, newVariableDefault));
                                                   revision = revision + 1;
                                               }}>
                                            <icon class="small-button-icon" icon="plus" size={12.0f} />
                                            <text class="small-button-label">Add variable (name, type, start)</text>
                                        </frame>
                                    </frame>
                                </frame>
                                <frame class="graph-centre">
                                    <viewport ref="graph-canvas" class="graph-canvas" renderer="graph" />
                                    <text ref="graph-page-status" class="entity-page-kind">{pageStatus}</text>
                                    <scroll ref="graph-nyx-scroll" class="graph-nyx" wheelStep={40.0f}>
                                        <frame class="entity-page-fields">
                                            <slot>
                                                !{GraphPageUi:::LineNumbers(isOpen ? editorGraphNyx() : "").map((lineNumber: i32) ->
                                                    <frame key={`graph-nyx-line-${lineNumber}`} class="graph-nyx-line" ref={`graph-nyx-line-${lineNumber}`}
                                                           onRelease={() -> {
                                                               guard editorGraphIsOpen() return;
                                                               editorGraphSelectLine(lineNumber);
                                                               revision = revision + 1;
                                                           }}>
                                                        <text class="entity-page-kind">{GraphPageUi:::LineLabel(editorGraphNyx(), lineNumber)}</text>
                                                    </frame>)}
                                            </slot>
                                        </frame>
                                    </scroll>
                                </frame>
                                <frame class="graph-side">
                                    <text class="entity-page-heading">{selectedId == "" ? "No node selected" : `${kind}: ${selectedId}`}</text>
                                    <slot>
                                        !{GraphPageUi:::FieldsOf(kind).map((field: string) ->
                                            <frame key={`graph-field-${field}`} ref={`graph-field-${field}`}
                                                   class={GraphPageUi:::FieldClass(chosenNode == selectedId && chosenField == field)}
                                                   onRelease={() -> {
                                                       chosenField = field;
                                                       chosenNode = selectedId;
                                                       fieldText = GraphPageUi:::Shown(editorGraphField(field));
                                                   }}>
                                                <text class="entity-page-component-name">{field}</text>
                                                <text class="entity-page-component-count">{GraphPageUi:::Shown(editorGraphField(field))}</text>
                                            </frame>)}
                                    </slot>
                                    <frame class="field-row">
                                        <input ref="graph-field-text" class="field-input" text={fieldText}
                                               preferredWidth={150.0f}
                                               onTextChange={(text: string) -> { fieldText = text; }} />
                                        <frame ref="graph-field-set-button" class="small-button"
                                               onRelease={() -> {
                                                   guard chosenField != "" && chosenNode == selectedId return;
                                                   pageStatus = editorGraphSetField(chosenField, GraphPageUi:::Reference(fieldText));
                                                   revision = revision + 1;
                                               }}>
                                            <text class="small-button-label">Set</text>
                                        </frame>
                                    </frame>
                                    <slot>
                                        !{GraphPageUi:::CommentRows(editorGraphCommentIndex()).map((unused: string) ->
                                            <frame key="graph-comment-row" class="field-row">
                                                <text class="entity-page-component-name">Comment</text>
                                                <input ref="graph-comment-text" class="field-input" text={editorGraphCommentText()}
                                                       preferredWidth={150.0f}
                                                       onTextChange={(text: string) -> { editorGraphSetCommentText(text); }} />
                                            </frame>)}
                                    </slot>
                                    <text class="entity-page-kind">Right-click the canvas to add a node or comment. Drag a pin to empty canvas for likely nodes. Delete removes the selection. The wheel zooms.</text>
                                </frame>
                            </frame>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
