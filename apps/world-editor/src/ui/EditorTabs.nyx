// The document tabs above the centre of the editor: the Level tab, which is the 3D viewport, one tab for each
// Silhouette opened as a document, the Graph tab, and one tab for each entity opened for editing. `active` is the
// entity of the tab being shown, 0 for the level, SILHOUETTE_TAB for a Silhouette or GRAPH_TAB for the graph.
// Opening or showing an entity's tab also selects that entity, so the outliner and the details panel on the
// right follow whichever tab is up.
EditorTabs :: class {
public:
    static LEVEL_TAB :: 0;

    @signal entities~ Array<i64> = [];
    @signal active~ i64 = 0;
    // The Silhouettes open as documents, each in a tab of its own, in the order they were opened. `silhouette` is the
    // one being shown while `active` is SILHOUETTE_TAB, and the one that comes back when the Silhouette tabs are left
    // and shown again.
    static SILHOUETTE_TAB :: -1;
    @signal silhouettes~ Array<string> = [];
    @signal silhouette~ string = "";
    // The Graph tab: shown when `active` is GRAPH_TAB. It lists the graphs and shows the open one.
    static GRAPH_TAB :: -2;
    @signal graphTab~ bool = false;

    // Opens a tab for an entity (or shows it if it is already open) and selects the entity.
    OpenEntity~: (id: i64) -> void {
        guard id != 0 return;
        if !this.IsOpen(id) {
            next~ Array<i64> = this.entities;
            next.add(id);
            this.entities = next;
        }
        this.Show(id);
    }

    // Opens a Silhouette as a document: a new tab, or the tab it already has. Its tab is then shown.
    OpenSilhouette~: (templateId: string) -> void {
        guard templateId != "" return;
        if this.SilhouettePosition(templateId) < 0 {
            next~ Array<string> = this.silhouettes;
            next.add(templateId);
            this.silhouettes = next;
        }
        this.ShowSilhouette(templateId);
    }

    // Shows an open Silhouette's tab.
    ShowSilhouette~: (templateId: string) -> void {
        guard this.SilhouettePosition(templateId) >= 0 return;
        this.silhouette = templateId;
        editorSetPreviewTemplate(this.PreviewNameOf(templateId));
        this.active = -1;
    }

    // True when a Silhouette's tab is the one being shown.
    IsShowingSilhouette:: (templateId: string) -> bool {
        return this.active == -1 && this.silhouette == templateId;
    }

    // Closes one Silhouette's tab. When it was the Silhouette being shown, the Silhouette tab to its left takes over
    // (or the first one), and the level comes back when it was the last Silhouette open.
    CloseSilhouetteNamed~: (templateId: string) -> void {
        position := this.SilhouettePosition(templateId);
        guard position >= 0 return;
        next~ Array<string> = [];
        for open in this.silhouettes {
            if open != templateId {
                next.add(open);
            }
        }
        this.silhouettes = next;
        guard this.silhouette == templateId return;
        if next.length() == 0 {
            this.silhouette = "";
            if this.active == -1 {
                this.active = 0;
            }
            return;
        }
        replacement := position > 0 ? next[position - 1] : next[0];
        if this.active == -1 {
            this.ShowSilhouette(replacement);
        } else {
            this.silhouette = replacement;
        }
    }

    // Closes the Silhouette tab being shown.
    CloseSilhouette~: () -> void {
        this.CloseSilhouetteNamed(this.silhouette);
    }

    // Moves a Silhouette's tab over to its new name after the Silhouette was renamed, keeping its place in the row.
    RenameSilhouette~: (oldId: string, newId: string) -> void {
        next~ Array<string> = [];
        for open in this.silhouettes {
            if open == oldId {
                next.add(newId);
            } else if open != newId {
                next.add(open);
            }
        }
        this.silhouettes = next;
        if this.silhouette == oldId {
            this.silhouette = newId;
            editorSetPreviewTemplate(this.PreviewNameOf(newId));
        }
    }

    // True when a Silhouette is a material Silhouette, whose document shows its material instead of its components.
    IsMaterialSilhouette:: (templateId: string) -> bool {
        for row in editorMaterialList().split("\n") {
            if row.split("\t")[0] == templateId {
                return true;
            }
        }
        return false;
    }

    // What the document's preview draws for a Silhouette: a material Silhouette as `material:<name>`, the sphere its
    // material is drawn on, and any other Silhouette by its name.
    PreviewNameOf:: (templateId: string) -> string {
        return this.IsMaterialSilhouette(templateId) ? `material:${templateId}` : templateId;
    }

    // Where a Silhouette's tab is among the Silhouette tabs, or -1.
    SilhouettePosition:: (templateId: string) -> i32 {
        for index~ i32 = 0; index < this.silhouettes.length(); index++ {
            if this.silhouettes[index] == templateId {
                return index;
            }
        }
        return -1;
    }

    // Opens the Graph tab and shows it.
    OpenGraphTab~: () -> void {
        this.graphTab = true;
        this.active = -2;
    }

    // Closes the Graph tab, going back to the level. The open graph stays open in the editor.
    CloseGraphTab~: () -> void {
        this.graphTab = false;
        if this.active == -2 {
            this.active = 0;
        }
    }

    // Opens a tab for the selected entity.
    OpenSelected~: () -> void {
        this.OpenEntity(editorPrimarySelection());
    }

    // Shows a tab: the level, or an open entity, which becomes the selection.
    Show~: (id: i64) -> void {
        this.active = id;
        if id != 0 {
            editorSelect(id, false);
        }
    }

    // Shows the next tab to the right, wrapping around to the level.
    ShowNext~: () -> void {
        if this.active == 0 {
            if this.entities.length() > 0 {
                this.Show(this.entities[0]);
            }
            return;
        }
        position := this.PositionOf(this.active);
        if position + 1 < this.entities.length() {
            this.Show(this.entities[position + 1]);
        } else {
            this.Show(0);
        }
    }

    // Closes an entity's tab. If it was showing, the tab to its left (or the level) takes over.
    Close~: (id: i64) -> void {
        guard this.IsOpen(id) return;
        position := this.PositionOf(id);
        next~ Array<i64> = [];
        for open in this.entities {
            if open != id {
                next.add(open);
            }
        }
        this.entities = next;
        if this.active == id {
            this.active = position > 0 ? next[position - 1] : 0;
            if this.active != 0 {
                editorSelect(this.active, false);
            }
        }
    }

    // Closes the tab being shown. The level tab does not close.
    CloseActive~: () -> void {
        if this.active == -1 {
            this.CloseSilhouette();
            return;
        }
        if this.active == -2 {
            this.CloseGraphTab();
            return;
        }
        if this.active != 0 {
            this.Close(this.active);
        }
    }

    // Closes the tabs of entities that were deleted.
    DropMissing~: () -> void {
        for open in this.entities {
            if editorEntityName(open) == "" {
                this.Close(open);
            }
        }
    }

    // True when an entity has a tab.
    IsOpen:: (id: i64) -> bool {
        return this.PositionOf(id) >= 0;
    }

    // Where an entity's tab is among the entity tabs, or -1.
    PositionOf:: (id: i64) -> i32 {
        for index~ i32 = 0; index < this.entities.length(); index++ {
            if this.entities[index] == id {
                return index;
            }
        }
        return -1;
    }
}
