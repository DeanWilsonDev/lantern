EditorCommands :: import EditorCommands;
EditorDocument :: import EditorDocument;
EditorKeyboard :: import EditorKeyboard;
EditorLayout :: import EditorLayout;
EditorOverlays :: import EditorOverlays;
EditorSelection :: import EditorSelection;

Editor :: class {
public:
    document~ EditorDocument = new EditorDocument();
    overlays~ EditorOverlays = new EditorOverlays();
    layout~ EditorLayout = new EditorLayout();
    selection~ EditorSelection;
    commands~ EditorCommands;
    keyboard~ EditorKeyboard;

    Editor~: () {
        this.selection = new EditorSelection(this.overlays);
        this.commands = new EditorCommands(this.document, this.overlays, this.layout);
        this.keyboard = new EditorKeyboard(this.commands, this.overlays, this.document, this.selection);
    }

    Tick~: (deltaSeconds: f32) -> void {
        this.document.Tick(deltaSeconds);
        this.commands.PollFileDialog();
        this.selection.PollContextMenu();
    }
}
