Editor :: import Editor;

// A panel's name, its style class, and what it holds, passed in as its children.
DockablePanelProps :: data {
    panel: string;
    panelClass: string = "panel";
    children: Array<Penumbra:::Component> = [];
}

// A panel that can be moved: the grip along its top edge shows while the mouse is over the panel (`hovered`, its own
// state), and dragging the grip moves the panel to a side, under the viewport or floating, wherever it is let go
// (EditorLayout.FollowPanelDrag, PanelDocking.DropPlace). The tool palette's grip works the same way.
DockablePanel :: (props: DockablePanelProps) -> Penumbra:::Component {
    @context editor~ Editor;
    @signal hovered~ bool = false;
    return (
        <frame ref={`panel-${props.panel}`} class={props.panelClass}
               onHover={() -> { if !hovered { hovered = true; } }} onHoverEnd={() -> { hovered = false; }}>
            <frame ref={`panel-grip-${props.panel}`} class="panel-grip" onPress={() -> editor.layout.BeginPanelDrag(props.panel)}>
                <slot>
                    !{hovered
                        ? <icon class="panel-grip-icon" icon="dot-grid" size={10.0f} />
                        : <frame class="nothing" />}
                </slot>
            </frame>
            <slot>!{props.children}</slot>
        </frame>
    );
}
