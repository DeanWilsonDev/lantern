EditorApplication :: class : Application {
    Configure~: () -> void override {
        this.SetWindowTitle(editorTitle());
        this.SetWindowSize(1680, 980);
    }

    OnStart~: () -> bool override {
        this.SetTextInputActive(true);
        this.ReloadFont(this.GetDpiScaleFactor());
        return this.MountAppRoot("App.chaos", "App");
    }

    OnUpdate~: (deltaSeconds: f32) -> void override {
        this.TickChaos();
    }

    OnDpiScaleChanged~: (newDpiScaleFactor: f32) -> void override {
        this.ReloadFont(newDpiScaleFactor);
        this.MountAppRoot("App.chaos", "App");
    }

    OnShutdown~: () -> void override {
        editorSavePreferences();
        this.TeardownRootWidget();
    }
}
