// The application the window runs. It sets the window title and size, mounts the root component
// (App.chaos), keeps the Chaos tree updating every frame, and saves the preferences when the
// window closes. All the editor's behaviour lives in the services created by Editor.nyx.
TerrainUi :: import TerrainUi;

EditorApplication :: class : Application {
    // Window title and size, before the window opens.
    Configure~: () -> void override {
        this.SetWindowTitle(editorTitle());
        this.SetWindowSize(1680, 980);
    }

    // Turns text input on (for the text boxes), loads the font for the display's scale and mounts the
    // interface. Returns false if that fails, which closes the program.
    OnStart~: () -> bool override {
        TerrainUi:::Restore();
        this.SetTextInputActive(true);
        this.ReloadFont(this.GetDpiScaleFactor());
        return this.MountAppRoot("App.chaos", "App");
    }

    // Runs the interface's reactive update.
    OnUpdate~: (deltaSeconds: f32) -> void override {
        this.TickChaos();
    }

    // The window moved to a display of a different scale: loads the font again and mounts the interface
    // again so it is laid out at the new size.
    OnDpiScaleChanged~: (newDpiScaleFactor: f32) -> void override {
        this.ReloadFont(newDpiScaleFactor);
        this.MountAppRoot("App.chaos", "App");
    }

    // Saves the preferences and takes the interface down.
    OnShutdown~: () -> void override {
        editorSavePreferences();
        this.TeardownRootWidget();
    }
}
