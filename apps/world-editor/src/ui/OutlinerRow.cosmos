.outliner-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    height: 22px;
    border-radius: var(--border-radius-small);
    background-color: #00000000;
}

.outliner-row:hover {
    background-color: var(--color-row-hover);
}

.outliner-row-selected {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    height: 22px;
    border-radius: var(--border-radius-small);
    background-gradient-start: var(--color-row-selected-gradient-top);
    background-gradient-end: var(--color-row-selected);
}

.outliner-row-accent {
    width: 3px;
    height: 16px;
    border-radius: 1px;
    background-color: var(--color-accent);
}

.outliner-row-accent-off {
    width: 3px;
    height: 16px;
}

.outliner-row-indent {
    width: attr(indent);
    height: 1px;
}

.outliner-chevron {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
}

.outliner-chevron-blank {
    width: 14px;
    height: 14px;
}

.outliner-chevron-icon {
    color: var(--color-text-disabled);
}

.outliner-kind-icon {
    color: var(--color-accent-hovered);
}

.outliner-row-name {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    flex-grow: 1;
}

.outliner-row-name-hidden {
    color: var(--color-text-disabled);
    text-overflow: ellipsis;
    flex-grow: 1;
}

.outliner-row-kind {
    color: var(--color-text-disabled);
    font-size: 11px;
    max-width: 64px;
    text-overflow: ellipsis;
}

.outliner-toggle {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
}

.outliner-toggle:hover {
    background-color: var(--color-row-selected);
}

.outliner-toggle-on {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background-color: var(--color-row-selected);
}

.outliner-toggle-icon {
    color: var(--color-text-disabled);
}
