.outliner-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 20px;
    border-radius: var(--border-radius-small);
    background-color: #00000000;
}

.outliner-row:hover {
    background-color: var(--color-row-hover);
}

.outliner-row-selected {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 20px;
    border-radius: var(--border-radius-small);
    background-gradient-start: var(--color-row-selected-gradient-top);
    background-gradient-end: var(--color-row-selected);
}

.outliner-row-accent {
    width: 3px;
    height: 16px;
    border-radius: 1px;
    background-color: var(--color-accent);
}

.outliner-row-accent-off {
    width: 3px;
    height: 16px;
}

.outliner-row-indent {
    width: attr(indent);
    height: 1px;
}

.outliner-row-name {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    flex-grow: 1;
}

.outliner-row-kind {
    color: var(--color-text-disabled);
    margin: 0px var(--spacing-small) 0px 0px;
}
