AssetFileCardProps :: data {
    kind: string;
    label: string;
    selected: bool;
    onSelect: () -> void;
}

AssetFileCardUi :: namespace {
    Icon :: (kind: string) -> string {
        return when kind {
            "folder" -> "folder",
            "script" -> "terminal",
            "graph" -> "kanban",
            "texture" -> "image",
            "mesh" -> "cube",
            "sound" -> "play",
            "world" -> "grid",
            "material" -> "sun",
            default -> "document"
        };
    }
}

AssetFileCard :: (props: AssetFileCardProps) -> Penumbra:::Component {
    return (
        <frame ref={`asset-file-${props.label}`}
               class={props.selected ? "asset-card-selected" : "asset-card"}
               onPress={() -> props.onSelect()}>
            <frame class="asset-file-icon-area">
                <icon class="asset-file-icon" icon={AssetFileCardUi:::Icon(props.kind)} size={40.0f} />
            </frame>
            <frame class="asset-caption">
                <text class="asset-label">{props.label}</text>
            </frame>
            <text class="asset-kind-text">{props.kind}</text>
        </frame>
    );
}
