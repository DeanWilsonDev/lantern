.silhouette-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
}

.silhouette-header-gap {
    flex-grow: 1;
}

.silhouette-status {
    color: var(--color-text-error);
}

.silhouette-document {
    display: stack;
    flex-direction: row;
    align-items: stretch;
    gap: var(--panel-gap);
    flex-grow: 1;
}

.silhouette-hierarchy {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    width: 260px;
    padding: var(--spacing-medium);
    border-radius: var(--border-radius-panel);
    background-color: var(--color-panel-background);
}

.silhouette-inspector {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    width: 360px;
    padding: var(--spacing-medium);
    border-radius: var(--border-radius-panel);
    background-color: var(--color-panel-background);
}

.silhouette-centre {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
}

.silhouette-viewport {
    flex-grow: 1;
    border-radius: var(--border-radius-small);
}

.silhouette-panel-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    padding: 0px 0px var(--spacing-small) 0px;
}

.silhouette-panel-title {
    color: var(--color-text-primary);
}

.silhouette-add-menu {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    padding: var(--spacing-small);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    background-color: var(--color-window-background);
}

.silhouette-add-item {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
}

.silhouette-add-item:hover {
    background-color: var(--color-row-hover);
}

.silhouette-hierarchy-scroll {
    flex-grow: 1;
    align-items: stretch;
}

.silhouette-inspector-scroll {
    flex-grow: 1;
    align-items: stretch;
}

.silhouette-rows {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 1px;
}

.silhouette-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
}

.silhouette-row:hover {
    background-color: var(--color-row-hover);
}

.silhouette-row-selected {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.silhouette-row-inherited {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-window-background);
}

.silhouette-row-indent {
    color: var(--color-text-disabled);
}

.silhouette-row-icon {
    color: var(--color-accent-hovered);
}

.silhouette-row-name {
    color: var(--color-text-primary);
    flex-grow: 1;
}

.silhouette-row-note {
    color: var(--color-text-disabled);
}

.silhouette-group {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    padding: 0px 0px var(--spacing-medium) 0px;
}

.silhouette-group-title {
    color: var(--color-text-primary);
    margin: var(--spacing-small) 0px 0px 0px;
}

.silhouette-revert {
    display: stack;
    flex-direction: row;
    align-items: center;
    padding: 3px;
    border-radius: var(--border-radius-small);
}

.silhouette-revert:hover {
    background-color: var(--color-row-hover);
}


.silhouette-chips {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
}
