Editor :: import Editor;
EditorMenus :: import EditorMenus;

GraphNodeMenuProps :: data {
    x: f32;
    y: f32;
    kinds: Array<string>;
    onPick: (kind: string) -> void;
    onDismiss: () -> void;
}

GraphNodeMenuUi :: namespace {
    Filtered :: (kinds: Array<string>, filter: string) -> Array<string> {
        guard filter != "" return kinds;
        wanted := filter.toLower();
        rows~ Array<string> = [];
        for kind in kinds {
            if kind != "-" && kind.toLower().contains(wanted) {
                rows.add(kind);
            }
        }
        return rows;
    }

    Height :: (kinds: Array<string>) -> f32 {
        height~ f32 = EditorMenus:::POPUP_PADDING;
        for kind in kinds {
            height += kind == "-" ? EditorMenus:::SEPARATOR_HEIGHT : EditorMenus:::ENTRY_HEIGHT;
        }
        return height;
    }
}

GraphNodeMenu :: (props: GraphNodeMenuProps) -> Penumbra:::Component {
    @signal filter~ string = "";
    shown := GraphNodeMenuUi:::Filtered(props.kinds, filter);
    return (
        <portal ref="graph-node-menu" x={props.x} y={props.y} width={EditorMenus:::POPUP_WIDTH}
                height={GraphNodeMenuUi:::Height(shown) + EditorMenus:::ENTRY_HEIGHT} dismissOnOutsideClick={true}
                onDismiss={props.onDismiss}>
            <frame class="menu-popup">
                <frame class="search-row">
                    <icon class="search-icon" icon="search" size={12.0f} />
                    <input ref="graph-menu-search" class="search-input" text={filter}
                           preferredWidth={150.0f}
                           onTextChange={(text: string) -> { filter = text; }} />
                </frame>
                <slot>
                    !{shown.map((kind: string) ->
                        kind == "-"
                            ? <frame key="graph-menu-separator" class="menu-separator" />
                            : <frame key={`graph-menu-${kind}`} ref={`graph-menu-${kind}`} class="menu-entry"
                                     onRelease={() -> { props.onPick(kind); }}>
                                  <text class="menu-entry-label">{kind}</text>
                              </frame>)}
                </slot>
            </frame>
        </portal>
    );
}
