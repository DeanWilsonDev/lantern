Editor :: import Editor;
EditorModel :: import EditorModel;
InspectorFieldItem :: import InspectorFieldItem;

ColorFieldProps :: data {
    item: InspectorFieldItem;
}

ColorField :: (props: ColorFieldProps) -> Penumbra:::Component {
    @context editor~ Editor = new Editor();
    return (
        <frame class="color-row">
            <slot>
                !{EditorModel:::HasColor(props.item.value)
                    ? <frame class="color-swatch" red={EditorModel:::ColorChannel(props.item.value, 0)}
                             green={EditorModel:::ColorChannel(props.item.value, 1)}
                             blue={EditorModel:::ColorChannel(props.item.value, 2)} />
                    : <frame class="color-swatch-empty" />}
            </slot>
            <input ref={`input-${props.item.key}`} class="field-input" text={props.item.value} preferredWidth={96.0f}
                   onTextChange={(text: string) -> editor.document.EditField(props.item.key, text)} />
        </frame>
    );
}
