.bottom-panel {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    flex-grow: 1;
}

.asset-browser {
    display: stack;
    flex-direction: row;
    align-items: stretch;
    gap: var(--spacing-medium);
    flex-grow: 1;
}

.asset-scroll {
    flex-grow: 1;
}

.asset-cards {
    display: stack;
    flex-direction: row;
    align-items: start;
    gap: var(--spacing-medium);
    padding: 4px 2px;
}

.asset-card {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    width: 112px;
    gap: 4px;
    padding: 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.asset-card:hover {
    background-color: var(--color-row-hover);
}

.asset-card-selected {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    width: 112px;
    gap: 4px;
    padding: 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-accent);
    background-color: var(--color-row-selected);
}

.asset-thumbnail {
    height: 96px;
    border-radius: 4px;
}

.asset-caption {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.asset-kind-icon {
    color: var(--color-text-disabled);
}

.asset-label {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    font-size: 11px;
}

.asset-preview {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    width: 220px;
    gap: 4px;
}

.asset-preview-viewport {
    flex-grow: 1;
    border-radius: var(--border-radius-small);
}

.asset-preview-actions {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 26px;
}

.asset-preview-title {
    color: var(--color-text-disabled);
    flex-grow: 1;
    text-overflow: ellipsis;
}

.console {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    flex-grow: 1;
}

.history {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    flex-grow: 1;
}

.console-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-medium);
    height: 24px;
}

.console-toggles {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-medium);
}

.console-toggle {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.console-checkbox {
    accent-color: var(--color-accent);
    color: var(--color-text-primary);
    font-size: 14px;
    border-width: var(--border-width-default);
    border-color: var(--color-text-disabled);
    border-radius: 3px;
    background-color: var(--color-window-background);
}

.console-toggle-label {
    color: var(--color-text-disabled);
}

.console-scroll {
    flex-grow: 1;
}

.palette-scroll {
    flex-grow: 1;
}

.console-rows {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 1px;
}

.console-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0px 4px;
}

.console-icon-info {
    color: var(--color-text-disabled);
}

.console-icon-warning {
    color: #FFC86EFF;
}

.console-icon-error {
    color: var(--color-text-error);
}

.console-text-info {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
}

.console-text-warning {
    color: #FFC86EFF;
    text-overflow: ellipsis;
}

.console-text-error {
    color: var(--color-text-error);
    text-overflow: ellipsis;
}

.history-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0px 4px;
    border-radius: var(--border-radius-small);
}

.history-row:hover {
    background-color: var(--color-row-hover);
}

.history-row-undone {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0px 4px;
    border-radius: var(--border-radius-small);
}

.history-row-undone:hover {
    background-color: var(--color-row-hover);
}

.history-row-current {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0px 4px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.history-label {
    color: var(--color-text-primary);
}

.history-label-undone {
    color: var(--color-text-disabled);
}
