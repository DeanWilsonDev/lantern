/* The drawer under the viewport and the pages in it. The asset browser has a folder tree, a strip of cards and a
   preview; the console and the history share one list style, and each level of a console line has its own colour. */
.bottom-panel {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    flex-grow: 1;
}

.asset-browser {
    display: stack;
    flex-direction: row;
    align-items: stretch;
    gap: var(--spacing-medium);
    flex-grow: 1;
}

.asset-scroll {
    flex-grow: 1;
}

.asset-cards {
    display: stack;
    flex-direction: row;
    align-items: start;
    gap: var(--spacing-medium);
    padding: 4px 2px;
}

/* A card in the asset browser, plain and selected, with its thumbnail and caption. */
.asset-card {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    width: 112px;
    gap: 4px;
    padding: 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.asset-card:hover {
    background-color: var(--color-row-hover);
}

.asset-card-selected {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    width: 112px;
    gap: 4px;
    padding: 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-accent);
    background-color: var(--color-row-selected);
}

.asset-thumbnail {
    height: 96px;
    border-radius: 4px;
    pointer-events: none;
}

.asset-caption {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.asset-kind-icon {
    color: var(--color-text-disabled);
}

.asset-label {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    font-size: 11px;
}

.asset-preview {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    width: 220px;
    gap: 4px;
}

.asset-preview-viewport {
    flex-grow: 1;
    border-radius: var(--border-radius-small);
}

.asset-preview-actions {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 26px;
}

.asset-preview-title {
    color: var(--color-text-disabled);
    flex-grow: 1;
    text-overflow: ellipsis;
}

/* The console and history pages: a header with the filters, then rows that scroll. */
.console {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    flex-grow: 1;
}

.history {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    flex-grow: 1;
}

.console-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-medium);
    height: 24px;
}

.console-toggles {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-medium);
}

.console-toggle {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.console-checkbox {
    accent-color: var(--color-accent);
    color: var(--color-text-primary);
    font-size: 14px;
    border-width: var(--border-width-default);
    border-color: var(--color-text-disabled);
    border-radius: 3px;
    background-color: var(--color-window-background);
}

.console-toggle-label {
    color: var(--color-text-disabled);
}

.console-scroll {
    flex-grow: 1;
}

.palette-scroll {
    flex-grow: 1;
}

.console-rows {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 1px;
}

.console-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0px 4px;
}

.console-icon-info {
    color: var(--color-text-disabled);
}

.console-icon-warning {
    color: #FFC86EFF;
}

.console-icon-error {
    color: var(--color-text-error);
}

.console-text-info {
    color: var(--color-text-primary);
    text-overflow: ellipsis;
}

.console-text-warning {
    color: #FFC86EFF;
    text-overflow: ellipsis;
}

.console-text-error {
    color: var(--color-text-error);
    text-overflow: ellipsis;
}

/* A step of the undo history. The current step is highlighted and a step that has been undone is dimmed. */
.history-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0px 4px;
    border-radius: var(--border-radius-small);
}

.history-row:hover {
    background-color: var(--color-row-hover);
}

.history-row-undone {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0px 4px;
    border-radius: var(--border-radius-small);
}

.history-row-undone:hover {
    background-color: var(--color-row-hover);
}

.history-row-current {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0px 4px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.history-label {
    color: var(--color-text-primary);
}

.history-label-undone {
    color: var(--color-text-disabled);
}

/* The folder tree on the left of the asset browser, and the bar with the path and search above the cards. */
.asset-tree {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    width: 130px;
}

.tree-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: var(--border-radius-small);
}

.tree-row:hover {
    background-color: var(--color-row-hover);
}

.tree-row-selected {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.asset-main {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    flex-grow: 1;
}

.asset-bar {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
}

.asset-path {
    color: var(--color-text-disabled);
    flex-grow: 1;
    text-overflow: ellipsis;
}

.asset-file-icon-area {
    display: stack;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 96px;
}

.asset-file-icon {
    color: var(--color-text-disabled);
}

.asset-kind-text {
    color: var(--color-text-disabled);
    font-size: 10px;
}
