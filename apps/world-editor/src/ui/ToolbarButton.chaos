ToolbarButtonProps :: data {
    label: string;
    active: bool = false;
    enabled: bool = true;
    onPress: () -> void;
}

ToolbarButtonUi :: namespace {
    FrameClass :: (props: ToolbarButtonProps) -> string {
        if !props.enabled {
            return "toolbar-button-disabled";
        }
        return props.active ? "toolbar-button-active" : "toolbar-button";
    }

    LabelClass :: (props: ToolbarButtonProps) -> string {
        if !props.enabled {
            return "toolbar-button-label-disabled";
        }
        return props.active ? "toolbar-button-label-active" : "toolbar-button-label";
    }
}

ToolbarButton :: (props: ToolbarButtonProps) -> Penumbra:::Component {
    return (
        <frame class={ToolbarButtonUi:::FrameClass(props)}
               onRelease={() -> { if props.enabled { props.onPress(); } }}>
            <text class={ToolbarButtonUi:::LabelClass(props)}>{props.label}</text>
        </frame>
    );
}
