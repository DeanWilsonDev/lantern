EditorLayout :: class {
public:
    @signal bottomPanel~ string = RememberedBottomPanel();

    ShowBottomPanel~: (panel: string) -> void {
        this.bottomPanel = panel;
        editorSetPreference("ui.bottomPanel", panel);
    }

    static RememberedBottomPanel :: () -> string {
        remembered := editorPreference("ui.bottomPanel");
        return remembered == "" ? "assets" : remembered;
    }
}
