EditorModel :: import EditorModel;
EditorModes :: import EditorModes;
PanelDocking :: import PanelDocking;
PanelVisibility :: import PanelVisibility;

// Layout choices that are remembered between runs: which panels are shown, where the tool palette is (docked beside
// the viewport, or floating and where), where each panel is docked or floats, and which tab the drawer is on (assets,
// console or history). Hiding every panel (focusViewport) remembers what was shown so the same command brings it back.
// The panels are the ones PanelDocking:::Panels names, and each table below holds one entry per panel. A table is a
// value, so a change writes a new copy and the signal sees it.
EditorLayout :: class {
public:
    @signal bottomPanel~ string = RememberedBottomPanel();
    @signal shown~ Dictionary<string, bool> = RememberedShown();

    // The tool palette: docked beside the viewport, or floating at (toolsX, toolsY) in the window. While its handle is
    // dragged, toolsDragging is set and the grab point's offset from its corner is kept so it doesn't jump.
    @signal toolsFloating~ bool = editorPreference("ui.toolsFloating") == "1";
    @signal toolsX~ f32 = RememberedPosition("ui.toolsX", 160.0f);
    @signal toolsY~ f32 = RememberedPosition("ui.toolsY", 180.0f);
    // Escape closes the topmost floating thing, which can be the palette itself. It isn't a popup, so it comes
    // straight back: a new toolsShowing number gives its <portal> a new key, which shows a fresh one.
    @signal toolsShowing~ i32 = 0;
    toolsDragging~ bool = false;
    toolsGrabX~ f32 = 0.0f;
    toolsGrabY~ f32 = 0.0f;

    // Where each panel is (PanelDocking: "left", "right", "bottom" or "float") and, for a floating one, its corner.
    @signal places~ Dictionary<string, string> = RememberedPlaces();
    @signal floatXs~ Dictionary<string, f32> = RememberedCorners("X");
    @signal floatYs~ Dictionary<string, f32> = RememberedCorners("Y");
    // The panel being dragged by its grip ("" when none), where it would go if let go now, and the corner of the
    // floating preview. The grab offset keeps a floating panel from jumping under the mouse.
    @signal panelDragging~ string = "";
    @signal panelDropPlace~ string = "";
    @signal panelPreviewX~ f32 = 0.0f;
    @signal panelPreviewY~ f32 = 0.0f;
    panelGrabX~ f32 = 0.0f;
    panelGrabY~ f32 = 0.0f;
    // As toolsShowing does for the palette: Escape closes the topmost portal, so floating panels come straight back.
    @signal panelsShowing~ i32 = 0;

    focusSaved~ Dictionary<string, bool> = {};
    focused~ bool = false;

    // Shows a bottom panel on its tab and remembers the choice. Asking for the tab already showing hides the
    // drawer, so one key opens and closes it; "none" hides it.
    ShowBottomPanel~: (panel: string) -> void {
        if panel == "none" {
            this.SetDrawer(false);
            return;
        }
        if this.IsShown("drawer") && this.bottomPanel == panel {
            this.SetDrawer(false);
            return;
        }
        this.bottomPanel = panel;
        editorSetPreference("ui.bottomPanel", panel);
        this.SetDrawer(true);
    }

    // Shows the drawer on a page and remembers the choice, without the closing ShowBottomPanel does when the page is
    // already up. A mode uses it to bring up its own page.
    OpenBottomPanel~: (panel: string) -> void {
        this.bottomPanel = panel;
        editorSetPreference("ui.bottomPanel", panel);
        this.SetDrawer(true);
    }

    // The tool palette's handle was pressed: start dragging it. A docked palette comes off the dock under the mouse.
    BeginToolsDrag~: () -> void {
        if !this.toolsFloating {
            this.toolsX = penumbra:::mouseX() - 18.0f;
            this.toolsY = penumbra:::mouseY() - 8.0f;
            this.toolsFloating = true;
        }
        this.toolsGrabX = penumbra:::mouseX() - this.toolsX;
        this.toolsGrabY = penumbra:::mouseY() - this.toolsY;
        this.toolsDragging = true;
    }

    // Called once a frame. While the handle is held the palette follows the mouse, kept inside the window; when it is let
    // go near the window's left edge it docks beside the viewport, and otherwise it stays where it was dropped. Either
    // way the choice is remembered.
    FollowToolsDrag~: () -> void {
        guard this.toolsDragging return;
        if penumbra:::isMouseButtonDown() {
            this.toolsX = Clamp(penumbra:::mouseX() - this.toolsGrabX, 0.0f, penumbra:::windowWidth() - 48.0f);
            this.toolsY = Clamp(penumbra:::mouseY() - this.toolsGrabY, 0.0f, penumbra:::windowHeight() - 48.0f);
            return;
        }
        this.toolsDragging = false;
        if penumbra:::mouseX() < DOCK_ZONE {
            this.SetToolsFloating(false);
            return;
        }
        this.SetToolsFloating(true);
    }

    ReshowTools~: () -> void {
        this.toolsShowing += 1;
    }

    SetToolsFloating~: (floating: bool) -> void {
        this.toolsFloating = floating;
        editorSetPreference("ui.toolsFloating", floating ? "1" : "0");
        editorSetPreference("ui.toolsX", HexOf(i32(this.toolsX)));
        editorSetPreference("ui.toolsY", HexOf(i32(this.toolsY)));
    }

    // Where a panel is: "left", "right", "bottom" or "float".
    PlaceOf :: (panel: string) -> string {
        guard this.places.containsKey(panel) return PanelDocking:::DefaultPlace(panel);
        return this.places[panel];
    }

    // A floating panel's corner.
    FloatXOf :: (panel: string) -> f32 {
        guard this.floatXs.containsKey(panel) return PanelDocking:::DefaultFloatX(panel);
        return this.floatXs[panel];
    }

    FloatYOf :: (panel: string) -> f32 {
        guard this.floatYs.containsKey(panel) return PanelDocking:::DefaultFloatY(panel);
        return this.floatYs[panel];
    }

    // True when a panel is switched on (the Window menu, Alt+1 to 3, Shift+A and Alt+5 for the Silhouettes panel).
    IsShown :: (panel: string) -> bool {
        guard this.shown.containsKey(panel) return PanelDocking:::ShownAtFirst(panel);
        return this.shown[panel];
    }

    // The panels on screen at a place in a mode, in the order a dock stacks them.
    PanelsAt :: (place: string, mode: string) -> Array<string> {
        found~ Array<string> = [];
        for panel in PanelDocking:::Panels() {
            belongs := PanelDocking:::BelongsToMode(panel, EditorModes:::ShowsRightDock(mode));
            if this.PlaceOf(panel) == place && this.IsShown(panel) && belongs {
                found.add(panel);
            }
        }
        return found;
    }

    // A panel's grip was pressed: start dragging it. A floating panel moves with the mouse; a docked one stays put and
    // a preview shows where it would go.
    BeginPanelDrag~: (panel: string) -> void {
        if this.PlaceOf(panel) == PanelDocking:::FLOAT {
            this.panelGrabX = penumbra:::mouseX() - this.FloatXOf(panel);
            this.panelGrabY = penumbra:::mouseY() - this.FloatYOf(panel);
        } else {
            this.panelGrabX = 40.0f;
            this.panelGrabY = 6.0f;
        }
        this.panelDragging = panel;
    }

    // Called once a frame. While a grip is held, works out where the panel would go and moves a floating one with the
    // mouse; when it is let go, puts the panel there and remembers it.
    FollowPanelDrag~: () -> void {
        guard this.panelDragging != "" return;
        panel := this.panelDragging;
        width := penumbra:::windowWidth();
        height := penumbra:::windowHeight();
        place := PanelDocking:::DropPlace(penumbra:::mouseX(), penumbra:::mouseY(), width, height);
        cornerX := PanelDocking:::FloatCorner(penumbra:::mouseX(), this.panelGrabX, PanelDocking:::FloatWidth(panel), width);
        cornerY := PanelDocking:::FloatCorner(penumbra:::mouseY(), this.panelGrabY, PanelDocking:::FloatHeight(panel), height);
        if penumbra:::isMouseButtonDown() {
            if this.panelDropPlace != place {
                this.panelDropPlace = place;
            }
            if place == PanelDocking:::FLOAT && this.PlaceOf(panel) == PanelDocking:::FLOAT {
                this.MoveFloating(panel, cornerX, cornerY);
            } else if place == PanelDocking:::FLOAT {
                this.panelPreviewX = cornerX;
                this.panelPreviewY = cornerY;
            }
            return;
        }
        this.panelDragging = "";
        this.panelDropPlace = "";
        if place == PanelDocking:::FLOAT {
            this.MoveFloating(panel, cornerX, cornerY);
            this.RememberCorner(panel);
        }
        this.SetPlace(panel, place);
    }

    // Puts a panel at a place and remembers it.
    SetPlace~: (panel: string, place: string) -> void {
        next~ Dictionary<string, string> = this.places;
        next[panel] = place;
        this.places = next;
        editorSetPreference(`ui.${panel}Place`, place);
    }

    MoveFloating~: (panel: string, x: f32, y: f32) -> void {
        nextX~ Dictionary<string, f32> = this.floatXs;
        nextX[panel] = x;
        this.floatXs = nextX;
        nextY~ Dictionary<string, f32> = this.floatYs;
        nextY[panel] = y;
        this.floatYs = nextY;
    }

    // Saves a floating panel's corner, so it comes back there next time.
    RememberCorner~: (panel: string) -> void {
        editorSetPreference(`ui.${panel}X`, HexOf(i32(this.FloatXOf(panel))));
        editorSetPreference(`ui.${panel}Y`, HexOf(i32(this.FloatYOf(panel))));
    }

    ReshowPanels~: () -> void {
        this.panelsShowing += 1;
    }

    // Shows or hides a panel by name (one of PanelDocking:::Panels).
    TogglePanel~: (panel: string) -> void {
        this.focused = false;
        this.SetShown(panel, !this.IsShown(panel));
    }

    // Hides every panel for a clean viewport, or brings back the ones that were shown.
    ToggleFocus~: () -> void {
        if this.focused {
            this.focused = false;
            for panel in PanelDocking:::Panels() {
                if this.focusSaved.containsKey(panel) {
                    this.SetShown(panel, this.focusSaved[panel]);
                }
            }
            return;
        }
        saved~ Dictionary<string, bool> = {};
        for panel in PanelDocking:::Panels() {
            saved[panel] = this.IsShown(panel);
            this.SetShown(panel, false);
        }
        this.focusSaved = saved;
        this.focused = true;
    }

    // What is shown, as one value for the menus.
    Visibility :: () -> PanelVisibility {
        return PanelVisibility {
            outliner: this.IsShown("outliner"),
            details: this.IsShown("details"),
            drawer: this.IsShown("drawer"),
            silhouettes: this.IsShown("silhouettes"),
            preview: this.IsShown("preview"),
            bottomPanel: this.bottomPanel
        };
    }

    // Shows or hides a panel and remembers it.
    SetShown~: (panel: string, isShown: bool) -> void {
        next~ Dictionary<string, bool> = this.shown;
        next[panel] = isShown;
        this.shown = next;
        editorSetPreference(`ui.${panel}`, isShown ? "1" : "0");
    }

    SetDrawer~: (isShown: bool) -> void {
        this.SetShown("drawer", isShown);
    }

    // How close to the window's left edge, in pixels, a dropped palette docks.
    static DOCK_ZONE :: 70.0f;

    // A number kept between 0 and an upper end.
    static Clamp :: (value: f32, lowest: f32, highest: f32) -> f32 {
        guard value >= lowest return lowest;
        guard value <= highest return highest;
        return value;
    }

    // A whole number from 0 to 65535 as four hexadecimal digits, the way a position is saved in the preferences (they
    // hold text, and Nyx has no text-to-number conversion, so EditorModel's hex reader brings it back).
    static HexOf :: (value: i32) -> string {
        digits := "0123456789abcdef";
        kept := value < 0 ? 0 : (value > 65535 ? 65535 : value);
        text~ string = "";
        remaining~ i32 = kept;
        for place~ i32 = 0; place < 4; place++ {
            text = digits.substring(remaining % 16, 1) + text;
            remaining = remaining / 16;
        }
        return text;
    }

    // A position saved by HexOf, or a fallback the first time.
    static RememberedPosition :: (name: string, fallback: f32) -> f32 {
        saved := editorPreference(name);
        guard saved.length() == 4 return fallback;
        value~ i32 = 0;
        for place~ i32 = 0; place < 4; place++ {
            value = value * 16 + EditorModel:::HexDigit(saved, place);
        }
        return f32(value);
    }

    // Each panel's saved place, or where it starts the first time.
    static RememberedPlaces :: () -> Dictionary<string, string> {
        places~ Dictionary<string, string> = {};
        for panel in PanelDocking:::Panels() {
            saved := editorPreference(`ui.${panel}Place`);
            places[panel] = PanelDocking:::IsPlace(saved) ? saved : PanelDocking:::DefaultPlace(panel);
        }
        return places;
    }

    // Each panel's saved floating corner along one axis ("X" or "Y"), or where it starts the first time.
    static RememberedCorners :: (axis: string) -> Dictionary<string, f32> {
        corners~ Dictionary<string, f32> = {};
        for panel in PanelDocking:::Panels() {
            fallback := axis == "X" ? PanelDocking:::DefaultFloatX(panel) : PanelDocking:::DefaultFloatY(panel);
            corners[panel] = RememberedPosition(`ui.${panel}${axis}`, fallback);
        }
        return corners;
    }

    // Whether each panel was shown last time, or whether it starts shown.
    static RememberedShown :: () -> Dictionary<string, bool> {
        shown~ Dictionary<string, bool> = {};
        for panel in PanelDocking:::Panels() {
            saved := editorPreference(`ui.${panel}`);
            shown[panel] = saved == "" ? PanelDocking:::ShownAtFirst(panel) : saved != "0";
        }
        return shown;
    }

    // The panel saved last time, or "assets" the first time.
    static RememberedBottomPanel :: () -> string {
        remembered := editorPreference("ui.bottomPanel");
        return remembered == "" ? "assets" : remembered;
    }

}
