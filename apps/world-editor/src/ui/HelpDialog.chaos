Editor :: import Editor;

HelpDialogUi :: namespace {
    WIDTH: f32 : 620.0f;
    HEIGHT: f32 : 420.0f;

    X :: () -> f32 {
        return (penumbra:::windowWidth() - WIDTH) * 0.5f;
    }

    Y :: () -> f32 {
        return (penumbra:::windowHeight() - HEIGHT) * 0.4f;
    }

    Title :: (page: string) -> string {
        return when page {
            "controls" -> "Viewport controls",
            "shortcuts" -> "Keyboard shortcuts",
            default -> "Lantern World Editor"
        };
    }

    ShortcutsHelp :: () -> Array<string> {
        return [
            "W / E / R  Move, rotate, scale tool",
            "F / Home  Frame selection / frame all",
            "X / Z  Toggle local space / pivot at center",
            "G / H / Shift+H  Toggle grid / hide selection / unhide all",
            "End  Snap selection to ground",
            "Delete, Escape  Delete selection, deselect or cancel a drag",
            "Ctrl+Z / Ctrl+Shift+Z  Undo / redo",
            "Ctrl+D / Ctrl+G / Ctrl+A / Ctrl+I  Duplicate / group / select all / invert",
            "Ctrl+S / Ctrl+Shift+S / Ctrl+O / Ctrl+N  Save / save as / open / new",
            "Ctrl+P  Play or stop the level",
            "Ctrl+1..9 / 1..9  Set / go to a camera bookmark",
            "Ctrl+Shift+P  Command palette",
            "Shift+click or Ctrl+click in the outliner adds to the selection"
        ];
    }

    Lines :: (page: string) -> Array<string> {
        return when page {
            "controls" -> [
                "Right-drag orbits the camera around its target.",
                "Shift+right-drag or middle-drag pans.",
                "The wheel zooms. Hold the right button and use W A S D Q E to fly.",
                "Left-click picks an entity; drag a gizmo handle to move, rotate or scale.",
                "Left-drag on empty space box-selects. Shift adds to the selection.",
                "Drag an asset card from the Assets panel into the viewport to place it under the cursor.",
                "Top, front and side presets are orthographic; Perspective goes back to the free camera."
            ],
            "shortcuts" -> HelpDialogUi:::ShortcutsHelp(),
            default -> [
                "Lantern's level editor: Penumbra, Chaos, Cosmos and Nyx in front, Rust behind.",
                "The editing logic and the 3D view live in crates/editor-core and crates/editor-backend.",
                "Every change is undoable; the History tab shows the whole stack.",
                "Play runs the game on the level as it is now, saved to a scratch file beside the worlds."
            ]
        };
    }
}

HelpDialog :: () -> Penumbra:::Component {
    @context editor~ Editor = new Editor();
    return (
        <portal ref="help-dialog" x={HelpDialogUi:::X()} y={HelpDialogUi:::Y()} width={HelpDialogUi:::WIDTH}
                height={HelpDialogUi:::HEIGHT} dismissOnOutsideClick={true}
                onDismiss={() -> editor.overlays.CloseAll()}>
            <frame class="dialog">
                <frame class="dialog-title-row">
                    <icon class="dialog-icon" icon="info" size={16.0f} />
                    <text class="dialog-title">{HelpDialogUi:::Title(editor.overlays.helpPage)}</text>
                    <frame class="toolbar-spacer" />
                    <frame class="icon-button" onRelease={() -> editor.overlays.CloseAll()}>
                        <icon class="icon-button-glyph" icon="close" size={14.0f} />
                    </frame>
                </frame>
                <scroll ref="help-scroll" class="palette-scroll" wheelStep={60.0f}>
                    <frame class="help-lines">
                        <slot>
                            !{HelpDialogUi:::Lines(editor.overlays.helpPage).map((line: string) ->
                                <text key={line} class="dialog-body">{line}</text>)}
                        </slot>
                    </frame>
                </scroll>
            </frame>
        </portal>
    );
}
