ChoiceRow :: import ChoiceRow;
EditorUi :: import EditorUi;
SettingsUi :: import SettingsUi;

SnappingSettings :: () -> Penumbra:::Component {
    state := EditorUi:::App().Toolbar();
    return (
        <frame class="settings-page">
            <text class="settings-heading">Snapping</text>
            <frame class="setting-row">
                <checkbox class="field-checkbox" checked={state.snap}
                          onToggle={(checked: bool) -> EditorUi:::App().SetSnap(checked)} />
                <text class="setting-label">Snap while dragging gizmo handles</text>
            </frame>
            <ChoiceRow label="Move step (units)" options={SettingsUi:::TranslateSteps()}
                       selected={EditorUi:::App().SnapStepChoice("translate")}
                       onSelect={(choice: string) -> EditorUi:::App().SetSnapStepChoice("translate", choice)} />
            <ChoiceRow label="Rotate step (degrees)" options={SettingsUi:::RotateSteps()}
                       selected={EditorUi:::App().SnapStepChoice("rotate")}
                       onSelect={(choice: string) -> EditorUi:::App().SetSnapStepChoice("rotate", choice)} />
            <ChoiceRow label="Scale step" options={SettingsUi:::ScaleSteps()}
                       selected={EditorUi:::App().SnapStepChoice("scale")}
                       onSelect={(choice: string) -> EditorUi:::App().SetSnapStepChoice("scale", choice)} />
        </frame>
    );
}
