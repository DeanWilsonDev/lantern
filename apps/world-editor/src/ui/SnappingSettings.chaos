ChoiceRow :: import ChoiceRow;
Editor :: import Editor;
SettingsUi :: import SettingsUi;

// The Snapping tab: the master switch for snapping while a gizmo handle is dragged, and the step each tool snaps to:
// move
// in units, rotate in degrees, scale as a factor.
SnappingSettings :: () -> Penumbra:::Component {
    @context editor~ Editor;
    state := editor.document.toolbar;
    return (
        <frame class="settings-page">
            <text class="settings-heading">Snapping</text>
            <frame class="setting-row">
                <checkbox class="field-checkbox" checked={state.snap}
                          onToggle={(checked: bool) -> editorSetSnap(checked)} />
                <text class="setting-label">Snap while dragging gizmo handles</text>
            </frame>
            <frame class="setting-row">
                <checkbox class="field-checkbox" checked={state.socketSnap}
                          onToggle={(checked: bool) -> editorSetSocketSnap(checked)} />
                <text class="setting-label">Snap a dragged scene to the sockets of nearby scenes</text>
            </frame>
            <ChoiceRow label="Move step (units)" options={SettingsUi:::TranslateSteps()}
                       selected={SettingsUi:::SnapStepChoice("translate")}
                       onSelect={(choice: string) -> SettingsUi:::SetSnapStepChoice("translate", choice)} />
            <ChoiceRow label="Rotate step (degrees)" options={SettingsUi:::RotateSteps()}
                       selected={SettingsUi:::SnapStepChoice("rotate")}
                       onSelect={(choice: string) -> SettingsUi:::SetSnapStepChoice("rotate", choice)} />
            <ChoiceRow label="Scale step" options={SettingsUi:::ScaleSteps()}
                       selected={SettingsUi:::SnapStepChoice("scale")}
                       onSelect={(choice: string) -> SettingsUi:::SetSnapStepChoice("scale", choice)} />
        </frame>
    );
}
