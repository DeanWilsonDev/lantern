EditorCommands :: import EditorCommands;
EditorDocument :: import EditorDocument;
EditorModes :: import EditorModes;
EditorOverlays :: import EditorOverlays;
EditorSelection :: import EditorSelection;

// Turns key presses into commands. Keys with the shortcut modifier (Ctrl, or Cmd on a Mac) run menu
// commands; Shift and the shortcut key are tracked so a click can add to the selection; Escape closes
// things in order; every other key goes to the editor's own key handling (tools, camera, deleting)
// unless a dialog is open.
EditorKeyboard :: class {
public:
    // The bit for each modifier in the number the editor takes.
    static SHIFT_BIT :: 1;
    static SHORTCUT_BIT :: 2;
    static ALT_BIT :: 4;

    commands~ EditorCommands;
    overlays~ EditorOverlays;
    document~ EditorDocument;
    selection~ EditorSelection;
    shiftHeld~ bool = false;
    shortcutHeld~ bool = false;

    EditorKeyboard~: (commands~ EditorCommands, overlays~ EditorOverlays, document~ EditorDocument,
                      selection~ EditorSelection) {
        this.commands = commands;
        this.overlays = overlays;
        this.document = document;
        this.selection = selection;
    }

    // A key went down. The key name arrives with its modifiers, such as "Shortcut+Shift+s".
    KeyDown~: (key: string) -> void {
        when key {
            "Shift" -> this.SetShift(true),
            ("Control" || "Meta") -> this.SetShortcut(true),
            "Escape" -> this.Escape(),
            "F2" -> this.commands.RunCommand("rename"),
            "F4" -> this.commands.RunCommand("editInTab"),
            "Shortcut+w" -> this.commands.RunCommand("closeTab"),
            "Shortcut+Tab" -> this.commands.RunCommand("nextTab"),
            "F11" -> this.commands.RunCommand("focusViewport"),
            "Alt+1" -> this.commands.RunCommand("togglePanel:outliner"),
            "Alt+2" -> this.commands.RunCommand("togglePanel:details"),
            "Alt+3" -> this.commands.RunCommand("togglePanel:drawer"),
            "Alt+c" -> this.commands.RunCommand("viewportMenu:camera"),
            "Alt+v" -> this.commands.RunCommand("viewportMenu:show"),
            "Alt+4" -> this.commands.RunCommand("panel:history"),
            "Alt+5" -> this.commands.RunCommand("panel:silhouettes"),
            "Alt+6" -> this.commands.RunCommand("panel:terrain"),
            ("Shortcut+ " || "Control+ ") -> this.commands.RunCommand("panel:assets"),
            "`" -> this.commands.RunCommand("panel:console"),
            "[" -> this.commands.RunCommand("terrain:radius:down"),
            "]" -> this.commands.RunCommand("terrain:radius:up"),
            "Shortcut+n" -> this.commands.RunCommand("new"),
            "Shortcut+o" -> this.commands.RunCommand("open"),
            "Shortcut+s" -> this.commands.RunCommand("save"),
            "Shortcut+Shift+s" -> this.commands.RunCommand("saveAs"),
            "Shortcut+q" -> this.commands.RunCommand("quit"),
            "Shortcut+p" -> this.commands.RunCommand(this.document.toolbar.playing ? "stop" : "play"),
            "Shortcut+Shift+p" -> this.commands.RunCommand("commandPalette"),
            "Shortcut+," -> this.commands.RunCommand("settings"),
            "Shortcut+l" -> this.commands.RunCommand("lock"),
            "Shortcut+Shift+l" -> this.commands.RunCommand("unlock"),
            "Shortcut+i" -> this.commands.RunCommand("invertSelection"),
            ("Shift+1" || "Shift+2") -> this.EnterModeKey(key),
            "Shift+a" -> this.AddKey(),
            default -> this.Forward(key, true)
        }
    }

    // Shift and a digit enters the mode in that place on the switcher, unless a dialog has the keyboard.
    EnterModeKey~: (key: string) -> void {
        guard !this.overlays.BlocksViewportKeys() return;
        this.commands.RunCommand(`mode:${EditorModes:::ForDigit(key.substring(6, 1))}`);
    }

    // Shift+A pops the Silhouettes panel out at the mouse in Select mode, as Blender's Add menu opens, or puts it away.
    AddKey~: () -> void {
        guard !this.overlays.BlocksViewportKeys() return;
        guard this.commands.modes.Current() == EditorModes:::SELECT return;
        this.commands.RunCommand("silhouettes");
    }

    // A key went up. Only the modifiers matter, plus any key the editor tracks being held (the fly keys).
    KeyUp~: (key: string) -> void {
        when key {
            "Shift" -> this.SetShift(false),
            ("Control" || "Meta") -> this.SetShortcut(false),
            default -> this.Forward(key, false)
        }
    }

    // Escape closes a popup, dialog or settings if one is open; otherwise it leaves Terrain mode for Select mode
    // (keeping the terrain selected, so its tools stay in the palette), and otherwise it goes to the editor, which
    // cancels a drag or clears the selection.
    Escape~: () -> void {
        guard !this.overlays.Escape() return;
        if this.commands.modes.Current() == EditorModes:::TERRAIN {
            this.commands.RunCommand(`mode:${EditorModes:::SELECT}`);
            return;
        }
        editorKey("Escape", true, 0);
    }

    // Tracks Shift. Shift or the shortcut key makes a click add to the selection.
    SetShift~: (held: bool) -> void {
        this.shiftHeld = held;
        this.selection.additive = this.shiftHeld || this.shortcutHeld;
    }

    // Tracks the shortcut key.
    SetShortcut~: (held: bool) -> void {
        this.shortcutHeld = held;
        this.selection.additive = this.shiftHeld || this.shortcutHeld;
    }

    // Sends a key to the editor with its modifiers packed in a number, unless a dialog is open that should
    // have the keyboard.
    Forward~: (qualified: string, down: bool) -> void {
        guard !this.overlays.BlocksViewportKeys() return;
        modifierBits~ i32 = 0;
        name~ string = qualified;
        if name.startsWith("Shortcut+") {
            modifierBits += SHORTCUT_BIT;
            name = name.substring(9, name.length() - 9);
        }
        if name.startsWith("Alt+") {
            modifierBits += ALT_BIT;
            name = name.substring(4, name.length() - 4);
        }
        if name.startsWith("Shift+") {
            modifierBits += SHIFT_BIT;
            name = name.substring(6, name.length() - 6);
        }
        guard name != "" return;
        editorKey(name, down, modifierBits);
    }
}
