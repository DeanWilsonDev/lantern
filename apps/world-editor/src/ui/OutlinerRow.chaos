Editor :: import Editor;
EditorModel :: import EditorModel;
OutlineRowItem :: import OutlineRowItem;
OutlinerState :: import OutlinerState;

OutlinerRowUi :: namespace {
    INDENT_PER_DEPTH: f32 : 14.0f;

    Indent :: (item: OutlineRowItem) -> f32 {
        return f32(item.depth) * INDENT_PER_DEPTH;
    }

    RowClass :: (item: OutlineRowItem, outliner: OutlinerState) -> string {
        if outliner.dropTarget == RowTarget(item) {
            return "outliner-row-drop";
        }
        return item.selected ? "outliner-row-selected" : "outliner-row";
    }

    RowTarget :: (item: OutlineRowItem) -> string {
        return `row:${item.id}`;
    }

    GapTarget :: (item: OutlineRowItem) -> string {
        return `gap:${item.id}`;
    }

    GapLineClass :: (item: OutlineRowItem, outliner: OutlinerState) -> string {
        return outliner.dropTarget == GapTarget(item) ? "outliner-gap-line-active" : "outliner-gap-line";
    }

    NameClass :: (item: OutlineRowItem) -> string {
        return item.hidden ? "outliner-row-name-hidden" : "outliner-row-name";
    }

    ChevronIcon :: (item: OutlineRowItem) -> string {
        return item.expanded ? "chevron-down" : "chevron-right";
    }
}

OutlinerRowProps :: data {
    item: OutlineRowItem;
}

OutlinerRow :: (props: OutlinerRowProps) -> Penumbra:::Component {
    @context editor~ Editor = new Editor();
    @context outliner~ OutlinerState = new OutlinerState();
    return (
        <frame ref={`outline-${props.item.key}`} class={OutlinerRowUi:::RowClass(props.item, outliner)}
               dragPayload={`entity:${props.item.id}`}
               onRelease={() -> editor.selection.Select(props.item.id)}
               onHover={() -> editor.selection.Hover(props.item.id)}
               onHoverEnd={() -> editor.selection.Unhover(props.item.id)}
               onDragStart={() -> outliner.BeginDrag()}
               onDragEnd={() -> outliner.EndDrag()}
               onDragEnter={() -> outliner.EnterDropTarget(OutlinerRowUi:::RowTarget(props.item))}
               onDragLeave={() -> outliner.LeaveDropTarget(OutlinerRowUi:::RowTarget(props.item))}
               onDrop={(payload: string) -> outliner.DropOnEntity(payload, props.item.id)}>
            <slot>
                !{outliner.dragging
                    ? <frame class="outliner-gap"
                             onDragEnter={() -> outliner.EnterDropTarget(OutlinerRowUi:::GapTarget(props.item))}
                             onDragLeave={() -> outliner.LeaveDropTarget(OutlinerRowUi:::GapTarget(props.item))}
                             onDrop={(payload: string) -> outliner.DropBeforeEntity(payload, props.item.id)}>
                          <frame class={OutlinerRowUi:::GapLineClass(props.item, outliner)} />
                      </frame>
                    : null}
            </slot>
            <frame class={props.item.selected ? "outliner-row-accent" : "outliner-row-accent-off"} />
            <frame class="outliner-row-indent" indent={OutlinerRowUi:::Indent(props.item)} />
            <slot>
                !{props.item.hasChildren
                    ? <frame class="outliner-chevron" onRelease={() -> outliner.ToggleExpanded(props.item.id)}>
                          <icon class="outliner-chevron-icon" icon={OutlinerRowUi:::ChevronIcon(props.item)} size={10.0f} />
                      </frame>
                    : <frame class="outliner-chevron-blank" />}
            </slot>
            <icon class="outliner-kind-icon" icon={EditorModel:::KindIcon(props.item.kind)} size={12.0f} />
            <text class={OutlinerRowUi:::NameClass(props.item)}>{props.item.name}</text>
            <text class="outliner-row-kind">{props.item.kind}</text>
            <frame class={props.item.hidden ? "outliner-toggle-on" : "outliner-toggle"}
                   onRelease={() -> editorSetHidden(props.item.id, !props.item.hidden)}>
                <icon class="outliner-toggle-icon" icon={props.item.hidden ? "eye-off" : "eye"} size={12.0f} />
            </frame>
            <frame class={props.item.locked ? "outliner-toggle-on" : "outliner-toggle"}
                   onRelease={() -> editorSetLocked(props.item.id, !props.item.locked)}>
                <icon class="outliner-toggle-icon" icon={props.item.locked ? "lock" : "unlock"} size={12.0f} />
            </frame>
        </frame>
    );
}
