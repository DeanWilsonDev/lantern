LogItem :: import LogItem;

ConsoleFilters :: class {
public:
    @signal info~ bool = true;
    @signal warnings~ bool = true;
    @signal errors~ bool = true;

    SetLevel~: (level: string, shown: bool) -> void {
        when level {
            "info" -> { this.info = shown; },
            "warning" -> { this.warnings = shown; },
            "error" -> { this.errors = shown; },
            default -> {}
        }
    }

    Shown:: (items: Array<LogItem>) -> Array<LogItem> {
        shown~ Array<LogItem> = [];
        for item in items {
            visible := when item.level {
                "info" -> this.info,
                "warning" -> this.warnings,
                "error" -> this.errors,
                (other) -> true
            };
            if visible {
                shown.add(item);
            }
        }
        return shown;
    }
}
