// What the Add menu offers and how it is sorted. The Add menu places something on the level: it has a column of
// categories (Shapes, Lights and so on) and a column of the things in the category under the mouse, like the Place
// panel of other editors. The things come from the game's palette (palette.json and the project's Silhouettes); each
// goes in a category by its kind, so the menu needs no list of its own. A Silhouette of a kind none of the categories
// names (a gem), or made of several parts (a lamp post), goes under Silhouettes, and a plain palette entry of such a
// kind under Other.
//
// Like editor-modes.nyx, these are plain functions with no calls into the editor, so they can be tested on their own.
// AddMenu.chaos draws the menu.
AddMenuItems :: namespace {
    // The menu's size: the two columns' widths, a row's height and the padding around the rows.
    CATEGORY_WIDTH: f32 : 150.0f;
    ITEM_WIDTH: f32 : 230.0f;
    ROW_HEIGHT: f32 : 24.0f;
    PADDING: f32 : 12.0f;

    // The categories, top to bottom.
    Categories :: () -> Array<string> {
        return ["Shapes", "Lights", "Cameras", "Gameplay", "Terrain", "Silhouettes", "Other"];
    }

    // The icon beside a category.
    Icon :: (category: string) -> string {
        return when category {
            "Shapes" -> "platform",
            "Lights" -> "light",
            "Cameras" -> "camera",
            "Gameplay" -> "flag",
            "Terrain" -> "chart-line",
            "Silhouettes" -> "layers",
            default -> "cube"
        };
    }

    // The category a palette template goes in, by its kind, whether it was made from a Silhouette and how many components
    // it has. A Silhouette of more than one component (a lamp post with its light) is a prop made of parts, not a basic
    // shape or a lone light, so it goes under Silhouettes whatever its root's kind.
    CategoryOf :: (kind: string, fromSilhouette: bool, components: i32) -> string {
        guard components <= 1 return "Silhouettes";
        return when kind {
            ("block" || "ramp" || "moving_platform") -> "Shapes",
            ("point_light" || "spot_light" || "sun") -> "Lights",
            ("camera_volume" || "camera_shot") -> "Cameras",
            ("player_start" || "spawn" || "kill_plane") -> "Gameplay",
            "terrain" -> "Terrain",
            default -> fromSilhouette ? "Silhouettes" : "Other"
        };
    }

    // The command that places a template from the palette.
    PlaceCommand :: (templateId: string) -> string {
        return `add:${templateId}`;
    }

    // The template a place command names, or "" for any other command.
    PlacedTemplate :: (command: string) -> string {
        guard command.startsWith("add:") return "";
        return command.substring(4, command.length() - 4);
    }

    // The menu's height for a number of rows in its taller column.
    Height :: (rows: i32) -> f32 {
        return PADDING + ROW_HEIGHT * f32(rows);
    }
}
