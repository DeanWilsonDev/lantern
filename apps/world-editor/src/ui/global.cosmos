/* The editor's design tokens, shared by every other stylesheet in this folder. A rule uses one with var(--name). The
   palette is a dark grey with one blue accent; the last digits of a colour are its opacity. Changing a value here
   re-themes the whole editor, which is why the other files hold almost no colours of their own. The --z values are
   the stacking order of the floating layers: menus above panels, tooltips above menus. */
:root {
    --color-window-background: #141414FF;
    --color-panel-background: #242424FF;
    --color-panel-border: #0E0E0EFF;
    --color-row-hover: #303030FF;
    --color-row-selected: #26405FFF;
    --color-row-selected-gradient-top: #2F5282FF;
    --color-accent: #0F7BDCFF;
    --color-accent-hovered: #2D93F0FF;
    --color-accent-pressed: #0A63B4FF;
    --color-accent-label: #FFFFFFFF;
    --color-accent-gradient-top: #2D93F0FF;
    --color-text-primary: #D2D2D2FF;
    --color-text-disabled: #7C7C7CFF;
    --color-text-error: #FF6E6EFF;
    --color-text-good: #68E098FF;
    --color-shadow: #00000078;
    --shadow-blur-radius: 12px;
    --color-treemap-leaf-border: #FFFFFF64;
    --color-treemap-hover: #FFFFFFB4;
    --border-width-default: 1px;
    --border-radius-small: 3px;
    --border-radius-pill: 4px;
    --border-radius-panel: 3px;
    --spacing-small: 5px;
    --spacing-medium: 10px;
    --spacing-large: 16px;
    --panel-padding-vertical: 12px;
    --panel-padding-horizontal: 16px;
    --panel-gap: 4px;
    --z-menu-backdrop: 90;
    --z-menu: 100;
    --z-tooltip: 110;
}
