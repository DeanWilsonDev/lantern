:root {
    --color-window-background: #0B0B0EFF;
    --color-panel-background: #111115FF;
    --color-panel-border: #22222BFF;
    --color-row-hover: #1C1C24FF;
    --color-row-selected: #1C2A4EFF;
    --color-row-selected-gradient-top: #283C6AFF;
    --color-accent: #4A90FFFF;
    --color-accent-hovered: #68A8FFFF;
    --color-accent-pressed: #3676E0FF;
    --color-accent-label: #0E1420FF;
    --color-accent-gradient-top: #90C4FFFF;
    --color-text-primary: #EEEEF3FF;
    --color-text-disabled: #6C6C7AFF;
    --color-text-error: #FF6E6EFF;
    --color-text-good: #68E098FF;
    --color-shadow: #00000078;
    --shadow-blur-radius: 12px;
    --color-treemap-leaf-border: #FFFFFF64;
    --color-treemap-hover: #FFFFFFB4;
    --border-width-default: 1px;
    --border-radius-small: 6px;
    --border-radius-pill: 9px;
    --border-radius-panel: 10px;
    --spacing-small: 5px;
    --spacing-medium: 10px;
    --spacing-large: 16px;
    --panel-padding-vertical: 12px;
    --panel-padding-horizontal: 16px;
    --panel-gap: 8px;
    --z-menu-backdrop: 90;
    --z-menu: 100;
    --z-tooltip: 110;
}
