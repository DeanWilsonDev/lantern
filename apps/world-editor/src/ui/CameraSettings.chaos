BookmarkRow :: import BookmarkRow;
ChoiceRow :: import ChoiceRow;
Editor :: import Editor;
SettingsUi :: import SettingsUi;

CameraSettings :: () -> Penumbra:::Component {
    @context editor~ Editor;
    state := editor.document.toolbar;
    return (
        <frame class="settings-page">
            <text class="settings-heading">Camera</text>
            <frame class="setting-row">
                <checkbox class="field-checkbox" checked={state.orthographic}
                          onToggle={(checked: bool) -> editorSetOrthographic(checked)} />
                <text class="setting-label">Orthographic projection</text>
            </frame>
            <ChoiceRow label="Look from" options={SettingsUi:::Presets()}
                       selected={state.orthographic ? "orthographic" : "perspective"}
                       onSelect={(choice: string) -> editorCameraPreset(choice)} />
            <text class="settings-heading">Bookmarks (Ctrl+1..9 sets, 1..9 goes)</text>
            <scroll ref="bookmark-scroll" class="settings-scroll" wheelStep={40.0f}>
                <frame class="settings-page">
                    <slot>
                        !{SettingsUi:::Bookmarks().map((slot: string) -> <BookmarkRow key={slot} slot={slot} />)}
                    </slot>
                </frame>
            </scroll>
        </frame>
    );
}
