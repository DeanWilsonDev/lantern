
// A row's label, the name of the viewport option it sets, and whether the option is on.
SettingRowProps :: data {
    label: string;
    option: string;
    checked: bool;
}

// A checkbox row in the viewport's Show menu or the settings: ticking it sets the named viewport option on or off.
ViewOptionRow :: (props: SettingRowProps) -> Penumbra:::Component {
    return (
        <frame class="setting-row">
            <checkbox class="field-checkbox" checked={props.checked}
                      onToggle={(checked: bool) -> { editorSetViewOption(props.option, checked ? "true" : "false"); }} />
            <text class="setting-label">{props.label}</text>
        </frame>
    );
}
