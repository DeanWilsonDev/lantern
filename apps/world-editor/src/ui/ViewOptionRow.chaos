EditorUi :: import EditorUi;

SettingRowProps :: data {
    label: string;
    option: string;
    checked: bool;
}

ViewOptionRow :: (props: SettingRowProps) -> Penumbra:::Component {
    return (
        <frame class="setting-row">
            <checkbox class="field-checkbox" checked={props.checked}
                      onToggle={(checked: bool) -> EditorUi:::App().SetViewOption(props.option, checked)} />
            <text class="setting-label">{props.label}</text>
        </frame>
    );
}
