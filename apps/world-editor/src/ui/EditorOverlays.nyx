SilhouetteCategories :: import SilhouetteCategories;

// The menus and dialogs that float over the interface: which menu is open and where, the right click
// menu, the command palette, the settings, the help page and the "save first?" question. They are signals,
// so App.chaos shows each when its value is set.
EditorOverlays :: class {
public:
    // How far left of the mouse a menu opens, so it sits under the menu bar button.
    static MENU_OFFSET :: 16.0f;

    // How far below the mouse a viewport header menu opens, so it starts under the header button.
    static VIEWPORT_MENU_DROP :: 10.0f;

    @signal openMenu~ string = "";
    @signal menuX~ f32 = 0.0f;
    @signal viewportMenu~ string = "";
    @signal viewportMenuX~ f32 = 0.0f;
    @signal viewportMenuY~ f32 = 0.0f;
    @signal contextOpen~ bool = false;
    @signal contextX~ f32 = 0.0f;
    @signal contextY~ f32 = 0.0f;
    @signal contextEntity~ i64 = 0;
    @signal paletteOpen~ bool = false;
    @signal settingsOpen~ bool = false;
    @signal helpPage~ string = "";
    @signal confirmCommand~ string = "";
    @signal projectDialog~ string = "";
    @signal projectParent~ string = "";
    // The category the Silhouettes panel shows, kept here so the panel comes back on it.
    @signal silhouettesCategory~ string = SilhouetteCategories:::ALL;

    // Opens a menu from the menu bar, or closes it if it was open.
    ToggleMenu~: (name: string) -> void {
        this.CloseAll();
        if this.openMenu == name {
            this.openMenu = "";
            return;
        }
        this.openMenu = name;
        this.menuX = penumbra:::mouseX() - MENU_OFFSET;
    }

    // While one menu is open, moving over another menu bar button opens that one.
    HoverMenu~: (name: string) -> void {
        if this.openMenu != "" && this.openMenu != name {
            this.openMenu = name;
            this.menuX = penumbra:::mouseX() - MENU_OFFSET;
        }
    }

    // Opens one of the viewport header's menus ("camera" or "show") under the mouse, or closes it if it was
    // open.
    ToggleViewportMenu~: (name: string) -> void {
        wasOpen := this.viewportMenu == name;
        this.CloseAll();
        if wasOpen {
            return;
        }
        this.viewportMenu = name;
        this.viewportMenuX = penumbra:::mouseX() - MENU_OFFSET;
        this.viewportMenuY = penumbra:::mouseY() + VIEWPORT_MENU_DROP;
    }

    // Closes the viewport header's menu.
    CloseViewportMenu~: () -> void { this.viewportMenu = ""; }

    // Closes the menu.
    CloseMenu~: () -> void { this.openMenu = ""; }

    // Opens the right click menu at the mouse for an entity.
    OpenContextMenu~: (entity: i64) -> void {
        this.contextEntity = entity;
        this.contextX = penumbra:::mouseX();
        this.contextY = penumbra:::mouseY();
        this.contextOpen = true;
        this.openMenu = "";
        this.viewportMenu = "";
    }

    // Closes it.
    CloseContextMenu~: () -> void { this.contextOpen = false; }

    // Opens the command palette.
    OpenPalette~: () -> void { this.paletteOpen = true; }
    OpenSettings~: () -> void { this.settingsOpen = true; }

    // Opens the project dialog in a mode: "new" (make a project), "duplicate" (copy this one) or "settings" (rename it,
    // point it at another engine, check it). The folder a new or copied project goes in starts as the default one.
    OpenProject~: (mode: string) -> void {
        this.projectParent = projectDefaultParent();
        this.projectDialog = mode;
    }

    // Closes the project dialog.
    CloseProject~: () -> void { this.projectDialog = ""; }
    ShowHelp~: (page: string) -> void { this.helpPage = page; }
    AskToSave~: (command: string) -> void { this.confirmCommand = command; }

    // Closes the settings and saves the preferences, since changes in it are made on the spot.
    CloseSettings~: () -> void {
        this.settingsOpen = false;
        editorSavePreferences();
    }

    // Dismisses the "save first?" question.
    ClearConfirmCommand~: () -> void {
        this.confirmCommand = "";
    }

    // Closes every popup (but not the settings dialog or the save question).
    CloseAll~: () -> void {
        this.openMenu = "";
        this.viewportMenu = "";
        this.contextOpen = false;
        this.paletteOpen = false;
        this.helpPage = "";
    }

    // True when a menu, the right click menu, the palette or a help page is open.
    AnyPopupOpen:: () -> bool {
        return this.openMenu != "" || this.viewportMenu != "" || this.contextOpen || this.paletteOpen || this.helpPage != "";
    }

    // True when a dialog is open that should get the keyboard instead of the viewport.
    BlocksViewportKeys:: () -> bool {
        return this.paletteOpen || this.settingsOpen || this.confirmCommand != "" || this.projectDialog != "";
    }

    // Closes the topmost thing that is open: popups, then the save question, then settings.
    // Returns false when there was nothing to close.
    Escape~: () -> bool {
        if this.AnyPopupOpen() {
            this.CloseAll();
            return true;
        }
        if this.confirmCommand != "" {
            this.confirmCommand = "";
            return true;
        }
        if this.projectDialog != "" {
            this.projectDialog = "";
            return true;
        }
        if this.settingsOpen {
            this.CloseSettings();
            return true;
        }
        return false;
    }
}
