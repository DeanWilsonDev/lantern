EditorOverlays :: class {
public:
    static MENU_OFFSET :: 16.0f;

    @signal openMenu~ string = "";
    @signal menuX~ f32 = 0.0f;
    @signal contextOpen~ bool = false;
    @signal contextX~ f32 = 0.0f;
    @signal contextY~ f32 = 0.0f;
    @signal contextEntity~ i64 = 0;
    @signal paletteOpen~ bool = false;
    @signal settingsOpen~ bool = false;
    @signal helpPage~ string = "";
    @signal confirmCommand~ string = "";

    ToggleMenu~: (name: string) -> void {
        this.CloseAll();
        if this.openMenu == name {
            this.openMenu = "";
            return;
        }
        this.openMenu = name;
        this.menuX = penumbra:::mouseX() - MENU_OFFSET;
    }

    HoverMenu~: (name: string) -> void {
        if this.openMenu != "" && this.openMenu != name {
            this.openMenu = name;
            this.menuX = penumbra:::mouseX() - MENU_OFFSET;
        }
    }

    CloseMenu~: () -> void { this.openMenu = ""; }

    OpenContextMenu~: (entity: i64) -> void {
        this.contextEntity = entity;
        this.contextX = penumbra:::mouseX();
        this.contextY = penumbra:::mouseY();
        this.contextOpen = true;
        this.openMenu = "";
    }

    CloseContextMenu~: () -> void { this.contextOpen = false; }

    OpenPalette~: () -> void { this.paletteOpen = true; }
    OpenSettings~: () -> void { this.settingsOpen = true; }
    ShowHelp~: (page: string) -> void { this.helpPage = page; }
    AskToSave~: (command: string) -> void { this.confirmCommand = command; }

    CloseSettings~: () -> void {
        this.settingsOpen = false;
        editorSavePreferences();
    }

    ClearConfirmCommand~: () -> void {
        this.confirmCommand = "";
    }

    CloseAll~: () -> void {
        this.openMenu = "";
        this.contextOpen = false;
        this.paletteOpen = false;
        this.helpPage = "";
    }

    AnyPopupOpen:: () -> bool {
        return this.openMenu != "" || this.contextOpen || this.paletteOpen || this.helpPage != "";
    }

    BlocksViewportKeys:: () -> bool {
        return this.paletteOpen || this.settingsOpen || this.confirmCommand != "";
    }

    Escape~: () -> bool {
        if this.AnyPopupOpen() {
            this.CloseAll();
            return true;
        }
        if this.confirmCommand != "" {
            this.confirmCommand = "";
            return true;
        }
        if this.settingsOpen {
            this.CloseSettings();
            return true;
        }
        return false;
    }
}
