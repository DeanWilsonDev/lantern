Editor :: import Editor;
EditorMenus :: import EditorMenus;
MenuEntry :: import MenuEntry;

MenuPopupProps :: data {
    x: f32;
    y: f32;
    entries: Array<MenuEntry>;
    onDismiss: () -> void;
}

MenuPopupUi :: namespace {
    EntryClass :: (entry: MenuEntry) -> string {
        return entry.enabled ? "menu-entry" : "menu-entry-disabled";
    }

    LabelClass :: (entry: MenuEntry) -> string {
        return entry.enabled ? "menu-entry-label" : "menu-entry-label-disabled";
    }
}

MenuPopup :: (props: MenuPopupProps) -> Penumbra:::Component {
    @context editor~ Editor = new Editor();
    return (
        <portal ref="menu-popup" x={props.x} y={props.y} width={EditorMenus:::POPUP_WIDTH}
                height={EditorMenus:::PopupHeight(props.entries)} dismissOnOutsideClick={true}
                onDismiss={props.onDismiss}>
            <frame class="menu-popup">
                <slot>
                    !{props.entries.map((entry: MenuEntry) ->
                        entry.separator
                            ? <frame key={`separator-${entry.label}-${entry.command}`} class="menu-separator" />
                            : <frame key={entry.command + entry.label} class={MenuPopupUi:::EntryClass(entry)}
                                     onRelease={() -> { if entry.enabled { editor.commands.RunCommand(entry.command); } }}>
                                  <frame class="menu-entry-check">
                                      <slot>
                                          !{entry.checked
                                              ? <icon class="menu-entry-check-icon" icon="check" size={11.0f} />
                                              : <frame class="nothing" />}
                                      </slot>
                                  </frame>
                                  <text class={MenuPopupUi:::LabelClass(entry)}>{entry.label}</text>
                                  <text class="menu-entry-shortcut">{entry.shortcut}</text>
                              </frame>)}
                </slot>
            </frame>
        </portal>
    );
}
