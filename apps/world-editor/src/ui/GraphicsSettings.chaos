ChoiceRow :: import ChoiceRow;
Editor :: import Editor;
SettingsUi :: import SettingsUi;
ViewOptionRow :: import ViewOptionRow;

GraphicsSettings :: () -> Penumbra:::Component {
    @context editor~ Editor;
    state := editor.document.toolbar;
    return (
        <frame class="settings-page">
            <text class="settings-heading">How the viewport is drawn</text>
            <text class="dialog-body">A quality level sets everything below; a checkbox then changes one effect.</text>
            <ChoiceRow label="Quality" options={SettingsUi:::QualityLevels()} selected={state.quality}
                       onSelect={(choice: string) -> { editorSetViewOption("quality", choice); }} />
            <ViewOptionRow label="Bloom" option="bloom" checked={state.bloom} />
            <ViewOptionRow label="Ambient occlusion" option="ambient_occlusion" checked={state.ambientOcclusion} />
            <ViewOptionRow label="Anti-aliasing" option="anti_aliasing" checked={state.antiAliasing} />
            <ViewOptionRow label="Light shafts" option="light_shafts" checked={state.lightShafts} />
            <ChoiceRow label="Shadow quality" options={SettingsUi:::QualityLevels()} selected={state.shadowQuality}
                       onSelect={(choice: string) -> { editorSetViewOption("shadow_quality", choice); }} />
        </frame>
    );
}
