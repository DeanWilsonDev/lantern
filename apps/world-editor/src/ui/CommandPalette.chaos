EditorUi :: import EditorUi;
MenuEntry :: import MenuEntry;

CommandPaletteUi :: namespace {
    WIDTH: f32 : 520.0f;
    HEIGHT: f32 : 380.0f;

    X :: () -> f32 {
        return (EditorUi:::App().WindowWidth() - WIDTH) * 0.5f;
    }
}

CommandPalette :: () -> Penumbra:::Component {
    return (
        <portal ref="command-palette" x={CommandPaletteUi:::X()} y={72.0f} width={CommandPaletteUi:::WIDTH}
                height={CommandPaletteUi:::HEIGHT} dismissOnOutsideClick={true}
                onDismiss={() -> EditorUi:::App().CloseOverlays()}>
            <frame class="dialog">
                <frame class="search-row">
                    <icon class="search-icon" icon="command" size={13.0f} />
                    <input ref="palette-input" class="search-input" text={EditorUi:::App().PaletteQuery()}
                           preferredWidth={460.0f}
                           onTextChange={(text: string) -> EditorUi:::App().SetPaletteQuery(text)}
                           onKeyDown={(key: string) -> EditorUi:::App().PaletteKey(key)} />
                </frame>
                <scroll ref="palette-scroll" class="palette-scroll" wheelStep={60.0f}>
                    <frame class="console-rows">
                        <slot>
                            !{EditorUi:::App().PaletteCommands().map((entry: MenuEntry) ->
                                <frame key={entry.command + entry.label} class={entry.enabled ? "menu-entry" : "menu-entry-disabled"}
                                       onRelease={() -> { if entry.enabled { EditorUi:::App().RunCommand(entry.command); } }}>
                                    <text class={entry.enabled ? "menu-entry-label" : "menu-entry-label-disabled"}>{entry.label}</text>
                                    <text class="menu-entry-shortcut">{entry.shortcut}</text>
                                </frame>)}
                        </slot>
                    </frame>
                </scroll>
                <text class="dialog-hint">Enter runs the first match. Escape closes.</text>
            </frame>
        </portal>
    );
}
