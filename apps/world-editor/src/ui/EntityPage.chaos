Editor :: import Editor;
InspectorGroupItem :: import InspectorGroupItem;

EntityPage :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="entity-page" class="entity-page">
            <slot>
                !{(() -> Penumbra:::Component {
                    revision := editor.document.revision;
                    id := editor.tabs.active;
                    return (
                        <frame class="entity-page-body">
                            <frame class="entity-page-header">
                                <icon class="panel-header-icon" icon="pencil" size={14.0f} />
                                <text class="entity-page-title">{editorEntityName(id)}</text>
                                <text class="entity-page-kind">{editorEntityKind(id)}</text>
                            </frame>
                            <text class="entity-page-heading">Components</text>
                            <slot>
                                !{editor.document.inspectorGroups.map((group: InspectorGroupItem) ->
                                    <frame key={group.name} class="entity-page-component">
                                        <text class="entity-page-component-name">{group.name}</text>
                                        <text class="entity-page-component-count">{`${group.fields.length()} properties`}</text>
                                    </frame>)}
                            </slot>
                            <text class="dialog-hint">Edit the values in the Details panel on the right. Ctrl+W closes this tab.</text>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
