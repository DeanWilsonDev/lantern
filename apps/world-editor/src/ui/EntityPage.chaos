Editor :: import Editor;
InspectorField :: import InspectorField;
InspectorFieldItem :: import InspectorFieldItem;
InspectorGroupItem :: import InspectorGroupItem;

// ComponentClass styles the chosen component's row. ChosenGroup finds the group with the wanted name, or the first one
// when that name is gone (for example after switching to another entity), or an empty group when there are none.
EntityPageUi :: namespace {
    ComponentClass :: (selected: bool) -> string {
        return selected ? "entity-page-component-selected" : "entity-page-component";
    }

    ChosenGroup :: (groups: Array<InspectorGroupItem>, wanted: string) -> InspectorGroupItem {
        for group in groups {
            if group.name == wanted {
                return group;
            }
        }
        return groups.length() > 0 ? groups[0] : InspectorGroupItem { name: "", collapsed: false, fields: [] };
    }
}

// An entity's own tab: its name and kind on top, a list of its components (the inspector's groups) on the left and the
// fields of the chosen one on the right. `chosenName` is the page's own signal. The page is built in a function
// called straight away inside the slot, so that reading editor.document.revision makes it re-render whenever the
// document changes.
EntityPage :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal chosenName~ string = "";
    return (
        <frame ref="entity-page" class="entity-page">
            <slot>
                !{(() -> Penumbra:::Component {
                    revision := editor.document.revision;
                    id := editor.tabs.active;
                    chosen := EntityPageUi:::ChosenGroup(editor.document.inspectorGroups, chosenName);
                    return (
                        <frame class="entity-page-body">
                            <frame class="entity-page-header">
                                <icon class="panel-header-icon" icon="pencil" size={14.0f} />
                                <text class="entity-page-title">{editorEntityName(id)}</text>
                                <text class="entity-page-kind">{editorEntityKind(id)}</text>
                            </frame>
                            <frame class="entity-page-columns">
                                <frame class="entity-page-list">
                                    <text class="entity-page-heading">Components</text>
                                    <slot>
                                        !{editor.document.inspectorGroups.map((group: InspectorGroupItem) ->
                                            <frame key={group.name} ref={`component-${group.name}`}
                                                   class={EntityPageUi:::ComponentClass(group.name == chosen.name)}
                                                   onRelease={() -> { chosenName = group.name; }}>
                                                <text class="entity-page-component-name">{group.name}</text>
                                                <text class="entity-page-component-count">{`${group.fields.length()}`}</text>
                                            </frame>)}
                                    </slot>
                                </frame>
                                <scroll ref="entity-page-scroll" class="entity-page-fields-scroll" wheelStep={60.0f}>
                                    <frame class="entity-page-fields">
                                        <text class="entity-page-heading">{chosen.name}</text>
                                        <slot>
                                            !{chosen.fields.map((item: InspectorFieldItem) ->
                                                <InspectorField key={item.rowKey} item={item} />)}
                                        </slot>
                                    </frame>
                                </scroll>
                            </frame>
                        </frame>
                    );
                })()}
            </slot>
        </frame>
    );
}
