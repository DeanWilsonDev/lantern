DocumentTabs :: import DocumentTabs;
Editor :: import Editor;
MainPane :: import MainPane;
PanelDock :: import PanelDock;

// The document tabs over the viewport (or an entity's tab), with the bottom dock under them while a panel is docked
// there: the content drawer to begin with, or whichever panels have been dragged under the viewport.
CentreArea :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="centre-area" class="workspace-fill">
            <DocumentTabs />
            <slot>
                !{editor.layout.PanelsAt("bottom", editor.Mode()).length() > 0
                    ? <split ref="viewport-split" class="workspace-fill" axis="vertical" ratio={0.72f} minPaneSize={120.0f} handleThickness={4.0f}>
                          <MainPane />
                          <PanelDock place="bottom" />
                      </split>
                    : <MainPane />}
            </slot>
        </frame>
    );
}
