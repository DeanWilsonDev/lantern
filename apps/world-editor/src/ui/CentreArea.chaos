BottomPanel :: import BottomPanel;
Editor :: import Editor;
ViewportPane :: import ViewportPane;

// The viewport, with the content drawer under it while the drawer is shown.
CentreArea :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="centre-area" class="workspace-fill">
            <slot>
                !{editor.layout.drawerVisible
                    ? <split ref="viewport-split" class="workspace-fill" axis="vertical" ratio={0.72f} minPaneSize={120.0f} handleThickness={4.0f}>
                          <ViewportPane />
                          <frame ref="bottom-panel" class="panel-bottom">
                              <BottomPanel />
                          </frame>
                      </split>
                    : <ViewportPane />}
            </slot>
        </frame>
    );
}
