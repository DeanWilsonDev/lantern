Editor :: import Editor;
Inspector :: import Inspector;
Outliner :: import Outliner;

// The outliner above the details panel, or whichever of the two is shown.
RightDock :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="right-dock" class="workspace-fill">
            <slot>
                !{editor.layout.outlinerVisible && editor.layout.detailsVisible
                    ? <split ref="dock-split" class="workspace-fill" axis="vertical" ratio={0.42f} minPaneSize={120.0f} handleThickness={4.0f}>
                          <frame ref="outliner" class="panel">
                              <Outliner />
                          </frame>
                          <frame ref="inspector" class="panel">
                              <Inspector />
                          </frame>
                      </split>
                    : editor.layout.outlinerVisible
                        ? <frame ref="outliner" class="panel">
                              <Outliner />
                          </frame>
                        : <frame ref="inspector" class="panel">
                              <Inspector />
                          </frame>}
            </slot>
        </frame>
    );
}
