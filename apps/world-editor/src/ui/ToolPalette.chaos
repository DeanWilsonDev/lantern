Editor :: import Editor;
EditorModes :: import EditorModes;
IconButton :: import IconButton;
ToolbarState :: import ToolbarState;

// One button of the tool palette (or a gap between groups when `separator` is set, or a group's heading when `heading` is): its icon, its tooltip, the command
// it runs and whether it is the tool in use.
ToolEntry :: data {
    icon: string = "";
    tooltip: string = "";
    command: string = "";
    active: bool = false;
    separator: bool = false;
    heading: bool = false;
}

// What the palette holds in each mode, and its size. Select mode has the three transform tools, and while a terrain is
// selected a Terrain group under them with the brushes, so the terrain tools turn up when there is a terrain to work
// on instead of behind a mode button. Picking a brush enters Terrain mode, where the palette has the brushes, New
// Terrain and Done, which goes back to selecting (as Escape does). The Silhouette and graph tabs have no palette.
ToolPaletteUi :: namespace {
    WIDTH: f32 : 40.0f;
    HANDLE_HEIGHT: f32 : 30.0f;
    BUTTON_HEIGHT: f32 : 28.0f;
    SEPARATOR_HEIGHT: f32 : 9.0f;
    LABEL_HEIGHT: f32 : 16.0f;
    PADDING: f32 : 8.0f;

    Tool :: (icon: string, tooltip: string, command: string, active: bool) -> ToolEntry {
        return ToolEntry { icon: icon, tooltip: tooltip, command: command, active: active };
    }

    Gap :: () -> ToolEntry {
        return ToolEntry { separator: true };
    }

    // A small heading over a group of tools, kept in the `tooltip` field since a heading has no tooltip of its own.
    Heading :: (text: string) -> ToolEntry {
        return ToolEntry { tooltip: text, heading: true };
    }

    Tools :: (mode: string, state: ToolbarState) -> Array<ToolEntry> {
        if mode == EditorModes:::SELECT {
            tools~ Array<ToolEntry> = [
                Tool("move", "Move (W)", "tool:move", state.tool == "move"),
                Tool("rotate", "Rotate (E)", "tool:rotate", state.tool == "rotate"),
                Tool("scale", "Scale (R)", "tool:scale", state.tool == "scale")
            ];
            guard state.terrainSelected return tools;
            tools.add(Gap());
            tools.add(Heading("Terrain"));
            for brush in Brushes() {
                tools.add(Tool(BrushIcon(brush), `Sculpt: ${Capitalised(brush)} brush`, `terrain:brush:${brush}`, false));
            }
            return tools;
        }
        guard mode == EditorModes:::TERRAIN return [];
        tools~ Array<ToolEntry> = [Heading("Terrain")];
        for brush in Brushes() {
            tools.add(Tool(BrushIcon(brush), `${Capitalised(brush)} brush`, `terrain:brush:${brush}`, state.terrainBrush == brush));
        }
        tools.add(Gap());
        tools.add(Tool("plus", "New terrain", "terrain:generate", false));
        tools.add(Tool("check", "Done sculpting (Esc)", "mode:select", false));
        return tools;
    }

    Brushes :: () -> Array<string> {
        return ["raise", "lower", "smooth", "flatten", "noise", "terrace", "erode"];
    }

    BrushIcon :: (brush: string) -> string {
        return when brush {
            "raise" -> "chevrons-up",
            "lower" -> "chevrons-down",
            "smooth" -> "circle",
            "flatten" -> "equals",
            "noise" -> "dot-grid",
            "terrace" -> "chart-bar",
            default -> "circle-half"
        };
    }

    // "raise" becomes "Raise", for a tooltip.
    Capitalised :: (word: string) -> string {
        guard word.length() > 0 return word;
        return word.substring(0, 1).toUpper() + word.substring(1, word.length() - 1);
    }

    // The palette's height for its tools and the handle.
    Height :: (tools: Array<ToolEntry>) -> f32 {
        height~ f32 = HANDLE_HEIGHT + PADDING;
        for tool in tools {
            height += tool.separator ? SEPARATOR_HEIGHT : (tool.heading ? LABEL_HEIGHT : BUTTON_HEIGHT);
        }
        return height;
    }

    // The tool entry's key in the palette's list.
    Key :: (tool: ToolEntry) -> string {
        return tool.heading ? `tool-heading-${tool.tooltip}` : (tool.separator ? `tool-gap-${tool.command}` : `tool-${tool.command}`);
    }
}

// The tool palette, a narrow column of the mode's tools like the tools panel of a paint program. It sits docked beside
// the viewport or floats over it (editor.layout.toolsFloating); App.chaos puts the floating one in a <portal> and
// MainPane puts the docked one at the viewport's left. The grip at its top shows while the mouse is over the palette
// (`hovered`, the palette's own state) and stays out of the way otherwise. Dragging it moves the palette, floating a
// docked one, and dropping it near the window's left edge docks it again (EditorLayout.FollowToolsDrag).
ToolPalette :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @signal hovered~ bool = false;
    return (
        <frame ref="tool-palette" class="tool-palette"
               onHover={() -> { hovered = true; }} onHoverEnd={() -> { hovered = false; }}>
            <frame ref="tool-palette-handle" class="tool-palette-handle" onPress={() -> editor.layout.BeginToolsDrag()}>
                <slot>
                    !{hovered
                        ? <icon class="tool-palette-grip" icon="dot-grid" size={10.0f} />
                        : <frame class="nothing" />}
                </slot>
            </frame>
            <slot>
                !{ToolPaletteUi:::Tools(editor.Mode(), editor.document.toolbar).map((tool: ToolEntry) ->
                    tool.heading
                        ? <text key={ToolPaletteUi:::Key(tool)} class="tool-palette-heading">{tool.tooltip}</text>
                        : tool.separator
                        ? <frame key={ToolPaletteUi:::Key(tool)} class="tool-palette-separator" />
                        : <IconButton key={ToolPaletteUi:::Key(tool)} icon={tool.icon} tooltip={tool.tooltip}
                                      tooltipPlacement="inside" active={tool.active}
                                      onPress={() -> editor.commands.RunCommand(tool.command)} />)}
            </slot>
        </frame>
    );
}
