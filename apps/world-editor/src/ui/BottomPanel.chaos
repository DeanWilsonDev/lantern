AssetBrowser :: import AssetBrowser;
BottomTab :: import BottomTab;
ConsoleFilters :: import ConsoleFilters;
ConsolePanel :: import ConsolePanel;
Editor :: import Editor;
HistoryPanel :: import HistoryPanel;

BottomPanel :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @provide consoleFilters~ ConsoleFilters = new ConsoleFilters();
    return (
        <frame class="bottom-panel">
            <slot>
                !{<frame class="tab-row">
                    <BottomTab tab="assets" icon="cube" label="Assets" />
                    <BottomTab tab="console" icon="terminal" label="Console" />
                    <BottomTab tab="history" icon="history" label="History" />
                </frame>}
            </slot>
            <slot>
                !{editor.layout.bottomPanel == "console"
                    ? <ConsolePanel />
                    : editor.layout.bottomPanel == "history"
                        ? <HistoryPanel />
                        : <AssetBrowser />}
            </slot>
        </frame>
    );
}
