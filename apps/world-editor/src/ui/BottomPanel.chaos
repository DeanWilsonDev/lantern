AssetBrowser :: import AssetBrowser;
BottomTab :: import BottomTab;
ConsoleFilters :: import ConsoleFilters;
ConsolePanel :: import ConsolePanel;
Editor :: import Editor;
HistoryPanel :: import HistoryPanel;
SilhouetteBrowser :: import SilhouetteBrowser;
TerrainPanel :: import TerrainPanel;

// The drawer under the viewport: a row of tabs (Assets, Silhouettes, Terrain, Console, History) and the page the active tab
// names. editor.layout.bottomPanel holds the active tab, so a menu command can switch it too. This component also
// creates the console's filters and provides them to the Console page below it.
BottomPanel :: () -> Penumbra:::Component {
    @context editor~ Editor;
    @provide consoleFilters~ ConsoleFilters = new ConsoleFilters();
    return (
        <frame class="bottom-panel">
            <slot>
                !{<frame class="tab-row">
                    <BottomTab tab="assets" icon="cube" label="Assets" />
                    <BottomTab tab="silhouettes" icon="layers" label="Silhouettes" />
                    <BottomTab tab="terrain" icon="chart-line" label="Terrain" />
                    <BottomTab tab="console" icon="terminal" label="Console" />
                    <BottomTab tab="history" icon="history" label="History" />
                </frame>}
            </slot>
            <slot>
                !{editor.layout.bottomPanel == "console"
                    ? <ConsolePanel />
                    : editor.layout.bottomPanel == "history"
                        ? <HistoryPanel />
                        : editor.layout.bottomPanel == "silhouettes"
                            ? <SilhouetteBrowser />
                            : editor.layout.bottomPanel == "terrain"
                                ? <TerrainPanel />
                                : <AssetBrowser />}
            </slot>
        </frame>
    );
}
