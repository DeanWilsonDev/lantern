/*
 * The bar along the top: the logo, the menu titles (one is highlighted while its menu is open) and the "Playing" text.
 */
.menu-bar {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 2px;
    height: 28px;
    padding: 0px var(--spacing-medium);
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
}

.menu-bar-logo {
    color: var(--color-accent);
    margin: 0px 4px 0px 0px;
}

.menu-bar-brand {
    color: var(--color-text-primary);
    margin: 0px var(--spacing-medium) 0px 0px;
}

.menu-bar-spacer {
    flex-grow: 1;
    height: 1px;
}

.menu-bar-title {
    color: var(--color-text-good);
}

.menu-title {
    display: stack;
    align-items: center;
    padding: 3px 10px;
    border-radius: var(--border-radius-small);
}

.menu-title:hover {
    background-color: var(--color-row-hover);
}

.menu-title-open {
    display: stack;
    align-items: center;
    padding: 3px 10px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.menu-title-label {
    color: var(--color-text-primary);
}

/*
 * A floating menu (the menu bar's, the viewport's, the right-click menu and the command palette's list). An entry is
 * plain, hovered or disabled, with a column for a tick and one for the shortcut.
 */
.menu-popup {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 0px;
    padding: 6px 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.menu-entry {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 24px;
    padding: 0px 8px;
    border-radius: var(--border-radius-small);
}

.menu-entry:hover {
    background-color: var(--color-row-selected);
}

.menu-entry-disabled {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 24px;
    padding: 0px 8px;
}

.menu-entry-check {
    display: stack;
    align-items: center;
    width: 14px;
    height: 14px;
}

.menu-entry-check-icon {
    color: var(--color-accent);
}

.menu-entry-label {
    color: var(--color-text-primary);
    flex-grow: 1;
}

.menu-entry-label-disabled {
    color: var(--color-text-disabled);
    flex-grow: 1;
}

.menu-entry-shortcut {
    color: var(--color-text-disabled);
    font-size: 11px;
}

.menu-separator {
    height: 1px;
    margin: 4px 6px;
    background-color: var(--color-panel-border);
}

/* Tooltips. The area wraps the thing the tooltip belongs to and is `position: relative`, so the bubble, which is
   `position: absolute`, is placed against it: under it (.tooltip), under its right edge (.tooltip-end) or inside its
   corner (.tooltip-inside). `pointer-events: none` lets the pointer pass through the bubble, so showing it never
   causes the area's hover to end. */
.tooltip-area {
    position: relative;
    display: stack;
    flex-direction: row;
    align-items: center;
}

.tooltip {
    position: absolute;
    top: 100%;
    left: 0px;
    margin: 4px 0px 0px 0px;
    z-index: var(--z-tooltip);
    pointer-events: none;
    display: stack;
    align-items: center;
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.tooltip-end {
    position: absolute;
    top: 100%;
    right: 0px;
    margin: 4px 0px 0px 0px;
    z-index: var(--z-tooltip);
    pointer-events: none;
    display: stack;
    align-items: center;
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.tooltip-inside {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: var(--z-tooltip);
    pointer-events: none;
    display: stack;
    align-items: center;
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.tooltip-text {
    color: var(--color-text-primary);
    font-size: 11px;
}

/* The Add menu: a column of categories beside a column of the things in the one under the mouse. */
.add-menu {
    display: stack;
    flex-direction: row;
    align-items: stretch;
    padding: 6px 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.add-menu-categories {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    width: 146px;
    padding: 0px 4px 0px 0px;
}

.add-menu-divider {
    width: 1px;
    background-color: var(--color-panel-border);
}

.add-menu-items {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    padding: 0px 0px 0px 4px;
}

.add-category {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 24px;
    padding: 0px 8px;
    border-radius: var(--border-radius-small);
}

.add-category:hover {
    background-color: var(--color-row-hover);
}

.add-category-active {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 24px;
    padding: 0px 8px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.add-category-icon {
    color: var(--color-accent);
}

.add-category-arrow {
    color: var(--color-text-disabled);
}
