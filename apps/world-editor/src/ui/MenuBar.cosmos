.menu-bar {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 2px;
    height: 28px;
    padding: 0px var(--spacing-medium);
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
}

.menu-bar-logo {
    color: var(--color-accent);
    margin: 0px 4px 0px 0px;
}

.menu-bar-brand {
    color: var(--color-text-primary);
    margin: 0px var(--spacing-medium) 0px 0px;
}

.menu-bar-spacer {
    flex-grow: 1;
    height: 1px;
}

.menu-bar-title {
    color: var(--color-text-good);
}

.menu-title {
    display: stack;
    align-items: center;
    padding: 3px 10px;
    border-radius: var(--border-radius-small);
}

.menu-title:hover {
    background-color: var(--color-row-hover);
}

.menu-title-open {
    display: stack;
    align-items: center;
    padding: 3px 10px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.menu-title-label {
    color: var(--color-text-primary);
}

.menu-popup {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 0px;
    padding: 6px 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.menu-entry {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 24px;
    padding: 0px 8px;
    border-radius: var(--border-radius-small);
}

.menu-entry:hover {
    background-color: var(--color-row-selected);
}

.menu-entry-disabled {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 24px;
    padding: 0px 8px;
}

.menu-entry-check {
    display: stack;
    align-items: center;
    width: 14px;
    height: 14px;
}

.menu-entry-check-icon {
    color: var(--color-accent);
}

.menu-entry-label {
    color: var(--color-text-primary);
    flex-grow: 1;
}

.menu-entry-label-disabled {
    color: var(--color-text-disabled);
    flex-grow: 1;
}

.menu-entry-shortcut {
    color: var(--color-text-disabled);
    font-size: 11px;
}

.menu-separator {
    height: 1px;
    margin: 4px 6px;
    background-color: var(--color-panel-border);
}

.tooltip-area {
    position: relative;
    display: stack;
    flex-direction: row;
    align-items: center;
}

.tooltip {
    position: absolute;
    top: 100%;
    left: 0px;
    margin: 4px 0px 0px 0px;
    z-index: var(--z-tooltip);
    pointer-events: none;
    display: stack;
    align-items: center;
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.tooltip-end {
    position: absolute;
    top: 100%;
    right: 0px;
    margin: 4px 0px 0px 0px;
    z-index: var(--z-tooltip);
    pointer-events: none;
    display: stack;
    align-items: center;
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.tooltip-inside {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: var(--z-tooltip);
    pointer-events: none;
    display: stack;
    align-items: center;
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.tooltip-text {
    color: var(--color-text-primary);
    font-size: 11px;
}
