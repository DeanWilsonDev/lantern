Editor :: import Editor;
EditorModes :: import EditorModes;
IconButton :: import IconButton;
EntityPage :: import EntityPage;
SilhouettePage :: import SilhouettePage;
MaterialSilhouettePage :: import MaterialSilhouettePage;
GraphPage :: import GraphPage;
ToolPalette :: import ToolPalette;
ViewportPane :: import ViewportPane;

// The main page under the document tabs. editor.tabs.active says which: 0 is the viewport (with the tool palette
// docked at its left unless it floats, and in Select mode the side rail at its right, whose button shows or hides the
// Silhouettes panel), -1 the page of the Silhouette being shown (mounted afresh for each Silhouette, so one document
// never keeps another's choices), -2 the graph page, and any other number an entity's own tab (EntityPage).
MainPane :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="main-pane" class="workspace-fill">
            <slot>
                !{editor.tabs.active == 0
                    ? <frame class="viewport-with-tools">
                          <slot>
                              !{editor.layout.toolsFloating
                                  ? <frame class="nothing" />
                                  : <frame ref="tool-dock" class="tool-dock"><ToolPalette /></frame>}
                          </slot>
                          <ViewportPane />
                          <slot>
                              !{editor.Mode() == EditorModes:::SELECT
                                  ? <frame ref="side-rail-dock" class="side-rail-dock">
                                        <frame ref="side-rail" class="side-rail">
                                            <IconButton icon="layers" tooltip="Silhouettes: everything to place (Shift+A)"
                                                        tooltipPlacement="end" active={editor.layout.IsShown("silhouettes")}
                                                        onPress={() -> editor.commands.RunCommand("silhouettes")} />
                                        </frame>
                                    </frame>
                                  : <frame class="nothing" />}
                          </slot>
                      </frame>
                    : (editor.tabs.active == -1
                        ? (editor.tabs.IsMaterialSilhouette(editor.tabs.silhouette)
                            ? <MaterialSilhouettePage key={`material-page-${editor.tabs.silhouette}`} materialName={editor.tabs.silhouette} />
                            : <SilhouettePage key={`silhouette-page-${editor.tabs.silhouette}`} />) : (editor.tabs.active == -2 ? <GraphPage /> : <EntityPage />))}
            </slot>
        </frame>
    );
}
