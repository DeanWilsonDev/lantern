Editor :: import Editor;
EntityPage :: import EntityPage;
SilhouettePage :: import SilhouettePage;
GraphPage :: import GraphPage;
ViewportPane :: import ViewportPane;

MainPane :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame ref="main-pane" class="workspace-fill">
            <slot>
                !{editor.tabs.active == 0 ? <ViewportPane /> : (editor.tabs.active == -1 ? <SilhouettePage /> : (editor.tabs.active == -2 ? <GraphPage /> : <EntityPage />))}
            </slot>
        </frame>
    );
}
