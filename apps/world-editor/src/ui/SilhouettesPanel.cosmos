/* The Silhouettes panel that pops out from the viewport's side rail: a header, a search box, and a column of
   categories beside a scrolling grid of thumbnail cards. */
.silhouettes-panel {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    gap: var(--spacing-small);
    padding: 6px 8px 8px 8px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
    box-shadow: var(--color-shadow);
}

.silhouettes-panel-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 26px;
}

.silhouettes-panel-title {
    color: var(--color-text-primary);
    font-size: 13px;
}

.silhouettes-panel-body {
    display: stack;
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    gap: var(--spacing-small);
}

.silhouettes-panel-categories {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    width: 132px;
    gap: 2px;
}

.silhouettes-panel-divider {
    width: 1px;
    background-color: var(--color-panel-border);
}

.silhouettes-panel-content {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    gap: var(--spacing-small);
}

.silhouettes-panel-scroll {
    flex-grow: 1;
}

.silhouettes-panel-rows {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
}

.silhouettes-category {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 26px;
    padding: 0px 8px;
    border-radius: var(--border-radius-small);
}

.silhouettes-category:hover {
    background-color: var(--color-row-hover);
}

.silhouettes-category-active {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
    height: 26px;
    padding: 0px 8px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.silhouettes-category-icon {
    color: var(--color-accent);
}

.silhouettes-category-label {
    color: var(--color-text-primary);
    font-size: 12px;
}

.silhouettes-category-count {
    color: var(--color-text-disabled);
    font-size: 11px;
}

.silhouettes-panel-empty {
    color: var(--color-text-disabled);
    font-size: 12px;
    padding: 8px 4px;
}

/* The side rail at the viewport's right edge, holding the button that opens the panel. */
.side-rail {
    display: stack;
    flex-direction: column;
    align-items: center;
    width: 40px;
    gap: 2px;
    padding: 4px 0px;
    margin: var(--panel-gap) 0px 0px 0px;
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
}

.side-rail-dock {
    display: stack;
    flex-direction: column;
    align-items: start;
}
