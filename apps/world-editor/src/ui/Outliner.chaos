EditorUi :: import EditorUi;
OutlineRowItem :: import OutlineRowItem;
OutlinerRow :: import OutlinerRow;

Outliner :: () -> Penumbra:::Component {
    return (
        <frame class="outliner">
            <text class="panel-title">World</text>
            <scroll ref="outliner-scroll" class="outliner-scroll" wheelStep={60.0f}>
                <frame ref="outliner-rows" class="outliner-rows">
                    <slot>
                        !{EditorUi:::App().OutlineRows().map((item: OutlineRowItem) ->
                            <OutlinerRow key={item.key} item={item}
                                         onSelect={(id: i64) -> EditorUi:::App().SelectEntity(id)} />)}
                    </slot>
                </frame>
            </scroll>
        </frame>
    );
}
