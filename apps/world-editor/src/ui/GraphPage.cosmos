.graph-centre {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    gap: var(--spacing-small);
}

.graph-canvas {
    flex-grow: 1;
    border-radius: var(--border-radius-small);
}

.graph-nyx {
    height: 150px;
}

.graph-side {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    width: 300px;
}

.graph-nyx-line {
    display: stack;
    flex-direction: column;
    align-items: stretch;
}

.type-swatch-bool {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #D84F4F;
}

.type-swatch-integer {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #4FD0C8;
}

.type-swatch-float {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #7BD662;
}

.type-swatch-string {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #E06CC8;
}

.type-swatch-other {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #6FB8FF;
}

.type-picker {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
}

.type-picker:hover {
    background-color: var(--color-row-hover);
}

.type-list {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    padding: 4px;
    border-radius: var(--border-radius-small);
    border-width: var(--border-width-default);
    border-color: var(--color-panel-border);
    background-color: var(--color-panel-background);
}

.type-option {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    border-radius: var(--border-radius-small);
}

.type-option:hover {
    background-color: var(--color-row-hover);
}
