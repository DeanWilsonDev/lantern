.graph-centre {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    gap: var(--spacing-small);
}

.graph-canvas {
    flex-grow: 1;
    border-radius: var(--border-radius-small);
}

.graph-nyx {
    height: 150px;
}

.graph-side {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    width: 300px;
}

.graph-nyx-line {
    display: stack;
    flex-direction: column;
    align-items: stretch;
}
