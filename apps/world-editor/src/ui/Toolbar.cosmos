/*
 * The row of tool buttons under the menu bar, and the icon button's states: plain, hovered, pressed, active (the chosen
 * tool) and disabled.
 */
.toolbar {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    padding: 4px var(--spacing-medium);
    margin: var(--panel-gap) var(--panel-gap) 0px var(--panel-gap);
}

.toolbar-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 2px;
}

.toolbar-separator {
    width: 1px;
    height: 20px;
    margin: 0px var(--spacing-small);
    background-color: var(--color-panel-border);
}

.toolbar-label {
    color: var(--color-text-disabled);
    margin: 0px var(--spacing-small) 0px 0px;
}

.toolbar-select {
    min-width: 120px;
    color: var(--color-text-primary);
    background-color: var(--color-window-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    padding: 2px 8px;
}

.icon-button {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 26px;
    border-radius: var(--border-radius-small);
}

.icon-button:hover {
    background-color: var(--color-row-hover);
}

.icon-button:active {
    background-color: var(--color-row-selected);
}

.icon-button-active {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 26px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-accent);
}

.icon-button-disabled {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 26px;
    border-radius: var(--border-radius-small);
}

.icon-button-glyph {
    color: var(--color-text-primary);
}

.icon-button-glyph-active {
    color: var(--color-accent-label);
}

.icon-button-glyph-disabled {
    color: var(--color-text-disabled);
}

/* The viewport and the header above it: its two menu buttons, the camera text and the hint. The panel's background is
   black, so a frame the engine hasn't drawn yet doesn't flash grey. */
.viewport-pane {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    margin: var(--panel-gap) 0px 0px 0px;
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    background-color: #000000FF;
}

.viewport-header {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-medium);
    height: 22px;
    padding: 0px var(--spacing-medium);
    background-color: var(--color-panel-background);
}

.viewport-menu-button {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: var(--border-radius-small);
}

.viewport-menu-button:hover {
    background-color: var(--color-row-hover);
}

.viewport-menu-label {
    color: var(--color-text-primary);
    font-size: 11px;
}

.viewport-menu-arrow {
    color: var(--color-text-disabled);
}

.viewport-camera {
    color: var(--color-text-primary);
    font-size: 11px;
}

.viewport-hint {
    color: var(--color-text-disabled);
    font-size: 11px;
    text-overflow: ellipsis;
}

.viewport {
    flex-grow: 1;
}

/* The viewport with the tool palette docked at its left. */
.viewport-with-tools {
    display: stack;
    flex-direction: row;
    align-items: stretch;
    gap: var(--panel-gap);
    flex-grow: 1;
}

.tool-dock {
    display: stack;
    flex-direction: column;
    align-items: start;
    margin: var(--panel-gap) 0px 0px 0px;
}

/* The tool palette: a grip to drag it by (shown while the mouse is over it), then a column of the mode's tools. */
.tool-palette {
    display: stack;
    flex-direction: column;
    align-items: center;
    width: 40px;
    gap: 0px;
    padding: 0px 0px 4px 0px;
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    box-shadow: var(--color-shadow);
}

.tool-palette-handle {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 26px;
}

.tool-palette-handle:hover {
    background-color: var(--color-row-hover);
}

.tool-palette-grip {
    color: var(--color-text-disabled);
}

.tool-palette-heading {
    color: var(--color-text-disabled);
    font-size: 9px;
    height: 16px;
}

.tool-palette-separator {
    width: 24px;
    height: 1px;
    margin: 4px 0px;
    background-color: var(--color-panel-border);
}

/* The toolbar's left and right groups share a width, so Play sits in the middle of the window. */
.toolbar-side {
    display: stack;
    flex-direction: row;
    align-items: center;
    width: 220px;
}

.toolbar-side-end {
    display: stack;
    flex-direction: row;
    align-items: center;
    justify-content: end;
    gap: 2px;
    width: 220px;
}

/* Play: white while nothing runs, green while the game is running. Pause beside it turns orange while paused. */
.play-controls {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
}

.play-button {
    display: stack;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 84px;
    height: 26px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-play-idle);
}

.play-button:hover {
    background-color: var(--color-play-idle-hovered);
}

.play-button-playing {
    display: stack;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 84px;
    height: 26px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-playing);
}

.play-button-playing:hover {
    background-color: var(--color-playing-hovered);
}

.play-button-icon {
    color: var(--color-play-label);
}

.play-button-label {
    color: var(--color-play-label);
}

.pause-button {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 26px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-window-background);
}

.pause-button:hover {
    background-color: var(--color-row-hover);
}

.pause-button-active {
    display: stack;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 26px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-paused);
}

.pause-button-active:hover {
    background-color: var(--color-paused-hovered);
}

.pause-button-icon {
    color: var(--color-text-primary);
}

.pause-button-icon-active {
    color: var(--color-play-label);
}

/* Snap, space and pivot in the viewport's header: small labelled toggles, lit while on. */
.viewport-toggle {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: var(--border-radius-small);
}

.viewport-toggle:hover {
    background-color: var(--color-row-hover);
}

.viewport-toggle-active {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: var(--border-radius-small);
    background-color: var(--color-row-selected);
}

.viewport-toggle-icon {
    color: var(--color-text-disabled);
}

.viewport-toggle-icon-active {
    color: var(--color-accent-hovered);
}

.viewport-header-separator {
    width: 1px;
    height: 14px;
    background-color: var(--color-panel-border);
}

.viewport-header-group {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: 4px;
}
