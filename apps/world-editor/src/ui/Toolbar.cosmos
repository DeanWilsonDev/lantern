.toolbar {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    background-color: var(--color-panel-background);
    border-color: var(--color-panel-border);
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-panel);
    padding: var(--spacing-medium) var(--panel-padding-horizontal);
    margin: var(--panel-gap) var(--panel-gap) 0px var(--panel-gap);
}

.toolbar-row {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
}

.toolbar-group {
    display: stack;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-small);
}

.toolbar-separator {
    width: 1px;
    height: 20px;
    margin: 0px var(--spacing-small);
    background-color: var(--color-panel-border);
}

.toolbar-label {
    color: var(--color-text-disabled);
    margin: 0px var(--spacing-small) 0px 0px;
}

.path-field {
    border-width: var(--border-width-default);
    border-radius: var(--border-radius-small);
    border-color: var(--color-panel-border);
    background-color: var(--color-window-background);
    color: var(--color-text-primary);
    padding: 4px var(--spacing-medium);
}
