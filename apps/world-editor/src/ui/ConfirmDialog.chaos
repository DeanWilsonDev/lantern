Editor :: import Editor;

ConfirmDialogUi :: namespace {
    WIDTH: f32 : 440.0f;
    HEIGHT: f32 : 150.0f;

    X :: () -> f32 {
        return (penumbra:::windowWidth() - WIDTH) * 0.5f;
    }

    Y :: () -> f32 {
        return (penumbra:::windowHeight() - HEIGHT) * 0.4f;
    }
}

ConfirmDialog :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <portal ref="confirm-dialog" x={ConfirmDialogUi:::X()} y={ConfirmDialogUi:::Y()} width={ConfirmDialogUi:::WIDTH}
                height={ConfirmDialogUi:::HEIGHT} dismissOnOutsideClick={false}>
            <frame class="dialog">
                <frame class="dialog-title-row">
                    <icon class="dialog-warning-icon" icon="warning" size={16.0f} />
                    <text class="dialog-title">Unsaved changes</text>
                </frame>
                <text class="dialog-body">The world has changes that have not been saved. Save them first?</text>
                <frame class="dialog-actions">
                    <frame class="small-button" onRelease={() -> editor.commands.ConfirmCancel()}>
                        <text class="small-button-label">Cancel</text>
                    </frame>
                    <frame class="small-button" onRelease={() -> editor.commands.ConfirmDiscard()}>
                        <text class="small-button-label">Discard</text>
                    </frame>
                    <frame class="small-button-accent" onRelease={() -> editor.commands.ConfirmSave()}>
                        <text class="small-button-label-accent">Save</text>
                    </frame>
                </frame>
            </frame>
        </portal>
    );
}
