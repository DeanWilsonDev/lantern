Editor :: import Editor;
TerrainChoice :: import TerrainChoice;
TerrainUi :: import TerrainUi;

// The Terrain page of the drawer, in three columns that match the three jobs. Brush: switch the brush on (also B, the
// toolbar button, or Terrain > Sculpt Brush), then hold the left button on a terrain; hold Ctrl to invert, Shift to smooth,
// and [ and ] resize it. Generate: what a new or regenerated terrain is made from. Make: its size, and the buttons that
// add, rebuild and weather a terrain. The Terrain menu runs the same commands, and every choice here is remembered
// between runs except the seed.
TerrainPanel :: () -> Penumbra:::Component {
    @context editor~ Editor;
    state := editor.document.toolbar;
    return (
        <frame class="terrain-panel">
            <frame class="terrain-column">
                <frame class="setting-row">
                    <text class="settings-heading">Brush</text>
                    <checkbox class="field-checkbox" checked={state.terrainOn}
                              onToggle={(checked: bool) -> editor.commands.RunCommand("terrain:toggle")} />
                    <text class="setting-label">On (B)</text>
                </frame>
                <TerrainChoice label="Brush" name="brush" />
                <TerrainChoice label="Radius (metres)" name="radius" />
                <TerrainChoice label="Strength" name="strength" />
                <TerrainChoice label="Falloff" name="falloff" />
                <TerrainChoice label="Terrace step (metres)" name="terrace_step" />
            </frame>
            <frame class="terrain-column">
                <text class="settings-heading">Generate</text>
                <frame class="setting-row">
                    <text class="setting-label-wide">Seed</text>
                    <text class="setting-label">{TerrainUi:::Shown(editorTerrainOption("seed"))}</text>
                    <frame class="small-button" onRelease={() -> editor.commands.RunCommand("terrain:reseed")}>
                        <text class="small-button-label">New seed</text>
                    </frame>
                </frame>
                <TerrainChoice label="Feature size (metres)" name="feature_size" />
                <TerrainChoice label="Octaves" name="octaves" />
                <TerrainChoice label="Height (metres)" name="amplitude" />
                <TerrainChoice label="Base height" name="base_height" />
            </frame>
            <frame class="terrain-column">
                <text class="settings-heading">Make</text>
                <TerrainChoice label="Columns of vertices" name="columns" />
                <TerrainChoice label="Cell size (metres)" name="cell_size" />
                <TerrainChoice label="Erosion passes" name="erosion_passes" />
                <frame class="setting-row">
                    <frame class="small-button-accent" onRelease={() -> editor.commands.RunCommand("terrain:generate")}>
                        <text class="small-button-label-accent">New terrain</text>
                    </frame>
                    <frame class="small-button" onRelease={() -> editor.commands.RunCommand("terrain:regenerate")}>
                        <text class="small-button-label">Regenerate selected</text>
                    </frame>
                    <frame class="small-button" onRelease={() -> editor.commands.RunCommand("terrain:erode")}>
                        <text class="small-button-label">Erode selected</text>
                    </frame>
                </frame>
            </frame>
        </frame>
    );
}
