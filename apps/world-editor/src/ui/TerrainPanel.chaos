TerrainChoice :: import TerrainChoice;
TerrainUi :: import TerrainUi;

// The Terrain page of the drawer. Sculpt: switch the brush on, then hold the left button on a terrain to raise, lower,
// smooth or flatten it (one undo step per stroke). Generate: the settings a new terrain, or the selected one, is made
// from. Actions: add a terrain, rebuild the selected one from the settings, or weather it.
TerrainPanel :: () -> Penumbra:::Component {
    @signal brushOn~ bool = editorTerrainOption("active") > 0.5f;
    @signal seed~ string = TerrainUi:::Shown(editorTerrainOption("seed"));
    return (
        <frame class="terrain-panel">
            <frame class="terrain-column">
                <text class="settings-heading">Sculpt</text>
                <frame class="setting-row">
                    <checkbox class="field-checkbox" checked={brushOn}
                              onToggle={(checked: bool) -> { brushOn = checked; editorSetTerrainOption("active", checked ? 1.0f : 0.0f); }} />
                    <text class="setting-label">Brush on (hold the left button on a terrain)</text>
                </frame>
                <TerrainChoice label="Brush" name="brush" />
                <TerrainChoice label="Radius (metres)" name="radius" />
                <TerrainChoice label="Strength" name="strength" />
            </frame>
            <frame class="terrain-column">
                <text class="settings-heading">Generate</text>
                <frame class="setting-row">
                    <text class="setting-label-wide">Seed</text>
                    <text class="setting-label">{seed}</text>
                    <frame class="small-button" onRelease={() -> { editorTerrainAction("reseed"); seed = TerrainUi:::Shown(editorTerrainOption("seed")); }}>
                        <text class="small-button-label">New seed</text>
                    </frame>
                </frame>
                <TerrainChoice label="Feature size (metres)" name="feature_size" />
                <TerrainChoice label="Octaves" name="octaves" />
                <TerrainChoice label="Height (metres)" name="amplitude" />
                <TerrainChoice label="Base height" name="base_height" />
            </frame>
            <frame class="terrain-column">
                <text class="settings-heading">Make</text>
                <TerrainChoice label="Columns of vertices" name="columns" />
                <TerrainChoice label="Cell size (metres)" name="cell_size" />
                <TerrainChoice label="Erosion passes" name="erosion_passes" />
                <frame class="setting-row">
                    <frame class="small-button-accent" onRelease={() -> editorTerrainAction("generate")}>
                        <text class="small-button-label-accent">New terrain</text>
                    </frame>
                    <frame class="small-button" onRelease={() -> editorTerrainAction("regenerate")}>
                        <text class="small-button-label">Regenerate selected</text>
                    </frame>
                    <frame class="small-button" onRelease={() -> editorTerrainAction("erode")}>
                        <text class="small-button-label">Erode selected</text>
                    </frame>
                </frame>
            </frame>
        </frame>
    );
}
