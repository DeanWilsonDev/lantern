BottomPanel :: import BottomPanel;
CommandPalette :: import CommandPalette;
ConfirmDialog :: import ConfirmDialog;
EditorUi :: import EditorUi;
HelpDialog :: import HelpDialog;
Inspector :: import Inspector;
MenuBar :: import MenuBar;
MenuPopup :: import MenuPopup;
Outliner :: import Outliner;
SettingsDialog :: import SettingsDialog;
StatusBar :: import StatusBar;
Toolbar :: import Toolbar;
ViewportPane :: import ViewportPane;

App :: () -> Penumbra:::Component {
    return (
        <frame ref="app-root" class="app-root"
               onKeyDown={(key: string) -> EditorUi:::App().HandleKey(key)}
               onKeyUp={(key: string) -> EditorUi:::App().HandleKeyUp(key)}>
            <MenuBar />
            <Toolbar />
            <split ref="root-split" class="app-content" axis="horizontal" ratio={0.18f} minPaneSize={180.0f}
                   handleThickness={4.0f}>
                <frame ref="outliner" class="panel">
                    <Outliner />
                </frame>
                <split ref="center-split" axis="horizontal" ratio={0.76f} minPaneSize={220.0f} handleThickness={4.0f}>
                    <split ref="viewport-split" axis="vertical" ratio={0.72f} minPaneSize={120.0f} handleThickness={4.0f}>
                        <ViewportPane />
                        <frame ref="bottom-panel" class="panel-bottom">
                            <BottomPanel />
                        </frame>
                    </split>
                    <frame ref="inspector" class="panel">
                        <Inspector />
                    </frame>
                </split>
            </split>
            <StatusBar />
            <slot>
                !{EditorUi:::App().OpenMenu() != ""
                    ? <MenuPopup x={EditorUi:::App().MenuX()} y={EditorUi:::App().MenuBarHeight()}
                                 entries={EditorUi:::App().MenuEntries(EditorUi:::App().OpenMenu())}
                                 onDismiss={() -> EditorUi:::App().CloseMenu()} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{EditorUi:::App().ContextOpen()
                    ? <MenuPopup x={EditorUi:::App().ContextX()} y={EditorUi:::App().ContextY()}
                                 entries={EditorUi:::App().ContextEntries()}
                                 onDismiss={() -> EditorUi:::App().CloseContextMenu()} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{EditorUi:::App().PaletteOpen() ? <CommandPalette /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{EditorUi:::App().SettingsOpen() ? <SettingsDialog /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{EditorUi:::App().ConfirmCommand() != "" ? <ConfirmDialog /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{EditorUi:::App().HelpPage() != "" ? <HelpDialog /> : <frame class="nothing" />}
            </slot>
        </frame>
    );
}
