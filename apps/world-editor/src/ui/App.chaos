BottomPanel :: import BottomPanel;
CommandPalette :: import CommandPalette;
ConfirmDialog :: import ConfirmDialog;
Editor :: import Editor;
EditorMenus :: import EditorMenus;
HelpDialog :: import HelpDialog;
Inspector :: import Inspector;
MenuBar :: import MenuBar;
MenuPopup :: import MenuPopup;
Outliner :: import Outliner;
SettingsDialog :: import SettingsDialog;
StatusBar :: import StatusBar;
Toolbar :: import Toolbar;
ViewportPane :: import ViewportPane;

App :: () -> Penumbra:::Component {
    @provide editor~ Editor = new Editor();
    OnTick := (deltaSeconds: f32) -> void { editor.Tick(deltaSeconds); };
    return (
        <frame ref="app-root" class="app-root"
               onKeyDown={(key: string) -> editor.keyboard.KeyDown(key)}
               onKeyUp={(key: string) -> editor.keyboard.KeyUp(key)}>
            <MenuBar />
            <Toolbar />
            <split ref="root-split" class="app-content" axis="horizontal" ratio={0.18f} minPaneSize={180.0f}
                   handleThickness={4.0f}>
                <frame ref="outliner" class="panel">
                    <Outliner />
                </frame>
                <split ref="center-split" axis="horizontal" ratio={0.76f} minPaneSize={220.0f} handleThickness={4.0f}>
                    <split ref="viewport-split" axis="vertical" ratio={0.72f} minPaneSize={120.0f} handleThickness={4.0f}>
                        <ViewportPane />
                        <frame ref="bottom-panel" class="panel-bottom">
                            <BottomPanel />
                        </frame>
                    </split>
                    <frame ref="inspector" class="panel">
                        <Inspector />
                    </frame>
                </split>
            </split>
            <StatusBar />
            <slot>
                !{editor.overlays.openMenu != ""
                    ? <MenuPopup x={editor.overlays.menuX} y={EditorMenus:::BAR_HEIGHT}
                                 entries={EditorMenus:::Entries(editor.overlays.openMenu, editor.document.toolbar,
                                                                editor.document.recentFiles)}
                                 onDismiss={() -> editor.overlays.CloseMenu()} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.contextOpen
                    ? <MenuPopup x={editor.overlays.contextX} y={editor.overlays.contextY}
                                 entries={EditorMenus:::ContextEntries(editorIsHidden(editor.overlays.contextEntity),
                                                                       editorIsLocked(editor.overlays.contextEntity))}
                                 onDismiss={() -> editor.overlays.CloseContextMenu()} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.paletteOpen ? <CommandPalette /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.settingsOpen ? <SettingsDialog /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.confirmCommand != "" ? <ConfirmDialog /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.helpPage != "" ? <HelpDialog /> : <frame class="nothing" />}
            </slot>
        </frame>
    );
}
