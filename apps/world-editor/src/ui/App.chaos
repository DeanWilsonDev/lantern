EditorUi :: import EditorUi;
Inspector :: import Inspector;
Outliner :: import Outliner;
Toolbar :: import Toolbar;

App :: () -> Penumbra:::Component {
    return (
        <frame ref="app-root" class="app-root">
            <Toolbar />
            <split ref="root-split" class="app-content" axis="horizontal" ratio={0.17f} minPaneSize={160.0f}
                   handleThickness={4.0f}>
                <frame ref="outliner" class="panel">
                    <Outliner />
                </frame>
                <split ref="center-split" axis="horizontal" ratio={0.76f} minPaneSize={200.0f} handleThickness={4.0f}>
                    <frame ref="viewport-pane" class="viewport-pane">
                        <native ref="viewport" build="LanternViewport" />
                    </frame>
                    <frame ref="inspector" class="panel">
                        <Inspector />
                    </frame>
                </split>
            </split>
            <frame class="status-bar">
                <slot>
                    !{<text ref="status" class="status-text">{EditorUi:::App().Status()}</text>}
                </slot>
                <text class="status-hint">{EditorUi:::App().ControlsHint()}</text>
            </frame>
        </frame>
    );
}
