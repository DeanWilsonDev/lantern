AddMenu :: import AddMenu;
CommandPalette :: import CommandPalette;
ConfirmDialog :: import ConfirmDialog;
Editor :: import Editor;
EditorMenus :: import EditorMenus;
GraphNodeMenu :: import GraphNodeMenu;
GraphPageUi :: import GraphPageUi;
HelpDialog :: import HelpDialog;
ProjectDialog :: import ProjectDialog;
MenuBar :: import MenuBar;
MenuPopup :: import MenuPopup;
SettingsDialog :: import SettingsDialog;
StatusBar :: import StatusBar;
Toolbar :: import Toolbar;
ToolPalette :: import ToolPalette;
ToolPaletteUi :: import ToolPaletteUi;
Workspace :: import Workspace;

// The editor's root component. It creates the one Editor (the whole editor's state, see Editor.nox) and hands it down
// to every component below it with @provide; they read it back with @context. OnTick runs once per frame, before
// the frame is drawn. The key handlers on the root frame forward every key press to the editor's keyboard, which
// turns shortcuts into commands.
// 
// Under the fixed layout (menu bar, toolbar, workspace, status bar) come the overlays: the menu bar's menus (Add has its
// own two-column menu), the viewport's menus, the right-click menu, the tool palette while it floats,
// the Add menu from the tool palette and Shift+A, and the dialogs. Each is its own <slot>, so
// opening one re-renders only that slot, and each shows an empty frame until its flag in editor.overlays turns on.
App :: () -> Penumbra:::Component {
    @provide editor~ Editor = new Editor();
    OnTick := (deltaSeconds: f32) -> void { editor.Tick(deltaSeconds); };
    return (
        <frame ref="app-root" class="app-root"
               onKeyDown={(key: string) -> editor.keyboard.KeyDown(key)}
               onKeyUp={(key: string) -> editor.keyboard.KeyUp(key)}>
            <MenuBar />
            <Toolbar />
            <Workspace />
            <StatusBar />
            <slot>
                !{editor.overlays.openMenu == "Add"
                    ? <AddMenu x={editor.overlays.menuX} y={EditorMenus:::BAR_HEIGHT}
                               onDismiss={() -> editor.overlays.CloseMenu()} />
                    : editor.overlays.openMenu != ""
                    ? <MenuPopup x={editor.overlays.menuX} y={EditorMenus:::BAR_HEIGHT}
                                 entries={EditorMenus:::Entries(editor.overlays.openMenu, editor.document.toolbar,
                                                                editor.document.recentFiles, editor.Panels())}
                                 onDismiss={() -> editor.overlays.CloseMenu()} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.viewportMenu != ""
                    ? <MenuPopup x={editor.overlays.viewportMenuX} y={editor.overlays.viewportMenuY}
                                 entries={EditorMenus:::ViewportEntries(editor.overlays.viewportMenu, editor.document.toolbar)}
                                 onDismiss={() -> editor.overlays.CloseViewportMenu()} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.contextOpen
                    ? <MenuPopup x={editor.overlays.contextX} y={editor.overlays.contextY}
                                 entries={EditorMenus:::ContextEntries(editorIsHidden(editor.overlays.contextEntity),
                                                                       editorIsLocked(editor.overlays.contextEntity))}
                                 onDismiss={() -> editor.overlays.CloseContextMenu()} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.layout.toolsFloating && editor.tabs.active == 0
                    ? <portal key={`floating-tools-${editor.layout.toolsShowing}`} ref="floating-tools"
                              x={editor.layout.toolsX} y={editor.layout.toolsY}
                              onDismiss={() -> editor.layout.ReshowTools()}
                              width={ToolPaletteUi:::WIDTH}
                              height={ToolPaletteUi:::Height(ToolPaletteUi:::Tools(editor.Mode(), editor.document.toolbar))}>
                          <ToolPalette />
                      </portal>
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.addMenuOpen
                    ? <AddMenu x={editor.overlays.addMenuX} y={editor.overlays.addMenuY}
                               onDismiss={() -> editor.overlays.CloseAddMenu()} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.document.graphMenuOpen
                    ? <GraphNodeMenu x={editor.document.graphMenuX} y={editor.document.graphMenuY}
                                     kinds={GraphPageUi:::Lines(editorGraphMenuKinds())}
                                     onPick={(kind: string) -> {
                                         editorGraphAddNodeFromMenu(kind);
                                         editor.document.graphMenuOpen = false;
                                     }}
                                     onDismiss={() -> { editor.document.graphMenuOpen = false; }} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.paletteOpen ? <CommandPalette /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.settingsOpen ? <SettingsDialog /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.projectDialog != ""
                    ? <ProjectDialog key={editor.overlays.projectDialog} />
                    : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.confirmCommand != "" ? <ConfirmDialog /> : <frame class="nothing" />}
            </slot>
            <slot>
                !{editor.overlays.helpPage != "" ? <HelpDialog /> : <frame class="nothing" />}
            </slot>
        </frame>
    );
}
