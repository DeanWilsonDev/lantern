Editor :: import Editor;

EditorSettings :: () -> Penumbra:::Component {
    @context editor~ Editor;
    return (
        <frame class="settings-page">
            <text class="settings-heading">Editor</text>
            <text class="dialog-body">Preferences are saved when this dialog closes and when the editor quits: view options, snapping, recent worlds and the open bottom panel.</text>
            <frame class="setting-row">
                <text class="setting-label-wide">Recent worlds</text>
                <frame class="small-button" onRelease={() -> editor.document.ClearRecentFiles()}>
                    <text class="small-button-label">Clear list</text>
                </frame>
            </frame>
            <frame class="setting-row">
                <text class="setting-label-wide">Bottom panel</text>
                <select class="field-select" options={["assets", "console", "history"]} selected={editor.layout.bottomPanel}
                        onSelect={(choice: string) -> editor.layout.ShowBottomPanel(choice)} />
            </frame>
            <frame class="setting-row">
                <text class="setting-label-wide">Help</text>
                <frame class="small-button" onRelease={() -> editor.commands.RunCommand("help:shortcuts")}>
                    <text class="small-button-label">Keyboard shortcuts</text>
                </frame>
                <frame class="small-button" onRelease={() -> editor.commands.RunCommand("help:controls")}>
                    <text class="small-button-label">Viewport controls</text>
                </frame>
            </frame>
        </frame>
    );
}
