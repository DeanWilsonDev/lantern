.outliner {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    flex-grow: 1;
}

.outliner-scroll {
    flex-grow: 1;
}

.outliner-rows {
    display: stack;
    flex-direction: column;
    align-items: stretch;
}

.outliner-drop-tail {
    height: 40px;
}
