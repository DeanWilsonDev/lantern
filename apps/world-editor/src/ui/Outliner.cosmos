.outliner {
    display: stack;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-small);
    flex-grow: 1;
}

.panel-title {
    color: var(--color-text-disabled);
}

.outliner-scroll {
    flex-grow: 1;
}

.outliner-rows {
    display: stack;
    flex-direction: column;
    align-items: stretch;
}
