lantern:::worldeditor:::paths :: namespace {
    // Where the editor's files are, relative to the repository root, which is the folder it is run
    // from: the Chaos and Cosmos files of its interface, the font, the shared assets folder and the
    // compiled shaders.
    UI_DIRECTORY: string : "apps/world-editor/src/ui";
    FONT_PATH: string : "apps/world-editor/data/fonts/Inter-Regular.ttf";
    ASSETS_DIRECTORY: string : "games/platformer/assets";
    SHADER_DIRECTORY: string : "engine/shaders/compiled";
}
