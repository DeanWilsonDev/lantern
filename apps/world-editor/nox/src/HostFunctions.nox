NyxError :: import lantern:::nyx:::NyxError;

lantern:::worldeditor:::hostfunctions :: namespace {
    ToIndex :: (value: i32) -> u32 {
        if value < 0 {
            return 0;
        }
        return u32(value);
    }

    FirstFailure :: (first: NyxError*!?, next: NyxError*!?) -> NyxError*!? {
        if first == null {
            return next!;
        }
        delete next;
        return first!;
    }
}
