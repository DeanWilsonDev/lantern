NyxError :: import lantern:::nyx:::NyxError;

lantern:::worldeditor:::hostfunctions :: namespace {
    // Turns a signed number from the UI into an unsigned index, with a negative number becoming 0.
    ToIndex :: (value: i32) -> u32 {
        if value < 0 {
            return 0;
        }
        return u32(value);
    }

    // Keeps the first of two errors and frees the second, so a function that does two things can report
    // what went wrong first.
    FirstFailure :: (first: NyxError*!?, next: NyxError*!?) -> NyxError*!? {
        if first == null {
            return next!;
        }
        delete next;
        return first!;
    }
}
