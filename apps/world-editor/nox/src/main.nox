// The world editor program. It has three parts: the editor's logic and drawing, called through the editor C
// API (`Api`, from engine/editor-backend); the interface, written in Chaos and Cosmos and run by
// the Penumbra bridge (`BridgeHost`), which also calls the host functions registered here; and the SDL
// window, fonts, clipboard and renderer that Penumbra draws the interface with. This file joins them
// and runs the window's loop. The imports below are those three parts' classes.
WidgetBase :: import WidgetBase;
Point :: import Point;
Rect :: import Rect;
Color :: import Color;
InputState :: import InputState;
LayoutContext :: import LayoutContext;
StackingTracker :: import StackingTracker;
OverlayHost :: import OverlayHost;
IClipboard :: import IClipboard;
IIconBackend :: import IIconBackend;
IImageBackend :: import IImageBackend;
ViewportRenderer :: import penumbra:::bridge:::viewports:::ViewportRenderer;
StandardIconBackend :: import StandardIconBackend;
SdlWindow :: import SdlWindow;
SdlClipboard :: import SdlClipboard;
SdlFonts :: import SdlFonts;
SdlRenderer :: import SdlRenderer;
SdlImages :: import SdlImages;
BridgeC :: import BridgeC;
BridgeHost :: import penumbra:::bridge:::BridgeHost;
WindowRequests :: import penumbra:::bridge:::WindowRequests;
Runtime :: import lantern:::nyx:::Runtime;
NyxError :: import lantern:::nyx:::NyxError;
CallContext :: import lantern:::nyx:::CallContext;
Sdl :: import Sdl;
Api :: import lantern:::editorapi;
Editor :: import lantern:::editorapi:::Editor;
EditorFunctions :: import lantern:::worldeditor:::editorfunctions;
HostFunctions :: import lantern:::worldeditor:::hostfunctions;
FrameTimeFunctions :: import lantern:::worldeditor:::frametimes;
FrameTimes :: import lantern:::worldeditor:::frametimes:::FrameTimes;
Paths :: import lantern:::worldeditor:::paths;
FileDialog :: import lantern:::worldeditor:::filedialogs:::FileDialog;
LevelRenderer :: import lantern:::worldeditor:::viewports:::LevelRenderer;
PreviewRenderer :: import lantern:::worldeditor:::viewports:::PreviewRenderer;
GraphRenderer :: import lantern:::worldeditor:::viewports:::GraphRenderer;
GraphFunctions :: import lantern:::worldeditor:::graphfunctions;
ThumbnailRenderer :: import lantern:::worldeditor:::viewports:::ThumbnailRenderer;

// The C library's setenv, to set an environment variable before the renderer starts.
lantern:::worldeditor:::cenvironment :: foreign "c" {
    setenv :: (name: string, value: string, overwrite: i32) -> i32;
}

lantern:::worldeditor :: namespace {
    // The interface's first file and the class in it that is the application. The window starts at
    // 1680 by 980 logical pixels, the interface font is 12, and icon lines are 1.5 wide.
    APPLICATION_FILE: string : "EditorApplication.nyx";
    APPLICATION_CLASS: string : "EditorApplication";
    HOST_SURFACE_APPLICATION_SOURCE: string : "EditorHostSurfaceApplication :: class : Application {\n}\n";
    WINDOW_LOGICAL_WIDTH: i32 : 1680;
    WINDOW_LOGICAL_HEIGHT: i32 : 980;
    ICON_STROKE_LOGICAL: f32 : 1.5f;
    FONT_SIZE_LOGICAL: f32 : 12.0f;

    // Points the renderer at the compiled shaders, unless LANTERN_SHADER_DIRECTORY is already set (the
    // last argument, 0, means do not overwrite).
    UseBuiltShaderDirectory :: () -> void {
        unsafe {
            lantern:::worldeditor:::cenvironment:::setenv("LANTERN_SHADER_DIRECTORY", Paths:::SHADER_DIRECTORY, 0);
        }
    }

    // Prints an error's message, if there is one, and frees it.
    PrintFailure :: (failure: NyxError*!?) -> void {
        if found := failure {
            print(`${found->message}`);
        }
        delete failure;
    }

    // The three kinds of picture the interface asks for, made once for an editor: the level viewport, the
    // template preview, and a thumbnail for every template in the palette. They are given to the bridge
    // under names ("level", "preview", "thumbnail:ID") that the interface's picture elements use.
    EditorRenderers :: class {
    public:
        level~ LevelRenderer*!;
        preview~ PreviewRenderer*!;
        graph~ GraphRenderer*!;
        thumbnails~ Array<ThumbnailRenderer*!>! = [];

        EditorRenderers~: (editorInstance: raw Editor~*) {
            this->level = new LevelRenderer(editorInstance);
            this->preview = new PreviewRenderer(editorInstance);
            this->graph = new GraphRenderer(editorInstance);
            unsafe {
                borrowed: Editor~* = editorInstance;
                templateCount: u32 = Api:::TemplateCount(borrowed);
                for index~ u32 = 0; index < templateCount; index++ {
                    templateId: string! = Api:::Template(borrowed, index, Api:::TEMPLATE_ID);
                    this->thumbnails.push(new ThumbnailRenderer(editorInstance, templateId));
                    delete templateId;
                }
            }
        }

        !EditorRenderers~: () {
            this->thumbnails.freeAll();
            delete this->graph;
            delete this->preview;
            delete this->level;
        }

        // Registers each renderer with the bridge under its name.
        RegisterWith~: (host: BridgeHost~*) -> void {
            unsafe {
                levelPointer: raw ViewportRenderer~* = this->level;
                host->RegisterViewportRenderer("level", levelPointer);
                previewPointer: raw ViewportRenderer~* = this->preview;
                host->RegisterViewportRenderer("preview", previewPointer);
                graphPointer: raw ViewportRenderer~* = this->graph;
                host->RegisterViewportRenderer("graph", graphPointer);
            }
            for index~ usize = 0; index < this->thumbnails.length(); index++ {
                name: string! = `thumbnail:${this->thumbnails[index]->templateId}`;
                unsafe {
                    thumbnailPointer: raw ViewportRenderer~* = this->thumbnails[index];
                    host->RegisterViewportRenderer(name, thumbnailPointer);
                }
                delete name;
            }
        }
    }

    // Registers the two host functions the interface calls to choose which template the preview
    // shows (`editorSetPreviewTemplate`) and to ask which it is showing (`editorPreviewTemplate`).
    RegisterPreviewFunctions :: (runtime: Runtime~*, preview: raw PreviewRenderer~*) -> NyxError*!? {
        failure~ NyxError*!? = runtime->RegisterFunction("editorSetPreviewTemplate", "(templateId: string) -> void", new (context: CallContext~*) -> void [preview] {
            templateId: string! = context->Text(0);
            unsafe {
                chosen: PreviewRenderer~* = preview;
                chosen->SetTemplate(templateId);
            }
            delete templateId;
            context->ReturnNull();
        });
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorPreviewTemplate", "() -> string", new (context: CallContext~*) -> void [preview] {
            unsafe {
                chosen: PreviewRenderer~* = preview;
                context->ReturnText(chosen->templateId);
            }
        }));
        return failure!;
    }

    // Registers every function the editor's Nyx code can call: the editor's own (EditorFunctions), the
    // preview ones and the frame time ones (FrameTimeFunctions). Prints the reason and returns false if any
    // registration fails.
    RegisterHostFunctions :: (runtime: Runtime~*, editorInstance: raw Editor~*, renderers: EditorRenderers~*, frameTimes: raw FrameTimes~*) -> bool {
        failure~ NyxError*!? = EditorFunctions:::RegisterEditorFunctions(runtime, editorInstance);
        unsafe {
            previewPointer: raw PreviewRenderer~* = renderers->preview;
            failure = HostFunctions:::FirstFailure(failure!, RegisterPreviewFunctions(runtime, previewPointer));
        }
        failure = HostFunctions:::FirstFailure(failure!, GraphFunctions:::RegisterGraphFunctions(runtime, editorInstance));
        failure = HostFunctions:::FirstFailure(failure!, FrameTimeFunctions:::RegisterFrameTimeFunctions(runtime, frameTimes));
        if failure != null {
            print("registering the editor's host functions failed:");
            PrintFailure(failure!);
            return false;
        }
        return true;
    }

    // Prints the messages the bridge collected (script errors and logs).
    PrintMessages :: (host: BridgeHost~*) -> void {
        messages~ Array<string!>! = host->TakeMessages();
        for message in messages {
            print(`${message}`);
        }
        messages.freeAll();
    }

    // Handles `--host-surface FILE`: starts everything except the window, registers the host
    // functions and writes the list of them as a manifest, so the Nyx language server can check the
    // interface's code against the real names.
    WriteHostSurface :: (outputPath: string) -> i32 {
        UseBuiltShaderDirectory();
        editorInstance~ Editor*! = Api:::Create(Paths:::ASSETS_DIRECTORY, "");
        defer delete editorInstance;
        runtime := new Runtime();
        defer delete runtime;
        editorPointer~ raw Editor~* = null;
        unsafe {
            editorPointer = editorInstance;
        }
        renderers := new EditorRenderers(editorPointer);
        defer delete renderers;
        frameTimes := new FrameTimes(true);
        defer delete frameTimes;
        frameTimesPointer~ raw FrameTimes~* = null;
        unsafe {
            frameTimesPointer = frameTimes;
        }
        guard RegisterHostFunctions(runtime, editorPointer, renderers, frameTimesPointer) == true return 1;
        fonts := new SdlFonts(Paths:::FONT_PATH);
        defer delete fonts;
        host := new BridgeHost(runtime->handle, Paths:::UI_DIRECTORY, fonts);
        defer delete host;
        guard host->IsUsable() == true return 1;
        when runtime->WriteHostSurface() {
            Result:::Ok(manifest) -> {
                defer delete manifest;
                return WriteText(outputPath, manifest);
            },
            Result:::Err(failure) -> {
                print("writing the editor's host surface failed:");
                PrintFailure(failure!);
                return 1;
            }
        }
    }

    // Writes a text file, printing the reason on failure. Returns the exit code.
    WriteText :: (outputPath: string, contents: string) -> i32 {
        when writeTextFile(outputPath, contents) {
            Result:::Ok(written) -> {
                return 0;
            },
            Result:::Err(failure) -> {
                print(`can't write ${outputPath}: ${failure.message()}`);
                delete failure;
                return 1;
            }
        }
    }

    // The interface cannot touch the window, so it leaves requests with the bridge (a new title, a new
    // size, text input on or off, a file dialog). Once a frame this carries them out. A dialog that
    // cannot open is answered with a cancel.
    ApplyWindowRequests :: (window: SdlWindow~*, host: BridgeHost~*, fileDialog: FileDialog~*) -> void {
        requests: WindowRequests*! = host->TakeWindowRequests();
        if requests->hasTitle {
            window->SetTitle(requests->title);
        }
        if requests->hasSize {
            window->SetLogicalSize(i32(requests->width), i32(requests->height));
        }
        if requests->hasTextInput {
            window->SetTextInputActive(requests->textInputActive);
        }
        if requests->hasFileDialog {
            if !fileDialog->Show(requests) {
                host->FinishFileDialog(null);
            }
        }
        delete requests;
    }

    // Collects what the interface may ask about the window each frame: its size, the display scale, the
    // mouse position and buttons, and whether the interface used the mouse last frame (so the 3D
    // viewport can tell when a click was meant for it).
    WindowState :: (size: Point, dpiScaleFactor: f32, input: InputState, rootConsumedInput: bool) -> BridgeC:::penumbra_bridge_window_state {
        return BridgeC:::penumbra_bridge_window_state {
            logical_width: size.x,
            logical_height: size.y,
            dpi_scale: dpiScaleFactor,
            mouse_x: input.mousePosition.x,
            mouse_y: input.mousePosition.y,
            primary_button_down: input.mouseButtonDown[0],
            secondary_button_down: input.mouseButtonDown[2],
            secondary_button_pressed_this_frame: input.mouseButtonPressedThisFrame[2],
            root_consumed_input_this_frame: rootConsumedInput
        };
    }

    // Creates the editor, the script runtime and the renderers, registers the host functions and runs the
    // window. Everything is released when it returns. The argument is the level to open (empty for the
    // default).
    RunEditor :: (worldPath: string) -> i32 {
        UseBuiltShaderDirectory();
        editorInstance~ Editor*! = Api:::Create(Paths:::ASSETS_DIRECTORY, worldPath);
        defer delete editorInstance;
        runtime := new Runtime();
        defer delete runtime;
        editorPointer~ raw Editor~* = null;
        unsafe {
            editorPointer = editorInstance;
        }
        status~ i32 = 0;
        {
            renderers := new EditorRenderers(editorPointer);
            defer delete renderers;
            frameTimes := new FrameTimes(lantern:::gpu:::GpuOptions:::FromEnvironment().vsync);
            defer delete frameTimes;
            frameTimesPointer~ raw FrameTimes~* = null;
            unsafe {
                frameTimesPointer = frameTimes;
            }
            guard RegisterHostFunctions(runtime, editorPointer, renderers, frameTimesPointer) == true return 1;
            status = RunWindow(runtime, renderers, frameTimes);
        }
        return status;
    }

    // The editor's main loop. It opens the window, makes the fonts, renderer, clipboard, icons and image
    // loader, starts the interface, and then each frame: pumps window events, finishes a file dialog,
    // carries out the interface's window requests, runs its update, measures and arranges the widgets,
    // lets them react to the mouse, draws them and presents. It stops when the window closes, the
    // interface asks to quit, or LANTERN_MAX_FRAMES frames have run (for tests and benchmarks). The editor
    // redraws every frame, never only on a change, so the frame time is the cost of a whole redraw. Each
    // frame it also times itself from the start of the last frame (see FrameTimes) and makes the window's
    // vertical sync match what the interface asked for, which starts as LANTERN_VSYNC says.
    RunWindow :: (runtime: Runtime~*, renderers: EditorRenderers~*, frameTimes: FrameTimes~*) -> i32 {
        window := new SdlWindow();
        defer delete window;
        guard window->Open("Lantern World Editor", WINDOW_LOGICAL_WIDTH, WINDOW_LOGICAL_HEIGHT) == true return 1;
        ApplyVerticalSync(window, frameTimes);
        fonts := new SdlFonts(Paths:::FONT_PATH);
        defer delete fonts;
        unsafe {
            fonts->cache->renderer = window->renderer;
        }
        fonts->dpiScaleFactor = window->DpiScaleFactor();
        guard fonts->IsReady() == true return 1;
        sdlRenderer := new SdlRenderer(window->renderer, fonts->cache, window->DpiScaleFactor());
        defer delete sdlRenderer;
        clipboard := new SdlClipboard();
        defer delete clipboard;
        icons := new StandardIconBackend(ICON_STROKE_LOGICAL, Color { red: 220, green: 220, blue: 228, alpha: 255 });
        defer delete icons;
        rendererPointer~ raw SdlRenderer~* = null;
        unsafe {
            rendererPointer = sdlRenderer;
        }
        images := new SdlImages(rendererPointer);
        defer delete images;
        overlays := new OverlayHost();
        defer delete overlays;
        layout := new LayoutContext();
        defer delete layout;
        stacking := new StackingTracker();
        defer delete stacking;
        clearColor: Color = Color { red: 18, green: 18, blue: 22, alpha: 255 };
        fileDialog := new FileDialog();
        defer delete fileDialog;

        host := new BridgeHost(runtime->handle, Paths:::UI_DIRECTORY, fonts);
        defer delete host;
        guard host->IsUsable() == true return 1;
        host->SetDefaultFontSize(FONT_SIZE_LOGICAL);
        unsafe {
            overlayPointer: raw OverlayHost~* = overlays;
            host->SetOverlayHost(overlayPointer);
            clipboardPointer: raw IClipboard~* = clipboard;
            host->SetClipboard(clipboardPointer);
            iconPointer: raw IIconBackend~* = icons;
            host->SetIconBackend(iconPointer);
            imagePointer: raw IImageBackend~* = images;
            host->SetImageBackend(imagePointer);
        }
        renderers->RegisterWith(host);

        startingSize: Point = window->LogicalSize();
        startingDpiScaleFactor: f32 = window->DpiScaleFactor();
        input~ InputState = window->FrameInput();
        host->SetWindowState(WindowState(startingSize, startingDpiScaleFactor, input, false));
        loaded: bool = host->Load(APPLICATION_FILE, APPLICATION_CLASS);
        started: bool = loaded && host->Start();
        PrintMessages(host);
        if !started {
            print("the editor UI failed to load");
            return 1;
        }
        ApplyWindowRequests(window, host, fileDialog);

        frameLimit: u64 = FrameLimit();
        frameCount~ u64 = 0;
        rootConsumedInput~ bool = false;
        frameStartNanoseconds~ u64 = NowNanoseconds();
        while !host->quitRequested {
            nowNanoseconds: u64 = NowNanoseconds();
            frameTimes->RecordFrame(f64(nowNanoseconds - frameStartNanoseconds) / 1000000000.0f);
            frameStartNanoseconds = nowNanoseconds;
            if frameTimes->verticalSyncWanted != frameTimes->verticalSyncActive {
                ApplyVerticalSync(window, frameTimes);
            }
            guard window->PumpEvents() == true break;
            dpiScaleFactor: f32 = window->DpiScaleFactor();
            viewport: Point = window->LogicalSize();
            fileDialog->FinishIfClosed(host);
            ApplyWindowRequests(window, host, fileDialog);
            input = window->FrameInput();
            sdlRenderer->SetDpiScaleFactor(dpiScaleFactor);
            fonts->dpiScaleFactor = dpiScaleFactor;
            host->SetWindowState(WindowState(viewport, dpiScaleFactor, input, rootConsumedInput));
            host->Update(input.deltaTimeSeconds);
            PrintMessages(host);

            layout->viewportLogical = viewport;
            stacking->keys->viewportLogical = viewport;
            root: raw WidgetBase~* = host->Root();
            rootConsumedInput = false;
            unsafe {
                if root != null {
                    layout->BeginPass();
                    root->Measure(viewport, layout);
                    root->Arrange(Rect { x: 0.0f, y: 0.0f, width: viewport.x, height: viewport.y }, layout);
                    overlays->Measure(viewport, layout);
                    overlays->Arrange(Rect { x: 0.0f, y: 0.0f, width: viewport.x, height: viewport.y }, layout);
                    layout->EndPass();
                    overlayConsumed: bool = overlays->UpdateInteractionState(input, stacking);
                    rootConsumedInput = root->UpdateInteractionState(input, stacking) || overlayConsumed;
                }
            }
            sdlRenderer->BeginFrame(clearColor);
            unsafe {
                if root != null {
                    root->Draw(sdlRenderer, stacking);
                    overlays->Draw(sdlRenderer, stacking);
                }
            }
            sdlRenderer->EndFrameAndPresent();
            frameCount = frameCount + 1;
            if frameLimit > 0 && frameCount >= frameLimit {
                break;
            }
        }
        host->Shutdown();
        PrintMessages(host);
        return 0;
    }

    // The current time from SDL, in nanoseconds.
    NowNanoseconds :: () -> u64 {
        now~ u64 = 0;
        unsafe {
            now = Sdl:::SDL_GetTicksNS();
        }
        return now;
    }

    // Makes the window's vertical sync what was asked for, then records what the window says it has,
    // which is what the status bar shows. A driver that refuses leaves it as it was; the request is then
    // dropped, so the toggle in the settings shows the truth and the loop does not ask again every frame.
    ApplyVerticalSync :: (window: SdlWindow~*, frameTimes: FrameTimes~*) -> void {
        window->SetVerticalSync(frameTimes->verticalSyncWanted);
        frameTimes->verticalSyncActive = window->VerticalSyncEnabled();
        frameTimes->verticalSyncWanted = frameTimes->verticalSyncActive;
    }

    // The number of frames to run from LANTERN_MAX_FRAMES, or 0 for no limit.
    FrameLimit :: () -> u64 {
        limitText: string!? = environmentVariable("LANTERN_MAX_FRAMES");
        defer delete limitText;
        if text := limitText {
            if limit := lantern:::core:::ParseUnsigned(text) {
                return limit;
            }
        }
        return 0;
    }
}

// `--host-surface FILE` writes the host function manifest; any other argument is a level to open; with
// no argument the editor opens its default level.
main :: (arguments: Array<string>) -> i32 {
    if arguments.length() == 3 && arguments[1] == "--host-surface" {
        return lantern:::worldeditor:::WriteHostSurface(arguments[2]);
    }
    if arguments.length() > 1 {
        return lantern:::worldeditor:::RunEditor(arguments[1]);
    }
    return lantern:::worldeditor:::RunEditor("");
}
