Api :: import lantern:::editorapi;
Editor :: import lantern:::editorapi:::Editor;
Modifiers :: import Modifiers;
ViewportFrame :: import penumbra:::bridge:::viewports:::ViewportFrame;
ViewportRenderer :: import penumbra:::bridge:::viewports:::ViewportRenderer;

lantern:::worldeditor:::viewports :: namespace {
    PREVIEW_TURNS_PER_SECOND_RADIANS: f32 : 0.6f;
    FULL_TURN_RADIANS: f32 : 6.2831855f;

    ModifierBits :: (modifiers: Modifiers) -> u32 {
        bits~ u32 = 0;
        if modifiers.shift {
            bits = bits | lantern:::editor:::MODIFIER_SHIFT;
        }
        if modifiers.shortcut {
            bits = bits | lantern:::editor:::MODIFIER_COMMAND;
        }
        if modifiers.alt {
            bits = bits | lantern:::editor:::MODIFIER_ALT;
        }
        return bits;
    }

    SizeFrame :: (frame: ViewportFrame~*, width: u32, height: u32) -> void {
        frame->widthPhysical = width;
        frame->heightPhysical = height;
        byteCount: usize = usize(width) * usize(height) * 4;
        while frame->rgbaPixels.length() > byteCount {
            frame->rgbaPixels.pop();
        }
        while frame->rgbaPixels.length() < byteCount {
            frame->rgbaPixels.push(0);
        }
    }

    LevelRenderer :: class {
        implements:
            ViewportRenderer;
    public:
        LevelRenderer~: (editorInstance: raw Editor~*) : editorInstance(editorInstance) {
        }

        Render~: (widthPhysical: u32, heightPhysical: u32, frame: ViewportFrame~*) -> bool {
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                guard Api:::Render(editorInstance, widthPhysical, heightPhysical) == true return false;
                SizeFrame(frame, Api:::PixelWidth(editorInstance), Api:::PixelHeight(editorInstance));
                return Api:::CopyPixels(editorInstance, frame->rgbaPixels);
            }
        }

        PointerMoved~: (xPhysical: f32, yPhysical: f32) -> void {
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                Api:::PointerMove(editorInstance, xPhysical, yPhysical);
            }
        }

        PointerButton~: (button: usize, down: bool, modifiers: Modifiers) -> void {
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                Api:::PointerButton(editorInstance, u32(button), down, ModifierBits(modifiers));
            }
        }

        Wheel~: (notches: f32, notchesX: f32) -> void {
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                Api:::Wheel(editorInstance, notches);
            }
        }

        Key~: (keyName: string, down: bool, modifiers: Modifiers) -> bool {
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                return Api:::Key(editorInstance, keyName, down, ModifierBits(modifiers));
            }
        }

        HoverChanged~: (pointerIsOver: bool) -> void {
            guard pointerIsOver == false return;
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                Api:::ReleaseKeys(editorInstance);
            }
        }

        Tick~: (deltaSeconds: f32) -> void {
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                Api:::Update(editorInstance, deltaSeconds);
            }
        }

    private:
        editorInstance~ raw Editor~* = null;
    }

    PreviewRenderer :: class {
        implements:
            ViewportRenderer;
    public:
        templateId~ string! = "";

        PreviewRenderer~: (editorInstance: raw Editor~*) : editorInstance(editorInstance) {
        }

        !PreviewRenderer~: () {
            delete this->templateId;
        }

        SetTemplate~: (chosen: string) -> void {
            copied: string! = chosen.copy();
            delete this->templateId;
            this->templateId = copied!;
        }

        Render~: (widthPhysical: u32, heightPhysical: u32, frame: ViewportFrame~*) -> bool {
            guard this->templateId.length() > 0 return false;
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                guard Api:::RenderPreview(editorInstance, this->templateId, widthPhysical, heightPhysical, this->spinRadians) == true return false;
                SizeFrame(frame, Api:::PreviewWidth(editorInstance), Api:::PreviewHeight(editorInstance));
                return Api:::CopyPreviewPixels(editorInstance, frame->rgbaPixels);
            }
        }

        PointerMoved~: (xPhysical: f32, yPhysical: f32) -> void {
        }

        PointerButton~: (button: usize, down: bool, modifiers: Modifiers) -> void {
        }

        Wheel~: (notches: f32, notchesX: f32) -> void {
        }

        Key~: (keyName: string, down: bool, modifiers: Modifiers) -> bool {
            return false;
        }

        HoverChanged~: (pointerIsOver: bool) -> void {
        }

        Tick~: (deltaSeconds: f32) -> void {
            this->spinRadians = this->spinRadians + deltaSeconds * PREVIEW_TURNS_PER_SECOND_RADIANS;
            while this->spinRadians >= FULL_TURN_RADIANS {
                this->spinRadians = this->spinRadians - FULL_TURN_RADIANS;
            }
        }

    private:
        editorInstance~ raw Editor~* = null;
        spinRadians~ f32 = 0.0f;
    }

    ThumbnailRenderer :: class {
        implements:
            ViewportRenderer;
    public:
        templateId~ string! = "";

        ThumbnailRenderer~: (editorInstance: raw Editor~*, templateId: string) : editorInstance(editorInstance) {
            this->templateId += templateId;
        }

        !ThumbnailRenderer~: () {
            delete this->templateId;
        }

        Render~: (widthPhysical: u32, heightPhysical: u32, frame: ViewportFrame~*) -> bool {
            size~ u32 = widthPhysical;
            if heightPhysical < size {
                size = heightPhysical;
            }
            guard size > 0 return false;
            unsafe {
                editorInstance: Editor~* = this->editorInstance;
                actualSize: u32 = Api:::Thumbnail(editorInstance, this->templateId, size);
                guard actualSize > 0 return false;
                SizeFrame(frame, actualSize, actualSize);
                return Api:::CopyThumbnailPixels(editorInstance, this->templateId, frame->rgbaPixels);
            }
        }

        PointerMoved~: (xPhysical: f32, yPhysical: f32) -> void {
        }

        PointerButton~: (button: usize, down: bool, modifiers: Modifiers) -> void {
        }

        Wheel~: (notches: f32, notchesX: f32) -> void {
        }

        Key~: (keyName: string, down: bool, modifiers: Modifiers) -> bool {
            return false;
        }

        HoverChanged~: (pointerIsOver: bool) -> void {
        }

        Tick~: (deltaSeconds: f32) -> void {
        }

    private:
        editorInstance~ raw Editor~* = null;
    }
}
