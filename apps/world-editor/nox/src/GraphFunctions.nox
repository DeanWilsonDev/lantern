Api :: import lantern:::editorapi;
Editor :: import lantern:::editorapi:::Editor;
Runtime :: import lantern:::nyx:::Runtime;
CallContext :: import lantern:::nyx:::CallContext;
NyxError :: import lantern:::nyx:::NyxError;
HostFunctions :: import lantern:::worldeditor:::hostfunctions;

lantern:::worldeditor:::graphfunctions :: namespace {
    // The host functions of the Graph tab: the Nyx names the interface calls to open, draw-adjacent state, edit and save the
    // graph the editor has open. Each calls the matching `Graph...` function of the editor C API.
    RegisterGraphFunctions :: (runtime: Runtime~*, state: raw Editor~*) -> NyxError*!? {
        failure~ NyxError*!? = null;
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphList", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphList(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphOpen", "(name: string, create: bool) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                name: string! = context->Text(0);
                create: bool = context->Bool(1);
                result: string! = Api:::GraphOpen(editorInstance, name, create);
                context->ReturnText(result);
                delete result;
                delete name;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphName", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphName(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorMaterialList", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::MaterialList(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphClose", "() -> void", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                Api:::GraphClose(editorInstance);
                context->ReturnNull();
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphIsOpen", "() -> bool", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                context->ReturnBool(Api:::GraphIsOpen(editorInstance));
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphRevision", "() -> i32", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                context->ReturnI32(i32(Api:::GraphRevision(editorInstance)));
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphFormat", "() -> bool", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                context->ReturnBool(Api:::GraphFormat(editorInstance));
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphMenuRequest", "() -> i32", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                context->ReturnI32(i32(Api:::GraphMenuRequest(editorInstance)));
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphMenuKinds", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphMenuKinds(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphAddNodeFromMenu", "(kind: string) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                kind: string! = context->Text(0);
                result: string! = Api:::GraphAddNodeFromMenu(editorInstance, kind);
                context->ReturnText(result);
                delete result;
                delete kind;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphVariables", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphVariables(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphAddVariable", "(name: string, typeName: string, initial: string) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                name: string! = context->Text(0);
                typeName: string! = context->Text(1);
                initial: string! = context->Text(2);
                result: string! = Api:::GraphAddVariable(editorInstance, name, typeName, initial);
                context->ReturnText(result);
                delete result;
                delete initial;
                delete typeName;
                delete name;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphRemoveVariable", "(name: string) -> bool", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                name: string! = context->Text(0);
                context->ReturnBool(Api:::GraphRemoveVariable(editorInstance, name));
                delete name;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphAddVariableNode", "(kind: string, name: string) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                kind: string! = context->Text(0);
                name: string! = context->Text(1);
                result: string! = Api:::GraphAddVariableNode(editorInstance, kind, name);
                context->ReturnText(result);
                delete result;
                delete name;
                delete kind;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphIsDirty", "() -> bool", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                context->ReturnBool(Api:::GraphIsDirty(editorInstance));
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphStatus", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphStatus(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphFunctions", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphFunctions(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphSelectFunction", "(index: i32) -> void", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                index: i32 = context->I32(0);
                Api:::GraphSelectFunction(editorInstance, HostFunctions:::ToIndex(index));
                context->ReturnNull();
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphSelectLine", "(line: i32) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                line: i32 = context->I32(0);
                result: string! = Api:::GraphSelectLine(editorInstance, HostFunctions:::ToIndex(line));
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphSelectedFunction", "() -> i32", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                context->ReturnI32(i32(Api:::GraphSelectedFunction(editorInstance)));
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphAddFunction", "(name: string, returns: string) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                name: string! = context->Text(0);
                returns: string! = context->Text(1);
                result: string! = Api:::GraphAddFunction(editorInstance, name, returns);
                context->ReturnText(result);
                delete result;
                delete returns;
                delete name;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphAddNode", "(kind: string) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                kind: string! = context->Text(0);
                result: string! = Api:::GraphAddNode(editorInstance, kind);
                context->ReturnText(result);
                delete result;
                delete kind;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphSelected", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphSelected(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphField", "(field: string) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                field: string! = context->Text(0);
                result: string! = Api:::GraphField(editorInstance, field);
                context->ReturnText(result);
                delete result;
                delete field;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphSetField", "(field: string, value: string) -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                field: string! = context->Text(0);
                value: string! = context->Text(1);
                result: string! = Api:::GraphSetField(editorInstance, field, value);
                context->ReturnText(result);
                delete result;
                delete value;
                delete field;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphCommentIndex", "() -> i32", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                context->ReturnI32(Api:::GraphCommentIndex(editorInstance));
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphCommentText", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphCommentText(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphSetCommentText", "(text: string) -> void", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                text: string! = context->Text(0);
                Api:::GraphSetCommentText(editorInstance, text);
                delete text;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphNyx", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphNyx(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        failure = HostFunctions:::FirstFailure(failure!, runtime->RegisterFunction("editorGraphSave", "() -> string", new (context: CallContext~*) -> void [state] {
            unsafe {
                editorInstance: Editor~* = state;
                result: string! = Api:::GraphSave(editorInstance);
                context->ReturnText(result);
                delete result;
            }
        }));
        return failure!;
    }
}
